---
// ServiceCard — reusable service card component
export interface Props {
  href: string;
  title: string;
  description: string;
  badge?: string;
  accent: 'indigo' | 'rose' | 'amber' | 'emerald';
  features: string[];
}

const { href, title, description, badge, accent, features } = Astro.props;

const accentMap = {
  indigo: { bar: 'bg-brand-indigo', text: 'text-brand-indigo', bg: 'bg-brand-indigo/10', before: 'before:bg-brand-indigo' },
  rose: { bar: 'bg-brand-rose', text: 'text-brand-rose', bg: 'bg-brand-rose/10', before: 'before:bg-brand-rose' },
  amber: { bar: 'bg-brand-amber', text: 'text-brand-amber', bg: 'bg-brand-amber/10', before: 'before:bg-brand-amber' },
  emerald: { bar: 'bg-brand-emerald', text: 'text-brand-emerald', bg: 'bg-brand-emerald/10', before: 'before:bg-brand-emerald' },
};

const a = accentMap[accent];
---

<a
  href={href}
  class:list={[
    'group relative block card-interactive reveal',
    'before:absolute before:left-6 before:top-0 before:h-1 before:w-12 before:rounded-b-sm before:transition-all before:duration-300 hover:before:w-20',
    a.before,
  ]}
>
  {badge && (
    <span class="inline-flex items-center px-2 py-0.5 text-[11px] font-medium tracking-wide uppercase text-slate-600 bg-slate-100 rounded">
      {badge}
    </span>
  )}

  <h3 class="mt-3 text-xl font-bold tracking-tighter-2 text-navy">{title}</h3>

  <p class="mt-3 text-sm text-slate-600 leading-relaxed">{description}</p>

  <ul class="mt-5 space-y-2">
    {features.map((feature) => (
      <li class="flex items-start gap-2 text-sm text-slate-700">
        <svg class="w-4 h-4 mt-0.5 flex-shrink-0 text-brand-emerald" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
        </svg>
        <span>{feature}</span>
      </li>
    ))}
  </ul>

  <div class="mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-navy">
    <span>Meer over {title.split('—')[0].trim()}</span>
    <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
    </svg>
  </div>
</a>
