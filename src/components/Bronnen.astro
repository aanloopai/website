---
// GEO-citatiestandaard v1 (S2/S10): zichtbare "Bronnen"-sectie. Alleen ids uit
// src/data/bronnen.json (elke URL live op 'accessed' gecontroleerd + citaat letterlijk aanwezig).
import registry from '../data/bronnen.json';
interface Props { ids: string[]; heading?: string }
const { ids, heading = 'Bronnen' } = Astro.props;
const byId = new Map(registry.bronnen.map((b) => [b.id, b]));
const items = ids.map((id) => {
  const b = byId.get(id);
  if (!b) throw new Error(`Bronnen.astro: onbekende bron-id "${id}" (niet in src/data/bronnen.json)`);
  const [y, m, d] = b.accessed.split('-');
  return { ...b, geraadpleegd: `${d}-${m}-${y}` };
});
---
{items.length > 0 && (
  <section class="max-w-3xl mx-auto mt-12" data-bronnen aria-labelledby="bronnen-heading">
    <h2 id="bronnen-heading" class="text-2xl font-bold text-navy mb-4">{heading}</h2>
    <ol class="list-decimal pl-6 space-y-2 text-sm text-slate-600 leading-relaxed">
      {items.map((b) => (
        <li>
          <a href={b.url} rel="noopener" target="_blank" class="text-brand-indigo underline hover:text-navy">{b.title}</a>
          {' '}— {b.publisher}, geraadpleegd {b.geraadpleegd}
          <span class="block text-slate-500">Citaat: <q lang={b.taal}>{b.citaat}</q></span>
        </li>
      ))}
    </ol>
  </section>
)}
