---
// Overeenkomst flow (lijst, bedrijfsgegevens, 4 stappen, ondertekenen).
// mode 'klant': /api/portal/overeenkomst/* (portal page).
// mode 'voorbeeld': admin preview, data from /api/admin/overeenkomst/klantweergave (GET only);
// the whole flow is a local simulation: nothing is ever sent to the server (apiPost throws in this mode).
// Data: document HTML arrives pre-escaped from the API.
const { mode = 'klant' } = Astro.props;
---

<div id="ovk-root" data-mode={mode}>
  {mode === 'voorbeeld' && (
    <div id="ovk-banner" class="palert palert--info mb-4" role="status">Voorbeeldweergave — zo ziet de klant de overeenkomst. Er wordt niets opgeslagen.</div>
  )}
  <h1 class="page-title" id="ovk-title">Overeenkomst</h1>
  <p class="page-sub" id="ovk-sub">Lees de documenten, onderteken digitaal en lever daarna de gevraagde bestanden aan.</p>

  <div id="ovk-msg" class="palert palert--warn mt-4 hidden" role="alert"></div>

  <!-- Lijst (geen ?id) -->
  <section id="ovk-list" class="mt-6">
    <div class="pskel h-20 w-full"></div>
  </section>

  <!-- Bedrijfsgegevens aanvullen -->
  <section id="ovk-bedrijf" class="pcard mt-6 hidden">
    <div class="pcard-h">Bedrijfsgegevens aanvullen</div>
    <div class="pcard-b">
      <p class="text-sm p-muted">Vul eerst de gegevens van uw bedrijf aan. Ze komen in de overeenkomst te staan. Het KvK-nummer is verplicht, het btw-nummer is optioneel.</p>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        <div>
          <label for="ovk-kvk" class="plabel">KvK-nummer</label>
          <input type="text" id="ovk-kvk" class="pinput" inputmode="numeric" maxlength="8" placeholder="8 cijfers" autocomplete="off" />
        </div>
        <div>
          <label for="ovk-btw" class="plabel">btw-nummer (optioneel)</label>
          <input type="text" id="ovk-btw" class="pinput" maxlength="14" placeholder="NL123456789B01" autocomplete="off" />
        </div>
      </div>
      <button type="button" id="ovk-bedrijf-save" class="pbtn pbtn--primary mt-4">Opslaan en doorgaan</button>
    </div>
  </section>

  <!-- Leesstroom -->
  <section id="ovk-flow" class="mt-6 hidden">
    <ol class="stepper" id="ovk-stepper"></ol>

    <!-- Stap 1-3: document -->
    <div id="ovk-docstep" class="pcard mt-4 hidden">
      <div class="pcard-h">
        <span id="ovk-doctitle"></span>
        <a href="#" id="ovk-pdf-concept" class="p-link text-sm">Download als PDF</a>
      </div>
      <div class="pcard-b">
        <div id="ovk-opties" class="pcard hidden mb-4">
          <div class="pcard-h">Opties</div>
          <div class="pcard-b">
            <label class="flex items-start gap-2 text-sm" style="color:var(--p-ink)">
              <input type="checkbox" id="ovk-opties-check" class="mt-1" />
              <span id="ovk-opties-label"></span>
            </label>
            <p id="ovk-opties-note" class="mt-2 text-xs hidden" style="color:var(--p-ink-4)">Vastgelegd bij je eerste akkoordverklaring.</p>
            <p id="ovk-opties-preview-note" class="mt-2 text-xs hidden" style="color:var(--p-ink-4)">In voorbeeldweergave wordt de tekst niet opnieuw gerenderd.</p>
          </div>
        </div>
        <div class="doc-box" id="ovk-box" tabindex="0"></div>
        <label class="mt-4 flex items-start gap-2 text-sm" style="color:var(--p-ink)">
          <input type="checkbox" id="ovk-check" disabled class="mt-1" />
          <span id="ovk-label"></span>
        </label>
        <p id="ovk-help" class="mt-2 text-xs" style="color:var(--p-ink-4)">Lees het document volledig voordat je akkoord gaat. <span id="ovk-count"></span></p>
        <p id="ovk-consent-info" class="mt-2 text-xs hidden" style="color:#0e6245"></p>
        <div class="mt-4 flex items-center justify-between gap-3">
          <button type="button" id="ovk-back" class="pbtn pbtn--subtle">Terug</button>
          <button type="button" id="ovk-next" class="pbtn pbtn--primary" disabled>Volgende</button>
        </div>
      </div>
    </div>

    <!-- Stap 4: ondertekenen -->
    <div id="ovk-signstep" class="pcard mt-4 hidden">
      <div class="pcard-h">
        <span>Ondertekenen</span>
        <a href="#" id="ovk-pdf-concept2" class="p-link text-sm">Download als PDF</a>
      </div>
      <div class="pcard-b">
        <p class="section-title">Samenvatting</p>
        <ul id="ovk-summary" class="mt-2 space-y-1.5 text-sm"></ul>

        <div class="pcard mt-4">
          <div class="pcard-h">Te betalen bedragen (excl. btw)</div>
          <div class="pcard-b">
            <div id="ovk-totalen" class="space-y-1.5 text-sm" style="color:var(--p-ink)"></div>
            <label class="mt-4 flex items-start gap-2 text-sm" style="color:var(--p-ink)">
              <input type="checkbox" id="ovk-bedragen" class="mt-1" />
              <span id="ovk-bedragen-label"></span>
            </label>
          </div>
        </div>

        <label class="mt-4 flex items-start gap-2 text-sm" style="color:var(--p-ink)">
          <input type="checkbox" id="ovk-aanvaard" class="mt-1" />
          <span id="ovk-aanvaard-label"></span>
        </label>

        <div id="ovk-role-note" class="palert palert--info mt-4 hidden">Alleen de eigenaar van het account kan de overeenkomst ondertekenen.</div>

        <label for="ovk-naam" class="plabel mt-5">Volledige naam</label>
        <input type="text" id="ovk-naam" class="pinput" maxlength="120" placeholder="Typ je volledige naam zoals op de KvK" autocomplete="name" />

        <div class="mt-5 flex items-center justify-between">
          <span class="plabel" style="margin:0">Handtekening</span>
          <button type="button" id="ovk-wis" class="pbtn pbtn--subtle pbtn--sm">Wissen</button>
        </div>
        <canvas id="ovk-canvas" class="sig-canvas mt-2" aria-label="Handtekening tekenen"></canvas>
        <p class="mt-1 text-xs" style="color:var(--p-ink-4)">Teken je handtekening met muis of vinger.</p>

        <label class="mt-5 flex items-start gap-2 text-sm" style="color:var(--p-ink)">
          <input type="checkbox" id="ovk-bevoegd" class="mt-1" />
          <span id="ovk-bevoegd-label"></span>
        </label>

        <div class="mt-5 flex items-center justify-between gap-3">
          <button type="button" id="ovk-back2" class="pbtn pbtn--subtle">Terug</button>
          <button type="button" id="ovk-sign-btn" class="pbtn pbtn--primary" disabled>Ondertekenen</button>
        </div>
      </div>
    </div>

    <!-- Succes -->
    <div id="ovk-done" class="pcard mt-4 hidden">
      <div class="pcard-b text-center" style="padding:32px 20px">
        <p class="page-title">Bedankt, de overeenkomst is ondertekend.</p>
        <p class="page-sub" id="ovk-done-sub"></p>
        <div class="mt-5 flex flex-wrap items-center justify-center gap-3">
          <a href="#" id="ovk-done-pdf" class="pbtn pbtn--subtle">Download als PDF</a>
          <a href="/portal/aanleveren/" id="ovk-done-aanlever" class="pbtn pbtn--primary">Ga naar aanleverlijst</a>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      var MODE = document.getElementById('ovk-root').getAttribute('data-mode') === 'voorbeeld' ? 'voorbeeld' : 'klant';
      var PREVIEW = MODE === 'voorbeeld';
      var PDF = PREVIEW ? '/api/admin/overeenkomst/pdf?id=' : '/api/portal/overeenkomst/pdf?id=';
      var DETAIL = PREVIEW ? '/api/admin/overeenkomst/klantweergave?id=' : '/api/portal/overeenkomst?id=';
      var STEP_TITLES = ['Overeenkomst', 'Algemene voorwaarden', 'Privacy & verwerking', 'Ondertekenen'];
      var STATUS = {
        sent: ['Nog te lezen', 'pbadge--amber'],
        in_progress: ['In behandeling', 'pbadge--blue'],
        signed: ['Ondertekend', 'pbadge--green']
      };
      var agrId = new URLSearchParams(location.search).get('id');
      var data = null;          // GET /api/portal/overeenkomst?id=
      var step = 0;             // 0..2 documents, 3 = ondertekenen
      var docState = {};        // per document: { openLocal, scrolledAt }
      var pointCount = 0;
      var optiesPreviewNote = false; // voorbeeld: show the 'text not re-rendered' note once the option was toggled

      function $(id) { return document.getElementById(id); }
      function esc(s) {
        return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
        });
      }
      function show(id, on) { var el = $(id); if (el) el.classList.toggle('hidden', !on); }
      function msg(text) {
        var el = $('ovk-msg');
        el.textContent = text || '';
        el.classList.toggle('hidden', !text);
        if (text) el.scrollIntoView({ block: 'nearest' });
      }
      function api(path, method, body) {
        // Preview safety net: nothing but GET ever leaves the page.
        if (PREVIEW && method && method !== 'GET') throw new Error('voorbeeld: geen schrijfacties');
        var opt = { method: method || 'GET', credentials: 'same-origin' };
        if (body !== undefined) {
          opt.headers = { 'Content-Type': 'application/json' };
          opt.body = JSON.stringify(body);
        }
        return fetch(path, opt).then(function (r) {
          if (r.status === 401 || (PREVIEW && r.status === 403)) {
            if (window.adminFout && window.adminFout.naarLogin) window.adminFout.naarLogin(); else location.href = PREVIEW ? '/admin' : '/portal/login';
            throw new Error('unauth');
          }
          return r.json().catch(function () { return {}; }).then(function (j) { return { ok: r.ok, status: r.status, j: j }; });
        });
      }
      // Every mutation goes through here; in voorbeeld mode it throws (callers branch to the local simulation first).
      function apiPost(path, body) {
        if (PREVIEW) throw new Error('voorbeeld: geen schrijfacties');
        return api(path, 'POST', body);
      }
      function fail(res, fallback) { msg((res && res.j && res.j.error) || fallback || 'Er ging iets mis. Probeer het opnieuw.'); }
      function euro(n) {
        if (n == null || !isFinite(n)) return '—';
        var whole = Math.abs(n - Math.round(n)) < 0.005;
        return '€ ' + new Intl.NumberFormat('nl-NL', { minimumFractionDigits: whole ? 0 : 2, maximumFractionDigits: whole ? 0 : 2 }).format(whole ? Math.round(n) : n);
      }
      function ts(ms) { return new Date(ms).toLocaleString('nl-NL', { timeZone: 'Europe/Amsterdam', dateStyle: 'short', timeStyle: 'short' }); }
      function dt(ms) { return ms ? new Date(ms).toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' }) : ''; }

      // ── Lijst ────────────────────────────────────────────────
      function loadList() {
        api('/api/portal/overeenkomst/lijst').then(function (res) {
          var box = $('ovk-list');
          if (!res.ok) { box.innerHTML = ''; fail(res, 'Overeenkomsten konden niet worden geladen.'); return; }
          var list = res.j.agreements || [];
          if (!list.length) {
            box.innerHTML = '<div class="pcard"><div class="empty"><p class="empty-title">Nog geen overeenkomst</p><p class="empty-text">Zodra er een overeenkomst voor u klaarstaat, ziet u die hier.</p></div></div>';
            return;
          }
          box.innerHTML = list.map(function (a) {
            var st = STATUS[a.status] || ['Concept', 'pbadge--gray'];
            var when = a.signed_at ? 'Ondertekend op ' + dt(a.signed_at) : (a.sent_at ? 'Verstuurd op ' + dt(a.sent_at) : '');
            return '<a href="/portal/overeenkomst/?id=' + encodeURIComponent(a.id) + '" class="pcard mb-3 block"><div class="pcard-b flex items-center justify-between gap-3">' +
              '<div><div style="color:var(--p-ink);font-weight:600">' + esc(a.title) + '</div><div class="text-xs p-muted mt-1">' + esc(when) + '</div></div>' +
              '<span class="pbadge ' + st[1] + '">' + st[0] + '</span></div></a>';
          }).join('');
        }).catch(function () {});
      }

      // ── Stepper ──────────────────────────────────────────────
      function allConsents() {
        return data.documents.every(function (d) { return !!d.consent; });
      }
      function renderStepper() {
        $('ovk-stepper').innerHTML = STEP_TITLES.map(function (t, i) {
          var cls = i === step ? 'is-active' : ((i < 3 && data.documents[i] && data.documents[i].consent) ? 'is-done' : '');
          var mark = cls === 'is-done' ? '✓' : String(i + 1);
          return '<li class="' + cls + '" data-step="' + i + '"' + '><span class="step-n">' + mark + '</span><span>' + esc(t) + '</span></li>';
        }).join('<li aria-hidden="true" style="color:var(--p-border-strong)">—</li>');
      }

      // ── Documentstap ─────────────────────────────────────────
      function reachedEnd(box) { return box.scrollTop + box.clientHeight >= box.scrollHeight - 24; }
      function readSecs(doc) {
        var st = docState[doc.id];
        return st && st.openLocal ? Math.floor((Date.now() - st.openLocal) / 1000) : 0;
      }
      function updateGate() {
        if (step > 2) return;
        var doc = data.documents[step];
        var chk = $('ovk-check');
        if (doc.consent) return;
        var st = docState[doc.id] || {};
        // Only gate: scrolled to the end (and the server knows the document was
        // opened). No countdown — owner decision 2026-10-09.
        var ready = !!st.scrolledAt && !!st.openLocal;
        chk.disabled = !ready;
        $('ovk-count').textContent = ready || st.scrolledAt ? '' : 'Scroll tot het einde van het document.';
        show('ovk-help', !ready);
      }
      function onScroll() {
        var doc = data.documents[step];
        if (!doc) return;
        var box = $('ovk-box');
        var st = docState[doc.id] || (docState[doc.id] = {});
        if (!st.scrolledAt && reachedEnd(box)) st.scrolledAt = Date.now();
        updateGate();
      }
      function renderDoc() {
        var doc = data.documents[step];
        var st = docState[doc.id] || (docState[doc.id] = {});
        show('ovk-docstep', true);
        show('ovk-signstep', false);
        $('ovk-doctitle').textContent = doc.title + ' (versie ' + doc.version + ')';
        $('ovk-label').textContent = doc.label;
        $('ovk-box').innerHTML = doc.html;
        $('ovk-box').scrollTop = 0;
        $('ovk-pdf-concept').href = PDF + encodeURIComponent(agrId);
        $('ovk-back').classList.toggle('hidden', step === 0);
        renderOpties();
        var chk = $('ovk-check');
        var info = $('ovk-consent-info');
        if (doc.consent) {
          chk.checked = true; chk.disabled = PREVIEW ? false : true;
          show('ovk-help', false);
          info.textContent = 'Akkoord gegeven op ' + new Date(doc.consent.checkbox_at).toLocaleString('nl-NL') + '.';
          show('ovk-consent-info', true);
        } else {
          chk.checked = false; chk.disabled = true;
          show('ovk-consent-info', false);
          show('ovk-help', true);
          if (PREVIEW) {
            // Local simulation: the read timer starts when the document is shown, no /open call.
            if (!st.openLocal) st.openLocal = Date.now();
          } else if (!st.openLocal && !st.opening) {
            st.opening = true;
            apiPost('/api/portal/overeenkomst/open', { document_id: doc.id }).then(function (res) {
              st.opening = false;
              if (res.ok) { st.openLocal = Date.now(); updateGate(); } else { fail(res); }
            }).catch(function () { st.opening = false; });
          }
        }
        $('ovk-next').disabled = !doc.consent;
        $('ovk-next').textContent = step === 2 ? 'Naar ondertekenen' : 'Volgende';
        // Korte documenten zonder scrollbalk: direct "sona" bereikt.
        setTimeout(onScroll, 0);
        updateGate();
      }
      // ── Opties (stap 1) ──────────────────────────────────────
      function renderOpties() {
        var o = data.opties && data.opties.optie_3d;
        var showIt = step === 0 && !!o && (o.prijs != null || o.gekozen);
        show('ovk-opties', showIt);
        if (!showIt) return;
        $('ovk-opties-label').textContent = 'Cinematic 3D-beleving toevoegen (+ ' + euro(o.prijs) + ' excl. btw)';
        var c = $('ovk-opties-check');
        c.checked = !!o.gekozen;
        c.disabled = !o.wijzigbaar;
        show('ovk-opties-note', !o.wijzigbaar);
        show('ovk-opties-preview-note', PREVIEW && optiesPreviewNote);
      }
      function refreshData(done) {
        api(DETAIL + encodeURIComponent(agrId)).then(function (res) {
          if (res.ok) {
            data = res.j;
            // The text of document 1 changed: it has to be scrolled to the end again (the read timer keeps running).
            data.documents.forEach(function (d) { if (d.slug === 'overeenkomst' && docState[d.id]) docState[d.id].scrolledAt = null; });
            renderStepper();
            if (step === 3) renderSign(); else renderDoc();
          } else fail(res);
        }).catch(function () {}).then(function () { if (done) done(); });
      }
      function onOptie() {
        var c = $('ovk-opties-check');
        var want = c.checked;
        if (PREVIEW) {
          // Local simulation: only the displayed amounts change.
          var o = data.opties.optie_3d, t = data.totalen || (data.totalen = {});
          o.gekozen = want;
          var spec = (t.eenmalig_specificatie || []).slice(0, 1);
          if (want) spec.push({ label: 'Cinematic 3D-beleving', bedrag: o.prijs });
          t.eenmalig_specificatie = spec;
          t.eenmalig = spec.length && spec.every(function (r) { return r.bedrag != null; }) ? spec.reduce(function (a, r) { return a + r.bedrag; }, 0) : null;
          optiesPreviewNote = true;
          show('ovk-opties-preview-note', true);
          return;
        }
        c.disabled = true;
        apiPost('/api/portal/overeenkomst/opties', { agreement_id: agrId, optie_3d_gekozen: want }).then(function (res) {
          if (res.ok) { msg(''); refreshData(); } else { fail(res); refreshData(); }
        }).catch(function () { refreshData(); });
      }
      function onCheck() {
        var chk = $('ovk-check');
        var doc = data.documents[step];
        if (PREVIEW) {
          // Local simulation: consent toggles in memory (per document), nothing is stored.
          doc.consent = chk.checked ? { checkbox_at: Date.now() } : null;
          renderStepper();
          $('ovk-next').disabled = !doc.consent;
          if (doc.consent) {
            $('ovk-consent-info').textContent = 'Akkoord gegeven op ' + new Date(doc.consent.checkbox_at).toLocaleString('nl-NL') + '.';
            show('ovk-consent-info', true);
            show('ovk-help', false);
          } else {
            show('ovk-consent-info', false);
            updateGate();
          }
          return;
        }
        if (!chk.checked) return;
        var st = docState[doc.id] || {};
        chk.disabled = true;
        apiPost('/api/portal/overeenkomst/consent', {
          document_id: doc.id,
          scrolled_to_end_at: st.scrolledAt,
          time_on_document_sec: readSecs(doc)
        }).then(function (res) {
          if (res.ok && res.j.consent) {
            msg('');
            doc.consent = res.j.consent;
            renderStepper();
            renderDoc();
          } else {
            chk.checked = false;
            fail(res, 'Lees het document volledig voordat je akkoord gaat.');
            updateGate();
          }
        }).catch(function () { chk.checked = false; updateGate(); });
      }

      // ── Ondertekenen ─────────────────────────────────────────
      var canvas, ctx, drawing = false;
      function sizeCanvas() {
        var dpr = Math.min(window.devicePixelRatio || 1, 2);
        var w = canvas.clientWidth, h = canvas.clientHeight;
        if (!w) return;
        canvas.width = Math.round(w * dpr);
        canvas.height = Math.round(h * dpr);
        ctx = canvas.getContext('2d');
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx.lineWidth = 2.2;
        ctx.lineCap = 'round';
        ctx.lineJoin = 'round';
        ctx.strokeStyle = '#1a1f36';
        pointCount = 0;
      }
      function pos(e) {
        var r = canvas.getBoundingClientRect();
        return { x: e.clientX - r.left, y: e.clientY - r.top };
      }
      function initCanvas() {
        canvas = $('ovk-canvas');
        canvas.addEventListener('pointerdown', function (e) {
          drawing = true;
          try { canvas.setPointerCapture(e.pointerId); } catch (x) {}
          var p = pos(e);
          ctx.beginPath(); ctx.moveTo(p.x, p.y);
          ctx.lineTo(p.x + 0.01, p.y + 0.01); ctx.stroke();
          pointCount++;
          e.preventDefault();
        });
        canvas.addEventListener('pointermove', function (e) {
          if (!drawing) return;
          var p = pos(e);
          ctx.lineTo(p.x, p.y); ctx.stroke();
          ctx.beginPath(); ctx.moveTo(p.x, p.y);
          pointCount++;
          updateSignGate();
          e.preventDefault();
        });
        function stop() { drawing = false; updateSignGate(); }
        canvas.addEventListener('pointerup', stop);
        canvas.addEventListener('pointercancel', stop);
        canvas.addEventListener('pointerleave', stop);
        $('ovk-wis').addEventListener('click', function () { sizeCanvas(); updateSignGate(); });
      }
      function isOwner() { return PREVIEW || !window.__portalUser || !window.__portalUser.role || window.__portalUser.role === 'eigenaar'; }
      function updateSignGate() {
        var ok = $('ovk-naam').value.trim().length >= 4 && pointCount >= 20 && $('ovk-bevoegd').checked && $('ovk-aanvaard').checked && $('ovk-bedragen').checked && isOwner();
        $('ovk-sign-btn').disabled = !ok;
      }
      function renderSign() {
        show('ovk-docstep', false);
        show('ovk-signstep', true);
        $('ovk-pdf-concept2').href = PDF + encodeURIComponent(agrId);
        // The checkboxes mirror the stored per-step consents; they are display-only, not new consents.
        $('ovk-summary').innerHTML = data.documents.map(function (d, i) {
          return '<li class="rounded-md border px-3 py-2" style="border-color:var(--p-border)">' +
            '<div class="flex items-center justify-between gap-3">' +
            '<span style="color:var(--p-ink)">' + esc(d.title) + ' <span class="p-muted">(versie ' + esc(d.version) + ')</span></span>' +
            '<span class="flex items-center gap-3"><a href="#" class="ovk-bekijk p-link text-xs" data-i="' + i + '">Bekijken</a>' +
            '<code class="text-xs p-muted">' + esc(d.sha12) + '</code></span></div>' +
            '<label class="mt-1.5 flex items-center gap-2 text-xs" style="color:var(--p-ink-3)">' +
            '<input type="checkbox" disabled' + (d.consent ? ' checked' : '') + ' /> <span>Gelezen en akkoord' +
            (d.consent ? ' — ' + esc(ts(d.consent.checkbox_at)) : '') + '</span></label></li>';
        }).join('');
        renderTotalen();
        $('ovk-aanvaard-label').textContent = data.acceptance_label;
        $('ovk-bevoegd-label').textContent = data.authorized_label;
        show('ovk-role-note', !isOwner());
        if (!canvas) initCanvas();
        sizeCanvas();
        updateSignGate();
      }
      function renderTotalen() {
        var t = data.totalen || {};
        var l = t.leads || {};
        var spec = (t.eenmalig_specificatie || []).map(function (r) {
          return '<div class="flex justify-between gap-3 pl-4 text-xs" style="color:var(--p-ink-3)"><span>' + esc(r.label) + '</span><span>' + esc(euro(r.bedrag)) + '</span></div>';
        }).join('');
        $('ovk-totalen').innerHTML =
          '<div class="flex justify-between gap-3" style="font-weight:600"><span>Eenmalig</span><span>' + esc(euro(t.eenmalig)) + '</span></div>' + spec +
          '<div class="flex justify-between gap-3"><span>Maandelijks (beheer &amp; groei, vanaf livegang)</span><span>' + esc(euro(t.maandelijks)) + '</span></div>' +
          '<div>Leads: ' + esc(euro(l.per_lead)) + ' per lead · bundel van ' + esc(l.bundel_aantal == null ? '—' : l.bundel_aantal) + ' = ' + esc(euro(l.bundel_prijs)) + '</div>';
        $('ovk-bedragen-label').textContent = data.amounts_label || '';
      }
      function doSign() {
        if (PREVIEW) { msg(''); renderDone(); return; }
        var b = $('ovk-sign-btn');
        b.disabled = true;
        apiPost('/api/portal/overeenkomst/ondertekenen', {
          agreement_id: agrId,
          typed_name: $('ovk-naam').value.trim(),
          signature_png: canvas.toDataURL('image/png'),
          bevoegd: true,
          alles_aanvaard: true,
          bedragen_akkoord: true
        }).then(function (res) {
          if (res.ok) { msg(''); data.agreement.status = 'signed'; data.agreement.signed_at = res.j.signed_at; renderDone(); }
          else { fail(res); updateSignGate(); }
        }).catch(function () { updateSignGate(); });
      }

      // ── Succes ───────────────────────────────────────────────
      function renderDone() {
        show('ovk-docstep', false);
        show('ovk-signstep', false);
        show('ovk-done', true);
        $('ovk-stepper').innerHTML = '';
        if (PREVIEW) {
          $('ovk-done-sub').textContent = 'Voorbeeld: er is niets ondertekend of opgeslagen.';
          show('ovk-done-pdf', false);
          show('ovk-done-aanlever', false);
          return;
        }
        $('ovk-done-sub').textContent = data.agreement.signed_at ? 'Ondertekend op ' + new Date(data.agreement.signed_at).toLocaleString('nl-NL') + '.' : '';
        $('ovk-done-pdf').href = PDF + encodeURIComponent(agrId);
      }

      // ── Start ────────────────────────────────────────────────
      function startFlow() {
        show('ovk-bedrijf', false);
        show('ovk-flow', true);
        if (data.agreement.status === 'signed' && !PREVIEW) { renderDone(); return; }
        step = 3;
        for (var i = 0; i < data.documents.length; i++) { if (!data.documents[i].consent) { step = i; break; } }
        renderStepper();
        if (step === 3) renderSign(); else renderDoc();
      }
      function loadAgreement() {
        api(DETAIL + encodeURIComponent(agrId)).then(function (res) {
          show('ovk-list', false);
          if (!res.ok) { fail(res, 'Deze overeenkomst is niet beschikbaar.'); return; }
          data = res.j;
          if (PREVIEW) {
            // Fresh local simulation: ignore any stored consent state of the real agreement.
            data.documents.forEach(function (d) { d.consent = null; });
            if (data.opties && data.opties.optie_3d) data.opties.optie_3d.wijzigbaar = true;
          }
          $('ovk-title').textContent = data.agreement.title;
          $('ovk-sub').textContent = 'Lees elk document volledig, geef per document akkoord en onderteken daarna.';
          if (!data.bedrijf_compleet && (PREVIEW || data.agreement.status !== 'signed')) {
            $('ovk-kvk').value = (data.customer && data.customer.kvk) || '';
            $('ovk-btw').value = (data.customer && data.customer.btw_id) || '';
            show('ovk-bedrijf', true);
            return;
          }
          startFlow();
        }).catch(function () {});
      }
      function saveBedrijf() {
        if (PREVIEW) { msg(''); startFlow(); return; }
        var b = $('ovk-bedrijf-save');
        b.disabled = true;
        apiPost('/api/portal/overeenkomst/bedrijfsgegevens', {
          kvk: $('ovk-kvk').value.trim(),
          btw_id: $('ovk-btw').value.trim()
        }).then(function (res) {
          if (res.ok) { msg(''); loadAgreement(); } else fail(res, 'Controleer het KvK-nummer en het btw-nummer (optioneel).');
        }).catch(function () {}).then(function () { b.disabled = false; });
      }

      $('ovk-box').addEventListener('scroll', onScroll);
      $('ovk-check').addEventListener('change', onCheck);
      $('ovk-back').addEventListener('click', function () { if (step > 0) { step--; renderStepper(); renderDoc(); } });
      $('ovk-next').addEventListener('click', function () {
        if (!data.documents[step].consent) return;
        if (step < 2) { step++; renderStepper(); renderDoc(); }
        else if (allConsents()) { step = 3; renderStepper(); renderSign(); }
      });
      $('ovk-opties-check').addEventListener('change', onOptie);
      $('ovk-bedragen').addEventListener('change', updateSignGate);
      $('ovk-back2').addEventListener('click', function () { step = 2; renderStepper(); renderDoc(); });
      $('ovk-naam').addEventListener('input', updateSignGate);
      $('ovk-bevoegd').addEventListener('change', updateSignGate);
      $('ovk-aanvaard').addEventListener('change', updateSignGate);
      // "Bekijken": jump to that document's step; consent and checkbox state stay untouched.
      $('ovk-summary').addEventListener('click', function (e) {
        var a = e.target.closest && e.target.closest('.ovk-bekijk');
        if (!a) return;
        e.preventDefault();
        step = Number(a.getAttribute('data-i'));
        renderStepper();
        renderDoc();
      });
      $('ovk-sign-btn').addEventListener('click', doSign);
      $('ovk-bedrijf-save').addEventListener('click', saveBedrijf);
      document.addEventListener('portal:ready', function () {
        if (data && step === 3) { show('ovk-role-note', !isOwner()); updateSignGate(); }
      });

      if (agrId) loadAgreement();
      else if (PREVIEW) { show('ovk-list', false); msg('Geen overeenkomst gekozen.'); }
      else loadList();
    })();
  </script>
</div>
