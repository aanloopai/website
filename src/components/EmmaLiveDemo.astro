---
// Prominente live-demo van Emma (de site-brede ElevenLabs convai-widget).
// Laat bezoekers het product DIRECT ervaren — sterkste conversie + bewijs voor
// een jong AI-voice-bedrijf (horen = geloven, geen testimonials nodig).
// De knop opent best-effort de widget en markeert hem altijd zichtbaar.
---
<section class="section bg-gradient-to-br from-navy via-midnight to-navy text-pearl relative overflow-hidden">
  <div class="absolute inset-0 dot-grid opacity-[0.05]"></div>
  <div class="container-page relative">
    <div class="max-w-3xl mx-auto text-center reveal">
      <span class="pill bg-brand-emerald/15 text-brand-emerald text-[11px] mb-4 inline-flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-brand-emerald animate-pulse"></span> Live demo
      </span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-semibold tracking-tighter text-pearl text-balance">
        Geen demo plannen — praat nú met Emma.
      </h2>
      <p class="mt-5 text-lg text-slate-300 leading-relaxed max-w-2xl mx-auto">
        Emma is onze AI-receptionist. Klik, stel een vraag zoals een echte beller, en hoor zelf hoe natuurlijk het klinkt. Geen account, geen verplichting.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
        <button id="emma-live-btn" type="button" data-vis="demo" class="js-emma-live-trigger btn bg-pearl text-navy hover:bg-white text-base px-7 py-3.5 font-semibold">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11a7 7 0 01-14 0m7 7v3m-3-12a3 3 0 016 0v4a3 3 0 01-6 0V6z"/></svg>
          Start gesprek met Emma
        </button>
        <a href="/gratis-ai-scan/" class="btn border border-slate-600 text-pearl hover:bg-slate-800 text-base px-6 py-3.5">Liever eerst de gratis AI-scan doen</a>
      </div>
      <p id="emma-live-hint" class="mt-4 text-sm text-brand-emerald font-medium hidden">👉 Klik op de microfoon rechtsonder in beeld om het gesprek te starten.</p>
      <p class="mt-3 text-xs text-slate-400">AVG-compliant · EU-data · geen account nodig</p>
    </div>
  </div>

  <script is:inline>
    (function () {
      // Het openen van de widget (laden + gesprek starten) gebeurt site-breed in
      // public/js/boot.js voor elke .js-emma-live-trigger. Hier alleen de visuele
      // hint + markering van de widget, zodat de bezoeker hem altijd vindt.
      document.addEventListener('click', function (ev) {
        var t = ev.target && ev.target.closest ? ev.target.closest('.js-emma-live-trigger') : null;
        if (!t) return;
        var hint = document.getElementById('emma-live-hint');
        if (hint) hint.classList.remove('hidden');
        setTimeout(function () {
          var w = document.querySelector('elevenlabs-convai');
          if (!w) return;
          try {
            w.animate(
              [{ filter: 'drop-shadow(0 0 0 rgba(16,185,129,0))' }, { filter: 'drop-shadow(0 0 22px rgba(16,185,129,0.9))' }, { filter: 'drop-shadow(0 0 0 rgba(16,185,129,0))' }],
              { duration: 1300, iterations: 3 }
            );
          } catch (e) {}
        }, 900);
      });
    })();
  </script>
</section>
