---
// Contextuele interne links onderaan elk kennisbank-artikel.
// Verdeelt link-equity over de ~81 artikelen (cruciaal bij lage DR) + houdt
// bezoekers langer op de site. Gemount in BaseLayout; rendert alleen op
// /kennisbank/<slug>/-pagina's. Zero per-artikel edits.
import { KENNISBANK_ARTICLES as ARTICLES } from '../data/kennisbank-articles';

const m = Astro.url.pathname.match(/^\/kennisbank\/([^/]+)\/?$/);
let related = [];
if (m) {
  const slug = m[1];
  const current = ARTICLES.find((a) => a.slug === slug);
  if (current) {
    const tokens = new Set(slug.split('-').filter((w) => w.length > 3));
    related = ARTICLES
      .filter((a) => a.slug !== slug)
      .map((a) => {
        let score = a.category === current.category ? 2 : 0;
        for (const w of a.slug.split('-')) if (tokens.has(w)) score += 1;
        return { a, score };
      })
      .filter((x) => x.score > 0)
      .sort((x, y) => y.score - x.score || x.a.slug.localeCompare(y.a.slug))
      .slice(0, 6)
      .map((x) => x.a);
  }
}
---
{related.length > 0 && (
  <section class="section-tight border-t border-slate-200 bg-slate-50/50">
    <div class="container-page max-w-4xl mx-auto">
      <p class="eyebrow mb-5">Gerelateerde artikelen</p>
      <ul class="grid sm:grid-cols-2 gap-3">
        {related.map((a) => (
          <li>
            <a href={`/kennisbank/${a.slug}/`} class="group flex items-start gap-3 rounded-xl border border-slate-200 bg-white p-4 hover:border-brand-indigo/40 hover:shadow-sm transition-all">
              <span class="text-[10px] font-semibold uppercase tracking-wide text-brand-indigo bg-brand-indigo/10 rounded px-1.5 py-0.5 whitespace-nowrap mt-0.5">{a.category}</span>
              <span class="text-sm font-medium text-navy leading-snug group-hover:text-brand-indigo transition-colors">{a.title}</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
        <span class="text-slate-400">Direct verder:</span>
        <a href="/diensten/emma/" class="text-brand-indigo font-medium hover:underline">Emma — AI-receptionist</a>
        <a href="/diensten/emma/" class="text-brand-indigo font-medium hover:underline">Emma — WhatsApp-AI</a>
        <a href="/tarieven/" class="text-brand-indigo font-medium hover:underline">Tarieven</a>
        <a href="/gratis-ai-scan/" class="text-brand-indigo font-medium hover:underline">Gratis AI-scan</a>
      </div>
    </div>
  </section>
)}
