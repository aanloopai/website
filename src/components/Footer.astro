  }
</style>

<script>
  // ─── Cookie banner ───
  const banner = document.getElementById('cookie-banner') as HTMLElement;
  const COOKIE_KEY = 'aanloop_cookie_consent';
  let lastFocused: HTMLElement | null = null;

  function showBanner() {
    setTimeout(() => {
      banner?.classList.add('show');
      lastFocused = document.activeElement as HTMLElement;
      (document.getElementById('cookie-accept') as HTMLElement)?.focus();
    }, 800);
  }
  function hideBanner(value: string) {
    banner?.classList.remove('show');
    localStorage.setItem(COOKIE_KEY, value);
    lastFocused?.focus();
  }

  if (!localStorage.getItem(COOKIE_KEY)) {
    showBanner();
  }

  document.getElementById('cookie-accept')?.addEventListener('click', () => hideBanner('all'));
  document.getElementById('cookie-necessary')?.addEventListener('click', () => hideBanner('necessary'));

  // Escape closes with "necessary only" + Tab traps focus inside banner while visible
  banner?.addEventListener('keydown', (e: KeyboardEvent) => {
    if (!banner.classList.contains('show')) return;
    if (e.key === 'Escape') { e.preventDefault(); hideBanner('necessary'); return; }
    if (e.key === 'Tab') {
      const focusables = banner.querySelectorAll<HTMLElement>('a, button');
      if (focusables.length === 0) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    }
  });

  // ─── Newsletter form (Brevo via /api/submit) ───
  const nlForm = document.getElementById('footer-newsletter') as HTMLFormElement;
  const nlSuccess = document.getElementById('newsletter-success') as HTMLElement;
  nlForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const emailEl = document.getElementById('newsletter-email') as HTMLInputElement;
    const email = emailEl?.value;
    if (!email || !email.includes('@')) return;
    const data = new FormData();
    data.append('form_type', 'newsletter');
    data.append('subject', 'Nieuwe nieuwsbrief-aanmelding (footer) — aanloopai.nl');
    data.append('email', email);
    data.append('source', 'Footer newsletter signup');
    try {
      const res = await fetch('/api/submit', { method: 'POST', body: data });
      const json = await res.json();
      if (json.success) {
        nlForm.style.display = 'none';
        nlSuccess?.classList.remove('hidden');
      } else {
        throw new Error(json.message || 'fout');
      }
    } catch (err) {
      console.error('Newsletter signup error:', err);
      alert('Er ging iets mis. Probeer nogmaals of mail hello@aanloopai.nl');
    }
  });
</script>
