<!-- Cookie consent banner -->
<div id="cookie-banner" role="dialog" aria-labelledby="cookie-banner-title" aria-describedby="cookie-banner-desc" aria-modal="true">
  <div class="bg-white border border-slate-200 rounded-2xl shadow-2xl p-6">
