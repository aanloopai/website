</footer>

<!-- Cookie consent banner -->
<div id="cookie-banner" role="dialog" aria-label="Cookie-instellingen" aria-modal="true">
  <div class="bg-white border border-slate-200 rounded-2xl shadow-2xl p-6">
    <div class="flex items-start gap-4">
      <div class="w-10 h-10 flex-shrink-0 rounded-xl bg-brand-amber/10 flex items-center justify-center text-xl">🍪</div>
      <div class="flex-1 min-w-0">
        <h3 class="font-bold text-navy text-sm">Wij gebruiken cookies</h3>
        <p class="mt-1 text-xs text-slate-600 leading-relaxed">
          We gebruiken functionele en analytische cookies om uw ervaring te verbeteren.
          Lees meer in onze <a href="/cookies/" class="underline hover:text-navy">cookieverklaring</a>.
        </p>
        <div class="mt-4 flex flex-wrap gap-2">
          <button id="cookie-accept" class="btn-primary text-xs px-4 py-2">Alles accepteren</button>
          <button id="cookie-necessary" class="btn-outline text-xs px-4 py-2">Alleen noodzakelijk</button>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .footer-link {
    @apply text-sm text-slate-300 hover:text-pearl transition-colors;
  }
</style>

<script>
  // ─── Cookie banner ───
  const banner = document.getElementById('cookie-banner') as HTMLElement;
  const COOKIE_KEY = 'aanloop_cookie_consent';

  function showBanner() {
    setTimeout(() => banner?.classList.add('show'), 800);
  }
  function hideBanner(value: string) {
    banner?.classList.remove('show');
    localStorage.setItem(COOKIE_KEY, value);
  }

  if (!localStorage.getItem(COOKIE_KEY)) {
    showBanner();
  }

  document.getElementById('cookie-accept')?.addEventListener('click', () => hideBanner('all'));
  document.getElementById('cookie-necessary')?.addEventListener('click', () => hideBanner('necessary'));
</script>
