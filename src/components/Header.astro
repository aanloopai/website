<script>
  const progressBar = document.getElementById('scroll-progress') as HTMLElement;
  function updateProgress() {
    const scrollTop = window.scrollY;
    const docHeight = document.documentElement.scrollHeight - window.innerHeight;
    const pct = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
    if (progressBar) progressBar.style.width = pct + '%';
  }
  window.addEventListener('scroll', updateProgress, { passive: true });

  const header = document.getElementById('site-header') as HTMLElement;
  window.addEventListener('scroll', () => {
    if (header) {
      if (window.scrollY > 8) header.classList.add('shadow-sm');
      else header.classList.remove('shadow-sm');
    }
  }, { passive: true });

  const toggle = document.getElementById('mobile-menu-toggle') as HTMLButtonElement;
  const menu = document.getElementById('mobile-menu') as HTMLElement;
  const iconMenu = document.getElementById('icon-menu') as SVGElement;
  const iconClose = document.getElementById('icon-close') as SVGElement;

  toggle?.addEventListener('click', () => {
    const isOpen = !menu.classList.contains('hidden');
    if (isOpen) {
      menu.classList.add('hidden');
      toggle.setAttribute('aria-expanded', 'false');
      iconMenu?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      document.body.style.overflow = '';
    } else {
      menu.classList.remove('hidden');
      toggle.setAttribute('aria-expanded', 'true');
      iconMenu?.classList.add('hidden');
      iconClose?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }
  });

  const currentPath = window.location.pathname;
  document.querySelectorAll('.nav-link, .mobile-nav-link, .mobile-sub-link').forEach((link) => {
    const href = link.getAttribute('href');
    if (href && currentPath === href) {
      link.setAttribute('aria-current', 'page');
    } else if (href && href !== '/' && href.length > 1 && currentPath.startsWith(href)) {
      link.setAttribute('aria-current', 'page');
    }
  });

  document.querySelectorAll('#mobile-menu a').forEach((a) => {
    a.addEventListener('click', () => {
      menu?.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
      iconMenu?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      document.body.style.overflow = '';
    });
  });

  document.querySelectorAll('[data-nav-trigger]').forEach((group) => {
    const button = group.querySelector('button[aria-haspopup="true"]') as HTMLButtonElement | null;
    const panel = group.querySelector('.megamenu') as HTMLElement | null;
    if (!button || !panel) return;

    button.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = group.getAttribute('data-open') === 'true';
      document.querySelectorAll('[data-nav-trigger][data-open="true"]').forEach((other) => {
        if (other !== group) {
          other.setAttribute('data-open', 'false');
          (other.querySelector('button') as HTMLButtonElement)?.setAttribute('aria-expanded', 'false');
        }
      });
      group.setAttribute('data-open', isOpen ? 'false' : 'true');
      button.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
    });

    panel.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'Escape') {
        group.setAttribute('data-open', 'false');
        button.setAttribute('aria-expanded', 'false');
        button.focus();
      }
    });
  });

  document.addEventListener('click', (e) => {
    document.querySelectorAll('[data-nav-trigger][data-open="true"]').forEach((group) => {
      if (!group.contains(e.target as Node)) {
        group.setAttribute('data-open', 'false');
        (group.querySelector('button') as HTMLButtonElement)?.setAttribute('aria-expanded', 'false');
      }
    });

    if (!header?.contains(e.target as Node) && !menu?.classList.contains('hidden')) {
      menu.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
      iconMenu?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      document.body.style.overflow = '';
    }
  });

  // Cleanup body scroll-lock on browser back/forward (popstate) — prevents frozen scroll
  window.addEventListener('popstate', () => {
    document.body.style.overflow = '';
    if (menu && !menu.classList.contains('hidden')) {
      menu.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
      iconMenu?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    }
  });
</script>
