---
// Header — corporate-grade sticky header with mega-menu, SEO SiteNavigationElement schema,
// glassmorphism, and accessible keyboard/touch interactions.

// Owner-eis 2026-10-11, aangescherpt 2026-10-28: op ELKE publieke pagina staat
// bovenaan contact via formulier of e-mail (hello@aanloopai.nl). NERGENS een
// telefoonnummer of WhatsApp-link — guard: test/no-phone-number.test.js.
import { WEBSITE_BUNDEL } from '../data/pricing';
const euro = (n: number) => `€${n.toLocaleString('nl-NL')}`;

const CONTACT_MAIL = 'hello@aanloopai.nl';
const mailHref = `mailto:${CONTACT_MAIL}?subject=${encodeURIComponent('Vraag via aanloopai.nl')}&body=${encodeURIComponent('Hallo, ik kom via aanloopai.nl en heb een vraag over ')}`;
// Op deze pagina's IS het formulier de pagina zelf: geen tweede formulier erbovenop.
const pathNoPanel = new Set(['/contact/', '/demo-aanvragen/', '/aanvragen/']);
const normPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const showQuickForm = !pathNoPanel.has(normPath);

// Master plan Faz 3 (2026-10-25): "Vier diensten. Geen ruis." geldt ook voor het menu.
// Alleen de vier hoofdproducten staan in de hoofdnavigatie; de overige diensten,
// sectoren en de kennisbank zijn bereikbaar via /diensten/, /sectoren/ en de footer
// (die pagina's blijven bestaan en staan in de sitemap).
const dienstenGroups = [
  {
    title: 'Vier diensten',
    items: [
      { label: 'AI-Website Bundel', href: '/diensten/ai-website-bundel-mkb-nederland/', desc: `Website die klanten oplevert: Emma + AI-vindbaarheid + meetpaneel. ${euro(WEBSITE_BUNDEL.setup)} eenmalig + ${euro(WEBSITE_BUNDEL.maand)}/mnd`, badge: 'Meest gekozen' },
      { label: 'Emma — AI Receptionist', href: '/diensten/emma/', desc: 'Neemt telefoon en WhatsApp 24/7 aan en plant afspraken in. V.a. €149/mnd' },
      { label: 'AI-vindbaarheid (GEO)', href: '/ai-vindbaarheid/', desc: 'Gevonden worden in ChatGPT, Gemini & Perplexity. Gratis scan, v.a. €595/mnd' },
      { label: 'Leads kopen', href: '/leads-kopen/', desc: 'Exclusieve leads uit uw regio en branche. Betaal per lead', badge: 'Nieuw' },
    ],
  },
];
const alsoLinks = [
  { label: 'GEO-bureau', href: '/geo-bureau/' },
  { label: 'Resultaten (live)', href: '/resultaten/' },
];

const overItems = [
  { label: 'Over Aanloop AI',  href: '/over/',          desc: 'Founder, missie, KvK 88606902' },
  { label: 'Werkwijze',        href: '/werkwijze/',     desc: 'Van adviesgesprek tot live in 7 werkdagen' },
  { label: 'Ons werk',         href: '/werk/',          desc: 'Sites die wij bouwden, met gemeten resultaat' },
  { label: 'Cases',            href: '/cases/',         desc: 'Voorbeeldscenario per sector' },
  { label: 'Locaties',         href: '/locaties/',      desc: '18 steden in heel Nederland' },
  { label: 'Pers & nieuws',    href: '/pers/',          desc: 'Press kit en updates' },
  { label: 'Contact',          href: '/contact/',       desc: 'Rotterdam · WhatsApp · e-mail' },
  { label: 'Vacatures',        href: '/vacatures/',     desc: 'Werken bij Aanloop AI' },
];

// SEO: ItemList of SiteNavigationElement entries for Google nav understanding (Rich Results-valid)
const navSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  '@id': 'https://aanloopai.nl/#primary-navigation',
  name: 'Hoofdnavigatie Aanloop AI',
  numberOfItems: 6,
  itemListElement: [
    { '@type': 'SiteNavigationElement', position: 1, name: 'Diensten', url: 'https://aanloopai.nl/diensten/' },
    { '@type': 'SiteNavigationElement', position: 2, name: 'Resultaten', url: 'https://aanloopai.nl/resultaten/' },
    { '@type': 'SiteNavigationElement', position: 3, name: 'Tarieven', url: 'https://aanloopai.nl/tarieven/' },
    { '@type': 'SiteNavigationElement', position: 4, name: 'Cases', url: 'https://aanloopai.nl/cases/' },
    { '@type': 'SiteNavigationElement', position: 5, name: 'Over ons', url: 'https://aanloopai.nl/over/' },
    { '@type': 'SiteNavigationElement', position: 6, name: 'Contact', url: 'https://aanloopai.nl/contact/' },
  ],
};
---

<!-- Skip to main content (a11y, WCAG 2.4.1) -->
<a href="#main" class="skip-link">Direct naar hoofdinhoud</a>

<!-- Scroll progress bar -->
<div id="scroll-progress" aria-hidden="true"></div>

<!-- Top utility bar — corporate trust signals (lg+ only) -->
<div class="hidden lg:block bg-midnight text-pearl text-xs">
  <div class="container-page">
    <div class="flex items-center justify-between h-8">
      <div class="flex items-center gap-5 text-slate-300">
        <span class="flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-brand-emerald" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
          <span>AVG-compliant · EU-only data</span>
        </span>
        <span class="text-slate-500">·</span>
        <span>KvK 88606902 · Rotterdam</span>
      </div>
      <div class="flex items-center gap-4 text-slate-300">
        <a href="/gratis-ai-scan/" class="hover:text-pearl transition-colors flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg>
          <span>Gratis AI-scan</span>
        </a>
        <span class="text-slate-500">·</span>
        <span class="flex items-center gap-1.5">
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full rounded-full bg-brand-emerald opacity-75 animate-ping"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-brand-emerald"></span>
          </span>
          <span>Live in 7 werkdagen</span>
        </span>
      </div>
    </div>
  </div>
</div>

<!-- Main header -->
<header id="site-header" class="sticky top-0 z-40 bg-white/85 backdrop-blur-lg border-b border-slate-200/80 transition-all duration-300">
  <div class="container-page">
    <div class="flex items-center justify-between h-18 py-3 gap-4 relative">

      <!-- Logo -->
      <a href="/" class="flex items-center group flex-shrink-0" aria-label="Aanloop AI — naar de homepagina">
        <img
          src="/brand/logo-horizontal-light.svg"
          alt="Aanloop AI"
          width="200"
          height="62"
          class="h-9 sm:h-11 w-auto transition-opacity group-hover:opacity-80"
          loading="eager"
          fetchpriority="high"
        />
      </a>

      <!-- Desktop nav -->
      <nav class="hidden lg:flex items-center gap-0.5 flex-1 justify-center" aria-label="Hoofdnavigatie">

        <!-- Diensten mega-menu -->
        <div class="nav-group" data-nav-trigger>
          <button class="nav-link with-arrow" aria-expanded="false" aria-haspopup="true" aria-controls="megamenu-diensten">
            Diensten
            <svg class="w-3.5 h-3.5 nav-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
          </button>
          <div id="megamenu-diensten" class="megamenu" aria-label="Diensten submenu">
            <div class="megamenu-inner grid lg:grid-cols-[2fr_1fr] gap-10">
              <div class="grid grid-cols-1 gap-8 min-w-[420px]">
                {dienstenGroups.map((group) => (
                  <div>
                    <p class="megamenu-eyebrow">{group.title}</p>
                    <ul class="space-y-1">
                      {group.items.map((item) => (
                        <li>
                          <a href={item.href} class="megamenu-link group">
                            <div class="flex items-start justify-between gap-2">
                              <span class="font-semibold text-navy text-sm group-hover:text-brand-indigo transition-colors">{item.label}</span>
                              {item.badge && <span class="px-1.5 py-0.5 rounded text-[10px] font-semibold bg-brand-indigo/10 text-brand-indigo whitespace-nowrap">{item.badge}</span>}
                            </div>
                            <p class="text-xs text-slate-500 mt-0.5 leading-snug">{item.desc}</p>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
                <p class="text-xs text-slate-500 px-3">
                  Ook: {alsoLinks.map((l, i) => (<><a href={l.href} class="font-medium text-navy hover:text-brand-indigo">{l.label}</a>{i < alsoLinks.length - 1 ? ' · ' : ''}</>))}
                </p>
              </div>
              <aside class="bg-gradient-to-br from-navy to-midnight text-pearl rounded-xl p-6 flex flex-col">
                <p class="text-[11px] font-semibold uppercase tracking-widest text-brand-indigo mb-2">Niet zeker welke?</p>
                <p class="text-lg font-bold leading-tight mb-2">Gratis AI-scan voor uw bedrijf</p>
                <p class="text-sm text-slate-300 mb-5 leading-relaxed">In 30 min advies: welke 1-3 AI-agents leveren uw MKB direct ROI op.</p>
                <ul class="space-y-1.5 text-xs text-slate-300 mb-6">
                  <li class="flex items-center gap-2"><svg class="w-3.5 h-3.5 text-brand-emerald flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>Geen verplichtingen</li>
                  <li class="flex items-center gap-2"><svg class="w-3.5 h-3.5 text-brand-emerald flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>Branche-specifiek advies</li>
                  <li class="flex items-center gap-2"><svg class="w-3.5 h-3.5 text-brand-emerald flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>Concrete ROI-berekening</li>
                </ul>
                <div class="mt-auto flex flex-col gap-2">
                  <a href="/gratis-ai-scan/" class="inline-flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-lg bg-pearl text-navy text-sm font-semibold hover:bg-white transition-colors">Plan AI-scan →</a>
                  <a href="/diensten/" class="text-center text-xs text-slate-300 hover:text-pearl transition-colors">Alle diensten bekijken →</a>
                </div>
              </aside>
            </div>
          </div>
        </div>

        <!-- Resultaten (plain link) -->
        <a href="/resultaten/" class="nav-link">Resultaten</a>

        <!-- Tarieven (plain link) -->
        <a href="/tarieven/" class="nav-link">Tarieven</a>

        <!-- Cases (plain link) -->
        <a href="/cases/" class="nav-link">Cases</a>

        <!-- Over dropdown (compact) -->
        <div class="nav-group nav-group-relative" data-nav-trigger>
          <button class="nav-link with-arrow" aria-expanded="false" aria-haspopup="true" aria-controls="dropdown-over">
            Over
            <svg class="w-3.5 h-3.5 nav-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
          </button>
          <div id="dropdown-over" class="megamenu megamenu-compact" aria-label="Over submenu">
            <div class="dropdown-inner p-3 w-[320px]">
              <ul class="space-y-0.5">
                {overItems.map((item) => (
                  <li>
                    <a href={item.href} class="block px-3 py-2.5 rounded-lg hover:bg-slate-50 transition-colors group">
                      <p class="font-semibold text-navy text-sm group-hover:text-brand-indigo transition-colors">{item.label}</p>
                      <p class="text-xs text-slate-500 mt-0.5">{item.desc}</p>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </nav>

      <!-- CTA group — direct contact options + primary CTA -->
      <div class="flex items-center gap-1 sm:gap-1.5 flex-shrink-0">
        <a href={mailHref} id="header-mail" class="inline-flex items-center justify-center w-9 h-9 sm:w-10 sm:h-10 rounded-xl text-slate-600 hover:text-navy hover:bg-slate-100 transition-all" aria-label={`Stuur ons een e-mail: ${CONTACT_MAIL}`} title={CONTACT_MAIL}>
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        </a>
        <a href="/portal/login/" class="hidden sm:inline-flex items-center justify-center w-10 h-10 rounded-xl text-slate-600 hover:text-navy hover:bg-slate-100 transition-all" aria-label="Klantportaal — inloggen voor klanten" title="Klantportaal">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
        </a>
        {showQuickForm && (
          <button type="button" id="qc-toggle" class="btn-primary text-sm !px-2.5 sm:!px-4 !py-2" aria-expanded="false" aria-controls="quick-contact">
            <svg class="w-4 h-4 hidden sm:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8 10h8M8 14h5M21 12a8 8 0 01-8 8H7l-4 3v-6.5A8 8 0 1121 12z"/></svg>
            <span>Bericht</span>
          </button>
        )}
        <button type="button" class="js-emma-live-trigger btn-outline text-sm hidden min-[1600px]:inline-flex items-center gap-1.5" id="header-emma-live" data-vis="demo" aria-label="Bel Emma nu — live demo van de AI-assistent">
          <span class="relative flex h-2 w-2"><span class="absolute inline-flex h-full w-full rounded-full bg-brand-emerald opacity-75 animate-ping"></span><span class="relative inline-flex h-2 w-2 rounded-full bg-brand-emerald"></span></span>
          Bel Emma nu
        </button>
        <a href="/gratis-ai-scan/" class="btn-primary text-sm hidden sm:inline-flex" id="header-demo-cta">
          Gratis AI-scan
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>

        <!-- Hamburger -->
        <button id="mobile-menu-toggle" class="lg:hidden p-1.5 sm:p-2 text-slate-700 hover:text-navy hover:bg-slate-100 rounded-lg transition-colors" aria-label="Menu openen" aria-expanded="false" aria-controls="mobile-menu">
          <svg id="icon-menu" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
          <svg id="icon-close" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
    </div>
  </div>

  {showQuickForm && (
  <!-- Snel contactformulier — klapt open vanuit de "Bericht"-knop bovenin. Post naar
       dezelfde /api/submit-pijplijn als alle andere formulieren (D1 inbound_leads,
       Telegram, Brevo-notificatie naar hello@aanloopai.nl). -->
  <div id="quick-contact" class="hidden absolute inset-x-0 top-full px-3 pt-2 lg:inset-x-auto lg:right-6 lg:w-[480px]" role="region" aria-label="Snel contact opnemen">
    <div class="rounded-lg border border-slate-200 bg-white p-5 shadow-xl max-h-[calc(100vh-110px)] overflow-y-auto">
      <form id="qc-form" novalidate class="space-y-3">
        <input type="hidden" name="form_type" value="snel" />
        <input type="hidden" name="subject" value="Nieuw snel contactverzoek — Aanloop AI" />
        <input type="hidden" name="pagina" id="qc-page" value="" />
        <input type="hidden" name="interesse" id="qc-interest" value="" />
        <div class="absolute w-px h-px overflow-hidden -m-px p-0 border-0" style="clip:rect(0 0 0 0)" aria-hidden="true">
          <label for="qc-botcheck">Laat dit veld leeg</label>
          <input type="text" id="qc-botcheck" name="botcheck" tabindex="-1" autocomplete="off" />
        </div>
        <div class="flex items-baseline justify-between gap-3">
          <p class="text-base font-bold text-navy">Laat uw gegevens achter, wij bellen of mailen u terug</p>
          <button type="button" id="qc-close" class="text-slate-400 hover:text-navy p-1 -m-1" aria-label="Formulier sluiten">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>
        <div class="flex flex-wrap gap-2" role="group" aria-label="Waar gaat het over? (optioneel)">
          {['AI-receptionist', 'WhatsApp-automatisering', 'Website'].map((chip) => (
            <button type="button" data-qc-chip={chip} aria-pressed="false" class="qc-chip px-3 py-1.5 rounded-full border border-slate-200 text-xs font-medium text-slate-700 hover:border-navy transition-colors">{chip}</button>
          ))}
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label for="qc-naam" class="block text-xs font-medium text-slate-700 mb-1">Naam *</label>
            <input type="text" id="qc-naam" name="naam" required autocomplete="name" class="w-full px-3 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-indigo" />
          </div>
          <div>
            <label for="qc-bedrijf" class="block text-xs font-medium text-slate-700 mb-1">Bedrijf <span class="text-slate-500 font-normal">(optioneel)</span></label>
            <input type="text" id="qc-bedrijf" name="bedrijf" autocomplete="organization" class="w-full px-3 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-indigo" />
          </div>
          <div>
            <label for="qc-tel" class="block text-xs font-medium text-slate-700 mb-1">Telefoon</label>
            <input type="tel" id="qc-tel" name="telefoon" inputmode="tel" autocomplete="tel" class="w-full px-3 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-indigo" />
          </div>
          <div>
            <label for="qc-email" class="block text-xs font-medium text-slate-700 mb-1">E-mail</label>
            <input type="email" id="qc-email" name="email" autocomplete="email" class="w-full px-3 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-indigo" />
          </div>
        </div>
        <p class="text-xs text-slate-500 -mt-1">Telefoon of e-mail invullen is genoeg.</p>
        <div>
          <label for="qc-bericht" class="block text-xs font-medium text-slate-700 mb-1">Bericht <span class="text-slate-500 font-normal">(optioneel)</span></label>
          <textarea id="qc-bericht" name="bericht" rows="2" maxlength="1000" class="w-full px-3 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-indigo resize-none"></textarea>
        </div>
        <p id="qc-error" class="hidden text-sm text-red-600" role="alert"></p>
        <p id="qc-ok" class="hidden text-sm font-medium text-emerald-700" role="status">Bedankt! We hebben uw bericht ontvangen en nemen binnen 1 werkdag contact op.</p>
        <div class="flex flex-wrap items-center gap-3">
          <button type="submit" id="qc-submit" class="btn-primary text-sm">Verstuur</button>
          <p class="text-xs text-slate-500">Door te versturen gaat u akkoord met onze <a href="/privacy/" class="underline">privacyverklaring</a>. Liever direct? Gebruik WhatsApp of e-mail bovenaan.</p>
        </div>
      </form>
    </div>
  </div>
  )}

  <!-- Mobile menu — accordion-style -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-slate-200 bg-white max-h-[calc(100vh-72px)] overflow-y-auto" aria-label="Mobiele navigatie">
    <nav class="container-page py-4 flex flex-col gap-1">
      <!-- Diensten accordion -->
      <details class="mobile-accordion">
        <summary class="mobile-accordion-summary">Diensten<svg class="w-4 h-4 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg></summary>
        <div class="pl-3 pb-2 pt-1 space-y-3">
          {dienstenGroups.map((group) => (
            <div>
              <p class="text-[10px] font-semibold uppercase tracking-widest text-slate-400 px-3 mb-1">{group.title}</p>
              {group.items.map((item) => (
                <a href={item.href} class="mobile-sub-link">{item.label}</a>
              ))}
            </div>
          ))}
          <a href="/diensten/" class="block px-3 py-2 text-sm font-semibold text-brand-indigo hover:bg-slate-50 rounded-lg">Alle diensten →</a>
        </div>
      </details>

      <a href="/resultaten/" class="mobile-nav-link">Resultaten</a>
      <a href="/tarieven/" class="mobile-nav-link">Tarieven</a>
      <a href="/cases/" class="mobile-nav-link">Cases</a>

      <!-- Over accordion -->
      <details class="mobile-accordion">
