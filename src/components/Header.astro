  #scroll-progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 3px;
    width: 0;
    background: linear-gradient(90deg, #4338CA, #E11D48);
    z-index: 50;
    transition: width 80ms linear;
  }

  .h-18 { height: 4.5rem; }

  @media (max-width: 1023px) {
    .megamenu { display: none; }
  }
</style>

<script>
  const progressBar = document.getElementById('scroll-progress') as HTMLElement;
  function updateProgress() {
    const scrollTop = window.scrollY;
    const docHeight = document.documentElement.scrollHeight - window.innerHeight;
    const pct = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
    if (progressBar) progressBar.style.width = pct + '%';
  }
  window.addEventListener('scroll', updateProgress, { passive: true });

  const header = document.getElementById('site-header') as HTMLElement;
  window.addEventListener('scroll', () => {
    if (header) {
      if (window.scrollY > 8) header.classList.add('shadow-sm');
      else header.classList.remove('shadow-sm');
    }
  }, { passive: true });

  const toggle = document.getElementById('mobile-menu-toggle') as HTMLButtonElement;
  const menu = document.getElementById('mobile-menu') as HTMLElement;
  const iconMenu = document.getElementById('icon-menu') as SVGElement;
  const iconClose = document.getElementById('icon-close') as SVGElement;

  toggle?.addEventListener('click', () => {
    const isOpen = !menu.classList.contains('hidden');
    if (isOpen) {
      menu.classList.add('hidden');
      toggle.setAttribute('aria-expanded', 'false');
      iconMenu?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      document.body.style.overflow = '';
    } else {
      menu.classList.remove('hidden');
      toggle.setAttribute('aria-expanded', 'true');
      iconMenu?.classList.add('hidden');
      iconClose?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }
  });

  const currentPath = window.location.pathname;
  document.querySelectorAll('.nav-link, .mobile-nav-link, .mobile-sub-link').forEach((link) => {
    const href = link.getAttribute('href');
    if (href && currentPath === href) {
      link.setAttribute('aria-current', 'page');
    } else if (href && href !== '/' && href.length > 1 && currentPath.startsWith(href)) {
      link.setAttribute('aria-current', 'page');
    }
  });

  document.querySelectorAll('#mobile-menu a').forEach((a) => {
    a.addEventListener('click', () => {
      menu?.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
      iconMenu?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      document.body.style.overflow = '';
    });
  });

  document.querySelectorAll('[data-nav-trigger]').forEach((group) => {
    const button = group.querySelector('button[aria-haspopup="true"]') as HTMLButtonElement | null;
    const panel = group.querySelector('.megamenu') as HTMLElement | null;
    if (!button || !panel) return;

    button.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = group.getAttribute('data-open') === 'true';
      document.querySelectorAll('[data-nav-trigger][data-open="true"]').forEach((other) => {
        if (other !== group) {
          other.setAttribute('data-open', 'false');
          (other.querySelector('button') as HTMLButtonElement)?.setAttribute('aria-expanded', 'false');
        }
      });
      group.setAttribute('data-open', isOpen ? 'false' : 'true');
      button.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
    });

    panel.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'Escape') {
        group.setAttribute('data-open', 'false');
        button.setAttribute('aria-expanded', 'false');
        button.focus();
      }
    });
  });

  document.addEventListener('click', (e) => {
    document.querySelectorAll('[data-nav-trigger][data-open="true"]').forEach((group) => {
      if (!group.contains(e.target as Node)) {
        group.setAttribute('data-open', 'false');
        (group.querySelector('button') as HTMLButtonElement)?.setAttribute('aria-expanded', 'false');
      }
    });

    if (!header?.contains(e.target as Node) && !menu?.classList.contains('hidden')) {
      menu.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
      iconMenu?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      document.body.style.overflow = '';
    }
  });

  // Cleanup body scroll-lock on browser back/forward (popstate) — prevents frozen scroll
  window.addEventListener('popstate', () => {
    document.body.style.overflow = '';
    if (menu && !menu.classList.contains('hidden')) {
      menu.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
      iconMenu?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    }
  });
</script>

<script>
  // Snel contactformulier (zie #quick-contact). Eigen script-blok: raakt het
  // hamburger-gedrag hierboven niet aan.
  (() => {
    const toggle = document.getElementById('qc-toggle') as HTMLButtonElement | null;
    const panel = document.getElementById('quick-contact') as HTMLElement | null;
    const form = document.getElementById('qc-form') as HTMLFormElement | null;
    if (!toggle || !panel || !form) return;
    const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
    const err = document.getElementById('qc-error') as HTMLElement;
    const ok = document.getElementById('qc-ok') as HTMLElement;
    const submit = document.getElementById('qc-submit') as HTMLButtonElement;
    const chips = Array.from(panel.querySelectorAll<HTMLButtonElement>('[data-qc-chip]'));

    function setOpen(open: boolean) {
      panel!.classList.toggle('hidden', !open);
      toggle!.setAttribute('aria-expanded', String(open));
      if (open) {
        $('qc-page').value = location.pathname;
        (window as any)._track?.('quick_contact_open', { page: location.pathname });
        setTimeout(() => $('qc-naam').focus(), 0);
      }
    }
    toggle.addEventListener('click', () => setOpen(panel!.classList.contains('hidden')));
    document.getElementById('qc-close')?.addEventListener('click', () => { setOpen(false); toggle!.focus(); });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel!.classList.contains('hidden')) { setOpen(false); toggle!.focus(); }
    });
    chips.forEach((c) => c.addEventListener('click', () => {
      const on = c.getAttribute('aria-pressed') !== 'true';
      c.setAttribute('aria-pressed', String(on));
      c.classList.toggle('bg-navy', on); c.classList.toggle('text-white', on); c.classList.toggle('border-navy', on);
      $('qc-interest').value = chips.filter((x) => x.getAttribute('aria-pressed') === 'true').map((x) => x.dataset.qcChip).join(', ');
    }));

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      err.classList.add('hidden'); ok.classList.add('hidden');
      const naam = $('qc-naam').value.trim();
      const tel = $('qc-tel').value.trim();
      const mail = $('qc-email').value.trim();
      const telOk = tel.replace(/\D/g, '').length >= 8;
      const mailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(mail);
      let msg = '';
      if (!naam) msg = 'Vul uw naam in.';
      else if (!telOk && !mailOk) msg = 'Vul een telefoonnummer of een geldig e-mailadres in.';
      else if (mail && !mailOk) msg = 'Dit e-mailadres lijkt niet te kloppen.';
      if (msg) { err.textContent = msg; err.classList.remove('hidden'); return; }
      submit.disabled = true; submit.textContent = 'Verzenden...';
      const ctrl = new AbortController();
      const tid = setTimeout(() => ctrl.abort(), 30000);
      try {
        const res = await fetch('/api/submit', { method: 'POST', body: new FormData(form), signal: ctrl.signal });
        clearTimeout(tid);
        const json = await res.json().catch(() => ({} as any));
        if (!res.ok || !json.success) throw new Error(json.message || 'HTTP ' + res.status);
        (window as any)._track?.('generate_lead', { form_name: 'quick_contact' });
        form.reset();
        chips.forEach((c) => { c.setAttribute('aria-pressed', 'false'); c.classList.remove('bg-navy', 'text-white', 'border-navy'); });
        ok.classList.remove('hidden');
        submit.textContent = 'Verstuurd';
      } catch (ex: any) {
        clearTimeout(tid);
        err.textContent = (ex?.name === 'AbortError' ? 'Het versturen duurt te lang.' : 'Versturen mislukt.') + ' Probeer het opnieuw, of gebruik WhatsApp of mail naar hello@aanloopai.nl.';
        err.classList.remove('hidden');
        submit.disabled = false; submit.textContent = 'Verstuur';
      }
    });
  })();
</script>
