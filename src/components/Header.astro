---
// Header — corporate-grade sticky header with mega-menu, SEO SiteNavigationElement schema,
// glassmorphism, and accessible keyboard/touch interactions.

const dienstenGroups = [
  {
    title: 'Websites & Webshops',
    items: [
      { label: 'AI-Website Bundel', href: '/diensten/ai-website-bundel-mkb-nederland/', desc: 'Website + Marco + Emma in 1 pakket', badge: 'Meest waardevol' },
      { label: 'Website laten maken', href: '/diensten/website-laten-maken-mkb-nederland-2026/', desc: 'AI-ready website v.a. €2.950 setup' },
      { label: 'Webshop laten maken', href: '/diensten/webshop-laten-maken-shopify-woocommerce-nederland-2026/', desc: 'Shopify/WooCommerce/Lightspeed, iDeal+PostNL' },
      { label: 'AI Chatbot voor Website', href: '/diensten/ai-chatbot-website/', desc: 'Toevoegen aan bestaande website' },
    ],
  },
  {
    title: 'Voice & telefonie',
    items: [
      { label: 'Marco — AI Receptionist', href: '/diensten/marco/', desc: '24/7 telefoon aanneemt, plant afspraken in', badge: 'Meest gekozen' },
      { label: 'AI Telefoon Assistent', href: '/diensten/telefoon-assistent/', desc: 'Inkomende calls automatisch verwerken' },
      { label: 'AI Afspraken Inplannen', href: '/diensten/ai-afspraken-inplannen/', desc: 'Direct in Google / Outlook agenda' },
      { label: 'AI Verkoopagent Outbound', href: '/diensten/ai-verkoopagent-outbound/', desc: 'Cold calling en lead-followup' },
    ],
  },
  {
    title: 'Chat & messaging',
    items: [
      { label: 'Emma — WhatsApp Agent', href: '/diensten/emma/', desc: 'Klantvragen op WhatsApp in seconden' },
      { label: 'AI Klantenservice Omnichannel', href: '/diensten/ai-klantenservice-omnichannel/', desc: 'Telefoon, chat, WhatsApp én e-mail' },
      { label: 'AI E-mail Assistent', href: '/diensten/ai-email-assistent/', desc: 'Auto-sortering en antwoorden Gmail/Outlook' },
    ],
  },
  {
    title: 'Workflow automatisering',
    items: [
      { label: 'AI Document Processing', href: '/diensten/ai-document-processing/', desc: 'Facturen + contracten automatisch uitlezen' },
      { label: 'AI Lead Qualification', href: '/diensten/ai-lead-qualification/', desc: 'BANT-screening van elke aanvraag' },
      { label: 'AI HR & Recruitment', href: '/diensten/ai-hr-recruitment/', desc: 'CV-screening en intake-gesprekken' },
      { label: 'AI SEO Content Generator', href: '/diensten/ai-seo-content-generator/', desc: 'Nederlandse content op schaal' },
      { label: 'AI Social Media Agent', href: '/diensten/ai-social-media-agent/', desc: 'Posts, replies en planning' },
    ],
  },
];

const sectoren = [
  { label: 'Horeca & restaurants',         href: '/sectoren/horeca/',           emoji: '🍽️' },
  { label: 'Logistiek & Transport',        href: '/sectoren/logistiek/',        emoji: '🚚' },
  { label: 'Vastgoed & Makelaars',         href: '/sectoren/vastgoed/',         emoji: '🏠' },
  { label: 'Detailhandel & E-commerce',    href: '/sectoren/detailhandel/',     emoji: '🛍️' },
  { label: 'Zakelijke dienstverlening',    href: '/sectoren/zakelijk/',         emoji: '💼' },
  { label: 'Zorg & Welzijn',               href: '/sectoren/zorg/',             emoji: '🏥' },
  { label: 'Accountancy & Financieel',     href: '/sectoren/accountancy/',      emoji: '📊' },
  { label: 'Bouw & Installatie',           href: '/sectoren/bouw/',             emoji: '🏗️' },
  { label: 'Juridisch & Advocatuur',       href: '/sectoren/ai-voor-advocaten/', emoji: '⚖️' },
  { label: 'ZZP & Freelancers',            href: '/sectoren/ai-voor-zzp/',      emoji: '👤' },
  { label: 'Webshops & Online Retail',     href: '/sectoren/ai-voor-webshops/', emoji: '🛒' },
];

const kennisbank = [
  {
    title: 'Pillar gidsen',
    items: [
      { label: 'AI Receptionist Nederland',   href: '/ai-receptionist-nederland/' },
      { label: 'AI Telefonie Compleet 2026',  href: '/ai-telefonie-compleet-gids-nederland-2026/' },
      { label: 'AI voor Administratie',       href: '/ai-voor-administratie-boekhouding-mkb-nederland/' },
      { label: 'AI voor Zorg MKB',            href: '/ai-voor-zorg-mkb-nederland/' },
    ],
  },
  {
    title: 'Vergelijkingen',
    items: [
      { label: 'Marco vs Voiceflow',          href: '/vergelijk/marco-vs-voiceflow/' },
      { label: 'Emma vs Trengo',              href: '/vergelijk/emma-vs-trengo/' },
      { label: 'AI vs callcenter',            href: '/vergelijk/ai-receptionist-vs-callcenter/' },
      { label: 'Marco vs Make.com Voice',     href: '/vergelijk/marco-vs-make-com-voice/' },
    ],
  },
  {
    title: 'Tools & resources',
    items: [
      { label: 'Glossarium · 80+ AI termen',   href: '/glossarium/' },
      { label: 'AI ROI Calculator',            href: '/ai-roi-calculator/' },
      { label: 'AVG-checklist AI MKB',         href: '/avg-checklist-ai-mkb/' },
      { label: 'Veelgestelde vragen',          href: '/veelgestelde-vragen/' },
    ],
  },
];

const overItems = [
  { label: 'Over Aanloop AI',  href: '/over/',          desc: 'Founder, missie, KvK 88606902' },
  { label: 'Werkwijze',        href: '/werkwijze/',     desc: 'Van adviesgesprek tot live in 14 dagen' },
  { label: 'Cases',            href: '/cases/',         desc: 'Voorbeeldscenario per sector' },
  { label: 'Locaties',         href: '/locaties/',      desc: '18 steden in heel Nederland' },
  { label: 'Pers & nieuws',    href: '/pers/',          desc: 'Press kit en updates' },
  { label: 'Contact',          href: '/contact/',       desc: 'Rotterdam · WhatsApp · e-mail' },
  { label: 'Vacatures',        href: '/vacatures/',     desc: 'Werken bij Aanloop AI' },
];

// SEO: ItemList of SiteNavigationElement entries for Google nav understanding (Rich Results-valid)
const navSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  '@id': 'https://aanloopai.nl/#primary-navigation',
  name: 'Hoofdnavigatie Aanloop AI',
  numberOfItems: 7,
  itemListElement: [
    { '@type': 'SiteNavigationElement', position: 1, name: 'Diensten', url: 'https://aanloopai.nl/diensten/' },
    { '@type': 'SiteNavigationElement', position: 2, name: 'Sectoren', url: 'https://aanloopai.nl/sectoren/' },
    { '@type': 'SiteNavigationElement', position: 3, name: 'Kennisbank', url: 'https://aanloopai.nl/kennisbank/' },
    { '@type': 'SiteNavigationElement', position: 4, name: 'Tarieven', url: 'https://aanloopai.nl/tarieven/' },
    { '@type': 'SiteNavigationElement', position: 5, name: 'Cases', url: 'https://aanloopai.nl/cases/' },
    { '@type': 'SiteNavigationElement', position: 6, name: 'Over ons', url: 'https://aanloopai.nl/over/' },
    { '@type': 'SiteNavigationElement', position: 7, name: 'Contact', url: 'https://aanloopai.nl/contact/' },
  ],
};
---

<!-- Skip to main content (a11y, WCAG 2.4.1) -->
<a href="#main" class="skip-link">Direct naar hoofdinhoud</a>

<!-- Scroll progress bar -->
<div id="scroll-progress" aria-hidden="true"></div>

<!-- Top utility bar — corporate trust signals (lg+ only) -->
<div class="hidden lg:block bg-midnight text-pearl text-xs">
  <div class="container-page">
    <div class="flex items-center justify-between h-8">
      <div class="flex items-center gap-5 text-slate-300">
        <a href="tel:+31624741597" class="flex items-center gap-1.5 hover:text-pearl transition-colors">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          <span class="font-medium">+31 6 24 74 15 97</span>
        </a>
        <span class="text-slate-500">·</span>
        <span class="flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-brand-emerald" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
          <span>AVG-compliant · EU-only data</span>
        </span>
        <span class="text-slate-500">·</span>
        <span>KvK 88606902 · Rotterdam</span>
      </div>
      <div class="flex items-center gap-4 text-slate-300">
        <a href="/gratis-ai-scan/" class="hover:text-pearl transition-colors flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg>
          <span>Gratis AI-scan</span>
        </a>
        <a href="https://wa.me/31624741597" class="hover:text-pearl transition-colors flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
