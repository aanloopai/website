---
// Header component — sticky, glassmorphism, with mobile menu
---

<!-- Scroll progress bar -->
<div id="scroll-progress" aria-hidden="true"></div>

<header id="site-header" class="sticky top-0 z-40 bg-white/80 backdrop-blur-lg border-b border-slate-200/80 transition-all duration-300">
  <div class="container-page">
    <div class="flex items-center justify-between h-18 py-4">

      <!-- Logo -->
      <a href="/" class="flex items-center group" aria-label="Aanloop AI — naar de homepagina">
        <img
          src="/brand/logo-horizontal-light.svg"
          alt="Aanloop AI"
          width="160"
          height="50"
          class="h-9 w-auto transition-opacity group-hover:opacity-80"
          loading="eager"
          fetchpriority="high"
        />
      </a>

      <!-- Desktop nav -->
      <nav class="hidden lg:flex items-center gap-1" aria-label="Hoofdnavigatie">
        <a href="/diensten/" class="nav-link">Diensten</a>
        <a href="/sectoren/" class="nav-link">Sectoren</a>
        <a href="/cases/" class="nav-link">Cases</a>
        <a href="/werkwijze/" class="nav-link">Werkwijze</a>
        <a href="/tarieven/" class="nav-link">Tarieven</a>
        <a href="/over/" class="nav-link">Over ons</a>
      </nav>

      <!-- CTA group -->
      <div class="flex items-center gap-3">
        <a href="/contact/" class="hidden md:inline-flex btn-ghost text-sm">
          Contact
        </a>
        <a href="/contact/?type=demo" class="btn-primary text-sm" id="header-demo-cta">
          Boek een demo
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>

        <!-- Hamburger -->
        <button
          id="mobile-menu-toggle"
          class="lg:hidden p-2 text-slate-700 hover:text-navy hover:bg-slate-100 rounded-lg transition-colors"
          aria-label="Menu openen"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg id="icon-menu" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="icon-close" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden lg:hidden border-t border-slate-200 bg-white/95 backdrop-blur-lg"
    aria-label="Mobiele navigatie"
  >
    <nav class="container-page py-4 flex flex-col gap-1">
      <a href="/diensten/" class="mobile-nav-link">Diensten</a>
      <a href="/sectoren/" class="mobile-nav-link">Sectoren</a>
      <a href="/cases/" class="mobile-nav-link">Cases</a>
      <a href="/werkwijze/" class="mobile-nav-link">Werkwijze</a>
      <a href="/tarieven/" class="mobile-nav-link">Tarieven</a>
      <a href="/over/" class="mobile-nav-link">Over ons</a>
      <a href="/contact/" class="mobile-nav-link">Contact</a>
      <div class="pt-3 border-t border-slate-100 mt-2">
        <a href="/contact/?type=demo" class="btn-primary w-full text-center justify-center">
          Boek een gratis demo
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </nav>
  </div>
</header>

<style>
  .nav-link {
    @apply px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200 text-slate-600 hover:text-navy hover:bg-slate-50 relative;
  }
  /* Active state — highlight current page */
  .nav-link[aria-current="page"] {
    @apply text-navy bg-slate-50;
  }
  .mobile-nav-link {
    @apply px-4 py-3 rounded-lg text-sm font-medium transition-colors text-slate-700 hover:bg-slate-50 hover:text-navy;
  }
</style>

<script>
  // ─── Scroll progress bar ───
  const progressBar = document.getElementById('scroll-progress') as HTMLElement;
  function updateProgress() {
    const scrollTop = window.scrollY;
    const docHeight = document.documentElement.scrollHeight - window.innerHeight;
    const pct = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
    if (progressBar) progressBar.style.width = pct + '%';
  }
  window.addEventListener('scroll', updateProgress, { passive: true });

  // ─── Header shadow on scroll ───
  const header = document.getElementById('site-header') as HTMLElement;
  window.addEventListener('scroll', () => {
    if (header) {
      if (window.scrollY > 8) {
        header.classList.add('shadow-sm');
      } else {
        header.classList.remove('shadow-sm');
      }
    }
  }, { passive: true });

  // ─── Mobile menu ───
  const toggle = document.getElementById('mobile-menu-toggle') as HTMLButtonElement;
  const menu = document.getElementById('mobile-menu') as HTMLElement;
  const iconMenu = document.getElementById('icon-menu') as SVGElement;
  const iconClose = document.getElementById('icon-close') as SVGElement;

  toggle?.addEventListener('click', () => {
    const isOpen = !menu.classList.contains('hidden');
    if (isOpen) {
      menu.classList.add('hidden');
      toggle.setAttribute('aria-expanded', 'false');
      iconMenu?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    } else {
      menu.classList.remove('hidden');
      toggle.setAttribute('aria-expanded', 'true');
      iconMenu?.classList.add('hidden');
      iconClose?.classList.remove('hidden');
    }
  });

  // ─── Active nav link ───
  const currentPath = window.location.pathname;
  document.querySelectorAll('.nav-link, .mobile-nav-link').forEach((link) => {
    const href = link.getAttribute('href');
    if (href && currentPath.startsWith(href) && href !== '/') {
      link.setAttribute('aria-current', 'page');
      link.classList.add('text-navy', 'bg-slate-50');
    } else if (href === '/' && currentPath === '/') {
      link.setAttribute('aria-current', 'page');
    }
  });

  // ─── Close mobile menu when clicking outside ───
  document.addEventListener('click', (e) => {
    if (!header?.contains(e.target as Node) && !menu?.classList.contains('hidden')) {
      menu.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
      iconMenu?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    }
  });
</script>
