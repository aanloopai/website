    z-index: 50;
    width: max-content;
    max-width: min(1100px, calc(100vw - 32px));
    transform: translateY(-4px);
  }
  
  .megamenu-compact {
    left: auto;
    right: -10px;
    margin: 0;
  }
  
  .nav-group:hover > .megamenu,
  .nav-group:focus-within > .megamenu,
  .nav-group[data-open="true"] > .megamenu {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }
  .megamenu-inner {
    @apply bg-white border border-slate-200 rounded-2xl shadow-2xl shadow-slate-900/10 p-7;
    width: 100%;
  }
  .megamenu-compact .dropdown-inner {
    @apply bg-white border border-slate-200 rounded-2xl shadow-2xl shadow-slate-900/10;
