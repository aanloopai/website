<style>
  .skip-link {
    @apply absolute left-4 top-4 z-50 px-4 py-2 bg-navy text-white rounded-lg text-sm font-medium opacity-0 -translate-y-12 transition-all;
  }
  .skip-link:focus {
    @apply opacity-100 translate-y-0;
  }

  .nav-link {
    @apply px-3.5 py-2 rounded-lg text-sm font-medium transition-all duration-200 text-slate-700 hover:text-navy hover:bg-slate-100/70 inline-flex items-center gap-1;
  }
  .nav-link[aria-current="page"] {
    @apply text-navy bg-slate-100/80;
  }
  .nav-link.with-arrow .nav-chevron {
    @apply transition-transform duration-200 text-slate-400;
  }
  .nav-group[data-open="true"] > .nav-link .nav-chevron,
  .nav-group:hover > .nav-link .nav-chevron {
    @apply rotate-180 text-navy;
  }
  .nav-group[data-open="true"] > .nav-link,
  .nav-group:hover > .nav-link {
    @apply text-navy bg-slate-100/70;
  }

  .nav-group-relative {
    position: relative;
  }
  .megamenu {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    margin: 0 auto;
    opacity: 0;
    pointer-events: none;
    transition: opacity 160ms ease-out, transform 160ms ease-out;
    z-index: 50;
    width: max-content;
    max-width: min(1100px, calc(100vw - 32px));
    transform: translateY(-4px);
  }
  
  .megamenu-compact {
    left: auto;
    right: -10px;
    margin: 0;
  }
  
  .nav-group:hover > .megamenu,
  .nav-group:focus-within > .megamenu,
  .nav-group[data-open="true"] > .megamenu {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }
  .megamenu-inner {
    @apply bg-white border border-slate-200 rounded-lg shadow-2xl shadow-slate-900/10 p-7;
    width: 100%;
  }
  .megamenu-compact .dropdown-inner {
    @apply bg-white border border-slate-200 rounded-lg shadow-2xl shadow-slate-900/10;
  }

  .megamenu-eyebrow {
    @apply text-[10px] font-bold uppercase tracking-[0.12em] text-slate-400 mb-3;
  }
  .megamenu-link {
    @apply block px-3 py-2 -mx-3 rounded-lg hover:bg-slate-50 transition-colors;
  }
  .megamenu-link-compact {
    @apply block px-3 py-2 -mx-3 rounded-lg text-sm text-slate-700 hover:text-navy hover:bg-slate-50 transition-colors font-medium;
