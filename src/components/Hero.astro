---
// Hero — premium animated hero section
import { getImage } from 'astro:assets';
import { HERO_IMAGE, HERO_IMAGE_OPTIONS, HERO_MEDIA, HERO_PLACEHOLDER } from '../data/hero-image';

// Handmatige <picture> in plaats van <Image>: met één <img> haalde ook mobiel de
// hero op (sizes viel daar terug op 100vw) terwijl het blok op `hidden lg:block`
// staat en daar dus nooit zichtbaar is. Nu matcht de bron pas vanaf 1024px.
const heroImage = await getImage({ src: HERO_IMAGE, ...HERO_IMAGE_OPTIONS });
---

<section class="relative overflow-hidden hero-gradient min-h-[90vh] flex items-center">
  <!-- Dot grid overlay -->
  <div class="absolute inset-0 -z-10 dot-grid opacity-[0.035]"></div>

  <!-- Floating accent blobs -->
  <div class="absolute -top-32 -right-32 w-[600px] h-[600px] rounded-full bg-brand-indigo/5 blur-3xl -z-10 float-badge" style="animation-duration: 7s;"></div>
  <div class="absolute -bottom-32 -left-32 w-[400px] h-[400px] rounded-full bg-brand-rose/5 blur-3xl -z-10 float-badge" style="animation-duration: 9s; animation-delay: 1s;"></div>

  <div class="container-page pt-20 pb-24 lg:pt-28 lg:pb-36 w-full">
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-12 items-center">
    <div class="lg:col-span-7 max-w-5xl">

      <!-- Eyebrow -->
      <div class="flex items-center gap-4 mb-8 reveal">
        <div class="accent-band">
          <span></span><span></span><span></span><span></span>
        </div>
        <span class="eyebrow">AI-receptionist voor telefoon + WhatsApp · Nederlands MKB · Rotterdam</span>
      </div>

      <!-- H1 -->
      <h1 class="text-4xl sm:text-5xl lg:text-7xl font-bold tracking-tightest text-navy text-balance leading-[1.05] reveal reveal-delay-1">
        AI bureau dat <em class="not-italic relative">
          <span id="hero-typed" style="display:inline-block;min-width:14ch">écht werkt</span>
          <svg class="absolute -bottom-2 left-0 w-full" viewBox="0 0 240 12" preserveAspectRatio="none" aria-hidden="true">
            <path d="M2 8 Q 60 2, 120 6 T 238 5" fill="none" stroke="#E11D48" stroke-width="3" stroke-linecap="round" />
          </svg>
        </em><br />voor uw bedrijf.
      </h1>

      <!-- Pricing — prominent -->
      <div class="mt-6 reveal reveal-delay-2">
        <a href="/tarieven/" class="group inline-flex items-baseline gap-2 hover:opacity-90 transition-opacity">
          <span class="text-sm font-semibold uppercase tracking-wide text-slate-500">Vanaf</span>
          <span class="text-5xl lg:text-6xl font-extrabold tracking-tightest text-brand-indigo leading-none">€497</span>
          <span class="text-xl font-bold text-slate-500">/mnd</span>
        </a>
        <p class="mt-2 text-sm font-medium text-slate-500">Live in 7 werkdagen · setup op aanvraag</p>
      </div>

      <!-- Subheadline -->
      <p class="mt-6 text-lg lg:text-xl text-slate-600 leading-relaxed text-pretty max-w-2xl reveal reveal-delay-2">
        Aanloop AI is het AI bureau voor het Nederlandse MKB. Van AI-receptionist die uw telefoon 24/7 aanneemt, tot WhatsApp-assistent en workflow automatisering — wij leveren kant-en-klare AI agents en custom oplossingen voor ondernemers in heel Nederland.
      </p>

      <!-- CTAs — primair (gratis AI-scan, direct resultaat, geen boeking nodig) + secundair
           (demo boeken). "Bekijk tarieven" is een tekstlink eronder, geen derde knop. -->
      <div class="mt-10 flex flex-col sm:flex-row gap-3 reveal reveal-delay-3">
        <a href="/gratis-ai-scan/" class="btn-primary text-base px-6 py-3.5" id="hero-scan-btn">
          Gratis AI-scan — direct resultaat
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
        <a href="/demo-aanvragen/" class="btn-outline text-base px-6 py-3.5" id="hero-demo-btn">
          Boek een gratis demo
        </a>
      </div>
      <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 reveal reveal-delay-3">
        <a href="/tarieven/" class="text-sm font-medium text-slate-500 hover:text-brand-indigo underline underline-offset-2 transition-colors" id="hero-tarieven-btn">
          Bekijk tarieven →
        </a>
        <button type="button" id="hero-emma-live-btn" class="js-emma-live-trigger inline-flex items-center gap-1.5 text-sm font-medium text-brand-indigo hover:text-navy transition-colors">
          🎙️ Praat nú met Emma — geen account nodig
        </button>
      </div>

      <div class="mt-12 flex flex-wrap items-center gap-x-8 gap-y-3 text-sm text-slate-500 reveal reveal-delay-4">
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-brand-emerald" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span>AVG-compliant · EU data</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-brand-emerald" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span>Live binnen 7 werkdagen</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-brand-emerald" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span>Geen verborgen kosten</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-brand-emerald" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span>Rotterdam · heel Nederland</span>
        </div>
      </div>
    </div>

      <!-- Hero visual: Emma-gesprek op WhatsApp (right column on lg+) — toont het product zelf,
           i.p.v. een abstracte AI-illustratie die niet duidelijk maakte wat Emma doet. -->
      <div class="lg:col-span-5 relative reveal reveal-delay-2 hidden lg:flex lg:justify-center">
        <!-- Soft outer glow -->
        <div class="absolute -inset-8 -z-10 bg-gradient-to-br from-brand-indigo/20 via-brand-rose/10 to-transparent blur-3xl"></div>
        <!-- Floating decorative ring -->
        <div class="absolute -top-6 -right-6 w-24 h-24 rounded-full border border-brand-indigo/15 hidden xl:block"></div>
        <div class="relative w-full max-w-sm">
          <picture>
            <source
              media={HERO_MEDIA}
              type="image/webp"
              srcset={heroImage.srcSet.attribute}
              sizes={HERO_IMAGE_OPTIONS.sizes}
            />
            <img
              src={HERO_PLACEHOLDER}
              alt="Voorbeeldgesprek van Emma, de AI-receptionist van Aanloop AI, met een klant op WhatsApp"
              class="w-full h-auto rounded-3xl shadow-2xl shadow-slate-900/20 ring-1 ring-slate-200/50"
              width={HERO_IMAGE.width}
              height={HERO_IMAGE.height}
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
          </picture>
        </div>
        <!-- Floating "live" stat-card (premium SaaS feel) -->
        <div class="absolute -bottom-5 -left-2 bg-white rounded-2xl shadow-xl border border-slate-100 p-4 hidden xl:flex items-center gap-3 max-w-[220px]">
          <div class="relative flex-shrink-0">
            <span class="absolute inline-flex h-3 w-3 rounded-full bg-brand-emerald opacity-75 animate-ping"></span>
            <span class="relative inline-flex h-3 w-3 rounded-full bg-brand-emerald"></span>
          </div>
          <div>
            <p class="text-xs font-semibold text-navy">Live in productie</p>
            <p class="text-xs text-slate-500 mt-0.5">Emma neemt nu een gesprek aan</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Logo cloud: Vertrouwd door ondernemers in heel Nederland -->
<section class="border-b border-slate-100 bg-white">
  <div class="container-page py-8">
    <p class="text-center text-xs uppercase tracking-[0.15em] text-slate-500 mb-6">Vertrouwd door MKB-ondernemers in heel Nederland</p>
    <div class="flex flex-wrap items-center justify-center gap-x-10 gap-y-4">
      <!-- Sector logos als tekst-badges (realistisch voor MKB) -->
      <span class="font-bold text-slate-500 text-sm tracking-wide">Horeca</span>
      <span class="w-px h-4 bg-slate-200"></span>
      <span class="font-bold text-slate-500 text-sm tracking-wide">Logistiek</span>
      <span class="w-px h-4 bg-slate-200"></span>
      <span class="font-bold text-slate-500 text-sm tracking-wide">Vastgoed</span>
      <span class="w-px h-4 bg-slate-200"></span>
      <span class="font-bold text-slate-500 text-sm tracking-wide">Accountancy</span>
      <span class="w-px h-4 bg-slate-200"></span>
      <span class="font-bold text-slate-500 text-sm tracking-wide">Zorg</span>
      <span class="w-px h-4 bg-slate-200"></span>
      <span class="font-bold text-slate-500 text-sm tracking-wide">Bouw</span>
      <span class="w-px h-4 bg-slate-200"></span>
      <span class="font-bold text-slate-500 text-sm tracking-wide">Advocatuur</span>
      <span class="w-px h-4 bg-slate-200"></span>
      <span class="font-bold text-slate-500 text-sm tracking-wide">ZZP</span>
    </div>
    <p class="text-center text-xs text-slate-500 mt-4">Voor het MKB in Rotterdam, Amsterdam, Utrecht, Den Haag en heel Nederland</p>
  </div>
</section>

<!-- Exit-intent popup -->
<div id="exit-popup" class="fixed inset-0 z-[100] flex items-center justify-center p-4" style="display:none !important;" aria-modal="true" role="dialog" aria-label="Gratis AI checklist">
  <div id="exit-popup-backdrop" class="absolute inset-0 bg-navy/60 backdrop-blur-sm"></div>
  <div class="relative bg-white rounded-3xl shadow-2xl p-8 max-w-md w-full mx-4 animate-fade-up">
    <button id="exit-popup-close" class="absolute top-4 right-4 w-8 h-8 flex items-center justify-center rounded-full bg-slate-100 hover:bg-slate-200 transition-colors" aria-label="Sluiten">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>
    <div class="text-center">
      <div class="w-14 h-14 bg-brand-indigo/10 rounded-2xl flex items-center justify-center mx-auto mb-4">
        <svg class="w-7 h-7 text-brand-indigo" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
      </div>
      <h3 class="text-xl font-bold text-navy mb-2">Wacht — u krijgt iets gratis mee</h3>
      <p class="text-slate-600 text-sm mb-6">Download onze gratis <strong>AI Readiness Checklist</strong> — 17 vragen die elke MKB-ondernemer moet stellen vóór de start met AI.</p>
      <a href="/gratis-ai-scan/" class="btn-primary w-full text-center justify-center mb-3">
        Gratis AI-scan aanvragen
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </a>
      <button id="exit-popup-dismiss" class="text-xs text-slate-500 hover:text-slate-600 transition-colors">Nee bedankt, ik ga weg</button>
    </div>
  </div>
</div>

<style>
  @keyframes grow-bar {
    from { width: 0%; }
    to { width: 73%; }
  }
</style>

<script>
  // ─── Typing effect for hero (respects prefers-reduced-motion, WCAG 2.2.2) ───
  const typedEl = document.getElementById('hero-typed');
  const phrases = ['écht werkt', 'uw klanten helpt', '24/7 beschikbaar is', 'leads binnenhaalt'];
  const heroPrefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let phraseIdx = 0;
  let charIdx = 0;
  let isDeleting = false;
  let typingTimer: ReturnType<typeof setTimeout>;

  function typeLoop() {
    const current = phrases[phraseIdx];
    // Guard: A/B test (homepage-hero-copy) may swap the H1's textContent,
    // which removes this node from the DOM. Stop the loop instead of
    // animating a detached node forever.
    if (!typedEl || !typedEl.isConnected) {
      clearTimeout(typingTimer);
      return;
    }

    if (isDeleting) {
      charIdx--;
      typedEl.textContent = current.slice(0, charIdx);
      if (charIdx === 0) {
        isDeleting = false;
        phraseIdx = (phraseIdx + 1) % phrases.length;
        typingTimer = setTimeout(typeLoop, 400);
        return;
      }
      typingTimer = setTimeout(typeLoop, 45);
    } else {
      charIdx++;
      typedEl.textContent = current.slice(0, charIdx);
      if (charIdx === current.length) {
        typingTimer = setTimeout(() => { isDeleting = true; typeLoop(); }, 2600);
        return;
      }
      typingTimer = setTimeout(typeLoop, 80);
    }
  }

  // Start typing after initial display (phrase 0 is already visible)
  // Skip animation if user prefers reduced motion (WCAG 2.2.2 Pause/Stop/Hide)
  if (!heroPrefersReducedMotion) {
    setTimeout(() => {
      if (typedEl) {
        charIdx = phrases[0].length;
        typeLoop();
      }
    }, 3000);
  }

  // ─── Scroll reveal handled by global observer in BaseLayout (avoid duplicate observer) ───

  // ─── Exit-intent popup ───
  const popup = document.getElementById('exit-popup') as HTMLElement;
  let exitShown = false;

  function showExitPopup() {
    if (exitShown || sessionStorage.getItem('exit-popup-shown')) return;
    exitShown = true;
    sessionStorage.setItem('exit-popup-shown', '1');
    if (popup) {
      popup.style.removeProperty('display');
      popup.style.display = 'flex';
    }
  }

  function hideExitPopup() {
    if (popup) popup.style.display = 'none';
  }

  // Trigger on mouse leaving viewport at top
  document.addEventListener('mouseleave', (e) => {
    if (e.clientY <= 5) showExitPopup();
  });

  // Trigger on mobile after 45s scroll
  setTimeout(() => {
    if (window.scrollY > 300) showExitPopup();
  }, 45000);

  document.getElementById('exit-popup-close')?.addEventListener('click', hideExitPopup);
  document.getElementById('exit-popup-dismiss')?.addEventListener('click', hideExitPopup);
  document.getElementById('exit-popup-backdrop')?.addEventListener('click', hideExitPopup);
</script>
