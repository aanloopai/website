---
// Hero — premium animated hero section
---

<section class="relative overflow-hidden hero-gradient min-h-[90vh] flex items-center">
  <!-- Dot grid overlay -->
  <div class="absolute inset-0 -z-10 dot-grid opacity-[0.035]"></div>

  <!-- Floating accent blobs -->
  <div class="absolute -top-32 -right-32 w-[600px] h-[600px] rounded-full bg-brand-indigo/5 blur-3xl -z-10 float-badge" style="animation-duration: 7s;"></div>
  <div class="absolute -bottom-32 -left-32 w-[400px] h-[400px] rounded-full bg-brand-rose/5 blur-3xl -z-10 float-badge" style="animation-duration: 9s; animation-delay: 1s;"></div>

  <div class="container-page pt-20 pb-24 lg:pt-28 lg:pb-36 w-full">
    <div class="max-w-5xl">

      <!-- Eyebrow -->
      <div class="flex items-center gap-4 mb-8 reveal">
        <div class="accent-band">
          <span></span><span></span><span></span><span></span>
        </div>
        <span class="eyebrow">Rotterdam's AI-partner voor het MKB</span>
      </div>

      <!-- H1 -->
      <h1 class="text-4xl sm:text-5xl lg:text-7xl font-bold tracking-tightest text-navy text-balance leading-[1.05] reveal reveal-delay-1">
        AI die <em class="not-italic relative">
          <span id="hero-typed">écht werkt</span>
          <svg class="absolute -bottom-2 left-0 w-full" viewBox="0 0 240 12" preserveAspectRatio="none" aria-hidden="true">
            <path d="M2 8 Q 60 2, 120 6 T 238 5" fill="none" stroke="#E11D48" stroke-width="3" stroke-linecap="round" />
          </svg>
        </em><br />voor uw bedrijf.
      </h1>

      <!-- Subheadline -->
      <p class="mt-8 text-lg lg:text-xl text-slate-600 leading-relaxed text-pretty max-w-2xl reveal reveal-delay-2">
        Van AI-receptionist die uw telefoon aanneemt, tot WhatsApp-assistent die
        klantvragen beantwoordt — Aanloop AI levert kant-en-klare AI-oplossingen
        en custom workflows voor MKB-ondernemers in Nederland.
      </p>

      <!-- CTAs -->
      <div class="mt-10 flex flex-col sm:flex-row gap-3 reveal reveal-delay-3">
        <a href="/demo-aanvragen/" class="btn-primary text-base px-6 py-3.5" id="hero-demo-btn">
          Boek een gratis demo
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
        <a href="/diensten/" class="btn-outline text-base px-6 py-3.5">
          Bekijk onze diensten
        </a>
      </div>

      <div class="mt-12 flex flex-wrap items-center gap-x-8 gap-y-3 text-sm text-slate-500 reveal reveal-delay-4">
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-brand-emerald" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span>AVG-compliant · EU data</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-brand-emerald" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span>Live binnen 14 dagen</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-brand-emerald" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span>Geen verborgen kosten</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-brand-emerald" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span>KvK: 88606902 · Rotterdam</span>
        </div>
      </div>
    </div>

    <!-- Floating stats card -->
    <div class="hidden lg:block absolute right-10 bottom-36 xl:right-24">
      <div class="card shadow-xl max-w-[220px] reveal reveal-delay-5">
        <div class="flex items-center gap-3 mb-3">
          <div class="w-8 h-8 rounded-lg bg-brand-emerald/10 flex items-center justify-center">
            <svg class="w-4 h-4 text-brand-emerald" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
            </svg>
          </div>
          <div>
            <div class="text-xs text-slate-500">Gemiste leads</div>
            <div class="text-lg font-bold text-navy">−73%</div>
          </div>
        </div>
        <div class="h-1.5 w-full bg-slate-100 rounded-full overflow-hidden">
          <div class="h-full bg-brand-emerald rounded-full" style="width: 73%; animation: grow-bar 1.5s ease-out 0.8s both;">
          </div>
        </div>
        <p class="mt-2 text-[11px] text-slate-400">Gemiddeld resultaat bij Marco</p>
      </div>
    </div>
  </div>
</section>

<!-- Logo cloud: Vertrouwd door ondernemers in heel Nederland -->
<section class="border-b border-slate-100 bg-white">
  <div class="container-page py-8">
    <p class="text-center text-xs uppercase tracking-[0.15em] text-slate-400 mb-6">Vertrouwd door MKB-ondernemers in heel Nederland</p>
    <div class="flex flex-wrap items-center justify-center gap-x-10 gap-y-4 opacity-40 grayscale">
      <!-- Sector logos als tekst-badges (realistisch voor MKB) -->
      <span class="font-bold text-slate-500 text-sm tracking-wide">Horeca</span>
      <span class="w-px h-4 bg-slate-200"></span>
      <span class="font-bold text-slate-500 text-sm tracking-wide">Logistiek</span>
      <span class="w-px h-4 bg-slate-200"></span>
      <span class="font-bold text-slate-500 text-sm tracking-wide">Vastgoed</span>
      <span class="w-px h-4 bg-slate-200"></span>
      <span class="font-bold text-slate-500 text-sm tracking-wide">Accountancy</span>
      <span class="w-px h-4 bg-slate-200"></span>
      <span class="font-bold text-slate-500 text-sm tracking-wide">Zorg</span>
      <span class="w-px h-4 bg-slate-200"></span>
      <span class="font-bold text-slate-500 text-sm tracking-wide">Bouw</span>
      <span class="w-px h-4 bg-slate-200"></span>
      <span class="font-bold text-slate-500 text-sm tracking-wide">Advocatuur</span>
      <span class="w-px h-4 bg-slate-200"></span>
      <span class="font-bold text-slate-500 text-sm tracking-wide">ZZP</span>
    </div>
    <p class="text-center text-xs text-slate-400 mt-4">500+ actieve klanten · Rotterdam, Amsterdam, Utrecht, Den Haag en heel Nederland</p>
  </div>
</section>

<!-- Exit-intent popup -->
<div id="exit-popup" class="fixed inset-0 z-[100] flex items-center justify-center p-4" style="display:none !important;" aria-modal="true" role="dialog" aria-label="Gratis AI checklist">
  <div id="exit-popup-backdrop" class="absolute inset-0 bg-navy/60 backdrop-blur-sm"></div>
  <div class="relative bg-white rounded-3xl shadow-2xl p-8 max-w-md w-full mx-4 animate-fade-up">
    <button id="exit-popup-close" class="absolute top-4 right-4 w-8 h-8 flex items-center justify-center rounded-full bg-slate-100 hover:bg-slate-200 transition-colors" aria-label="Sluiten">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>
    <div class="text-center">
      <div class="w-14 h-14 bg-brand-indigo/10 rounded-2xl flex items-center justify-center mx-auto mb-4">
        <svg class="w-7 h-7 text-brand-indigo" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
      </div>
      <h3 class="text-xl font-bold text-navy mb-2">Wacht — u krijgt iets gratis mee</h3>
      <p class="text-slate-600 text-sm mb-6">Download onze gratis <strong>AI Readiness Checklist</strong> — 17 vragen die elke MKB-ondernemer moet stellen vóór de start met AI.</p>
      <a href="/gratis-ai-scan/" class="btn-primary w-full text-center justify-center mb-3">
        Gratis AI-scan aanvragen
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </a>
      <button id="exit-popup-dismiss" class="text-xs text-slate-400 hover:text-slate-600 transition-colors">Nee bedankt, ik ga weg</button>
    </div>
  </div>
</div>

<style>
  @keyframes grow-bar {
    from { width: 0%; }
    to { width: 73%; }
  }
</style>

<script>
  // ─── Typing effect for hero ───
  const typedEl = document.getElementById('hero-typed');
  const phrases = ['écht werkt', 'uw klanten helpt', '24/7 beschikbaar is', 'leads binnenhaalt'];
  let phraseIdx = 0;
  let charIdx = 0;
  let isDeleting = false;
  let typingTimer: ReturnType<typeof setTimeout>;

  function typeLoop() {
    const current = phrases[phraseIdx];
    if (!typedEl) return;

    if (isDeleting) {
      charIdx--;
      typedEl.textContent = current.slice(0, charIdx);
      if (charIdx === 0) {
        isDeleting = false;
        phraseIdx = (phraseIdx + 1) % phrases.length;
        typingTimer = setTimeout(typeLoop, 400);
        return;
      }
      typingTimer = setTimeout(typeLoop, 45);
    } else {
      charIdx++;
      typedEl.textContent = current.slice(0, charIdx);
      if (charIdx === current.length) {
        typingTimer = setTimeout(() => { isDeleting = true; typeLoop(); }, 2600);
        return;
      }
      typingTimer = setTimeout(typeLoop, 80);
    }
  }

  // Start typing after initial display (phrase 0 is already visible)
  setTimeout(() => {
    if (typedEl) {
      charIdx = phrases[0].length;
      typeLoop();
    }
  }, 3000);

  // ─── Scroll reveal ───
  const reveals = document.querySelectorAll('.reveal');
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
      }
    });
  }, { threshold: 0.1 });
  reveals.forEach(el => observer.observe(el));

  // ─── Exit-intent popup ───
  const popup = document.getElementById('exit-popup') as HTMLElement;
  let exitShown = false;

  function showExitPopup() {
    if (exitShown || sessionStorage.getItem('exit-popup-shown')) return;
    exitShown = true;
    sessionStorage.setItem('exit-popup-shown', '1');
    if (popup) {
      popup.style.removeProperty('display');
      popup.style.display = 'flex';
    }
  }

  function hideExitPopup() {
    if (popup) popup.style.display = 'none';
  }

  // Trigger on mouse leaving viewport at top
  document.addEventListener('mouseleave', (e) => {
    if (e.clientY <= 5) showExitPopup();
  });

  // Trigger on mobile after 45s scroll
  setTimeout(() => {
    if (window.scrollY > 300) showExitPopup();
  }, 45000);

  document.getElementById('exit-popup-close')?.addEventListener('click', hideExitPopup);
  document.getElementById('exit-popup-dismiss')?.addEventListener('click', hideExitPopup);
  document.getElementById('exit-popup-backdrop')?.addEventListener('click', hideExitPopup);
</script>
