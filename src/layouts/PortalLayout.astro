---
// Customer portal app shell (V3, Stripe-Dashboard style). Sidebar + topbar.
// Global auth guard fetches /api/portal/me — redirects to login on 401,
// fills the topbar, hides [data-write] for the kijker role.
import '../styles/global.css';
import '../styles/portal.css';

export interface Props {
  title: string;
  active?: string;
}
const { title, active = '' } = Astro.props;

const nav = [
  { key: 'overzicht', label: 'Overzicht', href: '/portal/' },
  { key: 'diensten', label: 'Mijn diensten', href: '/portal/diensten' },
  { key: 'ontdekken', label: 'Diensten ontdekken', href: '/portal/ontdekken' },
  { key: 'facturatie', label: 'Facturatie', href: '/portal/facturatie' },
  { key: 'support', label: 'Support', href: '/portal/support' },
  { key: 'instellingen', label: 'Instellingen', href: '/portal/instellingen' },
];
---

<!DOCTYPE html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · Aanloop AI Klantportaal</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  </head>
  <body class="portal min-h-screen">
    <div class="mx-auto flex min-h-screen max-w-[1180px] flex-col lg:flex-row">
      <aside class="shrink-0 border-b lg:w-60 lg:border-b-0 lg:border-r" style="background:var(--p-surface);border-color:var(--p-border)">
        <div class="flex items-center gap-2 px-5 py-4">
          <a href="/" aria-label="Aanloop AI home">
            <img src="/brand/logo-horizontal-light.svg" alt="Aanloop AI" class="h-6" />
          </a>
        </div>
        <nav class="flex gap-1 overflow-x-auto px-3 pb-3 lg:flex-col">
          {nav.map((n) => (
            <a href={n.href} class={`pnav ${active === n.key ? 'pnav--active' : ''}`}>{n.label}</a>
          ))}
        </nav>
      </aside>

      <div class="flex min-w-0 flex-1 flex-col">
        <header class="flex items-center justify-between border-b px-5 py-3 lg:px-8" style="background:var(--p-surface);border-color:var(--p-border)">
          <div class="truncate text-sm font-semibold" id="pl-bedrijf" style="color:var(--p-ink)">Klantportaal</div>
          <div class="flex items-center gap-3">
            <span class="hidden text-sm sm:inline" id="pl-user" style="color:var(--p-ink-2)"></span>
            <span class="pbadge pbadge--gray hidden capitalize" id="pl-role"></span>
            <a href="/api/auth/logout" class="pbtn pbtn--subtle pbtn--sm">Uitloggen</a>
          </div>
        </header>
        <main class="flex-1 px-5 py-6 lg:px-8 lg:py-8">
          <slot />
        </main>
      </div>
    </div>

    <script is:inline>
      fetch('/api/portal/me', { credentials: 'same-origin' })
        .then(function (r) {
          if (r.status === 401) { location.href = '/portal/login'; throw new Error('unauth'); }
          return r.json();
        })
        .then(function (d) {
          var u = d.user || {}, c = d.customer || {};
          var b = document.getElementById('pl-bedrijf');
          if (b) b.textContent = c.bedrijf || 'Klantportaal';
          var un = document.getElementById('pl-user');
          if (un) un.textContent = u.naam || '';
          var rl = document.getElementById('pl-role');
          if (rl && u.role) { rl.textContent = u.role; rl.classList.remove('hidden'); }
          window.__portalUser = u;
          if (u.role === 'kijker') {
            document.querySelectorAll('[data-write]').forEach(function (el) { el.classList.add('hidden'); });
          }
          document.dispatchEvent(new CustomEvent('portal:ready', { detail: d }));
        })
        .catch(function () {});
    </script>
  </body>
</html>
