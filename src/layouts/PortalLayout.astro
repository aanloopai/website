---
// Minimal layout for the customer portal (C3). No marketing chrome,
// always noindex — the portal is for authenticated customers only.
import '../styles/global.css';

export interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · Aanloop AI Klantportaal</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900 antialiased">
    <header class="border-b border-slate-200 bg-white">
      <div class="mx-auto flex max-w-4xl items-center justify-between px-4 py-4">
        <a href="/" class="flex items-center gap-2" aria-label="Aanloop AI home">
          <img src="/brand/logo-horizontal-light.svg" alt="Aanloop AI" class="h-7" />
        </a>
        <span class="text-xs font-medium uppercase tracking-wider text-slate-400">Klantportaal</span>
      </div>
    </header>

    <main class="mx-auto max-w-4xl px-4 py-10">
      <slot />
    </main>

    <footer class="mx-auto max-w-4xl px-4 py-8 text-xs text-slate-400">
      Aanloop AI — <a href="https://aanloopai.nl" class="underline">aanloopai.nl</a> — KvK 88606902 ·
      <a href="/privacy/" class="underline">Privacy</a>
    </footer>
  </body>
</html>
