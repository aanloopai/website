---
// Admin panel app shell (V3, Stripe-Dashboard style). Staff-only — guarded
// by /api/admin/me.
import '../styles/global.css';
import '../styles/portal.css';

export interface Props {
  title: string;
  active?: string;
}
const { title, active = '' } = Astro.props;

const nav = [
  { key: 'dashboard', label: 'Dashboard', href: '/admin/' },
  { key: 'klanten', label: 'Klanten', href: '/admin/klanten' },
  { key: 'aanvragen', label: 'Aanvragen', href: '/admin/aanvragen' },
  { key: 'support', label: 'Support', href: '/admin/support' },
  { key: 'leadgen', label: 'Leadgen', href: '/admin/leadgen' },
];
---

<!DOCTYPE html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · Aanloop AI Admin</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  </head>
  <body class="portal min-h-screen">
    <div class="mx-auto flex min-h-screen max-w-[1180px] flex-col lg:flex-row">
      <aside class="shrink-0 border-b lg:w-56 lg:border-b-0 lg:border-r" style="background:var(--p-surface);border-color:var(--p-border)">
        <div class="px-5 py-4">
          <span class="text-sm font-bold" style="color:var(--p-ink)">Aanloop AI</span>
          <span class="ml-1.5 pbadge pbadge--blue">Admin</span>
        </div>
        <nav class="flex gap-1 overflow-x-auto px-3 pb-3 lg:flex-col">
          {nav.map((n) => (
            <a href={n.href} class={`pnav ${active === n.key ? 'pnav--active' : ''}`}>{n.label}</a>
          ))}
        </nav>
      </aside>

      <div class="flex min-w-0 flex-1 flex-col">
        <header class="flex items-center justify-between border-b px-5 py-3 lg:px-8" style="background:var(--p-surface);border-color:var(--p-border)">
          <div class="text-sm font-semibold" style="color:var(--p-ink)">Beheer</div>
          <div class="flex items-center gap-3">
            <span class="hidden text-sm sm:inline" id="al-user" style="color:var(--p-ink-2)"></span>
            <form method="POST" action="/api/auth/logout" class="inline"><button type="submit" class="pbtn pbtn--subtle pbtn--sm">Uitloggen</button></form>
          </div>
        </header>
        <main class="flex-1 px-5 py-6 lg:px-8 lg:py-8">
          <slot />
        </main>
      </div>
    </div>

    <script is:inline>
      fetch('/api/admin/me', { credentials: 'same-origin' })
        .then(function (r) {
          if (r.status !== 200) { location.href = '/portal/login'; throw new Error('no-access'); }
          return r.json();
        })
        .then(function (d) {
          var un = document.getElementById('al-user');
          if (un) un.textContent = (d.user && d.user.naam) || '';
          window.__adminUser = d.user || {};
          document.dispatchEvent(new CustomEvent('admin:ready', { detail: d }));
        })
        .catch(function () {});
    </script>
  </body>
</html>
