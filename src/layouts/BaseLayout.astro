---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  schema?: object | object[];
  faqSchema?: { question: string; answer: string }[];
  canonicalOverride?: string;
}

const {
  title,
  description,
  image = '/og-image-default.png',
  noindex = false,
  schema,
  faqSchema,
  canonicalOverride,
} = Astro.props;

const canonical = canonicalOverride ?? new URL(Astro.url.pathname, 'https://aanloopai.nl').toString();
// Smart suffix: only append " · Aanloop AI" when total stays <=60 chars
// (Google SERP truncation threshold). Hardcoded "Aanloop" in source title
// is respected verbatim — no double-suffix.
const TITLE_SUFFIX = ' · Aanloop AI';
const TITLE_MAX = 60;
const fullTitle = title.includes('Aanloop')
  ? title
  : (title.length + TITLE_SUFFIX.length <= TITLE_MAX ? `${title}${TITLE_SUFFIX}` : title);

// Per-page OG-image: derive from URL path, fallback to default
const ogSlugMap: Record<string, string> = {
  '/': 'home',
  '/diensten/marco/': 'marco',
  '/diensten/emma/': 'emma',
  '/ai-receptionist-nederland/': 'ai-receptionist-nederland',
  '/ai-roi-calculator/': 'ai-roi-calculator',
  '/no-show-calculator/': 'no-show-calculator',
  '/avg-checklist-ai-mkb/': 'avg-checklist',
  '/kennisbank/': 'kennisbank',
  '/glossarium/': 'glossarium',
  '/locaties/': 'locaties',
};
const ogSlug = ogSlugMap[Astro.url.pathname];
const derivedImage = ogSlug ? `/og/${ogSlug}.png` : image;
const finalImage = image !== '/og-image-default.png' ? image : derivedImage;
const ogImage = finalImage.startsWith('http') ? finalImage : `https://aanloopai.nl${finalImage}`;

// Auto-inject author bio + last-updated on kennisbank-articles (not on index)
const isKennisbankArticle =
  Astro.url.pathname.startsWith('/kennisbank/') &&
  Astro.url.pathname !== '/kennisbank/' &&
  Astro.url.pathname !== '/kennisbank';
const lastUpdated = '1 mei 2026';

// Hide sticky mobile CTA op pages waar het redundant of misplaatst is.
// /contact + /demo-aanvragen + /aanvragen ZIJN de bestemming. /bedankt + /demo-* zijn post-submit. Legal pages zijn geen sales-context.
const stickyCtaHidePaths = new Set([
  '/contact/', '/contact',
  '/demo-aanvragen/', '/demo-aanvragen',
  '/aanvragen/', '/aanvragen',
  '/bedankt/', '/bedankt',
  '/demo-bedankt/', '/demo-bedankt',
  '/demo-bevestigd/', '/demo-bevestigd',
  '/demo-herplannen/', '/demo-herplannen',
  '/demo-inplannen/', '/demo-inplannen',
  '/privacy/', '/privacy',
  '/cookies/', '/cookies',
  '/voorwaarden/', '/voorwaarden',
  '/sla/', '/sla',
  '/disclaimer/', '/disclaimer',
]);
const hideStickyCta = stickyCtaHidePaths.has(Astro.url.pathname);

// ── Organization Schema ────────────────────────────────────────────
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'ProfessionalService'],
  '@id': 'https://aanloopai.nl/#organization',
  name: 'Aanloop AI',
  legalName: 'Aanloop AI B.V.',
  alternateName: 'AanloopAI',
  url: 'https://aanloopai.nl',
  logo: {
    '@type': 'ImageObject',
    url: 'https://aanloopai.nl/logo-mark-light-1024.png',
    width: 1024,
    height: 1024,
  },
  description: 'Aanloop AI B.V. levert AI agents, voice AI en workflow automation voor het Nederlandse MKB. Van AI-receptionist tot custom n8n workflows — live in 7 werkdagen. KVK: 56312075.',
  slogan: 'AI die echt werkt voor uw bedrijf',
  foundingDate: '2024',
  identifier: {
    '@type': 'PropertyValue',
    name: 'KVK',
    value: '56312075',
  },
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Rotterdam',
    addressLocality: 'Rotterdam',
    addressRegion: 'Zuid-Holland',
    postalCode: '3011',
    addressCountry: 'NL',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: '51.9225',
    longitude: '4.4792',
  },
  areaServed: [
    { '@type': 'City', name: 'Rotterdam' },
    { '@type': 'City', name: 'Amsterdam' },
    { '@type': 'City', name: 'Den Haag' },
    { '@type': 'City', name: 'Utrecht' },
    { '@type': 'Country', name: 'Nederland' },
  ],
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'sales',
    email: 'hello@aanloopai.nl',
    telephone: '+31624741597',
    areaServed: 'NL',
    availableLanguage: ['Dutch', 'English'],
    hoursAvailable: {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '09:00',
      closes: '17:00',
    },
  },
  priceRange: '€597-€5000',
  founder: {
    '@type': 'Person',
    '@id': 'https://aanloopai.nl/team/magahdogan/#person',
    name: 'Mustafa Agah Dogan',
    givenName: 'Mustafa',
    additionalName: 'Agah',
    familyName: 'Dogan',
    url: 'https://aanloopai.nl/team/magahdogan/',
    image: 'https://aanloopai.nl/team/magahdogan.jpg',
    jobTitle: 'Oprichter, CEO Aanloop AI',
    description: 'Oprichter en CEO Aanloop AI B.V. BSc Computer Engineering (2012), bijna 20 jaar IT-ervaring, voormalig AI-lead Big 4-consultancy met 40+ enterprise AI-implementaties.',
    knowsAbout: [
      'Artificial intelligence',
      'AI consulting',
      'Wft Pensioenadvies',
      'Wft Vermogen',
      'Wft Hypothecair',
      'AVG / GDPR compliance',
      'EU AI Act',
      'n8n automation',
      'ElevenLabs voice AI',
      'WhatsApp Business API',
      'Dutch MKB / KMO',
      'AI receptionist',
      'AI agent design',
    ],
    alumniOf: {
      '@type': 'EducationalOrganization',
      name: 'Bilgisayar Mühendisliği (Computer Engineering BSc, 2012)',
    },
    worksFor: { '@id': 'https://aanloopai.nl/#organization' },
    sameAs: [
      'https://www.linkedin.com/in/doganm/',
      // TODO: voeg X/Twitter, GitHub-personal, Mastodon zodra publiek beschikbaar
    ],
  },
  sameAs: [
    'https://www.kvk.nl/zoeken/?source=all&q=56312075',
    'https://github.com/aanloopai',
    'https://www.instagram.com/aanloop.ai/',
    'https://www.linkedin.com/company/aanloop-ai',
    // TODO: voeg toe zodra entity-vermeldingen live zijn:
    // 'https://www.wikidata.org/wiki/[Q-id]',
    // 'https://www.crunchbase.com/organization/aanloop-ai',
    // 'https://www.producthunt.com/products/aanloop-ai',
    // 'https://twitter.com/aanloopai',
    // 'https://nl.trustpilot.com/review/aanloopai.nl',
    // 'https://www.google.com/maps/place/?q=place_id:[GBP-id]',
  ],
  knowsAbout: [
    'AI Agents',
    'Voice AI',
    'AI Automatisering',
    'AI Receptionist',
    'WhatsApp AI Assistent',
    'Workflow Automatisering',
    'n8n Workflow Automation',
    'ElevenLabs Voice AI',
    'EU AI Act Compliance',
    'AVG GDPR Compliance',
    'AI voor MKB Nederland',
    'AI Agency Nederland',
    'Wft Pensioenadvies',
    'Wft Hypothecair Krediet',
    'Wft Vermogen',
    'Wet toekomst pensioenen',
    'AFM Klantbelang Centraal',
    'Wwft clientonderzoek',
    'KiFiD klachtenroute',
  ],
};

// ── WebSite Schema ────────────────────────────────────────────────
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': 'https://aanloopai.nl/#website',
  url: 'https://aanloopai.nl',
  name: 'Aanloop AI',
  description: 'AI-oplossingen voor het Nederlandse MKB',
  publisher: { '@id': 'https://aanloopai.nl/#organization' },
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: 'https://aanloopai.nl/kennisbank/?q={search_term_string}',
    },
    'query-input': 'required name=search_term_string',
  },
};

// ── Speakable Schema (for voice assistants) ───────────────────────
const speakableSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: fullTitle,
  url: canonical,
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['h1', 'main p:first-of-type', '.eyebrow + h2 + p', '[data-speakable]'],
  },
};

// ── FAQ Schema ────────────────────────────────────────────────────
const faqSchemaLD = faqSchema?.length ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqSchema.map(({ question, answer }) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
} : null;

// ── Breadcrumb Schema ─────────────────────────────────────────────
const pathParts = Astro.url.pathname.replace(/\/$/, '').split('/').filter(Boolean);
const breadcrumbSchema = pathParts.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://aanloopai.nl/' },
    ...pathParts.map((part, i) => ({
      '@type': 'ListItem',
      position: i + 2,
      name: part.charAt(0).toUpperCase() + part.slice(1).replace(/-/g, ' '),
      item: `https://aanloopai.nl/${pathParts.slice(0, i + 1).join('/')}/`,
    })),
  ],
} : null;

const allSchemas = [
  orgSchema,
  websiteSchema,
  speakableSchema,
  breadcrumbSchema,
  faqSchemaLD,
  ...(Array.isArray(schema) ? schema : schema ? [schema] : []),
].filter(Boolean);
---

<!DOCTYPE html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Consent Mode v2 — defaults: deny until user consents (AVG/GDPR) -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        functionality_storage: 'granted',
        security_storage: 'granted',
        wait_for_update: 200,
      });
      // Honour existing consent on subsequent page loads
      try {
        if (localStorage.getItem('aanloop_cookie_consent') === 'all') {
          gtag('consent', 'update', {
            ad_storage: 'granted',
            ad_user_data: 'granted',
            ad_personalization: 'granted',
            analytics_storage: 'granted',
          });
        }
      } catch (e) {}
      gtag('js', new Date());
      gtag('config', 'G-VS8SZZ6W45', { anonymize_ip: true, transport_type: 'beacon' });
      // Global fail-safe event helper
      window._track = function(name, params) {
        try {
          if (window.gtag) window.gtag('event', name, params || {});
          if (Array.isArray(window.dataLayer)) window.dataLayer.push(Object.assign({ event: name }, params || {}));
        } catch(e) {}
      };
      // Phone-click delegation (werkt ook na lazy DOM-injectie van ElevenLabs widget)
      document.addEventListener('click', function(e) {
        var a = e.target && e.target.closest ? e.target.closest('a[href^="tel:"]') : null;
        if (a) window._track('phone_click', { link_url: a.href, link_text: (a.textContent || '').trim() });
      });
      // WhatsApp-click delegation
      document.addEventListener('click', function(e) {
        var a = e.target && e.target.closest ? e.target.closest('a[href*="wa.me"]') : null;
        if (a) window._track('whatsapp_click', { link_url: a.href });
      });
    </script>
    <!-- GTM script lazy-loaded after first interaction or idle (matches ElevenLabs widget pattern).
         Cuts TBT ~1500ms on desktop while keeping consent + analytics intact. -->
    <script is:inline>
      (function(){
        var loaded = false;
        function loadGTM(){
          if (loaded) return; loaded = true;
          var s = document.createElement('script');
          s.src = 'https://www.googletagmanager.com/gtag/js?id=G-VS8SZZ6W45';
          s.async = true;
          document.head.appendChild(s);
        }
        ['scroll','mousemove','touchstart','keydown','click'].forEach(function(ev){
          window.addEventListener(ev, loadGTM, { once: true, passive: true });
        });
        if ('requestIdleCallback' in window) {
          requestIdleCallback(function(){ setTimeout(loadGTM, 3000); });
        } else {
          setTimeout(loadGTM, 4000);
        }
      })();
    </script>

    <!-- Canonical & Hreflang (NL-only site: one language tag + x-default) -->
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="nl" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />

    <!-- Favicons -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- RSS Feed -->
    <link rel="alternate" type="application/rss+xml" title="Aanloop AI Kennisbank" href="/rss.xml" />

    <!-- PWA Web App Manifest -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="application-name" content="Aanloop AI" />
    <meta name="apple-mobile-web-app-title" content="Aanloop AI" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <!-- Google Search Console verification -->
    <meta name="google-site-verification" content="fqKcaVQJ2__42Y37RHft10dijtbLuGmLfOp4gTOs3dw" />

    <!-- Primary meta -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="AI receptionist, AI automatisering, WhatsApp AI, workflow automatisering, AI assistent Nederland, MKB AI oplossingen" />
    <meta name="author" content="Aanloop AI" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1'} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Aanloop AI" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Aanloop AI — AI-oplossingen voor het Nederlandse MKB" />
    <meta property="og:locale" content="nl_NL" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@aanloopai" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Theme color -->
    <meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0B1120" media="(prefers-color-scheme: dark)" />

    <!-- Core Web Vitals: Resource Hints -->
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <link rel="preconnect" href="https://unpkg.com" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://www.google-analytics.com" />
    <link rel="dns-prefetch" href="https://api.web3forms.com" />

    <!-- LCP image preload — logo is in the header above the fold -->
    <link rel="preload" as="image" href="/brand/logo-horizontal-light.svg" fetchpriority="high" />

    <!-- Microsoft Clarity: Heatmap + Session Recording (AVG-compliant, consent-gated, lazy-loaded) -->
    <!-- TODO: Replace 'XXXXXXXX' with actual Clarity project ID from clarity.microsoft.com -->
    <script is:inline>
      (function() {
        // Only load Clarity if user accepted analytics cookies
        var clarityProjectId = 'XXXXXXXX';
        function loadClarity() {
          // Not configured yet — skip to avoid a broken https://clarity.ms/tag/XXXXXXXX request.
          if (!clarityProjectId || clarityProjectId === 'XXXXXXXX') return;
          try {
            if (localStorage.getItem('aanloop_cookie_consent') !== 'all') return;
          } catch (e) { return; }

          var c = window.clarity = window.clarity || function() {
            (c.q = c.q || []).push(arguments);
          };
          var script = document.createElement('script');
          script.async = true;
          script.src = 'https://www.clarity.ms/tag/' + clarityProjectId;
          document.head.appendChild(script);
        }

        // Load on first interaction or idle callback
        ['scroll', 'mousemove', 'touchstart', 'keydown', 'click'].forEach(function(ev) {
          window.addEventListener(ev, loadClarity, { once: true, passive: true });
        });
        if ('requestIdleCallback' in window) {
          requestIdleCallback(function() { setTimeout(loadClarity, 3000); });
        } else {
          setTimeout(loadClarity, 4000);
        }
      })();
    </script>

    <!-- Schema.org JSON-LD -->
    {allSchemas.map(s => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}

    <!-- Intercept shadow root creation to inject branding-hide CSS before widget renders -->
    <script is:inline>
      (function () {
        var _origAttachShadow = Element.prototype.attachShadow;
        Element.prototype.attachShadow = function (init) {
          var root = _origAttachShadow.call(this, init);
          var style = document.createElement('style');
          style.setAttribute('data-hide-pb', '1');
          style.textContent = [
            'a[href*="elevenlabs.io"] { display:none!important; }',
            '[class*="powered"] { display:none!important; }',
            '[class*="branding"] { display:none!important; }',
            /* Hide the container holding "Powered by" + link together */
            'a[href*="elevenlabs.io"] ~ *, a[href*="elevenlabs.io"] + * { display:none!important; }'
          ].join('');
          root.appendChild(style);
          /* Also watch for late-rendered content inside this shadow root */
          new MutationObserver(function () {
            root.querySelectorAll('a[href*="elevenlabs.io"]').forEach(function (link) {
              link.style.setProperty('display', 'none', 'important');
              if (link.parentElement) link.parentElement.style.setProperty('display', 'none', 'important');
            });
          }).observe(root, { childList: true, subtree: true });
          return root;
        };
      })();
    </script>
  </head>
  <body>
    <!-- Skip to main content — accessibility -->
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-navy focus:text-white focus:rounded-lg"
    >
      Naar hoofdinhoud
    </a>

    <Header />

    <main id="main">
      {pathParts.length > 0 && (
        <nav aria-label="Kruimelpad" class="border-b border-slate-100 bg-white">
          <div class="container-page py-3">
            <ol class="flex flex-wrap items-center gap-1.5 text-xs text-slate-500">
              <li><a href="/" class="hover:text-navy">Home</a></li>
              {pathParts.map((part, i) => {
                const isLast = i === pathParts.length - 1;
                const href = `/${pathParts.slice(0, i + 1).join('/')}/`;
                const label = part.charAt(0).toUpperCase() + part.slice(1).replace(/-/g, ' ');
                return (
                  <>
                    <li aria-hidden="true" class="text-slate-300">›</li>
                    <li>
                      {isLast ? (
                        <span class="text-navy font-medium" aria-current="page">{label}</span>
                      ) : (
                        <a href={href} class="hover:text-navy">{label}</a>
                      )}
                    </li>
                  </>
                );
              })}
            </ol>
          </div>
        </nav>
      )}
      <slot />
      {isKennisbankArticle && (
        <section class="border-t border-slate-200 bg-slate-50/60">
          <div class="container-page max-w-3xl py-12 lg:py-16">
            <div class="flex items-center justify-between text-sm text-slate-500 mb-8">
              <span>Laatst bijgewerkt: {lastUpdated}</span>
              <a href="/kennisbank/" class="hover:text-navy">Terug naar kennisbank</a>
            </div>
            <div class="rounded-2xl border border-slate-200 bg-white p-6 lg:p-8 shadow-sm">
              <div class="flex items-start gap-4">
                <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-navy text-white text-lg font-bold">MA</div>
                <div class="min-w-0">
                  <p class="text-xs uppercase tracking-wider text-slate-500 mb-1">Geschreven door</p>
                  <h3 class="text-lg font-bold text-navy">
                    <a href="/team/magahdogan/" class="hover:underline">Mustafa Agah Dogan</a>
                  </h3>
                  <p class="text-sm text-slate-600 mt-1">Oprichter en CEO Aanloop AI. Helpt Nederlandse MKB-bedrijven met de implementatie van AI-receptionisten, WhatsApp-assistenten en workflow automatisering.</p>
                  <div class="flex flex-wrap gap-3 mt-3 text-sm">
                    <a href="/team/magahdogan/" class="text-navy hover:underline">Profiel</a>
                    <a href="https://www.linkedin.com/in/doganm/" rel="author noopener" target="_blank" class="text-navy hover:underline">LinkedIn</a>
                    <a href="/contact/" class="text-navy hover:underline">Contact</a>
                  </div>
                </div>
              </div>
            </div>
            <div class="flex flex-wrap gap-2 mt-6 text-xs">
              <a href="/kennisbank/" class="rounded-full border border-slate-200 px-3 py-1 text-slate-600 hover:border-navy hover:text-navy">Meer kennisbank-artikelen</a>
              <a href="/glossarium/" class="rounded-full border border-slate-200 px-3 py-1 text-slate-600 hover:border-navy hover:text-navy">AI-begrippenlijst</a>
              <a href="/aanvragen/" class="rounded-full border border-slate-200 px-3 py-1 text-slate-600 hover:border-navy hover:text-navy">Gratis adviesgesprek</a>
            </div>
          </div>
        </section>
      )}
    </main>

    <!-- Pre-footer trust strip — sitewide risk-reversal signals (no testimonials) -->
    <section aria-label="Garanties" class="bg-white border-t border-slate-200">
      <div class="container-page py-8">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
          <div class="flex flex-col items-center gap-2">
            <svg class="w-7 h-7 text-brand-emerald" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            <p class="text-sm font-semibold text-navy">Maandelijks opzegbaar</p>
            <p class="text-xs text-slate-500">Geen jaarcontract verplicht</p>
