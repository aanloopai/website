---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  schema?: object | object[];
  faqSchema?: { question: string; answer: string }[];
}

const {
  title,
  description,
  image = '/logo-mark-light-1024.png',
  noindex = false,
  schema,
  faqSchema,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, 'https://aanloopai.nl').toString();
const fullTitle = title.includes('Aanloop') ? title : `${title} · Aanloop AI`;
const ogImage = image.startsWith('http') ? image : `https://aanloopai.nl${image}`;

// ── Organization Schema ────────────────────────────────────────────
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'ProfessionalService'],
  '@id': 'https://aanloopai.nl/#organization',
  name: 'Aanloop AI',
  legalName: 'Aanloop AI B.V.',
  alternateName: 'AanloopAI',
  url: 'https://aanloopai.nl',
  logo: {
    '@type': 'ImageObject',
    url: 'https://aanloopai.nl/logo-mark-light-1024.png',
    width: 1024,
    height: 1024,
  },
  description: 'Aanloop AI B.V. levert AI agents, voice AI en workflow automation voor het Nederlandse MKB. Van AI-receptionist tot custom n8n workflows — live in 7 werkdagen. KVK: 88606902.',
  slogan: 'AI die echt werkt voor uw bedrijf',
  foundingDate: '2024',
  identifier: {
    '@type': 'PropertyValue',
    name: 'KVK',
    value: '88606902',
  },
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Rotterdam',
    addressLocality: 'Rotterdam',
    addressRegion: 'Zuid-Holland',
    postalCode: '3000',
    addressCountry: 'NL',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: '51.9225',
    longitude: '4.4792',
  },
  areaServed: [
    { '@type': 'City', name: 'Rotterdam' },
    { '@type': 'City', name: 'Amsterdam' },
    { '@type': 'City', name: 'Den Haag' },
    { '@type': 'City', name: 'Utrecht' },
    { '@type': 'Country', name: 'Nederland' },
  ],
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'sales',
    email: 'hello@aanloopai.nl',
    telephone: '+31624741597',
    areaServed: 'NL',
    availableLanguage: ['Dutch', 'English'],
    hoursAvailable: {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '09:00',
      closes: '17:00',
    },
  },
  priceRange: '€€',
  sameAs: [
    'https://www.linkedin.com/company/aanloopai',
    'https://twitter.com/aanloopai',
  ],
  knowsAbout: [
    'AI Agents',
    'Voice AI',
    'AI Automatisering',
    'AI Receptionist',
    'WhatsApp AI Assistent',
    'Workflow Automatisering',
    'n8n Workflow Automation',
    'ElevenLabs Voice AI',
    'EU AI Act Compliance',
    'AVG GDPR Compliance',
    'AI voor MKB Nederland',
    'AI Agency Nederland',
  ],
};

// ── WebSite Schema ────────────────────────────────────────────────
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': 'https://aanloopai.nl/#website',
  url: 'https://aanloopai.nl',
  name: 'Aanloop AI',
  description: 'AI-oplossingen voor het Nederlandse MKB',
  publisher: { '@id': 'https://aanloopai.nl/#organization' },
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: 'https://aanloopai.nl/kennisbank/?q={search_term_string}',
    },
    'query-input': 'required name=search_term_string',
  },
};

// ── FAQ Schema ────────────────────────────────────────────────────
const faqSchemaLD = faqSchema?.length ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqSchema.map(({ question, answer }) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
} : null;

// ── Breadcrumb Schema ─────────────────────────────────────────────
const pathParts = Astro.url.pathname.replace(/\/$/, '').split('/').filter(Boolean);
const breadcrumbSchema = pathParts.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://aanloopai.nl/' },
    ...pathParts.map((part, i) => ({
      '@type': 'ListItem',
      position: i + 2,
      name: part.charAt(0).toUpperCase() + part.slice(1).replace(/-/g, ' '),
      item: `https://aanloopai.nl/${pathParts.slice(0, i + 1).join('/')}/`,
    })),
  ],
} : null;

const allSchemas = [
  orgSchema,
  websiteSchema,
  breadcrumbSchema,
  faqSchemaLD,
  ...(Array.isArray(schema) ? schema : schema ? [schema] : []),
].filter(Boolean);
---

<!DOCTYPE html>
<html lang="nl">
  <head>
    <!-- Google Analytics 4 — must be first in head -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-VS8SZZ6W45"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-VS8SZZ6W45');
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Canonical & Hreflang -->
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="nl" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />

    <!-- Favicons -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Google Search Console verification -->
    <meta name="google-site-verification" content="fqKcaVQJ2__42Y37RHft10dijtbLuGmLfOp4gTOs3dw" />

    <!-- Primary meta -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="AI receptionist, AI automatisering, WhatsApp AI, workflow automatisering, AI assistent Nederland, MKB AI oplossingen" />
    <meta name="author" content="Aanloop AI" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1'} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Aanloop AI" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Aanloop AI — AI-oplossingen voor het Nederlandse MKB" />
    <meta property="og:locale" content="nl_NL" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@aanloopai" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Theme color -->
    <meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0B1120" media="(prefers-color-scheme: dark)" />

    <!-- Core Web Vitals: Resource Hints -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://api.web3forms.com" />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://www.google-analytics.com" />

    <!-- Schema.org JSON-LD -->
    {allSchemas.map(s => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
  </head>
  <body>
    <!-- Skip to main content — accessibility -->
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-navy focus:text-white focus:rounded-lg"
    >
      Naar hoofdinhoud
    </a>

    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <!-- Global scroll reveal -->
    <script>
      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
            }
          });
        },
        { threshold: 0.08, rootMargin: '0px 0px -40px 0px' }
      );
      document.querySelectorAll('.reveal').forEach((el) => revealObserver.observe(el));
    </script>

    <!-- Counter animation -->
    <script>
      const counterObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting && !entry.target.dataset.counted) {
              entry.target.dataset.counted = 'true';
              const target = parseInt(entry.target.dataset.target || '0', 10);
              const suffix = entry.target.dataset.suffix || '';
              const duration = 1500;
              const start = performance.now();
              function update(time: number) {
                const elapsed = time - start;
                const progress = Math.min(elapsed / duration, 1);
                const eased = 1 - Math.pow(1 - progress, 3);
                entry.target.textContent = Math.floor(eased * target) + suffix;
                if (progress < 1) requestAnimationFrame(update);
                else entry.target.textContent = target + suffix;
              }
              requestAnimationFrame(update);
            }
          });
        },
        { threshold: 0.5 }
      );
      document.querySelectorAll('[data-counter]').forEach((el) => counterObserver.observe(el));
    </script>
    <!-- Mobile sticky CTA bar -->
    <div class="lg:hidden fixed bottom-0 inset-x-0 z-30 bg-white/95 backdrop-blur border-t border-slate-200 px-4 py-3 flex gap-2 shadow-2xl">
      <a href="https://wa.me/31624741597" class="flex-1 flex items-center justify-center gap-2 px-4 py-3 rounded-xl border border-slate-200 text-navy font-semibold text-sm hover:bg-slate-50 transition-all">
        <svg class="w-4 h-4 text-green-500" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        WhatsApp
      </a>
      <a href="/demo-aanvragen/" class="flex-1 flex items-center justify-center gap-2 px-4 py-3 rounded-xl bg-brand-indigo text-white font-semibold text-sm hover:bg-indigo-700 transition-all">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
        Gratis demo
      </a>
    </div>

    <!-- ElevenLabs ConvAI Widget -->
    <elevenlabs-convai agent-id="agent_6101kqdjepxmeqsr02kg7vwwd873"></elevenlabs-convai>
    <script src="https://unpkg.com/@elevenlabs/convai-widget-embed" async type="text/javascript"></script>
  </body>
</html>
