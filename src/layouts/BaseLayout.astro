---
import '../styles/global.css';
import '../components/motion/lenis.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ExitIntentModal from '../components/ExitIntentModal.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import { PRICE_RANGE } from '../data/pricing';
import { getImage } from 'astro:assets';
import { HERO_IMAGE, HERO_IMAGE_OPTIONS, HERO_MEDIA } from '../data/hero-image';

export interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  schema?: object | object[];
  faqSchema?: { question: string; answer: string }[];
  videoSchema?: { name: string; description: string; thumbnailUrl: string; uploadDate: string; contentUrl?: string; embedUrl?: string; duration?: string };
  canonicalOverride?: string;
  /** Zet dit op de pagina waar Hero.astro boven de vouw staat (nu alleen /). */
  preloadHero?: boolean;
}

const {
  title,
  description,
  image = '/og-image-default.png',
  noindex = false,
  schema,
  faqSchema,
  videoSchema,
  canonicalOverride,
  preloadHero = false,
} = Astro.props;

// LCP-preload van de hero-afbeelding. Opties komen uit data/hero-image.ts, net
// als het <picture>-blok in components/Hero.astro — één bron, zodat de preload
// gegarandeerd dezelfde srcset oplevert en er geen tweede download ontstaat.
const heroPreload = preloadHero
  ? await getImage({ src: HERO_IMAGE, ...HERO_IMAGE_OPTIONS })
  : null;

const canonical = canonicalOverride ?? new URL(Astro.url.pathname, 'https://aanloopai.nl').toString();
// Smart suffix: only append " · Aanloop AI" when total stays <=60 chars
// (Google SERP truncation threshold). Hardcoded "Aanloop" in source title
// is respected verbatim — no double-suffix.
const TITLE_SUFFIX = ' · Aanloop AI';
const TITLE_MAX = 60;
const fullTitle = title.includes('Aanloop')
  ? title
  : (title.length + TITLE_SUFFIX.length <= TITLE_MAX ? `${title}${TITLE_SUFFIX}` : title);

// Per-page OG-image: derive from URL path, fallback to default
const ogSlugMap: Record<string, string> = {
  '/': 'home',
  '/diensten/emma/': 'emma',
  '/ai-receptionist-nederland/': 'ai-receptionist-nederland',
  '/ai-roi-calculator/': 'ai-roi-calculator',
  '/no-show-calculator/': 'no-show-calculator',
  '/avg-checklist-ai-mkb/': 'avg-checklist',
  '/kennisbank/': 'kennisbank',
  '/glossarium/': 'glossarium',
  '/locaties/': 'locaties',
};
const ogSlug = ogSlugMap[Astro.url.pathname];
const derivedImage = ogSlug ? `/og/${ogSlug}.png` : image;
const finalImage = image !== '/og-image-default.png' ? image : derivedImage;
const ogImage = finalImage.startsWith('http') ? finalImage : `https://aanloopai.nl${finalImage}`;

// Auto-inject author bio + last-updated on kennisbank-articles (not on index)
const isKennisbankArticle =
  Astro.url.pathname.startsWith('/kennisbank/') &&
  Astro.url.pathname !== '/kennisbank/' &&
  Astro.url.pathname !== '/kennisbank';
const lastUpdated = '1 mei 2026';

// Hide sticky mobile CTA op pages waar het redundant of misplaatst is.
// /contact + /demo-aanvragen + /aanvragen ZIJN de bestemming. /bedankt + /demo-* zijn post-submit. Legal pages zijn geen sales-context.
const stickyCtaHidePaths = new Set([
  '/contact/', '/contact',
  '/demo-aanvragen/', '/demo-aanvragen',
  '/aanvragen/', '/aanvragen',
  '/bedankt/', '/bedankt',
  '/demo-bedankt/', '/demo-bedankt',
  '/demo-bevestigd/', '/demo-bevestigd',
  '/demo-herplannen/', '/demo-herplannen',
  '/demo-inplannen/', '/demo-inplannen',
  '/privacy/', '/privacy',
  '/cookies/', '/cookies',
  '/voorwaarden/', '/voorwaarden',
  '/sla/', '/sla',
  '/disclaimer/', '/disclaimer',
]);
const hideStickyCta = stickyCtaHidePaths.has(Astro.url.pathname);

// ── Organization Schema ────────────────────────────────────────────
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'ProfessionalService'],
  '@id': 'https://aanloopai.nl/#organization',
  name: 'Aanloop AI',
  legalName: 'Aanloop AI',
  alternateName: 'AanloopAI',
  url: 'https://aanloopai.nl',
  logo: {
    '@type': 'ImageObject',
    url: 'https://aanloopai.nl/logo-mark-light-1024.png',
    width: 1024,
    height: 1024,
  },
  description: 'Aanloop AI levert AI agents, voice AI en workflow automation voor het Nederlandse MKB. Van AI-receptionist tot custom n8n workflows — live in 7 werkdagen. KVK: 88606902.',
  slogan: 'AI die echt werkt voor uw bedrijf',
  foundingDate: '2024',
  identifier: {
    '@type': 'PropertyValue',
    name: 'KVK',
    value: '88606902',
  },
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Rotterdam',
    addressLocality: 'Rotterdam',
    addressRegion: 'Zuid-Holland',
    postalCode: '3011',
    addressCountry: 'NL',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: '51.9225',
    longitude: '4.4792',
  },
  areaServed: [
    { '@type': 'City', name: 'Rotterdam' },
    { '@type': 'City', name: 'Amsterdam' },
    { '@type': 'City', name: 'Den Haag' },
    { '@type': 'City', name: 'Utrecht' },
    { '@type': 'Country', name: 'Nederland' },
  ],
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'sales',
    email: 'hello@aanloopai.nl',
    telephone: '+31624741597',
    areaServed: 'NL',
    availableLanguage: ['Dutch', 'English'],
    hoursAvailable: {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '09:00',
      closes: '17:00',
    },
  },
  priceRange: PRICE_RANGE,
  knowsAbout: [
    'Artificial intelligence',
    'AI consulting',
    'AVG / GDPR compliance',
    'EU AI Act',
    'n8n automation',
    'Voice AI',
    'WhatsApp Business API',
    'Dutch MKB / KMO',
    'AI receptionist',
    'AI agent design',
  ],
  sameAs: [
    'https://www.kvk.nl/zoeken/?source=all&q=88606902',
    'https://github.com/aanloopai',
    'https://www.instagram.com/aanloop.ai/',
    'https://www.linkedin.com/company/aanloop-ai',
    'https://www.google.com/maps?cid=13817542784615558433',
    // TODO: voeg toe zodra entity-vermeldingen live zijn:
    // 'https://www.wikidata.org/wiki/[Q-id]',
    // 'https://www.crunchbase.com/organization/aanloop-ai',
    // 'https://www.producthunt.com/products/aanloop-ai',
    // 'https://twitter.com/aanloopai',
    // 'https://nl.trustpilot.com/review/aanloopai.nl',
  ],
  knowsAbout: [
    'AI Agents',
    'Voice AI',
    'AI Automatisering',
    'AI Receptionist',
    'WhatsApp AI Assistent',
    'Workflow Automatisering',
    'n8n Workflow Automation',
    'ElevenLabs Voice AI',
    'EU AI Act Compliance',
    'AVG GDPR Compliance',
    'AI voor MKB Nederland',
    'AI Agency Nederland',
    'Wft Pensioenadvies',
    'Wft Hypothecair Krediet',
    'Wft Vermogen',
    'Wet toekomst pensioenen',
    'AFM Klantbelang Centraal',
    'Wwft clientonderzoek',
    'KiFiD klachtenroute',
  ],
};

// ── WebSite Schema ────────────────────────────────────────────────
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': 'https://aanloopai.nl/#website',
  url: 'https://aanloopai.nl',
  name: 'Aanloop AI',
  description: 'AI-oplossingen voor het Nederlandse MKB',
  publisher: { '@id': 'https://aanloopai.nl/#organization' },
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: 'https://aanloopai.nl/kennisbank/?q={search_term_string}',
    },
    'query-input': 'required name=search_term_string',
  },
};

// ── Speakable Schema (for voice assistants) ───────────────────────
const speakableSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: fullTitle,
  url: canonical,
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['h1', 'main p:first-of-type', '.eyebrow + h2 + p', '[data-speakable]'],
  },
};

// ── FAQ Schema ────────────────────────────────────────────────────
const faqSchemaLD = faqSchema?.length ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqSchema.map(({ question, answer }) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
} : null;

// ── Breadcrumb Schema ─────────────────────────────────────────────
const pathParts = Astro.url.pathname.replace(/\/$/, '').split('/').filter(Boolean);
const breadcrumbSchema = pathParts.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://aanloopai.nl/' },
    ...pathParts.map((part, i) => ({
      '@type': 'ListItem',
      position: i + 2,
      name: part.charAt(0).toUpperCase() + part.slice(1).replace(/-/g, ' '),
      item: `https://aanloopai.nl/${pathParts.slice(0, i + 1).join('/')}/`,
    })),
  ],
} : null;

// ── VideoObject Schema (scaffold — klaar voor YouTube/demo-video's) ─────
const videoSchemaLD = videoSchema ? {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: videoSchema.name,
  description: videoSchema.description,
  thumbnailUrl: videoSchema.thumbnailUrl,
  uploadDate: videoSchema.uploadDate,
  ...(videoSchema.contentUrl ? { contentUrl: videoSchema.contentUrl } : {}),
  ...(videoSchema.embedUrl ? { embedUrl: videoSchema.embedUrl } : {}),
  ...(videoSchema.duration ? { duration: videoSchema.duration } : {}),
  publisher: { '@type': 'Organization', name: 'Aanloop AI', logo: { '@type': 'ImageObject', url: 'https://aanloopai.nl/logo-mark-light-1024.png' } },
} : null;

// Verrijk Article-schema centraal: injecteer image + mainEntityOfPage wanneer de
// pagina ze niet zelf meegeeft, zodat elk kennisbank-artikel/pillar in aanmerking
// komt voor Google Article rich results. Eén plek → alle artikelen. Bestaande
// waarden blijven ongemoeid (idempotent).
const enrichArticle = (s: Record<string, any>): Record<string, any> => {
  if (!s || s['@type'] !== 'Article') return s;
  return {
    ...s,
    image: s.image ?? { '@type': 'ImageObject', url: ogImage, width: 1200, height: 630 },
    mainEntityOfPage: s.mainEntityOfPage ?? { '@type': 'WebPage', '@id': canonical },
  };
};

const allSchemas = [
  orgSchema,
  websiteSchema,
  speakableSchema,
  breadcrumbSchema,
  faqSchemaLD,
  videoSchemaLD,
  ...(Array.isArray(schema) ? schema : schema ? [schema] : []).map(enrichArticle),
].filter(Boolean);
---

<!DOCTYPE html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Consent Mode v2 — defaults: deny until user consents (AVG/GDPR) -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        functionality_storage: 'granted',
        security_storage: 'granted',
        wait_for_update: 200,
      });
      // Eén bron van waarheid voor cookietoestemming. Alle derde-partij-loaders
      // (nu GA4 en ElevenLabs) hangen hieronder via onGrant,
      // zodat geen enkele daarvan zelf localStorage hoeft te lezen — dat was
      // eerder per loader gekopieerd en bij GA4 vergeten, waardoor gtag.js ook
      // bij "alleen noodzakelijk" werd opgehaald.
      // onGrant vuurt óók als de bezoeker pas ná het laden accepteert; de
      // loaders draaiden voorheen op {once:true}-listeners en kwamen dan pas
      // op de vólgende paginaweergave op gang.
      window.__aanloopConsent = (function () {
        var KEY = 'aanloop_cookie_consent';
        var subs = [];
        function read() { try { return localStorage.getItem(KEY); } catch (e) { return null; } }
        function granted() { return read() === 'all'; }
        function flush() {
          var pending = subs.splice(0, subs.length);
          for (var i = 0; i < pending.length; i++) {
            try { pending[i](); } catch (e) {}
          }
        }
        return {
          KEY: KEY,
          read: read,
          granted: granted,
          // fn draait direct als er al toestemming is, anders zodra die er komt.
          onGrant: function (fn) { if (granted()) { try { fn(); } catch (e) {} } else { subs.push(fn); } },
          set: function (value) {
            try { localStorage.setItem(KEY, value); } catch (e) {}
            if (value === 'all') {
              gtag('consent', 'update', {
                ad_storage: 'granted',
                ad_user_data: 'granted',
                ad_personalization: 'granted',
                analytics_storage: 'granted',
              });
              flush();
            }
          },
        };
      })();

      // Honour existing consent on subsequent page loads
      if (window.__aanloopConsent.granted()) {
        gtag('consent', 'update', {
          ad_storage: 'granted',
          ad_user_data: 'granted',
          ad_personalization: 'granted',
          analytics_storage: 'granted',
        });
      }
      gtag('js', new Date());
      // page_location expliciet zonder het "t"-queryparam: dat draagt op
      // /start/voorstel/?t=<token> een 14-dagen-geldige capability (voorstel
      // lezen + magic link versturen naar het klantadres). Zonder deze
      // override stuurt gtag.js automatisch de volledige document.location.href
      // mee als paginalocatie, en belandt dat token in de GA4-property — voor
      // iedereen met viewer-toegang daar. Alleen "t" wordt verwijderd, geen
      // andere querystring (UTM's etc. blijven gewoon meetellen).
      var _gaPageLocation = location.href;
      try {
        var _gaUrl = new URL(location.href);
        _gaUrl.searchParams.delete('t');
        _gaPageLocation = _gaUrl.toString();
      } catch (e) {}
      gtag('config', 'G-VS8SZZ6W45', { anonymize_ip: true, transport_type: 'beacon', page_location: _gaPageLocation });
      window._track = function(name, params) {
        try {
          if (window.gtag) window.gtag('event', name, params || {});
          if (Array.isArray(window.dataLayer)) window.dataLayer.push(Object.assign({ event: name }, params || {}));
        } catch(e) {}
      };
    </script>

    {/*
      De rest van de gedeelde front-end logica staat in public/js/boot.js: de
      GA4-loader, de widget-bootstrap, de exit-intent-modal, de sticky CTA-sync
      en de click-tracking op tel:/wa.me. Dat scheelde ~10 KB ruw (~4 KB gzip)
      per pagina, op 253 pagina's, en de browser cachet het bestand sitebreed.

      Wat hierboven inline blijft is bewust de API-laag: gtag(),
      window.__aanloopConsent en window._track. Inline page-scripts kunnen die
      tijdens het parsen al aanroepen, en een defer-script draait daar te laat
      voor. Alles in boot.js start zichzelf en wordt door niets aangeroepen.
    */}
    <script src="/js/boot.js" defer is:inline></script>
    {/* Zichtbaarheid site-acties beacon (tel/WhatsApp/route/mail/form
        klikken → /api/visibility/event, alleen tellers, geen cookies). */}
    <script src="/v.js" defer is:inline></script>

    <!-- Canonical & Hreflang (NL-only site: one language tag + x-default) -->
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="nl" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />

    <!-- Favicons -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- RSS Feed -->
    <link rel="alternate" type="application/rss+xml" title="Aanloop AI Kennisbank" href="/rss.xml" />

    <!-- PWA Web App Manifest -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="application-name" content="Aanloop AI" />
    <meta name="apple-mobile-web-app-title" content="Aanloop AI" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <!-- Google Search Console verification -->
    <meta name="google-site-verification" content="fqKcaVQJ2__42Y37RHft10dijtbLuGmLfOp4gTOs3dw" />

    <!-- Primary meta -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="AI receptionist, AI automatisering, WhatsApp AI, workflow automatisering, AI assistent Nederland, MKB AI oplossingen" />
    <meta name="author" content="Aanloop AI" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1'} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Aanloop AI" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Aanloop AI — AI-oplossingen voor het Nederlandse MKB" />
    <meta property="og:locale" content="nl_NL" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@aanloopai" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Theme color -->
    <meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0B1120" media="(prefers-color-scheme: dark)" />

    <!-- Core Web Vitals: Resource Hints -->
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <link rel="preconnect" href="https://unpkg.com" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://www.google-analytics.com" />

    <!-- Header-logo staat boven de vouw, maar is NIET de LCP — daarom preloaden
         zonder fetchpriority, zodat het de echte LCP niet voor de voeten loopt. -->
    <link rel="preload" as="image" href="/brand/logo-horizontal-light.svg" />

    {heroPreload && (
      <link
        rel="preload"
        as="image"
        imagesrcset={heroPreload.srcSet.attribute}
        imagesizes={HERO_IMAGE_OPTIONS.sizes}
        media={HERO_MEDIA}
        fetchpriority="high"
      />
    )}

    {/*
      Hier stonden drie niet-geconfigureerde analytics-stubs. Astro-commentaar,
      geen HTML-commentaar: dit hoort in de broncode thuis en niet op 231
      pagina's mee te reizen.

      - Microsoft Clarity (projectId 'XXXXXXXX') — kon nooit laden, ~30 regels
        dode inline-JS per pagina.
      - Meta Pixel + LinkedIn Insight Tag ('META_PIXEL_ID' / 'LI_PARTNER_ID') —
        de ID-check sloeg het laden altijd over, en connect.facebook.net en
        snap.licdn.com staan bovendien niet in de CSP in public/_headers. Wat
        overbleef was ~35 regels inline-JS plus een wrapper om window._track die
        alleen naar window.fbq/window.lintrk schreef: twee objecten die nooit
        bestonden. Het GA4-pad van _track staat los (zie ~regel 408) en is
        ongemoeid gebleven.

      Bij terugzetten: echte ID's invullen, de betreffende hosts aan script-src
      in public/_headers toevoegen, en laden via __aanloopConsent.onGrant, net
      zoals GTM hierboven.
    */}

    <!-- Schema.org JSON-LD -->
    {allSchemas.map(s => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}

  </head>
  <body>
    <!-- Skip to main content — accessibility -->
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-navy focus:text-white focus:rounded-lg"
    >
      Naar hoofdinhoud
    </a>

    <Header />

    <main id="main">
      {pathParts.length > 0 && (
        <nav aria-label="Kruimelpad" class="border-b border-slate-100 bg-white">
          <div class="container-page py-3">
            <ol class="flex flex-wrap items-center gap-1.5 text-xs text-slate-500">
              <li><a href="/" class="hover:text-navy">Home</a></li>
              {pathParts.map((part, i) => {
                const isLast = i === pathParts.length - 1;
                const href = `/${pathParts.slice(0, i + 1).join('/')}/`;
                const label = part.charAt(0).toUpperCase() + part.slice(1).replace(/-/g, ' ');
                return (
                  <>
                    <li aria-hidden="true" class="text-slate-300">›</li>
                    <li>
                      {isLast ? (
                        <span class="text-navy font-medium" aria-current="page">{label}</span>
                      ) : (
                        <a href={href} class="hover:text-navy">{label}</a>
                      )}
                    </li>
                  </>
                );
              })}
            </ol>
          </div>
        </nav>
      )}
      <slot />
      {isKennisbankArticle && (
        <section class="border-t border-slate-200 bg-slate-50/60">
          <div class="container-page max-w-3xl py-12 lg:py-16">
            <div class="flex items-center justify-between text-sm text-slate-500 mb-8">
              <span>Laatst bijgewerkt: {lastUpdated}</span>
              <a href="/kennisbank/" class="hover:text-navy">Terug naar kennisbank</a>
            </div>
            <div class="rounded-2xl border border-slate-200 bg-white p-6 lg:p-8 shadow-sm">
              <div class="flex items-start gap-4">
                <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-navy text-white text-lg font-bold">A</div>
                <div class="min-w-0">
                  <p class="text-xs uppercase tracking-wider text-slate-500 mb-1">Geschreven door</p>
                  <h3 class="text-lg font-bold text-navy">
                    <a href="/over/" class="hover:underline">Team Aanloop AI</a>
                  </h3>
                  <p class="text-sm text-slate-600 mt-1">Het team achter Aanloop AI helpt Nederlandse MKB-bedrijven met de implementatie van AI-receptionisten, WhatsApp-assistenten en workflow automatisering.</p>
                  <div class="flex flex-wrap gap-3 mt-3 text-sm">
                    <a href="/over/" class="text-navy hover:underline">Over ons</a>
                    <a href="https://www.linkedin.com/company/aanloop-ai" rel="noopener" target="_blank" class="text-navy hover:underline">LinkedIn</a>
                    <a href="/contact/" class="text-navy hover:underline">Contact</a>
                  </div>
                </div>
              </div>
