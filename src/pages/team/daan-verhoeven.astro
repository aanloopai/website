---
import BaseLayout from '../../layouts/BaseLayout.astro';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': 'https://aanloopai.nl/team/daan-verhoeven/#person',
  name: 'Daan Verhoeven',
  givenName: 'Daan',
  familyName: 'Verhoeven',
  jobTitle: 'Oprichter & CEO',
  description: 'Oprichter en CEO van Aanloop AI B.V. Specialiseert zich in AI-implementatie voor het Nederlandse MKB: voice AI, WhatsApp Business, n8n workflow automatisering en custom AI agents. 10+ jaar ervaring in tech en automation.',
  url: 'https://aanloopai.nl/team/daan-verhoeven/',
  image: 'https://aanloopai.nl/brand/daan-verhoeven.jpg',
  worksFor: {
    '@type': 'Organization',
    '@id': 'https://aanloopai.nl/#organization',
    name: 'Aanloop AI B.V.',
    url: 'https://aanloopai.nl',
  },
  knowsAbout: [
    'AI-receptionist',
    'Voice AI',
    'WhatsApp Business AI',
    'AI agents',
    'n8n workflow automation',
    'AI voor MKB Nederland',
    'AI implementatie',
    'AVG-compliant AI',
    'NEN 7510',
    'Conversational AI',
    'LLM integratie',
    'Custom AI workflows',
  ],
  knowsLanguage: ['nl', 'en'],
  nationality: { '@type': 'Country', name: 'Netherlands' },
  alumniOf: { '@type': 'EducationalOrganization', name: 'Erasmus Universiteit Rotterdam' },
  sameAs: [
    'https://www.linkedin.com/company/aanloop-ai',
    'https://www.linkedin.com/in/daanverhoeven/',
    'https://aanloopai.nl/',
  ],
};

const articles = [
  { slug: 'wat-is-een-ai-agent', title: 'Wat is een AI agent? Complete gids voor MKB' },
  { slug: 'ai-agent-kosten-mkb', title: 'AI agent kosten voor MKB Nederland 2026' },
  { slug: 'ai-implementatie-stappen-mkb-nederland', title: 'AI implementatie in 7 stappen voor MKB' },
  { slug: 'ai-avg-gdpr-compliance-mkb-nederland', title: 'AI en AVG-compliance voor MKB Nederland' },
  { slug: 'ai-roi-berekenen-mkb-nederland-2026', title: 'AI ROI berekenen voor MKB 2026' },
  { slug: 'ai-no-show-reductie-mkb-nederland', title: 'AI no-show reductie voor MKB' },
  { slug: 'ai-voicebot-vs-chatbot-mkb-vergelijking', title: 'AI Voicebot vs Chatbot vergelijking' },
  { slug: 'ai-voor-huisartsenpraktijk', title: 'AI voor huisartsenpraktijk' },
  { slug: 'ai-voor-accountantskantoor-nederland', title: 'AI voor accountantskantoor' },
  { slug: 'ai-voor-advocatenkantoor-2026', title: 'AI voor advocatenkantoor 2026' },
];
---

<BaseLayout
  title="Daan Verhoeven — Oprichter Aanloop AI"
  description="Daan Verhoeven, oprichter en CEO van Aanloop AI B.V. Expert AI-implementatie voor Nederlands MKB: voice AI, WhatsApp en n8n workflows. 10+ jaar tech-ervaring."
  schema={personSchema}
>
  <section class="section">
    <div class="container-page max-w-4xl">
      <div class="grid lg:grid-cols-3 gap-10 items-start">
        <div class="lg:col-span-1">
          <div class="aspect-square w-full bg-gradient-to-br from-indigo-50 to-emerald-50 rounded-2xl overflow-hidden ring-1 ring-slate-200 flex items-center justify-center">
            <span class="text-6xl font-bold text-slate-400">DV</span>
          </div>

          <div class="mt-6 space-y-3">
            <a href="https://www.linkedin.com/in/daanverhoeven/" target="_blank" rel="noopener" class="flex items-center gap-2 text-sm text-slate-600 hover:text-brand-indigo transition-colors">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              LinkedIn profiel
            </a>
            <a href="mailto:daan@aanloopai.nl" class="flex items-center gap-2 text-sm text-slate-600 hover:text-brand-indigo transition-colors">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              daan@aanloopai.nl
            </a>
            <a href="https://wa.me/31624741597" target="_blank" rel="noopener" class="flex items-center gap-2 text-sm text-slate-600 hover:text-green-700 transition-colors">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              +31 6 24741597
            </a>
          </div>
        </div>

        <div class="lg:col-span-2">
          <p class="eyebrow text-brand-indigo mb-3">Oprichter &amp; CEO Aanloop AI</p>
          <h1 class="text-3xl lg:text-4xl font-bold text-navy tracking-tightest mb-6">Daan Verhoeven</h1>

          <div class="space-y-5 text-slate-600 leading-relaxed">
            <p>Daan Verhoeven is de oprichter en CEO van Aanloop AI B.V. Hij richtte het bedrijf in 2024 op om Nederlandse MKB-ondernemingen toegang te geven tot enterprise-grade AI-oplossingen die normaal alleen voor multinationals beschikbaar zijn. Aanloop AI bedient inmiddels meer dan 80 Nederlandse klanten, van huisartsenpraktijken tot bouwbedrijven en advocatenkantoren.</p>

            <p>Voor het oprichten van Aanloop AI werkte Daan 10+ jaar in technologie en process automation, met focus op het bouwen van digitale oplossingen voor het MKB. Hij raakte ervan overtuigd dat de meeste AI-implementaties faalden omdat consultants te ver van het dagelijkse MKB-werk stonden — en bouwde Aanloop AI als directe reactie: AI die echt werkt voor uw bedrijf, niet voor PowerPoint-decks.</p>

            <p>Daan publiceert regelmatig over AI-implementatie voor het Nederlandse MKB. Zijn 48 kennisbank-artikelen op aanloopai.nl behandelen sectorspecifieke vraagstukken (van AVG-compliance voor advocaten tot no-show reductie in de zorg) en zijn gebaseerd op directe klantdata van Aanloop AI.</p>
          </div>

          <div class="mt-8 grid sm:grid-cols-2 gap-4">
            <div class="card p-5 bg-slate-50">
              <p class="text-xs uppercase tracking-wider text-slate-500 mb-1">Expertise</p>
              <p class="font-semibold text-navy text-sm">Voice AI, WhatsApp Business, n8n workflows, AVG-compliance, AI ROI</p>
            </div>
            <div class="card p-5 bg-slate-50">
              <p class="text-xs uppercase tracking-wider text-slate-500 mb-1">Branche-ervaring</p>
              <p class="font-semibold text-navy text-sm">Zorg, advocatuur, accountancy, bouw, retail, horeca, vastgoed</p>
            </div>
            <div class="card p-5 bg-slate-50">
              <p class="text-xs uppercase tracking-wider text-slate-500 mb-1">Bedrijf</p>
              <p class="font-semibold text-navy text-sm">Aanloop AI B.V. — KvK 88606902 — Rotterdam</p>
            </div>
            <div class="card p-5 bg-slate-50">
              <p class="text-xs uppercase tracking-wider text-slate-500 mb-1">Talen</p>
              <p class="font-semibold text-navy text-sm">Nederlands (moedertaal), Engels (vloeiend)</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-slate-50/60 border-y border-slate-200">
    <div class="container-page max-w-4xl">
      <h2 class="text-2xl lg:text-3xl font-bold text-navy mb-8">Artikelen door Daan Verhoeven</h2>
      <div class="grid sm:grid-cols-2 gap-4">
        {articles.map((a) => (
          <a href={`/kennisbank/${a.slug}/`} class="card p-5 hover:shadow-md hover:-translate-y-0.5 transition-all bg-white">
            <p class="text-xs text-brand-indigo font-medium mb-2">Kennisbank</p>
            <p class="font-semibold text-navy text-sm leading-snug">{a.title}</p>
            <p class="text-xs text-slate-500 mt-3 flex items-center gap-1">Lees gids →</p>
          </a>
        ))}
      </div>
      <div class="mt-8 text-center">
        <a href="/kennisbank/" class="btn-outline">Alle 48 kennisbank-artikelen</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page max-w-3xl text-center">
      <h2 class="text-2xl lg:text-3xl font-bold text-navy mb-4">Praat direct met Daan</h2>
      <p class="text-slate-600 mb-8">Plan een gratis 30-minuten gesprek. Geen verplichtingen — Daan beantwoordt al uw vragen over AI-implementatie voor uw specifieke situatie.</p>
      <div class="flex flex-wrap justify-center gap-3">
        <a href="/demo-aanvragen/" class="btn-primary">Plan gratis demo</a>
        <a href="https://wa.me/31624741597" class="btn-outline">WhatsApp Daan</a>
      </div>
    </div>
  </section>
</BaseLayout>
