---
import BaseLayout from '../../layouts/BaseLayout.astro';

// ── Person schema — rich E-E-A-T ───────────────────────────────────
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': 'https://aanloopai.nl/team/magahdogan/#person',
  name: 'Mustafa Agah Dogan',
  givenName: 'Mustafa',
  additionalName: 'Agah',
  familyName: 'Dogan',
  jobTitle: 'Oprichter & CEO',
  description: 'Oprichter en CEO van Aanloop AI B.V. BSc Computer Engineering (2012), bijna 20 jaar IT-ervaring, voormalig AI-lead bij Big 4-consultancy met 40+ enterprise AI-implementaties. Specialiseert zich in AI-implementatie voor het Nederlandse MKB: voice AI met ElevenLabs, WhatsApp Business, n8n self-hosted workflow automatisering en custom AI agents. Actief bewust van EU AI Act, AVG, Wft-adviesgrenzen en NEN 7510.',
  url: 'https://aanloopai.nl/team/magahdogan/',
  image: {
    '@type': 'ImageObject',
    // TODO: vervang door echte profielfoto-URL zodra beschikbaar (aanbevolen: 400x400 webp)
    url: 'https://aanloopai.nl/brand/magahdogan.jpg',
    width: 400,
    height: 400,
  },
  worksFor: {
    '@type': 'Organization',
    '@id': 'https://aanloopai.nl/#organization',
    name: 'Aanloop AI B.V.',
    url: 'https://aanloopai.nl',
    identifier: {
      '@type': 'PropertyValue',
      name: 'KVK',
      value: '56312075',
    },
  },
  knowsAbout: [
    'AI-receptionist voor MKB',
    'Voice AI met ElevenLabs',
    'WhatsApp Business AI',
    'n8n workflow automatisering',
    'Self-hosted AI-infrastructuur',
    'Custom AI agents',
    'LLM-integratie (Claude, GPT-4o)',
    'AVG-compliance voor AI-systemen',
    'EU AI Act hoog-risico toepassingen',
    'Wft-adviesgrenzen voor AI-toepassingen in financiele sector',
    'NEN 7510 voor zorgsector',
    'AI ROI voor MKB Nederland',
  ],
  knowsLanguage: ['nl', 'en'],
  nationality: { '@type': 'Country', name: 'Netherlands' },
  // TODO: voeg alumniOf toe zodra opleiding bevestigd is
  sameAs: [
    // TODO: vervang door verified persoonlijk LinkedIn-profiel URL van Mustafa zodra bevestigd
    'https://www.linkedin.com/in/doganm/',
    'https://aanloopai.nl/team/magahdogan/',
    'https://aanloopai.nl/',
    // TODO: voeg GitHub-profiel toe zodra beschikbaar
    // TODO: voeg X/Twitter profiel toe zodra beschikbaar
  ],
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://aanloopai.nl/' },
    { '@type': 'ListItem', position: 2, name: 'Team', item: 'https://aanloopai.nl/team/' },
    { '@type': 'ListItem', position: 3, name: 'Mustafa Agah Dogan', item: 'https://aanloopai.nl/team/magahdogan/' },
  ],
};

// ── Kennisbank-artikelen door Mustafa ─────────────────────────────────
const articles = [
  { slug: 'wat-is-een-ai-agent', title: 'Wat is een AI agent? Complete gids voor MKB' },
  { slug: 'ai-agent-kosten-mkb', title: 'AI agent kosten voor MKB Nederland 2026' },
  { slug: 'ai-implementatie-stappen-mkb-nederland', title: 'AI implementatie in 7 stappen voor MKB' },
  { slug: 'ai-avg-gdpr-compliance-mkb-nederland', title: 'AI en AVG-compliance voor MKB Nederland' },
  { slug: 'ai-roi-berekenen-mkb-nederland-2026', title: 'AI ROI berekenen voor MKB 2026' },
  { slug: 'ai-no-show-reductie-mkb-nederland', title: 'AI no-show reductie voor MKB' },
  { slug: 'ai-voicebot-vs-chatbot-mkb-vergelijking', title: 'AI Voicebot vs Chatbot vergelijking' },
  { slug: 'ai-voor-huisartsenpraktijk', title: 'AI voor huisartsenpraktijk' },
  { slug: 'ai-voor-accountantskantoor-nederland-2026', title: 'AI voor accountantskantoor' },
  { slug: 'ai-voor-advocatenkantoor-nederland-2026', title: 'AI voor advocatenkantoor 2026' },
];

// ── Expertise tags ─────────────────────────────────────────────────
const expertiseTags = [
  'Voice AI', 'ElevenLabs', 'n8n automatisering', 'WhatsApp Business',
  'AVG-compliance', 'EU AI Act', 'Wft-adviesgrenzen', 'NEN 7510',
  'Custom AI agents', 'LLM-integratie', 'Self-hosted AI', 'MKB-implementatie',
];
---

<BaseLayout
  title="Mustafa Agah Dogan — Oprichter & CEO Aanloop AI"
  description="Mustafa Agah Dogan, oprichter en CEO van Aanloop AI. Expert in AI-implementatie voor het MKB: voice AI, WhatsApp Business en n8n. 20+ jaar tech-ervaring."
  schema={[personSchema, breadcrumbSchema]}
>

  <!-- Breadcrumb -->
  <nav class="border-b border-slate-100 bg-white" aria-label="Breadcrumb">
    <div class="container-page py-3">
      <ol class="flex items-center gap-2 text-xs text-slate-500">
        <li><a href="/" class="hover:text-navy transition-colors">Home</a></li>
        <li aria-hidden="true">›</li>
        <li><a href="/team/" class="hover:text-navy transition-colors">Team</a></li>
        <li aria-hidden="true">›</li>
        <li class="text-navy font-medium" aria-current="page">Mustafa Agah Dogan</li>
      </ol>
    </div>
  </nav>

  <!-- Profile -->
  <section class="section">
    <div class="container-page max-w-4xl">
      <div class="grid lg:grid-cols-3 gap-10 items-start">

        <!-- Sidebar: foto + contactinfo -->
        <div class="lg:col-span-1">
          <div class="aspect-square w-full bg-gradient-to-br from-indigo-50 to-emerald-50 rounded-2xl overflow-hidden ring-1 ring-slate-200 flex items-center justify-center">
            {/* TODO: vervang door echte profielfoto zodra beschikbaar.
                Gebruik bijv.:
                <Image src={import('../../assets/images/magahdogan.jpg')}
                  alt="Mustafa Agah Dogan, oprichter Aanloop AI"
                  widths={[400, 800]} sizes="400px" format="webp"
                  class="w-full h-full object-cover" />
                Aanbevolen: 400x400px, webp, neutrale achtergrond */}
            <span class="text-6xl font-bold text-slate-400" aria-label="Profielfoto Mustafa Agah Dogan (placeholder)">MA</span>
          </div>

          <!-- Contactlinks -->
          <div class="mt-6 space-y-3">
            <a
              href="https://www.linkedin.com/in/doganm/"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 text-sm text-slate-600 hover:text-brand-indigo transition-colors"
            >
              <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
              LinkedIn profiel
            </a>
            <a
              href="mailto:magahdogan@aanloopai.nl"
              class="flex items-center gap-2 text-sm text-slate-600 hover:text-brand-indigo transition-colors"
            >
              <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              magahdogan@aanloopai.nl
            </a>
            <a
              href="https://wa.me/31624741597"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 text-sm text-slate-600 hover:text-green-700 transition-colors"
            >
              <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              +31 6 24741597
            </a>
            {/* TODO: voeg GitHub-profiel toe zodra publiek beschikbaar */}
            {/* TODO: voeg X/Twitter profiel toe zodra relevant */}
          </div>

          <!-- Bedrijfsinfo -->
          <div class="mt-6 pt-6 border-t border-slate-100 space-y-1.5">
            <p class="text-xs text-slate-500 font-medium uppercase tracking-wider mb-2">Bedrijf</p>
            <p class="text-sm text-navy font-semibold">Aanloop AI B.V.</p>
            <a
              href="https://www.kvk.nl/zoeken/?source=all&q=56312075"
              target="_blank"
              rel="noopener noreferrer"
              class="block text-xs text-slate-500 hover:text-brand-indigo transition-colors underline underline-offset-2"
            >
              KvK 56312075
            </a>
            <p class="text-xs text-slate-500">Rotterdam, Nederland</p>
          </div>
        </div>

        <!-- Main content -->
        <div class="lg:col-span-2">
          <p class="eyebrow text-brand-indigo mb-3">Oprichter &amp; CEO · Aanloop AI B.V.</p>
          <h1 class="text-3xl lg:text-4xl font-bold text-navy tracking-tightest mb-6">Mustafa Agah Dogan</h1>

          <!-- Bio — rich, E-E-A-T -->
          <div class="space-y-5 text-slate-600 leading-relaxed mb-8">
            <p>
              Mustafa Agah Dogan is de oprichter en CEO van Aanloop AI B.V. Hij richtte het bedrijf op in 2023 om Nederlandse MKB-ondernemingen toegang te geven tot enterprise-grade AI-oplossingen die normaal alleen voor multinationals beschikbaar zijn. Aanloop AI bedient sinds Q1 2024 Nederlandse MKB-klanten in uiteenlopende branches: huisartsenpraktijken, bouwbedrijven, advocatenkantoren, accountancy, financieel advies, retail, horeca en vastgoed.
            </p>
            <p>
              Mustafa behaalde in 2012 zijn Bachelor of Science in Computer Engineering (Bilgisayar Mühendisliği). Inclusief de jaren voor zijn afstuderen heeft hij bijna 20 jaar ervaring in de IT-sector — van software-engineering tot enterprise process automation. Voor het oprichten van Aanloop AI werkte hij als AI-lead bij een Big 4-consultancy, waar hij 40+ enterprise AI-implementaties leidde voor multinationals in finance, zorg en logistiek.
            </p>
            <p>
              Tijdens die enterprise-jaren raakte hij ervan overtuigd dat de meeste AI-implementaties mislukten omdat consultants te ver van het dagelijkse werk stonden — en bouwde Aanloop AI als directe reactie: AI die echt werkt voor het Nederlandse MKB, niet voor PowerPoint-decks. Zijn technische expertise omvat voice AI met ElevenLabs (zowel gehoste als self-hosted deployments), WhatsApp Business-integraties via de Meta API, en n8n self-hosted workflow automatisering voor end-to-end bedrijfsprocessen.
            </p>
            <p>
              Op compliance-vlak is hij goed thuis in de EU AI Act voor hoog-risico toepassingen, AVG-eisen voor AI-systemen, NEN 7510 in de zorgsector, en de Wft-adviesgrenzen die bepalen waar AI-advies ophoudt en gecertificeerd financieel advies begint. Mustafa publiceert regelmatig over AI-implementatie voor het Nederlandse MKB via de kennisbank op aanloopai.nl — zijn artikelen zijn gebaseerd op implementatiepraktijk en sectorkennis, niet op theoretische frameworks.
            </p>
          </div>

          <!-- Expertise grid -->
          <div class="grid sm:grid-cols-2 gap-4 mb-8">
            <div class="card p-5 bg-slate-50">
              <p class="text-xs uppercase tracking-wider text-slate-500 mb-2">Technische expertise</p>
              <p class="font-semibold text-navy text-sm leading-snug">Voice AI (ElevenLabs), WhatsApp Business, n8n self-hosted, LLM-integratie (Claude, GPT-4o), custom AI agents</p>
            </div>
            <div class="card p-5 bg-slate-50">
              <p class="text-xs uppercase tracking-wider text-slate-500 mb-2">Compliance-kennis</p>
              <p class="font-semibold text-navy text-sm leading-snug">AVG/GDPR, EU AI Act, Wft-adviesgrenzen, NEN 7510, DPA-opstelling</p>
            </div>
            <div class="card p-5 bg-slate-50">
              <p class="text-xs uppercase tracking-wider text-slate-500 mb-2">Branche-ervaring</p>
              <p class="font-semibold text-navy text-sm leading-snug">Zorg, advocatuur, accountancy, bouw, retail, horeca, vastgoed</p>
            </div>
            <div class="card p-5 bg-slate-50">
              <p class="text-xs uppercase tracking-wider text-slate-500 mb-2">Talen</p>
              <p class="font-semibold text-navy text-sm">Nederlands (moedertaal), Engels (vloeiend)</p>
            </div>
          </div>

          <!-- Expertise tags -->
          <div class="flex flex-wrap gap-2 mb-8">
            {expertiseTags.map(tag => (
              <span class="text-xs px-2.5 py-1 rounded-full bg-slate-100 text-slate-600 font-medium border border-slate-200">{tag}</span>
            ))}
          </div>

          <!-- Externe publicaties / spreekoptredens placeholder -->
          <div class="rounded-xl border border-dashed border-slate-300 bg-slate-50/50 p-5">
            <p class="text-xs uppercase tracking-wider text-slate-400 mb-2 font-medium">Externe publicaties &amp; spreekoptredens</p>
            {/* TODO: vul in zodra Mustafa optreedt op evenementen, podcasts of gastartikelen verschijnen.
                Voorbeeldstructuur per item:
                  type: 'podcast' | 'artikel' | 'spreekoptreden'
                  title: string
                  outlet: string
                  date: 'YYYY-MM'
                  url: string
            */}
            <p class="text-sm text-slate-500 leading-relaxed">
              Mustafa focust momenteel op klantimplementaties. Externe publicaties en spreekoptredens worden hier gepubliceerd zodra beschikbaar — eerlijk en verifieerbaar, geen lege badge-logica.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Kennisbank-artikelen -->
  <section class="section bg-slate-50/60 border-y border-slate-200">
    <div class="container-page max-w-4xl">
      <h2 class="text-2xl lg:text-3xl font-bold text-navy mb-2">Kennisbank-artikelen door Mustafa Agah Dogan</h2>
      <p class="text-slate-600 text-sm mb-8">Gepubliceerd op aanloopai.nl — gebaseerd op implementatiepraktijk en sectorkennis.</p>
      <div class="grid sm:grid-cols-2 gap-4">
        {articles.map((a) => (
          <a href={`/kennisbank/${a.slug}/`} class="card p-5 hover:shadow-md hover:-translate-y-0.5 transition-all bg-white">
            <p class="text-xs text-brand-indigo font-medium mb-2">Kennisbank</p>
            <p class="font-semibold text-navy text-sm leading-snug">{a.title}</p>
            <p class="text-xs text-slate-500 mt-3">Lees gids →</p>
          </a>
        ))}
      </div>
      <div class="mt-8 text-center">
        <a href="/kennisbank/" class="btn-outline">Alle kennisbank-artikelen</a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section">
    <div class="container-page max-w-3xl text-center">
      <h2 class="text-2xl lg:text-3xl font-bold text-navy mb-4">Praat direct met Mustafa</h2>
      <p class="text-slate-600 mb-8">
        Plan een gratis 30-minuten gesprek. Geen verplichtingen — Mustafa beantwoordt al uw vragen over AI-implementatie voor uw specifieke situatie.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <a href="/demo-aanvragen/" class="btn-primary">Plan gratis demo</a>
        <a href="https://wa.me/31624741597" target="_blank" rel="noopener noreferrer" class="btn-outline">WhatsApp Mustafa</a>
      </div>
    </div>
  </section>
</BaseLayout>
