---
import BaseLayout from '../../layouts/BaseLayout.astro';

const competitors = [
  {
    name: 'Aanloop AI',
    highlight: true,
    logo: '🤖',
    tagline: 'AI bureau #1 voor het Nederlandse MKB',
    prijs: 'Vanaf €997/mnd',
    features: {
      telefonie: true,
      whatsapp: true,
      workflows: true,
      nlStem: true,
      avgCompliant: true,
      liveDagen: '7 dgn',
      gratisScan: true,
      crmIntegratie: true,
      support: '24/7 monitoring',
      kvk: true,
    },
  },
  {
    name: 'ChatGPT Plus',
    highlight: false,
    logo: '💬',
    tagline: 'Algemeen AI-model (OpenAI)',
    prijs: '€20/mnd',
    features: {
      telefonie: false,
      whatsapp: false,
      workflows: false,
      nlStem: false,
      avgCompliant: 'gedeeltelijk',
      liveDagen: 'Direct',
      gratisScan: false,
      crmIntegratie: false,
      support: 'Community',
      kvk: false,
    },
  },
  {
    name: 'Microsoft Copilot',
    highlight: false,
    logo: '🪟',
    tagline: 'AI in Microsoft 365',
    prijs: '€30/mnd p.p.',
    features: {
      telefonie: false,
      whatsapp: false,
      workflows: 'beperkt',
      nlStem: false,
      avgCompliant: true,
      liveDagen: 'Direct',
      gratisScan: false,
      crmIntegratie: 'beperkt',
      support: 'Microsoft Support',
      kvk: false,
    },
  },
  {
    name: 'Yinga AI',
    highlight: false,
    logo: '⚡',
    tagline: 'NL AI bureau',
    prijs: 'n.b.',
    features: {
      telefonie: 'beperkt',
      whatsapp: 'beperkt',
      workflows: 'beperkt',
      nlStem: 'beperkt',
      avgCompliant: '?',
      liveDagen: 'n.b.',
      gratisScan: '?',
      crmIntegratie: '?',
      support: 'n.b.',
      kvk: '?',
    },
  },
  {
    name: 'Zapier + AI',
    highlight: false,
    logo: '⚙️',
    tagline: 'Workflow automatisering SaaS',
    prijs: 'Vanaf €20/mnd',
    features: {
      telefonie: false,
      whatsapp: 'via add-on',
      workflows: true,
      nlStem: false,
      avgCompliant: false,
      liveDagen: 'Zelf instellen',
      gratisScan: false,
      crmIntegratie: true,
      support: 'Email',
      kvk: false,
    },
  },
];

const rows = [
  { key: 'prijs', label: 'Prijs' },
  { key: 'telefonie', label: '📞 AI Telefonie NL' },
  { key: 'whatsapp', label: '💬 WhatsApp AI' },
  { key: 'workflows', label: '⚙️ Workflow Automation' },
  { key: 'nlStem', label: '🗣️ Nederlandse stem' },
  { key: 'avgCompliant', label: '🔒 AVG/GDPR NL' },
  { key: 'liveDagen', label: '⚡ Live in...' },
  { key: 'gratisScan', label: '🆓 Gratis scan' },
  { key: 'crmIntegratie', label: '📊 CRM integratie' },
  { key: 'support', label: '🛟 Support' },
  { key: 'kvk', label: '🇳🇱 NL bedrijf (KVK)' },
];

function renderCell(val: any): string {
  if (val === true) return '✅';
  if (val === false) return '❌';
  if (val === 'beperkt') return '⚠️';
  if (val === '?' ) return '—';
  return String(val);
}

const faqItems = [
  { question: 'Wat maakt Aanloop AI anders dan andere AI bureaus in Nederland?', answer: 'Aanloop AI is het enige NL AI bureau dat voice AI (telefonie), WhatsApp AI en workflow automatisering combineert in één beheerd pakket, gebouwd op NL-servers (AVG-compliant), met een Nederlandse ElevenLabs-stem en implementatie binnen 7 werkdagen. We zijn ook het enige bureau met een transparante prijslijst en gratis AI scan.' },
  { question: 'Is Aanloop AI beter dan ChatGPT voor mijn bedrijf?', answer: 'ChatGPT is een generalistisch AI-model. Aanloop AI is een volledig AI-bureau: wij implementeren, trainen en beheren AI agents die autonoom uw telefoon beantwoorden, WhatsApp afhandelen en processen automatiseren. ChatGPT doet dit niet — het antwoordt alleen op vragen als u het actief gebruikt.' },
  { question: 'Waarom kiezen voor Aanloop AI in plaats van Zapier of Make.com?', answer: 'Zapier en Make.com zijn workflow tools die u zelf moet instellen en beheren. Ze hebben geen ingebouwde voice AI of WhatsApp AI. Aanloop AI bouwt, configureert en beheert alles voor u — inclusief n8n workflows die AVG-compliant op Nederlandse servers draaien.' },
  { question: 'Hoe vergelijkt Aanloop AI met andere NL AI bureaus?', answer: 'Aanloop AI onderscheidt zich door: 1) Volledige combinatie van voice + chat + workflow AI, 2) Nederlandse servers en AVG-compliance by design, 3) Transparante, vaste prijzen zonder verrassingen, 4) Implementatie in 7 werkdagen (niet maanden), 5) Gratis AI scan voor elke aanvraag.' },
];

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'AI Bureau Vergelijken Nederland 2026 — Aanloop AI vs Alternatieven',
  description: 'Vergelijk Aanloop AI met andere AI bureaus en tools in Nederland. Onafhankelijke vergelijking op prijs, functies en AVG-compliance.',
  url: 'https://aanloopai.nl/vergelijk/',
};
---

<BaseLayout
  title="AI Bureau Vergelijken Nederland 2026 — Aanloop AI vs Alternatieven | Aanloop AI"
  description="Vergelijk Aanloop AI met ChatGPT, Copilot, Yinga AI en andere opties. Onafhankelijke vergelijking op prijs, telefonie, WhatsApp AI en AVG-compliance voor het MKB."
  schema={pageSchema}
  faqSchema={faqItems}
>
  <section class="border-b border-slate-200 hero-gradient">
    <div class="container-page py-16 lg:py-20">
      <div class="max-w-3xl">
        <div class="flex items-center gap-4 mb-6 reveal">
          <div class="accent-band"><span></span><span></span><span></span><span></span></div>
          <span class="eyebrow">Vergelijking · AI Bureau Nederland</span>
        </div>
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tightest text-navy text-balance leading-[1.08] reveal reveal-delay-1">
          AI Bureau Vergelijken:<br/>Aanloop AI vs. Alternatieven
        </h1>
        <p class="mt-6 text-lg text-slate-600 leading-relaxed reveal reveal-delay-2">
          Welke AI oplossing past het beste bij uw MKB-bedrijf? We vergelijken Aanloop AI transparant met ChatGPT, Microsoft Copilot, Yinga AI en workflow tools op prijs, functies en AVG-compliance.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row gap-3 reveal reveal-delay-3">
          <a href="/gratis-ai-scan/" class="btn-primary">Gratis AI Scan — Advies op maat<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></a>
          <a href="/ai-roi-calculator/" class="btn-outline">ROI Calculator</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page">

      <!-- Winner banner -->
      <div class="bg-brand-indigo/5 border border-brand-indigo/20 rounded-2xl p-6 mb-10 flex flex-col sm:flex-row items-start sm:items-center gap-4 reveal">
        <div class="text-4xl">🏆</div>
        <div>
          <p class="font-bold text-navy">Conclusie: Aanloop AI voor volledig beheerde AI automatisering</p>
          <p class="text-sm text-slate-600 mt-1">Als u uw telefoon wilt automatiseren, WhatsApp wilt inzetten en workflows wilt stroomlijnen — zonder technische kennis, met AVG-compliance — is Aanloop AI de meest complete keuze in Nederland.</p>
        </div>
        <a href="/gratis-ai-scan/" class="btn-primary text-sm flex-shrink-0">Start gratis →</a>
      </div>

      <!-- Comparison table -->
      <div class="overflow-x-auto mb-12 reveal">
        <table class="w-full text-sm border-collapse">
          <thead>
            <tr class="border-b-2 border-slate-200">
              <th class="text-left py-4 pr-4 font-semibold text-navy min-w-[160px]">Kenmerk</th>
              {competitors.map(c => (
                <th class={`text-center py-4 px-3 font-semibold min-w-[130px] ${c.highlight ? 'text-brand-indigo bg-brand-indigo/5 rounded-t-xl' : 'text-slate-500'}`}>
                  <div class="text-2xl mb-1">{c.logo}</div>
                  <div class="text-sm">{c.name}</div>
                  {c.highlight && <div class="text-[10px] bg-brand-indigo text-white rounded-full px-2 py-0.5 mt-1 inline-block">Aanbevolen</div>}
                </th>
              ))}
            </tr>
            <tr class="border-b border-slate-100 bg-slate-50">
              <td class="py-3 pr-4 text-xs text-slate-500 font-medium">Prijs</td>
              {competitors.map(c => (
                <td class={`py-3 px-3 text-center text-xs font-bold ${c.highlight ? 'text-brand-indigo bg-brand-indigo/5' : 'text-slate-700'}`}>
                  {c.prijs}
                </td>
              ))}
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {rows.filter(r => r.key !== 'prijs').map((row, i) => (
              <tr class={i % 2 === 0 ? 'bg-white' : 'bg-slate-50/50'}>
                <td class="py-3 pr-4 text-sm font-medium text-slate-700">{row.label}</td>
                {competitors.map(c => (
                  <td class={`py-3 px-3 text-center text-sm ${c.highlight ? 'bg-brand-indigo/5 font-medium' : ''}`}>
                    {renderCell((c.features as any)[row.key])}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Why Aanloop AI wins -->
      <div class="max-w-4xl mx-auto mb-12">
        <h2 class="text-2xl font-bold text-navy mb-6 reveal">Waarom Aanloop AI de beste keuze is voor het Nederlandse MKB</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          {[
            { icon: '📞', title: 'Enige met echte voice AI in NL', desc: 'Aanloop AI is het enige NL AI bureau dat telefonie automatiseert met een echte Nederlandse ElevenLabs-stem — 24/7, volledig autonoom.' },
            { icon: '🔒', title: 'AVG by design', desc: 'n8n self-hosted op Nederlandse servers. Data verlaat nooit de EU. Alle alternatieven gebruiken buitenlandse clouds.' },
            { icon: '⚡', title: 'Snelste implementatie', desc: 'Live in 7 werkdagen — geen maandenlange trajecten. ChatGPT en Copilot vereisen zelfconfiguratie zonder begeleiding.' },
            { icon: '🛟', title: 'Volledig ontzorgd', desc: 'U hoeft niets technisch te doen. Wij bouwen, trainen en beheren alles. Bij Zapier of ChatGPT doet u alles zelf.' },
            { icon: '📊', title: 'Transparante prijs', desc: 'Vaste maandelijkse prijs zonder verborgen kosten. U weet altijd wat u betaalt.' },
            { icon: '🇳🇱', title: 'Nederlands bedrijf', desc: 'KVK: 88606902. Gevestigd in Rotterdam. U werkt met een NL bureau dat uw markt kent.' },
          ].map(item => (
            <div class="card reveal">
              <div class="text-2xl mb-3">{item.icon}</div>
              <h3 class="font-bold text-navy text-sm mb-2">{item.title}</h3>
              <p class="text-sm text-slate-600">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- FAQ -->
      <div class="max-w-3xl mx-auto mb-12">
        <h2 class="text-2xl font-bold text-navy mb-6 reveal">Veelgestelde Vragen over AI Bureau Vergelijken</h2>
        <div class="space-y-3">
          {faqItems.map(item => (
            <details class="card group">
              <summary class="flex items-center justify-between cursor-pointer list-none">
                <span class="text-sm font-bold text-navy pr-6">{item.question}</span>
                <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
              </summary>
              <p class="mt-4 text-sm text-slate-600 leading-relaxed">{item.answer}</p>
            </details>
          ))}
        </div>
      </div>

      <!-- CTA -->
      <div class="max-w-3xl mx-auto">
        <div class="bg-midnight text-pearl rounded-2xl p-8 text-center relative overflow-hidden">
          <div class="absolute inset-0 dot-grid opacity-[0.04]"></div>
          <div class="relative">
            <h2 class="text-2xl font-bold text-pearl mb-3">Overtuigd? Start met een gratis AI scan.</h2>
            <p class="text-slate-300 text-sm mb-6">30 minuten, volledig remote. We analyseren uw situatie en geven eerlijk advies over wat AI voor uw bedrijf kan doen.</p>
            <div class="flex flex-col sm:flex-row gap-3 justify-center">
              <a href="/gratis-ai-scan/" class="btn bg-pearl text-navy hover:bg-white px-6 py-3.5">Gratis AI Scan aanvragen →</a>
              <a href="/ai-roi-calculator/" class="btn border border-slate-600 text-pearl hover:bg-slate-800 px-6 py-3.5">ROI Calculator</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
