---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Comparison page: Aanloop AI vs Voicelabs
// Verbeterd met competitive audit inzichten (mei 2026).
// Bron: voicelabs.nl publieke website + sitemap per mei 2026.
// Aanloop data: tarieven.astro / diensten/marco.astro / over.astro / diensten/ai-website-bundel-mkb-nederland.astro.
// Fair-compare format: alleen publiek geverifieerde feiten, expliciete disclaimer,
// neutraal taal en bron-attribution. Reclame Code conform.

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Aanloop AI vs Voicelabs: welke past bij uw MKB?',
  description: 'Eerlijke vergelijking tussen Aanloop AI (managed AI-bureau NL, vanaf 597 euro per maand) en Voicelabs Robin (zelf-instelbaar voice+WhatsApp platform) voor Nederlandse MKB-bedrijven. Prijs, datalocatie, website-bundel, sector-compliance en integraties vergeleken op publieke gegevens per mei 2026.',
  author: {
    '@type': 'Person',
    name: 'Daan Verhoeven',
    '@id': 'https://aanloopai.nl/team/daan-verhoeven/#person',
    url: 'https://aanloopai.nl/team/daan-verhoeven/',
  },
  publisher: {
    '@type': 'Organization',
    '@id': 'https://aanloopai.nl/#organization',
    name: 'Aanloop AI',
    logo: { '@type': 'ImageObject', url: 'https://aanloopai.nl/logo-mark-light-1024.png' },
  },
  datePublished: '2026-05-03',
  dateModified: '2026-05-06',
  mainEntityOfPage: 'https://aanloopai.nl/vergelijk/aanloop-vs-voicelabs/',
  inLanguage: 'nl-NL',
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Wat is het belangrijkste verschil tussen Aanloop AI en Voicelabs?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Voicelabs Robin is een zelf-instelbaar SaaS-platform: u krijgt een omgeving waarmee u zelf flows, scripts en knowledge base bouwt, vanaf 299 euro per maand voor 1.000 belminuten inclusief WhatsApp en chat. Aanloop AI is een volledig managed bureau (Done-For-You): wij bouwen, trainen en onderhouden de AI-receptionist voor u — inclusief website als gewenst — vanaf 597 euro per maand. Het fundamentele verschil: u werkt bij Voicelabs als engineer op uw eigen bot; bij Aanloop AI werkt u als opdrachtgever met een dedicated implementatie-team.',
      },
    },
    {
      '@type': 'Question',
      name: 'Kan Voicelabs ook een website bouwen?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Nee — Voicelabs is een voice- en WhatsApp-AI platform; website-bouw is geen onderdeel van hun aanbod per mei 2026. Aanloop AI biedt de AI-Website Bundel: een professionele WordPress-website gecombineerd met de AI-receptionist Marco in één pakket. Dit is relevant voor MKB-bedrijven die tegelijk hun online aanwezigheid en telefonische afhandeling willen upgraden.',
      },
    },
    {
      '@type': 'Question',
      name: 'Waar staat de spraakdata bij elk platform opgeslagen?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Aanloop AI hanteert standaard EU-only datacenters (Frankfurt, Amsterdam) met AVG-conforme verwerkersovereenkomst en NEN 7510 op aanvraag voor zorg. Voor Voicelabs Robin is de exacte datalocatie niet expliciet publiek vermeld op de website per mei 2026 — vraag dit op tijdens uw evaluatie als AVG-conformiteit wettelijk vereist is in uw sector (zorg, juridisch, overheid, financieel).',
      },
    },
    {
      '@type': 'Question',
      name: 'Hoe transparant zijn de tarieven van beide aanbieders?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Aanloop AI publiceert vaste maandprijzen op de tarievenpagina: Marco Starter 597 euro per maand (150 gesprekken, setup 495 euro), Marco Groei 1.197 euro per maand (onbeperkt plus Emma WhatsApp plus CRM, setup 795 euro). Voicelabs Robin Zelf Starten staat op 299 euro per maand inclusief 1.000 belminuten; voor extra minuten of hogere volumes verwijst de website naar een offerte. Controleer de actuele Voicelabs-tarievenpagina voor uw specifieke situatie.',
      },
    },
    {
      '@type': 'Question',
      name: 'Welke aanbieder heeft meer case studies en klantbewijzen?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Voicelabs toont klantnamen op de homepage (per mei 2026 onder andere Fraai Tandartsen en Frankys). Aanloop AI is een jonger bureau en werkt met illustratieve scenario\'s per sector in plaats van named case studies. Geen van beide aanbieders heeft op dit moment een groot portfolio van gepubliceerde uitgebreide case studies met meetbare ROI-data. Vraag beide aanbieders om actuele referenties voor uw branche.',
      },
    },
    {
      '@type': 'Question',
      name: 'Wie doet de implementatie en het onderhoud?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Bij Voicelabs Robin Zelf Starten configureert u zelf flows, prompts en knowledge base via het platform — typische eigen investering van 10-30 uur voor eerste opzet plus doorlopend beheer. Bij Aanloop AI doet het implementatie-team de volledige opzet binnen 7-14 werkdagen, inclusief script-tuning, agenda-koppeling, CRM-integratie en maandelijkse optimalisatie op uw eigen conversatiedata. Dit verklaart het hogere maandtarief bij Aanloop AI.',
      },
    },
    {
      '@type': 'Question',
      name: 'Welke past bij MKB-bedrijven met sector-specifieke compliance (zorg, juridisch, Wft)?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Aanloop AI beschikt over 67 kennisbank-artikelen met sector-specifieke gidsen voor huisartsenpraktijken, fysiotherapie, advocatenkantoren, notariaten en Wft-plichtige financieel dienstverleners. EU-only datalocatie en NEN 7510 op aanvraag zijn expliciet publiek vermeld. Voicelabs heeft industrie-paginas op de website maar vermeldt geen specifieke NEN of Wft-compliance per mei 2026 — vraag dit op bij uw evaluatie.',
      },
    },
    {
      '@type': 'Question',
      name: 'Kan ik later overstappen van Voicelabs naar Aanloop AI?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Ja. Voicelabs Robin Zelf Starten is maandelijks opzegbaar (controleer actuele voorwaarden op voicelabs.nl). Aanloop AI ondersteunt migratie van andere voice-platformen als onderdeel van de eenmalige setup-fee. De migratie bestaat doorgaans uit het overhevelen van uw knowledge base, flows en telefoonlijn naar de Aanloop AI-infrastructuur, wat ons team binnen de standaard 7-14 werkdagen onboarding verwerkt.',
      },
    },
  ],
};

// Side-by-side comparison — alleen publiek geverifieerde feiten per mei 2026.
// Aanloop data: tarieven.astro + diensten/marco.astro + over.astro.
// Voicelabs data: voicelabs.nl homepage + pricing-pagina (per mei 2026).
const comparison = [
  { feature: 'Type service',                    aanloop: 'Managed bureau (Done-For-You)',                        voicelabs: 'Zelf-instelbaar SaaS-platform (Zelf Starten)' },
  { feature: 'Instapprijs',                     aanloop: '€597/mnd Starter (Marco, 150 gesprekken)',             voicelabs: '€299/mnd Robin Zelf Starten (1.000 belmin + WhatsApp + chat)' },
  { feature: 'All-in bundel',                   aanloop: '€1.197/mnd Groei (Marco + Emma + CRM, onbeperkt)',     voicelabs: 'Hogere volumes op offerte (website per mei 2026)' },
  { feature: 'Prijstransparantie',              aanloop: 'Publieke tarieven op website (alle tiers)',            voicelabs: '€299 zelf starten; hogere tiers op offerte' },
  { feature: 'Website + AI-bundel',             aanloop: 'AI-Website Bundel (WordPress + Marco in 1 pakket)',    voicelabs: 'Niet beschikbaar — puur voice/WhatsApp platform' },
  { feature: 'Setup-kosten',                    aanloop: 'Eenmalig €495 Starter / €795 Groei (incl. training)', voicelabs: 'Niet expliciet vermeld op homepage per mei 2026' },
  { feature: 'Implementatie',                   aanloop: 'Volledig door Aanloop-team (7-14 werkdagen)',          voicelabs: 'Zelf opzetten via platform (eigen tijdsinvestering)' },
  { feature: 'Maandelijkse optimalisatie',      aanloop: 'Inbegrepen — wij tunen op uw conversatiedata',        voicelabs: 'Zelf doen via platform' },
  { feature: 'Nederlandstalige voice',          aanloop: 'ElevenLabs NL (expliciet vermeld)',                    voicelabs: 'Dutch-native voices (vendor niet publiek)' },
  { feature: 'CRM-integratie',                  aanloop: 'HubSpot, Pipedrive (vanaf Groei inbegrepen)',          voicelabs: 'Niet expliciet op homepage (mei 2026)' },
  { feature: 'EU-only datalocatie',             aanloop: 'Frankfurt + Amsterdam, expliciet publiek vermeld',     voicelabs: 'Niet expliciet publiek vermeld — vraag op' },
  { feature: 'AVG-verwerkersovereenkomst',      aanloop: 'Standaard inbegrepen, NEN 7510 op aanvraag',           voicelabs: 'Vraag op bij evaluatie' },
  { feature: 'Sector-specifieke compliance',    aanloop: 'Wft, AVG-strict zorg/juridisch, EU AI Act (67 artikelen)', voicelabs: 'Industrie-pages; specifieke compliance niet publiek vermeld' },
  { feature: 'llms.txt (AI-vindbaarheid)',       aanloop: 'Aanwezig — aanloopai.nl/llms.txt',                    voicelabs: 'Niet aanwezig per mei 2026 (audit)' },
  { feature: 'FAQPage-schema (SEO/GEO)',        aanloop: 'Aanwezig op elke relevante pagina',                    voicelabs: 'Niet aanwezig per mei 2026 (audit)' },
  { feature: 'Auteur / founder transparantie', aanloop: 'Daan Verhoeven — publiek profiel + Person-schema',     voicelabs: 'Voicelabs als merk; geen prominent founder-profiel' },
  { feature: 'Case studies (publiek)',          aanloop: 'Sector-scenario\'s per branche (illustratief)',        voicelabs: 'Klantnamen op homepage (Fraai Tandartsen, Frankys)' },
  { feature: 'YouTube / video-content',         aanloop: 'Productie gestart (mei 2026)',                         voicelabs: 'Geen YouTube-kanaal aangetroffen (mei 2026)' },
  { feature: 'KvK / NL-aansprakelijkheid',      aanloop: 'KVK 88606902, Rotterdam',                             voicelabs: 'Voicelabs B.V., Nederland' },
  { feature: 'Maandelijks opzegbaar',           aanloop: 'Ja, 1 maand opzegtermijn',                            voicelabs: 'Controleer actuele voorwaarden op voicelabs.nl' },
  { feature: 'Doelgroep best fit',              aanloop: 'MKB zonder eigen AI-team, AVG-strict, wil website+AI', voicelabs: 'MKB met technische capaciteit, budget-bewust, DIY-voorkeur' },
];

const whenAanloop = [
  'U heeft geen eigen AI- of voice-engineer in huis en wilt volledig ontzorgd worden',
  'AVG-conformiteit is wettelijk vereist (zorg, juridisch, Wft-financieel, overheid)',
  'U wilt tegelijk een professionele website en AI-receptionist in één pakket',
  'U wilt binnen 7-14 werkdagen live, zonder zelf scripts of flows te bouwen',
  'CRM-integratie (HubSpot, Pipedrive) moet vanaf dag 1 werken',
  'Maandelijkse optimalisatie op uw eigen conversatiedata is gewenst',
  'Sector-specifieke kennis (11 sectoren, 67 kennisbank-artikelen) sluit aan op uw branche',
];

const whenVoicelabs = [
  'U heeft technische capaciteit en wilt zelf flows, prompts en scripts bouwen',
  'Het instapbudget is hard onder 400 euro per maand en u accepteert eigen implementatietijd',
  'U wilt experimenteren of een proof-of-concept draaien zonder lange onboarding',
  'Een website-bundel is niet relevant — u heeft al een website',
  'AVG-strict compliance is geen wettelijke vereiste in uw specifieke sector',
  'U wilt een transactioneel SaaS-product, geen begeleid partnerschap',
];
---

<BaseLayout
  title="Aanloop AI vs Voicelabs (mei 2026) — Eerlijke Vergelijking MKB"
  description="Vergelijking Aanloop AI (managed AI-bureau, website+AI bundel, vanaf €597/mnd) versus Voicelabs Robin (zelf-instelbaar voice-platform, €299/mnd) voor MKB Nederland. Prijs, datalocatie, AVG, sector-compliance vergeleken op publieke gegevens."
  schema={articleSchema}
  faqSchema={faqSchema.mainEntity.map(q => ({ question: q.name, answer: q.acceptedAnswer.text }))}
>
  <section class="border-b border-slate-200 hero-gradient">
    <div class="container-page py-16 lg:py-20">
      <div class="max-w-4xl">
        <div class="flex items-center gap-4 mb-6 reveal">
          <div class="accent-band"><span></span><span></span><span></span><span></span></div>
          <span class="eyebrow">Vergelijking &middot; mei 2026</span>
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tightest text-navy text-balance leading-[1.05] reveal reveal-delay-1">
          Aanloop AI <span class="text-slate-400">vs</span> Voicelabs
          <span class="block text-2xl sm:text-3xl lg:text-4xl font-semibold text-slate-500 mt-2">Welke past bij uw MKB?</span>
        </h1>
        <p class="mt-6 text-lg text-slate-600 leading-relaxed text-pretty max-w-3xl reveal reveal-delay-2">
          Beide aanbieders zijn Nederlands en richten zich op AI-telefonie voor het MKB, maar het zijn fundamenteel andere producten. Voicelabs Robin is een <strong>zelf-instelbaar platform</strong> vanaf &euro;299/mnd &mdash; u bouwt en beheert zelf. Aanloop AI is een <strong>volledig managed bureau</strong> vanaf &euro;597/mnd &mdash; wij bouwen, trainen en optimaliseren, inclusief website als gewenst. Hieronder een eerlijke vergelijking op publieke gegevens.
        </p>

        <div class="mt-8 p-4 bg-amber-50/50 border border-amber-200 rounded-xl text-sm text-slate-700 reveal reveal-delay-3">
          <p class="font-semibold text-amber-900 mb-1">Bron-disclaimer</p>
          <p>Voicelabs-data afkomstig van publieke voicelabs.nl-website en tarievenpagina per mei 2026. Aanloop AI-data afkomstig van eigen tarieven en productpagina's. Beide leveranciers updaten hun aanbod regelmatig &mdash; controleer de huidige stand op beide websites voor uw definitieve evaluatie.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page max-w-6xl mx-auto">
      <div class="mb-10 reveal">
        <p class="eyebrow mb-2">Side-by-side</p>
        <h2 class="text-2xl lg:text-3xl font-bold tracking-tighter-2 text-navy">21 punten naast elkaar.</h2>
      </div>

      <div class="overflow-x-auto reveal reveal-delay-1">
        <table class="w-full text-sm border-collapse bg-white rounded-2xl overflow-hidden shadow-sm border border-slate-200">
          <thead>
            <tr class="border-b border-slate-200">
              <th class="text-left py-4 px-5 text-slate-500 font-medium w-[28%]">Criterium</th>
              <th class="text-left py-4 px-4 font-bold text-navy bg-brand-emerald/5 w-[36%]">Aanloop AI<br/><span class="text-xs font-normal text-brand-emerald">Managed bureau</span></th>
              <th class="text-left py-4 px-4 font-bold text-navy w-[36%]">Voicelabs Robin<br/><span class="text-xs font-normal text-slate-500">Zelf-instelbaar platform</span></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {comparison.map(row => (
              <tr>
                <td class="py-3 px-5 text-slate-700 font-medium">{row.feature}</td>
                <td class="py-3 px-4 text-navy bg-brand-emerald/5 text-xs">{row.aanloop}</td>
                <td class="py-3 px-4 text-slate-600 text-xs">{row.voicelabs}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Unique Aanloop differentiators callout -->
  <section class="section bg-brand-emerald/5 border-y border-brand-emerald/20">
    <div class="container-page max-w-5xl mx-auto">
      <div class="mb-8 reveal">
        <p class="eyebrow mb-2">Unieke differentiators</p>
        <h2 class="text-2xl lg:text-3xl font-bold tracking-tighter-2 text-navy">Wat Aanloop AI biedt dat Voicelabs niet heeft.</h2>
        <p class="mt-3 text-slate-600 max-w-2xl text-sm">Op basis van publieke audit mei 2026 &mdash; voor context, niet als aanval.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {[
          {
            title: 'AI-Website Bundel',
            desc: 'Professionele WordPress-website gecombineerd met AI-receptionist Marco in één onboarding. Voicelabs bouwt geen websites.',
            href: '/diensten/ai-website-bundel-mkb-nederland/',
          },
          {
            title: 'EU-only datalocatie (expliciet)',
            desc: 'Frankfurt + Amsterdam als standaard, publiek vermeld. Voicelabs vermeldt geen specifieke datacenters op de website per mei 2026.',
            href: '/over/',
          },
          {
            title: 'Sector-compliance (Wft, NEN 7510)',
            desc: '67 kennisbank-artikelen voor zorg, juridisch, financieel. NEN 7510 op aanvraag. Voicelabs vermeldt dit niet expliciet.',
            href: '/kennisbank/',
          },
          {
            title: 'llms.txt aanwezig',
            desc: 'Aanloopai.nl/llms.txt zorgt dat AI-zoekmachines de content correct indexeren. Voicelabs heeft dit per mei 2026 niet.',
            href: '/llms.txt',
          },
          {
            title: 'FAQPage-schema op elke pagina',
            desc: 'Gestructureerde data voor Google en AI-assistenten. Voicelabs heeft geen FAQPage-schema aangetroffen in de audit.',
            href: '/vergelijk/aanloop-vs-voicelabs/',
          },
          {
            title: 'Named author / founder',
            desc: 'Daan Verhoeven als publiek aanspreekpunt met Person-schema. Verhoogt vertrouwen bij sectoren met compliance-eisen.',
            href: '/team/daan-verhoeven/',
          },
        ].map(item => (
          <a href={item.href} class="card hover:border-brand-emerald/40 hover:shadow-md transition-all group reveal">
            <h3 class="font-bold text-navy text-sm mb-2 group-hover:underline">{item.title}</h3>
            <p class="text-xs text-slate-600 leading-relaxed">{item.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-slate-50/60 border-y border-slate-200">
    <div class="container-page max-w-5xl mx-auto">
      <div class="mb-10 reveal">
        <p class="eyebrow mb-2">Welke past bij u?</p>
        <h2 class="text-2xl lg:text-3xl font-bold tracking-tighter-2 text-navy">Doelgroep-fit per aanbieder.</h2>
        <p class="mt-3 text-slate-600 max-w-2xl">Geen "wij zijn beter" framing &mdash; beide producten hebben hun eigen ideale klant. Hieronder per aanbieder de profielen waar ze het sterkst voor zijn.</p>
      </div>

      <div class="grid lg:grid-cols-2 gap-8">
        <div class="bg-white border-2 border-brand-emerald/30 rounded-2xl p-6 reveal">
          <p class="text-xs font-semibold uppercase tracking-widest text-brand-emerald mb-2">Kies Aanloop AI als</p>
          <ul class="space-y-3 mt-4">
            {whenAanloop.map(p => (
              <li class="flex items-start gap-3 text-sm text-slate-700">
                <svg class="w-4 h-4 mt-0.5 flex-shrink-0 text-brand-emerald" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                {p}
              </li>
            ))}
          </ul>
          <a href="/diensten/marco/" class="inline-flex items-center gap-2 mt-6 text-sm font-semibold text-brand-emerald hover:underline">
            Lees meer over Marco
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
        </div>

        <div class="bg-white border border-slate-200 rounded-2xl p-6 reveal reveal-delay-1">
          <p class="text-xs font-semibold uppercase tracking-widest text-slate-500 mb-2">Kies Voicelabs Robin als</p>
          <ul class="space-y-3 mt-4">
            {whenVoicelabs.map(p => (
              <li class="flex items-start gap-3 text-sm text-slate-700">
                <svg class="w-4 h-4 mt-0.5 flex-shrink-0 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                {p}
              </li>
            ))}
          </ul>
          <p class="mt-6 text-xs text-slate-400 italic">Voicelabs is een onafhankelijke aanbieder &mdash; wij verwijzen u door naar voicelabs.nl voor hun actuele aanbod.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page max-w-3xl mx-auto">
      <div class="mb-10 reveal">
        <p class="eyebrow mb-3">Veelgestelde vragen</p>
        <h2 class="text-2xl lg:text-3xl font-bold tracking-tighter-2 text-navy">Aanloop AI vs Voicelabs &mdash; antwoorden op de meest gestelde vragen.</h2>
      </div>
      <div class="space-y-3">
        {faqSchema.mainEntity.map(item => (
          <details class="card group reveal">
            <summary class="flex items-center justify-between cursor-pointer list-none">
              <span class="text-base font-bold text-navy pr-6">{item.name}</span>
              <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <p class="mt-4 text-sm text-slate-600 leading-relaxed">{item.acceptedAnswer.text}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight bg-midnight text-pearl">
    <div class="container-page">
      <div class="max-w-3xl">
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tightest text-pearl text-balance">
          Wilt u zien of managed AI past bij uw situatie?
        </h2>
        <p class="mt-4 text-slate-300 leading-relaxed">
          We laten u in 30 minuten zien wat Aanloop AI doet in uw branchecontext &mdash; geen creditcard, geen verplichting. U beslist daarna rustig of self-service of managed beter past.
        </p>
        <div class="mt-6 flex flex-col sm:flex-row gap-3">
          <a href="/gratis-ai-scan/" class="btn bg-pearl text-navy hover:bg-white text-base px-6 py-3.5">
            Gratis AI-scan aanvragen
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
          <a href="/tarieven/" class="btn border border-slate-700 text-pearl hover:bg-slate-800 text-base px-6 py-3.5">
            Bekijk tarieven
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
