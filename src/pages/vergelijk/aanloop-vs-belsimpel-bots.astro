---
import BaseLayout from '../../layouts/BaseLayout.astro';

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Aanloop AI vs Belsimpel/Toing-bots: welke AI-oplossing past bij MKB Nederland?',
  description: 'Vergelijking Aanloop AI (Marco, Emma, AI-document) versus Belsimpel-bots / Toing voor MKB Nederland: scope, eigenaarschap, EU-data, prijs en doorlooptijd vergeleken.',
  author: {
    '@type': 'Person',
    name: 'Daan Verhoeven',
    '@id': 'https://aanloopai.nl/team/daan-verhoeven/#person',
    url: 'https://aanloopai.nl/team/daan-verhoeven/',
  },
  publisher: {
    '@type': 'Organization',
    '@id': 'https://aanloopai.nl/#organization',
    name: 'Aanloop AI',
    logo: { '@type': 'ImageObject', url: 'https://aanloopai.nl/logo-mark-light-1024.png' },
  },
  datePublished: '2026-05-02',
  dateModified: '2026-05-02',
  mainEntityOfPage: 'https://aanloopai.nl/vergelijk/aanloop-vs-belsimpel-bots/',
  inLanguage: 'nl-NL',
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Wat is het verschil in scope tussen Aanloop AI en Belsimpel/Toing?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Belsimpel is van origine een telecom-aanbieder en biedt bots primair als bel- en chat-aanvulling op telefonie-abonnementen. Aanloop AI is een gespecialiseerd AI-bureau met drie productlijnen: Marco (voice), Emma (WhatsApp) en AI-document automation, los van een telecom-pakket.',
      },
    },
    {
      '@type': 'Question',
      name: 'Wie is eigenaar van het AI-model en de gespreksdata?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Bij Aanloop AI blijft de klant eigenaar van transcripts en metadata; data staat in EU-regio (Frankfurt/Amsterdam) met DPA. Telecom-bots zijn vaak onderdeel van een groter call-platform; controleer de DPA en datalokatie expliciet in jouw offerte.',
      },
    },
    {
      '@type': 'Question',
      name: 'Wat zijn de prijsstructuren?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Aanloop AI: Emma vanaf 197 euro per maand, Marco vanaf 397 euro per maand all-in. Telecom-bots zijn meestal een add-on bovenop een zakelijk telefonie-abonnement met variabele per-minuut kosten. Vergelijk altijd de all-in prijs over 12 maanden inclusief implementatie en onderhoud.',
      },
    },
    {
      '@type': 'Question',
      name: 'Hoe zit het met support en doorontwikkeling?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Bij Aanloop AI is prompt-tuning, kwartaalreview en flow-update onderdeel van het maandtarief. Telecom-bot support hangt af van het pakket; vraag of prompt-aanpassingen meekomen of als changerequest worden gefactureerd.',
      },
    },
    {
      '@type': 'Question',
      name: 'Kan ik beide combineren?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Ja. Veel klanten houden hun telecom-pakket bij hun huidige aanbieder en koppelen Marco of Emma daaraan via SIP-trunks of WhatsApp Business API. Aanloop AI levert de AI-laag, niet de telefonielijn zelf.',
      },
    },
  ],
};

const comparison = [
  { feature: 'Type bedrijf', aanloop: 'AI-bureau (operator-as-a-service)', belsimpel: 'Telecom-aanbieder met bot add-on' },
  { feature: 'Productpalet AI', aanloop: 'Marco (voice), Emma (WhatsApp), AI-document', belsimpel: 'Bel/chat-bot binnen telefonie-pakket' },
  { feature: 'Onafhankelijk van telecom-aanbieder', aanloop: 'Ja — werkt met elke SIP/Provider', belsimpel: 'Doorgaans gekoppeld aan eigen pakket' },
  { feature: 'Datalokatie', aanloop: 'EU-only (Frankfurt/Amsterdam)', belsimpel: 'Afhankelijk van pakket — controleren in DPA' },
  { feature: 'AVG-DPA', aanloop: 'NL-DPA, signing in 1 dag', belsimpel: 'Onderdeel van bredere telecom-DPA' },
  { feature: 'NEN 7510 zorg-add-on', aanloop: 'Beschikbaar', belsimpel: 'Doorgaans niet als losse module' },
  { feature: 'Doorlooptijd live-gang', aanloop: '5-7 werkdagen', belsimpel: 'Variabel; afhankelijk van pakket-onboarding' },
  { feature: 'Startprijs per maand', aanloop: 'Vanaf 197 euro (Emma) / 397 euro (Marco)', belsimpel: 'Bot-add-on bovenop telecom-pakket' },
  { feature: 'Eigenaarschap transcripts', aanloop: 'Klant', belsimpel: 'Variabel — controleer voorwaarden' },
  { feature: 'Native NL-spraak', aanloop: 'Ja', belsimpel: 'Ja' },
  { feature: 'CRM-integraties', aanloop: 'HubSpot, Salesforce, Pipedrive, AFAS native', belsimpel: 'Variabel per pakket' },
  { feature: 'Support taal', aanloop: 'Nederlands, telefoon + e-mail', belsimpel: 'Nederlands, via klantenservice telecom' },
  { feature: 'Best voor', aanloop: 'MKB dat AI los van telecom wil opbouwen', belsimpel: 'Bedrijven die telecom + bot bij 1 aanbieder willen' },
  { feature: 'Onderhoud / prompt-updates', aanloop: 'Inbegrepen', belsimpel: 'Mogelijk changerequest — controleer offerte' },
];

const useCases = [
  { sector: 'Onderneming met bestaande telecom-contract', kies: 'Aanloop AI', reden: 'Behoud uw telefoniecontract, voeg AI toe via SIP-trunk. Geen vendor-lock-in.' },
  { sector: 'Startup zonder vast telefonie-pakket', kies: 'Belsimpel', reden: 'Bundel telefoon + bot bij 1 aanbieder voor administratief gemak.' },
  { sector: 'Huisartsenpraktijk', kies: 'Aanloop AI', reden: 'NEN 7510 zorg-add-on en NL-DPA expliciet — telecom-bots dekken zorgcompliance niet uit de doos.' },
  { sector: 'Webshop met support-team', kies: 'Aanloop AI (Emma)', reden: 'WhatsApp Business AI met Shopify/WooCommerce-koppeling — telecom-bots zijn voice-georiënteerd.' },
  { sector: 'Klein installatiebedrijf', kies: 'Belsimpel', reden: 'Eenvoud: 1 factuur voor telefonie + bot, beperkt volume.' },
  { sector: 'Notariskantoor', kies: 'Aanloop AI', reden: 'Eigenaarschap transcripts en EU-only data zwaarder dan administratief gemak.' },
  { sector: 'Thuiszorg-organisatie', kies: 'Aanloop AI', reden: 'NEN 7510 + AVG-DPA met named processor; telecom-bot mist deze depth.' },
  { sector: 'Tandartsketen', kies: 'Aanloop AI', reden: 'Agenda-koppeling Google/Outlook/Calendly out-of-the-box, sentiment-detectie + escalatie.' },
];
---

<BaseLayout
  title="Aanloop AI vs Belsimpel/Toing-bots — AI-bureau of telecom-pakket?"
  description="Aanloop AI versus telecom-bots (Belsimpel/Toing) vergeleken op scope, datalokatie, prijs, NEN 7510, integraties en eigenaarschap voor MKB Nederland."
  schema={[articleSchema, faqSchema]}
>
  <section class="border-b border-slate-200 hero-gradient">
    <div class="container-page py-16 lg:py-24">
      <div class="max-w-3xl">
        <div class="flex items-center gap-3 mb-6">
          <div class="accent-band"><span></span><span></span><span></span><span></span></div>
          <span class="eyebrow">Vergelijken &middot; Aanloop AI vs Belsimpel-bots</span>
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tightest text-navy text-balance leading-[1.05]">
          Aanloop AI of Belsimpel/Toing-bots: wat past bij uw MKB?
        </h1>
        <p class="mt-6 text-lg lg:text-xl text-slate-600 leading-relaxed text-pretty">
          Belsimpel/Toing biedt bots als add-on op zakelijke telefonie. Aanloop AI is een gespecialiseerd AI-bureau dat de AI-laag los levert van uw telefonie-aanbieder. Hier de 14-punts feature-vergelijking en sector-aanbevelingen. Belsimpel en Toing zijn handelsmerken van Belsimpel/Toing en worden hier ter referentie genoemd.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/aanvragen/" class="btn-primary">Gratis adviesgesprek</a>
          <a href="/diensten/" class="btn-secondary">Alle diensten</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page max-w-5xl">
      <h2 class="text-2xl lg:text-3xl font-bold tracking-tightest text-navy mb-6">Feature-tabel</h2>
      <div class="overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm">
        <table class="w-full text-sm">
          <thead class="bg-slate-50">
            <tr>
              <th class="text-left p-4 font-semibold text-navy">Feature</th>
              <th class="text-left p-4 font-semibold text-navy">Aanloop AI</th>
              <th class="text-left p-4 font-semibold text-navy">Belsimpel/Toing-bots</th>
            </tr>
          </thead>
          <tbody>
            {comparison.map((row, i) => (
              <tr class={i % 2 === 0 ? 'bg-white' : 'bg-slate-50/40'}>
                <td class="p-4 font-medium text-navy">{row.feature}</td>
                <td class="p-4 text-slate-700">{row.aanloop}</td>
                <td class="p-4 text-slate-700">{row.belsimpel}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section bg-slate-50/60 border-y border-slate-200">
    <div class="container-page max-w-3xl">
      <h2 class="text-2xl lg:text-3xl font-bold tracking-tightest text-navy mb-8">Welke kiezen per sector?</h2>
      <div class="space-y-4">
        {useCases.map((uc) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-5">
            <div class="flex items-start gap-4">
              <span class="rounded-full bg-navy text-white text-xs px-3 py-1 font-semibold whitespace-nowrap">{uc.kies}</span>
              <div>
                <h3 class="font-bold text-navy">{uc.sector}</h3>
                <p class="text-sm text-slate-600 mt-1 leading-relaxed">{uc.reden}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page max-w-3xl">
      <h2 class="text-2xl lg:text-3xl font-bold tracking-tightest text-navy mb-6">Wanneer een telecom-bot logischer is</h2>
      <p class="text-slate-700 leading-relaxed mb-4">Bedrijven die hun telefonie en bot bij een enkele leverancier willen consolideren, met beperkt callvolume en zonder strenge sectorcompliance, kunnen prima starten met een telecom-bot. Eenvoud van facturatie en 1 supportkanaal weegt dan zwaarder dan flexibiliteit.</p>
      <p class="text-slate-700 leading-relaxed mb-4">Voor zorg, juridisch, vastgoed en andere AVG-zware sectoren, of bij groei boven 500 gesprekken per maand, levert een gespecialiseerde AI-laag (Aanloop AI) doorgaans betere prompt-kwaliteit, scherpere escalatieregels en transparante datalokatie.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/diensten/marco/" class="btn-secondary">Marco (voice)</a>
        <a href="/diensten/emma/" class="btn-secondary">Emma (WhatsApp)</a>
        <a href="/aanvragen/" class="btn-primary">Adviesgesprek aanvragen</a>
      </div>
    </div>
  </section>

  <section class="section bg-slate-50/60 border-y border-slate-200">
    <div class="container-page max-w-3xl">
      <h2 class="text-2xl lg:text-3xl font-bold tracking-tightest text-navy mb-6">Veelgestelde vragen</h2>
      <div class="space-y-4">
        {faqSchema.mainEntity.map((q) => (
          <details class="rounded-2xl border border-slate-200 bg-white p-5">
            <summary class="font-semibold text-navy cursor-pointer">{q.name}</summary>
            <p class="text-sm text-slate-600 mt-3 leading-relaxed">{q.acceptedAnswer.text}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page max-w-3xl">
      <h2 class="text-2xl lg:text-3xl font-bold tracking-tightest text-navy mb-6">Verder vergelijken</h2>
      <ul class="space-y-3 text-slate-700">
        <li><a href="/vergelijk/aanloop-vs-watermelon/" class="text-navy hover:underline">Aanloop AI vs Watermelon</a></li>
        <li><a href="/vergelijk/aanloop-vs-chatlayer/" class="text-navy hover:underline">Aanloop AI vs Chatlayer</a></li>
        <li><a href="/vergelijk/marco-vs-voiceflow/" class="text-navy hover:underline">Marco vs Voiceflow</a></li>
        <li><a href="/vergelijk/" class="text-navy hover:underline">Aanloop AI versus andere leveranciers</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>
