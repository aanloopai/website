---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { EMMA_LITE_MND, EMMA_MND, EMMA_TELEFOON_NAAM, EMMA_WHATSAPP_NAAM, EMMA_TELEFOON_URL, EMMA_WHATSAPP_URL } from '../../data/pricing';

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Aanloop AI vs Chatlayer (Sinch): welke conversational-AI past bij uw MKB?',
  description: 'Vergelijking Aanloop AI versus Chatlayer van Sinch: feature-tabel, prijzen, integraties, sector-aanbevelingen. Voor Nederlands MKB dat AI-klantcontact wil opzetten in 2026.',
  author: {
    '@type': 'Person',
    name: 'Mustafa Agah Dogan',
    '@id': 'https://aanloopai.nl/team/magahdogan/#person',
    url: 'https://aanloopai.nl/team/magahdogan/',
  },
  publisher: {
    '@type': 'Organization',
    '@id': 'https://aanloopai.nl/#organization',
    name: 'Aanloop AI',
    logo: { '@type': 'ImageObject', url: 'https://aanloopai.nl/logo-mark-light-1024.png' },
  },
  datePublished: '2026-05-02',
  dateModified: '2026-05-02',
  mainEntityOfPage: 'https://aanloopai.nl/vergelijk/aanloop-vs-chatlayer/',
  inLanguage: 'nl-NL',
};

const comparison = [
  { feature: 'Type', a: 'Full-service AI-bureau MKB-Nederland', b: 'Enterprise conversational-AI-platform (onderdeel Sinch)' },
  { feature: 'Doelgroep', a: 'MKB 5-250 medewerkers', b: 'Enterprise 500+ medewerkers, multinationals' },
  { feature: 'Onboarding-model', a: 'Done-for-you door Aanloop-specialist', b: 'Self-service met optionele professional services' },
  { feature: 'Telefoon-AI (voice)', a: 'Ja - Emma', b: 'Beperkt; Sinch-voice apart product' },
  { feature: 'WhatsApp Business', a: `Ja - ${EMMA_WHATSAPP_NAAM}, vanaf ${EMMA_LITE_MND}`, b: 'Ja - via Sinch-channels' },
  { feature: 'Web-chat', a: 'Ja, snel deploybaar widget', b: 'Ja, geavanceerde flow-builder' },
  { feature: 'Startprijs', a: `${EMMA_LITE_MND} (${EMMA_WHATSAPP_NAAM}) · ${EMMA_MND} (${EMMA_TELEFOON_NAAM}, incl. WhatsApp)`, b: 'Vanaf circa 1.500 euro/maand (enterprise tier)' },
  { feature: 'Doorlooptijd', a: '7-14 werkdagen', b: '6-12 weken (enterprise project)' },
  { feature: 'Nederlands NLU', a: 'Native NL, sector-tuned', b: 'NL-ondersteund, vereist eigen training' },
  { feature: 'Integraties', a: 'HubSpot, Salesforce, Pipedrive, AFAS, Exact, Twinfield', b: 'API-first, werkt met alles maar vereist build' },
  { feature: 'EU-data', a: 'EU-only standaard (Hetzner/AWS Frankfurt)', b: 'EU-region beschikbaar' },
  { feature: 'Beste voor', a: 'MKB met snelheid + budget < 1.500/mnd', b: 'Enterprise met eigen IT-team en complex architectuur' },
  { feature: 'Contractduur', a: 'Maandelijks opzegbaar', b: 'Jaarcontracten standaard' },
];

const useCases = [
  { sector: 'MKB e-commerce (10-50 mensen)', kies: 'Aanloop AI', reden: 'Chatlayer is overkill qua functionaliteit en budget. Emma dekken 90 procent van de behoefte voor een fractie van de prijs.' },
  { sector: 'Multinational (1000+ FTE)', kies: 'Chatlayer', reden: 'Enterprise IT-stack, multi-land, eigen developers - Chatlayer is gebouwd voor deze schaal en complexiteit.' },
  { sector: 'Huisartsenpraktijk', kies: 'Aanloop AI', reden: 'NEN 7510-zorg-add-on standaard. Chatlayer vereist maatwerk-architectuur voor zorgcompliance.' },
  { sector: 'B2B SaaS startup', kies: 'Beide opties', reden: 'Met eigen developers kunt u Chatlayer als bouwblok gebruiken. Voor snelle GTM is Aanloop sneller.' },
  { sector: 'Retailketen 50+ vestigingen', kies: 'Chatlayer', reden: 'Multi-store routing, complex agent-handover, 24/7 callcenter-integratie - enterprise-grade.' },
  { sector: 'Restaurant met 1-3 vestigingen', kies: 'Aanloop AI', reden: 'Eenvoudige reservering + WhatsApp. Chatlayer is overengineering.' },
  { sector: 'Notariskantoor', kies: 'Aanloop AI', reden: 'Vertrouwelijke intake via Emma-telefoon, AVG-conform out-of-the-box.' },
  { sector: 'Telecom of bank', kies: 'Chatlayer', reden: 'Compliance-frameworks, audit-trails, multi-channel governance - enterprise vereist.' },
];

const faqs = [
  {
    q: 'Voor wie is Chatlayer eigenlijk gebouwd?',
    a: 'Chatlayer (onderdeel van Sinch) richt zich primair op enterprise-klanten - banken, telecoms, multinationals. De prijspunten en implementatie-tijd weerspiegelen dit.',
  },
  {
    q: 'Kan Aanloop AI ook enterprise-niveau leveren?',
    a: 'Ja, voor MKB-Nederland tot circa 250 medewerkers. Voor multinational-stack met eigen IT-architectuur is een platform als Chatlayer beter passend.',
  },
  {
    q: 'Wat is het prijsverschil concreet?',
    a: `${EMMA_WHATSAPP_NAAM} start vanaf ${EMMA_LITE_MND}; ${EMMA_TELEFOON_NAAM} (incl. WhatsApp) vanaf ${EMMA_MND}. Chatlayer enterprise contracten beginnen rond 1.500 euro/maand exclusief implementatie-budget van 20-50K eenmalig.`,
  },
  {
    q: 'Welke is sneller live?',
    a: 'Aanloop levert in 7-14 werkdagen. Chatlayer enterprise-implementaties duren typisch 6-12 weken vanwege scope en governance.',
  },
  {
    q: 'Welke heeft betere Nederlandstalige ondersteuning?',
    a: 'Aanloop is volledig NL-team, native ondersteuning. Sinch/Chatlayer is internationaal met Nederlandstalige support op enterprise-tier.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const combinedSchema = [articleSchema, faqSchema];
---

<BaseLayout
  title="Aanloop vs Chatlayer — welke conversational-AI?"
  description="Vergelijking Aanloop AI versus Chatlayer van Sinch: feature-tabel, prijzen, integraties, sector-aanbevelingen. Voor Nederlands MKB in 2026."
  schema={combinedSchema}
>
  <section class="border-b border-slate-200 hero-gradient">
    <div class="container-page py-16 lg:py-24">
      <div class="max-w-3xl">
        <div class="flex items-center gap-3 mb-6">
          <div class="accent-band"><span></span><span></span><span></span><span></span></div>
          <span class="eyebrow">Vergelijken - Aanloop AI vs Chatlayer</span>
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tightest text-navy text-balance leading-[1.05]">
          Aanloop AI of Chatlayer (Sinch): welke past bij uw schaal?
        </h1>
        <p class="mt-6 text-lg lg:text-xl text-slate-600 leading-relaxed text-pretty">
          Chatlayer is een enterprise conversational-AI-platform van Sinch, ontworpen voor multinationals. Aanloop AI is een Nederlands MKB-bureau met directe sector-implementaties. Twee verschillende werelden - hier de eerlijke vergelijking.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/aanvragen/" class="btn-primary">Gratis adviesgesprek</a>
          <a href="/tarieven/" class="btn-secondary">Bekijk prijzen</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page max-w-5xl">
      <h2 class="text-2xl lg:text-3xl font-bold tracking-tightest text-navy mb-6">Feature-tabel</h2>
      <div class="overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm">
        <table class="w-full text-sm">
          <thead class="bg-slate-50">
            <tr>
              <th class="text-left p-4 font-semibold text-navy">Feature</th>
              <th class="text-left p-4 font-semibold text-navy">Aanloop AI</th>
              <th class="text-left p-4 font-semibold text-navy">Chatlayer (Sinch)</th>
            </tr>
          </thead>
          <tbody>
            {comparison.map((row, i) => (
              <tr class={i % 2 === 0 ? 'bg-white' : 'bg-slate-50/40'}>
                <td class="p-4 font-medium text-navy">{row.feature}</td>
                <td class="p-4 text-slate-700">{row.a}</td>
                <td class="p-4 text-slate-700">{row.b}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-4 text-sm text-slate-500">Prijzen en features op basis van publieke informatie per 2026-05-02. Chatlayer is een product van Sinch AB.</p>
    </div>
  </section>

  <section class="section bg-slate-50/60 border-y border-slate-200">
    <div class="container-page max-w-3xl">
      <h2 class="text-2xl lg:text-3xl font-bold tracking-tightest text-navy mb-8">Welke kiezen per use-case?</h2>
      <div class="space-y-4">
        {useCases.map((uc) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-5">
            <div class="flex items-start gap-4">
              <span class="rounded-full bg-navy text-white text-xs px-3 py-1 font-semibold whitespace-nowrap">{uc.kies}</span>
              <div>
                <h3 class="font-bold text-navy">{uc.sector}</h3>
                <p class="text-sm text-slate-600 mt-1 leading-relaxed">{uc.reden}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page max-w-3xl">
      <h2 class="text-2xl lg:text-3xl font-bold tracking-tightest text-navy mb-6">Wanneer Aanloop AI, wanneer Chatlayer?</h2>
      <p class="text-slate-700 leading-relaxed mb-4">Chatlayer is gebouwd voor enterprise-schaal: multi-land, multi-channel, complexe governance, integraties met SAP/Oracle/Salesforce-stacks. Een MKB-bedrijf gebruikt typisch 10-15 procent van de functionaliteit en betaalt 5-10x meer.</p>
      <p class="text-slate-700 leading-relaxed mb-4">Aanloop AI is gebouwd voor Nederlands MKB: snelle implementatie, sector-specifieke templates, voorspelbare maandprijs. Voor 95 procent van de MKB-bedrijven is dit de juiste keuze.</p>
      <p class="text-slate-700 leading-relaxed mb-4">Vuistregel: heeft u een eigen IT-afdeling van 5+ FTE en budget van 20K+ voor implementatie? Overweeg Chatlayer. Anders: Aanloop AI.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={EMMA_TELEFOON_URL} class="btn-secondary">Emma - telefoon-AI</a>
        <a href={EMMA_WHATSAPP_URL} class="btn-secondary">Emma - WhatsApp-AI</a>
        <a href="/aanvragen/" class="btn-primary">Adviesgesprek aanvragen</a>
      </div>
    </div>
  </section>

  <section class="section bg-slate-50/60 border-y border-slate-200">
    <div class="container-page max-w-3xl">
      <h2 class="text-2xl lg:text-3xl font-bold tracking-tightest text-navy mb-8">Veelgestelde vragen</h2>
      <div class="space-y-5">
        {faqs.map((f) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-5">
            <h3 class="font-semibold text-navy mb-2">{f.q}</h3>
            <p class="text-sm text-slate-600 leading-relaxed">{f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page max-w-3xl">
      <h2 class="text-2xl lg:text-3xl font-bold tracking-tightest text-navy mb-6">Verder vergelijken</h2>
      <ul class="space-y-3 text-slate-700">
        <li><a href="/vergelijk/aanloop-vs-watermelon/" class="text-navy hover:underline">Aanloop AI versus Watermelon</a></li>
        <li><a href="/diensten/emma/" class="text-navy hover:underline">Emma — AI-receptie & WhatsApp Agent (productpagina)</a></li>
        <li><a href="/vergelijk/ai-receptionist-vs-callcenter/" class="text-navy hover:underline">AI-receptionist versus extern callcenter</a></li>
        <li><a href="/vergelijk/" class="text-navy hover:underline">Alle vergelijkingen</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>
