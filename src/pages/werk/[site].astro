---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FaqSection from '../../components/FaqSection.astro';
import { RESULTATEN, RESULTATEN_PEILDATUM, type SiteResultaat } from '../../data/resultaten';
import { WEBSITE_BUNDEL } from '../../data/pricing';

export function getStaticPaths() {
  return RESULTATEN.map((s) => ({ params: { site: s.key }, props: { s } }));
}

const { s } = Astro.props as { s: SiteResultaat };
const euro = (n: number) => `€${n.toLocaleString('nl-NL')}`;
const datum = (iso: string) => new Date(`${iso}T12:00:00Z`).toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' });
const url = `https://aanloopai.nl/werk/${s.key}/`;
const eigen = s.eigenaar === 'eigen';
const anderen = RESULTATEN.filter((x) => x.key !== s.key).slice(0, 3);

const faqItems = [
  { question: `Is ${s.naam} een klant van Aanloop AI?`, answer: eigen ? `Nee, ${s.naam} is ${s.eigenaarLabel.toLowerCase()}. We zeggen dat erbij: het is geen betaalde klantcase, maar precies daarom kunnen we de meting en de techniek tot in detail laten zien.` : `Ja. ${s.naam} is ${s.eigenaarLabel.toLowerCase()} en staat hier met akkoord van de eigenaar. De cijfers komen uit dezelfde meting als bij onze eigen sites.` },
  { question: `Wat is er precies met AI gebouwd op ${s.host}?`, answer: s.ai.join(' · ') },
  { question: 'Kan ik dezelfde opzet krijgen?', answer: `Ja: de AI-Website Bundel bevat dezelfde bouwwijze, Emma als AI-receptionist, AI-vindbaarheid en het meetpaneel. ${euro(WEBSITE_BUNDEL.setup)} eenmalig en ${euro(WEBSITE_BUNDEL.maand)} per maand, exclusief btw.` },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    '@id': `${url}#case`,
    headline: `${s.naam}: website met AI, gebouwd door Aanloop AI`,
    description: s.samenvatting,
    author: { '@id': 'https://aanloopai.nl/#organization' },
    publisher: { '@id': 'https://aanloopai.nl/#organization' },
    dateModified: RESULTATEN_PEILDATUM,
    inLanguage: 'nl-NL',
    articleSection: 'Werk',
    about: { '@type': 'WebSite', name: s.naam, url: s.url },
    mainEntityOfPage: url,
    ...(s.screenshot ? { image: `https://aanloopai.nl${s.screenshot}` } : {}),
  },
];
---

<BaseLayout
  title={`${s.naam}: website met AI die klanten oplevert`}
  description={s.metaDescription}
  schema={schema}
  faqSchema={faqItems}
  image={s.screenshot ? `https://aanloopai.nl${s.screenshot}` : undefined}
>
  <section class="border-b border-slate-200 hero-gradient">
    <div class="container-page py-16 lg:py-20">
      <div class="grid lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-7 max-w-3xl">
          <div class="flex items-center gap-4 mb-6"><div class="accent-band"><span></span><span></span><span></span><span></span></div><span class="eyebrow">Werk · {eigen ? 'eigen bedrijf' : 'klant'}</span></div>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-semibold tracking-tighter text-navy text-balance leading-[1.05]">{s.naam}</h1>
          <p class="mt-3 text-sm font-medium text-slate-500">{s.sector} · {s.eigenaarLabel} · {/^\d{4}-\d{2}-\d{2}$/.test(s.live) ? `live ${datum(s.live)}` : s.live.length === 4 ? `live ${s.live}` : s.live}</p>
          <p class="mt-6 text-lg lg:text-xl text-slate-600 leading-relaxed text-pretty" data-speakable>{s.samenvatting}</p>
          <div class="mt-8 flex flex-col sm:flex-row gap-3">
            <a href={s.url} target="_blank" rel="noopener" class="btn-primary text-base px-6 py-3.5">Bezoek {s.host} ↗</a>
            <a href="/resultaten/" class="btn-outline text-base px-6 py-3.5">Alle live cijfers</a>
          </div>
        </div>
        {s.screenshot && (
          <div class="lg:col-span-5">
            <img src={s.screenshot} alt={`Schermafbeelding van ${s.host}`} width="1440" height="900" loading="eager" decoding="async" class="w-full rounded-xl border border-slate-200 shadow-xl" />
          </div>
        )}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page grid lg:grid-cols-2 gap-10">
      <div>
        <h2 class="text-2xl font-bold text-navy mb-4">Wat we bouwden</h2>
        <ul class="space-y-3">
          {s.gebouwd.map((g) => (
            <li class="flex items-start gap-2 text-slate-700 leading-relaxed"><svg class="w-4 h-4 mt-1.5 flex-shrink-0 text-brand-emerald" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg><span>{g}</span></li>
          ))}
        </ul>
      </div>
      <div>
        <h2 class="text-2xl font-bold text-navy mb-4">Waar de AI zit</h2>
        <ul class="space-y-3">
          {s.ai.map((a) => (
            <li class="flex items-start gap-2 text-slate-700 leading-relaxed"><svg class="w-4 h-4 mt-1.5 flex-shrink-0 text-brand-indigo" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg><span>{a}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section bg-slate-50 border-y border-slate-200">
    <div class="container-page">
      <div class="max-w-3xl mb-8">
        <p class="eyebrow mb-3">Gemeten</p>
        <h2 class="text-3xl font-semibold tracking-tighter text-navy">{s.cijfers.length ? `Momentopname van ${datum(RESULTATEN_PEILDATUM)}.` : s.geenMeting ? 'Geen meetcijfers voor deze site.' : 'De meting loopt.'}</h2>
      </div>
      {s.geenMeting ? (
        <p class="text-slate-600 leading-relaxed max-w-2xl">{s.geenMeting} De gemeten sites staan met methode en datum op <a href="/resultaten/" class="underline">/resultaten/</a>.</p>
      ) : s.cijfers.length ? (
        <dl class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
          {s.cijfers.map((c) => (
            <div class="card">
              <dt class="text-xs text-slate-500 leading-snug">{c.label}</dt>
              <dd class="mt-1 text-3xl font-semibold tracking-tighter text-navy">{c.waarde}</dd>
              <dd class="mt-2 text-sm text-slate-600 leading-snug">{c.toelichting}</dd>
              <dd class="mt-2 text-[11px] text-slate-400">{c.methode} · {c.periode} · gemeten {c.gemeten_op}</dd>
            </div>
          ))}
        </dl>
      ) : (
        <p class="text-slate-600 leading-relaxed max-w-2xl">De beacon meet sinds {datum(s.metingSinds!)}. Zodra 28 dagen vol zijn, verschijnen hier dezelfde cijfers als bij de andere sites: sessies, aandeel via AI-assistenten, contactratio tegenover Google en verzonden formulieren. De live tabel op <a href="/resultaten/" class="underline">/resultaten/</a> toont intussen de voorlopige telling.</p>
      )}
      <p class="mt-6 text-xs text-slate-500 max-w-3xl">Contactactie = klik op bellen, WhatsApp, e-mail, route of een verzonden formulier (cookieloze beacon). Lead = afgeleverde aanvraag in de inbox van het bedrijf (afleverstatistiek). We tellen die twee nooit bij elkaar op.</p>
    </div>
  </section>

  <section class="section-tight bg-midnight text-pearl">
    <div class="container-page max-w-3xl">
      <h2 class="text-3xl font-semibold tracking-tighter text-pearl">Zo'n site voor uw bedrijf?</h2>
      <p class="mt-4 text-slate-300 leading-relaxed">AI-Website Bundel: website, Emma, AI-vindbaarheid en het meetpaneel in één contract. {euro(WEBSITE_BUNDEL.setup)} eenmalig, {euro(WEBSITE_BUNDEL.maand)} per maand, exclusief btw.</p>
      <div class="mt-6 flex flex-col sm:flex-row gap-3">
        <a href="/diensten/ai-website-bundel-mkb-nederland/" class="btn bg-pearl text-navy hover:bg-white text-base px-6 py-3.5">Bekijk de bundel</a>
        <a href="/demo-aanvragen/" class="btn border border-slate-700 text-pearl hover:bg-slate-800 text-base px-6 py-3.5">Plan een gesprek</a>
      </div>
    </div>
  </section>

  <FaqSection items={faqItems} />

  <section class="border-t border-slate-200 py-10">
    <div class="container-page">
      <h2 class="text-sm font-semibold uppercase tracking-[0.15em] text-slate-500 mb-4">Meer werk</h2>
      <ul class="flex flex-wrap gap-x-8 gap-y-2 text-sm">
        {anderen.map((x) => <li><a href={`/werk/${x.key}/`} class="text-navy underline-offset-4 hover:underline">{x.naam}</a></li>)}
        <li><a href="/werk/" class="text-brand-indigo font-semibold underline-offset-4 hover:underline">Alle sites →</a></li>
        <li><a href="/resultaten/" class="text-brand-indigo font-semibold underline-offset-4 hover:underline">Live resultaten →</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>
