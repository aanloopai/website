---
import BaseLayout from '../layouts/BaseLayout.astro';
import { GROEI, GROEI_MND } from '../data/pricing';

// 2026-09-15: "no-show verminderen afspraken" is een SERP zonder aanbieders
// (Firecrawl, 10/10 zorgnieuws). Titel/H1 dragen de zoekvraag nu letterlijk.
// Rekenmodel: geen verzonnen "5% residueel" meer, maar een relatieve daling
// van 38% — Koshy, Car & Majeed 2008 (BMC Ophthalmology): sms-herinnering
// 18,1% -> 11,2% no-show. Investering = Emma Groei, de eerste trede mét
// WhatsApp (het reminder-kanaal); Compleet was hier ten onrechte de basis.
const REDUCTIE = 0.38;
const INVEST_JAAR = GROEI.monthly * 12;

const faqs = [
  { q: 'Hoe kan ik no-shows verminderen zonder extra personeel?', a: 'De best onderzochte maatregel is een herinnering vlak vóór de afspraak, naast die van een dag ervoor: een extra sms-herinnering verlaagde de no-show-kans in een grote zorgstudie met nog eens 7% (regulier) tot 11% (ggz) bovenop de eerste (Nelson et al., 2022). Een AI-telefoniste als Emma verstuurt WhatsApp-bevestigingen en -reminders automatisch en laat de klant met één antwoord verzetten.' },
  { q: 'Wat is een realistisch no-show-percentage voor mijn branche?', a: 'Een landelijk, gepubliceerd benchmarkcijfer voor Nederland (NZa, Nivel, CBS) bestaat niet. Gebruik uw eigen cijfers; de standaardwaarde in deze calculator is een invulvoorbeeld, geen gemeten gemiddelde.' },
  { q: 'Mag ik een no-show-tarief in rekening brengen?', a: 'Ja, rechtstreeks bij de klant en vooraf gecommuniceerd (bijvoorbeeld in de bevestiging of voorwaarden). In de zorg mag een gemiste afspraak niet bij de zorgverzekeraar worden gedeclareerd — alleen direct bij de patiënt (NZa).' },
  { q: 'Waar komt de 38% in deze berekening vandaan?', a: 'Uit een veelgeciteerde studie in een oogheelkundige polikliniek: een sms-herinnering liet het no-show-percentage dalen van 18,1% naar 11,2%, een relatieve daling van 38% (Koshy, Car & Majeed, 2008, BMC Ophthalmology). Uw werkelijke effect hangt af van uw klanten en uw beleid; de calculator is een indicatie, geen belofte.' },
];

const calculatorSchema = {
  '@context': 'https://schema.org',
  // WebApplication is een subtype van SoftwareApplication en erft dus de
  // Google-eis van aggregateRating/review. Die beoordelingen bestaan niet voor
  // deze calculator, dus blijft alleen WebPage over.
  '@type': 'WebPage',
  '@id': 'https://aanloopai.nl/no-show-calculator/#calculator',
  name: 'No-shows verminderen: bereken wat het u kost',
  description: 'Bereken in 30 seconden hoeveel uw bedrijf jaarlijks verliest aan no-shows en wat u kunt besparen met AI-WhatsApp herinneringen. Vrij te gebruiken, geen registratie.',
  url: 'https://aanloopai.nl/no-show-calculator/',
  isAccessibleForFree: true,
  inLanguage: 'nl-NL',
  creator: { '@id': 'https://aanloopai.nl/#organization' },
};
---

<BaseLayout
  title="No-show verminderen: bereken uw verlies"
  description="No-show verminderen begint met inzicht: bereken in 30 seconden uw jaarlijkse verlies aan gemiste afspraken en wat WhatsApp-herinneringen besparen."
  schema={calculatorSchema}
  faqSchema={faqs.map((f) => ({ question: f.q, answer: f.a }))}
>
  <section class="section">
    <div class="container-page max-w-3xl">
      <p class="eyebrow text-brand-indigo mb-3">Tools · Calculator</p>
      <h1 class="text-3xl lg:text-5xl font-bold text-navy tracking-tightest mb-6">No-shows verminderen: bereken wat het u kost</h1>
      <p class="text-lg text-slate-600 leading-relaxed mb-2">
        Bereken in 30 seconden hoeveel uw bedrijf jaarlijks verliest aan no-shows — en hoeveel u bespaart met AI-WhatsApp herinneringen.
      </p>
      <p class="text-sm text-slate-500">Geen registratie. Het effect van herinneringen komt uit gepubliceerd onderzoek (bron onderaan); uw eigen cijfers bepalen de uitkomst.</p>
    </div>
  </section>

  <section class="section bg-slate-50/60 border-y border-slate-200">
    <div class="container-page max-w-3xl">
      <div class="card p-6 lg:p-8 bg-white">
        <div class="space-y-6">
          <div>
            <label for="appointments" class="block text-sm font-semibold text-navy mb-2">
              Hoeveel afspraken per week heeft u gemiddeld?
            </label>
            <input id="appointments" type="number" min="1" max="2000" value="100" class="w-full px-4 py-3 border border-slate-300 rounded-xl text-lg font-semibold text-navy focus:outline-none focus:border-brand-indigo" />
          </div>

          <div>
            <label for="value" class="block text-sm font-semibold text-navy mb-2">
              Wat is uw gemiddelde afspraakwaarde (euro)?
            </label>
            <input id="value" type="number" min="10" max="10000" value="75" class="w-full px-4 py-3 border border-slate-300 rounded-xl text-lg font-semibold text-navy focus:outline-none focus:border-brand-indigo" />
            <p class="text-xs text-slate-500 mt-1">Bijv. huisarts 90 euro, fysio 50 euro, kapper 65 euro, garage APK 75 euro</p>
          </div>

          <div>
            <label for="rate" class="block text-sm font-semibold text-navy mb-2">
              Wat is uw huidige no-show percentage?
            </label>
            <select id="rate" class="w-full px-4 py-3 border border-slate-300 rounded-xl text-lg font-semibold text-navy focus:outline-none focus:border-brand-indigo">
              <option value="10">10% (zeer goed — al sterke herinneringsflow)</option>
              <option value="15" selected>15% (gemiddeld voor MKB Nederland)</option>
              <option value="20">20% (typisch zonder herinneringen)</option>
              <option value="25">25% (boven gemiddeld — vaak premium-segment)</option>
              <option value="30">30% (zeer hoog — actie nodig)</option>
            </select>
          </div>
        </div>

        <button id="calc-button" class="btn-primary w-full mt-8 justify-center">
          Bereken mijn no-show verlies
        </button>
      </div>

      <div id="results" class="mt-6 hidden" data-reductie={REDUCTIE} data-invest-jaar={INVEST_JAAR} data-invest-mnd={GROEI.monthly}>
        <div class="card p-6 lg:p-8 bg-white border-2 border-brand-indigo">
          <p class="eyebrow text-brand-indigo mb-3">Uw resultaten</p>
          <h2 class="text-2xl font-bold text-navy mb-6">Berekening</h2>

          <div class="grid sm:grid-cols-2 gap-4 mb-6">
            <div class="bg-slate-50 rounded-xl p-5">
              <p class="text-xs uppercase tracking-wider text-slate-500 mb-1">Uw huidige verlies (jaar)</p>
              <p class="text-2xl font-bold text-rose-600" id="current-loss">-</p>
              <p class="text-xs text-slate-500 mt-1" id="current-detail">-</p>
            </div>
            <div class="bg-brand-emerald/5 rounded-xl p-5 border border-brand-emerald/20">
              <p class="text-xs uppercase tracking-wider text-brand-emerald mb-1">Met herinneringen (−38%)</p>
              <p class="text-2xl font-bold text-brand-emerald" id="ai-loss">-</p>
              <p class="text-xs text-slate-500 mt-1" id="ai-detail">-</p>
            </div>
          </div>

          <div class="card p-5 bg-brand-indigo/5 border border-brand-indigo/20 mb-6">
            <p class="text-xs uppercase tracking-wider text-brand-indigo mb-2">Mogelijke besparing per jaar</p>
            <p class="text-4xl font-bold text-brand-indigo" id="saved">-</p>
            <p class="text-xs text-slate-500 mt-2" id="saved-detail">-</p>
          </div>

          <div class="card p-5 bg-slate-50">
            <p class="text-xs uppercase tracking-wider text-slate-500 mb-2">Aanloop AI Emma — telefoon + WhatsApp</p>
            <p class="text-sm font-semibold text-navy mb-1">Emma Groei {GROEI_MND} — telefoon + WhatsApp-herinneringen</p>
            <p class="text-xs text-slate-500" id="roi-detail">-</p>
          </div>

          <div class="mt-6 flex flex-wrap gap-3">
            <a href="/demo-aanvragen/" class="btn-primary">Plan gratis demo</a>
            <a href="/kennisbank/ai-no-show-reductie-mkb-nederland/" class="btn-outline">Lees: wat aantoonbaar werkt tegen no-shows</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page max-w-3xl">
      <h2 class="text-2xl lg:text-3xl font-bold text-navy mb-6">Hoe werkt deze berekening?</h2>
      <div class="space-y-4 text-slate-600 text-sm leading-relaxed">
        <p><strong class="text-navy">Formule:</strong> Jaarlijks verlies = (afspraken per week × 52) × (no-show percentage / 100) × afspraakwaarde.</p>
        <p><strong class="text-navy">Met herinneringen:</strong> wij rekenen met een relatieve daling van 38% — in een veelgeciteerde studie daalde het no-show-percentage door een sms-herinnering van 18,1% naar 11,2% (<a href="https://pmc.ncbi.nlm.nih.gov/articles/PMC2438329/" rel="noopener" target="_blank" class="text-brand-indigo underline">Koshy, Car &amp; Majeed, 2008</a>). Een tweede herinnering kort vooraf voegt daar in onderzoek nog 7-11% aan toe (<a href="https://pmc.ncbi.nlm.nih.gov/articles/PMC9126539/" rel="noopener" target="_blank" class="text-brand-indigo underline">Nelson et al., 2022</a>); die tellen we bewust niet mee. Uw werkelijke effect verschilt.</p>
        <p><strong class="text-navy">Investering:</strong> Emma Groei {GROEI_MND} ({INVEST_JAAR.toLocaleString('nl-NL')} euro per jaar) — de eerste trede met WhatsApp, het kanaal voor de herinneringen. Emma Start ({'€149/mnd'}) neemt de telefoon aan maar stuurt geen WhatsApp. Bekijk <a href="/tarieven/" class="text-brand-indigo underline">alle tarieven</a>.</p>
        <p><strong class="text-navy">Onbekende waardes?</strong> Schat realistisch. Voor exacte cijfers per branche: zie onze sectorspecifieke <a href="/kennisbank/" class="text-brand-indigo underline">kennisbank-gidsen</a>.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
  const fmt = (n: number) => n.toLocaleString('nl-NL', { maximumFractionDigits: 0 });

  const btn = document.getElementById('calc-button');
  const resultsBox = document.getElementById('results');

  // De uitkomst werd alleen bij een klik op de knop berekend. Wie daarna een
  // invoerveld aanpaste, hield de oude bedragen in beeld zonder dat iets
  // aangaf dat ze niet meer klopten. Nu herrekent elke wijziging zodra de
  // resultaten zichtbaar zijn; de knop blijft de eerste onthulling.
  let resultsVisible = false;

  function recalculate(reveal: boolean) {
    const apptsPerWeek = parseFloat($('appointments').value || '0');
    const value = parseFloat($('value').value || '0');
    const noShowPct = parseFloat($('rate').value || '15');

    if (apptsPerWeek <= 0 || value <= 0) return;

    const apptsPerYear = apptsPerWeek * 52;
    const currentNoShows = apptsPerYear * (noShowPct / 100);
    const currentLoss = currentNoShows * value;

    const reductie = Number(resultsBox?.dataset.reductie || 0.38);
    const investJaar = Number(resultsBox?.dataset.investJaar || 0);
    const investMnd = Number(resultsBox?.dataset.investMnd || 0);
    const aiNoShows = currentNoShows * (1 - reductie);
    const aiLoss = aiNoShows * value;

    const saved = currentLoss - aiLoss;
    const roiMultiple = investJaar > 0 ? saved / investJaar : 0;

    document.getElementById('current-loss')!.textContent = '€ ' + fmt(currentLoss);
    document.getElementById('current-detail')!.textContent = `${fmt(currentNoShows)} gemiste afspraken per jaar bij ${noShowPct}%`;

    document.getElementById('ai-loss')!.textContent = '€ ' + fmt(aiLoss);
    document.getElementById('ai-detail')!.textContent = `${fmt(aiNoShows)} gemiste afspraken per jaar bij ${(noShowPct * (1 - reductie)).toFixed(1)}%`;

    document.getElementById('saved')!.textContent = '€ ' + fmt(saved);
    document.getElementById('saved-detail')!.textContent = `${fmt(currentNoShows - aiNoShows)} extra ingevulde slots per jaar`;

    document.getElementById('roi-detail')!.textContent =
      `Investering Emma Groei ${investMnd} euro per maand = ${fmt(investJaar)} euro per jaar. Indicatieve verhouding besparing/investering: ${roiMultiple.toFixed(1)}x op alleen no-shows.`;

    resultsBox?.classList.remove('hidden');
    resultsVisible = true;
    if (reveal) resultsBox?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  btn?.addEventListener('click', () => recalculate(true));

  ['appointments', 'value', 'rate'].forEach((id) => {
    const el = $(id);
    el?.addEventListener('input', () => { if (resultsVisible) recalculate(false); });
    el?.addEventListener('change', () => { if (resultsVisible) recalculate(false); });
  });
</script>
