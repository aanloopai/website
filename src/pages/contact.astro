---
import BaseLayout from '../layouts/BaseLayout.astro';

const url = new URL(Astro.request.url);
const type = url.searchParams.get('type') || 'contact';
---

<BaseLayout
  title="Contact · Aanloop AI"
  description="Neem contact op met Aanloop AI. Boek een gratis demo, stel een vraag, of plan een adviesgesprek van 30 minuten."
>
  <section class="border-b border-slate-200">
    <div class="container-page py-16 lg:py-24">
      <div class="max-w-3xl">
        <div class="flex items-center gap-4 mb-6">
          <div class="accent-band"><span></span><span></span><span></span><span></span></div>
          <span class="eyebrow">Contact</span>
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tightest text-navy text-balance leading-[1.05]">
          Laten we kennismaken.
        </h1>
        <p class="mt-6 text-lg lg:text-xl text-slate-600 leading-relaxed text-pretty max-w-2xl">
          Boek een gratis adviesgesprek van 30 minuten. We laten u live een AI-assistent zien — afgestemd op uw branche. Geen verplichtingen.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page">
      <div class="grid lg:grid-cols-5 gap-16">

        <!-- Contact form -->
        <div class="lg:col-span-3">
          <form id="contact-form" class="space-y-6" novalidate>
            <!-- Type selector -->
            <div>
              <label class="block text-sm font-medium text-navy mb-3">Waarmee kan ik u helpen?</label>
              <div class="grid grid-cols-2 sm:grid-cols-3 gap-3" role="group">
                {[
                  { value: 'demo', label: '🎯 Gratis demo' },
                  { value: 'contact', label: '💬 Vraag stellen' },
                  { value: 'offerte', label: '📋 Offerte aanvragen' },
                ].map((opt) => (
                  <label class="type-option">
                    <input type="radio" name="type" value={opt.value} checked={type === opt.value} class="sr-only" />
                    <span class="block p-3 border border-slate-200 rounded-xl text-sm font-medium text-center cursor-pointer transition-all hover:border-navy peer-checked:border-navy peer-checked:bg-navy peer-checked:text-white">
                      {opt.label}
                    </span>
                  </label>
                ))}
              </div>
            </div>

            <!-- Name + company -->
            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label for="name" class="block text-sm font-medium text-navy mb-2">Naam *</label>
                <input type="text" id="name" name="name" required autocomplete="name"
                  class="form-input" placeholder="Jan de Boer" />
              </div>
              <div>
                <label for="company" class="block text-sm font-medium text-navy mb-2">Bedrijfsnaam *</label>
                <input type="text" id="company" name="company" required autocomplete="organization"
                  class="form-input" placeholder="De Boer BV" />
              </div>
            </div>

            <!-- Email + phone -->
            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label for="email" class="block text-sm font-medium text-navy mb-2">E-mailadres *</label>
                <input type="email" id="email" name="email" required autocomplete="email"
                  class="form-input" placeholder="jan@deboeerbv.nl" />
              </div>
              <div>
                <label for="phone" class="block text-sm font-medium text-navy mb-2">Telefoonnummer</label>
                <input type="tel" id="phone" name="phone" autocomplete="tel"
                  class="form-input" placeholder="06 12 34 56 78" />
              </div>
            </div>

            <!-- Sector -->
            <div>
              <label for="sector" class="block text-sm font-medium text-navy mb-2">Uw branche</label>
              <select id="sector" name="sector" class="form-input">
                <option value="">Selecteer uw branche</option>
                <option>Horeca</option>
                <option>Logistiek & transport</option>
                <option>Vastgoed & makelaars</option>
                <option>Detailhandel</option>
                <option>Zakelijke dienstverlening</option>
                <option>Zorg & welzijn</option>
                <option>Anders</option>
              </select>
            </div>

            <!-- Message -->
            <div>
              <label for="message" class="block text-sm font-medium text-navy mb-2">Uw bericht *</label>
              <textarea id="message" name="message" rows="5" required
                class="form-input resize-none"
                placeholder="Vertel ons kort over uw bedrijf en hoe wij u kunnen helpen..."></textarea>
            </div>

            <!-- Privacy -->
            <div class="flex items-start gap-3">
              <input type="checkbox" id="privacy" name="privacy" required
                class="mt-1 w-4 h-4 rounded border-slate-300 text-brand-indigo focus:ring-brand-indigo cursor-pointer" />
              <label for="privacy" class="text-sm text-slate-600">
                Ik ga akkoord met de <a href="/privacy/" class="underline hover:text-navy">privacyverklaring</a>
                en geef toestemming voor het verwerken van mijn gegevens.
              </label>
            </div>

            <button type="submit" id="submit-btn" class="btn-primary text-base px-8 py-3.5 w-full sm:w-auto">
              <span id="submit-label">Verstuur bericht</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </button>

            <!-- Success message -->
            <div id="form-success" class="hidden p-4 rounded-xl bg-brand-emerald/10 border border-brand-emerald/20 text-brand-emerald text-sm">
              ✓ Bedankt! We nemen binnen 1 werkdag contact op.
            </div>
            <!-- Error message -->
            <div id="form-error" class="hidden p-4 rounded-xl bg-brand-rose/10 border border-brand-rose/20 text-brand-rose text-sm">
              ✗ Er is iets misgegaan. Probeer het opnieuw of mail naar <a href="mailto:hello@aanloopai.nl" class="underline">hello@aanloopai.nl</a>.
            </div>
          </form>
        </div>

        <!-- Contact info sidebar -->
        <div class="lg:col-span-2 space-y-6">
          <div class="card">
            <h2 class="font-bold text-navy mb-4">Direct bereikbaar</h2>
            <div class="space-y-4 text-sm">
              <a href="mailto:hello@aanloop.ai" class="flex items-center gap-3 text-slate-700 hover:text-navy transition-colors group">
                <div class="w-9 h-9 rounded-lg bg-brand-indigo/10 flex items-center justify-center flex-shrink-0 group-hover:bg-brand-indigo/20 transition-colors">
                  <svg class="w-4 h-4 text-brand-indigo" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                </div>
                hello@aanloop.ai
              </a>
              <a href="tel:+31000000000" class="flex items-center gap-3 text-slate-700 hover:text-navy transition-colors group">
                <div class="w-9 h-9 rounded-lg bg-brand-rose/10 flex items-center justify-center flex-shrink-0 group-hover:bg-brand-rose/20 transition-colors">
                  <svg class="w-4 h-4 text-brand-rose" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                </div>
                Op afspraak beschikbaar
              </a>
              <div class="flex items-center gap-3 text-slate-700">
                <div class="w-9 h-9 rounded-lg bg-brand-amber/10 flex items-center justify-center flex-shrink-0">
                  <svg class="w-4 h-4 text-brand-amber" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                </div>
                Rotterdam, Nederland
              </div>
            </div>
          </div>

          <div class="card">
            <h2 class="font-bold text-navy mb-3">Reactietijd</h2>
            <div class="space-y-2">
              {[
                { label: 'Demo-aanvragen', time: 'Zelfde dag', color: 'text-brand-emerald' },
                { label: 'Algemene vragen', time: '< 24 uur', color: 'text-brand-emerald' },
                { label: 'Offertes', time: '1–3 werkdagen', color: 'text-brand-amber' },
              ].map(item => (
                <div class="flex justify-between items-center text-sm py-2 border-b border-slate-100 last:border-0">
                  <span class="text-slate-600">{item.label}</span>
                  <span class={`font-medium ${item.color}`}>{item.time}</span>
                </div>
              ))}
            </div>
          </div>

          <div class="card">
            <p class="text-sm font-medium text-navy mb-2">Liever direct plannen?</p>
            <p class="text-xs text-slate-600 mb-4">Boek direct een tijdslot in onze agenda.</p>
            <a href="/demo-aanvragen/" class="btn-outline text-sm w-full justify-center">
              📅 Kies een tijdslot
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .form-input {
    @apply w-full px-4 py-3 border border-slate-200 rounded-xl text-sm text-navy placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-indigo focus:border-transparent transition-all;
  }
  .type-option input:checked + span {
    @apply border-navy bg-navy text-white;
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const WEB3FORMS_KEY = '10596d38-fc14-4230-a3c9-4bb1a6981bc7';

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('submit-btn') as HTMLButtonElement;
    const label = document.getElementById('submit-label') as HTMLElement;
    const successMsg = document.getElementById('form-success') as HTMLElement;
    const errorMsg = document.getElementById('form-error') as HTMLElement;

    // Gather form data
    const data = new FormData(form);
    const submitterName = (data.get('name') as string)?.split(' ')[0] || 'daar';
    const requestType = data.get('type') as string || 'contact';
    const typeLabel: Record<string, string> = {
      demo: 'demo-aanvraag',
      contact: 'bericht',
      offerte: 'offerteaanvraag',
    };

    data.append('access_key', WEB3FORMS_KEY);
    data.append('subject', `Nieuw bericht via aanloopai.nl — ${typeLabel[requestType] || requestType}`);
    data.append('from_name', 'Aanloop AI');
    data.append('replyto', data.get('email') as string);

    // Auto-response to the submitter
    data.append('autoresponse', 'true');
    data.append('autoresponse_subject', `Bedankt voor uw ${typeLabel[requestType] || 'bericht'} — Aanloop AI`);
    data.append('autoresponse_message', `Hallo ${submitterName},\n\nBedankt voor uw bericht! We hebben uw ${typeLabel[requestType] || 'bericht'} goed ontvangen.\n\nWe nemen zo snel mogelijk contact met u op — bij demo-aanvragen streven we naar dezelfde werkdag.\n\nMet vriendelijke groet,\nHet team van Aanloop AI\n\n---\nAanloop AI | AI-oplossingen voor het Nederlandse MKB\nhello@aanloopai.nl | aanloopai.nl`);
    data.append('redirect', 'false');

    btn.disabled = true;
    label.textContent = 'Versturen…';
    errorMsg?.classList.add('hidden');

    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: data,
      });
      const json = await res.json();

      if (json.success) {
        successMsg?.classList.remove('hidden');
        form.reset();
        // Redirect to thank you page after 1.5s
        setTimeout(() => {
          window.location.href = '/bedankt/?type=contact';
        }, 1500);
      } else {
        throw new Error(json.message || 'Onbekende fout');
      }
    } catch (err) {
      errorMsg?.classList.remove('hidden');
      console.error('Form error:', err);
    } finally {
      btn.disabled = false;
      label.textContent = 'Verstuur bericht';
    }
  });
</script>
