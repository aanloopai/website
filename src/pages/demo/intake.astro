---
// Demo-intake: vijf korte vragen na een demo-aanvraag. De link in de mail
// draagt een HMAC-token (?t=…); zonder geldig token toont de pagina een
// nette uitleg en geen formulier. Zie src/lib/demo-intake.js.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { DEMO_INTAKE_SCHEMA } from '../../lib/demo-intake.js';
const inputCls = 'w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-indigo transition-all';
---
<BaseLayout title="Uw demo voorbereiden" description="Vijf korte vragen zodat wij uw demo bij Aanloop AI afstemmen op uw bedrijf." noindex={true}>
  <section class="border-b border-slate-200 hero-gradient">
    <div class="container-page py-12 lg:py-16">
      <div class="max-w-3xl">
        <div class="flex items-center gap-4 mb-6 reveal"><div class="accent-band"><span></span><span></span><span></span><span></span></div><span class="eyebrow">Demo voorbereiden</span></div>
        <h1 id="intake-h1" class="text-4xl sm:text-5xl font-semibold tracking-tighter text-navy text-balance leading-[1.08] reveal reveal-delay-1">Nog vijf korte vragen</h1>
        <p class="mt-5 text-lg text-slate-600 leading-relaxed reveal reveal-delay-2">
          U hoeft nergens in te loggen — er is geen account. Met uw antwoorden bereiden wij een demo voor die over <strong>uw</strong> situatie gaat. Twee minuten.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page max-w-2xl mx-auto">
      <div id="intake-loading" class="bg-white border border-slate-200 rounded-lg p-8 shadow-sm text-sm text-slate-500">Even geduld…</div>

      <div id="intake-invalid" class="bg-white border border-slate-200 rounded-lg p-8 shadow-sm hidden">
        <h2 class="text-lg font-bold text-navy mb-2">Deze link is ongeldig of verlopen</h2>
        <p id="intake-invalid-msg" class="text-sm text-slate-600 leading-relaxed">Stuur een e-mail naar <a class="text-brand-indigo underline" href="mailto:hello@aanloopai.nl">hello@aanloopai.nl</a> of vraag opnieuw een demo aan via <a class="text-brand-indigo underline" href="/demo-aanvragen/">aanloopai.nl/demo-aanvragen</a>.</p>
      </div>

      <div id="intake-done" class="bg-white border border-slate-200 rounded-lg p-8 shadow-sm hidden text-center">
        <div class="w-16 h-16 rounded-full bg-brand-emerald/10 flex items-center justify-center mx-auto mb-6">
          <svg class="w-8 h-8 text-brand-emerald" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
        </div>
        <h2 class="text-2xl font-semibold tracking-tighter text-navy mb-3">Bedankt, uw antwoorden zijn binnen</h2>
        <p class="text-slate-600 leading-relaxed mb-6">Wij nemen <strong>binnen 1 werkdag</strong> contact op om de demo in te plannen. Wilt u zelf alvast een moment kiezen?</p>
        <a href="/demo-inplannen/" class="btn-primary">Direct een moment kiezen</a>
      </div>

      <form id="intake-form" class="hidden" novalidate>
        <div class="bg-white border border-slate-200 rounded-lg p-8 shadow-sm space-y-7">
          {DEMO_INTAKE_SCHEMA.map((q, i) => (
            <div>
              <label class="block text-sm font-semibold text-navy mb-1" for={`q-${q.name}`}>{i + 1}. {q.label}{q.required && <span class="text-red-500"> *</span>}</label>
              {q.hint && <p class="text-xs text-slate-500 mb-3">{q.hint}</p>}
              {q.type === 'multiselect' && (
                <div class="space-y-2" id={`q-${q.name}`}>
                  {q.options.map((o) => (
                    <label class="flex items-start gap-3 cursor-pointer text-sm text-slate-700">
                      <input type="checkbox" name={q.name} value={o} class="mt-0.5 w-4 h-4 rounded border-slate-300 text-brand-indigo focus:ring-brand-indigo" />
                      <span>{o}</span>
                    </label>
                  ))}
                </div>
              )}
              {q.type === 'select' && (
                <select id={`q-${q.name}`} name={q.name} class={inputCls}>
                  <option value="">Maak een keuze…</option>
                  {q.options.map((o) => <option value={o}>{o}</option>)}
                </select>
              )}
              {q.type === 'textarea' && <textarea id={`q-${q.name}`} name={q.name} rows="3" class={inputCls + ' resize-none'}></textarea>}
              {q.type === 'text' && <input type="text" id={`q-${q.name}`} name={q.name} class={inputCls} />}
            </div>
          ))}
          <p id="form-error" class="text-sm text-red-600 hidden" role="alert"></p>
          <div class="flex items-center justify-between gap-4 pt-2">
            <p class="text-xs text-slate-400">Uw antwoorden gebruiken wij alleen om de demo voor te bereiden.</p>
            <button type="submit" id="submit-btn" class="btn-primary px-8"><span id="submit-txt">Antwoorden versturen</span></button>
          </div>
        </div>
      </form>
    </div>
  </section>

  <script>
    (function () {
      var token = new URLSearchParams(window.location.search).get('t') || '';
      var loading = document.getElementById('intake-loading') as HTMLElement;
      var invalid = document.getElementById('intake-invalid') as HTMLElement;
      var invalidMsg = document.getElementById('intake-invalid-msg') as HTMLElement;
      var done = document.getElementById('intake-done') as HTMLElement;
      var form = document.getElementById('intake-form') as HTMLFormElement;
      var errEl = document.getElementById('form-error') as HTMLElement;

      function show(el: HTMLElement) {
        [loading, invalid, done, form].forEach(function (x) { x.classList.add('hidden'); });
        el.classList.remove('hidden');
      }
      function fail(msg?: string) {
        if (msg) invalidMsg.textContent = msg + ' ';
        show(invalid);
      }

      if (!token) { fail(); return; }

      fetch('/api/demo-intake?t=' + encodeURIComponent(token), { headers: { accept: 'application/json' } })
        .then(function (r) { return r.json(); })
        .then(function (j) {
          if (!j || !j.ok) { fail(j && j.error); return; }
          if (j.lead && j.lead.voornaam) {
            var h1 = document.getElementById('intake-h1');
            if (h1) h1.textContent = 'Hallo ' + j.lead.voornaam + ', nog vijf korte vragen';
          }
          if (j.lead && j.lead.answered) { show(done); return; }
          show(form);
        })
        .catch(function () { fail('De verbinding is mislukt. Probeer het later opnieuw.'); });

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        errEl.classList.add('hidden');
        var answers: Record<string, unknown> = {};
        var fd = new FormData(form);
        fd.forEach(function (v, k) {
          var cur = answers[k];
          if (cur === undefined) answers[k] = v;
          else answers[k] = ([] as unknown[]).concat(cur as unknown[], [v]);
        });
        // checkbox-groepen altijd als lijst
        var dienst = fd.getAll('dienst');
        if (dienst.length) answers['dienst'] = dienst;
        var btn = document.getElementById('submit-btn') as HTMLButtonElement;
        var txt = document.getElementById('submit-txt') as HTMLElement;
        btn.disabled = true; txt.textContent = 'Versturen…';
        fetch('/api/demo-intake', {
          method: 'POST',
          headers: { 'content-type': 'application/json', accept: 'application/json' },
          body: JSON.stringify({ t: token, answers: answers }),
        })
          .then(function (r) { return r.json(); })
          .then(function (j) {
            if (j && j.ok) { show(done); window.scrollTo({ top: 0, behavior: 'smooth' }); return; }
            errEl.textContent = (j && j.error) || 'Er ging iets mis. Probeer opnieuw of mail naar hello@aanloopai.nl.';
            errEl.classList.remove('hidden');
            btn.disabled = false; txt.textContent = 'Antwoorden versturen';
          })
          .catch(function () {
            errEl.textContent = 'De verbinding is mislukt. Probeer opnieuw of mail naar hello@aanloopai.nl.';
            errEl.classList.remove('hidden');
            btn.disabled = false; txt.textContent = 'Antwoorden versturen';
          });
      });
    })();
  </script>
</BaseLayout>
