---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': 'https://aanloopai.nl/pers/#webpage',
  name: 'Pers & Media — Aanloop AI',
  description: 'Persinformatie, logos en bedrijfsfeiten van Aanloop AI B.V. Voor journalisten, partners en analisten die schrijven over AI in het Nederlandse MKB.',
  url: 'https://aanloopai.nl/pers/',
  inLanguage: 'nl-NL',
  about: { '@id': 'https://aanloopai.nl/#organization' },
  mainEntity: {
    '@id': 'https://aanloopai.nl/#organization',
  },
};

const facts = [
  { label: 'Bedrijfsnaam', value: 'Aanloop AI B.V.' },
  { label: 'KvK', value: '56312075' },
  { label: 'Oprichting', value: '2023' },
  { label: 'Hoofdkantoor', value: 'Rotterdam, Nederland' },
  { label: 'Oprichter & CEO', value: 'Mustafa Agah Dogan' },
  { label: 'Sector', value: 'AI / SaaS / B2B' },
  { label: 'Doelgroep', value: 'Nederlands MKB (5-250 medewerkers)' },
  { label: 'Sectoren', value: '11 gespecialiseerd' },
  { label: 'Sectoren bediend', value: 'Zorg, advocatuur, accountancy, bouw, retail, horeca, vastgoed, recruitment, en meer' },
  { label: 'Datalokatie', value: 'EU-only (Frankfurt / Amsterdam)' },
  { label: 'Compliance', value: 'AVG, NEN 7510-bewust, ISO 27001-cloud' },
  { label: 'Contact (pers)', value: 'pers@aanloopai.nl' },
];

const products = [
  { name: 'Marco', desc: 'AI receptionist (voicebot) voor inkomende telefonie. 24/7 beschikbaar, NL-talig, agenda-koppeling.', price: '497 euro per maand (één vast tarief)' },
  { name: 'Emma', desc: 'WhatsApp Business AI-assistent voor klantcommunicatie. Intake, herinneringen, no-show reductie.', price: 'vanaf 197 euro per maand' },
  { name: 'Custom AI Solutions', desc: 'Maatwerk AI-workflows met n8n, integraties met EPD, ERP, CRM en sectorspecifieke software.', price: 'op maat geprijsd' },
  { name: 'AI Audit', desc: 'Discovery-traject: identificatie van AI-kansen voor uw bedrijf, ROI-berekening, implementatie-roadmap.', price: 'gratis kennismaking' },
];

const milestones = [
  { date: '2023', event: 'Aanloop AI B.V. opgericht in Rotterdam (KvK 56312075).' },
  { date: '2023', event: 'Marco (AI-receptionist) gelanceerd voor zorg en zakelijke dienstverlening.' },
  { date: '2024', event: 'Lancering Emma (WhatsApp Business AI) — multikanaal klantcontact.' },
  { date: '2025', event: 'Custom AI Solutions geïntroduceerd — n8n-workflows voor maatwerk.' },
  { date: '2025 Q4', event: 'Uitbreiding van het dienstenaanbod. Lancering kennisbank met 38 sectorspecifieke gidsen.' },
  { date: '2026 Q1', event: 'Kennisbank uitgebreid naar 48 gidsen. Glossarium en pers-portal live.' },
];

const quotes = [
  {
    text: 'AI moet werken voor uw bedrijf, niet voor PowerPoint-decks. Wij bouwen oplossingen die de receptioniste of de werkvoorbereider direct ontlast — niet pilots die jaren duren.',
    author: 'Mustafa Agah Dogan',
    role: 'Oprichter & CEO Aanloop AI',
  },
  {
    text: 'Het Nederlandse MKB heeft niet hetzelfde budget als multinationals, maar wel dezelfde behoefte aan automatisering. Aanloop AI maakt enterprise-grade AI toegankelijk vanaf 197 euro per maand.',
    author: 'Mustafa Agah Dogan',
    role: 'Oprichter & CEO Aanloop AI',
  },
];

const missionStatement = 'Aanloop AI maakt enterprise-grade AI toegankelijk voor het Nederlandse MKB. Wij geloven dat AI alleen waarde toevoegt als het meetbaar werk uit handen neemt — vanaf de eerste week, niet over twee jaar. Onze drie productlijnen (Marco, Emma en AI-document automation) zijn ontworpen om binnen 7 werkdagen live te gaan, EU-only data te garanderen en maandelijks opzegbaar te zijn. Geen lock-in, geen pilot-budgets, wel resultaat.';

const brandColors = [
  { name: 'Midnight', hex: '#0B1220', usage: 'Primaire achtergrond, footer, dark surfaces' },
  { name: 'Navy', hex: '#0F1E3D', usage: 'Headlines, primaire tekst, navigatie' },
  { name: 'Pearl', hex: '#F4F6FA', usage: 'Tekst op donkere achtergrond, light surfaces' },
  { name: 'Slate-600', hex: '#475569', usage: 'Body-tekst, secundaire informatie' },
  { name: 'Slate-200', hex: '#E2E8F0', usage: 'Borders, subtle dividers' },
  { name: 'Indigo (accent)', hex: '#4F46E5', usage: 'Call-to-action, links, accent-band' },
];

const factsheetLines = [
  'Aanloop AI B.V. - KvK 56312075 - opgericht 2023 in Rotterdam.',
  'Drie productlijnen: Marco (AI-receptionist telefoon), Emma (AI WhatsApp), AI-document automation.',
  'Vanaf 49 euro per maand (Emma Lite); 497 euro (Marco); 997 euro (Marco Groei).',
  '7 werkdagen tot live-gang, 99,5 procent SLA, EU-only datacentra (Frankfurt/Amsterdam).',
  'AVG-DPA in 1 dag ondertekend; NEN 7510 add-on voor zorgsector beschikbaar.',
  'Oplossingen voor zorg, juridisch, automotive, hospitality, retail, bouw en recruitment.',
  'Stack: ElevenLabs voice, GPT-4o + Claude 3.5 + Mistral LLM, n8n self-hosted, Dify RAG.',
  'Founder: Mustafa Agah Dogan - magahdogan@aanloopai.nl - LinkedIn /in/magahdogan/',
];
---

<BaseLayout
  title="Pers & Media"
  description="Persinformatie, logos, bedrijfsfeiten en quotes van Aanloop AI B.V. Voor journalisten, partners en analisten die schrijven over AI in het Nederlandse MKB."
  schema={pageSchema}
>
  <section class="section">
    <div class="container-page max-w-4xl">
      <p class="eyebrow text-brand-indigo mb-3">Pers & Media</p>
      <h1 class="text-3xl lg:text-5xl font-bold text-navy tracking-tightest mb-6">Pers & media — Aanloop AI</h1>
      <p class="text-lg text-slate-600 leading-relaxed mb-8">
        Welkom bij ons pers-portaal. Hier vindt u alle benodigde informatie om over Aanloop AI te schrijven: bedrijfsfeiten, productinformatie, founder-quotes en logos. Voor interviews of aanvullende vragen kunt u direct contact opnemen.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href="mailto:pers@aanloopai.nl" class="btn-primary">Mail pers@aanloopai.nl</a>
        <a href="https://wa.me/31624741597" class="btn-outline">WhatsApp Mustafa direct</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page max-w-3xl">
      <h2 class="text-2xl lg:text-3xl font-bold text-navy mb-6">Onze missie</h2>
      <p class="text-lg text-slate-700 leading-relaxed">{missionStatement}</p>
    </div>
  </section>

  <section class="section bg-slate-50/60 border-y border-slate-200">
    <div class="container-page max-w-4xl">
      <h2 class="text-2xl lg:text-3xl font-bold text-navy mb-8">Bedrijfsfeiten</h2>
      <dl class="grid sm:grid-cols-2 gap-4">
        {facts.map((f) => (
          <div class="card p-5 bg-white">
            <dt class="text-xs uppercase tracking-wider text-slate-500 mb-1">{f.label}</dt>
            <dd class="font-semibold text-navy text-sm leading-snug">{f.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="container-page max-w-4xl">
      <h2 class="text-2xl lg:text-3xl font-bold text-navy mb-8">Producten</h2>
      <div class="space-y-4">
        {products.map((p) => (
          <div class="card p-6 bg-white border border-slate-200">
            <div class="flex items-start justify-between gap-4 flex-wrap">
              <div class="flex-1 min-w-0">
                <h3 class="font-bold text-navy text-lg mb-2">{p.name}</h3>
                <p class="text-slate-600 text-sm leading-relaxed">{p.desc}</p>
              </div>
              <span class="pill bg-brand-indigo/10 text-brand-indigo">{p.price}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-slate-50/60 border-y border-slate-200">
    <div class="container-page max-w-4xl">
      <h2 class="text-2xl lg:text-3xl font-bold text-navy mb-8">Mijlpalen</h2>
      <ol class="space-y-4">
        {milestones.map((m) => (
          <li class="card p-5 bg-white flex gap-5 items-start">
            <span class="text-xs font-mono uppercase tracking-wider text-brand-indigo flex-shrink-0 w-20">{m.date}</span>
            <p class="text-slate-700 text-sm leading-relaxed">{m.event}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container-page max-w-4xl">
      <h2 class="text-2xl lg:text-3xl font-bold text-navy mb-8">Quotes (vrij te citeren)</h2>
      <div class="space-y-6">
        {quotes.map((q) => (
          <blockquote class="card p-6 bg-white border-l-4 border-brand-indigo">
            <p class="text-lg text-slate-700 leading-relaxed italic mb-4">"{q.text}"</p>
            <footer class="text-sm text-slate-500">— <strong>{q.author}</strong>, {q.role}</footer>
          </blockquote>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-slate-50/60 border-y border-slate-200">
    <div class="container-page max-w-4xl">
      <h2 class="text-2xl lg:text-3xl font-bold text-navy mb-8">Logos &amp; merkrichtlijnen</h2>
      <div class="grid sm:grid-cols-2 gap-4">
        <div class="card p-6 bg-white">
          <div class="bg-white border border-slate-200 rounded-lg p-8 flex items-center justify-center mb-4 h-32">
            <img src="/brand/logo-horizontal-light.svg" alt="Aanloop AI logo (lichte achtergrond)" width="200" height="62" />
          </div>
          <p class="text-sm font-medium text-navy mb-2">Logo — lichte achtergrond</p>
          <a href="/brand/logo-horizontal-light.svg" download class="text-xs text-brand-indigo hover:underline">Download SVG</a>
        </div>
        <div class="card p-6 bg-white">
          <div class="bg-midnight rounded-lg p-8 flex items-center justify-center mb-4 h-32">
            <img src="/brand/logo-horizontal-dark.svg" alt="Aanloop AI logo (donkere achtergrond)" width="200" height="62" />
          </div>
          <p class="text-sm font-medium text-navy mb-2">Logo — donkere achtergrond</p>
          <a href="/brand/logo-horizontal-dark.svg" download class="text-xs text-brand-indigo hover:underline">Download SVG</a>
        </div>
      </div>
      <p class="text-xs text-slate-500 mt-6">Gebruik onze logos zoals geleverd, zonder kleurwijzigingen of vervorming. Voor verdere merkvragen: pers@aanloopai.nl.</p>
    </div>
  </section>

  <section class="section">
    <div class="container-page max-w-4xl">
      <h2 class="text-2xl lg:text-3xl font-bold text-navy mb-6">Brand-kleuren</h2>
      <p class="text-slate-600 mb-6 text-sm">Gebruik onze huiskleuren wanneer u Aanloop AI in een artikel of presentatie afbeeldt. Geen alternatieve hex-codes; geen gradients gemixt met andere brand-elementen.</p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {brandColors.map((c) => (
          <div class="card p-5 bg-white border border-slate-200">
            <div class="rounded-lg h-16 mb-3 border border-slate-200" style={`background:${c.hex}`}></div>
            <p class="font-semibold text-navy text-sm">{c.name}</p>
            <p class="font-mono text-xs text-slate-500 mb-2">{c.hex}</p>
            <p class="text-xs text-slate-600 leading-snug">{c.usage}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-slate-50/60 border-y border-slate-200">
    <div class="container-page max-w-3xl">
      <h2 class="text-2xl lg:text-3xl font-bold text-navy mb-6">Factsheet (kopieerbaar)</h2>
      <p class="text-slate-600 text-sm mb-4">Acht bullet-feiten voor in een artikel-sidebar of factsheet-rij. Vrij te citeren met bronvermelding "Aanloop AI".</p>
      <ul class="space-y-2 list-disc pl-5 text-slate-700 text-sm leading-relaxed">
        {factsheetLines.map((line) => (<li>{line}</li>))}
      </ul>
      <p class="text-xs text-slate-500 mt-6">Een uitgebreide PDF-versie sturen wij op aanvraag — mail <a href="mailto:pers@aanloopai.nl" class="text-brand-indigo underline">pers@aanloopai.nl</a>.</p>
    </div>
  </section>

  <section class="section">
    <div class="container-page max-w-3xl text-center">
      <h2 class="text-2xl lg:text-3xl font-bold text-navy mb-4">Plan een interview</h2>
      <p class="text-slate-600 mb-8">Mustafa Agah Dogan (oprichter & CEO) is beschikbaar voor interviews, podcasts en achtergrondgesprekken over AI in het Nederlandse MKB. Reactietijd: gemiddeld binnen 4 uur op werkdagen.</p>
      <div class="flex flex-wrap justify-center gap-3">
        <a href="mailto:pers@aanloopai.nl" class="btn-primary">pers@aanloopai.nl</a>
        <a href="/team/magahdogan/" class="btn-outline">Over Mustafa Agah Dogan</a>
      </div>
    </div>
  </section>
</BaseLayout>
