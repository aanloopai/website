---
import BaseLayout from '../../layouts/BaseLayout.astro';

const faqItems = [
  { question: 'Wanneer is Marco Lite (€249/mnd) genoeg, en wanneer moet ik direct naar Starter?', answer: 'Marco Lite is voldoende als u onder de 50 binnenkomende gesprekken per maand zit, geen CRM-koppeling nodig hebt en een standaard branche-script (algemene FAQ + agenda) acceptabel is. Bovenstaande situatie geldt voor de meeste ZZP\'ers, kleine horeca, single-locatie makelaars en ZZP-juridisch. Zodra u boven de 50 gesprekken/mnd komt, eigen scripting wilt of CRM-integratie nodig hebt, is Starter (€597/mnd) cost-effective omdat overscope-fees vervallen.' },
  { question: 'Wat is het verschil tussen Emma Lite (€49/mnd) en Emma Standard (€197/mnd)?', answer: 'Emma Lite is gelimiteerd tot 500 berichten per maand met standaard FAQ-training en NL/EN auto-detect. Emma Standard heeft onbeperkte berichten, eigen kennisbank-import, native koppelingen met Shopify/WooCommerce/Magento/HubSpot/Pipedrive, multilingual NL/EN/FR/DE en handover-protocol naar uw team. Voor budget-MKB die wil testen: Lite. Voor productie-webshop of omnichannel KS: Standard.' },
  { question: 'Verlies ik data of script-aanpassingen als ik later upgrade van Lite naar Starter?', answer: 'Nee. Lite-data (gesprekstranscripts, lead-info, agenda-koppeling) blijft volledig behouden bij upgrade. Het standaard script wordt vervangen door uw maatwerk-script tijdens de Starter-onboarding (1-uur intake). Pro-rata facturatie: u betaalt alleen het verschil voor de resterende factuurperiode. Geen migratie-fees, geen downtime.' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Marco Lite of Starter? Wanneer Lite-Tier Genoeg Is voor MKB',
  alternateName: ['AI receptionist Lite Nederland', 'WhatsApp AI agent Lite MKB', 'AI telefoon 50 gesprekken'],
  description: 'Beslis-hulp voor Nederlandse MKB: wanneer is Marco Lite (€249/mnd, 50 gesprekken) of Emma Lite (€49/mnd, 500 berichten) genoeg, en wanneer moet u direct naar Starter of Standard upgraden?',
  author: {
    '@type': 'Person',
    '@id': 'https://aanloopai.nl/over-ons/#mustafa-agah-dogan',
    name: 'Mustafa Agah Dogan',
    jobTitle: 'Oprichter & AI-strateeg',
    url: 'https://aanloopai.nl/over-ons/',
    worksFor: { '@id': 'https://aanloopai.nl/#organization' },
  },
  publisher: {
    '@type': 'Organization',
    '@id': 'https://aanloopai.nl/#organization',
    name: 'Aanloop AI',
    url: 'https://aanloopai.nl',
    logo: { '@type': 'ImageObject', url: 'https://aanloopai.nl/logo-mark-light-1024.png' },
  },
  datePublished: '2026-05-15',
  dateModified: '2026-05-21',
  inLanguage: 'nl-NL',
  articleSection: 'AI Prijzen & ROI',
  url: 'https://aanloopai.nl/kennisbank/marco-emma-lite-genoeg-mkb-2026/',
  mainEntityOfPage: { '@type': 'WebPage', '@id': 'https://aanloopai.nl/kennisbank/marco-emma-lite-genoeg-mkb-2026/' },
};
---

<BaseLayout
  title="Marco Lite of Starter? Wanneer Lite Genoeg Is — MKB 2026"
  description="Beslis-hulp voor het MKB: wanneer is Marco Lite (€249/mnd) of Emma Lite (€49/mnd) genoeg? Decision-tree, 4 case-types en upgrade-pad uitgelegd."
  schema={schema}
  faqSchema={faqItems}
>
  <section class="border-b border-slate-200 hero-gradient">
    <div class="container-page py-16 lg:py-20">
      <div class="max-w-3xl">
        <div class="flex items-center gap-4 mb-6">
          <div class="accent-band"><span></span><span></span><span></span><span></span></div>
          <span class="eyebrow">Kennisbank · Beslis-hulp</span>
        </div>
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tightest text-navy text-balance leading-[1.08] reveal reveal-delay-1">
          Marco Lite of Starter?<br/>Wanneer Lite Genoeg Is voor uw MKB
        </h1>
        <p class="mt-6 text-lg text-slate-600 leading-relaxed reveal reveal-delay-2">
          Marco Lite (€249/mnd, 50 gesprekken, geen setup) en Emma Lite (€49/mnd, 500 berichten) zijn nieuwe instap-pakketten. Maar wanneer is Lite écht genoeg, en wanneer betaalt u zich rijk aan overscope-fees? Vijf vragen, vier case-types, één upgrade-pad.
        </p>
        <div class="mt-6 flex flex-wrap items-center gap-4 text-sm text-slate-500">
          <span>📅 15 mei 2026</span>
          <span>·</span>
          <span>⏱ 6 min leestijd</span>
          <span>·</span>
          <span>✍️ Mustafa Agah Dogan</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page max-w-3xl mx-auto">

      <div class="bg-brand-indigo/5 border-l-4 border-brand-indigo rounded-r-xl p-6 mb-10">
        <p class="text-sm font-bold text-brand-indigo uppercase tracking-wide mb-2">Direct Antwoord</p>
        <p class="text-sm text-slate-700">
          <strong>Marco Lite (€249/mnd)</strong> is genoeg als u <strong>onder 50 gesprekken/maand</strong> zit, geen CRM-koppeling nodig hebt en een standaard branche-script acceptabel is. <strong>Emma Lite (€49/mnd)</strong> is genoeg als u onder 500 WhatsApp-berichten/mnd zit en geen eigen kennisbank-import nodig hebt. Boven die grenzen: upgrade naar Starter (€597/mnd) of Emma Standard (€197/mnd) wordt cost-effective.
        </p>
      </div>

      <h2 class="text-2xl font-bold text-navy mt-10 mb-6">Beslis-tree: 5 vragen voor Marco Lite vs Starter</h2>
      <p class="text-slate-700 leading-relaxed mb-6">
        Als u op alle 5 vragen "ja" zegt, is Marco Lite waarschijnlijk genoeg. Bij 1 of meer "nee" wordt Starter cost-effective omdat de overscope-fees of feature-gaps de meerprijs van €348/mnd al snel overschrijden.
      </p>

      <ol class="space-y-4 mb-10">
        {[
          { n: 1, q: 'Krijgt u onder de 50 binnenkomende gesprekken per maand?', y: 'Lite (50 gesprekken inbegrepen)', no: 'Starter (150 gesprekken) of Groei (onbeperkt)' },
          { n: 2, q: 'Is een standaard branche-script genoeg, zonder uw eigen scripting?', y: 'Lite (standaard script)', no: 'Starter (1 callscript op maat) of Groei (3 op maat)' },
          { n: 3, q: 'Heeft u géén CRM-integratie nodig (HubSpot, Pipedrive, etc.)?', y: 'Lite (geen CRM)', no: 'Groei (CRM inbegrepen)' },
          { n: 4, q: 'Wilt u eerst de AI testen voordat u commitment maakt?', y: 'Lite (geen setup-fee, makkelijk uitstappen)', no: 'Starter (€495 setup, maar volledige onboarding)' },
          { n: 5, q: 'Is een reactie binnen 48 uur op support voldoende?', y: 'Lite (< 48 uur SLA)', no: 'Starter (< 24 uur) of Groei (< 4 uur prioriteit)' },
        ].map(item => (
          <li class="flex gap-4 bg-white border border-slate-200 rounded-xl p-5">
            <div class="flex-shrink-0 w-8 h-8 rounded-full bg-brand-indigo text-white text-sm font-bold flex items-center justify-center">{item.n}</div>
            <div class="flex-1">
              <p class="font-semibold text-navy mb-2">{item.q}</p>
              <div class="grid sm:grid-cols-2 gap-3 text-sm">
                <div class="bg-brand-emerald/5 border border-brand-emerald/20 rounded-lg p-3">
                  <p class="text-[11px] font-bold text-brand-emerald uppercase tracking-wide mb-1">Ja →</p>
                  <p class="text-slate-700">{item.y}</p>
                </div>
                <div class="bg-amber-50 border border-amber-100 rounded-lg p-3">
                  <p class="text-[11px] font-bold text-amber-700 uppercase tracking-wide mb-1">Nee →</p>
                  <p class="text-slate-700">{item.no}</p>
                </div>
              </div>
            </div>
          </li>
        ))}
      </ol>

      <h2 class="text-2xl font-bold text-navy mt-12 mb-6">4 Typische Case-types</h2>

      <div class="space-y-6 mb-10">
        {[
          {
            type: 'Horeca lunch-only restaurant',
            calls: '~25 reserveringsvragen/mnd buiten openingstijd',
            advice: 'Marco Lite (€249/mnd)',
            why: 'Standaard reserverings-script werkt; volume laag; geen CRM-behoefte; live binnen 5 dgn = perfect voor laagseizoen-test.',
          },
          {
            type: 'ZZP juridisch (1-persoon advocatenpraktijk)',
            calls: '~30 inkomende intake-gesprekken/mnd',
            advice: 'Marco Lite (€249/mnd) — start, upgrade naar Starter wanneer toelichting AVG/conflict-of-interest gewenst',
            why: 'Lage volume; standaard intake-script (naam, dossier-type, urgentie) volstaat; AVG-handle gaat via standaard escalatie. Bij groei naar 50+ intakes/mnd → Starter voor maatwerk-script.',
          },
          {
            type: 'Single-locatie makelaar (1-2 personen)',
            calls: '~80 lead-aanvragen/mnd, eigen criteria voor lead-kwalificatie',
            advice: 'Direct Starter (€597/mnd)',
            why: 'Volume al boven Lite-cap (50); lead-kwalificatie criteria vereisen maatwerk-callscript; makelaar wint snel terug via meer geconverteerde leads. Lite zou na 1 maand al overscope-warning geven.',
          },
          {
            type: 'Klein webshop (<200 orders/mnd)',
            calls: 'Telefoon: 10/mnd · WhatsApp: 300/mnd order-status vragen',
            advice: 'Emma Lite (€49/mnd) standalone — geen Marco nodig',
            why: 'Telefoon-volume verwaarloosbaar; WhatsApp dominant kanaal; 300 berichten ruim onder Lite-cap (500). Standaard FAQ "waar is mijn pakket" werkt voor 80% vragen. Bij groei naar 600+ msgs of native Shopify-koppeling nodig → Emma Standard (€197/mnd).',
          },
        ].map(c => (
          <div class="bg-slate-50 border border-slate-200 rounded-xl p-5">
            <p class="text-sm font-bold text-navy mb-1">{c.type}</p>
            <p class="text-xs text-slate-500 mb-3">{c.calls}</p>
            <div class="bg-white border border-brand-indigo/30 rounded-lg p-3 mb-2">
              <p class="text-[11px] font-bold text-brand-indigo uppercase tracking-wide mb-1">Advies</p>
              <p class="text-sm font-semibold text-navy">{c.advice}</p>
            </div>
            <p class="text-xs text-slate-600 leading-relaxed"><strong>Waarom:</strong> {c.why}</p>
          </div>
        ))}
      </div>

      <p class="text-sm text-slate-600 leading-relaxed mb-6">Emma maakt gebruik van de <a href="https://developers.facebook.com/docs/whatsapp/cloud-api/" target="_blank" rel="external noopener noreferrer" class="text-brand-indigo underline hover:text-navy">WhatsApp Business Cloud API van Meta</a>; de Meta-conversatiekosten worden los van het Aanloop-abonnement afgerekend volgens de <a href="https://developers.facebook.com/docs/whatsapp/pricing/" target="_blank" rel="external noopener noreferrer" class="text-brand-indigo underline hover:text-navy">officiële WhatsApp-prijzen</a>.</p>

      <h2 class="text-2xl font-bold text-navy mt-12 mb-6">Emma Lite vs Emma Standard</h2>
      <div class="overflow-x-auto mb-10">
        <table class="w-full text-sm border-collapse bg-white rounded-xl border border-slate-200 overflow-hidden">
          <thead>
            <tr class="bg-slate-50 border-b border-slate-200">
              <th class="text-left py-3 px-4 text-slate-500 font-medium">Feature</th>
              <th class="text-center py-3 px-4 font-bold text-navy">Emma Lite<br/><span class="text-xs font-normal text-slate-400">€49/mnd</span></th>
              <th class="text-center py-3 px-4 font-bold text-navy bg-navy/5">Emma Standard<br/><span class="text-xs font-normal text-slate-400">€197/mnd</span></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {[
              ['Berichten/maand', '500', 'Onbeperkt'],
              ['FAQ-training', 'Standaard branche', 'Eigen kennisbank import'],
              ['Productcatalogus', '—', 'Volledig'],
              ['Native Shopify/WooCommerce/Magento', '—', '✓'],
              ['CRM-koppeling (HubSpot/Pipedrive)', '—', '✓'],
              ['Multilingual', 'NL/EN', 'NL/EN/FR/DE (ES/IT/PL op aanvraag)'],
              ['Handover-protocol naar team', 'Basis', 'Volledig configureerbaar'],
              ['Meta Business API verificatie', '✓', '✓'],
              ['AVG-compliant + EU-data', '✓', '✓'],
              ['Setup-fee', 'Geen', 'Op offerte'],
            ].map(([f, lite, std]) => (
              <tr>
                <td class="py-2.5 px-4 text-slate-700 font-medium">{f}</td>
                <td class="py-2.5 px-4 text-center text-slate-600">{lite}</td>
                <td class="py-2.5 px-4 text-center text-navy font-medium bg-navy/5">{std}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h2 class="text-2xl font-bold text-navy mt-12 mb-4">Upgrade-pad: Lite → Starter zonder verlies</h2>
      <p class="text-slate-700 leading-relaxed mb-4">
        Een veel gestelde vraag: "wat als ik later wil upgraden — moet ik dan opnieuw beginnen?" Antwoord: nee. Lite-tiers zijn ontworpen als instap met volledig migratie-pad:
      </p>
      <ul class="list-disc list-inside text-slate-700 space-y-2 mb-8 pl-4">
        <li><strong>Data behoud:</strong> alle gesprekstranscripts, lead-info en agenda-koppelingen blijven bij upgrade. Geen export/import-stap.</li>
        <li><strong>Pro-rata facturatie:</strong> u betaalt alleen het verschil voor de resterende factuurperiode (geen dubbele setup, geen jaarcontract-boete).</li>
        <li><strong>Script-migratie:</strong> standaard Lite-script wordt vervangen door uw maatwerk-script tijdens de 1-uur Starter-intake.</li>
        <li><strong>Geen downtime:</strong> upgrade gebeurt overnacht — Marco/Emma blijft live met het laatste script tot de nieuwe versie wordt geactiveerd.</li>
        <li><strong>Termijn:</strong> upgrade-aanvraag binnen 1 werkdag verwerkt, volledig actief binnen 5 werkdagen (Starter onboarding-tijd).</li>
      </ul>

      <div class="bg-gradient-to-br from-brand-indigo/10 via-white to-brand-emerald/10 border border-brand-indigo/20 rounded-2xl p-8 mt-10">
        <h3 class="text-xl font-bold text-navy mb-3">Klaar om te starten?</h3>
        <p class="text-sm text-slate-700 mb-5">
          Lite-tiers zijn maandelijks opzegbaar zonder setup-fee. Test 1 maand, schaal omhoog wanneer u meer nodig hebt.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="/aanvragen/?plan=lite" class="btn-primary text-sm">Start Marco Lite (€249/mnd)<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></a>
          <a href="/aanvragen/?plan=emma-lite" class="btn-primary text-sm">Start Emma Lite (€49/mnd)<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></a>
          <a href="/tarieven/#tco" class="btn-outline text-sm">Bereken uw 5-jaars TCO</a>
        </div>
      </div>

      <div class="mt-12 pt-8 border-t border-slate-200">
        <p class="text-sm font-bold text-navy mb-3">Lees verder</p>
        <ul class="space-y-2 text-sm">
          <li>→ <a href="/tarieven/" class="text-brand-indigo hover:underline">Volledig tarieven-overzicht (Marco + Emma + AI-Website Bundel + SEO/GEO)</a></li>
          <li>→ <a href="/diensten/marco/" class="text-brand-indigo hover:underline">Marco — AI Receptionist productdetails</a></li>
          <li>→ <a href="/diensten/emma/" class="text-brand-indigo hover:underline">Emma — WhatsApp AI Agent productdetails</a></li>
          <li>→ <a href="/kennisbank/ai-agent-kosten-mkb/" class="text-brand-indigo hover:underline">Hoeveel kost een AI agent in Nederland (uitgebreid)</a></li>
          <li>→ <a href="/kennisbank/ai-agency-kiezen-mkb-nederland-2026/" class="text-brand-indigo hover:underline">Hoe kies ik een AI-agency? — vergelijkingsgids</a></li>
        </ul>
      </div>

      <div class="mt-8 pt-8 border-t border-slate-200">
        <p class="text-sm font-bold text-navy mb-3">Bronnen en verdere informatie</p>
        <ul class="space-y-2 text-sm text-slate-600">
          <li>→ <a href="https://developers.facebook.com/docs/whatsapp/cloud-api/" target="_blank" rel="external noopener noreferrer" class="text-brand-indigo hover:underline">Meta — WhatsApp Business Cloud API documentatie</a></li>
          <li>→ <a href="https://developers.facebook.com/docs/whatsapp/pricing/" target="_blank" rel="external noopener noreferrer" class="text-brand-indigo hover:underline">Meta — WhatsApp Business prijzen</a></li>
          <li>→ <a href="https://elevenlabs.io/docs/conversational-ai/overview" target="_blank" rel="external noopener noreferrer" class="text-brand-indigo hover:underline">ElevenLabs — Conversational AI documentatie</a></li>
          <li>→ <a href="https://www.autoriteitpersoonsgegevens.nl/themas/algoritmes-ai" target="_blank" rel="external noopener noreferrer" class="text-brand-indigo hover:underline">Autoriteit Persoonsgegevens — Algoritmes &amp; AI</a></li>
        </ul>
      </div>

    </div>
  </section>
</BaseLayout>
