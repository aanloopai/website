---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

// Markdown kennisbank articles — one .md file in src/content/kennisbank/ per
// article. Astro resolves static routes (src/pages/kennisbank/*.astro) before
// this dynamic route, so the 84 existing hand-written articles always win on
// a slug collision. No collision currently exists (verified against
// src/data/kennisbank-articles.ts and src/pages/kennisbank/*.astro).
export async function getStaticPaths() {
  const posts = await getCollection('kennisbank', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

type Props = { post: CollectionEntry<'kennisbank'> };
const { post } = Astro.props;
const { Content } = await post.render();

const dateFmt = (d: Date) => d.toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' });

const pageUrl = new URL(`/kennisbank/${post.slug}/`, Astro.site).toString();

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.published.toISOString(),
  ...(post.data.updated ? { dateModified: post.data.updated.toISOString() } : {}),
  author: { '@type': 'Organization', '@id': 'https://aanloopai.nl/#organization', name: 'Aanloop AI' },
  publisher: {
    '@type': 'Organization',
    name: 'Aanloop AI',
    url: 'https://aanloopai.nl',
    logo: { '@type': 'ImageObject', url: 'https://aanloopai.nl/logo-mark-light-1024.png' },
  },
  mainEntityOfPage: pageUrl,
  inLanguage: 'nl-NL',
  articleSection: post.data.category,
};
---

<BaseLayout title={post.data.title} description={post.data.description} schema={[articleSchema]}>
  <section class="border-b border-slate-200 hero-gradient">
    <div class="container-page py-16 lg:py-20">
      <div class="max-w-3xl">
        <div class="flex items-center gap-4 mb-6 reveal">
          <div class="accent-band"><span></span><span></span><span></span><span></span></div>
          <span class="eyebrow">Kennisbank · {post.data.category}</span>
        </div>
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tightest text-navy text-balance leading-[1.08] reveal reveal-delay-1">
          {post.data.title}
        </h1>
        <p class="mt-6 text-lg text-slate-600 leading-relaxed reveal reveal-delay-2">
          {post.data.excerpt}
        </p>
        <div class="mt-6 flex flex-wrap items-center gap-4 text-sm text-slate-500 reveal reveal-delay-3">
          <span>{dateFmt(post.data.published)}</span>
          {post.data.updated && (<><span>·</span><span>Bijgewerkt {dateFmt(post.data.updated)}</span></>)}
          {post.data.readingMinutes && (<><span>·</span><span>{post.data.readingMinutes} min leestijd</span></>)}
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page">
      <article class="max-w-3xl mx-auto prose-blog">
        <Content />
      </article>
      <div class="max-w-3xl mx-auto mt-12 pt-8 border-t border-slate-200">
        <a href="/kennisbank/" class="text-sm font-medium text-brand-indigo hover:underline">← Terug naar kennisbank</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* No @tailwindcss/typography in this repo — style the rendered markdown explicitly. */
  .prose-blog :global(h2) {
    @apply text-2xl font-bold text-navy mt-10 mb-4;
  }
  .prose-blog :global(h3) {
    @apply text-xl font-bold text-navy mt-8 mb-3;
  }
  .prose-blog :global(p) {
    @apply text-slate-700 leading-relaxed mb-5;
  }
  .prose-blog :global(ul) {
    @apply list-disc pl-6 mb-5 space-y-2 text-slate-700;
  }
  .prose-blog :global(ol) {
    @apply list-decimal pl-6 mb-5 space-y-2 text-slate-700;
  }
  .prose-blog :global(li) {
    @apply leading-relaxed;
  }
  .prose-blog :global(a) {
    @apply text-brand-indigo underline hover:text-navy;
  }
  .prose-blog :global(strong) {
    @apply font-semibold text-navy;
  }
  .prose-blog :global(blockquote) {
    @apply border-l-4 border-brand-indigo bg-brand-indigo/5 rounded-r-xl px-5 py-3 my-6 text-slate-700 italic;
  }
  .prose-blog :global(code) {
    @apply bg-slate-100 text-navy rounded px-1.5 py-0.5 text-sm;
  }
</style>
