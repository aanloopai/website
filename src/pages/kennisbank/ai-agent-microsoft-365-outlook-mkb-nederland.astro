const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'AI agent in Microsoft 365 en Outlook implementeren voor MKB in 8 stappen',
  description: 'Stappenplan om een AI agent op Microsoft 365 en Outlook in te richten voor email-triage, agenda-scheduling, document-Q&A en meeting-notes. Doorlooptijd circa 10 werkdagen voor een team van 5 tot 25 gebruikers.',
  totalTime: 'P10D',
  inLanguage: 'nl-NL',
  step: [
    { '@type': 'HowToStep', position: 1, name: 'Use-cases prioriteren', text: 'Selecteer 2 of 3 use-cases met hoogste ROI: typisch email-triage, agenda-scheduling en meeting-notes. Vermijd te brede scope bij start. Per use-case bepaal succescriteria (bijv. 50 procent minder tijd in inbox per dag, 80 procent meeting-notes auto-gegenereerd).' },
    { '@type': 'HowToStep', position: 2, name: 'Licentie- en architectuur-keuze maken', text: 'Beslis Copilot for Microsoft 365 (30 euro per gebruiker per maand) versus custom Power Automate plus Azure OpenAI versus custom n8n plus Anthropic Claude EU. Voor 5 tot 25 gebruikers met standaard use-cases: Copilot. Voor specifieke flows of full data-sovereignty: custom build via Aanloop AI.' },
    { '@type': 'HowToStep', position: 3, name: 'Tenant-instellingen en data-residentie configureren', text: 'In Microsoft 365 admin center: bevestig EU data residency (Microsoft EU Data Boundary, sinds 2025 volledig actief), schakel Copilot connector toegang in voor SharePoint en OneDrive, configureer Conditional Access policies, beperk welke teams toegang krijgen tijdens pilot.' },
    { '@type': 'HowToStep', position: 4, name: 'Pilot-team selecteren en trainen', text: 'Begin met 3 tot 5 power-users uit verschillende rollen (sales, ops, finance). Geef 1-uurs Nederlandstalige hands-on training: prompt-patronen, hallucinatie-herkenning, escalatie-flow, AI-disclosure naar externe relaties. Geef pilot 2 weken.' },
    { '@type': 'HowToStep', position: 5, name: 'Use-case 1 implementeren — email-triage', text: 'Configureer Outlook Copilot of custom Power Automate flow die binnenkomende mails categoriseert (urgent, normaal, nieuwsbrief, intern), draft-replies maakt voor bekende vraagtypen, en uitzonderingen flagt voor menselijke review. Test 3 dagen, meet tijdwinst.' },
    { '@type': 'HowToStep', position: 6, name: 'Use-case 2 en 3 toevoegen — agenda en meeting-notes', text: 'Agenda: AI agent vindt vrij overlappend slot tussen 2 of meer gebruikers, stelt voor, plant na bevestiging. Meeting-notes: Teams meeting wordt getranscribeerd, action-items en besluiten geextraheerd, samenvatting per email naar deelnemers. Beide use-cases activeren incrementeel.' },
    { '@type': 'HowToStep', position: 7, name: 'AVG-disclaimers en logging inrichten', text: 'In email-handtekening pilot-team: vermelding dat AI ondersteunt bij correspondentie (transparantie naar externe ontvangers, AI Act limited-risk plicht). Logging-laag: elke AI-actie gelogd in Microsoft Purview of custom database voor audit. AI-literacy training voor alle pilot-deelnemers documenteren.' },
    { '@type': 'HowToStep', position: 8, name: 'Roll-out, meten en bijsturen', text: 'Na succesvolle pilot: roll-out in 2 golven (kantoorpersoneel eerst, externe-facing rollen tweede). Maandelijkse review: aantal AI-acties, tijdwinst per gebruiker, fout-frequentie, gebruikers-tevredenheid. Bijsturen op prompts, training en use-case-uitbreidingen.' }],
};

const speakableSchema = { '@context': 'https://schema.org', '@type': 'WebPage', name: 'AI agent voor Microsoft 365 en Outlook — MKB NL 2026', speakable: { '@type': 'SpeakableSpecification', cssSelector: ['h1', '.hero-gradient .max-w-3xl > p'] }, url: 'https://aanloopai.nl/kennisbank/ai-agent-microsoft-365-outlook-mkb-nederland/', inLanguage: 'nl-NL' };

const faqItems = [
  { question: 'Wat doet een AI agent in Microsoft 365 en Outlook concreet?', answer: 'Een AI agent automatiseert repetitieve taken in uw Microsoft-omgeving: email-triage met draft-replies, agenda-scheduling tussen meerdere gebruikers, transcriptie en samenvatting van Teams-meetings, document-Q&A op SharePoint en OneDrive, formules en analyse in Excel, en draft-PowerPoints op basis van prompt. De gebruiker bevestigt of overrulet, AI bespaart tijd op de uitvoering.' },
  { question: 'Wat is het verschil tussen Microsoft Copilot en een custom AI agent?', answer: 'Microsoft Copilot is een ingebakken AI-laag in M365-apps (30 euro per gebruiker per maand), met goede UX maar beperkte aanpasbaarheid. Een custom AI agent op Power Automate of n8n is een eigen workflow die specifiek uw bedrijfsprocessen automatiseert (bijv. CRM-koppeling, branche-specifieke email-classificatie, custom rapportage), volledig op EU-data, met aanpasbare logging. Copilot is sneller live, custom is preciezer en goedkoper bij meer dan 25 gebruikers met specifieke use-cases.' },
  { question: 'Blijft mijn data binnen de EU als ik Copilot voor Microsoft 365 gebruik?', answer: 'Ja, sinds 2025 is de Microsoft EU Data Boundary volledig actief: alle Copilot-data van EU-tenants wordt verwerkt op EU-servers (Frankfurt, Amsterdam, Dublin) en niet uitgewisseld met de US. Voor enterprise plans zit dit standaard, voor MKB-business plans handmatig in admin center bevestigen. Alternatief: custom AI agent via Anthropic Claude EU of Azure OpenAI in West-Europe-regio met expliciete EU-only configuratie.' },
  { question: 'Welke ROI levert een AI agent op in een MKB van 10 tot 25 gebruikers?', answer: 'Conservatief: 30 tot 60 minuten per gebruiker per dag tijdwinst op email-triage, agenda en meeting-notes. Bij 20 gebruikers en uurtarief 65 euro: 13.000 tot 26.000 euro per maand winst. Copilot-licentie 30 euro per gebruiker per maand kost 600 euro per maand. Custom AI agent: 4.500 tot 12.000 euro implementatie + 297 tot 597 euro per maand. Terugverdientijd 1 tot 3 maanden bij gemiddelde adoptie.' },
  { question: 'Hoe verhoudt een AI agent in M365 zich tot de EU AI Act?', answer: 'Een Copilot of custom AI agent in M365 valt onder limited risk in de EU AI Act — gebruiker moet weten dat hij met AI werkt. Praktisch: vermelding in email-handtekening of in interne tooling-overview. Geen high-risk plichten zoals conformity assessment, mits AI niet wordt gebruikt voor sollicitatie-screening, kredietbeoordeling of biometrische identificatie. Wel: AI-literacy training voor alle gebruikers verplicht sinds februari 2025.' },
  { question: 'Kan ik een AI agent in Outlook combineren met mijn CRM zoals HubSpot of Salesforce?', answer: 'Ja, via Power Automate of n8n-workflows. Concreet: AI agent leest binnenkomende email, herkent contact-naam, controleert HubSpot voor lead-status, en stelt context-aware draft-reply voor (bijv. inclusief deal-stage en laatste gespreksnotities). Aanloop AI bouwt deze integraties standaard, met EU-only data-flow. Implementatie typisch 5 tot 10 werkdagen na go-live van basis-AI-agent.' },
  { question: 'Wat zijn de grootste fouten bij Copilot of M365 AI-implementatie in MKB?', answer: 'Top 3 fouten: (1) te brede scope ineens uitrollen (start met 2 use-cases, niet 8), (2) geen training en geen prompt-handleiding voor team (gebruikers vinden Copilot dan niet nuttig), (3) gebrek aan AI-disclosure naar externe relaties (kan AVG artikel 13 schenden bij geautomatiseerde correspondentie). Mitigatie: kleine pilot, 1-uurs training met cheatsheet, vermelding in email-handtekening.' },
  { question: 'Wanneer kies ik Copilot for Microsoft 365 versus een Aanloop AI custom agent?', answer: 'Kies Copilot bij: 5 tot 25 gebruikers, standaard use-cases (email, agenda, meeting-notes, Word/Excel-assistentie), korte time-to-value (binnen 1 week live), geen specifieke compliance-eisen. Kies custom Aanloop AI bij: 25+ gebruikers, branche-specifieke automatisering (juridische klacht-routing, accountants-werkbladen, makelaardij-CRM-flow), strikte data-sovereignty (geen Microsoft AI-services), of integratie met niet-Microsoft systemen (Twinfield, AFAS, NMBRS). Hybride is ook mogelijk.' }];
