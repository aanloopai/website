const escalationKeywords = [
  '"koliek" / "rolt over de grond" / "krabt buik" / "kijkt naar flank" → directe spoed (sterfte 30-80% zonder snelle interventie)',
  '"weigert eten" + "geen mest 12u" / "zweet hevig zonder reden" → mogelijk koliek, directe spoed',
