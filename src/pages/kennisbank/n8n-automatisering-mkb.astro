              { titel: '📧 E-mail Auto-beantwoording', uitleg: 'Inkomende e-mails worden automatisch gelezen door GPT-4, gecategoriseerd en beantwoord. Standaardvragen 100% automatisch, complexe vragen gemarkeerd voor u.', tijd: '6 uur/week bespaard' },
              { titel: '📄 Factuurverwerking', uitleg: 'Inkomende facturen (PDF) worden uitgelezen, gecontroleerd en automatisch geboekt in Exact Online of Twinfield. 85% tijdsbesparing op administratie.', tijd: '5 uur/week bespaard' },
              { titel: '💬 WhatsApp → Agenda', uitleg: 'WhatsApp-berichten van klanten worden verwerkt door Emma (AI agent). Afspraakaanvragen worden automatisch ingepland in uw agenda met bevestigingsbericht.', tijd: '3 uur/week bespaard' },
              { titel: '🏪 Webshop → Logistiek', uitleg: 'Nieuwe bestellingen in Shopify/WooCommerce worden automatisch verwerkt: aanmeldingsemail, magazijn-notificatie, facturatie in Exact en track-and-trace via WhatsApp.', tijd: '8 uur/week bespaard' }].map(ex => (
