---
import BaseLayout from '../../layouts/BaseLayout.astro';

const faqItems = [
  { question: 'Wat kost n8n automatisering voor mijn bedrijf?', answer: 'n8n self-hosted is open-source en gratis te gebruiken. De kosten zitten in de implementatie: bij Aanloop AI beginnen n8n workflow automatiseringsprojecten vanaf €1.500 eenmalig voor een standaard workflow, of €1.997/maand voor een volledig beheerde automatiseringsoplossing inclusief onderhoud.' },
  { question: 'Wat is het verschil tussen n8n en Make.com (voorheen Integromat)?', answer: 'n8n is open-source en kan self-hosted worden (uw data verlaat nooit de EU), terwijl Make.com een SaaS-product is met beperkte controle over dataopslag. n8n is technisch complexer maar biedt meer flexibiliteit en is beter voor AVG-compliance in Nederland.' },
  { question: 'Kan ik n8n gebruiken zonder technische kennis?', answer: 'n8n zelf installeren en beheren vereist technische kennis. Aanloop AI neemt dit volledig van u over: wij bouwen, beheren en onderhouden de n8n workflows op basis van uw bedrijfsprocessen. U hoeft niets technisch te doen.' },
  { question: 'Met welke systemen kan n8n worden gekoppeld?', answer: 'n8n heeft 400+ ingebouwde integraties, waaronder Gmail, Outlook, Google Calendar, HubSpot, Pipedrive, Exact Online, Twinfield, Slack, WhatsApp Business API, Shopify en nog honderden andere tools. Custom API-koppelingen zijn ook mogelijk.' },
  { question: 'Is n8n AVG-compliant voor gebruik in Nederland?', answer: 'Ja — mits u n8n self-hosted gebruikt op EU-servers, wat Aanloop AI standaard doet. Data verlaat dan nooit de EU en u heeft volledige controle. Dit is een groot voordeel ten opzichte van cloud-gebaseerde alternatieven als Zapier of Make.com.' }];

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'N8N Workflow Automatisering voor MKB — Gids & Voorbeelden 2026',
  description: 'Wat is n8n en hoe zet u het in voor workflow automatisering in uw MKB? Kosten, voorbeelden en vergelijking met Make.com. AVG-compliant in Nederland.',
  author: { '@type': 'Person', name: 'Daan Verhoeven', '@id': 'https://aanloopai.nl/team/daan-verhoeven/#person', url: 'https://aanloopai.nl/team/daan-verhoeven/', jobTitle: 'Oprichter & CEO Aanloop AI', sameAs: ['https://www.linkedin.com/in/daanverhoeven/'], worksFor: { '@type': 'Organization', '@id': 'https://aanloopai.nl/#organization', name: 'Aanloop AI' } },
  publisher: { '@type': 'Organization', name: 'Aanloop AI', url: 'https://aanloopai.nl', logo: { '@type': 'ImageObject', url: 'https://aanloopai.nl/logo-mark-light-1024.png' } },
  datePublished: '2026-03-06',
  dateModified: '2026-04-19',
  wordCount: 2000,
  inLanguage: 'nl-NL',
  articleSection: 'AI per Sector',
  wordCount: 2000,
};

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'n8n self-hosted opzetten voor MKB workflow-automatisering',
  description: 'Stap-voor-stap: VPS provisioneren, n8n installeren, AVG-compliant configureren, eerste workflow opzetten. Doorlooptijd 5-10 werkdagen.',
  totalTime: 'P10D',
  estimatedCost: { '@type': 'MonetaryAmount', currency: 'EUR', value: '1500' },
  inLanguage: 'nl-NL',
  step: [
    { '@type': 'HowToStep', position: 1, name: 'EU-VPS provisioneren', text: 'VPS bij Hetzner (Falkenstein) of TransIP (Amsterdam) — minimaal 2 vCPU, 4 GB RAM, 40 GB SSD. Kosten 10-25 euro per maand.' },
    { '@type': 'HowToStep', position: 2, name: 'n8n via Docker installeren', text: 'Docker en Docker Compose installeren. n8n image pullen, persistentstorage en PostgreSQL configureren. SSL via Caddy of Traefik reverse proxy.' },
    { '@type': 'HowToStep', position: 3, name: 'AVG-compliant configuratie', text: 'Bewaartermijn voor execution-data instellen (30 dagen standaard). Encryption-at-rest activeren. Backup-schema inrichten met retention 90 dagen, EU-locatie.' },
    { '@type': 'HowToStep', position: 4, name: 'Eerste use-case: e-mail naar CRM', text: 'Workflow opzetten: nieuwe e-mail in inbox triggert AI-classificatie, extractie van naam en bedrijf, automatische opvoer in HubSpot of Pipedrive met label.' },
    { '@type': 'HowToStep', position: 5, name: 'Tweede use-case: factuur-OCR', text: 'PDF in inbox triggert OCR-extractie, AI-validatie, automatisch boeken in Exact Online of Moneybird. Twijfel-flag voor menselijke review.' },
    { '@type': 'HowToStep', position: 6, name: 'Monitoring en uitbreiding', text: 'Wekelijks dashboard met execution-count, failures, gemiddelde duur. Maandelijks nieuwe workflow toevoegen op basis van bedrijfsbehoefte.' }],
};
---

<BaseLayout
  title="N8N Workflow Automatisering voor MKB — Gids 2026"
  description="Wat is n8n en hoe gebruikt u het voor workflow automatisering in uw bedrijf? Kosten, AVG-compliance en hoe Aanloop AI het voor u beheert."
  schema={[articleSchema, howToSchema]}
  faqSchema={faqItems}
>
  <section class="border-b border-slate-200 hero-gradient">
    <div class="container-page py-16 lg:py-20">
      <div class="max-w-3xl">
        <div class="flex items-center gap-4 mb-6 reveal">
          <div class="accent-band"><span></span><span></span><span></span><span></span></div>
          <span class="eyebrow">Kennisbank · Workflow Automatisering</span>
        </div>
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tightest text-navy text-balance leading-[1.08] reveal reveal-delay-1">
          N8N Workflow Automatisering<br />voor MKB — Complete Gids 2026
        </h1>
        <p class="mt-6 text-lg text-slate-600 leading-relaxed reveal reveal-delay-2">
          n8n is de krachtigste open-source workflow automatiseringstool voor bedrijven die AVG-compliant willen automatiseren. Aanloop AI gebruikt n8n als fundament voor alle workflow oplossingen.
