                  <th class="text-center py-3 px-3 font-semibold text-brand-indigo">n8n</th>
                  <th class="text-center py-3 px-3 font-semibold text-slate-500">Make.com</th>
                  <th class="text-center py-3 px-3 font-semibold text-slate-500">Zapier</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                {[
                  ['Open-source', '✅', '❌', '❌'],
                  ['Self-hosted (AVG)', '✅ NL servers', '❌ Cloud', '❌ Cloud'],
                  ['Prijs (basis)', 'Gratis (self-hosted)', '€9/mnd', '€20/mnd'],
                  ['Integraties', '400+', '1000+', '5000+'],
                  ['AI/LLM native', '✅ Direct', '⚠️ Beperkt', '⚠️ Beperkt'],
                  ['Technisch niveau', 'Hoog (of beheerd)', 'Medium', 'Laag'],
                  ['Aanpasbaar', '⭐⭐⭐⭐⭐', '⭐⭐⭐', '⭐⭐']].map(([k, n, m, z]) => (
