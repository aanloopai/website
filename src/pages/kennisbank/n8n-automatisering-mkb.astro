                  <div>
                    <p class="font-bold text-navy text-sm mb-1">{ex.titel}</p>
                    <p class="text-sm text-slate-600">{ex.uitleg}</p>
                  </div>
                  <div class="bg-brand-emerald/10 rounded-lg px-3 py-1 flex-shrink-0">
                    <span class="text-xs font-semibold text-brand-emerald whitespace-nowrap">{ex.tijd}</span>
