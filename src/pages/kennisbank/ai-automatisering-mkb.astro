                  ['Beschikbaarheid', 'Ma–vr 9–17u', '24/7 · 365 dagen'],
                  ['Geschatte netto besparing', '—', '€1.800–€3.000/mnd'],
                  ['Terugverdientijd', '—', '3–6 maanden']].map(([p, z, m]) => (
