---
import BaseLayout from '../../layouts/BaseLayout.astro';
const faqItems = [
  { question: 'Kan AI echt mijn facturen verwerken?', answer: 'Ja. Moderne AI (met name LLM-modellen in combinatie met OCR) kan facturen lezen, leveranciersnamen extraheren, bedragen herkennen, btw-percentages berekenen en data importeren in uw boekhoudpakket. Aanloop AI bouwt dit met n8n en AI-extracitetools.' },
  { question: 'Met welke boekhoudpakketten werkt AI factuurautomatisering?', answer: 'Aanloop AI koppelt AI factuurverwerking met Exact Online, Snelstart, Moneybird, Twinfield, AFAS, QuickBooks en Xero. Via een API-koppeling of n8n-integratie.' },
  { question: 'Hoe nauwkeurig is AI bij factuurverwerking?', answer: 'Moderne AI factuurverwerking haalt 97-99% nauwkeurigheid op gestructureerde facturen. Ongestructureerde facturen (handgeschreven of slecht opgemaakt) scoren iets lager. Twijfelgevallen worden automatisch geflagd voor menselijke review.' },
  { question: 'Is AI factuurverwerking AVG-compliant?', answer: 'Ja, mits correct geconfigureerd. Aanloop AI gebruikt n8n self-hosted, waardoor factuurdata uitsluitend op uw eigen server wordt verwerkt — in Nederland. Er worden geen gegevens naar buitenlandse AI-providers gestuurd.' },
  { question: 'Hoeveel kost AI factuurautomatisering?', answer: 'AI factuurautomatisering is onderdeel van een custom workflow via Aanloop AI. Kosten starten vanaf €4.500 eenmalig voor implementatie + €597/maand voor beheer en monitoring. De terugverdientijd is typisch 2-4 maanden.' }];
const schema = { '@context': 'https://schema.org', '@type': 'Article', headline: 'Hoe Automatiseer je Je Facturering met AI? (Stap-voor-Stap Gids)', author: { '@type': 'Person', '@id': 'https://aanloopai.nl/over-ons/#mustafa-agah-dogan', name: 'Mustafa Agah Dogan', jobTitle: 'Oprichter & AI-strateeg', url: 'https://aanloopai.nl/over-ons/', worksFor: { '@id': 'https://aanloopai.nl/#organization' } }, publisher: { '@type': 'Organization', name: 'Aanloop AI', url: 'https://aanloopai.nl', logo: { '@type': 'ImageObject', url: 'https://aanloopai.nl/logo-mark-light-1024.png' } }, datePublished: '2025-12-21', dateModified: '2026-05-21', inLanguage: 'nl-NL', articleSection: 'Finance & AI' };
---
<BaseLayout title="Hoe Automatiseer je Je Facturering met AI? (Stap-voor-Stap)" description="Leer hoe u uw factuurverwerking automatiseert met AI en n8n. Van PDF-extractie tot automatisch boeken in Exact Online. AVG-compliant, stap-voor-stap uitgelegd." schema={[schema]} faqSchema={faqItems}>
  <section class="border-b border-slate-200 hero-gradient">
    <div class="container-page py-16 lg:py-20">
      <div class="max-w-3xl">
        <div class="flex items-center gap-4 mb-6"><div class="accent-band"><span></span><span></span><span></span><span></span></div><span class="eyebrow">Kennisbank · AI Automation</span></div>
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tightest text-navy text-balance leading-[1.08] reveal reveal-delay-1">Hoe Automatiseer je Je<br/>Facturering met AI?</h1>
        <p class="mt-6 text-lg text-slate-600 leading-relaxed reveal reveal-delay-2">Stop met handmatig facturen verwerken. Met AI en n8n automatiseert u het volledige factuurproces — van PDF-ontvangst tot boeking in uw boekhoudpakket. Stap-voor-stap uitgelegd.</p>
        <div class="mt-6 flex flex-wrap items-center gap-4 text-sm text-slate-500"><span>📅 7 mei 2026</span><span>·</span><span>⏱ 6 min leestijd</span><span>·</span><span>✍️ Aanloop AI Redactie</span></div>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container-page max-w-3xl mx-auto">
      <div class="bg-brand-indigo/5 border-l-4 border-brand-indigo rounded-r-xl p-6 mb-10">
        <p class="text-sm font-bold text-brand-indigo uppercase tracking-wide mb-2">Direct Antwoord</p>
        <p class="text-sm text-slate-700">AI factuurautomatisering werkt in 5 stappen: (1) factuur ontvangen (e-mail/upload), (2) AI extraheert data (leverancier, bedrag, btw, datum), (3) validatie tegen inkooporders, (4) automatisch boeken in boekhoudpakket, (5) betaalopdracht aanmaken. Met n8n self-hosted blijft alle data in Nederland.</p>
      </div>

      <h2 class="text-2xl font-bold text-navy mt-10 mb-4">Stap-voor-Stap: AI Factuurverwerking Opzetten</h2>
      <div class="space-y-4 mb-8">
        {[
          { n: '1', t: 'Factuur Ontvangen', d: 'De workflow monitort een specifiek e-mailadres (bijv. facturen@uwbedrijf.nl) of een uploadmap. Zodra een factuur binnenkomt (PDF, Word, foto), wordt de workflow getriggerd.', tools: ['n8n Email trigger', 'Gmail/Outlook integratie'] },
          { n: '2', t: 'Data Extraheren met AI', d: 'Een AI-model (GPT-4o of Claude) leest de factuur en extraheert: leveranciersnaam, factuurnummer, datum, bedragen (excl./incl. btw), btw-percentage, IBAN en betaaltermijn.', tools: ['OpenAI GPT-4o', 'Claude API', 'n8n AI node'] },
          { n: '3', t: 'Valideren & Matchen', d: 'De workflow vergelijkt de factuurdata met openstaande inkooporders in uw systeem. Klopt alles? Doorsturen voor goedkeuring. Discrepantie? Flag voor menselijke review.', tools: ['n8n conditional logic', 'ERP/CRM koppeling'] },
          { n: '4', t: 'Automatisch Boeken', d: 'Bij goedkeuring boekt de workflow de factuur automatisch in uw boekhoudpakket op de juiste grootboekrekening met de juiste btw-code.', tools: ['Exact Online API', 'Moneybird API', 'Snelstart API'] },
          { n: '5', t: 'Betaalopdracht Aanmaken', d: 'Optioneel: de workflow maakt een betaalopdracht aan voor goedkeuring in uw bankportaal. U hoeft alleen nog te autoriseren.', tools: ['SEPA betaalbestand', 'Bankintegratie'] }].map(s => (
          <div class="bg-white border border-slate-200 rounded-xl p-5">
            <div class="flex items-start gap-4">
              <span class="w-8 h-8 rounded-full bg-brand-indigo text-white flex items-center justify-center font-bold text-sm flex-shrink-0">{s.n}</span>
              <div class="flex-1">
                <p class="font-bold text-navy text-sm mb-1">{s.t}</p>
                <p class="text-sm text-slate-600 mb-3">{s.d}</p>
                <div class="flex flex-wrap gap-2">
                  {s.tools.map(t => <span class="text-xs bg-slate-100 text-slate-600 px-2 py-0.5 rounded-full">{t}</span>)}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <h2 class="text-2xl font-bold text-navy mt-10 mb-4">Resultaten bij Nederlandse Bedrijven</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
        {[
          { n: '85%', l: 'Tijdsbesparing', d: 'op factuurverwerking' },
          { n: '< 0.5%', l: 'Foutenpercentage', d: 'vs 5-10% handmatig' },
          { n: '€1.800', l: 'Besparing/maand', d: 'gemiddeld bij MKB' }].map(s => (
          <div class="bg-slate-50 border border-slate-200 rounded-xl p-5 text-center">
            <p class="text-3xl font-bold text-navy mb-1">{s.n}</p>
            <p class="text-sm font-medium text-slate-600">{s.l}</p>
            <p class="text-xs text-slate-400">{s.d}</p>
          </div>
        ))}
      </div>

      <h2 class="text-2xl font-bold text-navy mt-10 mb-4">Bronnen en verdere informatie</h2>
      <p class="text-sm text-slate-600 leading-relaxed mb-4">AI-factuurverwerking raakt aan fiscale bewaarplicht, AVG en de EU AI Act. Hieronder de officiele bronnen voor verdere verdieping.</p>
      <ul class="space-y-2 text-sm text-slate-700 mb-8">
        <li>&middot; <a href="https://www.belastingdienst.nl/wps/wcm/connect/bldcontentnl/belastingdienst/zakelijk/btw/administratie_bijhouden/administratie_bewaren/administratie_bewaren" target="_blank" rel="noopener noreferrer external" class="text-brand-indigo underline hover:text-navy">Belastingdienst &mdash; bewaarplicht administratie</a> &mdash; wettelijke bewaartermijn van 7 jaar voor facturen en boekhouding.</li>
        <li>&middot; <a href="https://www.autoriteitpersoonsgegevens.nl/themas/basis-avg/avg-algemeen" target="_blank" rel="noopener noreferrer external" class="text-brand-indigo underline hover:text-navy">Autoriteit Persoonsgegevens &mdash; AVG algemeen</a> &mdash; verwerking van leveranciers- en klantgegevens in factuurdata.</li>
        <li>&middot; <a href="https://digital-strategy.ec.europa.eu/en/policies/regulatory-framework-ai" target="_blank" rel="noopener noreferrer external" class="text-brand-indigo underline hover:text-navy">EU AI Act &mdash; Europese Commissie</a> &mdash; transparantieplicht voor AI-systemen die documenten verwerken.</li>
        <li>&middot; <a href="https://www.nba.nl/" target="_blank" rel="noopener noreferrer external" class="text-brand-indigo underline hover:text-navy">NBA &mdash; Koninklijke Nederlandse Beroepsorganisatie van Accountants</a> &mdash; beroepsregels rond geautomatiseerde administratie.</li>
      </ul>

      <div class="bg-slate-50 border border-slate-200 rounded-xl p-6 mb-8">
        <p class="text-sm font-bold text-navy mb-3">Lees ook</p>
        <ul class="space-y-2">
          <li><a href="/kennisbank/ai-workflow-automation/" class="text-sm text-brand-indigo hover:underline">AI Workflow Automation: Complete Uitleg voor Beginners →</a></li>
          <li><a href="/kennisbank/n8n-vs-make-com/" class="text-sm text-brand-indigo hover:underline">n8n vs Make.com vs Zapier: Welke is het Beste voor MKB? →</a></li>
          <li><a href="/sectoren/accountancy/" class="text-sm text-brand-indigo hover:underline">AI voor Accountants en Administratiekantoren →</a></li>
        </ul>
      </div>

      <h2 class="text-2xl font-bold text-navy mt-10 mb-6">Veelgestelde Vragen</h2>
      <div class="space-y-3 mb-8">
        {faqItems.map(item => (
          <details class="card group">
            <summary class="flex items-center justify-between cursor-pointer list-none">
              <span class="text-sm font-bold text-navy pr-6">{item.question}</span>
              <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <p class="mt-4 text-sm text-slate-600 leading-relaxed">{item.answer}</p>
          </details>
        ))}
      </div>
      <div class="border-t border-slate-200 pt-8 flex items-start gap-4">
        <div class="w-12 h-12 rounded-full bg-brand-indigo/10 flex items-center justify-center flex-shrink-0"><span class="text-xl">🤖</span></div>
        <div><p class="font-bold text-navy text-sm">Aanloop AI Redactie</p><p class="text-xs text-slate-500 mt-0.5">KVK: 56312075 · Rotterdam, Nederland.</p></div>
      </div>
    </div>
  </section>
  <!-- Sector relevance -->
  <section class="section-tight border-t border-slate-200">
    <div class="container-page max-w-4xl">
      <p class="eyebrow mb-3">Relevant voor uw sector</p>
      <h2 class="text-2xl lg:text-3xl font-bold tracking-tighter-2 text-navy text-balance mb-6">
        Concrete AI-toepassingen per branche.
      </h2>
      <p class="text-slate-600 leading-relaxed mb-6">
        Bekijk hieronder sector-specifieke pagina's met case examples, prijzen en use cases voor uw branche.
      </p>
      <div class="flex flex-wrap gap-2">
        <a href="/sectoren/horeca/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-slate-50 hover:bg-slate-100 border border-slate-200 hover:border-slate-300 rounded-lg text-sm font-medium text-navy transition-all">AI voor horeca →</a>
        <a href="/sectoren/accountancy/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-slate-50 hover:bg-slate-100 border border-slate-200 hover:border-slate-300 rounded-lg text-sm font-medium text-navy transition-all">AI voor accountancy →</a>
        <a href="/sectoren/ai-voor-advocaten/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-slate-50 hover:bg-slate-100 border border-slate-200 hover:border-slate-300 rounded-lg text-sm font-medium text-navy transition-all">AI voor advocaten →</a>
        <a href="/sectoren/vastgoed/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-slate-50 hover:bg-slate-100 border border-slate-200 hover:border-slate-300 rounded-lg text-sm font-medium text-navy transition-all">AI voor vastgoed →</a>
        <a href="/sectoren/zorg/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-slate-50 hover:bg-slate-100 border border-slate-200 hover:border-slate-300 rounded-lg text-sm font-medium text-navy transition-all">AI voor zorg →</a>
        <a href="/sectoren/ai-voor-zzp/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-slate-50 hover:bg-slate-100 border border-slate-200 hover:border-slate-300 rounded-lg text-sm font-medium text-navy transition-all">AI voor ZZP →</a>
        <a href="/sectoren/ai-voor-webshops/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-slate-50 hover:bg-slate-100 border border-slate-200 hover:border-slate-300 rounded-lg text-sm font-medium text-navy transition-all">AI voor webshops →</a>
        <a href="/sectoren/bouw/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-slate-50 hover:bg-slate-100 border border-slate-200 hover:border-slate-300 rounded-lg text-sm font-medium text-navy transition-all">AI voor bouw →</a>
        <a href="/sectoren/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-brand-indigo/5 hover:bg-brand-indigo/10 border border-brand-indigo/20 rounded-lg text-sm font-medium text-brand-indigo transition-all">Alle sectoren →</a>
      </div>
    </div>
  </section>

  <section class="section-tight bg-midnight text-pearl relative overflow-hidden">
    <div class="absolute inset-0 dot-grid opacity-[0.04]"></div>
    <div class="container-page relative max-w-3xl">
      <h2 class="text-3xl font-bold tracking-tightest text-pearl text-balance reveal">Automatiseer uw factuurverwerking</h2>
      <p class="mt-4 text-slate-300 reveal reveal-delay-1">Aanloop AI bouwt en beheert uw AI factuurworkflow. Plan een gratis scan voor een concreet voorstel.</p>
      <div class="mt-6 flex flex-col sm:flex-row gap-3 reveal reveal-delay-2">
        <a href="/gratis-ai-scan/" class="btn bg-pearl text-navy hover:bg-white text-base px-6 py-3.5">Gratis AI Scan aanvragen<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></a>
        <a href="/diensten/custom/" class="btn border border-slate-700 text-pearl hover:bg-slate-800 text-base px-6 py-3.5">Custom AI workflows</a>
      </div>
    </div>
  </section>
</BaseLayout>
