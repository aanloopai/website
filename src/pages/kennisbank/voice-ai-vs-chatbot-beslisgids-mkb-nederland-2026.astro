const sectorRecommendations = [
  { sector: 'Zorg (huisarts, fysio, tandarts)',       prio: 'Voice AI prio', rationale: 'Telefoon dominant — spoedoproepen, afspraken inplannen, herinneringsbelletjes. Combo bij hoog WhatsApp-volume.', product: 'Marco + optioneel Emma' },
  { sector: 'Webshop (e-commerce)',                   prio: 'Chatbot AI prio', rationale: 'WhatsApp/website dominant — productvragen, bestelstatus, retour, cart-recovery. Voice optioneel bij hoge klantenservice-escalaties.', product: 'Emma + optioneel Marco' },
  { sector: 'Tandarts',                               prio: 'Combo (aanbevolen)', rationale: 'Telefoon voor afspraken en spoed, WhatsApp voor patienten-vragen over behandelingen, kosten en verzekeraar.', product: 'Marco + Emma' },
  { sector: 'Accountantskantoor',                     prio: 'Voice AI prio', rationale: 'Telefoon dominant — klanten bellen voor deadlines, vragen over aangifte, afspraken. WhatsApp-volume doorgaans laag.', product: 'Marco + optioneel Emma' },
  { sector: 'Advocatenkantoor',                       prio: 'Combo (aanbevolen)', rationale: 'Telefoon voor urgente juridische vragen en intake, WhatsApp voor documentdoorgifte en statusupdates bij lopende zaken.', product: 'Marco + Emma' },
  { sector: 'Restaurant / horeca',                    prio: 'Combo (aanbevolen)', rationale: 'Telefoon voor reserveringen en spoedinformatie, WhatsApp voor menu-vragen, allergenen-informatie en bevestigingen.', product: 'Marco + Emma' },
  { sector: 'Pedicure / schoonheidssalon / kapper',  prio: 'Voice AI prio', rationale: 'Oudere klantdemografie telefoon-dominant. Afspraakinplannen en no-show-recall zijn de primaire use-cases.', product: 'Marco (eventueel Emma na 6 mnd)' },
  { sector: 'Logistiek / transport',                  prio: 'Chatbot AI prio', rationale: 'Track-trace vragen, leveringsstatus, afwijkingen asynchroon via WhatsApp afhandelen past bij het operationele ritme in de sector.', product: 'Emma + optioneel Marco' },
];

const roadmapPhases = [
  {
    phase: 'Fase 1: Kies het hoogste-volume-kanaal',
    tijdlijn: 'Week 1-3',
    body: 'Analyseer uw inkomende contacten van de afgelopen 3 maanden: hoeveel calls, hoeveel WhatsApp-berichten, hoeveel website-chat-vragen? Kies het kanaal met het hoogste volume als startpunt. Voor solo-MKB en teams tot 5 personen: typisch Voice AI als telefoon dominant is. Voor webshops en horeca: typisch chatbot. Onboarding-analyse identificeert top-10 vragen en top-5 escalaties zodat de configuratie direct op uw echte situatie is gericht.',
  },
  {
    phase: 'Fase 2: Live-gang en eerste stabilisatie',
    tijdlijn: 'Week 4-8',
    body: 'Het eerste kanaal gaat live op 25-35 procent van het verkeer. Dagelijkse monitoring van escalatie-rate, conversie, klanttevredenheid en kennisbank-gaps. Aanpassingen worden wekelijks doorgevoerd. Na 4 weken volledig live op primair kanaal. KPI-rapport na 30 dagen toont concrete resultaten: lead-conversie, no-show-reductie, tijdsbesparing. Dit vormt ook het business-case fundament voor het tweede kanaal.',
  },
  {
    phase: 'Fase 3: Tweede kanaal toevoegen (combo-upgrade)',
    tijdlijn: 'Maand 3-6 (solo MKB) of direct (multi-locatie)',
    body: 'Solo-MKB en kleine teams: zodra het eerste kanaal stabiel loopt (escalatie-rate onder 15 procent, lead-conversie stabiel), start de integratie van het tweede kanaal. De bestaande kennisbank is herbruikbaar — tweede implementatie duurt 40-60 procent korter. Multi-locatie-bedrijven en organisaties met aantoonbaar hoog volume op beide kanalen starten direct met de combo om consistentie over alle locaties te garanderen.',
  },
