      "name": "Aanloop AI",
      "url": "https://aanloopai.nl"
    },
    "publisher": {
      "@type": "Organization",
      "name": "Aanloop AI",
      "logo": {
        "@type": "ImageObject",
        "url": "https://aanloopai.nl/logo-mark-light-1024.png"
      }
    },
    "datePublished": "2026-04-30",
    "dateModified": "2026-04-30",
    "mainEntityOfPage": "https://aanloopai.nl/kennisbank/ai-voor-tandartspraktijk-nederland/",
    "inLanguage": "nl-NL"
  };

const faqItems = [
  { question: 'Werkt de AI met Exquise, Oasys, Simplex?', answer: 'Ja. Native koppelingen voor Exquise, Oasys, Simplex, Easy Dental NL en Yacedo.' },
  { question: 'Hoe nauwkeurig zijn de AI-prijsindicaties?', answer: 'De AI geeft prijsindicaties op basis van uw vooraf vastgelegde UPT-tarieven 2026. Definitieve behandelplan blijft verantwoordelijkheid van de tandarts.' },
  { question: 'Hoe groot is de no-show reductie?', answer: 'Cases tonen 50-65% no-show reductie binnen 6 maanden, van gemiddeld 12-18% naar 4-6%.' },
  { question: 'Spreekt de AI vloeiend Nederlands?', answer: 'Ja, met natuurlijke prosodie. Engels, Duits, Frans, Spaans op aanvraag voor toeristische gebieden.' },
  { question: 'Wat doet de AI bij een spoedgeval?', answer: 'Urgentie-keywords triggeren directe escalatie naar de waarnemende tandarts of dienst.' },
  { question: 'Wat kost AI voor een Nederlandse tandartspraktijk?', answer: 'Marco Starter: 297 euro per maand. Marco Groei plus Emma WhatsApp plus PMS-koppeling: 897 euro per maand.' },
  { question: 'Hoe snel ben ik live?', answer: '10-14 werkdagen voor solo-praktijk. 21-30 dagen voor multi-stoel praktijk.' },
