const faqItems = [
  { question: 'Werkt de AI met FysioRoadmap, Intramed of Spider?', answer: 'Ja. Native koppelingen voor FysioRoadmap, Intramed, Spider Webware, Winmens, Ifysio en custom EPD via REST API.' },
  { question: 'Voldoet AI aan NEN 7510 en AVG voor fysiotherapie?', answer: 'Ja. Aanloop AI biedt een NEN 7510-compatibele opzet met dedicated tenant per praktijk, ISO 27001-gecertificeerde EU-cloud.' },
  { question: 'Hoe groot is de no-show reductie?', answer: 'Cases tonen 60-70% no-show reductie binnen 6 maanden, van gemiddeld 10-15% naar 3-5%.' },
  { question: 'Kan AI zorgverzekering-vragen beantwoorden?', answer: 'Ja. Met koppeling aan uw verzekeraarsdatabase geeft AI directe antwoorden op vergoeding, eigen risico en machtiging.' },
