---
import BaseLayout from '../../layouts/BaseLayout.astro';

const today = new Date().toISOString().split('T')[0];

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'AI voor Bouwbedrijven: offertes en planning op autopilot',
  description: 'AI automatisering voor Nederlandse bouw- en installatiebedrijven: offerte-aanvragen 24/7 verwerken, monteurs slim routeren, storingsmeldingen direct geëscaleerd.',
  author: { '@type': 'Person', name: 'Daan Verhoeven', '@id': 'https://aanloopai.nl/team/daan-verhoeven/#person', url: 'https://aanloopai.nl/team/daan-verhoeven/', jobTitle: 'Oprichter & CEO Aanloop AI', sameAs: ['https://www.linkedin.com/company/aanloop-ai', 'https://www.linkedin.com/in/daanverhoeven/'], worksFor: { '@type': 'Organization', '@id': 'https://aanloopai.nl/#organization', name: 'Aanloop AI' } },
  publisher: { '@type': 'Organization', name: 'Aanloop AI', logo: { '@type': 'ImageObject', url: 'https://aanloopai.nl/logo-mark-light-1024.png' } },
  datePublished: today,
  dateModified: today,
  mainEntityOfPage: 'https://aanloopai.nl/kennisbank/ai-bouwbedrijf-offerte-automatisering/',
  inLanguage: 'nl-NL',
};

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'Offerte- en planningsautomatisering opzetten voor bouw- en installatiebedrijf',
  description: 'Stap-voor-stap: AI receptionist + WhatsApp koppelen aan uw planning, offerte-flow voor standaard-klussen, monteur-routering. Doorlooptijd circa 10 werkdagen.',
  totalTime: 'P10D',
  estimatedCost: { '@type': 'MonetaryAmount', currency: 'EUR', value: '297' },
  inLanguage: 'nl-NL',
  step: [
    { '@type': 'HowToStep', position: 1, name: 'Standaard-klussen definieren', text: 'Lijst opstellen van klustypes onder 5.000 euro (CV-onderhoud, kleine reparaties, ketelvervangingen) met vaste prijsranges en intake-vragen.' },
    { '@type': 'HowToStep', position: 2, name: 'Spoed-keywords en escalatie-flow', text: 'Lekkage, stroomstoring, breuk, spoed triggeren SMS plus telefoon naar bereikbaarheidsdienst-monteur. Bij geen reactie binnen 5 minuten escalatie naar tweede monteur en eigenaar.' },
    { '@type': 'HowToStep', position: 3, name: 'Werkbonsysteem koppelen', text: 'Native koppelingen: Bouwsoft, NetBau, Werkbon, AFAS, Exact. Custom systemen via REST API. Tweezijdige sync.' },
    { '@type': 'HowToStep', position: 4, name: 'Foto en plattegrond-flow', text: 'Klanten sturen fotos, videos en pdfs via WhatsApp. AI valideert, slaat op en koppelt aan offerte-aanvraag. Complexe technische tekeningen escaleren naar specialist.' },
    { '@type': 'HowToStep', position: 5, name: 'Vakjargon trainen', text: 'Onboarding met voorbeelden van CV-installaties, dakwerk, elektra, sanitair, metselwerk. AI leert uw specifieke terminologie en spreekt klantvriendelijk Nederlands.' },
    { '@type': 'HowToStep', position: 6, name: 'Pilot avond- en weekenddienst', text: '7-10 dagen alleen avond- en weekenduren live. KPI-monitoring (deflection, escalatie, CSAT) wekelijks.' },
    { '@type': 'HowToStep', position: 7, name: 'Volledig 24/7 live', text: 'Na pilot uitrollen op alle inkomende telefonie en WhatsApp. Maandelijkse rapportage en kennisbank-aanvullingen.' },
  ],
};

const faqItems = [
  { question: 'Werkt AI met mijn werkbon-systeem of planning-software?', answer: 'Ja. Native koppelingen voor Bouwsoft, NetBau, Werkbon, AFAS, Exact en custom systemen via REST API. Tijdens onboarding configureren we de tweezijdige sync zodat AI-data direct in uw planning landt.' },
  { question: 'Kan de AI tekeningen of plattegronden ontvangen via WhatsApp?', answer: 'Ja. Klanten kunnen fotos, videos en pdfs sturen — de AI valideert, slaat op en koppelt aan de offerte-aanvraag in uw systeem. Voor complexe technische tekeningen escaleert de AI automatisch naar een specialist.' },
  { question: 'Hoe handelt de AI urgente storingsmeldingen af?', answer: 'Volgens uw protocol. We configureren keywords (lekkage, stroomstoring, breuk, spoed) die direct triggeren naar de bereikbaarheidsdienst-monteur via SMS plus telefoon. Bij geen reactie binnen 5 minuten escalatie naar tweede monteur plus eigenaar.' },
  { question: 'Wat kost AI voor een Nederlands bouwbedrijf?', answer: 'Marco Starter (24/7 receptionist + offerte-intake): 297 euro per maand. Marco Groei (onbeperkt + WhatsApp + werkbon-koppeling): 497 euro per maand. Enterprise voor multi-team bouwbedrijven met meerdere vestigingen op maat.' },
  { question: 'Hoe snel ben ik live met AI in mijn bouwbedrijf?', answer: 'Standaard 7-10 werkdagen. Onboarding-vragenlijst, training met monteurs-skills en escalatieprotocol, werkbonsysteem-koppeling, testronde met echte scenarios.' },
  { question: 'Spreekt de AI vakjargon van de bouw?', answer: 'Ja, na training. Tijdens onboarding leveren we voorbeelden van CV-installaties, dakwerk, elektra, sanitair en metselwerk. De AI leert uw specifieke terminologie. Voor technisch complexe vragen escaleert de AI naar de juiste vakman.' },
];
---

<BaseLayout
  title="AI Bouwbedrijf — Offerte-Automatisering & Servicemonteur Routing voor MKB | Aanloop AI"
  description="AI automatisering voor Nederlandse bouw- en installatiebedrijven: offerte-aanvragen 24/7 verwerken, monteurs slim routeren, storingsmeldingen direct geëscaleerd. Vanaf 297 euro per maand."
  schema={[articleSchema, howToSchema]}
  faqSchema={faqItems}
>
  <section class="border-b border-slate-200 hero-gradient">
    <div class="container-page py-16 lg:py-24">
      <div class="max-w-3xl">
        <div class="flex items-center gap-3 mb-6">
          <div class="accent-band"><span></span><span></span><span></span><span></span></div>
          <span class="eyebrow">Kennisbank · Bouw</span>
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tightest text-navy text-balance leading-[1.05]">
          AI voor Bouwbedrijven: offertes en planning op autopilot
        </h1>
        <p class="mt-6 text-lg lg:text-xl text-slate-600 leading-relaxed text-pretty">
          Een gemiddeld Nederlands bouwbedrijf verliest jaarlijks 15-25% van inkomende offerte-aanvragen door gemiste telefoongesprekken, vergeten WhatsApp-berichten en monteurs die niet bereikt kunnen worden voor spoedklussen. AI automatisering lost deze drie kernproblemen op.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page max-w-3xl">
      <h2 class="text-2xl lg:text-3xl font-bold tracking-tightest text-navy text-balance mb-6">1. Offerte-aanvragen 24/7 aannemen + structureren</h2>
      <p class="text-slate-600 leading-relaxed mb-4">De meeste offerte-aanvragen komen s avonds binnen — particulieren denken aan hun verbouwing na het werk. Een AI agent neemt deze gesprekken aan, vraagt om de essentials (locatie, type werk, gewenste planning, budget-indicatie, contactpersoon) en stuurt de gestructureerde aanvraag direct naar uw werkbon-systeem (Bouwsoft, NetBau, eigen systeem) of CRM.</p>
      <p class="text-slate-600 leading-relaxed mb-4">Resultaat: u krijgt s ochtends 3-7 nieuwe gestructureerde leads in plaats van een chaotische telefoonlijst. De aanname van offerte-aanvragen wordt 100% — niemand krijgt een voicemail meer.</p>
    </div>
  </section>

  <section class="section bg-slate-50/60 border-y border-slate-200">
    <div class="container-page max-w-3xl">
      <h2 class="text-2xl lg:text-3xl font-bold tracking-tightest text-navy text-balance mb-6">2. Planning monteurs zonder telefoon-pingpong</h2>
      <p class="text-slate-600 leading-relaxed mb-4">Klassiek probleem: kantoor probeert monteur Jan te bereiken voor een spoedklus, Jan zit in de bestelbus, niemand neemt op. AI agent koppelt aan de planning van uw werkbonsysteem en stelt direct alternatieve monteurs voor op basis van locatie, type werk en beschikbaarheid.</p>
      <p class="text-slate-600 leading-relaxed mb-4">Voor grotere bouwbedrijven met multi-team setups: AI voorkomt dat een loodgieter naar een elektriciteitsklus wordt gestuurd door automatische skill-matching uit uw monteursprofielen.</p>
    </div>
  </section>

  <section class="section">
    <div class="container-page max-w-3xl">
      <h2 class="text-2xl lg:text-3xl font-bold tracking-tightest text-navy text-balance mb-6">3. Storingsmeldingen routing naar de juiste servicemonteur</h2>
      <p class="text-slate-600 leading-relaxed mb-4">Bij storingen (lekkage, stroomstoring, breuk) is snelheid kritiek. Een AI receptionist herkent urgente meldingen via keyword-detectie en escalatieprotocollen en routeert direct naar de bereikbaarheidsdienst van dienst — buiten kantooruren naar de wacht-monteur. Bij geen reactie binnen 5 minuten: escalatie naar een tweede monteur en SMS-notificatie naar de eigenaar.</p>
      <p class="text-slate-600 leading-relaxed mb-4">Dit voorkomt schade-claims van klanten die uren moesten wachten en helpt servicecontracten 24/7 na te leven.</p>
    </div>
  </section>

  <section class="section bg-slate-50/60 border-y border-slate-200">
    <div class="container-page max-w-3xl">
      <h2 class="text-2xl lg:text-3xl font-bold tracking-tightest text-navy text-balance mb-6">4. WhatsApp-updates voor planning en oplevering</h2>
      <p class="text-slate-600 leading-relaxed mb-4">Klanten in de bouwsector willen geïnformeerd worden — wanneer komen de monteurs, hoe laat zijn ze klaar, wat is de status van hun offerte? Een AI WhatsApp bot stuurt automatisch updates: onze monteur Jan is om 09:30 onderweg, werk is klaar factuur volgt, of uw offerte is verzonden geldig tot 14 dagen. Dit reduceert klantvragen met 60-70%.</p>
      <p class="text-slate-600 leading-relaxed mb-4">Koppeling met Mollie of iDEAL voor directe online betaling van facturen via WhatsApp-link mogelijk.</p>
    </div>
  </section>

  <section class="section">
    <div class="container-page max-w-3xl">
      <h2 class="text-2xl lg:text-3xl font-bold tracking-tightest text-navy text-balance mb-6">5. Factuurverwerking en garantie-aanvragen automatiseren</h2>
      <p class="text-slate-600 leading-relaxed mb-4">Inkomende factuurvragen (waar is mijn offerte gebleven, kan ik in termijnen betalen, wat valt onder garantie) worden door een AI agent automatisch beantwoord op basis van uw factuur-systeem. Voor garantie-aanvragen: de AI controleert of de klacht binnen de garantieperiode valt, vraagt fotos op via WhatsApp en plant indien nodig een herstelafspraak in.</p>
      <p class="text-slate-600 leading-relaxed mb-4">Dit haalt circa 40-50% van eerstelijns-klantcontact bij uw administratie weg, waardoor uw team zich op grote offertes kan focussen.</p>
    </div>
  </section>

  <section class="section bg-slate-50/60 border-y border-slate-200">
    <div class="container-page max-w-3xl">
      <p class="eyebrow mb-3">ROI rekenvoorbeeld</p>
      <h2 class="text-2xl lg:text-3xl font-bold tracking-tightest text-navy text-balance mb-6">Wat levert dit u op?</h2>
      <p class="text-slate-600 leading-relaxed">Voor een bouwbedrijf met 8-25 monteurs: 4.000-12.000 euro per maand extra omzet (15-25% meer offerteconversie + 30% minder no-shows + minder schade-claims door snellere storingsescalatie). Investering vanaf 297 euro per maand voor Marco Starter, of 897 euro per maand voor het complete Marco + Emma + werkbon-koppeling pakket. Break-even meestal binnen 2-4 weken.</p>
    </div>
  </section>

  <section class="section">
    <div class="container-page max-w-3xl">
      <p class="eyebrow mb-3">Veelgestelde vragen</p>
      <h2 class="text-2xl lg:text-3xl font-bold tracking-tightest text-navy text-balance mb-8">FAQ AI Bouwbedrijf</h2>
      <div class="space-y-3">
        {faqItems.map(item => (
          <details class="group card cursor-pointer">
            <summary class="flex items-start justify-between gap-4 list-none">
              <h3 class="text-base font-semibold text-navy pr-4">{item.question}</h3>
              <svg class="w-5 h-5 flex-shrink-0 text-slate-400 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <p class="mt-3 text-sm text-slate-600 leading-relaxed">{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight border-t border-slate-200">
    <div class="container-page max-w-4xl">
      <p class="eyebrow mb-3">Verder lezen</p>
      <h2 class="text-2xl lg:text-3xl font-bold tracking-tighter-2 text-navy text-balance mb-6">AI-bronnen voor uw bouwbedrijf.</h2>
      <div class="flex flex-wrap gap-2">
        <a href="/sectoren/bouw/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-brand-indigo/5 hover:bg-brand-indigo/10 border border-brand-indigo/20 rounded-lg text-sm font-medium text-brand-indigo transition-all">AI voor bouw (volledige hub) →</a>
        <a href="/diensten/marco/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-slate-50 hover:bg-slate-100 border border-slate-200 rounded-lg text-sm font-medium text-navy transition-all">Marco AI Receptionist →</a>
        <a href="/diensten/emma/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-slate-50 hover:bg-slate-100 border border-slate-200 rounded-lg text-sm font-medium text-navy transition-all">Emma WhatsApp Bot →</a>
        <a href="/sectoren/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-slate-50 hover:bg-slate-100 border border-slate-200 rounded-lg text-sm font-medium text-navy transition-all">Alle sectoren →</a>
      </div>
    </div>
  </section>

  <section class="section-tight bg-midnight text-pearl relative overflow-hidden">
    <div class="absolute inset-0 dot-grid opacity-[0.04]"></div>
    <div class="container-page relative max-w-3xl">
      <h2 class="text-3xl font-bold tracking-tightest text-pearl text-balance reveal">Klaar om uw bouwbedrijf 24/7 bereikbaar te maken?</h2>
      <p class="mt-4 text-slate-300 reveal reveal-delay-1">Plan een gratis demo van 30 minuten. We laten u zien hoe AI werkt met uw exacte werkbonsysteem en monteurs-planning.</p>
      <div class="mt-6 flex flex-col sm:flex-row gap-3 reveal reveal-delay-2">
        <a href="/demo-aanvragen/" class="btn bg-pearl text-navy hover:bg-white text-base px-6 py-3.5">Plan een demo</a>
        <a href="/tarieven/" class="btn border border-slate-700 text-pearl hover:bg-slate-800 text-base px-6 py-3.5">Bekijk tarieven</a>
      </div>
    </div>
  </section>
</BaseLayout>
