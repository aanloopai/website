const faqItems = [
  { question: 'Wat is het verschil tussen AI receptionist en AI telefoniste?', answer: 'AI receptionist is gestandaardiseerd voor afsprakenbeheer en lead-kwalificatie (Marco). AI telefoniste is gefocust op klantcontact en customer service (Emma).' },
  { question: 'Wanneer kies ik AI telefoonassistent in plaats van AI receptionist?', answer: 'AI telefoonassistent is voor grotere organisaties (25+ medewerkers) met meerdere afdelingen, IVR-menus en complexe routing.' },
