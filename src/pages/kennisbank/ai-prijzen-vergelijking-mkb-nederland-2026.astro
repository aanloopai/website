            <p class="text-xs text-slate-500 mb-3">investering: {s.investering}</p>
            <p class="text-xs text-slate-600 leading-relaxed mb-3">{s.toelichting}</p>
            <p class="text-xs font-medium text-brand-emerald">Terugverdientijd: {s.terugverdienTijd}</p>
