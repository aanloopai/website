            {[
              { n: '1', t: 'AI Scan', d: 'Analyseer welke processen het meest geschikt zijn voor automatisering. Aanloop AI biedt een gratis scan aan.' },
              { n: '2', t: 'Ontwerp', d: 'Bepaal de use cases, integraties (CRM, agenda, e-mail) en het gewenste gedrag van de agent.' },
              { n: '3', t: 'Bouw', d: 'De agent wordt gebouwd met n8n workflows en ElevenLabs voice AI (indien van toepassing).' },
              { n: '4', t: 'Test & Valideer', d: 'Uitgebreid testen met echte scenario\'s en edge cases voor go-live.' },
              { n: '5', t: 'Go-live', d: 'Live in gemiddeld 7 werkdagen. Continue optimalisatie op basis van data.' },
            ].map(s => (
              <div class="flex gap-4 items-start">
                <span class="w-8 h-8 rounded-full bg-slate-100 text-navy flex items-center justify-center font-bold text-sm flex-shrink-0 border border-slate-200">{s.n}</span>
                <div>
                  <p class="font-bold text-navy text-sm mb-0.5">{s.t}</p>
                  <p class="text-sm text-slate-600">{s.d}</p>
                </div>
              </div>
            ))}
          </div>

          <div class="bg-slate-50 border border-slate-200 rounded-xl p-6 mb-8">
