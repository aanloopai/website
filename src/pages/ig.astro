---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Welkom vanuit Instagram — Aanloop AI';
const description = 'Welkom! Korte intro op Aanloop: AI-automatisering voor NL MKB. Klantenservice-AI, process-automatisering en AI-websites met meetbare ROI.';
---

<BaseLayout title={title} description={description} noindex={true}>
  <section class="min-h-[60vh] flex items-center bg-gradient-to-b from-white to-slate-50">
    <div class="container-page py-16">
      <div class="max-w-3xl mx-auto text-center">

        <p class="text-xs font-semibold tracking-[0.18em] uppercase text-brand-emerald mb-3">
          📸 Welkom vanaf Instagram
        </p>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tightest text-navy text-balance mb-5">
          Aanloop in 60 seconden
        </h1>

        <p class="text-lg text-slate-600 leading-relaxed mb-10 max-w-xl mx-auto">
          Wij bouwen praktische AI-oplossingen voor Nederlandse MKB-bedrijven.
          Drie hoofddiensten, één doel: meetbare resultaten binnen 30–90 dagen.
        </p>

        <div class="grid sm:grid-cols-3 gap-4 text-left mb-10">
          <div class="card bg-white border-slate-200 p-5">
            <p class="text-2xl mb-2">💬</p>
            <p class="font-semibold text-navy mb-1">Klantenservice-AI</p>
            <p class="text-sm text-slate-600">24/7 in het Nederlands. Beantwoordt 60–80% zonder mens.</p>
          </div>
          <div class="card bg-white border-slate-200 p-5">
            <p class="text-2xl mb-2">⚙️</p>
            <p class="font-semibold text-navy mb-1">Process-AI</p>
            <p class="text-sm text-slate-600">Halveert handmatig werk: administratie, planning, offerte.</p>
          </div>
          <div class="card bg-white border-slate-200 p-5">
            <p class="text-2xl mb-2">🌐</p>
            <p class="font-semibold text-navy mb-1">AI-Websites</p>
            <p class="text-sm text-slate-600">Sites + webshops die zelf leads en orders produceren.</p>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row gap-3 justify-center mb-10">
          <a href="/demo-inplannen/?utm_source=ig&utm_medium=landing&utm_campaign=ig-welkom"
             class="btn-primary text-base px-6 py-3">
            Plan gratis 15-min audit
          </a>
          <a href="/cases/?utm_source=ig&utm_medium=landing&utm_campaign=ig-welkom"
             class="btn-outline text-base px-6 py-3">
            Bekijk klantcases
          </a>
        </div>

        <div class="card bg-slate-50 border-slate-200 text-left max-w-xl mx-auto">
          <p class="text-xs font-semibold tracking-[0.12em] uppercase text-slate-400 mb-3">Waarom Aanloop?</p>
          <ul class="space-y-2 text-sm text-slate-700">
            <li>✅ Nederlandse focus — taal, AVG, lokale support</li>
            <li>✅ Vast tarief — geen verrassende rekeningen</li>
            <li>✅ Live binnen 7 werkdagen na akkoord</li>
            <li>✅ Maandelijks opzegbaar — geen lock-in</li>
          </ul>
        </div>

        <p class="mt-8 text-sm text-slate-500">
          Liever direct contact? <a href="/contact/?utm_source=ig&utm_medium=landing" class="underline hover:text-brand-emerald">Stuur een bericht</a>.
        </p>

      </div>
    </div>
  </section>
</BaseLayout>
