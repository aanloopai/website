---
import BaseLayout from '../layouts/BaseLayout.astro';
// Demo inplannen — Cal.com niet vereist, directe WhatsApp + contact form
---
<BaseLayout title="Demo Inplannen: Kies Uw Moment | Aanloop AI" description="Plan uw gratis 30-minuten AI demo direct via WhatsApp of e-mail. Geen externe agenda nodig. Wij reageren binnen 1 werkdag. KVK: 88606902.">
  <section class="border-b border-slate-200 hero-gradient">
    <div class="container-page py-14 lg:py-20">
      <div class="max-w-3xl">
        <div class="flex items-center gap-4 mb-6 reveal"><div class="accent-band"><span></span><span></span><span></span><span></span></div><span class="eyebrow">Demo inplannen</span></div>
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tightest text-navy text-balance leading-[1.08] reveal reveal-delay-1">Kies uw moment</h1>
        <p class="mt-5 text-lg text-slate-600 leading-relaxed reveal reveal-delay-2">Plan een <strong>30-minuten AI demo</strong> — online via Google Meet. We laten zien hoe AI werkt voor uw specifieke situatie. Geen verplichting.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page">
      <div class="grid lg:grid-cols-3 gap-10">

        <!-- Sidebar: wat u kunt verwachten -->
        <div class="lg:col-span-1 reveal">
          <h2 class="text-lg font-bold text-navy mb-5">Wat behandelen we?</h2>
          <ul class="space-y-4 mb-8">
            {[
              { icon: '🎯', t: 'Uw situatie', d: 'Uw processen en grootste uitdagingen.' },
              { icon: '🤖', t: 'Live AI demo', d: 'Een werkende agent — live voor uw ogen.' },
              { icon: '💶', t: 'ROI berekening', d: 'Concrete tijdsbesparing en opbrengst.' },
              { icon: '🗺️', t: 'Stappenplan', d: 'Concreet plan om direct mee te starten.' },
            ].map(i => (
              <li class="flex gap-3">
                <span class="text-xl flex-shrink-0">{i.icon}</span>
                <div><p class="font-semibold text-navy text-sm">{i.t}</p><p class="text-sm text-slate-500 mt-0.5">{i.d}</p></div>
              </li>
            ))}
          </ul>
          <div class="bg-slate-50 border border-slate-200 rounded-xl p-5">
            <p class="text-xs font-bold text-navy uppercase tracking-wide mb-3">Wat u mag verwachten</p>
            <ul class="space-y-2 text-sm text-slate-600">
              {['100% vrijblijvend','30 min, online via Google Meet','Geen verkooppraatje','KVK: 88606902'].map(t=>(
                <li class="flex items-center gap-2"><svg class="w-4 h-4 text-brand-emerald flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>{t}</li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Kies contact methode -->
        <div class="lg:col-span-2 reveal reveal-delay-1">
          <h2 class="text-lg font-bold text-navy mb-6">Hoe wilt u contact opnemen?</h2>

          <div class="space-y-4">
            <!-- WhatsApp — snelste -->
            <a href="https://wa.me/31624741597?text=Hallo%2C%20ik%20wil%20graag%20een%20gratis%20AI%20demo%20inplannen%20bij%20Aanloop%20AI." target="_blank" class="flex items-center gap-5 p-6 bg-white border-2 border-green-200 hover:border-green-400 rounded-2xl transition-all group hover:shadow-md">
              <div class="w-14 h-14 flex-shrink-0 rounded-2xl bg-green-500/10 flex items-center justify-center">
                <svg class="w-7 h-7 text-green-600" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              </div>
              <div class="flex-1">
                <div class="flex items-center gap-2 mb-1">
                  <p class="font-bold text-navy">Via WhatsApp</p>
                  <span class="text-xs px-2 py-0.5 bg-green-100 text-green-700 rounded-full font-medium">Snelste respons</span>
                </div>
                <p class="text-sm text-slate-600">Stuur een WhatsApp-bericht. We reageren binnen 2 uur (ma–vr 9:00–18:00) en plannen direct een moment in.</p>
              </div>
              <svg class="w-5 h-5 text-slate-400 group-hover:text-green-500 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
            </a>

            <!-- E-mail -->
            <a href="mailto:hello@aanloopai.nl?subject=Demo%20aanvragen&body=Hallo%2C%20ik%20wil%20graag%20een%20gratis%20AI%20demo%20inplannen." class="flex items-center gap-5 p-6 bg-white border-2 border-slate-200 hover:border-brand-indigo rounded-2xl transition-all group hover:shadow-md">
              <div class="w-14 h-14 flex-shrink-0 rounded-2xl bg-brand-indigo/10 flex items-center justify-center">
                <svg class="w-7 h-7 text-brand-indigo" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              </div>
              <div class="flex-1">
                <p class="font-bold text-navy mb-1">Via e-mail</p>
                <p class="text-sm text-slate-600">Stuur een e-mail naar <strong>hello@aanloopai.nl</strong>. We reageren binnen 1 werkdag met beschikbare momenten.</p>
              </div>
              <svg class="w-5 h-5 text-slate-400 group-hover:text-brand-indigo transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
            </a>

            <!-- Telefoon -->
            <a href="tel:+31624741597" class="flex items-center gap-5 p-6 bg-white border-2 border-slate-200 hover:border-brand-amber rounded-2xl transition-all group hover:shadow-md">
              <div class="w-14 h-14 flex-shrink-0 rounded-2xl bg-brand-amber/10 flex items-center justify-center">
                <svg class="w-7 h-7 text-brand-amber" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              </div>
              <div class="flex-1">
                <p class="font-bold text-navy mb-1">Telefonisch</p>
                <p class="text-sm text-slate-600"><strong>+31 6 24 74 15 97</strong> — Ma–vr 09:00–17:00. Direct een moment inplannen met een van onze consultants.</p>
              </div>
              <svg class="w-5 h-5 text-slate-400 group-hover:text-brand-amber transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
            </a>

            <!-- Terug naar formulier -->
            <div class="p-5 bg-brand-indigo/5 border border-brand-indigo/20 rounded-2xl">
              <p class="text-sm text-slate-700 mb-3">Of vul het <strong>demo aanvraagformulier</strong> in — dan nemen wij contact op:</p>
              <a href="/demo-aanvragen/" class="btn-primary text-sm">
                Naar het aanvraagformulier
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
