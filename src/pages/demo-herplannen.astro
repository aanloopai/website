---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Demo herplannen" description="Plan uw AI demo opnieuw in op een moment dat beter uitkomt." noindex={true}>
  <section class="section min-h-[70vh] flex items-center">
    <div class="container-page">
      <div class="max-w-2xl mx-auto text-center">
        <div class="w-16 h-16 rounded-full bg-brand-amber/10 flex items-center justify-center mx-auto mb-6 reveal">
          <svg class="w-8 h-8 text-brand-amber" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
          </svg>
        </div>
        <div class="reveal reveal-delay-1">
          <p class="eyebrow text-brand-amber mb-3">Geen probleem!</p>
          <h1 class="text-3xl sm:text-4xl font-bold tracking-tightest text-navy mb-4">Kies een nieuw moment</h1>
          <p class="text-lg text-slate-600 leading-relaxed mb-8">Geen zorgen — kies hieronder een moment dat beter uitkomt. We kijken ernaar uit u te spreken.</p>
        </div>
        <div class="bg-white border border-slate-200 rounded-2xl p-8 mb-6 reveal reveal-delay-2">
          <a href="/demo-inplannen/" class="btn-primary w-full justify-center text-base py-4 mb-4">
            Kies een nieuw moment
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
          <p class="text-sm text-slate-500">Of neem direct contact op:</p>
          <div class="flex flex-col sm:flex-row gap-3 mt-3 justify-center">
            <a href="mailto:hello@aanloopai.nl" class="btn-outline text-sm">hello@aanloopai.nl</a>
            <a href="https://wa.me/31624741597" target="_blank" class="btn-outline text-sm">WhatsApp</a>
          </div>
        </div>
        <a href="/" class="btn-ghost text-sm reveal">Terug naar homepagina</a>
      </div>
    </div>
  </section>
</BaseLayout>
