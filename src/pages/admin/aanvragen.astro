---
// Admin panel — service request queue.
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Aanvragen" active="aanvragen">
  <h1 class="page-title">Aanvragen</h1>
  <p class="page-sub">Wijzigings- en productaanvragen van klanten.</p>

  <div class="mt-5">
    <select id="q-filter" class="pselect" style="width:auto">
      <option value="">Alle statussen</option>
      <option value="open">Open</option>
      <option value="in_behandeling">In behandeling</option>
      <option value="afgerond">Afgerond</option>
      <option value="afgewezen">Afgewezen</option>
    </select>
  </div>

  <div id="q-list" class="mt-5 space-y-3">
    <div class="pskel h-28 w-full"></div>
    <div class="pskel h-28 w-full"></div>
  </div>
  <div id="q-empty" class="pcard mt-5 hidden">
    <div class="empty">
      <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <p class="empty-title">Geen aanvragen</p>
      <p class="empty-text">Er zijn geen aanvragen voor dit filter.</p>
    </div>
  </div>

  <script is:inline>
    (function () {
      var TYPE = {
        upgrade: 'Upgrade', downgrade: 'Downgrade', pause: 'Pauzeren',
        resume: 'Hervatten', new_product: 'Nieuw product', cancel: 'Opzeggen',
      };
      var STATUS = { open: 'pbadge--amber', in_behandeling: 'pbadge--blue', afgerond: 'pbadge--green', afgewezen: 'pbadge--red' };
      function esc(s) {
        return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
        });
      }
      function load() {
        var f = document.getElementById('q-filter').value;
        fetch('/api/admin/requests' + (f ? '?status=' + f : ''), { credentials: 'same-origin' })
          .then(function (r) { if (r.status !== 200) { location.href = '/portal/login'; throw 0; } return r.json(); })
          .then(function (d) {
            var list = d.requests || [];
            var box = document.getElementById('q-list');
            if (!list.length) { box.innerHTML = ''; document.getElementById('q-empty').classList.remove('hidden'); return; }
            document.getElementById('q-empty').classList.add('hidden');
            box.innerHTML = list.map(function (r) {
              var dt = new Date(r.created_at).toLocaleString('nl-NL');
              return '<div class="pcard" data-id="' + esc(r.id) + '"><div class="pcard-b">' +
                '<div class="flex items-center justify-between gap-2"><span class="primary" style="color:var(--p-ink);font-weight:600">' +
                esc(TYPE[r.type] || r.type) + ' — ' + esc(r.bedrijf) + '</span>' +
                '<span class="pbadge ' + (STATUS[r.status] || 'pbadge--gray') + '">' + esc(r.status) + '</span></div>' +
                '<p class="mt-1 text-xs" style="color:var(--p-ink-4)">' + dt + ' · ' + esc(r.user_naam) + ' (' + esc(r.user_email) + ')' +
                (r.product_key ? ' · product: ' + esc(r.product_key) : '') + '</p>' +
                (r.bericht ? '<p class="mt-2 text-sm p-muted">' + esc(r.bericht) + '</p>' : '') +
                '<div class="mt-3 flex flex-wrap items-center gap-2">' +
                '<select class="q-stat pselect" style="width:auto">' +
                ['open', 'in_behandeling', 'afgerond', 'afgewezen'].map(function (s) {
                  return '<option value="' + s + '"' + (s === r.status ? ' selected' : '') + '>' + s + '</option>';
                }).join('') + '</select>' +
                '<input class="q-note pinput flex-1" style="min-width:12rem" placeholder="Interne notitie / reactie" value="' + esc(r.admin_notitie || '') + '" />' +
                '<button class="q-save pbtn pbtn--primary">Opslaan</button>' +
                '</div></div></div>';
            }).join('');
            document.querySelectorAll('#q-list .q-save').forEach(function (b) {
              b.addEventListener('click', function () {
                var box2 = b.closest('[data-id]');
                b.disabled = true;
                fetch('/api/admin/request', {
                  method: 'PATCH', credentials: 'same-origin',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({
                    id: box2.getAttribute('data-id'),
                    status: box2.querySelector('.q-stat').value,
                    admin_notitie: box2.querySelector('.q-note').value.trim(),
                  }),
                }).then(function () { load(); }).catch(function () { b.disabled = false; });
              });
            });
          })
          .catch(function () {});
      }
      document.getElementById('q-filter').addEventListener('change', load);
      load();
    })();
  </script>
</AdminLayout>
