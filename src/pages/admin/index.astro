---
// Admin panel — dashboard. Data: /api/admin/overview.
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Dashboard" active="dashboard">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="page-title">Dashboard</h1>
      <p class="page-sub">Overzicht van klanten, aanvragen en support.</p>
    </div>
    <a href="/admin/klanten" class="pbtn pbtn--primary">Klanten beheren</a>
  </div>

  <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <div class="kpi"><div class="kpi-label">Klanten</div><div class="kpi-value" id="k-klanten"><span class="pskel inline-block h-7 w-10"></span></div></div>
    <div class="kpi"><div class="kpi-label">Actieve diensten</div><div class="kpi-value" id="k-diensten"><span class="pskel inline-block h-7 w-10"></span></div></div>
    <div class="kpi"><div class="kpi-label">Open aanvragen</div><div class="kpi-value" id="k-aanvragen"><span class="pskel inline-block h-7 w-10"></span></div></div>
    <div class="kpi"><div class="kpi-label">Open tickets</div><div class="kpi-value" id="k-tickets"><span class="pskel inline-block h-7 w-10"></span></div></div>
  </div>

  <div class="mt-6 grid gap-6 lg:grid-cols-2">
    <section class="pcard">
      <div class="pcard-h">Vereist aandacht</div>
      <div class="pcard-b">
        <div id="d-attention" class="space-y-2"><div class="pskel h-10 w-full"></div></div>
        <div id="d-attention-empty" class="empty hidden">
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <p class="empty-title">Alles afgehandeld</p>
          <p class="empty-text">Geen open aanvragen of tickets.</p>
        </div>
      </div>
    </section>

    <section class="pcard">
      <div class="pcard-h">Recente activiteit</div>
      <div class="pcard-b">
        <div id="d-activity" class="space-y-3"><div class="pskel h-10 w-full"></div></div>
        <div id="d-activity-empty" class="empty hidden">
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          <p class="empty-title">Nog geen activiteit</p>
          <p class="empty-text">Activiteit verschijnt hier zodra er klanten zijn.</p>
        </div>
      </div>
    </section>
  </div>

  <script is:inline>
    (function () {
      var KIND = { klant: 'pbadge--blue', aanvraag: 'pbadge--amber', wijziging: 'pbadge--gray', ticket: 'pbadge--gray' };
      function esc(s) {
        return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
        });
      }
      fetch('/api/admin/overview', { credentials: 'same-origin' })
        .then(function (r) { if (r.status !== 200) { location.href = '/portal/login'; throw 0; } return r.json(); })
        .then(function (d) {
          var k = d.kpi || {};
          document.getElementById('k-klanten').textContent = k.klanten || 0;
          document.getElementById('k-diensten').textContent = k.actieveDiensten || 0;
          document.getElementById('k-aanvragen').textContent = k.openAanvragen || 0;
          document.getElementById('k-tickets').textContent = k.openTickets || 0;

          var att = d.attention || [];
          var ab = document.getElementById('d-attention');
          if (!att.length) { ab.innerHTML = ''; document.getElementById('d-attention-empty').classList.remove('hidden'); }
          else {
            ab.innerHTML = att.map(function (a) {
              return '<a href="' + esc(a.href) + '" class="flex items-center justify-between rounded-md border px-3 py-2.5 text-sm" style="border-color:var(--p-border)">' +
                '<span style="color:var(--p-ink-2)">' + esc(a.label) + '</span>' +
                '<span class="pbadge ' + (KIND[a.kind] || 'pbadge--gray') + '">' + esc(a.kind) + '</span></a>';
            }).join('');
          }

          var act = d.activity || [];
          var cb = document.getElementById('d-activity');
          if (!act.length) { cb.innerHTML = ''; document.getElementById('d-activity-empty').classList.remove('hidden'); }
          else {
            cb.innerHTML = act.map(function (a) {
              var dt = a.when ? new Date(a.when).toLocaleDateString('nl-NL') : '';
              return '<div class="flex items-start gap-3 text-sm">' +
                '<span class="pbadge ' + (KIND[a.kind] || 'pbadge--gray') + '">' + esc(a.kind) + '</span>' +
                '<span class="flex-1" style="color:var(--p-ink-2)">' + esc(a.label) + '</span>' +
                '<span class="text-xs" style="color:var(--p-ink-4)">' + dt + '</span></div>';
            }).join('');
          }
        })
        .catch(function () {});
    })();
  </script>
</AdminLayout>
