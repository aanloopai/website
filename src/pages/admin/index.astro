---
// Admin panel — dashboard. Data: /api/admin/overview.
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Dashboard" active="dashboard">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="page-title">Dashboard</h1>
      <p class="page-sub">Overzicht van klanten, aanvragen en support.</p>
    </div>
    <a href="/admin/klanten" class="pbtn pbtn--primary">Klanten beheren</a>
  </div>

  <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <div class="kpi"><div class="kpi-label">Klanten</div><div class="kpi-value" id="k-klanten"><span class="pskel inline-block h-7 w-10"></span></div></div>
    <div class="kpi"><div class="kpi-label">Actieve diensten</div><div class="kpi-value" id="k-diensten"><span class="pskel inline-block h-7 w-10"></span></div></div>
    <div class="kpi"><div class="kpi-label">Open aanvragen</div><div class="kpi-value" id="k-aanvragen"><span class="pskel inline-block h-7 w-10"></span></div></div>
    <div class="kpi"><div class="kpi-label">Open tickets</div><div class="kpi-value" id="k-tickets"><span class="pskel inline-block h-7 w-10"></span></div></div>
  </div>

  <div class="mt-4 grid gap-4 sm:grid-cols-2">
    <a href="/admin/pipeline?pipeline=services" class="kpi" style="display:block">
      <div class="kpi-label">Gewogen pipeline (services)</div>
      <div class="kpi-value" id="k-forecast"><span class="pskel inline-block h-7 w-16"></span></div>
    </a>
    <a href="/admin/pipeline" class="kpi" style="display:block">
      <div class="kpi-label">Rottende kaarten</div>
      <div class="kpi-value" id="k-rotting"><span class="pskel inline-block h-7 w-10"></span></div>
    </a>
  </div>

  <div class="mt-6 grid gap-6 lg:grid-cols-2">
    <section class="pcard">
      <div class="pcard-h">Vereist aandacht</div>
      <div class="pcard-b">
        <div id="d-attention" class="space-y-2"><div class="pskel h-10 w-full"></div></div>
        <div id="d-attention-empty" class="empty hidden">
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <p class="empty-title">Alles afgehandeld</p>
          <p class="empty-text">Geen open aanvragen of tickets.</p>
        </div>
      </div>
    </section>

    <section class="pcard">
      <div class="pcard-h">Recente activiteit</div>
      <div class="pcard-b">
        <div id="d-activity" class="space-y-3"><div class="pskel h-10 w-full"></div></div>
        <div id="d-activity-empty" class="empty hidden">
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          <p class="empty-title">Nog geen activiteit</p>
          <p class="empty-text">Activiteit verschijnt hier zodra er klanten zijn.</p>
        </div>
      </div>
    </section>
  </div>

  <section class="pcard mt-6">
    <div class="pcard-h">
      <span>Outreach-funnel</span>
      <a href="/admin/outreach" class="p-link text-sm">Naar outreach →</a>
    </div>
    <div class="pcard-b">
      <div id="d-funnel" class="d-funnel"><div class="pskel h-16 w-full"></div></div>
    </div>
  </section>

  <section class="pcard mt-6">
    <div class="pcard-h">
      <span>Emma AI-verbruik</span>
    </div>
    <div class="pcard-b">
      <div id="d-ai-usage" class="space-y-2"><div class="pskel h-10 w-full"></div></div>
      <div id="d-ai-usage-empty" class="empty hidden">
        <p class="empty-title">Nog geen AI-gebruik</p>
        <p class="empty-text">Verschijnt zodra Emma AI-velden of onderzoek aanroept.</p>
      </div>
    </div>
  </section>

  <style>
    .d-funnel { display: flex; flex-wrap: wrap; gap: 10px; }
    .d-funnel-step { flex: 1 1 120px; border: 1px solid var(--p-border); border-radius: 8px; padding: 12px 14px; text-align: center; }
    .d-funnel-step .n { font-size: 22px; font-weight: 600; color: var(--p-ink); font-variant-numeric: tabular-nums; }
    .d-funnel-step .l { font-size: 12px; color: var(--p-ink-3); margin-top: 2px; }
  </style>

  <script is:inline>
    (function () {
      var KIND = { klant: 'pbadge--blue', aanvraag: 'pbadge--amber', wijziging: 'pbadge--gray', ticket: 'pbadge--gray' };
      function esc(s) {
        return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
        });
      }
      function euro(cent) { return (Number(cent || 0) / 100).toLocaleString('nl-NL', { style: 'currency', currency: 'EUR' }); }

      fetch('/api/admin/overview', { credentials: 'same-origin' })
        .then(function (r) { if (r.status !== 200) { location.href = '/portal/login'; throw 0; } return r.json(); })
        .then(function (d) {
          var k = d.kpi || {};
          document.getElementById('k-klanten').textContent = k.klanten || 0;
          document.getElementById('k-diensten').textContent = k.actieveDiensten || 0;
          document.getElementById('k-aanvragen').textContent = k.openAanvragen || 0;
          document.getElementById('k-tickets').textContent = k.openTickets || 0;

          var att = d.attention || [];
          var ab = document.getElementById('d-attention');
          if (!att.length) { ab.innerHTML = ''; document.getElementById('d-attention-empty').classList.remove('hidden'); }
          else {
            ab.innerHTML = att.map(function (a) {
              return '<a href="' + esc(a.href) + '" class="flex items-center justify-between rounded-md border px-3 py-2.5 text-sm" style="border-color:var(--p-border)">' +
                '<span style="color:var(--p-ink-2)">' + esc(a.label) + '</span>' +
                '<span class="pbadge ' + (KIND[a.kind] || 'pbadge--gray') + '">' + esc(a.kind) + '</span></a>';
            }).join('');
          }

          var act = d.activity || [];
          var cb = document.getElementById('d-activity');
          if (!act.length) { cb.innerHTML = ''; document.getElementById('d-activity-empty').classList.remove('hidden'); }
          else {
            cb.innerHTML = act.map(function (a) {
              var dt = a.when ? new Date(a.when).toLocaleDateString('nl-NL') : '';
              return '<div class="flex items-start gap-3 text-sm">' +
                '<span class="pbadge ' + (KIND[a.kind] || 'pbadge--gray') + '">' + esc(a.kind) + '</span>' +
                '<span class="flex-1" style="color:var(--p-ink-2)">' + esc(a.label) + '</span>' +
                '<span class="text-xs" style="color:var(--p-ink-4)">' + dt + '</span></div>';
            }).join('');
          }
        })
        .catch(function () {});

      var FUNNEL_STAGES = [
        { stage: 'nieuw', label: 'Nieuw' },
        { stage: 'mail1', label: 'Mail 1' },
        { stage: 'followup', label: 'Follow-up' },
        { stage: 'geinteresseerd', label: 'Geïnteresseerd' },
        { stage: 'afgewezen', label: 'Afgewezen' },
      ];

      var rottingTotal = 0;

      Promise.all([
        fetch('/api/admin/crm/pipeline?pipeline=outreach', { credentials: 'same-origin' }).then(function (r) { return r.json(); }).catch(function () { return null; }),
        fetch('/api/admin/crm/pipeline?pipeline=services', { credentials: 'same-origin' }).then(function (r) { return r.json(); }).catch(function () { return null; }),
      ]).then(function (res) {
        var outreachData = res[0];
        var servicesData = res[1];

        var countByStage = {};
        ((outreachData && outreachData.columns) || []).forEach(function (c) { countByStage[c.stage] = c.cards.length; });
        document.getElementById('d-funnel').innerHTML = FUNNEL_STAGES.map(function (s) {
          return '<div class="d-funnel-step"><div class="n">' + (countByStage[s.stage] || 0) + '</div><div class="l">' + esc(s.label) + '</div></div>';
        }).join('');

        rottingTotal = ((outreachData && outreachData.totals && outreachData.totals.rotting_count) || 0)
          + ((servicesData && servicesData.totals && servicesData.totals.rotting_count) || 0);
        var rottingEl = document.getElementById('k-rotting');
        rottingEl.textContent = rottingTotal;
        rottingEl.style.color = rottingTotal > 0 ? '#b3093c' : '';

        var forecastCent = (servicesData && servicesData.totals && servicesData.totals.weighted_forecast_cent) || 0;
        document.getElementById('k-forecast').textContent = euro(forecastCent);
      });

      fetch('/api/admin/ai/usage', { credentials: 'same-origin' })
        .then(function (r) { return r.json(); })
        .then(function (d) {
          var vandaag = (d && d.vandaag) || [];
          var zevenDagen = (d && d.zeven_dagen) || [];
          var box = document.getElementById('d-ai-usage');
          if (!vandaag.length && !zevenDagen.length) {
            box.innerHTML = '';
            document.getElementById('d-ai-usage-empty').classList.remove('hidden');
            return;
          }
          var zevenByFeature = {};
          zevenDagen.forEach(function (r) { zevenByFeature[r.feature] = r.calls; });
          var features = vandaag.map(function (r) { return r.feature; });
          zevenDagen.forEach(function (r) { if (features.indexOf(r.feature) === -1) features.push(r.feature); });
          var vandaagByFeature = {};
          vandaag.forEach(function (r) { vandaagByFeature[r.feature] = r.calls; });
          box.innerHTML = features.map(function (f) {
            return '<div class="flex items-center justify-between text-sm">' +
              '<span style="color:var(--p-ink-2)">' + esc(f) + '</span>' +
              '<span class="p-muted">vandaag: <b style="color:var(--p-ink)">' + (vandaagByFeature[f] || 0) + '</b>' +
              ' · 7 dagen: <b style="color:var(--p-ink)">' + (zevenByFeature[f] || 0) + '</b></span></div>';
          }).join('');
        })
        .catch(function () {});
    })();
  </script>
</AdminLayout>
