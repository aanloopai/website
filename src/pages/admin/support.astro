---
// Admin panel — support ticket queue.
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Support" active="support">
  <h1 class="page-title">Support</h1>
  <p class="page-sub">Supportvragen van klanten. Een antwoord wordt per e-mail verstuurd.</p>

  <div class="mt-5">
    <select id="t-filter" class="pselect" style="width:auto">
      <option value="">Alle statussen</option>
      <option value="open">Open</option>
      <option value="in_behandeling">In behandeling</option>
      <option value="beantwoord">Beantwoord</option>
      <option value="gesloten">Gesloten</option>
    </select>
  </div>

  <div id="t-list" class="mt-5 space-y-3">
    <div class="pskel h-32 w-full"></div>
    <div class="pskel h-32 w-full"></div>
  </div>
  <div id="t-empty" class="pcard mt-5 hidden">
    <div class="empty">
      <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <p class="empty-title">Geen tickets</p>
      <p class="empty-text">Er zijn geen tickets voor dit filter.</p>
    </div>
  </div>

  <script is:inline>
    (function () {
      var STATUS = { open: 'pbadge--amber', in_behandeling: 'pbadge--blue', beantwoord: 'pbadge--green', gesloten: 'pbadge--gray' };
      function esc(s) {
        return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
        });
      }
      function load() {
        var f = document.getElementById('t-filter').value;
        fetch('/api/admin/tickets' + (f ? '?status=' + f : ''), { credentials: 'same-origin' })
          .then(function (r) { if (window.adminFout.http(r, 'Tickets')) { throw 0; } return r.json(); })
          .then(function (d) {
            var list = d.tickets || [];
            var box = document.getElementById('t-list');
            if (!list.length) { box.innerHTML = ''; document.getElementById('t-empty').classList.remove('hidden'); return; }
            document.getElementById('t-empty').classList.add('hidden');
            box.innerHTML = list.map(function (t) {
              var dt = new Date(t.created_at).toLocaleString('nl-NL');
              return '<div class="pcard" data-id="' + esc(t.id) + '"><div class="pcard-b">' +
                '<div class="flex items-center justify-between gap-2"><span class="primary" style="color:var(--p-ink);font-weight:600">' +
                esc(t.onderwerp) + ' — ' + esc(t.bedrijf) + '</span>' +
                '<span class="pbadge ' + (STATUS[t.status] || 'pbadge--gray') + '">' + esc(t.status) + '</span></div>' +
                '<p class="mt-1 text-xs" style="color:var(--p-ink-4)">' + dt + ' · ' + esc(t.user_naam) + ' (' + esc(t.user_email) + ')</p>' +
                '<p class="mt-2 text-sm p-muted">' + esc(t.bericht) + '</p>' +
                '<textarea class="t-ans ptextarea mt-3" placeholder="Antwoord aan de klant">' + esc(t.admin_antwoord || '') + '</textarea>' +
                '<div class="mt-2 flex flex-wrap items-center gap-2">' +
                '<select class="t-stat pselect" style="width:auto">' +
                ['open', 'in_behandeling', 'beantwoord', 'gesloten'].map(function (s) {
                  return '<option value="' + s + '"' + (s === t.status ? ' selected' : '') + '>' + s + '</option>';
                }).join('') + '</select>' +
                '<button class="t-save pbtn pbtn--primary">Opslaan + mailen</button>' +
                '<span class="text-xs" style="color:var(--p-ink-4)">Bij beantwoord/gesloten + antwoord gaat er een mail naar de klant.</span>' +
                '</div></div></div>';
            }).join('');
            document.querySelectorAll('#t-list .t-save').forEach(function (b) {
              b.addEventListener('click', function () {
                var box2 = b.closest('[data-id]');
                b.disabled = true;
                fetch('/api/admin/ticket', {
                  method: 'PATCH', credentials: 'same-origin',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({
                    id: box2.getAttribute('data-id'),
                    status: box2.querySelector('.t-stat').value,
                    admin_antwoord: box2.querySelector('.t-ans').value.trim(),
                  }),
                }).then(function () { load(); }).catch(function () { b.disabled = false; });
              });
            });
          })
          .catch(function () {});
      }
      document.getElementById('t-filter').addEventListener('change', load);
      load();
    })();
  </script>
</AdminLayout>
