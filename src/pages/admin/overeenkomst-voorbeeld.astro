---
// Admin — voorbeeldweergave van de klantflow (?id=agr_…). Read-only: niets wordt opgeslagen.
import AdminLayout from '../../layouts/AdminLayout.astro';
import OvereenkomstFlow from '../../components/OvereenkomstFlow.astro';
---

<AdminLayout title="Voorbeeld klantweergave" active="klanten">
  <a id="v-terug" href="/admin/klanten" class="p-link text-sm">← Overeenkomst</a>
  <div class="mt-4">
    <OvereenkomstFlow mode="voorbeeld" />
  </div>
  <script is:inline>
    (function () {
      var id = new URLSearchParams(location.search).get('id');
      if (id) document.getElementById('v-terug').href = '/admin/overeenkomst/?id=' + encodeURIComponent(id);
    })();
  </script>
</AdminLayout>
