---
// Admin panel — customer detail. Manage company data, users, services, invoices.
import AdminLayout from '../../layouts/AdminLayout.astro';
import { PORTAL_CATALOG } from '../../data/portal-catalog';
---

<AdminLayout title="Klant" active="klanten">
  <a href="/admin/" class="text-sm text-brand-indigo hover:underline">← Alle klanten</a>
  <h1 id="k-titel" class="mt-2 text-2xl font-bold text-slate-900">Klant</h1>

  <div id="k-loading" class="mt-6 text-sm text-slate-400">Bezig met laden...</div>

  <div id="k-content" class="hidden mt-6 space-y-8">
    <section class="rounded-xl border border-slate-200 bg-white p-5">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Bedrijfsgegevens</h2>
      <div class="mt-3 grid gap-3 sm:grid-cols-2">
        <input id="k-bedrijf" placeholder="Bedrijfsnaam" class="rounded-lg border border-slate-300 px-3 py-2 text-sm" />
        <input id="k-kvk" placeholder="KvK" class="rounded-lg border border-slate-300 px-3 py-2 text-sm" />
        <input id="k-adres" placeholder="Adres" class="rounded-lg border border-slate-300 px-3 py-2 text-sm" />
        <input id="k-postcode" placeholder="Postcode" class="rounded-lg border border-slate-300 px-3 py-2 text-sm" />
        <input id="k-stad" placeholder="Stad" class="rounded-lg border border-slate-300 px-3 py-2 text-sm" />
        <input id="k-telefoon" placeholder="Telefoon" class="rounded-lg border border-slate-300 px-3 py-2 text-sm" />
        <input id="k-factuur" type="email" placeholder="Factuur-e-mail" class="rounded-lg border border-slate-300 px-3 py-2 text-sm sm:col-span-2" />
      </div>
      <div class="mt-3 flex items-center gap-3">
        <button id="k-save" class="rounded-lg bg-brand-indigo px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700">Opslaan</button>
        <span id="k-msg" class="text-sm"></span>
      </div>
    </section>

    <section class="rounded-xl border border-slate-200 bg-white p-5">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Gebruikers</h2>
      <div id="k-users" class="mt-3 space-y-2"></div>
      <div class="mt-4 flex flex-col gap-2 sm:flex-row">
        <input id="u-naam" placeholder="Naam" class="rounded-lg border border-slate-300 px-3 py-2 text-sm" />
        <input id="u-email" type="email" placeholder="E-mail" class="flex-1 rounded-lg border border-slate-300 px-3 py-2 text-sm" />
        <select id="u-role" class="rounded-lg border border-slate-300 px-3 py-2 text-sm">
          <option value="eigenaar">Eigenaar</option>
          <option value="bewerker">Bewerker</option>
          <option value="kijker">Kijker</option>
        </select>
        <button id="u-add" class="rounded-lg bg-slate-800 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700">Toevoegen</button>
      </div>
      <span id="u-msg" class="mt-2 block text-sm"></span>
    </section>

    <section class="rounded-xl border border-slate-200 bg-white p-5">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Diensten</h2>
      <div id="k-services" class="mt-3 space-y-3"></div>
      <div class="mt-4 grid gap-2 sm:grid-cols-5">
        <select id="s-product" class="rounded-lg border border-slate-300 px-3 py-2 text-sm">
          {PORTAL_CATALOG.map((p) => <option value={p.key}>{p.naam}</option>)}
        </select>
        <input id="s-naam" placeholder="Weergavenaam" class="rounded-lg border border-slate-300 px-3 py-2 text-sm" />
        <input id="s-tier" placeholder="Tier" class="rounded-lg border border-slate-300 px-3 py-2 text-sm" />
        <select id="s-status" class="rounded-lg border border-slate-300 px-3 py-2 text-sm">
          <option value="onboarding">Onboarding</option>
          <option value="actief">Actief</option>
          <option value="gepauzeerd">Gepauzeerd</option>
        </select>
        <button id="s-add" class="rounded-lg bg-slate-800 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700">Dienst toevoegen</button>
      </div>
      <span id="s-msg" class="mt-2 block text-sm"></span>
    </section>

    <section class="rounded-xl border border-slate-200 bg-white p-5">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Facturen</h2>
      <div id="k-invoices" class="mt-3 space-y-2"></div>
      <div class="mt-4 grid gap-2 sm:grid-cols-5">
        <input id="i-periode" placeholder="Periode (bv. Mei 2026)" class="rounded-lg border border-slate-300 px-3 py-2 text-sm" />
        <input id="i-bedrag" type="number" step="0.01" placeholder="Bedrag €" class="rounded-lg border border-slate-300 px-3 py-2 text-sm" />
        <select id="i-status" class="rounded-lg border border-slate-300 px-3 py-2 text-sm">
          <option value="open">Open</option>
          <option value="betaald">Betaald</option>
        </select>
        <input id="i-pdf" placeholder="PDF-URL (optioneel)" class="rounded-lg border border-slate-300 px-3 py-2 text-sm" />
        <button id="i-add" class="rounded-lg bg-slate-800 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700">Factuur toevoegen</button>
      </div>
      <span id="i-msg" class="mt-2 block text-sm"></span>
    </section>
  </div>

  <script is:inline>
    (function () {
      function esc(s) {
        return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
        });
      }
      function euro(cent) { return (Number(cent || 0) / 100).toLocaleString('nl-NL', { style: 'currency', currency: 'EUR' }); }
      function flash(el, text, ok) {
        el.textContent = text;
        el.className = 'mt-2 block text-sm ' + (ok ? 'text-emerald-700' : 'text-rose-600');
        setTimeout(function () { el.textContent = ''; }, 4000);
      }
      var cid = new URLSearchParams(location.search).get('id');
      if (!cid) { location.href = '/admin/'; return; }

      function load() {
        fetch('/api/admin/customer?id=' + encodeURIComponent(cid), { credentials: 'same-origin' })
          .then(function (r) { if (r.status !== 200) { location.href = '/portal/login'; throw 0; } return r.json(); })
          .then(function (d) {
            document.getElementById('k-loading').classList.add('hidden');
            document.getElementById('k-content').classList.remove('hidden');
            var c = d.customer || {};
            document.getElementById('k-titel').textContent = c.bedrijf || 'Klant';
            document.getElementById('k-bedrijf').value = c.bedrijf || '';
            document.getElementById('k-kvk').value = c.kvk || '';
            document.getElementById('k-adres').value = c.adres || '';
            document.getElementById('k-postcode').value = c.postcode || '';
            document.getElementById('k-stad').value = c.stad || '';
            document.getElementById('k-telefoon').value = c.telefoon || '';
            document.getElementById('k-factuur').value = c.factuur_email || '';
            renderUsers(d.users || []);
            renderServices(d.services || []);
            renderInvoices(d.invoices || []);
          })
          .catch(function () {});
      }

      function renderUsers(list) {
        document.getElementById('k-users').innerHTML = list.length
          ? list.map(function (u) {
              return '<div class="flex items-center justify-between rounded-lg border border-slate-200 px-4 py-2 text-sm">' +
                '<span><span class="font-medium text-slate-900">' + esc(u.naam) + '</span>' +
                '<span class="ml-2 text-slate-400">' + esc(u.email) + '</span></span>' +
                '<span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs capitalize text-slate-600">' + esc(u.role) + '</span></div>';
            }).join('')
          : '<p class="text-sm text-slate-400">Nog geen gebruikers.</p>';
      }

      function renderServices(list) {
        document.getElementById('k-services').innerHTML = list.length
          ? list.map(function (s) {
              return '<div class="rounded-lg border border-slate-200 p-3" data-sid="' + esc(s.id) + '">' +
                '<div class="flex items-center justify-between"><span class="font-medium text-slate-900">' + esc(s.naam) + '</span>' +
                '<span class="text-xs text-slate-400">' + esc(s.product_key) + '</span></div>' +
                '<div class="mt-2 flex flex-wrap items-center gap-2">' +
                '<input class="s-tier w-28 rounded-lg border border-slate-300 px-2 py-1 text-sm" value="' + esc(s.tier || '') + '" placeholder="Tier" />' +
                '<select class="s-stat rounded-lg border border-slate-300 px-2 py-1 text-sm">' +
                ['actief', 'onboarding', 'gepauzeerd'].map(function (st) {
                  return '<option value="' + st + '"' + (st === s.status ? ' selected' : '') + '>' + st + '</option>';
                }).join('') + '</select>' +
                '<button class="s-upd rounded-lg bg-brand-indigo px-3 py-1 text-sm font-medium text-white hover:bg-indigo-700">Opslaan</button>' +
                '</div></div>';
            }).join('')
          : '<p class="text-sm text-slate-400">Nog geen diensten.</p>';
        document.querySelectorAll('#k-services .s-upd').forEach(function (b) {
          b.addEventListener('click', function () {
            var box = b.closest('[data-sid]');
            post('/api/admin/service', 'PATCH', {
              id: box.getAttribute('data-sid'),
              tier: box.querySelector('.s-tier').value.trim(),
              status: box.querySelector('.s-stat').value,
            }, document.getElementById('s-msg'));
          });
        });
      }

      function renderInvoices(list) {
        document.getElementById('k-invoices').innerHTML = list.length
          ? list.map(function (i) {
              var badge = i.status === 'betaald' ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800';
              return '<div class="flex items-center justify-between rounded-lg border border-slate-200 px-4 py-2 text-sm">' +
                '<span class="text-slate-800">' + esc(i.periode) + ' — ' + euro(i.bedrag_cent) + '</span>' +
                '<span class="rounded-full px-2 py-0.5 text-xs font-medium ' + badge + '">' + esc(i.status) + '</span></div>';
            }).join('')
          : '<p class="text-sm text-slate-400">Nog geen facturen.</p>';
      }

      function post(url, method, body, msgEl) {
        return fetch(url, {
          method: method, credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body),
        })
          .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
          .then(function (res) {
            flash(msgEl, res.ok ? (res.j.message || 'Opgeslagen') : (res.j.error || 'Fout'), res.ok);
            if (res.ok) load();
            return res;
          })
          .catch(function () { flash(msgEl, 'Netwerkfout', false); });
      }

      document.getElementById('k-save').addEventListener('click', function () {
        post('/api/admin/customer', 'PATCH', {
          id: cid,
          bedrijf: document.getElementById('k-bedrijf').value.trim(),
          kvk: document.getElementById('k-kvk').value.trim(),
          adres: document.getElementById('k-adres').value.trim(),
          postcode: document.getElementById('k-postcode').value.trim(),
          stad: document.getElementById('k-stad').value.trim(),
          telefoon: document.getElementById('k-telefoon').value.trim(),
          factuur_email: document.getElementById('k-factuur').value.trim(),
        }, document.getElementById('k-msg'));
      });
      document.getElementById('u-add').addEventListener('click', function () {
        post('/api/admin/user', 'POST', {
          customer_id: cid,
          naam: document.getElementById('u-naam').value.trim(),
          email: document.getElementById('u-email').value.trim(),
          role: document.getElementById('u-role').value,
        }, document.getElementById('u-msg'));
      });
      document.getElementById('s-add').addEventListener('click', function () {
        post('/api/admin/service', 'POST', {
          customer_id: cid,
          product_key: document.getElementById('s-product').value,
          naam: document.getElementById('s-naam').value.trim(),
          tier: document.getElementById('s-tier').value.trim(),
          status: document.getElementById('s-status').value,
        }, document.getElementById('s-msg'));
      });
      document.getElementById('i-add').addEventListener('click', function () {
        var euros = parseFloat(document.getElementById('i-bedrag').value);
        post('/api/admin/invoice', 'POST', {
          customer_id: cid,
          periode: document.getElementById('i-periode').value.trim(),
          bedrag_cent: isFinite(euros) ? Math.round(euros * 100) : NaN,
          status: document.getElementById('i-status').value,
          pdf_url: document.getElementById('i-pdf').value.trim(),
        }, document.getElementById('i-msg'));
      });

      load();
    })();
  </script>
</AdminLayout>
