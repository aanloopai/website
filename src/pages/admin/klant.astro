---
// Admin panel — customer detail. Manage company data, users, services, invoices.
import AdminLayout from '../../layouts/AdminLayout.astro';
import { PORTAL_CATALOG } from '../../data/portal-catalog';
---

<AdminLayout title="Klant" active="klanten">
  <a href="/admin/klanten" class="p-link text-sm">← Alle klanten</a>
  <h1 id="k-titel" class="page-title mt-2">Klant</h1>

  <div id="k-loading" class="mt-6"><div class="pskel h-48 w-full max-w-2xl"></div></div>

  <div id="k-content" class="hidden mt-6 space-y-6">
    <section class="pcard">
      <div class="pcard-h">Bedrijfsgegevens</div>
      <div class="pcard-b">
        <div class="grid gap-3 sm:grid-cols-2">
          <div><label class="plabel">Bedrijfsnaam</label><input id="k-bedrijf" class="pinput" /></div>
          <div><label class="plabel">KvK</label><input id="k-kvk" class="pinput" /></div>
          <div><label class="plabel">Adres</label><input id="k-adres" class="pinput" /></div>
          <div><label class="plabel">Postcode</label><input id="k-postcode" class="pinput" /></div>
          <div><label class="plabel">Stad</label><input id="k-stad" class="pinput" /></div>
          <div><label class="plabel">Telefoon</label><input id="k-telefoon" class="pinput" /></div>
          <div class="sm:col-span-2"><label class="plabel">Factuur-e-mail</label><input id="k-factuur" type="email" class="pinput" /></div>
        </div>
        <div class="mt-4 flex items-center gap-3">
          <button id="k-save" class="pbtn pbtn--primary">Opslaan</button>
          <span id="k-msg" class="text-sm"></span>
        </div>
      </div>
    </section>

    <section class="pcard">
      <div class="pcard-h">Gebruikers</div>
      <div class="pcard-b">
        <div id="k-users" class="space-y-2"></div>
        <div class="mt-4 flex flex-col gap-2 sm:flex-row">
          <input id="u-naam" placeholder="Naam" class="pinput" />
          <input id="u-email" type="email" placeholder="E-mail" class="pinput flex-1" />
          <select id="u-role" class="pselect" style="width:auto">
            <option value="eigenaar">Eigenaar</option>
            <option value="bewerker">Bewerker</option>
            <option value="kijker">Kijker</option>
          </select>
          <button id="u-add" class="pbtn pbtn--subtle">Toevoegen</button>
        </div>
        <span id="u-msg" class="mt-2 block text-sm"></span>
      </div>
    </section>

    <section class="pcard">
      <div class="pcard-h">Diensten</div>
      <div class="pcard-b">
        <div id="k-services" class="space-y-3"></div>
        <div class="mt-4 grid gap-2 sm:grid-cols-5">
          <select id="s-product" class="pselect">
            {PORTAL_CATALOG.map((p) => <option value={p.key}>{p.naam}</option>)}
          </select>
          <input id="s-naam" placeholder="Weergavenaam" class="pinput" />
          <input id="s-tier" placeholder="Tier" class="pinput" />
          <select id="s-status" class="pselect">
            <option value="onboarding">Onboarding</option>
            <option value="actief">Actief</option>
            <option value="gepauzeerd">Gepauzeerd</option>
          </select>
          <button id="s-add" class="pbtn pbtn--subtle">Dienst toevoegen</button>
        </div>
        <span id="s-msg" class="mt-2 block text-sm"></span>
      </div>
    </section>

    <section class="pcard">
      <div class="pcard-h">Facturen</div>
      <div class="pcard-b">
        <div id="k-invoices" class="space-y-2"></div>
        <div class="mt-4 grid gap-2 sm:grid-cols-5">
          <input id="i-periode" placeholder="Periode (bv. Mei 2026)" class="pinput" />
          <input id="i-bedrag" type="number" step="0.01" placeholder="Bedrag €" class="pinput" />
          <select id="i-status" class="pselect">
            <option value="open">Open</option>
            <option value="betaald">Betaald</option>
          </select>
          <input id="i-pdf" placeholder="PDF-URL (optioneel)" class="pinput" />
          <button id="i-add" class="pbtn pbtn--subtle">Factuur toevoegen</button>
        </div>
        <span id="i-msg" class="mt-2 block text-sm"></span>
      </div>
    </section>

    <section class="pcard">
      <div class="pcard-h">Gevaarlijke acties</div>
      <div class="pcard-b">
        <label class="plabel">Typ de bedrijfsnaam ter bevestiging</label>
        <div class="mt-2 flex flex-col gap-2 sm:flex-row">
          <input id="del-confirm" class="pinput flex-1" placeholder="Typ de bedrijfsnaam ter bevestiging" />
          <button id="k-delete" class="pbtn" style="color:#b3093c;border-color:#b3093c">Klant verwijderen</button>
        </div>
        <span id="del-msg" class="mt-2 block text-sm"></span>
      </div>
    </section>
  </div>

  <script is:inline>
    (function () {
      var STATUS = { actief: 'pbadge--green', onboarding: 'pbadge--amber', gepauzeerd: 'pbadge--gray' };
      function esc(s) {
        return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
        });
      }
      function euro(cent) { return (Number(cent || 0) / 100).toLocaleString('nl-NL', { style: 'currency', currency: 'EUR' }); }
      function flash(el, text, ok) {
        el.textContent = text;
        el.style.color = ok ? '#0e6245' : '#b3093c';
        setTimeout(function () { el.textContent = ''; }, 4000);
      }
      var cid = new URLSearchParams(location.search).get('id');
      if (!cid) { location.href = '/admin/klanten'; return; }

      function load() {
        fetch('/api/admin/customer?id=' + encodeURIComponent(cid), { credentials: 'same-origin' })
          .then(function (r) { if (window.adminFout.http(r, 'Customer')) { throw 0; } return r.json(); })
          .then(function (d) {
            document.getElementById('k-loading').classList.add('hidden');
            document.getElementById('k-content').classList.remove('hidden');
            var c = d.customer || {};
            document.getElementById('k-titel').textContent = c.bedrijf || 'Klant';
            document.getElementById('k-bedrijf').value = c.bedrijf || '';
            document.getElementById('k-kvk').value = c.kvk || '';
            document.getElementById('k-adres').value = c.adres || '';
            document.getElementById('k-postcode').value = c.postcode || '';
            document.getElementById('k-stad').value = c.stad || '';
            document.getElementById('k-telefoon').value = c.telefoon || '';
            document.getElementById('k-factuur').value = c.factuur_email || '';
            renderUsers(d.users || []);
            renderServices(d.services || []);
            renderInvoices(d.invoices || []);
          })
          .catch(function () {});
      }

      function renderUsers(list) {
        document.getElementById('k-users').innerHTML = list.length
          ? list.map(function (u) {
              return '<div class="flex items-center justify-between rounded-md border px-4 py-2.5 text-sm" style="border-color:var(--p-border)">' +
                '<span><span class="primary" style="color:var(--p-ink);font-weight:500">' + esc(u.naam) + '</span>' +
                '<span class="ml-2 p-muted">' + esc(u.email) + '</span></span>' +
                '<span class="pbadge pbadge--gray">' + esc(u.role) + '</span></div>';
            }).join('')
          : '<p class="text-sm p-muted">Nog geen gebruikers.</p>';
      }

      function provHtml(s) {
        var p;
        try { p = s.provisioning_json ? JSON.parse(s.provisioning_json) : null; } catch (e) { p = null; }
        if (!p) return '';
        if (p.status === 'fout') {
          return '<p class="mt-2 text-xs" style="color:#b3093c">Provisioning mislukt: ' + esc(p.error || '') + '</p>';
        }
        return '<p class="mt-2 text-xs" style="color:#0e6245">ElevenLabs agent: ' + esc(p.agent_id || '—') +
          (p.kb_id ? ' · kennisbank: ' + esc(p.kb_id) : '') + '</p>';
      }

      function renderServices(list) {
        document.getElementById('k-services').innerHTML = list.length
          ? list.map(function (s) {
              return '<div class="rounded-md border p-3" style="border-color:var(--p-border)" data-sid="' + esc(s.id) + '" data-status="' + esc(s.status) + '">' +
                '<div class="flex items-center justify-between"><span class="primary" style="color:var(--p-ink);font-weight:500">' + esc(s.naam) + '</span>' +
                '<span class="pbadge ' + (STATUS[s.status] || 'pbadge--gray') + '">' + esc(s.status) + '</span></div>' +
                '<div class="mt-2 flex flex-wrap items-center gap-2">' +
                '<input class="s-tier pinput pbtn--sm" style="width:8rem;height:30px" value="' + esc(s.tier || '') + '" placeholder="Tier" />' +
                '<select class="s-stat pselect" style="width:auto;height:30px">' +
                ['actief', 'onboarding', 'gepauzeerd'].map(function (st) {
                  return '<option value="' + st + '"' + (st === s.status ? ' selected' : '') + '>' + st + '</option>';
                }).join('') + '</select>' +
                '<button class="s-upd pbtn pbtn--primary pbtn--sm">Opslaan</button>' +
                '<button class="s-toggle pbtn pbtn--subtle pbtn--sm">' + (s.status === 'gepauzeerd' ? 'Hervatten' : 'Pauzeren') + '</button>' +
                '<button class="s-del pbtn pbtn--sm" style="color:#b3093c">Verwijderen</button>' +
                '</div>' + provHtml(s) + '</div>';
            }).join('')
          : '<p class="text-sm p-muted">Nog geen diensten.</p>';
        document.querySelectorAll('#k-services .s-upd').forEach(function (b) {
          b.addEventListener('click', function () {
            var box = b.closest('[data-sid]');
            post('/api/admin/service', 'PATCH', {
              id: box.getAttribute('data-sid'),
              tier: box.querySelector('.s-tier').value.trim(),
              status: box.querySelector('.s-stat').value,
            }, document.getElementById('s-msg'));
          });
        });
        document.querySelectorAll('#k-services .s-toggle').forEach(function (b) {
          b.addEventListener('click', function () {
            var box = b.closest('[data-sid]');
            var current = box.getAttribute('data-status');
            var next = current === 'gepauzeerd' ? 'actief' : 'gepauzeerd';
            post('/api/admin/service', 'PATCH', {
              id: box.getAttribute('data-sid'),
              status: next,
            }, document.getElementById('s-msg'));
          });
        });
        document.querySelectorAll('#k-services .s-del').forEach(function (b) {
          b.addEventListener('click', function () {
            if (!confirm('Dienst verwijderen? De AI-agent wordt gestopt en verwijderd.')) return;
            var box = b.closest('[data-sid]');
            var sid = box.getAttribute('data-sid');
            var msgEl = document.getElementById('s-msg');
            fetch('/api/admin/service?id=' + encodeURIComponent(sid), { method: 'DELETE', credentials: 'same-origin' })
              .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
              .then(function (res) {
                flash(msgEl, res.ok ? (res.j.message || 'Verwijderd') : (res.j.error || 'Fout'), res.ok);
                if (res.ok) load();
              })
              .catch(function () { flash(msgEl, 'Netwerkfout', false); });
          });
        });
      }

      function renderInvoices(list) {
        document.getElementById('k-invoices').innerHTML = list.length
          ? list.map(function (i) {
              var badge = i.status === 'betaald' ? 'pbadge--green' : 'pbadge--amber';
              return '<div class="flex items-center justify-between rounded-md border px-4 py-2.5 text-sm" style="border-color:var(--p-border)">' +
                '<span style="color:var(--p-ink-2)">' + esc(i.periode) + ' — ' + euro(i.bedrag_cent) + '</span>' +
                '<span class="pbadge ' + badge + '">' + esc(i.status) + '</span></div>';
            }).join('')
          : '<p class="text-sm p-muted">Nog geen facturen.</p>';
      }

      function post(url, method, body, msgEl) {
        return fetch(url, {
          method: method, credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body),
        })
          .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
          .then(function (res) {
            flash(msgEl, res.ok ? (res.j.message || 'Opgeslagen') : (res.j.error || 'Fout'), res.ok);
            if (res.ok) load();
            return res;
          })
          .catch(function () { flash(msgEl, 'Netwerkfout', false); });
      }

      document.getElementById('k-save').addEventListener('click', function () {
        post('/api/admin/customer', 'PATCH', {
          id: cid,
          bedrijf: document.getElementById('k-bedrijf').value.trim(),
          kvk: document.getElementById('k-kvk').value.trim(),
          adres: document.getElementById('k-adres').value.trim(),
          postcode: document.getElementById('k-postcode').value.trim(),
          stad: document.getElementById('k-stad').value.trim(),
          telefoon: document.getElementById('k-telefoon').value.trim(),
          factuur_email: document.getElementById('k-factuur').value.trim(),
        }, document.getElementById('k-msg'));
      });
      document.getElementById('u-add').addEventListener('click', function () {
        post('/api/admin/user', 'POST', {
          customer_id: cid,
          naam: document.getElementById('u-naam').value.trim(),
          email: document.getElementById('u-email').value.trim(),
          role: document.getElementById('u-role').value,
        }, document.getElementById('u-msg'));
      });
      document.getElementById('s-add').addEventListener('click', function () {
        post('/api/admin/service', 'POST', {
          customer_id: cid,
          product_key: document.getElementById('s-product').value,
          naam: document.getElementById('s-naam').value.trim(),
          tier: document.getElementById('s-tier').value.trim(),
          status: document.getElementById('s-status').value,
        }, document.getElementById('s-msg'));
      });
      document.getElementById('i-add').addEventListener('click', function () {
        var euros = parseFloat(document.getElementById('i-bedrag').value);
        post('/api/admin/invoice', 'POST', {
          customer_id: cid,
          periode: document.getElementById('i-periode').value.trim(),
          bedrag_cent: isFinite(euros) ? Math.round(euros * 100) : NaN,
          status: document.getElementById('i-status').value,
          pdf_url: document.getElementById('i-pdf').value.trim(),
        }, document.getElementById('i-msg'));
      });
      document.getElementById('k-delete').addEventListener('click', function () {
        var msgEl = document.getElementById('del-msg');
        var typed = document.getElementById('del-confirm').value.trim();
        var bedrijf = document.getElementById('k-bedrijf').value.trim();
        if (!typed || typed !== bedrijf) {
          flash(msgEl, 'Bedrijfsnaam komt niet overeen', false);
          return;
        }
        fetch('/api/admin/customer?id=' + encodeURIComponent(cid), {
          method: 'DELETE', credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ confirm: typed }),
        })
          .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
          .then(function (res) {
            if (res.ok) { location.href = '/admin/klanten'; return; }
            flash(msgEl, res.j.error || 'Fout', false);
          })
          .catch(function () { flash(msgEl, 'Netwerkfout', false); });
      });

      load();
    })();
  </script>
</AdminLayout>
