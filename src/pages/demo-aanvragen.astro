---
import BaseLayout from '../layouts/BaseLayout.astro';
const sectors = ['Horeca & Restaurant','Vastgoed & Makelaars','Juridisch & Advocatuur','Accountancy & Administratie','Bouw & Installatie','Logistiek & Transport','Zorg & Welzijn','E-commerce & Detailhandel','ZZP / Freelance','Overig'];
const sizes = ['1 persoon (ZZP)','2–10 medewerkers','11–50 medewerkers','51–200 medewerkers','200+ medewerkers'];
---
<BaseLayout title="Gratis Demo Aanvragen" description="Vraag een gratis 30-minuten AI demo aan. Wij laten u live zien hoe AI agents werken voor uw situatie. Geen verplichting. KVK: 88606902.">
  <section class="border-b border-slate-200 hero-gradient">
    <div class="container-page py-14 lg:py-20">
      <div class="max-w-3xl">
        <div class="flex items-center gap-4 mb-6 reveal"><div class="accent-band"><span></span><span></span><span></span><span></span></div><span class="eyebrow">Demo aanvragen</span></div>
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tightest text-navy text-balance leading-[1.08] reveal reveal-delay-1">Vraag een gratis demo aan</h1>
        <p class="mt-5 text-lg text-slate-600 leading-relaxed reveal reveal-delay-2">In <strong>30 minuten</strong> laten we u live zien hoe een AI agent werkt voor uw situatie. Geen verplichting, geen creditcard.</p>
        <div class="mt-8 flex items-center gap-2 reveal reveal-delay-3">
          {[{n:1,l:'Uw gegevens'},{n:2,l:'Uw bedrijf'},{n:3,l:'Bevestigen'}].map(({n,l},i) => (<>
            <div class="flex items-center gap-2">
              <div id={`step-circle-${n}`} class:list={['flex items-center justify-center w-8 h-8 rounded-full text-xs font-bold border-2 transition-all', n===1 ? 'bg-navy text-white border-navy' : 'bg-white text-slate-400 border-slate-200']}>{n}</div>
              <span id={`step-label-${n}`} class:list={['text-xs font-medium hidden sm:block', n===1 ? 'text-navy' : 'text-slate-400']}>{l}</span>
            </div>
            {i < 2 && <div class="w-8 h-px bg-slate-200 flex-shrink-0"></div>}
          </>))}
        </div>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container-page max-w-2xl mx-auto">
      <form id="demo-form" novalidate>
        <input type="hidden" name="form_type" value="demo" />
        <input type="hidden" name="subject" value="Nieuwe Demo Aanvraag — Aanloop AI" />
        <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

        <!-- Stap 1 -->
        <div id="stap-1" class="bg-white border border-slate-200 rounded-2xl p-8 shadow-sm reveal">
          <div class="flex items-center gap-3 mb-6"><div class="w-8 h-8 rounded-full bg-navy text-white flex items-center justify-center text-xs font-bold">1</div><h2 class="text-lg font-bold text-navy">Uw contactgegevens</h2></div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label for="voornaam" class="block text-sm font-medium text-slate-700 mb-1.5">Voornaam *</label>
              <input type="text" id="voornaam" name="voornaam" required autocomplete="given-name" placeholder="Jan" class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-indigo transition-all" />
              <p class="mt-1 text-xs text-red-500 hidden" id="err-voornaam">Voer uw voornaam in.</p>
            </div>
            <div>
              <label for="achternaam" class="block text-sm font-medium text-slate-700 mb-1.5">Achternaam *</label>
              <input type="text" id="achternaam" name="achternaam" required autocomplete="family-name" placeholder="de Vries" class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-indigo transition-all" />
              <p class="mt-1 text-xs text-red-500 hidden" id="err-achternaam">Voer uw achternaam in.</p>
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-slate-700 mb-1.5">Zakelijk e-mail *</label>
              <input type="email" id="email" name="email" required autocomplete="email" placeholder="jan@bedrijf.nl" class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-indigo transition-all" />
              <p class="mt-1 text-xs text-red-500 hidden" id="err-email">Voer een geldig e-mailadres in.</p>
            </div>
            <div>
              <label for="telefoon" class="block text-sm font-medium text-slate-700 mb-1.5">Telefoonnummer</label>
              <input type="tel" id="telefoon" name="telefoon" autocomplete="tel" placeholder="+31 6 12 34 56 78" class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-indigo transition-all" />
            </div>
          </div>
          <div class="mt-6 flex justify-end">
            <button type="button" id="naar-stap-2" class="btn-primary">Volgende stap <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></button>
          </div>
        </div>

        <!-- Stap 2 -->
        <div id="stap-2" class="hidden bg-white border border-slate-200 rounded-2xl p-8 shadow-sm mt-6">
          <div class="flex items-center gap-3 mb-6"><div class="w-8 h-8 rounded-full bg-navy text-white flex items-center justify-center text-xs font-bold">2</div><h2 class="text-lg font-bold text-navy">Uw bedrijf</h2></div>
          <div class="space-y-5">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label for="bedrijfsnaam" class="block text-sm font-medium text-slate-700 mb-1.5">Bedrijfsnaam *</label>
                <input type="text" id="bedrijfsnaam" name="bedrijfsnaam" required autocomplete="organization" placeholder="Mijn Bedrijf B.V." class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-indigo transition-all" />
              </div>
              <div>
                <label for="functie" class="block text-sm font-medium text-slate-700 mb-1.5">Uw functie</label>
                <input type="text" id="functie" name="functie" placeholder="Eigenaar / Directeur" class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-indigo transition-all" />
              </div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label for="sector" class="block text-sm font-medium text-slate-700 mb-1.5">Sector *</label>
                <select id="sector" name="sector" required class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-indigo transition-all bg-white">
                  <option value="">Kies uw sector...</option>
                  {sectors.map(s => <option value={s}>{s}</option>)}
                </select>
              </div>
              <div>
                <label for="grootte" class="block text-sm font-medium text-slate-700 mb-1.5">Bedrijfsgrootte *</label>
                <select id="grootte" name="bedrijfsgrootte" required class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-indigo transition-all bg-white">
                  <option value="">Kies grootte...</option>
                  {sizes.map(s => <option value={s}>{s}</option>)}
                </select>
              </div>
            </div>
            <div>
              <label for="uitdaging" class="block text-sm font-medium text-slate-700 mb-1.5">Grootste tijdverspiller? <span class="text-slate-400 font-normal">(optioneel)</span></label>
              <textarea id="uitdaging" name="uitdaging" rows="3" placeholder="Bijv. 'We missen calls buiten kantooruren' of 'Factuurverwerking kost ons 10 uur per week'..." class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-indigo transition-all resize-none"></textarea>
            </div>
            <div>
              <label for="gevonden" class="block text-sm font-medium text-slate-700 mb-1.5">Hoe gevonden? <span class="text-slate-400 font-normal">(optioneel)</span></label>
              <select id="gevonden" name="hoe_gevonden" class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-indigo transition-all bg-white">
                <option value="">Kies...</option>
                <option>Google zoekopdracht</option><option>LinkedIn</option><option>Aanbeveling</option><option>Social media</option><option>Vakblad / artikel</option><option>Anders</option>
              </select>
            </div>
          </div>
          <div class="mt-6 flex items-center justify-between">
            <button type="button" id="terug-1" class="btn-ghost text-sm"><svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg> Terug</button>
            <button type="button" id="naar-stap-3" class="btn-primary">Volgende stap <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></button>
          </div>
        </div>

        <!-- Stap 3 -->
        <div id="stap-3" class="hidden bg-white border border-slate-200 rounded-2xl p-8 shadow-sm mt-6">
          <div class="flex items-center gap-3 mb-6"><div class="w-8 h-8 rounded-full bg-navy text-white flex items-center justify-center text-xs font-bold">3</div><h2 class="text-lg font-bold text-navy">Bevestigen &amp; verzenden</h2></div>
          <div class="bg-slate-50 border border-slate-200 rounded-xl p-5 mb-6 text-sm">
            <p class="font-bold text-navy mb-3">Overzicht van uw aanvraag</p>
            <div class="grid grid-cols-2 gap-y-2">
              <span class="text-slate-500">Naam</span><span id="s-naam" class="font-medium">—</span>
              <span class="text-slate-500">E-mail</span><span id="s-email" class="font-medium">—</span>
              <span class="text-slate-500">Bedrijf</span><span id="s-bedrijf" class="font-medium">—</span>
              <span class="text-slate-500">Sector</span><span id="s-sector" class="font-medium">—</span>
            </div>
          </div>
          <div class="mb-6 space-y-3">
            <label class="flex items-start gap-3 cursor-pointer">
              <input type="checkbox" id="akkoord" name="akkoord_privacy" required class="mt-0.5 w-4 h-4 rounded border-slate-300 text-brand-indigo focus:ring-brand-indigo" />
              <span class="text-sm text-slate-600">Ik ga akkoord met de <a href="/privacy/" class="text-brand-indigo underline" target="_blank">privacyverklaring</a>. Mijn gegevens worden gebruikt om de demo in te plannen. *</span>
            </label>
            <label class="flex items-start gap-3 cursor-pointer">
              <input type="checkbox" name="akkoord_marketing" class="mt-0.5 w-4 h-4 rounded border-slate-300 text-brand-indigo focus:ring-brand-indigo" />
              <span class="text-sm text-slate-600">Ik ontvang graag AI-tips van Aanloop AI (max 1× per week, altijd afmeldbaar).</span>
            </label>
          </div>
          <p id="form-error" class="text-sm text-red-600 mt-2 hidden" role="alert"></p>
          <div class="flex items-center justify-between">
            <button type="button" id="terug-2" class="btn-ghost text-sm"><svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg> Terug</button>
            <button type="submit" id="submit-btn" class="btn-primary px-8">
              <span id="submit-txt">Demo aanvragen</span>
              <svg id="submit-icon" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
              <svg id="submit-spin" class="w-4 h-4 animate-spin hidden" viewBox="0 0 24 24" fill="none"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 14.627 0 20 4.373L16 8A4 4 0 008 8H4z"/></svg>
            </button>
          </div>
          <p class="text-xs text-slate-400 mt-4 text-center">Wij nemen binnen <strong>1 werkdag</strong> contact op om een moment in te plannen.</p>
          <div class="mt-6 pt-5 border-t border-slate-100 text-center">
            <p class="text-sm text-slate-500">Of bekijk onze open agenda <strong>na</strong> dit formulier.</p>
          </div>
        </div>

        <!-- Stap dots -->
        <div class="flex justify-center gap-2 mt-6">
          {[1,2,3].map(n => <div class:list={['step-dot rounded-full transition-all duration-300', n===1?'w-6 h-2 bg-navy':'w-2 h-2 bg-slate-200']} data-s={n}></div>)}
        </div>
      </form>

      <div class="mt-10 grid grid-cols-2 md:grid-cols-4 gap-4 text-center text-xs text-slate-500 reveal">
        {[{i:'🔒',t:'AVG-compliant'},{i:'⏱',t:'Reactie < 1 werkdag'},{i:'🆓',t:'Gratis & vrijblijvend'},{i:'🇳🇱',t:'KVK: 88606902'}].map(x=>(
          <div class="flex flex-col items-center gap-1"><span class="text-xl">{x.i}</span><span class="font-medium">{x.t}</span></div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
function toonStap(n: number) {
  [1,2,3].forEach(i => {
    const el = document.getElementById(`stap-${i}`);
    if (el) el.classList.toggle('hidden', i !== n);
    const circ = document.getElementById(`step-circle-${i}`) as HTMLElement|null;
    const lbl = document.getElementById(`step-label-${i}`) as HTMLElement|null;
    if (circ) {
      circ.classList.toggle('bg-navy', i <= n);
      circ.classList.toggle('text-white', i <= n);
      circ.classList.toggle('border-navy', i <= n);
      circ.classList.toggle('bg-white', i > n);
      circ.classList.toggle('text-slate-400', i > n);
      circ.classList.toggle('border-slate-200', i > n);
    }
    if (lbl) { lbl.classList.toggle('text-navy', i === n); lbl.classList.toggle('text-slate-400', i !== n); }
  });
  document.querySelectorAll<HTMLElement>('.step-dot').forEach(d => {
    const s = parseInt(d.dataset.s||'0');
    d.classList.toggle('w-6', s===n); d.classList.toggle('bg-navy', s===n);
    d.classList.toggle('w-2', s!==n); d.classList.toggle('bg-slate-200', s!==n);
  });
  // Stay at current scroll position — no auto-scroll (user-requested fix)
}

function v1(): boolean {
  let ok = true;
  const vn = (document.getElementById('voornaam') as HTMLInputElement).value.trim();
  const an = (document.getElementById('achternaam') as HTMLInputElement).value.trim();
  const em = (document.getElementById('email') as HTMLInputElement).value.trim();
  const ev = document.getElementById('err-voornaam')!; const ea = document.getElementById('err-achternaam')!; const ee = document.getElementById('err-email')!;
  ev.classList.add('hidden'); ea.classList.add('hidden'); ee.classList.add('hidden');
  if (!vn) { ev.classList.remove('hidden'); ok=false; }
  if (!an) { ea.classList.remove('hidden'); ok=false; }
  if (!em||!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(em)) { ee.classList.remove('hidden'); ok=false; }
  return ok;
}

function v2(): boolean {
  const b = (document.getElementById('bedrijfsnaam') as HTMLInputElement).value.trim();
  const s = (document.getElementById('sector') as HTMLSelectElement).value;
  const g = (document.getElementById('grootte') as HTMLSelectElement).value;
  if (!b||!s||!g) {
    const errEl = document.getElementById('form-error') as HTMLElement|null;
    if (errEl) { errEl.textContent = 'Vul alle verplichte velden in (Bedrijfsnaam, Sector en Grootte).'; errEl.classList.remove('hidden'); errEl.scrollIntoView({behavior:'smooth',block:'center'}); }
    return false;
  }
  const errEl2 = document.getElementById('form-error') as HTMLElement|null;
  if (errEl2) errEl2.classList.add('hidden');
  return true;
}

function fillSummary() {
  const g = (id: string) => (document.getElementById(id) as HTMLInputElement)?.value.trim()||'—';
  (document.getElementById('s-naam') as HTMLElement).textContent = `${g('voornaam')} ${g('achternaam')}`;
  (document.getElementById('s-email') as HTMLElement).textContent = g('email');
  (document.getElementById('s-bedrijf') as HTMLElement).textContent = g('bedrijfsnaam');
  (document.getElementById('s-sector') as HTMLElement).textContent = g('sector');
}

let _demoStarted = false;
document.getElementById('naar-stap-2')?.addEventListener('click',()=>{ if(v1()) { if (!_demoStarted) { _demoStarted = true; (window as any)._track?.('demo_form_started', { form_name: 'demo_aanvraag' }); } toonStap(2); } });
document.getElementById('terug-1')?.addEventListener('click',()=>toonStap(1));
document.getElementById('naar-stap-3')?.addEventListener('click',()=>{ if(v2()){ (window as any)._track?.('demo_form_step2_completed', { form_name: 'demo_aanvraag', sector: (document.getElementById('sector') as HTMLSelectElement)?.value || '' }); fillSummary(); toonStap(3); }});
document.getElementById('terug-2')?.addEventListener('click',()=>toonStap(2));

document.getElementById('demo-form')?.addEventListener('submit', async (e) => {
  e.preventDefault();
  const form = e.target as HTMLFormElement;
  const ck = document.getElementById('akkoord') as HTMLInputElement;
  if (!ck?.checked) {
    const errEl = document.getElementById('form-error') as HTMLElement|null;
    if (errEl) { errEl.textContent = 'Ga akkoord met de privacyverklaring om door te gaan.'; errEl.classList.remove('hidden'); errEl.scrollIntoView({behavior:'smooth',block:'center'}); }
    return;
  }
  const errElOk = document.getElementById('form-error') as HTMLElement|null;
  if (errElOk) errElOk.classList.add('hidden');

  const btn = document.getElementById('submit-btn') as HTMLButtonElement;
  const txt = document.getElementById('submit-txt') as HTMLElement;
  const ico = document.getElementById('submit-icon') as HTMLElement;
  const spn = document.getElementById('submit-spin') as HTMLElement;
  btn.disabled = true;
  txt.textContent = 'Verzenden...';
  ico?.classList.add('hidden');
  spn?.classList.remove('hidden');

  const data = new FormData(form);
  const ctrl = new AbortController();
  const tid = setTimeout(() => ctrl.abort(), 30000);
  try {
    const res = await fetch('/api/submit', { method: 'POST', body: data, signal: ctrl.signal });
    clearTimeout(tid);
    const text = await res.text();
    let json: any = {};
    try { json = JSON.parse(text); } catch { json = { message: text }; }
    if (res.ok && json.success) {
      (window as any)._track?.('generate_lead', { form_name: 'demo_aanvraag', currency: 'EUR', value: 200 });
      window.location.href = '/demo-bedankt/';
    } else {
      throw new Error(`[HTTP ${res.status}] ${json.message || text || 'Onbekende fout'}`);
    }
  } catch (err: any) {
    clearTimeout(tid);
    console.error('Demo form error:', err);
    const isTimeout = err?.name === 'AbortError';
    const msg = isTimeout
      ? 'Het versturen duurt te lang. Mogelijk een netwerk-issue.\n\nProbeer opnieuw of mail naar hello@aanloopai.nl.'
      : 'Er ging iets mis bij het versturen.\n\nFout: ' + (err?.message || 'Onbekende fout') + '\n\nProbeer opnieuw of stuur een e-mail naar hello@aanloopai.nl';
    const errElSubmit = document.getElementById('form-error') as HTMLElement|null;
    if (errElSubmit) { errElSubmit.textContent = msg.replace(/\n/g, ' '); errElSubmit.classList.remove('hidden'); errElSubmit.scrollIntoView({behavior:'smooth',block:'center'}); }
    btn.disabled = false;
    txt.textContent = 'Demo aanvragen';
    ico?.classList.remove('hidden');
    spn?.classList.add('hidden');
  }
});
</script>
