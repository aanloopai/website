---
import BaseLayout from '../layouts/BaseLayout.astro';

// Pakketprijzen sync met canonieke bron /tarieven (Starter €597, Groei €1.197, Partner op maat).
// /prijzen heeft canonicalOverride naar /tarieven — content moet daarmee overeenkomen.
const faqItems = [
  { question: 'Hoeveel kost een AI agent bij Aanloop AI?', answer: 'Onze pakketten starten vanaf €597 per maand voor Starter (Marco AI-telefoniste, tot 150 gesprekken). Het Groei pakket (€1.197/maand) bevat Marco + Emma WhatsApp en onbeperkte gesprekken. Partner is op maat geprijsd. Alle prijzen exclusief 21% btw.' },
  { question: 'Zijn er verborgen kosten?', answer: 'Nee. Hosting, onderhoud, updates, monitoring en support zijn allemaal inbegrepen in het maandelijkse abonnement. U betaalt nooit extra per gesprek of bericht. Eenmalige setup-kosten staan transparant vermeld: Starter €495, Groei €795, Partner op offerte.' },
  { question: 'Kan ik maandelijks opzeggen?', answer: 'Ja. Alle abonnementen zijn maandelijks opzegbaar met één maand opzegtermijn. Bij jaarlijkse betaling ontvangt u circa 16% korting (Starter €497/mnd, Groei €997/mnd jaarlijks).' },
  { question: 'Wat is het verschil tussen Starter en Groei?', answer: 'Starter (€597/maand) is voor bedrijven die alleen Marco AI-telefoniste willen: tot 150 gesprekken per maand, 1 callscript, agenda-integratie en e-mail leadnotificatie. Groei (€1.197/maand) voegt Emma WhatsApp toe, onbeperkte gesprekken, tot 3 callscripts, CRM-integratie en prioriteit support met reactietijd < 4 uur.' },
  { question: 'Hoe snel ben ik live?', answer: 'Starter: gemiddeld 10 werkdagen. Groei: 7 werkdagen. Partner: 14 werkdagen afhankelijk van de scope. Na ondertekening ontvangt u direct een onboarding-plan met exacte datum.' },
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'AI Agent Diensten',
  provider: { '@type': 'Organization', name: 'Aanloop AI', url: 'https://aanloopai.nl' },
  areaServed: { '@type': 'Country', name: 'Nederland' },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'AI Diensten Aanloop AI',
    itemListElement: [
      { '@type': 'Offer', name: 'Starter — Marco AI Telefoniste', price: '597.00', priceCurrency: 'EUR', priceValidUntil: '2026-12-31', availability: 'https://schema.org/InStock' },
      { '@type': 'Offer', name: 'Groei — Marco + Emma', price: '1197.00', priceCurrency: 'EUR', priceValidUntil: '2026-12-31', availability: 'https://schema.org/InStock' },
    ],
  },
  termsOfService: 'https://aanloopai.nl/voorwaarden/',
};

const plans = [
  {
    id: 'starter', name: 'Starter', tagline: 'Marco AI-telefoniste — eerste stap naar AI',
    price: 597, badge: null,
    features: [
      { text: 'Marco — AI telefoniste (24/7)', ok: true },
      { text: 'Tot 150 gesprekken/maand', ok: true },
      { text: '1 callscript op maat', ok: true },
      { text: 'Lead-melding via e-mail', ok: true },
      { text: 'Agenda-integratie (Google / Outlook)', ok: true },
      { text: 'Dashboard + gespreks­transcripts', ok: true },
      { text: 'Live binnen 10 werkdagen', ok: true },
      { text: 'WhatsApp AI (Emma)', ok: false },
      { text: 'CRM-integratie', ok: false },
      { text: 'Prioriteit support', ok: false },
    ],
  },
  {
    id: 'groei', name: 'Groei', tagline: 'Marco + Emma — telefoon en WhatsApp volledig geautomatiseerd',
    price: 1197, badge: 'Meest gekozen',
    features: [
      { text: 'Marco — AI telefoniste (24/7)', ok: true },
      { text: 'Onbeperkte gesprekken', ok: true },
      { text: 'Tot 3 callscripts op maat', ok: true },
      { text: 'Emma — WhatsApp AI agent', ok: true },
      { text: 'Lead-melding via e-mail + Telegram', ok: true },
      { text: 'Agenda-integratie + CRM (HubSpot / Pipedrive)', ok: true },
      { text: 'Dashboard + transcripts + opnames', ok: true },
      { text: 'Live binnen 7 werkdagen', ok: true },
      { text: 'Prioriteit support (reactie < 4 uur)', ok: true },
      { text: 'Workflow automation (basis)', ok: false },
    ],
  },
  {
    id: 'partner', name: 'Partner', tagline: 'Marco + Emma + Custom Workflows op maat',
    price: null, badge: null,
    features: [
      { text: 'Marco + Emma (onbeperkt)', ok: true },
      { text: 'Onbeperkte callscripts', ok: true },
      { text: 'Custom n8n workflow automation', ok: true },
      { text: 'Multi-team routing & escalatie', ok: true },
      { text: 'Dedicated account manager', ok: true },
      { text: 'SLA 99.9% uptime garantie', ok: true },
      { text: 'Maatwerk CRM/ERP integraties', ok: true },
      { text: 'Live binnen 14 werkdagen', ok: true },
      { text: 'Maandelijks optimalisatie-overleg', ok: true },
      { text: 'On-premise of private cloud optie', ok: true },
    ],
  },
];
---

<BaseLayout
  title="AI Agent Prijzen Nederland | Starter €597/maand"
  description="Transparante AI agent prijzen voor het Nederlandse MKB. Starter (Marco) vanaf €597/maand, Groei (Marco + Emma) €1.197/maand, Partner op maat. Geen verborgen kosten. KVK: 88606902."
  schema={serviceSchema}
  faqSchema={faqItems}
  canonicalOverride="https://aanloopai.nl/tarieven/"
>
  <!-- Hero -->
  <section class="border-b border-slate-200 hero-gradient">
    <div class="container-page py-16 lg:py-24">
      <div class="max-w-3xl">
        <div class="flex items-center gap-4 mb-6 reveal">
          <div class="accent-band"><span></span><span></span><span></span><span></span></div>
          <span class="eyebrow">Tarieven</span>
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tightest text-navy text-balance leading-[1.05] reveal reveal-delay-1">
          Eerlijke AI prijzen,<br/>geen verrassingen.
        </h1>
        <p class="mt-6 text-lg lg:text-xl text-slate-600 leading-relaxed reveal reveal-delay-2">
          Vaste maandprijzen. Geen kosten per gesprek. Geen ingewikkelde contracten. Maandelijks opzegbaar.
        </p>
        <div class="mt-8 flex flex-wrap gap-6 text-sm text-slate-600 reveal reveal-delay-3">
          <div class="flex items-center gap-2"><svg class="w-4 h-4 text-brand-emerald" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>Starter vanaf €597/maand</div>
          <div class="flex items-center gap-2"><svg class="w-4 h-4 text-brand-emerald" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>Live in 7 werkdagen</div>
          <div class="flex items-center gap-2"><svg class="w-4 h-4 text-brand-emerald" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>Maandelijks opzegbaar</div>
          <div class="flex items-center gap-2"><svg class="w-4 h-4 text-brand-emerald" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>AVG-compliant</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Plans -->
  <section class="section">
    <div class="container-page">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 max-w-5xl mx-auto">
        {plans.map((plan) => (
          <div class:list={['relative rounded-2xl p-8 flex flex-col reveal', plan.badge ? 'border-2 border-navy shadow-2xl bg-white' : 'border border-slate-200 bg-white']}>
            {plan.badge && (
              <span class="absolute -top-3.5 left-1/2 -translate-x-1/2 px-4 py-1 bg-navy text-white text-xs font-semibold tracking-wide uppercase rounded-full whitespace-nowrap">{plan.badge}</span>
            )}
            <div class="mb-6">
              <p class="text-sm font-medium text-slate-500 mb-1">{plan.name}</p>
              <p class="text-xs text-slate-400 mb-4">{plan.tagline}</p>
              {plan.price ? (
                <div class="flex items-baseline gap-1">
                  <span class="text-5xl font-bold text-navy">€{plan.price.toLocaleString('nl-NL')}</span>
                  <span class="text-sm text-slate-500">/maand</span>
                </div>
              ) : (
                <span class="text-3xl font-bold text-navy">Op maat</span>
              )}
              <p class="text-xs text-slate-400 mt-1">Excl. 21% btw</p>
            </div>
            <ul class="space-y-3 mb-8 flex-1">
              {plan.features.map(f => (
                <li class="flex items-start gap-2.5 text-sm">
                  {f.ok ? (
                    <svg class="w-4 h-4 mt-0.5 flex-shrink-0 text-brand-emerald" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                  ) : (
                    <svg class="w-4 h-4 mt-0.5 flex-shrink-0 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                  )}
                  <span class:list={[f.ok ? 'text-slate-700' : 'text-slate-400']}>{f.text}</span>
                </li>
              ))}
            </ul>
            {plan.id === 'partner' ? (
              <a href="/contact/?type=offerte&plan=partner" class="btn-outline text-sm w-full justify-center">Offerte aanvragen</a>
            ) : (
              <a href={`/aanvragen/?plan=${plan.id}`} class:list={['text-sm w-full justify-center', plan.badge ? 'btn-primary' : 'btn-outline']}>
                Start met {plan.name}
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
              </a>
            )}
          </div>
        ))}
      </div>
      <p class="text-center text-xs text-slate-400 mt-6">Alle prijzen exclusief 21% btw · Eenmalige setup-kosten op offerte · Maandelijks opzegbaar</p>
    </div>
  </section>

  <!-- AI-Website Bundel promo -->
  <section class="section bg-gradient-to-br from-brand-indigo/5 via-white to-brand-rose/5 border-y border-slate-200">
    <div class="container-page max-w-5xl">
      <div class="grid lg:grid-cols-3 gap-8 items-center">
        <div class="lg:col-span-2 reveal">
          <span class="pill bg-brand-indigo/10 text-brand-indigo text-[11px] mb-3">Bundel — meest voordelig</span>
          <h2 class="text-2xl lg:text-3xl font-bold tracking-tightest text-navy mb-3">Of liever website + AI in één pakket?</h2>
          <p class="text-slate-600 leading-relaxed mb-4">Bouwen we ook uw website of webshop? Dan is de <a href="/diensten/ai-website-bundel-mkb-nederland/" class="text-brand-indigo hover:underline font-medium">AI-Website Bundel</a> de slimste keuze: website Groei + Marco + Emma in één traject met één partij. Bespaart €8.014 in jaar 1 vergeleken met losse afname.</p>
          <ul class="grid sm:grid-cols-2 gap-2 mb-6">
            {[
              'AI-ready website (Astro/Next/WordPress)',
              'Marco — 24/7 telefoon-AI',
              'Emma — WhatsApp + cart-recovery',
              'Schema.org + Speakable + WCAG 2.2 AA',
            ].map(d => (
              <li class="flex items-start gap-2 text-sm text-slate-700">
                <svg class="w-4 h-4 mt-0.5 flex-shrink-0 text-brand-emerald" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                {d}
              </li>
            ))}
          </ul>
          <div class="flex flex-wrap gap-3">
            <a href="/diensten/ai-website-bundel-mkb-nederland/" class="btn-primary text-sm">Bekijk AI-Website Bundel<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></a>
            <a href="/diensten/website-laten-maken-mkb-nederland-2026/" class="btn-outline text-sm">Alleen website</a>
            <a href="/diensten/webshop-laten-maken-shopify-woocommerce-nederland-2026/" class="btn-outline text-sm">Alleen webshop</a>
          </div>
        </div>
        <div class="bg-white rounded-2xl border-2 border-brand-indigo/30 shadow-xl p-6 reveal reveal-delay-1">
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-400 mb-2">Bundel prijs</p>
          <div class="flex items-baseline gap-2 mb-1">
            <span class="text-4xl font-bold text-navy">€4.950</span>
            <span class="text-sm text-slate-500">setup</span>
          </div>
          <div class="flex items-baseline gap-2 mb-4">
            <span class="text-2xl font-bold text-brand-indigo">+ €397</span>
            <span class="text-sm text-slate-500">/maand</span>
          </div>
          <div class="pt-4 border-t border-slate-200">
            <p class="text-xs text-slate-500 mb-1">Vergelijk losse afname:</p>
            <p class="text-sm text-slate-700"><span class="line-through text-slate-400">€17.342</span> → <span class="font-bold text-brand-emerald">−€8.014 jaar 1</span></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Comparison table -->
  <section class="section bg-slate-50/60 border-y border-slate-200">
    <div class="container-page max-w-4xl mx-auto">
      <div class="mb-10 reveal">
        <p class="eyebrow mb-2">Vergelijking</p>
        <h2 class="text-2xl font-bold text-navy">Alles naast elkaar.</h2>
      </div>
      <div class="overflow-x-auto reveal reveal-delay-1">
        <table class="w-full text-sm border-collapse">
          <thead>
            <tr class="border-b border-slate-200">
              <th class="text-left py-4 pr-6 text-slate-500 font-medium w-1/2">Functie</th>
              <th class="text-center py-4 px-4 font-bold text-navy">Starter<br/><span class="text-xs font-normal text-slate-400">€597/mnd</span></th>
              <th class="text-center py-4 px-4 font-bold text-navy bg-navy/5 rounded-t-xl">Groei<br/><span class="text-xs font-normal text-slate-400">€1.197/mnd</span></th>
              <th class="text-center py-4 px-4 font-bold text-navy">Partner<br/><span class="text-xs font-normal text-slate-400">Op maat</span></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {[
              ['Gesprekken per maand', '150', 'Onbeperkt', 'Onbeperkt'],
              ['Marco — AI Telefoniste', '✓', '✓', '✓'],
              ['Emma — WhatsApp AI', '—', '✓', '✓'],
              ['Callscripts', '1', '3', 'Onbeperkt'],
              ['Lead-routering (e-mail)', '✓', '✓', '✓'],
              ['Dashboard + transcripts', '✓', '✓', '✓'],
              ['Gespreksopnames', '—', '✓', '✓'],
              ['CRM-integratie', '—', '✓', '✓'],
              ['Telegram-routering', '—', '✓', '✓'],
              ['Workflow automation', '—', 'Basis', 'Custom'],
              ['Multi-team routing', '—', '—', '✓'],
              ['SLA 99.9% uptime', '—', '—', '✓'],
              ['Dedicated account manager', '—', '—', '✓'],
              ['On-premise optie', '—', '—', '✓'],
              ['Support reactietijd', '< 24 uur', '< 4 uur', '< 1 uur'],
              ['Live binnen', '10 dgn', '7 dgn', '14 dgn'],
            ].map(([feature, starter, groei, partner]) => (
              <tr>
                <td class="py-3 pr-6 text-slate-700">{feature}</td>
                <td class="py-3 px-4 text-center text-slate-500">{starter}</td>
                <td class="py-3 px-4 text-center text-navy font-medium bg-navy/5">{groei}</td>
                <td class="py-3 px-4 text-center text-slate-500">{partner}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Trust signals -->
  <section class="section-tight bg-white border-b border-slate-200">
    <div class="container-page">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        {[
          { icon: '🔒', label: 'AVG-compliant', sub: 'Data in Nederland' },
          { icon: '🇳🇱', label: 'Nederlands bedrijf', sub: 'KVK: 88606902' },
          { icon: '⚡', label: 'Live in 7 werkdagen', sub: 'Snelle implementatie' },
          { icon: '🔓', label: 'Geen vendor lock-in', sub: 'n8n self-hosted' },
        ].map(t => (
          <div class="reveal">
            <div class="text-2xl mb-2">{t.icon}</div>
            <p class="text-sm font-medium text-navy">{t.label}</p>
            <p class="text-xs text-slate-500 mt-0.5">{t.sub}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container-page max-w-3xl mx-auto">
      <div class="mb-10 reveal">
        <p class="eyebrow mb-2">FAQ</p>
        <h2 class="text-2xl font-bold text-navy">Veelgestelde vragen over tarieven.</h2>
      </div>
      <div class="space-y-3">
        {faqItems.map(item => (
          <details class="card group reveal">
            <summary class="flex items-center justify-between cursor-pointer list-none">
              <span class="text-base font-bold text-navy pr-6">{item.question}</span>
              <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <p class="mt-4 text-sm text-slate-600 leading-relaxed">{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="section-tight bg-midnight text-pearl relative overflow-hidden">
    <div class="absolute inset-0 dot-grid opacity-[0.04]"></div>
    <div class="container-page relative max-w-3xl">
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tightest text-pearl text-balance reveal">Twijfelt u nog? Plan eerst een gratis AI scan.</h2>
      <p class="mt-4 text-slate-300 leading-relaxed reveal reveal-delay-1">Geen creditcard vereist. We berekenen samen de ROI voor uw specifieke situatie. Daarna beslist u rustig.</p>
      <div class="mt-6 flex flex-col sm:flex-row gap-3 reveal reveal-delay-2">
        <a href="/gratis-ai-scan/" class="btn bg-pearl text-navy hover:bg-white text-base px-6 py-3.5">Gratis AI Scan aanvragen<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></a>
        <a href="/aanvragen/?plan=groei" class="btn border border-slate-700 text-pearl hover:bg-slate-800 text-base px-6 py-3.5">Direct Groei starten</a>
      </div>
    </div>
  </section>
</BaseLayout>
