---
import BaseLayout from '../layouts/BaseLayout.astro';

const products = [
  {
    name: 'Marco — AI sekreter',
    description: 'AI-receptionist die uw telefoon 24/7 aanneemt',
    plans: [
      { name: 'Starter', price: '€297', frequency: '/maand', features: ['Tot 200 gesprekken/maand', '1 callscript', 'E-mail lead-routering'] },
      { name: 'Groei', price: '€497', frequency: '/maand', highlight: true, features: ['Onbeperkte gesprekken', 'Tot 5 callscripts', 'CRM-integratie + Telegram'] },
      { name: 'Enterprise', price: 'op maat', frequency: '', features: ['Multi-team routing', 'Dedicated account manager', 'SLA + 99.9% uptime'] },
    ],
  },
  {
    name: 'Emma — WhatsApp agent',
    description: 'AI-assistent voor klantvragen via WhatsApp',
    plans: [
      { name: 'Starter', price: '€247', frequency: '/maand', features: ['Tot 500 gesprekken/maand', 'Eigen kennisbank', 'Standaard handover'] },
      { name: 'Groei', price: '€397', frequency: '/maand', highlight: true, features: ['Onbeperkte gesprekken', 'Custom kennisbank', 'CRM-koppeling'] },
      { name: 'Enterprise', price: 'op maat', frequency: '', features: ['Multi-channel inbox', 'Dedicated support', 'SLA + monitoring'] },
    ],
  },
  {
    name: 'Custom AI workflow',
    description: 'Maatwerk-automatisering, gebouwd voor uw bedrijf',
    plans: [
      { name: 'Pilot', price: 'vanaf €4.500', frequency: 'eenmalig', features: ['1 gerichte workflow', 'Audit + bouw', 'Training inbegrepen'] },
      { name: 'Project', price: 'vanaf €12.500', frequency: 'eenmalig', highlight: true, features: ['Tot 5 workflows', '8-12 weken doorlooptijd', 'Onderhoud 6 maanden'] },
      { name: 'Strategisch', price: 'op maat', frequency: '', features: ['Volledige AI-roadmap', 'Multi-jaar partnerschap', 'In-huis team-training'] },
    ],
  },
];
---

<BaseLayout
  title="Tarieven · Aanloop AI"
  description="Transparante tarieven voor onze AI-oplossingen. Vanaf €247/maand voor kant-en-klare assistenten, custom projecten vanaf €4.500."
>
  <section class="border-b border-slate-200">
    <div class="container-page py-16 lg:py-24">
      <div class="max-w-3xl">
        <div class="flex items-center gap-4 mb-6">
          <div class="accent-band"><span></span><span></span><span></span><span></span></div>
          <span class="eyebrow">Tarieven</span>
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tightest text-navy text-balance leading-[1.05]">
          Eerlijke prijzen, geen verrassingen.
        </h1>
        <p class="mt-6 text-lg lg:text-xl text-slate-600 leading-relaxed text-pretty max-w-2xl">
          Voor onze kant-en-klare producten betaalt u één vast bedrag per maand.
          Maandelijks opzegbaar, geen lange contracten. Custom projecten op maat geprijsd na de audit-fase.
        </p>
      </div>
    </div>
  </section>

  {products.map((product, idx) => (
    <section class:list={['section', idx % 2 === 1 && 'bg-slate-50/60 border-y border-slate-200']}>
      <div class="container-page">
        <div class="max-w-3xl mb-12">
          <h2 class="text-2xl lg:text-3xl font-bold tracking-tighter-2 text-navy">{product.name}</h2>
          <p class="mt-2 text-slate-600">{product.description}</p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          {product.plans.map((plan) => (
            <div class:list={['card relative', plan.highlight && 'border-2 border-navy shadow-xl']}>
              {plan.highlight && (
                <span class="absolute -top-3 left-6 px-2.5 py-0.5 bg-navy text-white text-[11px] font-medium tracking-wide uppercase rounded">
                  Aanbevolen
                </span>
              )}
              <div class="text-sm font-medium text-slate-500 mb-1">{plan.name}</div>
              <div class="flex items-baseline gap-1.5 mb-6">
                <span class="text-4xl font-bold text-navy">{plan.price}</span>
                {plan.frequency && <span class="text-sm text-slate-500">{plan.frequency}</span>}
              </div>
              <ul class="space-y-2.5 mb-8">
                {plan.features.map((f) => (
                  <li class="flex items-start gap-2 text-sm text-slate-700">
                    <svg class="w-4 h-4 mt-0.5 flex-shrink-0 text-brand-emerald" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                    <span>{f}</span>
                  </li>
                ))}
              </ul>
              <a href="/contact/" class:list={['block text-center w-full', plan.highlight ? 'btn-primary' : 'btn-outline']}>
                Vraag offerte aan
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="section-tight">
    <div class="container-page">
      <div class="max-w-3xl">
        <h2 class="text-2xl lg:text-3xl font-bold tracking-tighter-2 text-navy mb-6">Veelgestelde vragen over tarieven</h2>
        <div class="space-y-4">
          {[
            { q: 'Zijn de prijzen exclusief btw?', a: 'Ja, alle prijzen op deze pagina zijn exclusief 21% btw. Dit is standaard voor B2B-tarieven in Nederland.' },
            { q: 'Wat zit er bij de maandelijkse abonnementen inbegrepen?', a: 'Hosting, onderhoud, updates, support, en alle gespreks-/berichtkosten. U betaalt nooit extra voor het verbruik. Eenmalige setup-kosten worden apart vermeld in de offerte.' },
            { q: 'Kan ik tussendoor opschalen of afschalen?', a: 'Ja. U kunt op elk moment switchen tussen Starter, Groei en Enterprise. Bij upgraden is de nieuwe prijs direct actief, bij downgraden vanaf de volgende factuurperiode.' },
            { q: 'Wat is de opzegtermijn?', a: 'De maandabonnementen zijn maandelijks opzegbaar. Custom projecten hebben een vaste doorlooptijd zoals afgesproken in het contract.' },
          ].map((item) => (
            <details class="card group">
              <summary class="flex items-center justify-between cursor-pointer list-none">
                <span class="text-base font-bold text-navy pr-6">{item.q}</span>
                <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
              </summary>
              <p class="mt-4 text-sm text-slate-600 leading-relaxed">{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
