<script>
  const toggle = document.getElementById('billing-toggle') as HTMLButtonElement;
  const knob = document.getElementById('toggle-knob') as HTMLElement;
  const labelMonthly = document.getElementById('label-monthly') as HTMLElement;
  const labelAnnual = document.getElementById('label-annual') as HTMLElement;
  const prices = document.querySelectorAll('.price-display') as NodeListOf<HTMLElement>;
  const annualNotes = document.querySelectorAll('.annual-note') as NodeListOf<HTMLElement>;

  let isAnnual = false;

  toggle?.addEventListener('click', () => {
    isAnnual = !isAnnual;
    toggle.setAttribute('aria-checked', String(isAnnual));

    if (isAnnual) {
      toggle.classList.replace('bg-slate-200', 'bg-brand-indigo');
      knob.style.transform = 'translateX(24px)';
      labelMonthly.classList.replace('text-navy', 'text-slate-500');
      labelAnnual.classList.replace('text-slate-500', 'text-navy');
      annualNotes.forEach(n => n.classList.remove('hidden'));
    } else {
      toggle.classList.replace('bg-brand-indigo', 'bg-slate-200');
      knob.style.transform = 'translateX(0)';
      labelMonthly.classList.replace('text-slate-500', 'text-navy');
      labelAnnual.classList.replace('text-navy', 'text-slate-500');
      annualNotes.forEach(n => n.classList.add('hidden'));
    }

    prices.forEach(el => {
      const monthly = parseInt(el.dataset.monthly || '0');
      const annual = parseInt(el.dataset.annual || '0');
      el.textContent = isAnnual ? `€${annual}` : `€${monthly}`;
    });
  });
</script>

