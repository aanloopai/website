    <script is:inline>
      (function() {
        const fmt = n => '€' + Math.round(n).toLocaleString('nl-NL');
        const tiers = document.querySelectorAll('.tco-tier-btn');
        const fte = document.getElementById('tco-fte');
        const fteVal = document.getElementById('tco-fte-val');
        const salary = document.getElementById('tco-salary');
        const aanloop = document.getElementById('tco-aanloop');
        const aanloopDetail = document.getElementById('tco-aanloop-detail');
        const fteTotal = document.getElementById('tco-fte-total');
        const fteDetail = document.getElementById('tco-fte-detail');
        const saving = document.getElementById('tco-saving');
        const savingPct = document.getElementById('tco-saving-pct');
        const payback = document.getElementById('tco-payback');
        const monthly = document.getElementById('tco-monthly');

        let activeMonthly = 1197;
        let activeSetup = 795;

        function recalc() {
          const fteVals = parseFloat(fte.value);
          const sal = parseFloat(salary.value) || 0;
          const aanloopTco = activeSetup + activeMonthly * 60;
          const fteTco = sal * fteVals * 5;
          const savingAbs = fteTco - aanloopTco;
          const savingPctVal = aanloopTco > 0 ? (savingAbs / aanloopTco) * 100 : 0;
          const ftePerMonth = (sal * fteVals) / 12;
          const monthlyDiff = ftePerMonth - activeMonthly;
          const paybackMonths = monthlyDiff > 0 ? activeSetup / monthlyDiff : Infinity;

          fteVal.textContent = fteVals.toString().replace('.', ',') + ' FTE';
          aanloop.textContent = fmt(aanloopTco);
          aanloopDetail.textContent = 'Setup ' + fmt(activeSetup) + ' + ' + fmt(activeMonthly) + ' × 60';
          fteTotal.textContent = fmt(fteTco);
          fteDetail.textContent = fmt(sal) + ' × ' + fteVals.toString().replace('.', ',') + ' × 5';
          monthly.textContent = fmt(activeMonthly) + '/mnd';

          if (savingAbs > 0) {
            saving.textContent = fmt(savingAbs);
            saving.classList.remove('text-rose-600');
            saving.classList.add('text-brand-emerald');
            savingPct.textContent = 'ROI: ' + savingPctVal.toFixed(1).replace('.', ',') + '% over 5 jaar';
          } else {
            saving.textContent = fmt(savingAbs);
            saving.classList.add('text-rose-600');
            saving.classList.remove('text-brand-emerald');
            savingPct.textContent = 'Aanloop kost meer dan een mens — gebruik Lite-tier of overweeg Marco-Starter';
          }

          if (isFinite(paybackMonths) && paybackMonths > 0) {
            payback.textContent = paybackMonths < 1 ? '< 1 mnd' : paybackMonths.toFixed(1).replace('.', ',') + ' mnd';
          } else if (activeSetup === 0) {
            payback.textContent = 'Direct (geen setup)';
          } else {
            payback.textContent = 'n.v.t.';
          }
        }

        tiers.forEach(btn => {
          btn.addEventListener('click', () => {
            tiers.forEach(b => b.setAttribute('aria-checked', 'false'));
            btn.setAttribute('aria-checked', 'true');
            activeMonthly = parseFloat(btn.dataset.monthly);
            activeSetup = parseFloat(btn.dataset.setup);
            recalc();
          });
        });

        fte.addEventListener('input', recalc);
        salary.addEventListener('input', recalc);
        recalc();
      })();
    </script>
