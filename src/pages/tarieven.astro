---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import dashboardMockup from '../assets/images/dashboard-mockup.png';

// ── Pricing logic ──────────────────────────────────────────────
// Market research (NL AI bureau markt, mei 2026):
// - Basis AI receptionist tools: €75–€300/mnd (zelf instellen, geen begeleiding)
// - Managed AI bureau (beheerd, getraind): €500–€1.200/mnd
// - Aanloop AI positionering: premium managed service, NL-native voice AI
// - USP: 7-dagenlive, ElevenLabs NL stem, beheerd = premium gerechtvaardigd
// Prijsstrategie: 3 pakketten, helder, geen addon-verwarring
// Starter: laagdrempelig instap → groei-pad
// Groei:   meest gekozene → combo Marco+Emma = volledige automatisering
// Partner: voor serieuze MKB's, maatwerk + dedicated

const plans = [
  {
    id: 'starter',
    name: 'Starter',
    tagline: 'Eerste stap naar AI automatisering',
    price: { monthly: 597, annual: 497 },
    badge: null,
    highlight: false,
    includes: 'Marco — AI Telefoniste',
    features: [
      { text: 'Marco — AI telefoniste (24/7)', included: true },
      { text: 'Tot 150 gesprekken/maand', included: true },
      { text: '1 callscript op maat', included: true },
      { text: 'Lead-melding via e-mail', included: true },
      { text: 'Agenda-integratie (Google / Outlook)', included: true },
      { text: 'Dashboard + gespreks­transcripts', included: true },
      { text: 'Live binnen 10 werkdagen', included: true },
      { text: 'WhatsApp AI (Emma)', included: false },
      { text: 'CRM-integratie', included: false },
      { text: 'Workflow automation', included: false },
    ],
    cta: 'Start met Starter',
    ctaHref: '/aanvragen/?plan=starter',
  },
  {
    id: 'groei',
    name: 'Groei',
    tagline: 'Telefoon + WhatsApp volledig geautomatiseerd',
    price: { monthly: 1197, annual: 997 },
    badge: 'Meest gekozen',
    highlight: true,
    includes: 'Marco + Emma',
    features: [
      { text: 'Marco — AI telefoniste (24/7)', included: true },
      { text: 'Onbeperkte gesprekken', included: true },
      { text: 'Tot 3 callscripts op maat', included: true },
      { text: 'Emma — WhatsApp AI agent', included: true },
      { text: 'Lead-melding via e-mail + Telegram', included: true },
      { text: 'Agenda-integratie + CRM (HubSpot / Pipedrive)', included: true },
      { text: 'Dashboard + transcripts + opnames', included: true },
      { text: 'Live binnen 7 werkdagen', included: true },
      { text: 'Prioriteit support (reactie < 4 uur)', included: true },
      { text: 'Workflow automation (basis)', included: false },
    ],
    cta: 'Start met Groei',
    ctaHref: '/aanvragen/?plan=groei',
  },
  {
    id: 'partner',
    name: 'Partner',
    tagline: 'Volledige AI automatisering op maat',
    price: { monthly: null, annual: null },
    badge: null,
    highlight: false,
    includes: 'Marco + Emma + Custom Workflows',
    features: [
      { text: 'Marco + Emma (onbeperkt)', included: true },
      { text: 'Onbeperkte callscripts', included: true },
      { text: 'Custom n8n workflow automation', included: true },
      { text: 'Multi-team routing & escalatie', included: true },
      { text: 'Dedicated account manager', included: true },
      { text: 'SLA 99.9% uptime garantie', included: true },
      { text: 'Maatwerk CRM/ERP integraties', included: true },
      { text: 'Live binnen 14 werkdagen', included: true },
      { text: 'Maandelijks optimalisatie-overleg', included: true },
      { text: 'On-premise of private cloud optie', included: true },
    ],
    cta: 'Offerte aanvragen',
    ctaHref: '/contact/?type=offerte&plan=partner',
  },
];

const eenmaligSetup = [
  { plan: 'Starter', prijs: '€495', desc: 'Eenmalig — inclusief intake, training, configuratie en go-live begeleiding' },
  { plan: 'Groei', prijs: '€795', desc: 'Eenmalig — inclusief Marco + Emma setup, CRM-koppeling en testfase' },
  { plan: 'Partner', prijs: 'Op offerte', desc: 'Afhankelijk van scope, integraties en workflows' },
];

const faqs = [
  { q: 'Zijn de prijzen exclusief btw?', a: 'Ja, alle prijzen zijn exclusief 21% btw. Dit is standaard voor B2B-diensten in Nederland.' },
  { q: 'Wat zijn de eenmalige setup-kosten?', a: 'Starter: €495 eenmalig. Groei: €795 eenmalig. Dit dekt de intake, training op uw bedrijf, technische configuratie en go-live begeleiding. Partner is op offerte.' },
  { q: 'Wat is inbegrepen in het maandabonnement?', a: 'Hosting, onderhoud, platform-updates, monitoring en support. U betaalt nooit extra per gesprek of bericht. Alle gesprekskosten zijn inbegrepen in uw pakket.' },
  { q: 'Hoe werkt jaarlijkse betaling?', a: 'Bij jaarlijkse betaling bespaart u circa 16% (±2 maanden gratis). U betaalt het volledige jaarbedrag vooruit en ontvangt één factuur per jaar.' },
  { q: 'Kan ik maandelijks opzeggen?', a: 'Maandabonnementen zijn maandelijks opzegbaar met één maand opzegtermijn. Geen boetes, geen gedoe.' },
  { q: 'Hoe snel ben ik live?', a: 'Starter: gemiddeld 10 werkdagen. Groei: 7 werkdagen. Partner: 14 werkdagen afhankelijk van de scope. Na ondertekening ontvangt u direct een onboarding-plan.' },
  { q: 'Kan ik upgraden van Starter naar Groei?', a: 'Ja, u kunt op elk moment upgraden. U betaalt alleen het verschil in abonnement. De setupkosten voor de extra diensten (Emma) worden apart verrekend.' },
  { q: 'Is er een gratis proefperiode?', a: 'We bieden geen automatische proefperiode, maar wel een gratis AI scan van 30 minuten en een live demo. U ziet het systeem in actie voordat u beslist.' },
];

const vergelijkRows = [
  ['Gesprekken per maand', '150', 'Onbeperkt', 'Onbeperkt'],
  ['AI Telefoniste (Marco)', '✓', '✓', '✓'],
  ['WhatsApp AI (Emma)', '—', '✓', '✓'],
  ['Callscripts', '1', '3', 'Onbeperkt'],
  ['Agenda-integratie', '✓', '✓', '✓'],
  ['CRM-integratie', '—', '✓', '✓'],
  ['Workflow automation', '—', 'Basis', 'Custom'],
  ['Lead-melding Telegram', '—', '✓', '✓'],
  ['Gespreksopnames', '—', '✓', '✓'],
  ['Dedicated account manager', '—', '—', '✓'],
  ['SLA 99.9% uptime', '—', '—', '✓'],
  ['Support reactietijd', '< 24 uur', '< 4 uur', '< 1 uur'],
  ['Live binnen', '10 dgn', '7 dgn', '14 dgn'],
];

// Product + Offer schema per tier — AI Overview citation trigger (P1 audit fix)
const productOfferGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Product',
      '@id': 'https://aanloopai.nl/tarieven/#starter',
      name: 'Aanloop AI — Starter',
      description: 'AI telefoniste Marco voor Nederlandse MKB. 150 gesprekken per maand, 1 callscript op maat, agenda-integratie en dashboard. Live binnen 10 werkdagen.',
      brand: { '@type': 'Brand', name: 'Aanloop AI' },
      category: 'AI Voice Agent / AI Receptionist',
      offers: {
        '@type': 'Offer',
        price: '597',
        priceCurrency: 'EUR',
        priceSpecification: {
          '@type': 'UnitPriceSpecification',
          price: '597',
          priceCurrency: 'EUR',
          unitText: 'maand',
          referenceQuantity: { '@type': 'QuantitativeValue', value: 1, unitText: 'maand' },
        },
        availability: 'https://schema.org/InStock',
        url: 'https://aanloopai.nl/aanvragen/?plan=starter',
        seller: { '@type': 'Organization', name: 'Aanloop AI', url: 'https://aanloopai.nl' },
        eligibleRegion: { '@type': 'Country', name: 'Nederland' },
        priceValidUntil: '2026-12-31',
      },
    },
    {
      '@type': 'Product',
      '@id': 'https://aanloopai.nl/tarieven/#groei',
      name: 'Aanloop AI — Groei',
      description: 'Marco AI telefoniste + Emma WhatsApp AI agent voor Nederlandse MKB. Onbeperkte gesprekken, CRM-integratie (HubSpot/Pipedrive), dashboard met opnames, prioriteit support. Live binnen 7 werkdagen.',
      brand: { '@type': 'Brand', name: 'Aanloop AI' },
      category: 'AI Voice + WhatsApp Agent Bundle',
      offers: {
        '@type': 'Offer',
        price: '1197',
        priceCurrency: 'EUR',
        priceSpecification: {
          '@type': 'UnitPriceSpecification',
          price: '1197',
          priceCurrency: 'EUR',
          unitText: 'maand',
          referenceQuantity: { '@type': 'QuantitativeValue', value: 1, unitText: 'maand' },
        },
        availability: 'https://schema.org/InStock',
        url: 'https://aanloopai.nl/aanvragen/?plan=groei',
        seller: { '@type': 'Organization', name: 'Aanloop AI', url: 'https://aanloopai.nl' },
        eligibleRegion: { '@type': 'Country', name: 'Nederland' },
        priceValidUntil: '2026-12-31',
      },
    },
    {
      '@type': 'Product',
      '@id': 'https://aanloopai.nl/tarieven/#partner',
      name: 'Aanloop AI — Partner',
      description: 'Volledige AI automatisering op maat met dedicated account manager, custom n8n workflows, multi-team routing, SLA 99.9%, on-premise/private cloud optie en maatwerk CRM/ERP integraties.',
      brand: { '@type': 'Brand', name: 'Aanloop AI' },
      category: 'Enterprise AI Agent Suite',
      offers: {
        '@type': 'Offer',
        priceSpecification: {
          '@type': 'PriceSpecification',
          priceCurrency: 'EUR',
          description: 'Op maat — offerte binnen 24 uur',
        },
        availability: 'https://schema.org/InStock',
        url: 'https://aanloopai.nl/contact/?type=offerte&plan=partner',
        seller: { '@type': 'Organization', name: 'Aanloop AI', url: 'https://aanloopai.nl' },
        eligibleRegion: { '@type': 'Country', name: 'Nederland' },
      },
    },
  ],
};

// Aanloop vs zelf-service AI-tools — fair compare (no rival names) value-justification
const valueCompareRows = [
  { feature: 'Implementatie + training inbegrepen', selfService: 'Nee — zelf prompts, scripts, koppelingen', aanloop: 'Ja — wij brengen u live binnen 7-10 werkdagen' },
  { feature: 'Nederlandstalige NL-native voice', selfService: 'Vaak Engels accent of beperkte stemmen', aanloop: 'ElevenLabs NL — natuurlijke intonatie' },
  { feature: 'Data uitsluitend in EU + AVG-strict', selfService: 'Vaak US/global cloud', aanloop: 'EU-only datacenters, AVG art. 28 verwerkers­overeenkomst' },
  { feature: 'KvK-geregistreerd Nederlands bedrijf', selfService: 'Vaak buitenlandse vendor', aanloop: 'KVK 88606902, Rotterdam — NL-aansprakelijk' },
  { feature: 'CRM-integratie (HubSpot/Pipedrive)', selfService: 'Tegen meerprijs of zelf bouwen', aanloop: 'Inbegrepen vanaf Groei' },
  { feature: 'Maandelijkse optimalisatie + script-updates', selfService: 'Doet u zelf', aanloop: 'Wij verbeteren Marco elke maand op uw data' },
  { feature: 'Geen extra kosten per gesprek of minuut', selfService: 'Vaak per minuut/credit', aanloop: 'Vast bedrag, voorspelbaar' },
  { feature: 'Dedicated NL support', selfService: 'E-mail tickets, vaak Engels', aanloop: 'Direct contact NL implementatie-team' },
  { feature: 'Maandelijks opzegbaar', selfService: 'Wisselend', aanloop: 'Ja — geen jaarcontract verplicht' },
];
---

<BaseLayout
  title="Tarieven — AI Agents & Automatisering voor MKB | Aanloop AI"
  description="Transparante tarieven voor Aanloop AI. Starter vanaf €597/mnd, Groei (Marco + Emma) €1.197/mnd. Geen verborgen kosten. Maandelijks opzegbaar. KVK: 88606902."
  schema={productOfferGraph}
  faqSchema={faqs.map(f => ({ question: f.q, answer: f.a }))}
>

  <!-- Hero -->
  <section class="border-b border-slate-200 hero-gradient">
    <div class="container-page py-16 lg:py-24">
      <div class="max-w-3xl">
        <div class="flex items-center gap-4 mb-6 reveal">
          <div class="accent-band"><span></span><span></span><span></span><span></span></div>
          <span class="eyebrow">Tarieven</span>
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tightest text-navy text-balance leading-[1.05] reveal reveal-delay-1">
          Eerlijke prijzen,<br/>geen verrassingen.
        </h1>
        <p class="mt-6 text-lg lg:text-xl text-slate-600 leading-relaxed text-pretty max-w-2xl reveal reveal-delay-2">
          Één vast bedrag per maand. Geen extra kosten per gesprek. Maandelijks opzegbaar. Eenmalige setup apart vermeld — geen kleine lettertjes.
        </p>

        <!-- Billing toggle -->
        <div class="mt-8 flex items-center gap-4 reveal reveal-delay-3">
          <span id="label-monthly" class="text-sm font-medium text-navy">Maandelijks</span>
          <button
            id="billing-toggle"
            role="switch"
            aria-checked="false"
            class="relative w-12 h-6 rounded-full bg-slate-200 transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-brand-indigo focus:ring-offset-2"
          >
            <span class="absolute left-1 top-1 w-4 h-4 rounded-full bg-white shadow transition-transform duration-200" id="toggle-knob"></span>
          </button>
          <span id="label-annual" class="text-sm font-medium text-slate-500">
            Jaarlijks
            <span class="ml-1.5 inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-medium bg-brand-emerald/10 text-brand-emerald">Bespaar 16%</span>
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing cards -->
  <section class="section">
    <div class="container-page">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
        {plans.map((plan) => (
          <div class:list={[
            'relative rounded-2xl p-8 flex flex-col reveal',
            plan.highlight
              ? 'border-2 border-navy shadow-2xl bg-white scale-[1.02]'
              : 'border border-slate-200 bg-white',
          ]}>
            {plan.badge && (
              <span class="absolute -top-3.5 left-1/2 -translate-x-1/2 px-4 py-1 bg-navy text-white text-xs font-semibold tracking-wide uppercase rounded-full whitespace-nowrap">
                {plan.badge}
              </span>
            )}

            <div class="mb-6">
              <p class="text-xs font-semibold uppercase tracking-widest text-brand-indigo mb-1">{plan.includes}</p>
              <p class="text-xl font-bold text-navy">{plan.name}</p>
              <p class="text-sm text-slate-500 mt-1">{plan.tagline}</p>
            </div>

            <div class="mb-6">
              {plan.price.monthly ? (
                <div>
                  <div class="flex items-baseline gap-1">
                    <span class="text-5xl font-bold text-navy price-display" data-monthly={plan.price.monthly} data-annual={plan.price.annual}>
                      €{plan.price.monthly}
                    </span>
                    <span class="text-sm text-slate-500 price-freq">/maand</span>
                  </div>
                  <p class="text-xs text-slate-400 mt-1 annual-note hidden">
                    €{(plan.price.annual ?? 0) * 12}/jaar bij jaarlijkse betaling
                  </p>
                  <p class="text-xs text-slate-400 mt-1">excl. btw + eenmalige setup</p>
                </div>
              ) : (
                <div>
                  <span class="text-3xl font-bold text-navy">Op maat</span>
                  <p class="text-xs text-slate-400 mt-1">Offerte binnen 24 uur</p>
                </div>
              )}
            </div>

            <ul class="space-y-3 mb-8 flex-1">
              {plan.features.map((f) => (
                <li class="flex items-start gap-2.5 text-sm">
                  {f.included ? (
                    <svg class="w-4 h-4 mt-0.5 flex-shrink-0 text-brand-emerald" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                  ) : (
                    <svg class="w-4 h-4 mt-0.5 flex-shrink-0 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                  )}
                  <span class:list={[f.included ? 'text-slate-700' : 'text-slate-400']}>{f.text}</span>
                </li>
              ))}
            </ul>

            <a
              href={plan.ctaHref}
              class:list={[
                'text-sm w-full justify-center',
                plan.highlight ? 'btn-primary' : 'btn-outline',
              ]}
            >
              {plan.cta}
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </a>
          </div>
        ))}
      </div>

      <p class="text-center text-xs text-slate-400 mt-8">Alle prijzen exclusief 21% btw · Maandelijks opzegbaar · Eenmalige setup apart</p>
    </div>
  </section>

  <!-- Setup costs — transparant -->
  <section class="section-tight bg-amber-50/60 border-y border-amber-100">
    <div class="container-page max-w-4xl mx-auto">
      <div class="flex flex-col md:flex-row items-start gap-8">
        <div class="flex-1">
          <p class="text-xs font-semibold uppercase tracking-widest text-amber-700 mb-2">Transparantie</p>
          <h2 class="text-xl font-bold text-navy mb-2">Eenmalige setup-kosten</h2>
          <p class="text-sm text-slate-600">Bij Aanloop AI betaalt u één keer voor de implementatie. Daarna alleen het vaste maandabonnement. Geen verborgen kosten, nooit.</p>
        </div>
        <div class="flex-1 space-y-3 w-full">
          {eenmaligSetup.map(s => (
            <div class="flex items-start justify-between gap-4 bg-white border border-amber-100 rounded-xl px-4 py-3">
              <div>
                <p class="text-sm font-bold text-navy">{s.plan}</p>
                <p class="text-xs text-slate-500 mt-0.5">{s.desc}</p>
              </div>
              <span class="text-sm font-bold text-navy whitespace-nowrap">{s.prijs}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- AI-Website Bundel promo -->
  <section class="section bg-gradient-to-br from-brand-indigo/5 via-white to-brand-rose/5 border-y border-slate-200">
    <div class="container-page max-w-5xl">
      <div class="grid lg:grid-cols-3 gap-8 items-center">
        <div class="lg:col-span-2 reveal">
          <span class="pill bg-brand-indigo/10 text-brand-indigo text-[11px] mb-3">Bundel — meest voordelig</span>
          <h2 class="text-2xl lg:text-3xl font-bold tracking-tightest text-navy mb-3">Of liever website + AI in één pakket?</h2>
          <p class="text-slate-600 leading-relaxed mb-4">Bouwen we ook uw website of webshop? Dan is de <a href="/diensten/ai-website-bundel-mkb-nederland/" class="text-brand-indigo hover:underline font-medium">AI-Website Bundel</a> de slimste keuze: website Groei + Marco + Emma in één traject met één partij. Bespaart €8.014 in jaar 1 vergeleken met losse afname.</p>
          <ul class="grid sm:grid-cols-2 gap-2 mb-6">
            {[
              'AI-ready website (Astro/Next/WordPress)',
              'Marco — 24/7 telefoon-AI',
              'Emma — WhatsApp + cart-recovery',
              'Schema.org + Speakable + WCAG 2.2 AA',
            ].map(d => (
              <li class="flex items-start gap-2 text-sm text-slate-700">
                <svg class="w-4 h-4 mt-0.5 flex-shrink-0 text-brand-emerald" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                {d}
              </li>
            ))}
          </ul>
          <div class="flex flex-wrap gap-3">
            <a href="/diensten/ai-website-bundel-mkb-nederland/" class="btn-primary text-sm">Bekijk AI-Website Bundel<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></a>
            <a href="/diensten/website-laten-maken-mkb-nederland-2026/" class="btn-outline text-sm">Alleen website</a>
            <a href="/diensten/webshop-laten-maken-shopify-woocommerce-nederland-2026/" class="btn-outline text-sm">Alleen webshop</a>
          </div>
        </div>
        <div class="bg-white rounded-2xl border-2 border-brand-indigo/30 shadow-xl p-6 reveal reveal-delay-1">
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-400 mb-2">Bundel prijs</p>
          <div class="flex items-baseline gap-2 mb-1">
            <span class="text-4xl font-bold text-navy">€4.950</span>
            <span class="text-sm text-slate-500">setup</span>
          </div>
          <div class="flex items-baseline gap-2 mb-4">
            <span class="text-2xl font-bold text-brand-indigo">+ €397</span>
            <span class="text-sm text-slate-500">/maand</span>
          </div>
          <div class="pt-4 border-t border-slate-200">
            <p class="text-xs text-slate-500 mb-1">Vergelijk losse afname:</p>
            <p class="text-sm text-slate-700"><span class="line-through text-slate-400">€17.342</span> → <span class="font-bold text-brand-emerald">−€8.014 jaar 1</span></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Aanloop vs zelf-service AI-tools — value justification (Voicelabs-class counter) -->
  <section class="section">
    <div class="container-page max-w-5xl mx-auto">
      <div class="mb-10 text-center reveal">
        <p class="eyebrow mb-3">Waarom Aanloop AI?</p>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tightest text-navy text-balance">
          €597 managed service vs €99–€299 zelf-service tools.
        </h2>
        <p class="mt-4 text-slate-600 leading-relaxed max-w-2xl mx-auto">
          Er zijn AI-receptionist tools vanaf €99/mnd. Op papier voordeliger. In de praktijk betaalt u tijd, integratiewerk en compliance-risico. Hier is wat onze prijs precies dekt.
        </p>
      </div>

      <div class="overflow-x-auto reveal reveal-delay-1">
        <table class="w-full text-sm border-collapse bg-white rounded-2xl overflow-hidden shadow-sm border border-slate-200">
          <thead>
            <tr class="border-b border-slate-200 bg-slate-50">
              <th class="text-left py-4 px-5 text-slate-500 font-medium">Wat krijgt u?</th>
              <th class="text-center py-4 px-4 font-bold text-slate-500 w-[26%]">Zelf-service tools<br/><span class="text-xs font-normal">€99–€299/mnd</span></th>
              <th class="text-center py-4 px-4 font-bold text-navy bg-brand-emerald/5 w-[26%]">Aanloop AI<br/><span class="text-xs font-normal text-brand-emerald">vanaf €597/mnd managed</span></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {valueCompareRows.map(row => (
              <tr>
                <td class="py-3 px-5 text-slate-700 font-medium">{row.feature}</td>
