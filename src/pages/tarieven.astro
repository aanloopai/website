      areaServed: { '@type': 'Country', name: 'Nederland' },
      offers: { '@type': 'Offer', price: '595', priceCurrency: 'EUR', priceSpecification: { '@type': 'UnitPriceSpecification', price: '595', priceCurrency: 'EUR', unitText: 'maand' }, availability: 'https://schema.org/InStock', url: 'https://aanloopai.nl/start/', priceValidUntil: '2026-12-31' },
    },
    {
      '@type': 'Service',
      '@id': 'https://aanloopai.nl/tarieven/#seo-geo-bundel',
      name: 'SEO + GEO Maandelijkse Bundel Nederland',
      serviceType: 'SEO + GEO Combined',
      description: 'Maandelijkse SEO + GEO bundel voor Nederlandse MKB: traditioneel SERP + AI-citation tracking gecombineerd. Bespaart €2.340 per jaar vs losse afname. Eén strategie, één team, één rapportage.',
      provider: { '@type': 'Organization', name: 'Aanloop AI', url: 'https://aanloopai.nl' },
      areaServed: { '@type': 'Country', name: 'Nederland' },
      offers: { '@type': 'Offer', price: '1195', priceCurrency: 'EUR', priceSpecification: { '@type': 'UnitPriceSpecification', price: '1195', priceCurrency: 'EUR', unitText: 'maand' }, availability: 'https://schema.org/InStock', url: 'https://aanloopai.nl/start/', priceValidUntil: '2026-12-31' },
    },
    {
      '@type': 'Service',
      '@id': 'https://aanloopai.nl/tarieven/#enterprise',
      name: 'Aanloop AI — Emma Enterprise',
      serviceType: 'Enterprise AI Agent Suite',
      provider: { '@type': 'Organization', name: 'Aanloop AI', url: 'https://aanloopai.nl' },
      areaServed: { '@type': 'Country', name: 'Nederland' },
      description: 'Emma omnichannel AI-agent op maat voor grotere organisaties: uptime-doel 99,9% (SLA op aanvraag), dedicated accountmanager, custom n8n workflows, white-label optie, on-premise/private cloud optie en maatwerk CRM/ERP-integraties.',
      brand: { '@type': 'Brand', name: 'Aanloop AI' },
      category: 'Enterprise AI Agent Suite',
      // Enterprise heeft geen publieke prijs. Een Offer met alleen een lege
      // PriceSpecification is ongeldig (priceCurrency zonder bedrag), dus staat
      // hier bewust geen offers-blok maar een potentialAction naar de offerte.
      // QuoteAction en niet RequestQuoteAction: dat laatste type bestaat niet
      // in het schema.org-vocabulaire (Ahrefs 2026-08-24: "Invalid schema.org
      // type. Expected types for potentialAction: Action").
      potentialAction: {
        '@type': 'QuoteAction',
        name: 'Offerte aanvragen — binnen 24 uur',
        target: 'https://aanloopai.nl/contact/?type=offerte&plan=enterprise',
      },
    },
  ],
};

// Aanloop vs zelf-service AI-tools — fair compare (no rival names) value-justification
const valueCompareRows = [
  { feature: 'Implementatie + training inbegrepen', selfService: 'Nee — zelf prompts, scripts, koppelingen', aanloop: 'Ja — wij brengen u live binnen 7 werkdagen' },
  { feature: 'Nederlandstalige NL-native voice', selfService: 'Vaak Engels accent of beperkte stemmen', aanloop: 'ElevenLabs NL — natuurlijke intonatie' },
  { feature: 'Data uitsluitend in EU + AVG-strict', selfService: 'Vaak US/global cloud', aanloop: 'EU-only datacenters, AVG art. 28 verwerkers­overeenkomst' },
  { feature: 'KvK-geregistreerd Nederlands bedrijf', selfService: 'Vaak buitenlandse vendor', aanloop: 'KVK 88606902, Rotterdam — NL-aansprakelijk' },
  { feature: 'CRM-integratie (HubSpot/Pipedrive)', selfService: 'Tegen meerprijs of zelf bouwen', aanloop: 'Inbegrepen vanaf Groei' },
  { feature: 'Maandelijkse optimalisatie + script-updates', selfService: 'Doet u zelf', aanloop: 'Wij verbeteren Emma elke maand op uw data' },
  { feature: 'Geen extra kosten per gesprek of minuut', selfService: 'Vaak per minuut/credit', aanloop: 'Vast bedrag, voorspelbaar' },
  { feature: 'Dedicated NL support', selfService: 'E-mail tickets, vaak Engels', aanloop: 'Direct contact NL implementatie-team' },
];

// TCO-calculator default state (Emma tier pre-selected). Setup komt uit EMMA.setup
// (pricing.ts) — tot 2026-07-14 hardcoded op 0, wat de 5-jaars TCO en de payback-tekst
// "Direct (geen setup)" onterecht liet kloppen. Zelfde formule als de client-side recalc().
const fmtEUR = (n: number) => '€' + Math.round(n).toLocaleString('nl-NL');
const tcoDefaultFte = 0.5;
const tcoDefaultSalary = 47520;
// Owner-besluit 2026-08-11: eenmalige setup NIET meer in de publieke TCO-som —
// alleen de maandelijkse 60x-optelsom (excl. setup, op aanvraag).
const tcoAanloopTotal = EMMA.monthly * 60;
const tcoFteTotal = tcoDefaultSalary * tcoDefaultFte * 5;
const tcoSaving = tcoFteTotal - tcoAanloopTotal;
const tcoSavingPct = tcoAanloopTotal > 0 ? (tcoSaving / tcoAanloopTotal) * 100 : 0;
