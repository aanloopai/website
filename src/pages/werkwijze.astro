---
import BaseLayout from '../layouts/BaseLayout.astro';

const werkwijzeStappen = [
  {
    n: '01',
    accent: 'bg-brand-indigo',
    accentText: 'text-brand-indigo',
    accentBg: 'bg-brand-indigo/10',
    title: 'Gratis adviesgesprek (30 min)',
    duration: 'Week 1',
    details: [
      'We leren uw bedrijf, processen en uitdagingen kennen',
      'U ziet een live demo van de AI in uw branche',
      'We bespreken eerlijk wat AI wel én niet kan doen',
      'Geen verplichtingen, geen verkoopgesprek',
    ],
    deliverable: 'Eerlijk advies + globale haalbaarheids-inschatting',
  },
  {
    n: '02',
    accent: 'bg-brand-rose',
    accentText: 'text-brand-rose',
    accentBg: 'bg-brand-rose/10',
    title: 'Voorstel & offerte',
    duration: 'Week 1–2',
    details: [
      'Concreet voorstel met scope, doorlooptijd en vaste prijs',
      'Technische architectuur en integratie-plan',
      'Definitie van succes-KPIs (wat gaan we meten?)',
      'Contractonderhandeling en akkoord',
    ],
    deliverable: 'Getekend contract + onboarding-plan',
  },
  {
    n: '03',
    accent: 'bg-brand-amber',
    accentText: 'text-brand-amber',
    accentBg: 'bg-brand-amber/10',
    title: 'Bouwen & trainen',
    duration: 'Week 2–5',
    details: [
      'Callscripts en kennisbank op maat schrijven',
      'AI trainen op uw producten, diensten en tone-of-voice',
      'Integraties bouwen (CRM, agenda, Telegram)',
      'Intern testen en itereren',
    ],
    deliverable: 'Geconfigureerde, geteste AI-assistent',
  },
  {
    n: '04',
    accent: 'bg-brand-emerald',
    accentText: 'text-brand-emerald',
    accentBg: 'bg-brand-emerald/10',
    title: 'Acceptatietest met uw team',
    duration: 'Week 5',
    details: [
      'Uw team belt/appt de AI en geeft feedback',
      'We finetunen op basis van echte feedback',
      'Escalatieprotocol testen',
      'Go/no-go beslissing samen met u',
    ],
    deliverable: 'Goedgekeurde AI-assistent klaar voor productie',
  },
  {
    n: '05',
    accent: 'bg-brand-indigo',
    accentText: 'text-brand-indigo',
    accentBg: 'bg-brand-indigo/10',
    title: 'Go-live & monitoring',
    duration: 'Week 6',
    details: [
      'Live-gang met begeleiding (u bent niet alleen)',
      'Eerste 48 uur actief monitoren',
      'Team-training en documentatie',
      'Dashboard-toegang en live-rapportage',
    ],
    deliverable: '✓ Aanloop AI live — uw telefoon gaat nooit meer onbeantwoord',
  },
  {
    n: '06',
    accent: 'bg-brand-rose',
    accentText: 'text-brand-rose',
    accentBg: 'bg-brand-rose/10',
    title: 'Doorontwikkelen & optimaliseren',
    duration: 'Maandelijks',
    details: [
      'Maandelijkse rapportage: gesprekken, leads, besparing',
      'Proactieve optimalisaties op basis van data',
      'Nieuwe scripts of integraties toevoegen',
      'Kwartaalreview met accountmanager',
    ],
    deliverable: 'Continue verbetering — AI die steeds slimmer wordt',
  },
];
---

<BaseLayout
  title="Werkwijze · Aanloop AI"
  description="Hoe Aanloop AI werkt: van eerste adviesgesprek tot live AI-assistent in 14 dagen. Stap voor stap uitgelegd."
>
  <section class="border-b border-slate-200 hero-gradient">
    <div class="container-page py-16 lg:py-24">
      <div class="max-w-3xl">
        <div class="flex items-center gap-4 mb-6 reveal">
          <div class="accent-band"><span></span><span></span><span></span><span></span></div>
          <span class="eyebrow">Werkwijze</span>
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tightest text-navy text-balance leading-[1.05] reveal reveal-delay-1">
          Van eerste gesprek<br/>tot live in 14 dagen.
        </h1>
        <p class="mt-6 text-lg text-slate-600 leading-relaxed max-w-2xl reveal reveal-delay-2">
          We geloven in transparantie. Hier is precies hoe een Aanloop AI-implementatie werkt — stap voor stap, met eerlijke doorlooptijden en concrete deliverables.
        </p>
        <div class="mt-8 flex gap-6 items-center reveal reveal-delay-3">
          <div class="text-center">
            <div class="text-3xl font-bold text-navy">14</div>
            <div class="text-xs text-slate-500">werkdagen gemiddeld</div>
          </div>
          <div class="w-px h-10 bg-slate-200"></div>
          <div class="text-center">
            <div class="text-3xl font-bold text-navy">6</div>
            <div class="text-xs text-slate-500">stappen tot live</div>
          </div>
          <div class="w-px h-10 bg-slate-200"></div>
          <div class="text-center">
            <div class="text-3xl font-bold text-navy">100%</div>
            <div class="text-xs text-slate-500">begeleiding</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page">
      <div class="space-y-8 max-w-4xl">
        {werkwijzeStappen.map((stap, i) => (
          <div class={`relative pl-8 reveal reveal-delay-${(i % 4) + 1}`}>
            <!-- Connector line -->
            {i < werkwijzeStappen.length - 1 && (
              <div class="absolute left-[19px] top-12 bottom-0 w-px bg-slate-100 -translate-x-1/2"></div>
            )}

            <div class={`absolute left-0 top-0 w-10 h-10 rounded-xl ${stap.accentBg} flex items-center justify-center`}>
              <span class={`text-xs font-bold ${stap.accentText}`}>{stap.n}</span>
            </div>

            <div class="card ml-4">
              <div class="flex flex-wrap items-start justify-between gap-4 mb-4">
                <div>
                  <h2 class="text-lg font-bold text-navy">{stap.title}</h2>
                </div>
                <span class={`pill ${stap.accentBg} ${stap.accentText} text-[11px]`}>{stap.duration}</span>
              </div>

              <div class="grid md:grid-cols-2 gap-6">
                <ul class="space-y-2">
                  {stap.details.map(d => (
                    <li class="flex items-start gap-2.5 text-sm text-slate-600">
                      <svg class="w-4 h-4 mt-0.5 flex-shrink-0 text-brand-emerald" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                      {d}
                    </li>
                  ))}
                </ul>
                <div class={`${stap.accentBg} rounded-xl p-4 flex flex-col justify-center`}>
                  <p class="text-[11px] font-semibold uppercase tracking-wide text-slate-400 mb-1">Deliverable</p>
                  <p class={`text-sm font-medium ${stap.accentText}`}>{stap.deliverable}</p>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Garanties -->
  <section class="section bg-slate-50/60 border-y border-slate-200">
    <div class="container-page">
      <div class="max-w-3xl mb-12 reveal">
        <p class="eyebrow mb-3">Onze garanties</p>
        <h2 class="text-3xl font-bold tracking-tightest text-navy">Waar u op kunt rekenen.</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {[
          { icon: '⏱️', title: '14-dagen garantie', desc: 'Als u niet live bent binnen 14 werkdagen door onze schuld, krijgt u de eerste maand gratis.' },
          { icon: '📞', title: 'Altijd bereikbaar', desc: 'Tijdens de implementatie heeft u een directe lijn naar uw accountmanager. Geen ticketsysteem.' },
          { icon: '↩️', title: '30-dagen tevredenheids-garantie', desc: 'Tevreden na 30 dagen? Dan gaat u door. Niet tevreden? Dan stoppen we — geen kosten voor resterende periode.' },
        ].map((g, i) => (
          <div class={`card reveal reveal-delay-${i + 1}`}>
            <div class="text-2xl mb-3">{g.icon}</div>
            <h3 class="font-bold text-navy mb-2">{g.title}</h3>
            <p class="text-sm text-slate-600 leading-relaxed">{g.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-tight bg-midnight text-pearl relative overflow-hidden">
    <div class="absolute inset-0 dot-grid opacity-[0.04]"></div>
    <div class="container-page relative">
      <div class="max-w-3xl">
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tightest text-pearl text-balance reveal">
          Klaar om te starten?
        </h2>
        <p class="mt-4 text-slate-300 reveal reveal-delay-1">Plan stap 1 — een gratis adviesgesprek van 30 minuten. Vrijblijvend, geen verplichtingen.</p>
        <div class="mt-6 flex flex-col sm:flex-row gap-3 reveal reveal-delay-2">
          <a href="/demo-aanvragen/" class="btn bg-pearl text-navy hover:bg-white text-base px-6 py-3.5">
            Plan een gratis gesprek
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
