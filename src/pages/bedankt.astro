---
import BaseLayout from '../layouts/BaseLayout.astro';

// Deze pagina is statisch (astro.config.mjs: output 'static'), dus
// Astro.url.searchParams is bij de build altijd leeg. De variant werd hier
// server-side gekozen en viel dus voor iedereen terug op 'aanvraag': wie een
// simpele vraag stelde las "Uw accountmanager neemt contact op voor de
// onboarding-planning". De keuze gebeurt nu client-side op location.search;
// de 'aanvraag'-variant blijft de server-side default zodat er zonder JS
// (en zonder parameter) nog steeds een kloppende pagina staat.
const TELEFOON = '+31 6 24 74 15 97';

const messages = {
  aanvraag: {
    title: 'Aanvraag ontvangen!',
    sub: 'Uw aanvraag is succesvol ingediend. Uw accountmanager neemt binnen 1 werkdag contact op voor de onboarding-planning.',
    next: [
      { href: '/werkwijze/', label: 'Lees hoe onboarding werkt' },
      { href: '/', label: 'Terug naar de homepage' },
    ],
    steps: [
      'U ontvangt een bevestigingsmail binnen enkele minuten.',
      'Onze accountmanager neemt binnen 1 werkdag telefonisch contact op.',
      'We plannen samen het onboarding-gesprek en de demo in.',
      'Live binnen 7 werkdagen na akkoord.',
    ],
  },
  demo: {
    title: 'Demo ingepland!',
    sub: 'U ontvangt een bevestigingsmail met de details. We kijken ernaar uit u te ontmoeten en de AI live te tonen.',
    next: [
      { href: '/cases/', label: 'Lees alvast onze klantcases' },
      { href: '/diensten/', label: 'Bekijk alle diensten' },
    ],
    steps: [
      'U ontvangt een bevestigingsmail met de afspraakdetails.',
      'We bellen kort vooraf om uw situatie door te nemen.',
      'Tijdens de demo ziet u de AI live werken op uw eigen use-case.',
      'Daarna krijgt u een offerte op maat — zonder verplichting.',
    ],
  },
  contact: {
    title: 'Bericht verzonden!',
    sub: `Bedankt voor uw bericht. We reageren binnen 1 werkdag. Heeft u een urgent verzoek? Bel ons direct op ${TELEFOON}.`,
    next: [
      { href: '/', label: 'Terug naar de homepage' },
      { href: '/diensten/', label: 'Bekijk onze diensten' },
    ],
    steps: [
      'U ontvangt een bevestigingsmail binnen enkele minuten.',
      'We lezen uw vraag en zoeken zo nodig iets uit.',
      'U krijgt binnen 1 werkdag antwoord per e-mail of telefoon.',
    ],
  },
};

const msg = messages.aanvraag;
---

<BaseLayout
  title="Bedankt"
  description="Uw aanvraag is ontvangen. Het Aanloop AI-team neemt snel contact op."
  noindex={true}
>
  <section class="min-h-[70vh] flex items-center">
    <div class="container-page py-20">
      <div class="max-w-2xl mx-auto text-center">

        <!-- Success animation -->
        <div class="w-20 h-20 rounded-full bg-brand-emerald/10 flex items-center justify-center mx-auto mb-8 success-circle">
          <svg class="w-10 h-10 text-brand-emerald" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
          </svg>
        </div>

        <div class="accent-band mx-auto mb-6"><span></span><span></span><span></span><span></span></div>

        <h1 id="bedankt-title" class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tightest text-navy text-balance mb-4">
          {msg.title}
        </h1>
        <p id="bedankt-sub" class="text-lg text-slate-600 leading-relaxed mb-10 max-w-lg mx-auto">
          {msg.sub}
        </p>

        <!-- Next steps -->
        <div id="bedankt-next" class="flex flex-col sm:flex-row gap-3 justify-center mb-16">
          {msg.next.map((n, i) => (
            <a href={n.href} class:list={[i === 0 ? 'btn-primary' : 'btn-outline', 'text-base px-6 py-3']}>
              {n.label}
            </a>
          ))}
        </div>

        <!-- What happens next -->
        <div class="card bg-slate-50 border-slate-200 text-left max-w-lg mx-auto">
          <p class="text-xs font-semibold tracking-[0.12em] uppercase text-slate-400 mb-4">Wat nu?</p>
          <ol id="bedankt-steps" class="space-y-4">
            {msg.steps.map((text, i) => (
              <li class="flex gap-4 items-start">
                <span class="w-6 h-6 rounded-full bg-navy text-white text-[11px] font-bold flex items-center justify-center flex-shrink-0 mt-0.5">{i + 1}</span>
                <span class="text-sm text-slate-700">{text}</span>
              </li>
            ))}
          </ol>
        </div>

      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline define:vars={{ messages }}>
  (function () {
    var type = new URLSearchParams(location.search).get('type');
    var msg = messages[type];
    if (!msg || type === 'aanvraag') return;

    var title = document.getElementById('bedankt-title');
    var sub = document.getElementById('bedankt-sub');
    var next = document.getElementById('bedankt-next');
    var steps = document.getElementById('bedankt-steps');

    if (title) title.textContent = msg.title;
    if (sub) sub.textContent = msg.sub;

    if (next) {
      next.textContent = '';
      msg.next.forEach(function (n, i) {
        var a = document.createElement('a');
        a.href = n.href;
        a.className = (i === 0 ? 'btn-primary' : 'btn-outline') + ' text-base px-6 py-3';
        a.textContent = n.label;
        next.appendChild(a);
      });
    }

    if (steps) {
      steps.textContent = '';
      msg.steps.forEach(function (text, i) {
        var li = document.createElement('li');
        li.className = 'flex gap-4 items-start';
        var num = document.createElement('span');
        num.className = 'w-6 h-6 rounded-full bg-navy text-white text-[11px] font-bold flex items-center justify-center flex-shrink-0 mt-0.5';
        num.textContent = String(i + 1);
        var txt = document.createElement('span');
        txt.className = 'text-sm text-slate-700';
        txt.textContent = text;
        li.appendChild(num);
        li.appendChild(txt);
        steps.appendChild(li);
      });
    }
  })();
</script>

<style>
  .success-circle {
    animation: pop-in 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }
  @keyframes pop-in {
    0% { transform: scale(0); opacity: 0; }
    100% { transform: scale(1); opacity: 1; }
  }
  .accent-band {
    width: fit-content;
  }
</style>
