<script>
  const form = document.getElementById('survey-form') as HTMLFormElement;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('submit-btn') as HTMLButtonElement;
    const label = document.getElementById('submit-label') as HTMLElement;
    const errorEl = document.getElementById('form-error') as HTMLElement;

    if (!form.checkValidity()) {
      errorEl?.classList.remove('hidden');
      return;
    }
    errorEl?.classList.add('hidden');
    btn.disabled = true;
    label.textContent = 'Verzenden...';

    const data = new FormData(form);
    data.append('form_type', 'survey_ai_adoption');
    data.append('subject', `Onderzoek AI-adoptie MKB - ${data.get('bedrijf') || 'onbekend'} (${data.get('sector') || 'sector onbekend'})`);

    const ctrl = new AbortController();
    const tid = setTimeout(() => ctrl.abort(), 30000);

    try {
      const res = await fetch('/api/submit', { method: 'POST', body: data, signal: ctrl.signal });
      clearTimeout(tid);
      const json = await res.json().catch(() => ({ success: false, message: 'Ongeldig antwoord' }));
      if (res.ok && json.success) {
        (window as any)._track?.('generate_lead', {
          form_type: 'survey_ai_adoption',
          sector: data.get('sector')
        });
        window.location.href = '/bedankt/?type=survey';
      } else {
        throw new Error(json.message || `HTTP ${res.status}`);
      }
    } catch (err: any) {
      clearTimeout(tid);
      console.error('Survey form error:', err);
      const isTimeout = err?.name === 'AbortError';
      errorEl?.classList.remove('hidden');
      if (errorEl) errorEl.textContent = isTimeout
        ? 'Het versturen duurt te lang. Probeer opnieuw of mail hello@aanloopai.nl.'
        : 'Er ging iets mis. Probeer opnieuw of mail hello@aanloopai.nl.';
      btn.disabled = false;
      label.textContent = 'Verzend mijn antwoorden';
    }
  });
</script>
