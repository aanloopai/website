---
import BaseLayout from '../layouts/BaseLayout.astro';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'AI Automatisering',
  serviceType: 'AI Automatisering',
  provider: {
    '@type': 'Organization',
    '@id': 'https://aanloopai.nl/#organization',
    name: 'Aanloop AI',
    url: 'https://aanloopai.nl',
  },
  areaServed: { '@type': 'Country', name: 'Nederland' },
  description: 'AI automatisering voor het Nederlandse MKB: telefonie, WhatsApp, facturatie, documentverwerking, leads en e-mail automatisch afhandelen met AI-agents. AVG-compliant, n8n self-hosted in Nederland. Starter €597/maand, Groei €1.197/maand.',
  audience: { '@type': 'BusinessAudience', audienceType: 'MKB Nederland' },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'AI Automatisering pakketten',
    itemListElement: [
      {
        '@type': 'Offer',
        name: 'Starter',
        price: '597.00',
        priceCurrency: 'EUR',
        description: 'Marco AI-telefoniste tot 150 gesprekken per maand, agenda-integratie, dashboard. Eenmalige setup €495. Live binnen 7-14 werkdagen.',
        priceSpecification: {
          '@type': 'UnitPriceSpecification',
          price: '597.00',
          priceCurrency: 'EUR',
          unitText: 'maand',
        },
      },
      {
        '@type': 'Offer',
        name: 'Groei',
        price: '1197.00',
        priceCurrency: 'EUR',
        description: 'Marco AI-telefoniste onbeperkt + Emma WhatsApp-agent + CRM-integratie + workflow automation. Eenmalige setup €795. Meest gekozen.',
        priceSpecification: {
          '@type': 'UnitPriceSpecification',
          price: '1197.00',
          priceCurrency: 'EUR',
          unitText: 'maand',
        },
      },
    ],
  },
};

const processen = [
  { titel: 'Telefonie', tekst: 'Inkomende gesprekken worden 24/7 aangenomen, gekwalificeerd en geboekt. Marco voert intake, plant afspraken en escaleert complexe vragen naar uw team — zonder gemiste oproep.', link: '/diensten/marco/' },
  { titel: 'WhatsApp & klantenservice', tekst: 'Emma beantwoordt WhatsApp-berichten, FAQ en bestelvragen automatisch in vloeiend Nederlands. Doorverbinden naar een mens gebeurt alleen wanneer het echt nodig is.', link: '/diensten/emma/' },
  { titel: 'Facturatie & documentverwerking', tekst: 'Facturen, bonnen en contracten worden automatisch uitgelezen, gecategoriseerd en in uw boekhoud- of ERP-systeem geboekt. Geen handmatige invoer meer.', link: '/diensten/ai-document-processing/' },
  { titel: 'Leadopvolging', tekst: 'Nieuwe leads worden direct verrijkt, gescoord en in uw CRM gezet — met automatische opvolg-acties zodat geen aanvraag blijft liggen.', link: '/ai-roi-calculator/' },
  { titel: 'Afspraken inplannen', tekst: 'Klanten boeken zelf via spraak of chat. De AI checkt beschikbaarheid in uw agenda, stuurt bevestigingen en herinneringen, en verwerkt verzettingen.', link: '/diensten/marco/' },
  { titel: 'E-mail & terugkerende workflows', tekst: 'Routinematige e-mails, statusupdates en interne overdrachten worden via n8n-workflows automatisch afgehandeld op basis van regels die u zelf bepaalt.', link: '/diensten/custom/' },
];

const sectoren = [
  { sector: 'Horeca', tekst: 'Reserveringen, take-away-bestellingen en groepsaanvragen worden via telefoon en WhatsApp automatisch verwerkt — ook tijdens de drukte in de keuken.' },
  { sector: 'Logistiek', tekst: 'Zending-statusvragen, planning-aanvragen en transportdocumenten worden automatisch afgehandeld, zodat planners zich op uitzonderingen richten.' },
  { sector: 'Zorg', tekst: 'Afsprakentriage volgens uw protocol, herinneringen en intake — met escalatie naar de praktijk bij spoed. AVG- en NEN 7510-bewust ingericht.' },
  { sector: 'Zakelijke dienstverlening', tekst: 'Intake van nieuwe klanten, documentaanvragen en urenregistratie worden geautomatiseerd, zodat adviseurs declarabele tijd terugwinnen.' },
];

const faqItems = [
  { question: 'Wat is AI automatisering precies?', answer: 'AI automatisering is het automatisch laten uitvoeren van bedrijfsprocessen door AI-agents die taal begrijpen en zelfstandig beslissingen nemen. Anders dan klassieke automatisering werkt het ook met ongestructureerde input zoals telefoongesprekken, e-mails en losse documenten. Aanloop AI levert dit als beheerde dienst voor het Nederlandse MKB.' },
  { question: 'Welke processen kan ik automatiseren met AI?', answer: 'De meest voorkomende toepassingen zijn telefonie (Marco), WhatsApp en klantenservice (Emma), facturatie- en documentverwerking, leadopvolging, afspraken inplannen en terugkerende e-mailworkflows. In de praktijk is elk repetitief proces met een duidelijke logica een kandidaat. Tijdens de gratis AI-scan bepalen we samen welke processen de hoogste ROI opleveren.' },
  { question: 'Wat is het verschil tussen AI automatisering en RPA?', answer: 'RPA (Robotic Process Automation) volgt vaste, vooraf geprogrammeerde klikpaden en breekt zodra een scherm of formulier verandert. AI automatisering begrijpt de bedoeling achter een gesprek, e-mail of document en past zich aan. Voor processen met ongestructureerde input is AI flexibeler; voor strikt repetitieve digitale taken kan RPA volstaan. Vaak combineren we beide.' },
  { question: 'Wat kost AI automatisering bij Aanloop AI?', answer: 'Aanloop AI hanteert vaste maandpakketten. Starter kost €597 per maand met een eenmalige setup van €495. Groei kost €1.197 per maand (meest gekozen) met een setup van €795 en bevat Marco, Emma en workflow automation. Partner is op maat geprijsd. Alle bedragen zijn exclusief 21% btw en maandelijks opzegbaar.' },
  { question: 'Hoe lang duurt het voordat AI automatisering live staat?', answer: 'Standaard staat een implementatie binnen 7 tot 14 werkdagen live. Na de gratis AI-scan en het voorstel bouwen en trainen we de AI op uw kennisbank, bedrijfstoon en processen, koppelen we uw agenda, CRM en telefonie, en doorlopen we een testronde met echte scenario\'s voordat het volledig live gaat.' },
  { question: 'Is AI automatisering AVG-compliant?', answer: 'Ja. Aanloop AI draait n8n self-hosted in Nederland en verwerkt persoonsgegevens binnen de EU. Voor LLM- en voice-providers zoals OpenAI, Anthropic en ElevenLabs zijn verwerkersovereenkomsten afgesloten. Bewaartermijnen zijn instelbaar en u behoudt volledige controle over uw data.' },
  { question: 'Vervangt AI automatisering mijn medewerkers?', answer: 'Nee, AI automatisering neemt vooral repetitief en eerstelijnswerk over. Uw medewerkers houden tijd over voor complexe gesprekken, persoonlijk contact en groei-werk. De beste resultaten ontstaan in een hybride model: AI vangt het routinewerk op, mensen doen de uitzonderingen en het maatwerk.' },
  { question: 'Welke systemen kan AI automatisering koppelen?', answer: 'Via n8n koppelen we onder andere agenda (Google, Outlook, Cal.com), CRM (HubSpot, Pipedrive, AFAS), boekhoudpakketten, webshops (Shopify, WooCommerce) en notificatiekanalen (e-mail, Telegram, WhatsApp). De NL-stem komt van ElevenLabs; voor agent-logica gebruiken we n8n, Dify en de modellen van OpenAI en Claude.' },
];
---

<BaseLayout
  title="AI Automatisering voor het MKB — Aanloop AI Nederland"
  description="AI automatisering voor het Nederlandse MKB: telefonie, WhatsApp, facturatie en e-mail automatisch afhandelen. AVG-compliant, live binnen 7-14 werkdagen, vanaf €597/maand."
  schema={serviceSchema}
  faqSchema={faqItems}
>
  <section class="border-b border-slate-200 hero-gradient">
    <div class="container-page py-16 lg:py-24">
      <div class="max-w-3xl">
        <div class="flex items-center gap-3 mb-6">
          <div class="accent-band"><span></span><span></span><span></span><span></span></div>
          <span class="eyebrow">AI Automatisering · Nederland</span>
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tightest text-navy text-balance leading-[1.05]">
          AI Automatisering voor het Nederlandse MKB
        </h1>
        <p class="mt-6 text-lg lg:text-xl text-slate-600 leading-relaxed text-pretty">
          AI automatisering laat AI-agents repetitieve bedrijfsprocessen zelfstandig afhandelen — telefoon aannemen, WhatsApp beantwoorden, facturen verwerken, leads opvolgen en afspraken plannen. Aanloop AI levert dit als beheerde dienst: AVG-compliant, n8n self-hosted in Nederland, live binnen 7 tot 14 werkdagen.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/gratis-ai-scan/" class="btn-primary">Gratis AI-scan aanvragen</a>
          <a href="/tarieven/" class="btn-secondary">Bekijk tarieven</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page max-w-3xl">
      <h2 class="text-2xl lg:text-3xl font-bold tracking-tightest text-navy mb-4">Wat is AI automatisering?</h2>
      <p class="text-slate-700 leading-relaxed mb-4">AI automatisering is het automatisch laten uitvoeren van bedrijfsprocessen door <strong class="text-navy">AI-agents</strong>: software die menselijke taal begrijpt, context interpreteert en zelfstandig de juiste actie kiest. Waar klassieke automatisering werkt met vaste invoervelden en knoppen, kan AI automatisering ook overweg met ongestructureerde input — een telefoongesprek, een vrij geformuleerde e-mail of een losse PDF-factuur.</p>
      <p class="text-slate-700 leading-relaxed mb-4">Een concreet voorbeeld: een klant belt buiten kantoortijd met de vraag of er morgen een afspraak vrij is. Een AI-telefoniste verstaat de vraag, controleert de agenda, biedt een tijdstip aan, boekt de afspraak en stuurt een bevestiging — zonder dat er een medewerker aan te pas komt. Datzelfde principe geldt voor WhatsApp-berichten, inkomende facturen of nieuwe leads.</p>
      <p class="text-slate-700 leading-relaxed mb-4">Voor het Nederlandse MKB betekent AI automatisering vooral één ding: <strong class="text-navy">tijd en aandacht teruggeven aan uw mensen</strong>. Repetitief werk dat nu uren per dag kost — telefoon aannemen, berichten beantwoorden, gegevens overtikken — wordt door AI afgehandeld, terwijl medewerkers zich richten op complexe gesprekken, persoonlijk contact en groei.</p>
      <p class="text-slate-700 leading-relaxed">Aanloop AI levert AI automatisering niet als losse tool, maar als <strong class="text-navy">beheerde dienst</strong>. We bouwen, trainen en onderhouden de AI-agents, koppelen ze aan uw bestaande systemen en optimaliseren ze maandelijks op basis van echte data. Meer achtergrond vindt u in onze pillar-gids over een <a href="/ai-agency-nederland/" class="text-brand-indigo hover:underline">AI agency in Nederland</a> en in het kennisbankartikel <a href="/kennisbank/ai-automatisering-mkb/" class="text-brand-indigo hover:underline">AI automatisering voor het MKB</a>.</p>
    </div>
  </section>

  <section class="section bg-slate-50/60 border-y border-slate-200">
    <div class="container-page max-w-5xl">
      <h2 class="text-2xl lg:text-3xl font-bold tracking-tightest text-navy mb-2">Welke processen kun je automatiseren met AI?</h2>
      <p class="text-sm text-slate-600 mb-8">Zes processen waar AI automatisering bij het MKB direct rendement oplevert.</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {processen.map((p) => (
          <a href={p.link} class="card card-interactive p-6 hover:border-navy hover:shadow-md transition-all bg-white">
            <h3 class="text-lg font-bold text-navy mb-2">{p.titel}</h3>
            <p class="text-sm text-slate-600 leading-relaxed mb-3">{p.tekst}</p>
            <p class="text-xs font-medium text-brand-indigo flex items-center gap-1">Meer lezen →</p>
          </a>
        ))}
      </div>
      <p class="text-sm text-slate-600 mt-6 leading-relaxed">Bovenstaande processen kunnen los of gecombineerd worden geautomatiseerd. De meeste MKB-bedrijven starten met telefonie of klantenservice — daar is het verlies van gemiste contacten het meest zichtbaar — en breiden daarna uit naar facturatie en interne workflows.</p>
    </div>
  </section>

  <section class="section">
    <div class="container-page max-w-3xl">
      <h2 class="text-2xl lg:text-3xl font-bold tracking-tightest text-navy mb-4">AI automatisering vs traditionele automatisering en RPA</h2>
      <p class="text-slate-700 leading-relaxed mb-4">Traditionele automatisering en RPA (Robotic Process Automation) volgen <strong class="text-navy">vaste, vooraf geprogrammeerde stappen</strong>. Een RPA-robot klikt exact het pad af dat een ontwikkelaar heeft vastgelegd: open scherm A, kopieer veld B, plak in systeem C. Dat werkt uitstekend voor strikt repetitieve digitale taken — maar het breekt zodra een formulier verandert, een uitzondering opduikt of de input niet in een vast format staat.</p>
      <p class="text-slate-700 leading-relaxed mb-4">AI automatisering werkt fundamenteel anders. In plaats van een vast klikpad te volgen, <strong class="text-navy">begrijpt de AI-agent de bedoeling</strong> achter een gesprek, e-mail of document en bepaalt zelf de juiste vervolgactie. Een AI-agent kan een factuur lezen die er net iets anders uitziet dan vorige maand, een beller begrijpen die zijn vraag op een ongebruikelijke manier formuleert, of een e-mail correct routeren ook al staat het onderwerp er niet exact in.</p>
      <p class="text-slate-700 leading-relaxed mb-4">Het verschil samengevat: RPA is goed in <em>voorspelbare, gestructureerde</em> taken; AI automatisering blinkt uit in <em>variabele, ongestructureerde</em> processen waarbij taalbegrip nodig is. RPA is ook gevoeliger voor onderhoud — elke systeemwijziging vraagt aanpassing — terwijl een goed getrainde AI-agent veel veranderingen zelf opvangt.</p>
      <p class="text-slate-700 leading-relaxed">In de praktijk is het geen of-of-keuze. Aanloop AI combineert beide: AI-agents handelen de taalintensieve eerstelijn af, terwijl deterministische workflows in <a href="/diensten/custom/" class="text-brand-indigo hover:underline">n8n</a> de gestructureerde vervolgstappen verzorgen. Zo krijgt u de flexibiliteit van AI met de betrouwbaarheid van vaste workflows. Een diepere uitleg leest u in <a href="/kennisbank/ai-workflow-automation/" class="text-brand-indigo hover:underline">AI workflow automation</a>.</p>
    </div>
  </section>

  <section class="section bg-slate-50/60 border-y border-slate-200">
    <div class="container-page max-w-5xl">
      <h2 class="text-2xl lg:text-3xl font-bold tracking-tightest text-navy mb-2">Voorbeelden van AI automatisering per sector</h2>
      <p class="text-sm text-slate-600 mb-8">Hoe AI automatisering er concreet uitziet in vier Nederlandse MKB-sectoren.</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {sectoren.map((s) => (
          <div class="card p-6 bg-white">
            <h3 class="text-lg font-bold text-navy mb-2">{s.sector}</h3>
            <p class="text-sm text-slate-600 leading-relaxed">{s.tekst}</p>
          </div>
        ))}
      </div>
      <p class="text-sm text-slate-600 mt-6 leading-relaxed">In alle sectoren geldt hetzelfde patroon: AI automatisering vangt de voorspelbare, hoog-volume taken op en escaleert wat echt menselijke aandacht vraagt. Daardoor verdwijnt er geen kwaliteit — die verbetert juist, omdat medewerkers tijd overhouden voor de gevallen die ertoe doen.</p>
    </div>
  </section>

  <section class="section">
    <div class="container-page max-w-3xl">
      <h2 class="text-2xl lg:text-3xl font-bold tracking-tightest text-navy mb-4">Wat levert AI automatisering op?</h2>
      <p class="text-slate-700 leading-relaxed mb-4">De winst van AI automatisering laat zich in drie concrete categorieën uitsplitsen.</p>
      <p class="text-slate-700 leading-relaxed mb-4"><strong class="text-navy">Tijdsbesparing.</strong> Repetitieve taken zoals telefoon aannemen, berichten beantwoorden en gegevens overtikken kosten in een gemiddeld MKB-bedrijf al snel meerdere uren per dag. Door deze processen te automatiseren wint u die uren terug — tijd die direct naar omzetgenererend of klantgericht werk kan.</p>
      <p class="text-slate-700 leading-relaxed mb-4"><strong class="text-navy">24/7 bereikbaarheid.</strong> Een AI-agent kent geen kantooruren, pauzes of vakantie. Klanten die 's avonds bellen of in het weekend appen krijgen direct antwoord en kunnen meteen een afspraak boeken. Dat voorkomt gemiste leads — een gemiste oproep is in veel branches een verloren klant.</p>
      <p class="text-slate-700 leading-relaxed mb-4"><strong class="text-navy">Voorspelbare kosten en ROI.</strong> Tegenover een vast maandbedrag staat onbeperkte capaciteit: de AI handelt evenveel gesprekken af bij piekdrukte als op een rustige dag, zonder extra personeelskosten. Voor veel MKB-bedrijven verdient een automatiseringstraject zich binnen enkele maanden terug. U kunt uw eigen situatie doorrekenen met de <a href="/ai-roi-calculator/" class="text-brand-indigo hover:underline">AI ROI-calculator</a>.</p>
      <p class="text-slate-700 leading-relaxed">Daarbovenop komt consistentie: een AI-agent volgt altijd hetzelfde script, vergeet nooit een stap en levert elke klant dezelfde kwaliteit — ongeacht het tijdstip of de drukte.</p>
    </div>
  </section>

  <section class="section bg-slate-50/60 border-y border-slate-200">
    <div class="container-page max-w-3xl">
      <h2 class="text-2xl lg:text-3xl font-bold tracking-tightest text-navy mb-6">Hoe begin je met AI automatisering?</h2>
      <p class="text-slate-700 leading-relaxed mb-6">Aanloop AI hanteert een beproefde werkwijze in vier stappen. U hoeft geen technische kennis te hebben — wij nemen het bouwen, koppelen en trainen volledig uit handen.</p>
      <ol class="space-y-4 text-slate-700">
        <li class="flex gap-4"><span class="shrink-0 w-8 h-8 rounded-full bg-navy text-white flex items-center justify-center font-bold text-sm">1</span><div><strong class="text-navy">Gratis AI-scan</strong> — in een gesprek van 30 minuten brengen we uw processen, knelpunten en gewenste integraties in kaart. We bepalen samen welke processen de hoogste ROI opleveren. <a href="/gratis-ai-scan/" class="text-brand-indigo hover:underline">Plan uw gratis AI-scan</a>.</div></li>
        <li class="flex gap-4"><span class="shrink-0 w-8 h-8 rounded-full bg-navy text-white flex items-center justify-center font-bold text-sm">2</span><div><strong class="text-navy">Voorstel</strong> — u ontvangt een concreet voorstel met scope, verwachte tijdsbesparing, prijs en doorlooptijd. Geen verrassingen achteraf, geen verborgen kosten.</div></li>
        <li class="flex gap-4"><span class="shrink-0 w-8 h-8 rounded-full bg-navy text-white flex items-center justify-center font-bold text-sm">3</span><div><strong class="text-navy">Bouwen en trainen</strong> — we bouwen de AI-agents, trainen ze op uw kennisbank en bedrijfstoon, koppelen uw agenda, CRM en telefonie en doorlopen een testronde met echte scenario's.</div></li>
        <li class="flex gap-4"><span class="shrink-0 w-8 h-8 rounded-full bg-navy text-white flex items-center justify-center font-bold text-sm">4</span><div><strong class="text-navy">Go-live binnen 7-14 werkdagen</strong> — de automatisering gaat live. We monitoren de eerste weken nauwgezet en optimaliseren maandelijks op basis van echte data.</div></li>
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container-page max-w-3xl">
      <h2 class="text-2xl lg:text-3xl font-bold tracking-tightest text-navy mb-4">Wat kost AI automatisering?</h2>
      <p class="text-slate-700 leading-relaxed mb-4">Aanloop AI werkt met vaste, transparante maandpakketten — geen kosten per gesprek of per bericht, geen verrassingen. Alle bedragen zijn exclusief 21% btw en maandelijks opzegbaar.</p>
      <div class="overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm my-6">
        <table class="w-full text-sm">
          <thead class="bg-slate-50">
            <tr>
              <th class="text-left p-4 font-semibold text-navy">Pakket</th>
              <th class="text-left p-4 font-semibold text-navy">Prijs per maand</th>
              <th class="text-left p-4 font-semibold text-navy">Eenmalige setup</th>
              <th class="text-left p-4 font-semibold text-navy">Inbegrepen</th>
            </tr>
          </thead>
          <tbody>
            <tr class="bg-white">
              <td class="p-4 font-medium text-navy">Starter</td>
              <td class="p-4 text-slate-700">€597</td>
              <td class="p-4 text-slate-700">€495</td>
              <td class="p-4 text-slate-700">Marco AI-telefoniste tot 150 gesprekken, agenda-integratie, dashboard</td>
            </tr>
            <tr class="bg-slate-50/40">
              <td class="p-4 font-medium text-navy">Groei <span class="text-xs text-brand-indigo">(meest gekozen)</span></td>
              <td class="p-4 text-slate-700">€1.197</td>
              <td class="p-4 text-slate-700">€795</td>
              <td class="p-4 text-slate-700">Marco onbeperkt + Emma WhatsApp-agent + CRM-integratie + workflow automation</td>
            </tr>
            <tr class="bg-white">
              <td class="p-4 font-medium text-navy">Partner</td>
              <td class="p-4 text-slate-700">Op maat</td>
              <td class="p-4 text-slate-700">Op maat</td>
              <td class="p-4 text-slate-700">Volledige AI automatisering met custom workflows, dedicated begeleiding en SLA</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="text-slate-700 leading-relaxed mb-4">Het Starter-pakket is de laagdrempelige instap, vooral geschikt om met telefonie-automatisering te beginnen. Het Groei-pakket combineert telefoon én WhatsApp met workflow automation en is daardoor de meest gekozen optie voor MKB-bedrijven die meerdere processen ineens willen automatiseren. Partner is maatwerk voor bedrijven met complexe of bedrijfsbrede automatisering.</p>
      <p class="text-slate-700 leading-relaxed">Een volledig overzicht met alle pakketten en opties vindt u op de <a href="/tarieven/" class="text-brand-indigo hover:underline">tarievenpagina</a>.</p>
    </div>
  </section>

  <section class="section bg-slate-50/60 border-y border-slate-200">
    <div class="container-page max-w-3xl">
      <h2 class="text-2xl lg:text-3xl font-bold tracking-tightest text-navy mb-6">Veelgestelde vragen over AI automatisering</h2>
      <div class="space-y-3">
        {faqItems.map((item) => (
          <details class="group bg-white border border-slate-200 rounded-xl">
            <summary class="flex items-center justify-between gap-4 cursor-pointer p-5 font-semibold text-navy">
              {item.question}
              <span class="shrink-0 text-brand-indigo transition-transform group-open:rotate-45 text-xl leading-none">+</span>
            </summary>
            <p class="px-5 pb-5 text-sm text-slate-600 leading-relaxed">{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page max-w-3xl">
