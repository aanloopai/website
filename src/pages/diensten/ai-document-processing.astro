---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import pageImage from '../../assets/images/pages/document.jpg';
const schema = { '@context': 'https://schema.org', '@type': 'Service', serviceType: 'AI Document Processing', provider: { '@type': 'Organization', name: 'Aanloop AI' }, offers: [{ '@type': 'Offer', name: 'Starter', price: '1200', priceCurrency: 'EUR' }, { '@type': 'Offer', name: 'Growth', price: '3000', priceCurrency: 'EUR' }] };
---
<BaseLayout title="AI Document Processing: Facturen, Contracten & PDF's Automatisch Verwerken | Aanloop AI" description="AI die facturen, contracten en PDF-documenten automatisch uitleest, categoriseert en verwerkt in uw systemen. 85% tijdsbesparing. Starter €1.200/maand. KVK: 88606902." schema={schema}>
  <section class="border-b border-slate-200 hero-gradient">
    <div class="container-page py-16 lg:py-24">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div class="max-w-3xl">
        <div class="flex items-center gap-4 mb-6 reveal"><div class="accent-band"><span></span><span></span><span></span><span></span></div><span class="eyebrow">AI Automation</span></div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tightest text-navy text-balance leading-[1.05] reveal reveal-delay-1">AI Document Processing</h1>
        <p class="mt-6 text-lg text-slate-600 leading-relaxed max-w-2xl reveal reveal-delay-2">Facturen, contracten, offertes en PDF's automatisch uitlezen, categoriseren en verwerken in uw boekhoud- of ERP-systeem. Van ontvangst tot boeken in seconden — zonder menselijke handeling.</p>
        <div class="mt-8 flex gap-3 flex-wrap reveal reveal-delay-3">
          <a href="/demo-aanvragen/" class="btn-primary text-base px-6 py-3.5">Gratis demo aanvragen <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></a>
          <a href="/kennisbank/ai-facturering-automatisering/" class="btn-outline text-base px-6 py-3.5">Lees meer →</a>
        </div>
      </div>
      <div class="reveal reveal-delay-2">
        <Image src={pageImage} alt="Documenten en koffie op donker bureau — automatische document processing met AI" class="w-full rounded-2xl shadow-xl object-cover aspect-[4/3]" loading="eager" decoding="async" fetchpriority="high" widths={[480, 800, 1200, 1400]} sizes="(min-width: 1024px) 600px, 100vw" format="webp" quality={82} />
      </div>
      </div>
    </div>
  </section>
  <section class="section-tight bg-slate-50 border-b border-slate-200">
    <div class="container-page">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        {[{v:'85%',l:'tijdsbesparing'},{v:'99.2%',l:'extractie-nauwkeurigheid'},{v:'AVG',l:'compliant'},{v:'Exact, Twinfield',l:'integraties'}].map(s=>(
          <div class="reveal"><p class="text-2xl font-bold text-navy">{s.v}</p><p class="text-xs text-slate-500 mt-1">{s.l}</p></div>
        ))}
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container-page">
      <div class="grid lg:grid-cols-2 gap-12">
        <div class="reveal">
          <h2 class="text-2xl font-bold text-navy mb-6">Welke documenten verwerkt de AI?</h2>
          <ul class="space-y-3">
            {['Inkomende facturen (PDF, scan, e-mail)','Uitgaande offertes & contracten','Betalingsbewijzen & bankafschriften','Leveringsbonnen & pakbonnen','Subsidie- & vergunningaanvragen','Huur- & leasecontracten'].map(f=>(
              <li class="flex items-start gap-3 text-sm text-slate-700"><svg class="w-5 h-5 mt-0.5 flex-shrink-0 text-brand-emerald" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>{f}</li>
            ))}
          </ul>
          <div class="mt-6 bg-slate-50 border border-slate-200 rounded-xl p-5">
            <p class="text-sm font-bold text-navy mb-2">Integraties</p>
            <div class="flex flex-wrap gap-2 text-xs">
              {['Exact Online','Twinfield','Visma','Moneybird','SAP','Microsoft Dynamics'].map(i=><span class="px-3 py-1 bg-white border border-slate-200 rounded-full">{i}</span>)}
            </div>
          </div>
        </div>
        <div class="reveal reveal-delay-2">
          <h2 class="text-2xl font-bold text-navy mb-6">Tarieven</h2>
          <div class="space-y-4">
            {[{n:'Starter',p:'€1.200',f:'/maand',d:'1 documenttype, tot 500 docs/maand, 1 integratie'},{n:'Growth',p:'€3.000',f:'/maand',d:'Alle documenttypen, onbeperkt, meerdere integraties, CRM-sync'},{n:'Enterprise',p:'Op maat',f:'',d:'On-premise verwerking, SLA, custom modellen'}].map(t=>(
              <div class="card"><div class="flex items-start justify-between mb-1"><div><p class="font-bold text-navy">{t.n}</p><p class="text-sm text-slate-500">{t.d}</p></div><div class="text-right flex-shrink-0 ml-4"><p class="font-bold text-navy">{t.p}</p><p class="text-xs text-slate-400">{t.f}</p></div></div></div>
            ))}
          </div>
          <a href="/demo-aanvragen/" class="btn-primary mt-6 w-full justify-center">Gratis demo aanvragen</a>
        </div>
      </div>
    </div>
  </section>
  <section class="section-tight bg-midnight text-pearl">
    <div class="container-page max-w-3xl">
      <h2 class="text-3xl font-bold text-pearl reveal">Uren besparen op documentverwerking?</h2>
      <p class="mt-4 text-slate-300 reveal reveal-delay-1">Plan een gratis demo en zie hoe de AI uw documenten verwerkt.</p>
      <a href="/demo-aanvragen/" class="mt-6 btn bg-pearl text-navy hover:bg-white text-base px-6 py-3.5 reveal reveal-delay-2">Gratis demo aanvragen</a>
    </div>
  </section>
</BaseLayout>
