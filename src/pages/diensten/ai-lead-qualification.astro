---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import pageImage from '../../assets/images/pages/lead.jpg';
const schema = { '@context': 'https://schema.org', '@type': 'Service', name: 'AI Lead Qualification Agent', serviceType: 'AI Lead Qualification Agent', provider: { '@type': 'Organization', name: 'Aanloop AI' , url: 'https://aanloopai.nl'}, offers: [{ '@type': 'Offer', name: 'Starter', price: '1100', priceCurrency: 'EUR' }, { '@type': 'Offer', name: 'Growth', price: '2800', priceCurrency: 'EUR' }] };
---
<BaseLayout title="AI Lead Qualification: Automatisch Leads Kwalificeren" description="AI agent die inkomende leads automatisch kwalificeert op budget, urgentie en fit. Alleen serieuze prospects bij uw salesteam. Starter €1.100/maand." schema={schema}>
  <section class="border-b border-slate-200 hero-gradient">
    <div class="container-page py-16 lg:py-24">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div class="max-w-3xl">
        <div class="flex items-center gap-4 mb-6 reveal"><div class="accent-band"><span></span><span></span><span></span><span></span></div><span class="eyebrow">AI Agents</span></div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tightest text-navy text-balance leading-[1.05] reveal reveal-delay-1">AI Lead Qualification Agent</h1>
        <p class="mt-6 text-lg text-slate-600 leading-relaxed max-w-2xl reveal reveal-delay-2">Stop met tijd verspillen aan ongeschikte leads. De AI agent kwalificeert automatisch elke inkomende aanvraag op budget, tijdlijn, urgentie en fit — zodat uw salesteam alleen serieuze prospects spreekt.</p>
        <div class="mt-8 flex gap-3 flex-wrap reveal reveal-delay-3">
          <a href="/demo-aanvragen/" class="btn-primary text-base px-6 py-3.5">Gratis demo aanvragen <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></a>
          <a href="/prijzen/" class="btn-outline text-base px-6 py-3.5">Bekijk prijzen</a>
        </div>
      </div>
      <div class="reveal reveal-delay-2">
        <Image src={pageImage} alt="Laptop met conversie-pagina — AI lead qualification met BANT-model" class="w-full rounded-2xl shadow-xl object-cover aspect-[4/3]" loading="eager" decoding="async" fetchpriority="high" widths={[480, 800, 1200, 1400]} sizes="(min-width: 1024px) 600px, 100vw" format="webp" quality={82} />
      </div>
      </div>
    </div>
  </section>
  <section class="section-tight bg-slate-50 border-b border-slate-200">
    <div class="container-page">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        {[{v:'3×',l:'meer gekwalificeerde leads'},{v:'−60%',l:'verspilde salestijd'},{v:'BANT',l:'kwalificatiemodel'},{v:'24/7',l:'actief'}].map(s=>(
          <div class="reveal"><p class="text-2xl font-bold text-navy">{s.v}</p><p class="text-xs text-slate-500 mt-1">{s.l}</p></div>
        ))}
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container-page">
      <div class="grid lg:grid-cols-2 gap-12">
        <div class="reveal">
          <h2 class="text-2xl font-bold text-navy mb-6">Hoe werkt de AI Lead Qualification?</h2>
          <ul class="space-y-4">
            {['Automatisch BANT-vragen stellen via telefoon, chat of WhatsApp','Budget, autoriteit, behoefte en tijdlijn vastleggen','Lead-score berekenen en prioriteit toewijzen','Gekwalificeerde leads direct doorsturen naar salesteam','Ongeschikte leads vriendelijk afhandelen','CRM-integratie: HubSpot, Pipedrive, Salesforce','Rapport per dag/week met conversie-statistieken'].map(f=>(
              <li class="flex items-start gap-3 text-sm text-slate-700"><svg class="w-5 h-5 mt-0.5 flex-shrink-0 text-brand-emerald" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>{f}</li>
            ))}
          </ul>
        </div>
        <div class="reveal reveal-delay-2">
          <h2 class="text-2xl font-bold text-navy mb-6">Tarieven</h2>
          <div class="space-y-4">
            {[{n:'Starter',p:'€1.100',f:'/maand',d:'1 kanaal, BANT-model, e-mail rapportage, tot 200 leads/maand'},{n:'Growth',p:'€2.800',f:'/maand',d:'Meerdere kanalen, CRM-sync, custom scoringsmodel, onbeperkte leads'},{n:'Enterprise',p:'Op maat',f:'',d:'API-integratie, multi-team, SLA, dedicated support'}].map(t=>(
              <div class="card"><div class="flex items-start justify-between mb-1"><div><p class="font-bold text-navy">{t.n}</p><p class="text-sm text-slate-500">{t.d}</p></div><div class="text-right flex-shrink-0 ml-4"><p class="font-bold text-navy">{t.p}</p><p class="text-xs text-slate-400">{t.f}</p></div></div></div>
            ))}
          </div>
          <a href="/demo-aanvragen/" class="btn-primary mt-6 w-full justify-center">Gratis demo aanvragen</a>
        </div>
      </div>
    </div>
  </section>
  <section class="section bg-slate-50 border-y border-slate-200">
    <div class="container-page max-w-4xl">
      <p class="eyebrow text-brand-indigo mb-2">Website + AI = 1 partner</p>
      <h2 class="text-2xl lg:text-3xl font-bold text-navy mb-4">Lead-kwalificatie werkt nóg sterker met website + Marco + Emma</h2>
      <p class="text-slate-600 mb-8 leading-relaxed">Lead-kwalificatie is de filter, maar de leads komen van uw website + telefoon + WhatsApp. In de AI-Website Bundel zitten AI-ready website + Marco (telefoon) + Emma (WhatsApp/chat) in één pakket — bespaart €8.014 jaar 1, met één contract en één aanspreekpunt.</p>
      <div class="grid md:grid-cols-3 gap-4">
        <a href="/diensten/ai-website-bundel-mkb-nederland/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">AI-Website Bundel</h3>
          <p class="text-xs text-slate-600 mb-3">Website + Marco + Emma in 1 pakket. €4.950 setup + €397/mnd. Bespaart €8.014 jaar 1.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk bundel →</span>
        </a>
        <a href="/diensten/emma/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">Emma — chat-leadkwalificatie</h3>
          <p class="text-xs text-slate-600 mb-3">24/7 WhatsApp + website-chat: leadkwalificatie + routering naar verkoopteam.</p>
          <span class="text-xs text-brand-indigo font-medium">Ontmoet Emma →</span>
        </a>
        <a href="/diensten/website-laten-maken-mkb-nederland-2026/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">AI-ready website laten maken</h3>
          <p class="text-xs text-slate-600 mb-3">Astro/Next/WordPress — Core Web Vitals groen + lead-formulieren ingebouwd vanaf dag 1.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk pakketten →</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section-tight bg-midnight text-pearl">
    <div class="container-page max-w-3xl">
      <h2 class="text-3xl font-bold text-pearl reveal">Alleen nog serieuze leads spreken?</h2>
      <p class="mt-4 text-slate-300 reveal reveal-delay-1">Plan een gratis demo en zie hoe de AI uw leadkwalificatie overneemt.</p>
      <a href="/demo-aanvragen/" class="mt-6 btn bg-pearl text-navy hover:bg-white text-base px-6 py-3.5 reveal reveal-delay-2">Gratis demo aanvragen</a>
    </div>
  </section>
</BaseLayout>
