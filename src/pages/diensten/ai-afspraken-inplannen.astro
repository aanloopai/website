---
import BaseLayout from '../../layouts/BaseLayout.astro';
const schema = { '@context': 'https://schema.org', '@type': 'Service', serviceType: 'AI Afspraken Inplannen', provider: { '@type': 'Organization', name: 'Aanloop AI' }, offers: [{ '@type': 'Offer', name: 'Starter', price: '700', priceCurrency: 'EUR' }, { '@type': 'Offer', name: 'Growth', price: '1800', priceCurrency: 'EUR' }] };
---
<BaseLayout title="AI Afspraken Inplannen: Automatische Agendabeheer | Aanloop AI" description="AI agent die afspraken inplant, bevestigt en herinnert via telefoon, WhatsApp of chat. Nooit meer een dubbele boeking of gemiste afspraak. Starter €700/maand. KVK: 88606902." schema={schema}>
  <section class="border-b border-slate-200 hero-gradient">
    <div class="container-page py-16 lg:py-24">
      <div class="max-w-3xl">
        <div class="flex items-center gap-4 mb-6 reveal"><div class="accent-band"><span></span><span></span><span></span><span></span></div><span class="eyebrow">AI Agents</span></div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tightest text-navy text-balance leading-[1.05] reveal reveal-delay-1">AI Afspraken Inplannen</h1>
        <p class="mt-6 text-lg text-slate-600 leading-relaxed max-w-2xl reveal reveal-delay-2">De AI agent plant afspraken in, stuurt bevestigingen en herinneringen, en verwerkt annuleringen — volledig automatisch via telefoon, WhatsApp of uw website. Uw agenda altijd up-to-date.</p>
        <div class="mt-8 flex gap-3 flex-wrap reveal reveal-delay-3">
          <a href="/demo-aanvragen/" class="btn-primary text-base px-6 py-3.5">Gratis demo aanvragen <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></a>
          <a href="/prijzen/" class="btn-outline text-base px-6 py-3.5">Bekijk prijzen</a>
        </div>
      </div>
    </div>
  </section>
  <section class="section-tight bg-slate-50 border-b border-slate-200">
    <div class="container-page">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        {[{v:'−50%',l:'no-shows'},{v:'24/7',l:'boeken mogelijk'},{v:'Google/Outlook',l:'integratie'},{v:'7 dgn',l:'live'}].map(s=>(
          <div class="reveal"><p class="text-2xl font-bold text-navy">{s.v}</p><p class="text-xs text-slate-500 mt-1">{s.l}</p></div>
        ))}
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container-page">
      <div class="grid lg:grid-cols-2 gap-12">
        <div class="reveal">
          <h2 class="text-2xl font-bold text-navy mb-6">Functies</h2>
          <ul class="space-y-4">
            {['Beschikbaarheid real-time controleren in uw agenda','Afspraken boeken via telefoon, chat of WhatsApp','Bevestigingsmail en SMS direct na boeking','Herinneringen 24 uur en 2 uur van tevoren','Annuleringen en herplanningen automatisch verwerken','Wachtlijstbeheer bij uitgebreide agenda','Meerdere medewerkers / locaties ondersteuning'].map(f=>(
              <li class="flex items-start gap-3 text-sm text-slate-700"><svg class="w-5 h-5 mt-0.5 flex-shrink-0 text-brand-emerald" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>{f}</li>
            ))}
          </ul>
        </div>
        <div class="reveal reveal-delay-2">
          <h2 class="text-2xl font-bold text-navy mb-6">Tarieven</h2>
          <div class="space-y-4">
            {[{n:'Starter',p:'€700',f:'/maand',d:'1 agenda, 2 kanalen, SMS + e-mail bevestiging'},{n:'Growth',p:'€1.800',f:'/maand',d:'Meerdere agenda\'s, alle kanalen, wachtlijst, CRM'},{n:'Enterprise',p:'Op maat',f:'',d:'Multi-locatie, multi-medewerker, SLA'}].map(t=>(
              <div class="card"><div class="flex items-start justify-between mb-1"><div><p class="font-bold text-navy">{t.n}</p><p class="text-sm text-slate-500">{t.d}</p></div><div class="text-right flex-shrink-0 ml-4"><p class="font-bold text-navy">{t.p}</p><p class="text-xs text-slate-400">{t.f}</p></div></div></div>
            ))}
          </div>
          <a href="/demo-aanvragen/" class="btn-primary mt-6 w-full justify-center">Gratis demo aanvragen</a>
        </div>
      </div>
    </div>
  </section>
  <section class="section-tight bg-midnight text-pearl">
    <div class="container-page max-w-3xl">
      <h2 class="text-3xl font-bold text-pearl reveal">Nooit meer een gemiste afspraak?</h2>
      <p class="mt-4 text-slate-300 reveal reveal-delay-1">Plan een gratis demo en zie hoe de AI uw agenda beheert.</p>
      <a href="/demo-aanvragen/" class="mt-6 btn bg-pearl text-navy hover:bg-white text-base px-6 py-3.5 reveal reveal-delay-2">Gratis demo aanvragen</a>
    </div>
  </section>
</BaseLayout>
