---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import pageImage from '../../assets/images/pages/seo.jpg';
const schema = { '@context': 'https://schema.org', '@type': 'Service', name: 'AI SEO Content Generator', serviceType: 'AI SEO Content Generator', description: 'AI die SEO-geoptimaliseerde artikelen, landingspaginas en blogs schrijft afgestemd op uw merk en zoekwoorden. Starter EUR1.000/maand. KVK: 88606902.', provider: { '@type': 'Organization', '@id': 'https://aanloopai.nl/#organization' }, areaServed: { '@type': 'Country', name: 'Nederland' }, audience: { '@type': 'BusinessAudience', audienceType: 'MKB Nederland (10-200 medewerkers)' }, offers: [{ '@type': 'Offer', name: 'Starter', price: '1000', priceCurrency: 'EUR' }, { '@type': 'Offer', name: 'Growth', price: '2500', priceCurrency: 'EUR' }], hasOfferCatalog: { '@type': 'OfferCatalog', name: 'Dienstenpakketten', itemListElement: [{ '@type': 'Offer', name: 'Starter', price: '1000', priceCurrency: 'EUR', description: '8 artikelen/maand, zoekwoord-onderzoek, basis SEO' }, { '@type': 'Offer', name: 'Growth', price: '2500', priceCurrency: 'EUR', description: 'Onbeperkt, CMS-publicatie, interne linking, schema markup' }, { '@type': 'Offer', priceSpecification: { '@type': 'PriceSpecification', priceCurrency: 'EUR', valueAddedTaxIncluded: false }, name: 'Enterprise', priceCurrency: 'EUR', description: 'Content-strategie, concurrentieanalyse, dedicated editor' }] } };
---
<BaseLayout title="AI SEO Content Generator: Artikelen, Landingspaginas & Blogs" description="AI die SEO-geoptimaliseerde artikelen, landingspagina's en blogs schrijft afgestemd op uw merk en zoekwoorden. Starter €1.000/maand. KVK: 88606902." schema={schema}>
  <section class="border-b border-slate-200 hero-gradient">
    <div class="container-page py-16 lg:py-24">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div class="max-w-3xl">
        <div class="flex items-center gap-4 mb-6 reveal"><div class="accent-band"><span></span><span></span><span></span><span></span></div><span class="eyebrow">AI Automation</span></div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tightest text-navy text-balance leading-[1.05] reveal reveal-delay-1">AI SEO Content Generator</h1>
        <p class="mt-6 text-lg text-slate-600 leading-relaxed max-w-2xl reveal reveal-delay-2">Hoogwaardige SEO-content op schaal. De AI schrijft artikelen, landingspagina's en blogposts die ranken in Google — in uw tone of voice, met de juiste zoekwoorden en interne links.</p>
        <div class="mt-8 flex gap-3 flex-wrap reveal reveal-delay-3">
          <a href="/demo-aanvragen/" class="btn-primary text-base px-6 py-3.5">Gratis demo aanvragen <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></a>
          <a href="/tarieven/" class="btn-outline text-base px-6 py-3.5">Bekijk prijzen</a>
        </div>
      </div>
      <div class="reveal reveal-delay-2">
        <Image src={pageImage} alt="Vulpen schrijft op gelinieerd papier — AI SEO content generator voor Nederlandse MKB" class="w-full rounded-2xl shadow-xl object-cover aspect-[4/3]" loading="eager" decoding="async" fetchpriority="high" widths={[480, 800, 1200, 1400]} sizes="(min-width: 1024px) 600px, 100vw" format="webp" quality={82} />
      </div>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container-page">
      <div class="grid lg:grid-cols-2 gap-12">
        <div class="reveal">
          <h2 class="text-2xl font-bold text-navy mb-6">Wat genereert de AI?</h2>
          <ul class="space-y-4">
            {['Lange SEO-artikelen (2.000–5.000 woorden)','Locatie-specifieke landingspagina\'s','Sector- en product-specifieke blogs','FAQ-pagina\'s op basis van echte zoekvragen','Meta-titels en -beschrijvingen','Interne linkstructuur automatisch opbouwen','Schema-markup (Article, FAQ, HowTo)'].map(f=>(
              <li class="flex items-start gap-3 text-sm text-slate-700"><svg class="w-5 h-5 mt-0.5 flex-shrink-0 text-brand-emerald" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>{f}</li>
            ))}
          </ul>
        </div>
        <div class="reveal reveal-delay-2">
          <h2 class="text-2xl font-bold text-navy mb-6">Tarieven</h2>
          <div class="space-y-4">
            {[{n:'Starter',p:'€1.000',f:'/maand',d:'8 artikelen/maand, zoekwoord-onderzoek, basis SEO'},{n:'Growth',p:'€2.500',f:'/maand',d:'Onbeperkt, CMS-publicatie, interne linking, schema markup'},{n:'Enterprise',p:'Op maat',f:'',d:'Content-strategie, concurrentieanalyse, dedicated editor'}].map(t=>(
              <div class="card"><div class="flex items-start justify-between mb-1"><div><p class="font-bold text-navy">{t.n}</p><p class="text-sm text-slate-500">{t.d}</p></div><div class="text-right flex-shrink-0 ml-4"><p class="font-bold text-navy">{t.p}</p><p class="text-xs text-slate-400">{t.f}</p></div></div></div>
            ))}
          </div>
          <a href="/demo-aanvragen/" class="btn-primary mt-6 w-full justify-center">Gratis demo aanvragen</a>
        </div>
      </div>
    </div>
  </section>
  <section class="section bg-slate-50 border-y border-slate-200">
    <div class="container-page max-w-4xl">
      <p class="eyebrow text-brand-indigo mb-2">Website + AI = 1 partner</p>
      <h2 class="text-2xl lg:text-3xl font-bold text-navy mb-4">SEO-content werkt nóg krachtiger op een AI-ready website</h2>
      <p class="text-slate-600 mb-8 leading-relaxed">SEO-content op een verouderde website verliest bezoekers door slechte Core Web Vitals + missing schema. In de AI-Website Bundel komt een AI-ready website (Schema.org + Speakable + WCAG 2.2 AA) + Marco + Emma — bespaart €8.014 jaar 1, met één contract en één aanspreekpunt.</p>
      <div class="grid md:grid-cols-3 gap-4">
        <a href="/diensten/ai-website-bundel-mkb-nederland/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">AI-Website Bundel</h3>
          <p class="text-xs text-slate-600 mb-3">Website + Marco + Emma in 1 pakket. €4.950 setup + €397/mnd. Bespaart €8.014 jaar 1.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk bundel →</span>
        </a>
        <a href="/diensten/website-laten-maken-mkb-nederland-2026/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">AI-ready website (SEO-optimal)</h3>
          <p class="text-xs text-slate-600 mb-3">Astro/Next/WordPress — Schema.org + Speakable + WCAG 2.2 AA + Core Web Vitals groen.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk pakketten →</span>
        </a>
        <a href="/cases/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">Combo-cases bekijken</h3>
          <p class="text-xs text-slate-600 mb-3">Branche-scenarios met SEO-content + AI-Website Bundel: detailhandel, advocatuur, accountancy.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk cases →</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section-tight bg-midnight text-pearl">
    <div class="container-page max-w-3xl">
      <h2 class="text-3xl font-bold text-pearl reveal">Hoger in Google zonder content-stress?</h2>
      <p class="mt-4 text-slate-300 reveal reveal-delay-1">Plan een gratis demo en zie een voorbeeld van AI-content voor uw branche.</p>
      <a href="/demo-aanvragen/" class="mt-6 btn bg-pearl text-navy hover:bg-white text-base px-6 py-3.5 reveal reveal-delay-2">Gratis demo aanvragen</a>
    </div>
  </section>
</BaseLayout>
