---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import pageImage from '../../assets/images/pages/chatbot.jpg';
const schema = { '@context': 'https://schema.org', '@type': 'Service', name: 'AI Chatbot voor Websites', serviceType: 'AI Chatbot voor Websites', provider: { '@type': 'Organization', name: 'Aanloop AI', url: 'https://aanloopai.nl' }, offers: [{ '@type': 'Offer', name: 'Starter', price: '800', priceCurrency: 'EUR' }, { '@type': 'Offer', name: 'Growth', price: '2000', priceCurrency: 'EUR' }] };
---
<BaseLayout title="AI Chatbot voor uw Website — 24/7 Klantenservice" description="AI chatbot voor uw website die leads kwalificeert, vragen beantwoordt en bezoekers omzet naar klanten. Starter vanaf €800/maand. KVK: 88606902." schema={schema}>
  <section class="border-b border-slate-200 hero-gradient">
    <div class="container-page py-16 lg:py-24">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div class="max-w-3xl">
        <div class="flex items-center gap-4 mb-6 reveal"><div class="accent-band"><span></span><span></span><span></span><span></span></div><span class="eyebrow">AI Agents</span></div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tightest text-navy text-balance leading-[1.05] reveal reveal-delay-1">AI Chatbot voor uw Website</h1>
        <p class="mt-6 text-lg text-slate-600 leading-relaxed max-w-2xl reveal reveal-delay-2">Een intelligente AI chatbot die 24/7 vragen beantwoordt, leads kwalificeert en bezoekers begeleidt naar een aankoop of afspraak — volledig geïntegreerd in uw huidige website.</p>
        <div class="mt-8 flex gap-3 flex-wrap reveal reveal-delay-3">
          <a href="/demo-aanvragen/" class="btn-primary text-base px-6 py-3.5">Gratis demo aanvragen <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></a>
          <a href="/prijzen/" class="btn-outline text-base px-6 py-3.5">Bekijk prijzen</a>
        </div>
      </div>
      <div class="reveal reveal-delay-2">
        <Image src={pageImage} alt="Modern bureau met laptop en telefoon — AI chatbot voor uw website" class="w-full rounded-2xl shadow-xl object-cover aspect-[4/3]" loading="eager" decoding="async" fetchpriority="high" widths={[480, 800, 1200, 1400]} sizes="(min-width: 1024px) 600px, 100vw" format="webp" quality={82} />
      </div>
      </div>
    </div>
  </section>
  <section class="section-tight bg-slate-50 border-b border-slate-200">
    <div class="container-page">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        {[{v:'85%',l:'minder onbeantwoorde vragen'},{v:'3×',l:'meer leadconversie'},{v:'24/7',l:'beschikbaar'},{v:'7 dgn',l:'live'}].map(s=>(
          <div class="reveal"><p class="text-2xl font-bold text-navy">{s.v}</p><p class="text-xs text-slate-500 mt-1">{s.l}</p></div>
        ))}
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container-page">
      <div class="grid lg:grid-cols-2 gap-12 mb-16">
        <div class="reveal">
          <p class="eyebrow mb-2">Wat doet de AI chatbot?</p>
          <h2 class="text-2xl font-bold text-navy mb-6">Meer dan een FAQ-bot</h2>
          <ul class="space-y-4">
            {['Bezoekers begroeten en direct helpen met hun vraag','Product- en dienstvragen beantwoorden op basis van uw kennisbank','Leads kwalificeren: budget, tijdlijn, urgentie','Afspraken inplannen direct vanuit de chat','E-mailadressen en contactinfo verzamelen','Doorschakelen naar medewerker bij complexe vragen','Beschikbaar in NL, EN en andere talen'].map(f=>(
              <li class="flex items-start gap-3 text-sm text-slate-700"><svg class="w-5 h-5 mt-0.5 flex-shrink-0 text-brand-emerald" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>{f}</li>
            ))}
          </ul>
        </div>
        <div class="reveal reveal-delay-2">
          <p class="eyebrow mb-2">Prijzen</p>
          <h2 class="text-2xl font-bold text-navy mb-6">Transparante tarieven</h2>
          <div class="space-y-4">
            {[{n:'Starter',p:'€800',f:'/maand',d:'1 chatbot, kennisbank t/m 500 paginas, basis analytics, e-mail leads'},{n:'Growth',p:'€2.000',f:'/maand',d:'Onbeperkt, CRM-koppeling, A/B-testen, prioriteit support'},{n:'Enterprise',p:'Op maat',f:'',d:'Multi-site, SSO, dedicated infra, SLA'}].map(t=>(
              <div class="card">
                <div class="flex items-start justify-between mb-2"><div><p class="font-bold text-navy">{t.n}</p><p class="text-sm text-slate-500">{t.d}</p></div><div class="text-right flex-shrink-0 ml-4"><p class="font-bold text-navy">{t.p}</p><p class="text-xs text-slate-400">{t.f}</p></div></div>
              </div>
            ))}
          </div>
          <a href="/demo-aanvragen/" class="btn-primary mt-6 w-full justify-center">Gratis demo aanvragen</a>
        </div>
      </div>
      <div class="bg-slate-50 border border-slate-200 rounded-xl p-6 max-w-3xl">
        <p class="text-sm font-bold text-navy mb-3">Gerelateerde diensten</p>
        <ul class="flex flex-wrap gap-3">
          <li><a href="/diensten/ai-klantenservice-omnichannel/" class="text-sm text-brand-indigo hover:underline">AI Klantenservice Omnichannel →</a></li>
          <li><a href="/diensten/ai-lead-qualification/" class="text-sm text-brand-indigo hover:underline">AI Lead Qualification →</a></li>
          <li><a href="/kennisbank/ai-agent-vs-chatbot/" class="text-sm text-brand-indigo hover:underline">AI Agent vs Chatbot →</a></li>
        </ul>
      </div>
    </div>
  </section>
  <section class="section bg-slate-50 border-y border-slate-200">
    <div class="container-page max-w-4xl">
      <p class="eyebrow text-brand-indigo mb-2">Website + AI = 1 partner</p>
      <h2 class="text-2xl lg:text-3xl font-bold text-navy mb-4">Chatbot werkt nóg beter ingebouwd in een AI-ready website</h2>
      <p class="text-slate-600 mb-8 leading-relaxed">Een losse chatbot widget op een verouderde website is suboptimaal. In de AI-Website Bundel komt een AI-ready website + Marco (telefoon) + Emma (WhatsApp + chat) — bespaart €8.014 jaar 1 t.o.v. losse leveranciers, met één contract en één aanspreekpunt.</p>
      <div class="grid md:grid-cols-3 gap-4">
        <a href="/diensten/ai-website-bundel-mkb-nederland/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">AI-Website Bundel</h3>
          <p class="text-xs text-slate-600 mb-3">Website + Marco + Emma in 1 pakket. €4.950 setup + €397/mnd. Bespaart €8.014 jaar 1.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk bundel →</span>
        </a>
        <a href="/diensten/emma/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">Emma — chatbot + WhatsApp</h3>
          <p class="text-xs text-slate-600 mb-3">24/7 leadkwalificatie, FAQ, afspraken, e-commerce-support op website + WhatsApp Business.</p>
          <span class="text-xs text-brand-indigo font-medium">Ontmoet Emma →</span>
        </a>
        <a href="/diensten/website-laten-maken-mkb-nederland-2026/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">AI-ready website laten maken</h3>
          <p class="text-xs text-slate-600 mb-3">Astro/Next/WordPress — Schema.org + Speakable + WCAG 2.2 AA + chatbot ingebouwd vanaf dag 1.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk pakketten →</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section-tight bg-midnight text-pearl">
    <div class="container-page max-w-3xl">
      <h2 class="text-3xl font-bold text-pearl reveal">Meer bezoekers omzetten naar klanten?</h2>
      <p class="mt-4 text-slate-300 reveal reveal-delay-1">Plan een gratis demo en zie de AI chatbot live in actie op uw website.</p>
      <div class="mt-6 flex gap-3 reveal reveal-delay-2">
        <a href="/demo-aanvragen/" class="btn bg-pearl text-navy hover:bg-white text-base px-6 py-3.5">Gratis demo aanvragen</a>
        <a href="/prijzen/" class="btn border border-slate-700 text-pearl hover:bg-slate-800 text-base px-6 py-3.5">Bekijk prijzen</a>
      </div>
    </div>
  </section>
</BaseLayout>
