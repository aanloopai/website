---
import BaseLayout from '../../layouts/BaseLayout.astro';
const schema = { '@context': 'https://schema.org', '@type': 'Service', name: 'AI Social Media Agent', serviceType: 'AI Social Media Agent', description: 'AI agent die social media posts schrijft, publiceert en reacties beheert op LinkedIn, Instagram en Facebook. Starter EUR900/maand. KVK: 88606902.', provider: { '@type': 'Organization', '@id': 'https://aanloopai.nl/#organization' }, areaServed: { '@type': 'Country', name: 'Nederland' }, audience: { '@type': 'BusinessAudience', audienceType: 'MKB Nederland (10-200 medewerkers)' }, offers: [{ '@type': 'Offer', name: 'Starter', price: '900', priceCurrency: 'EUR' }, { '@type': 'Offer', name: 'Growth', price: '2200', priceCurrency: 'EUR' }], hasOfferCatalog: { '@type': 'OfferCatalog', name: 'Dienstenpakketten', itemListElement: [{ '@type': 'Offer', name: 'Starter', price: '900', priceCurrency: 'EUR', description: '2 platforms, 12 posts/maand, basisanalytics' }, { '@type': 'Offer', name: 'Growth', price: '2200', priceCurrency: 'EUR', description: 'Alle platforms, onbeperkt, CRM-sync, reactiebeheer' }, { '@type': 'Offer', priceSpecification: { '@type': 'PriceSpecification', priceCurrency: 'EUR', valueAddedTaxIncluded: false }, name: 'Enterprise', priceCurrency: 'EUR', description: 'Multi-merk, PR-monitoring, dedicated strategist' }] } };
---
<BaseLayout title="AI Social Media Agent: Automatisch Posts & Reacties" description="AI agent die social media posts schrijft, publiceert en reacties beheert op LinkedIn, Instagram en Facebook. Starter €900/maand. KVK: 88606902." schema={schema}>
  <section class="border-b border-slate-200 hero-gradient">
    <div class="container-page py-16 lg:py-24">
      <div class="max-w-3xl">
        <div class="flex items-center gap-4 mb-6 reveal"><div class="accent-band"><span></span><span></span><span></span><span></span></div><span class="eyebrow">AI Agents</span></div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tightest text-navy text-balance leading-[1.05] reveal reveal-delay-1">AI Social Media Agent</h1>
        <p class="mt-6 text-lg text-slate-600 leading-relaxed max-w-2xl reveal reveal-delay-2">Consistent aanwezig op social media zonder er zelf tijd aan te besteden. De AI agent schrijft posts, publiceert op het juiste moment en beheert reacties — in de tone of voice van uw merk.</p>
        <div class="mt-8 flex gap-3 flex-wrap reveal reveal-delay-3">
          <a href="/demo-aanvragen/" class="btn-primary text-base px-6 py-3.5">Gratis demo aanvragen <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></a>
          <a href="/tarieven/" class="btn-outline text-base px-6 py-3.5">Bekijk prijzen</a>
        </div>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container-page">
      <div class="grid lg:grid-cols-2 gap-12">
        <div class="reveal">
          <h2 class="text-2xl font-bold text-navy mb-6">Wat doet de AI Social Media Agent?</h2>
          <ul class="space-y-4">
            {['Posts schrijven in uw eigen tone of voice','Automatisch publiceren op LinkedIn, Instagram en Facebook','Trending topics monitoren in uw branche','Reacties en comments beheren en beantwoorden','Content-kalender op basis van uw evenementen','Hashtag-strategie en optimale posttijden','Maandelijkse performance-rapportage'].map(f=>(
              <li class="flex items-start gap-3 text-sm text-slate-700"><svg class="w-5 h-5 mt-0.5 flex-shrink-0 text-brand-emerald" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>{f}</li>
            ))}
          </ul>
        </div>
        <div class="reveal reveal-delay-2">
          <h2 class="text-2xl font-bold text-navy mb-6">Tarieven</h2>
          <div class="space-y-4">
            {[{n:'Starter',p:'€900',f:'/maand',d:'2 platforms, 12 posts/maand, basisanalytics'},{n:'Growth',p:'€2.200',f:'/maand',d:'Alle platforms, onbeperkt, CRM-sync, reactiebeheer'},{n:'Enterprise',p:'Op maat',f:'',d:'Multi-merk, PR-monitoring, dedicated strategist'}].map(t=>(
              <div class="card"><div class="flex items-start justify-between mb-1"><div><p class="font-bold text-navy">{t.n}</p><p class="text-sm text-slate-500">{t.d}</p></div><div class="text-right flex-shrink-0 ml-4"><p class="font-bold text-navy">{t.p}</p><p class="text-xs text-slate-400">{t.f}</p></div></div></div>
            ))}
          </div>
          <a href="/demo-aanvragen/" class="btn-primary mt-6 w-full justify-center">Gratis demo aanvragen</a>
        </div>
      </div>
    </div>
  </section>
  <section class="section bg-slate-50 border-y border-slate-200">
    <div class="container-page max-w-4xl">
      <p class="eyebrow text-brand-indigo mb-2">Website + AI = 1 partner</p>
      <h2 class="text-2xl lg:text-3xl font-bold text-navy mb-4">Social-media AI werkt nóg beter met website + Emma</h2>
      <p class="text-slate-600 mb-8 leading-relaxed">Social-media-AI publiceert content; bezoekers worden geconverteerd op uw website + telefoon + WhatsApp. In de AI-Website Bundel zitten website + Emma in één pakket — bespaart op jaarbasis, met één contract en één aanspreekpunt voor de hele klantreis.</p>
      <div class="grid md:grid-cols-3 gap-4">
        <a href="/diensten/ai-website-bundel-mkb-nederland/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">AI-Website Bundel</h3>
          <p class="text-xs text-slate-600 mb-3">Website + Emma in 1 pakket. €5.950 setup + €649/mnd all-in. Eén factuur, één SLA.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk bundel →</span>
        </a>
        <a href="/diensten/website-laten-maken-mkb-nederland-2026/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">AI-ready website laten maken</h3>
          <p class="text-xs text-slate-600 mb-3">Astro/Next/WordPress — Schema.org + Speakable + WCAG 2.2 AA + social-pixel ingebouwd.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk pakketten →</span>
        </a>
        <a href="/diensten/emma/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">Emma — DM-afhandeling</h3>
          <p class="text-xs text-slate-600 mb-3">24/7 WhatsApp + chat: vangt social-media DM's en stuurt naar verkoopteam.</p>
          <span class="text-xs text-brand-indigo font-medium">Ontmoet Emma →</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section-tight bg-midnight text-pearl">
    <div class="container-page max-w-3xl">
      <h2 class="text-3xl font-bold text-pearl reveal">Altijd actief op social media?</h2>
      <p class="mt-4 text-slate-300 reveal reveal-delay-1">Plan een gratis demo en zie hoe de AI uw social media beheert.</p>
      <a href="/demo-aanvragen/" class="mt-6 btn bg-pearl text-navy hover:bg-white text-base px-6 py-3.5 reveal reveal-delay-2">Gratis demo aanvragen</a>
    </div>
  </section>
</BaseLayout>
