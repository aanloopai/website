---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import pageImage from '../../assets/images/pages/klantenservice.jpg';
const schema = { '@context': 'https://schema.org', '@type': 'Service', name: 'AI Klantenservice Omnichannel', serviceType: 'AI Klantenservice Omnichannel', description: 'Een AI die uw klantenservice beheert over alle kanalen: telefoon, live chat, WhatsApp en e-mail. Starter EUR2.000/maand. KVK: 88606902.', provider: { '@type': 'Organization', '@id': 'https://aanloopai.nl/#organization' }, areaServed: { '@type': 'Country', name: 'Nederland' }, audience: { '@type': 'BusinessAudience', audienceType: 'MKB Nederland (10-200 medewerkers)' }, offers: [{ '@type': 'Offer', name: 'Starter', price: '2000', priceCurrency: 'EUR' }, { '@type': 'Offer', name: 'Growth', price: '4500', priceCurrency: 'EUR' }], hasOfferCatalog: { '@type': 'OfferCatalog', name: 'Dienstenpakketten', itemListElement: [{ '@type': 'Offer', name: 'Starter', price: '2000', priceCurrency: 'EUR', description: '2-3 kanalen, tot 500 gesprekken/maand' }, { '@type': 'Offer', name: 'Growth', price: '4500', priceCurrency: 'EUR', description: 'Alle kanalen, onbeperkt, sentiment-analyse' }, { '@type': 'Offer', priceSpecification: { '@type': 'PriceSpecification', priceCurrency: 'EUR', valueAddedTaxIncluded: false }, name: 'Enterprise', priceCurrency: 'EUR', description: 'Custom channels, on-premise, SLA' }] } };
---
<BaseLayout title="AI Klantenservice Omnichannel: Telefoon, Chat & WhatsApp" description="Eén AI die uw klantenservice beheert over alle kanalen: telefoon, live chat, WhatsApp en e-mail. Starter €2.000/maand. KVK: 88606902." schema={schema}>
  <section class="border-b border-slate-200 hero-gradient">
    <div class="container-page py-16 lg:py-24">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div class="max-w-3xl">
        <div class="flex items-center gap-4 mb-6 reveal"><div class="accent-band"><span></span><span></span><span></span><span></span></div><span class="eyebrow">AI Agents</span></div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tightest text-navy text-balance leading-[1.05] reveal reveal-delay-1">AI Klantenservice Omnichannel</h1>
        <p class="mt-6 text-lg text-slate-600 leading-relaxed max-w-2xl reveal reveal-delay-2">Eén intelligente AI die uw klantenservice beheert over alle kanalen tegelijk — telefoon, live chat, WhatsApp, e-mail en social media. Consistente service, 24/7, zonder extra personeel.</p>
        <div class="mt-8 flex gap-3 flex-wrap reveal reveal-delay-3">
          <a href="/demo-aanvragen/" class="btn-primary text-base px-6 py-3.5">Gratis demo aanvragen <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></a>
          <a href="/tarieven/" class="btn-outline text-base px-6 py-3.5">Bekijk prijzen</a>
        </div>
      </div>
      <div class="reveal reveal-delay-2">
        <Image src={pageImage} alt="Klantenservice-team in vergaderruimte met laptops — AI omnichannel klantenservice" class="w-full rounded-2xl shadow-xl object-cover aspect-[4/3]" loading="eager" decoding="async" fetchpriority="high" widths={[480, 800, 1200, 1400]} sizes="(min-width: 1024px) 600px, 100vw" format="webp" quality={82} />
      </div>
      </div>
    </div>
  </section>
  <section class="section-tight bg-slate-50 border-b border-slate-200">
    <div class="container-page">
      <p class="text-xs text-slate-400 text-center mb-4">Indicatieve cijfers · resultaten verschillen per situatie</p>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        {[{v:'5 kanalen',l:'tegelijk beheerd'},{v:'−70%',l:'klantenservice kosten'},{v:'24/7',l:'beschikbaar'},{v:'24/7',l:'beschikbaar'}].map(s=>(
          <div class="reveal"><p class="text-2xl font-bold text-navy">{s.v}</p><p class="text-xs text-slate-500 mt-1">{s.l}</p></div>
        ))}
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container-page">
      <div class="grid lg:grid-cols-2 gap-12">
        <div class="reveal">
          <h2 class="text-2xl font-bold text-navy mb-4">Alle kanalen, één AI</h2>
          <div class="grid grid-cols-2 gap-3 mb-6">
            {[{i:'📞',t:'Telefoon'},{i:'💬',t:'Live Chat'},{i:'📱',t:'WhatsApp'},{i:'📧',t:'E-mail'},{i:'📘',t:'Facebook'},{i:'📸',t:'Instagram'}].map(c=>(
              <div class="flex items-center gap-3 p-3 bg-slate-50 rounded-xl border border-slate-200">
                <span class="text-xl">{c.i}</span><span class="text-sm font-medium text-navy">{c.t}</span>
              </div>
            ))}
          </div>
          <ul class="space-y-3">
            {['Eén uniforme kennisbank voor alle kanalen','Klanthistorie over alle kanalen zichtbaar','Escalatie naar juiste medewerker per kanaal','AVG-compliant dataverwerking (n8n self-hosted)','Realtime sentiment-analyse per gesprek'].map(f=>(
              <li class="flex items-start gap-3 text-sm text-slate-700"><svg class="w-5 h-5 mt-0.5 flex-shrink-0 text-brand-emerald" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>{f}</li>
            ))}
          </ul>
        </div>
        <div class="reveal reveal-delay-2">
          <h2 class="text-2xl font-bold text-navy mb-6">Tarieven</h2>
          <div class="space-y-4">
            {[{n:'Starter',p:'€2.000',f:'/maand',d:'3 kanalen, 1 kennisbank, basis analytics, e-mail escalatie'},{n:'Growth',p:'€4.500',f:'/maand',d:'Alle kanalen, CRM-sync, sentiment-analyse, prioriteit support'},{n:'Enterprise',p:'Op maat',f:'',d:'On-premise, SLA, dedicated infra, multi-merk'}].map(t=>(
              <div class="card"><div class="flex items-start justify-between mb-1"><div><p class="font-bold text-navy">{t.n}</p><p class="text-sm text-slate-500">{t.d}</p></div><div class="text-right flex-shrink-0 ml-4"><p class="font-bold text-navy">{t.p}</p><p class="text-xs text-slate-400">{t.f}</p></div></div></div>
            ))}
          </div>
          <a href="/demo-aanvragen/" class="btn-primary mt-6 w-full justify-center">Gratis demo aanvragen</a>
        </div>
      </div>
    </div>
  </section>
  <section class="section bg-slate-50 border-y border-slate-200">
    <div class="container-page max-w-4xl">
      <p class="eyebrow text-brand-indigo mb-2">Website + AI = 1 partner</p>
      <h2 class="text-2xl lg:text-3xl font-bold text-navy mb-4">Omnichannel klantenservice werkt nóg sterker met website + bundel</h2>
      <p class="text-slate-600 mb-8 leading-relaxed">Echte omnichannel-service vereist niet alleen telefoon + WhatsApp + chat, maar ook een AI-ready website die hen voedt met context. In de AI-Website Bundel zitten Emma + website in één pakket — bespaart op jaarbasis, met één contract en één aanspreekpunt.</p>
      <div class="grid md:grid-cols-3 gap-4">
        <a href="/diensten/ai-website-bundel-mkb-nederland/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">AI-Website Bundel</h3>
          <p class="text-xs text-slate-600 mb-3">Website + Emma in 1 pakket. €5.950 setup + €649/mnd all-in. Eén factuur, één SLA.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk bundel →</span>
        </a>
        <a href="/diensten/emma/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">Emma — telefoon-AI</h3>
          <p class="text-xs text-slate-600 mb-3">24/7 telefoon-kanaal van uw omnichannel-service: afspraken, intake, doorverbinden.</p>
          <span class="text-xs text-brand-indigo font-medium">Ontmoet Emma →</span>
        </a>
        <a href="/diensten/website-laten-maken-mkb-nederland-2026/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">AI-ready website laten maken</h3>
          <p class="text-xs text-slate-600 mb-3">Astro/Next/WordPress AI-ready. Schema.org + Speakable + WCAG 2.2 AA + omnichannel-koppeling.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk pakketten →</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section-tight bg-midnight text-pearl">
    <div class="container-page max-w-3xl">
      <h2 class="text-3xl font-bold text-pearl reveal">Klantenservice die altijd beschikbaar is?</h2>
      <p class="mt-4 text-slate-300 reveal reveal-delay-1">Plan een gratis demo en zie uw omnichannel klantenservice live in actie.</p>
      <a href="/demo-aanvragen/" class="mt-6 btn bg-pearl text-navy hover:bg-white text-base px-6 py-3.5 reveal reveal-delay-2">Gratis demo aanvragen</a>
    </div>
  </section>
</BaseLayout>
