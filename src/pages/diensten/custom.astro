---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import pageImage from '../../assets/images/pages/custom.jpg';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Custom AI Workflows',
  serviceType: 'AI Workflow Automatisering op Maat',
  description: 'Maatwerk AI-automatisering voor unieke bedrijfsprocessen van het Nederlandse MKB: offerte-generatie, contractverwerking, voorraadbeheer, rapportage en systeem-integraties.',
  provider: { '@type': 'Organization', '@id': 'https://aanloopai.nl/#organization', name: 'Aanloop AI', url: 'https://aanloopai.nl' },
  areaServed: { '@type': 'Country', name: 'Nederland' },
  url: 'https://aanloopai.nl/diensten/custom/',
};

const faqItems = [
  { question: 'Wat zijn custom AI workflows?', answer: 'Een custom AI workflow is maatwerk-automatisering voor een bedrijfsproces dat geen standaard product kent. Aanloop AI bouwt deze workflows met n8n (self-hosted, AVG-conform) en koppelt ze aan uw bestaande CRM-, ERP- of boekhoudsoftware. Voorbeelden: automatische offerte-generatie, contractverwerking, voorraadbeheer en rapportage.' },
  { question: 'Wat kost een custom AI-project?', answer: 'Custom projecten worden op maat geprijsd. Na de gratis AI-audit ontvangt u een concrete offerte met vaste prijs, scope en tijdlijn — geen verrassingen achteraf. Custom workflows vallen onder het Partner-pakket; de audit zelf is kosteloos en vrijblijvend.' },
  { question: 'Hoe lang duurt een custom AI-traject?', answer: 'Dat hangt af van de scope. We werken in sprints van twee weken met zichtbare voortgang. Een afgebakende workflow is vaak binnen enkele weken live; complexere integraties met meerdere systemen duren langer. De exacte planning staat in de roadmap die u na de audit ontvangt.' },
  { question: 'Welke processen kan Aanloop AI op maat automatiseren?', answer: 'Onder meer offerte-generatie op basis van klantdata en prijsregels, voorraadbeheer met automatische bestelpunten, contractverwerking, e-mail-triage, rapportage-automatisering vanuit meerdere databronnen en koppelingen tussen CRM, ERP en planningsystemen via AI-orchestratie.' },
  { question: 'Hoe verschilt custom van de kant-en-klare AI-assistenten?', answer: 'Kant-en-klare assistenten zoals Emma (AI-receptionist) en Emma (WhatsApp-agent) zijn binnen 7-14 werkdagen live tegen een vaste maandprijs. Een custom workflow lost een uniek, bedrijfsspecifiek proces op dat geen standaard product dekt, en wordt op maat gebouwd en geprijsd.' },
];
---

<BaseLayout
  title="Custom AI Workflows & Automatisering op Maat voor MKB"
  description="Maatwerk AI-automatisering voor unieke bedrijfsprocessen — van offerte-generatie tot voorraadbeheer. Audit, bouw, integratie en training inbegrepen."
  schema={serviceSchema}
  faqSchema={faqItems}
>
  <section class="border-b border-slate-200 hero-gradient">
    <div class="container-page py-16 lg:py-28">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div class="max-w-3xl">
        <div class="flex items-center gap-3 mb-6">
          <div class="accent-band"><span></span><span></span><span></span><span></span></div>
          <span class="eyebrow">Custom AI workflows</span>
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tightest text-navy text-balance leading-[1.05]">
          AI die past bij uw unieke proces.
        </h1>
        <p class="mt-6 text-lg text-slate-600 leading-relaxed max-w-2xl">
          Maatwerk-automatisering voor processen die geen standaard product kennen — van offerte-generatie en contractverwerking tot voorraadbeheer en klantcommunicatie.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row gap-3">
          <a href="/contact/?type=offerte" class="btn-primary text-base px-6 py-3.5">
            Offerte aanvragen
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
          <a href="/demo-aanvragen/" class="btn-outline text-base px-6 py-3.5">Vraag adviesgesprek aan</a>
        </div>
      </div>
      <div class="reveal reveal-delay-2">
        <Image src={pageImage} alt="Code editor op MacBook Pro — custom AI workflows op maat voor uw bedrijf" class="w-full rounded-2xl shadow-xl object-cover aspect-[4/3]" loading="eager" decoding="async" fetchpriority="high" widths={[480, 800, 1200, 1400]} sizes="(min-width: 1024px) 600px, 100vw" format="webp" quality={82} />
      </div>
      </div>
    </div>
  </section>

  <!-- Use cases -->
  <section class="section">
    <div class="container-page">
      <div class="max-w-3xl mb-14 reveal">
        <p class="eyebrow mb-3">Voorbeelden</p>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tightest text-navy text-balance">
          Wat kunnen we voor u automatiseren?
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          { icon: '📄', title: 'Offerte-generatie', desc: 'AI stelt automatisch offertes op op basis van klantdata, productcatalogus en prijsregels.' },
          { icon: '📦', title: 'Voorraadbeheer', desc: 'Voorraadniveaus monitoren, bestelpunten detecteren en leveranciers automatisch aanschrijven.' },
          { icon: '📋', title: 'Contractverwerking', desc: 'Contracten uitlezen, samenvatten, afwijkingen signaleren en handtekeningen coördineren.' },
          { icon: '📬', title: 'E-mail triage', desc: 'Inkomende e-mails sorteren, samenvatten en routeren naar de juiste medewerker of systeem.' },
          { icon: '📊', title: 'Rapportage-automatisering', desc: 'Dagelijkse / wekelijkse rapporten samenstellen vanuit meerdere databronnen.' },
          { icon: '🔗', title: 'Systeem-integraties', desc: 'Koppelingen bouwen tussen CRM, ERP, boekhoud- en planningsystemen via AI-orchestratie.' },
        ].map((uc, i) => (
          <div class={`card reveal reveal-delay-${(i % 3) + 1}`}>
            <div class="text-2xl mb-3">{uc.icon}</div>
            <h3 class="text-base font-bold text-navy mb-2">{uc.title}</h3>
            <p class="text-sm text-slate-600 leading-relaxed">{uc.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="section bg-slate-50/60 border-y border-slate-200">
    <div class="container-page">
      <div class="max-w-3xl mb-14 reveal">
        <p class="eyebrow mb-3">Werkwijze custom</p>
        <h2 class="text-3xl font-bold tracking-tightest text-navy">Hoe een custom project verloopt.</h2>
      </div>
      <ol class="space-y-6">
        {[
          { n: '01', title: 'AI-audit (gratis)', desc: 'We analyseren uw huidige processen en identificeren automatisering-kansen. U ontvangt een rapport met prioriteiten en geschatte ROI.' },
          { n: '02', title: 'Roadmap & offerte', desc: 'Op basis van de audit stellen we een concrete roadmap op met scope, tijdlijn en vaste prijs. Geen verrassingen achteraf.' },
          { n: '03', title: 'Bouw & iteratie', desc: 'We bouwen in sprints van 2 weken. U ziet voortgang, geeft feedback, wij passen aan. Geen black-box ontwikkeling.' },
          { n: '04', title: 'Training & overdracht', desc: 'Uw team leert de workflow bedienen. We documenteren alles en bieden onderhoud en SLA aan.' },
        ].map((step, i) => (
          <li class={`flex gap-6 items-start reveal reveal-delay-${i + 1}`}>
            <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-navy flex items-center justify-center text-white font-bold text-sm">{step.n}</div>
            <div>
              <h3 class="font-bold text-navy">{step.title}</h3>
              <p class="mt-1 text-sm text-slate-600 leading-relaxed">{step.desc}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section bg-slate-50 border-y border-slate-200">
    <div class="container-page max-w-4xl">
      <p class="eyebrow text-brand-indigo mb-2">Website + AI = 1 partner</p>
      <h2 class="text-2xl lg:text-3xl font-bold text-navy mb-4">Custom-AI werkt nóg krachtiger met website + bundel als basis</h2>
      <p class="text-slate-600 mb-8 leading-relaxed">Custom-AI bouwt op uw bestaande infrastructuur. Wie tegelijk een AI-ready website + Emma als basis kiest (AI-Website Bundel), bespaart op jaarbasis t.o.v. losse leveranciers, met één contract en één aanspreekpunt voor zowel standaard als custom-werk.</p>
      <div class="grid md:grid-cols-3 gap-4">
        <a href="/diensten/ai-website-bundel-mkb-nederland/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">AI-Website Bundel</h3>
          <p class="text-xs text-slate-600 mb-3">Website + Emma in 1 pakket. €5.950 setup + €649/mnd all-in. Eén factuur, één SLA.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk bundel →</span>
        </a>
        <a href="/diensten/website-laten-maken-mkb-nederland-2026/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">AI-ready website laten maken</h3>
          <p class="text-xs text-slate-600 mb-3">Astro/Next/WordPress AI-ready basis voor custom-uitbreidingen + Schema.org + WCAG 2.2 AA.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk pakketten →</span>
        </a>
        <a href="/cases/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">Combo-cases bekijken</h3>
          <p class="text-xs text-slate-600 mb-3">5 branche-scenarios met Website + AI bundel + custom-uitbreidingen.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk cases →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container-page max-w-3xl mx-auto">
      <div class="mb-10 reveal">
        <p class="eyebrow mb-3">FAQ</p>
        <h2 class="text-3xl font-bold tracking-tightest text-navy">Veelgestelde vragen over custom AI</h2>
      </div>
      <div class="space-y-3">
        {faqItems.map(item => (
          <details class="card group reveal">
            <summary class="flex items-center justify-between cursor-pointer list-none">
              <span class="text-base font-bold text-navy pr-6">{item.question}</span>
              <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <p class="mt-4 text-sm text-slate-600 leading-relaxed">{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight bg-midnight text-pearl">
    <div class="container-page">
      <div class="max-w-2xl">
        <h2 class="text-3xl lg:text-4xl font-bold tracking-tightest text-pearl">Nieuwsgierig wat er mogelijk is?</h2>
        <p class="mt-4 text-slate-300">Plan een gratis AI-audit van 45 minuten. We analyseren uw processen en tonen de kansen.</p>
        <div class="mt-6 flex gap-3 flex-wrap">
          <a href="/contact/?type=offerte" class="btn bg-pearl text-navy hover:bg-white text-base px-6 py-3.5">Gratis AI-audit aanvragen</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
