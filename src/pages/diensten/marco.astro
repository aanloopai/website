---
import BaseLayout from '../../layouts/BaseLayout.astro';

const features = [
  'Neemt 24/7 gesprekken aan in vloeiend Nederlands',
  'Plant afspraken direct in uw agenda (Google / Outlook)',
  'Levert lead-samenvattingen via Telegram, e-mail of WhatsApp',
  'Herkent terugkerende bellers en personaliseert het gesprek',
  'Onbeperkte gesprekken — geen extra kosten per minuut',
  'Meertalig: NL, EN, FR, DE, ES op aanvraag',
  'CRM-integratie (HubSpot, Salesforce, Pipedrive, eigen systeem)',
  'Live transcripts en gespreksopnames in uw dashboard',
  'Escalatie-protocol: doorverbinden of SMS naar uw team',
  'Live binnen 7 werkdagen, inclusief training en onboarding',
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Marco — AI sekreter',
  description: 'AI-receptionist die uw telefoon 24/7 aanneemt, afspraken plant en leads routeert.',
  brand: { '@type': 'Brand', name: 'Aanloop AI' },
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'EUR',
    lowPrice: '297',
    highPrice: '497',
    offerCount: '2',
  },
};
---

<BaseLayout
  title="Marco — AI sekreter · Aanloop AI"
  description="Marco neemt uw telefoon 24/7 aan in vloeiend Nederlands, plant afspraken en stuurt leads direct naar uw inbox. Live binnen 7 dagen."
  schema={schema}
>
  <!-- Hero -->
  <section class="border-b border-slate-200 relative overflow-hidden hero-gradient">
    <div class="container-page py-16 lg:py-28">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <div class="flex items-center gap-3 mb-6">
            <div class="accent-band"><span></span><span></span><span></span><span></span></div>
            <span class="eyebrow">Marco — AI sekreter</span>
          </div>
          <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-brand-indigo/10 text-brand-indigo mb-4">Meest gekozen</span>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tightest text-navy text-balance leading-[1.05]">
            Uw telefoon nooit meer onbeantwoord.
          </h1>
          <p class="mt-6 text-lg text-slate-600 leading-relaxed max-w-lg">
            Marco is uw AI-receptionist die 24/7 gesprekken aanneemt in vloeiend Nederlands, afspraken plant en leads direct in uw inbox bezorgt.
          </p>
          <div class="mt-8 flex flex-col sm:flex-row gap-3">
            <a href="/contact/?type=demo" class="btn-primary text-base px-6 py-3.5">
              Gratis demo boeken
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </a>
            <a href="/tarieven/" class="btn-outline text-base px-6 py-3.5">Bekijk tarieven</a>
          </div>
        </div>
        <!-- Stats card -->
        <div class="grid grid-cols-2 gap-4">
          {[
            { value: '70%', label: 'minder gemiste gesprekken', color: 'text-brand-indigo' },
            { value: '24/7', label: 'beschikbaar, ook in het weekend', color: 'text-brand-rose' },
            { value: '7 dgn', label: 'gemiddelde time-to-live', color: 'text-brand-amber' },
            { value: '€297', label: 'vanaf per maand all-in', color: 'text-brand-emerald' },
          ].map(s => (
            <div class="card text-center">
              <div class={`text-3xl font-bold ${s.color}`}>{s.value}</div>
              <div class="text-xs text-slate-500 mt-1">{s.label}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="section">
    <div class="container-page">
      <div class="max-w-3xl mb-14 reveal">
        <p class="eyebrow mb-3">Wat zit er in</p>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tightest text-navy text-balance">
          Alles wat een topsekreter doet — maar dan 24/7.
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {features.map((f, i) => (
          <div class={`flex items-start gap-3 p-4 rounded-xl bg-slate-50 border border-slate-100 reveal reveal-delay-${(i % 4) + 1}`}>
            <svg class="w-5 h-5 mt-0.5 flex-shrink-0 text-brand-emerald" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            <span class="text-sm text-slate-700">{f}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section class="section bg-slate-50/60 border-y border-slate-200">
    <div class="container-page">
      <div class="max-w-3xl mb-12 reveal">
        <p class="eyebrow mb-3">Tarieven Marco</p>
        <h2 class="text-3xl font-bold tracking-tightest text-navy">Transparant. Maandelijks opzegbaar.</h2>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        {[
          { name: 'Starter', price: '€297', freq: '/maand', features: ['Tot 200 gesprekken/maand', '1 callscript', 'E-mail lead-routering', 'Dashboard toegang'] },
          { name: 'Groei', price: '€497', freq: '/maand', highlight: true, features: ['Onbeperkte gesprekken', 'Tot 5 callscripts', 'CRM-integratie + Telegram', 'Prioriteit support'] },
          { name: 'Enterprise', price: 'Op maat', freq: '', features: ['Multi-team routing', 'Dedicated account manager', 'SLA + 99.9% uptime', 'On-premise optie'] },
        ].map(p => (
          <div class:list={['card relative reveal', p.highlight && 'border-2 border-navy shadow-xl']}>
            {p.highlight && <span class="absolute -top-3 left-6 px-2.5 py-0.5 bg-navy text-white text-[11px] font-medium tracking-wide uppercase rounded">Aanbevolen</span>}
            <div class="text-sm font-medium text-slate-500 mb-1">{p.name}</div>
            <div class="flex items-baseline gap-1.5 mb-6">
              <span class="text-4xl font-bold text-navy">{p.price}</span>
              {p.freq && <span class="text-sm text-slate-500">{p.freq}</span>}
            </div>
            <ul class="space-y-2.5 mb-8">
              {p.features.map(f => (
                <li class="flex items-start gap-2 text-sm text-slate-700">
                  <svg class="w-4 h-4 mt-0.5 flex-shrink-0 text-brand-emerald" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                  {f}
                </li>
              ))}
            </ul>
            <a href="/contact/" class:list={['block text-center w-full', p.highlight ? 'btn-primary' : 'btn-outline']}>
              Vraag offerte aan
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-tight bg-midnight text-pearl">
    <div class="container-page">
      <div class="max-w-2xl">
        <h2 class="text-3xl lg:text-4xl font-bold tracking-tightest text-pearl text-balance">Klaar om Marco te ontmoeten?</h2>
        <p class="mt-4 text-slate-300">Boek een live demo van 30 minuten — volledig gratis en zonder verplichtingen.</p>
        <div class="mt-6">
          <a href="/contact/?type=demo" class="btn bg-pearl text-navy hover:bg-white text-base px-6 py-3.5">
            Plan een demo
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
