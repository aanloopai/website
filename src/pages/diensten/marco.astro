---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import heroAiAgent from '../../assets/images/hero-ai-agent.png';
import dashboardMockup from '../../assets/images/dashboard-mockup.png';

const features = [
  'Neemt 24/7 gesprekken aan in vloeiend Nederlands',
  'Plant afspraken direct in uw agenda (Google / Outlook)',
  'Levert lead-samenvattingen via Telegram, e-mail of WhatsApp',
  'Herkent terugkerende bellers en personaliseert het gesprek',
  'Onbeperkte gesprekken — geen extra kosten per minuut',
  'Meertalig: NL, EN, FR, DE, ES op aanvraag',
  'CRM-integratie (HubSpot, Salesforce, Pipedrive, eigen systeem)',
  'Live transcripts en gespreksopnames in uw dashboard',
  'Escalatie-protocol: doorverbinden of SMS naar uw team',
  'Live binnen 7 werkdagen, inclusief training en onboarding',
];

const sectorUseCases = [
  { title: 'Horeca & restaurants', slug: '/sectoren/horeca/', body: 'Marco neemt reserveringen aan tot ver na sluitingstijd, beantwoordt vragen over openingstijden en allergenen, en stuurt no-show waarschuwingen. Resultaat: meer volle tafels, geen gemiste boekingen.' },
  { title: 'Vastgoed & makelaars', slug: '/sectoren/vastgoed/', body: 'Bij elke binnenkomende lead vraagt Marco direct naar locatievoorkeur, budget en tijdlijn. De gekwalificeerde lead landt warm in uw CRM — u belt alleen nog de échte koopkandidaten.' },
  { title: 'Accountancy', slug: '/sectoren/accountancy/', body: 'Marco verwerkt aanvragen voor jaarrekeningen, btw-aangiftes en advies, plant intakes en stuurt automatisch de juiste documentenlijst. Tijdens deadline-piekweken neemt Marco de telefoondruk volledig over.' },
  { title: 'Juridisch & advocaten', slug: '/sectoren/ai-voor-advocaten/', body: 'Marco screent zaak-intakes, herkent conflict-of-interest signalen via uw bestandsysteem en stuurt urgente strafrechtzaken direct door naar de piketadvocaat. Vertrouwelijke afhandeling, AVG-compliant.' },
  { title: 'Zorg & welzijn', slug: '/sectoren/zorg/', body: 'Marco doet triage volgens uw protocol, plant consulten in uw EPD-agenda en escaleert spoedgevallen direct naar de waarnemer. NEN 7510-compatibele opzet en EU-only data-routing op aanvraag.' },
  { title: 'ZZP & freelancers', slug: '/sectoren/ai-voor-zzp/', body: 'Geen tijd om elk gesprek te beantwoorden tussen klantafspraken door? Marco vangt elke beller op, kwalificeert het verzoek en stuurt u een samenvatting via WhatsApp — u reageert pas wanneer het past.' },
  { title: 'Bouw & installatie', slug: '/sectoren/bouw/', body: 'Marco neemt offerte-aanvragen aan, registreert locatie, type werk en gewenste planning, en zet alles meteen in uw werkbon-systeem. Storingsmeldingen worden direct geroute naar de servicemonteur van dienst.' },
];

const integrations = {
  Telefonie: ['VoIP / SIP', 'Twilio', 'KPN', 'BelBlock', 'Vonage', 'Eigen nummer (port)'],
  CRM: ['HubSpot', 'Salesforce', 'Pipedrive', 'Microsoft Dynamics', 'Custom API'],
  Agenda: ['Google Workspace', 'Microsoft 365 / Outlook', 'Calendly', 'Cal.com'],
  Notificaties: ['Telegram', 'WhatsApp Business', 'Slack', 'E-mail', 'SMS'],
};

const comparison = [
  { feature: '24/7 beschikbaar (nachten + weekend)', marco: true, mens: false, voicemail: 'Beperkt', antwoorddienst: true },
  { feature: 'Onbeperkte gesprekken zonder extra kosten', marco: true, mens: false, voicemail: true, antwoorddienst: false },
  { feature: 'Plant afspraken direct in uw agenda', marco: true, mens: true, voicemail: false, antwoorddienst: 'Beperkt' },
  { feature: 'Kwalificeert leads volgens uw criteria', marco: true, mens: 'Variabel', voicemail: false, antwoorddienst: false },
  { feature: 'CRM-integratie native', marco: true, mens: 'Handmatig', voicemail: false, antwoorddienst: false },
  { feature: 'Vertrekkosten / wervingskosten', marco: 'Geen', mens: '€8-15k', voicemail: 'Geen', antwoorddienst: 'Setup-fee' },
  { feature: 'Maandelijkse kosten', marco: '€497', mens: '€3.500+', voicemail: '€0-50', antwoorddienst: '€500-2.000' },
  { feature: 'Schaalt mee met groei zonder herinrichten', marco: true, mens: false, voicemail: true, antwoorddienst: false },
  { feature: 'AVG/GDPR-compliant + EU-data', marco: true, mens: true, voicemail: 'Variabel', antwoorddienst: 'Variabel' },
];

const faqItems = [
  { question: 'Hoe snel kan Marco live in mijn bedrijf?', answer: 'Gemiddeld binnen 7 werkdagen voor het Marco en Groei pakket. Tijdens de onboarding trainen we Marco met uw kennisbank, scripts en escalatieprotocol. Op dag 7 zet u het telefoonnummer over of activeert u de doorschakeling — dezelfde dag is Marco volledig operationeel.' },
  { question: 'Welke talen spreekt Marco?', answer: 'Marco spreekt standaard vloeiend Nederlands met natuurlijke prosodie en herkenning van regionale accenten. Op aanvraag voegen we Engels, Duits, Frans en Spaans toe. Marco kan automatisch wisselen op basis van wat de beller spreekt.' },
  { question: 'Wat doet Marco als hij een vraag niet kan beantwoorden?', answer: 'Marco volgt uw escalatieprotocol: doorverbinden naar een specifiek teamlid, een SMS-notificatie sturen, een terugbelafspraak inplannen of een ticket openen in uw helpdesk. U bepaalt zelf wat er bij welke situatie gebeurt.' },
  { question: 'Kan Marco mijn bestaande telefoonnummer gebruiken?', answer: 'Ja. We porten uw bestaande NL-nummer naar onze telefonie-infrastructuur of plaatsen een doorschakeling vanaf uw huidige operator. U houdt hetzelfde nummer en uw klanten merken niets van de wisseling.' },
  { question: 'Worden gesprekken opgenomen en zo ja, waar staan ze opgeslagen?', answer: 'Standaard worden opnames bewaard in EU-datacenters (Frankfurt of Amsterdam) met encryptie at-rest en in-transit. De bewaartermijn is configureerbaar (default 90 dagen). Op aanvraag kunnen we opnames uitschakelen of korte termijn bewaren.' },
  { question: 'Wat kost Marco precies — zijn er verborgen kosten?', answer: 'Nee. Marco is €497/maand all-in — één vast tarief (Marco AI-telefoniste, tot 150 gesprekken, callscript op maat). Groei is €997/maand met onbeperkte gesprekken plus Emma WhatsApp. Onboarding, training, hosting, monitoring en updates zijn inbegrepen. Partner is op maat geprijsd. Bij jaarlijkse betaling krijgt u circa 16% korting.' },
  { question: 'Hoe wordt Marco getraind voor mijn specifieke bedrijf?', answer: 'Tijdens onboarding leveren we een gestructureerde vragenlijst (1-2 uur invullen). Op basis daarvan trainen we Marco op uw diensten, FAQs, prijslijst, openingstijden, escalatieregels en huisstijl. Daarna doen we minimaal twee testrondes met u voordat Marco live gaat.' },
  { question: 'Is Marco AVG/GDPR-compliant?', answer: 'Ja. Aanloop AI is een Nederlandse B.V. (KVK 56312075) met een verwerkersovereenkomst-template, ISO 27001-gecertificeerde cloudinfrastructuur en alle data wordt binnen de EU verwerkt. Voor zorg- en juridische klanten leveren we ook een NEN 7510-compatibele opzet.' },
  { question: 'Wat als Marco een fout maakt of klanten klagen over de AI-stem?', answer: 'Iedere klant krijgt een dashboard met live transcripts. Bij opmerkingen passen we het script binnen 24 uur aan. Daarnaast kunt u Marco automatisch laten doorverbinden zodra een beller "menselijke medewerker" of vergelijkbare termen gebruikt — kun u zelf instellen.' },
  { question: 'Kan ik Marco testen voordat ik teken?', answer: 'Ja, tijdens een gratis demo van 30 minuten laten we Marco een echt scenario uit uw branche afhandelen. U mag bellen, lastige vragen stellen en sturen op het script. Pas daarna beslist u of u verder wilt.' },
  { question: 'Marco vs een echte receptionist of antwoorddienst — wat is het verschil?', answer: 'Marco is altijd beschikbaar (24/7), schaalt automatisch en kost een fractie van een fulltime receptionist (€497-997/maand vs €3.500+). Vergeleken met een antwoorddienst kwalificeert Marco leads, plant agenda-afspraken en integreert direct met uw CRM. Voor 80% van de MKB-vraagstukken is Marco de meer betrouwbare en goedkopere keuze.' },
  { question: 'Wat gebeurt er als ik Marco wil opzeggen?', answer: 'Maandelijkse abonnementen zijn opzegbaar met één maand opzegtermijn. Bij opzegging porten we uw nummer terug naar uw oude operator of behoudt u het via ons als overdrachtsabonnement. Geen exit-kosten, geen lock-in.' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Marco — AI Receptionist & AI Telefoniste',
  alternateName: ['AI receptionist Nederland', 'AI receptioniste', 'AI telefonist Nederland', 'virtuele receptionist', 'AI antwoordapparaat MKB'],
  description: 'AI-receptionist voor het Nederlandse MKB die telefoon 24/7 aanneemt in vloeiend Nederlands, afspraken plant in uw agenda, leads kwalificeert en routeert naar uw CRM.',
  brand: { '@type': 'Brand', name: 'Aanloop AI' },
  category: 'AI Receptionist Software',
  serviceType: 'AI Receptionist',
  url: 'https://aanloopai.nl/diensten/marco/',
  audience: { '@type': 'BusinessAudience', audienceType: 'MKB Nederland' },
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'EUR',
    lowPrice: '497',
    highPrice: '5000',
    offerCount: '3',
    availability: 'https://schema.org/InStock',
    seller: { '@type': 'Organization', name: 'Aanloop AI', url: 'https://aanloopai.nl' },
  },
};

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Marco — AI Receptionist',
  alternateName: ['AI receptionist Nederland', 'AI receptioniste', 'AI telefonist Nederland', 'virtuele receptionist', 'AI antwoordapparaat'],
  description: 'Cloud-gebaseerde AI-telefoniste voor MKB Nederland: 24/7 vloeiend Nederlands, agenda-integratie (Google/Outlook), CRM-koppeling (HubSpot/Salesforce/Pipedrive), live transcripts en EU-only datalokatie.',
  url: 'https://aanloopai.nl/diensten/marco/',
  applicationCategory: 'BusinessApplication',
  applicationSubCategory: 'AI Voice Agent / AI Receptionist',
  operatingSystem: 'Cloud (telephony + browser dashboard)',
  inLanguage: ['nl-NL', 'en', 'de', 'fr', 'es'],
  isAccessibleForFree: false,
  creator: { '@type': 'Organization', '@id': 'https://aanloopai.nl/#organization', name: 'Aanloop AI', url: 'https://aanloopai.nl' },
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'EUR',
    lowPrice: '497',
    highPrice: '5000',
    offerCount: '3',
    availability: 'https://schema.org/InStock',
  },
  featureList: features,
  audience: { '@type': 'BusinessAudience', audienceType: 'MKB Nederland' },
};
---

<BaseLayout
  title="Marco — AI Receptionist Nederland, 24/7 Telefoon"
  description="Marco is uw AI-receptionist die 24/7 de telefoon aanneemt in vloeiend Nederlands, afspraken plant en leads naar uw inbox stuurt."
  schema={[schema, softwareSchema]}
  faqSchema={faqItems}
>
  <!-- Hero -->
  <section class="border-b border-slate-200 relative overflow-hidden hero-gradient">
    <div class="container-page py-16 lg:py-28">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <div class="flex items-center gap-3 mb-6">
            <div class="accent-band"><span></span><span></span><span></span><span></span></div>
            <span class="eyebrow">Marco — AI sekreter</span>
          </div>
          <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-brand-indigo/10 text-brand-indigo mb-4">Meest gekozen</span>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tightest text-navy text-balance leading-[1.05]">
            Marco — Uw AI-receptionist voor Nederland (24/7 telefoon, NL-spraak)
          </h1>
          <p class="mt-6 text-lg text-slate-600 leading-relaxed max-w-lg">
            Marco is uw AI-receptionist en virtuele receptionist die 24/7 gesprekken aanneemt in vloeiend Nederlands, afspraken plant en leads direct in uw inbox bezorgt. De AI-telefonist die nooit slaapt.
          </p>
          <div class="mt-8 flex flex-col sm:flex-row gap-3">
            <a href="/demo-aanvragen/" class="btn-primary text-base px-6 py-3.5">
              Gratis demo boeken
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </a>
            <a href="/tarieven/" class="btn-outline text-base px-6 py-3.5">Bekijk tarieven</a>
          </div>
        </div>
        <!-- Hero visual: AI receptionist device with overlay stat cards -->
        <div class="relative">
          <div class="absolute -inset-6 -z-10 bg-gradient-to-br from-brand-indigo/15 via-transparent to-brand-rose/10 blur-3xl"></div>
          <div class="rounded-3xl overflow-hidden shadow-2xl shadow-slate-900/20 ring-1 ring-slate-200/50">
            <Image
              src={heroAiAgent}
              alt="Marco AI receptionist — 24/7 telefoon-assistent voor MKB Nederland, vloeiend Nederlands"
              class="w-full h-auto"
              loading="eager"
              decoding="async"
              widths={[400, 600, 900, 1200]}
              sizes="(min-width: 1024px) 50vw, 100vw"
              format="webp"
              quality={88}
            />
          </div>
          <!-- Floating stat: minder gemiste gesprekken -->
          <div class="absolute -top-4 -left-4 bg-white rounded-2xl shadow-xl border border-slate-100 p-4 hidden sm:block">
            <div class="text-2xl font-bold text-brand-indigo">70%</div>
            <div class="text-[11px] text-slate-500 mt-0.5 leading-tight">minder gemiste<br/>gesprekken</div>
          </div>
          <!-- Floating stat: vanaf prijs -->
          <div class="absolute -bottom-5 -right-4 bg-white rounded-2xl shadow-xl border border-slate-100 p-4 hidden sm:block">
            <div class="text-2xl font-bold text-brand-emerald">€497</div>
            <div class="text-[11px] text-slate-500 mt-0.5 leading-tight">vanaf p/mnd<br/>all-in</div>
          </div>
          <!-- Floating "live" indicator -->
          <div class="absolute top-1/2 -translate-y-1/2 -right-2 bg-white rounded-full shadow-lg border border-slate-100 px-3 py-1.5 hidden md:flex items-center gap-2">
            <span class="relative flex h-2.5 w-2.5">
              <span class="absolute inline-flex h-full w-full rounded-full bg-brand-emerald opacity-75 animate-ping"></span>
              <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-brand-emerald"></span>
            </span>
            <span class="text-xs font-semibold text-navy">24/7 live</span>
          </div>
        </div>

        <!-- Mobile-only stat strip (compensates for hidden floating stats on small screens) -->
        <div class="grid grid-cols-3 gap-3 sm:hidden mt-6">
          <div class="text-center">
            <div class="text-xl font-bold text-brand-indigo">70%</div>
            <div class="text-[10px] text-slate-500 mt-0.5">minder gemist</div>
          </div>
          <div class="text-center">
            <div class="text-xl font-bold text-brand-rose">24/7</div>
            <div class="text-[10px] text-slate-500 mt-0.5">beschikbaar</div>
          </div>
          <div class="text-center">
            <div class="text-xl font-bold text-brand-emerald">€497</div>
            <div class="text-[10px] text-slate-500 mt-0.5">v/a per maand</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="section">
    <div class="container-page">
      <div class="max-w-3xl mb-14 reveal">
        <p class="eyebrow mb-3">Wat zit er in</p>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tightest text-navy text-balance">
          Alles wat een topsekreter doet — maar dan 24/7.
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {features.map((f, i) => (
          <div class={`flex items-start gap-3 p-4 rounded-xl bg-slate-50 border border-slate-100 reveal reveal-delay-${(i % 4) + 1}`}>
            <svg class="w-5 h-5 mt-0.5 flex-shrink-0 text-brand-emerald" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            <span class="text-sm text-slate-700">{f}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Wat is een AI-receptionist? -->
  <section class="section border-b border-slate-200">
    <div class="container-page">
      <div class="max-w-3xl reveal">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tightest text-navy mb-4">Wat is een AI-receptionist?</h2>
        <p class="text-slate-600 leading-relaxed mb-4">
          Een <strong>AI-receptionist</strong> — ook wel AI-receptioniste, AI-telefonist of virtuele receptionist genoemd — is een cloud-gebaseerde spraak-AI die inkomende telefoongesprekken aanneemt namens uw bedrijf. In tegenstelling tot een voicemail of traditionele antwoorddienst begrijpt een AI-receptionist de inhoud van het gesprek, beantwoordt vragen uit uw kennisbank, plant afspraken direct in uw agenda en stuurt leads door naar uw CRM — volledig automatisch, 24 uur per dag.
        </p>
        <p class="text-slate-600 leading-relaxed mb-4">
          Marco is de AI-receptionist van Aanloop AI, speciaal ontwikkeld voor het Nederlandse MKB. Hij spreekt vloeiend Nederlands met natuurlijke intonatie, herkent regionale uitspraken en volgt uw eigen escalatieprotocol wanneer een beller een menselijke medewerker nodig heeft. Vergeleken met een klassiek AI-antwoordapparaat of generieke voicebot biedt een moderne AI-receptionist actieve gespreksafhandeling: hij vraagt door, kwalificeert leads en registreert alle informatie zonder dat u daar iets voor hoeft te doen.
        </p>
        <p class="text-slate-600 leading-relaxed mb-4">
          Voor MKB-bedrijven in Nederland is een AI-receptionist inmiddels een bewezen alternatief voor een fulltime receptioniste (kostenbesparing van doorgaans €2.000-3.000 per maand) of voor een externe antwoorddienst (betere kwaliteit, directe agenda-koppeling, geen per-minuut-kosten). Wilt u weten wat een AI-agent voor uw situatie kost?
        </p>
        <a href="/kennisbank/hoeveel-kost-een-ai-agent/" class="inline-flex items-center gap-1.5 text-brand-indigo font-medium hover:underline text-sm">
          Lees: Wat kost een AI-agent in Nederland? (volledig kostenoverzicht)
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="section bg-slate-50/60 border-y border-slate-200">
    <div class="container-page">
      <div class="max-w-3xl mb-14 reveal">
        <p class="eyebrow mb-3">Hoe werkt Marco</p>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tightest text-navy text-balance">
          Van eerste gesprek tot live: 3 stappen, 7 werkdagen.
        </h2>
        <p class="mt-4 text-slate-600 leading-relaxed">
          Geen lange implementatietrajecten of dure consultants. Aanloop AI levert Marco standaard op binnen
          één werkweek, inclusief training met uw eigen kennisbank en escalatieprotocol.
        </p>
      </div>
      <ol class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <li class="card reveal reveal-delay-1">
          <div class="text-3xl font-bold text-brand-indigo mb-3">01</div>
          <h3 class="text-lg font-bold text-navy mb-2">Onboarding &amp; training</h3>
          <p class="text-sm text-slate-600 leading-relaxed">U vult een gestructureerde intake-vragenlijst in (1-2 uur). Wij trainen Marco met uw diensten, FAQ&apos;s, prijzen, openingstijden, escalatieregels en de tone-of-voice die bij uw merk past. Twee testrondes met u zorgen dat alles klopt vóór de live-gang.</p>
        </li>
        <li class="card reveal reveal-delay-2">
          <div class="text-3xl font-bold text-brand-rose mb-3">02</div>
          <h3 class="text-lg font-bold text-navy mb-2">Live op uw nummer</h3>
          <p class="text-sm text-slate-600 leading-relaxed">U houdt uw bestaande NL-nummer. We porten het naar onze infrastructuur óf stellen een doorschakeling in vanaf uw huidige operator. Marco neemt vanaf dat moment elke beller aan, plant afspraken in uw agenda en stuurt samenvattingen waar u ze wilt: e-mail, WhatsApp, Telegram of CRM.</p>
        </li>
        <li class="card reveal reveal-delay-3">
          <div class="text-3xl font-bold text-brand-emerald mb-3">03</div>
          <h3 class="text-lg font-bold text-navy mb-2">Continue verbetering</h3>
          <p class="text-sm text-slate-600 leading-relaxed">Iedere week ontvangt u een rapport met gespreksvolume, conversieratio en transcripten van interessante calls. Wij stellen scriptverbeteringen voor; u beslist. Marco wordt beter elke maand zonder dat u extra hoeft te trainen.</p>
        </li>
      </ol>

      <!-- Dashboard preview — wat klanten elke dag in handen hebben -->
      <div class="mt-16 reveal">
        <div class="grid lg:grid-cols-5 gap-10 items-center">
          <div class="lg:col-span-2">
            <p class="eyebrow mb-3">Live klantdashboard</p>
            <h3 class="text-2xl sm:text-3xl font-bold tracking-tightest text-navy text-balance mb-4">
              Iedere call, iedere lead, in één overzicht.
            </h3>
            <p class="text-slate-600 leading-relaxed mb-6">
              Vanaf dag 1 ziet u realtime hoe Marco presteert: actieve gesprekken, gemiddelde antwoordtijd, conversie per dag en transcripts van elke call. Geen black box — u heeft de controle.
            </p>
            <ul class="space-y-2.5">
              {[
                'Realtime gespreks- en lead-metrics',
                'Volledige transcripts en opnames',
                'Wekelijkse rapportage per e-mail',
                'Export naar uw BI-tool (Looker, Power BI)',
              ].map(f => (
                <li class="flex items-start gap-2 text-sm text-slate-700">
                  <svg class="w-4 h-4 mt-0.5 flex-shrink-0 text-brand-emerald" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                  {f}
                </li>
              ))}
            </ul>
          </div>
          <div class="lg:col-span-3 relative">
            <div class="absolute -inset-6 -z-10 bg-gradient-to-br from-brand-indigo/10 via-transparent to-brand-emerald/10 blur-3xl"></div>
            <div class="rounded-2xl overflow-hidden shadow-2xl shadow-slate-900/15 ring-1 ring-slate-200/60 bg-midnight">
              <Image
                src={dashboardMockup}
                alt="Marco klant-dashboard — live gespreksmetrics, leads en conversie van uw AI-receptionist"
                class="w-full h-auto"
                loading="lazy"
                decoding="async"
                widths={[480, 800, 1200, 1600]}
                sizes="(min-width: 1024px) 60vw, 100vw"
                format="webp"
                quality={85}
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Sector use cases -->
  <section class="section">
    <div class="container-page">
