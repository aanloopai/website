---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import pageImage from '../../assets/images/pages/diensten-index.jpg';

const producten = [
  { href: '/diensten/emma/', title: 'Emma — AI Sekreter', description: 'Neemt uw telefoon 24/7 aan, plant afspraken in en levert leads direct in uw inbox — WhatsApp inbegrepen. Vloeiend Nederlands.', badge: 'Meest gekozen', icon: '📞', price: 'v.a. €497/maand' },
  { href: '/diensten/telefoon-assistent/', title: 'AI Telefoon Assistent', description: 'Eigen NL-telefoonnummer, intake, doorverbinden en samenvattingen. Volledig aanpasbaar.', icon: '☎️', price: 'v.a. €497/maand' },
  { href: '/diensten/custom/', title: 'Custom AI Workflows', description: 'Maatwerk-automatisering voor unieke processen: offerte-generatie, voorraadbeheer, interne kennisbank.', icon: '⚙️', price: 'Op maat' },
  { href: '/diensten/audit/', title: 'AI Strategie & Audit', description: '45-minuten analyse van uw processen. Concrete aanbevelingen voor AI-implementatie met ROI-berekening.', icon: '🔍', price: 'Gratis intake' },
];

const websites = [
  { href: '/diensten/ai-website-bundel-mkb-nederland/', title: 'AI-Website Bundel', description: 'All-in-one: AI-ready website + Emma. Eén factuur, één SLA, één maandbedrag.', badge: 'Meest waardevol', icon: '🎯', price: 'v.a. €5.950 setup + €649/mnd' },
  { href: '/diensten/website-laten-maken-mkb-nederland-2026/', title: 'Website laten maken', description: 'AI-ready website met Schema.org + Speakable. Astro/Next/WordPress. Live binnen 4-8 weken.', icon: '🌐', price: 'v.a. €3.450 setup' },
  { href: '/diensten/webshop-laten-maken-shopify-woocommerce-nederland-2026/', title: 'Webshop laten maken', description: 'Shopify, WooCommerce of Lightspeed. iDeal/Mollie, PostNL/DHL, AI product-descriptions, WhatsApp cart-recovery.', icon: '🛍️', price: 'v.a. €4.950 setup' },
];

const catalog = [
  { href: '/diensten/ai-chatbot-website/', title: 'AI Chatbot Website', description: '24/7 klantvragen beantwoorden, leads kwalificeren en bezoekers begeleiden naar een aankoop.', icon: '🤖', price: 'v.a. €800/maand' },
  { href: '/diensten/ai-email-assistent/', title: 'AI E-mail Assistent', description: 'Sorteert, prioriteert en beantwoordt automatisch inkomende e-mails. Bespaar 5+ uur per week.', icon: '📧', price: 'v.a. €600/maand' },
  { href: '/diensten/ai-lead-qualification/', title: 'AI Lead Qualification', description: 'BANT-kwalificatie van inkomende leads. Alleen serieuze prospects bij uw salesteam.', icon: '🎯', price: 'v.a. €1.100/maand' },
  { href: '/diensten/ai-klantenservice-omnichannel/', title: 'AI Klantenservice Omnichannel', description: 'Één AI voor telefoon, chat, WhatsApp en e-mail. Consistente service, 24/7.', icon: '🌐', price: 'v.a. €2.000/maand' },
  { href: '/diensten/ai-document-processing/', title: 'AI Document Processing', description: 'Facturen, contracten en PDF\'s automatisch uitlezen, categoriseren en verwerken.', icon: '📄', price: 'v.a. €1.200/maand' },
  { href: '/diensten/ai-social-media-agent/', title: 'AI Social Media Agent', description: 'Posts schrijven, publiceren en reacties beheren op LinkedIn, Instagram en Facebook.', icon: '📱', price: 'v.a. €900/maand' },
  { href: '/diensten/ai-hr-recruitment/', title: 'AI HR & Recruitment', description: 'Vacatureteksten, CV-screening, eerste interviews. Bespaar 60% recruitmenttijd.', icon: '👥', price: 'v.a. €1.500/maand' },
  { href: '/diensten/ai-afspraken-inplannen/', title: 'AI Afspraken Inplannen', description: '24/7 afspraken boeken via telefoon, chat of WhatsApp. Nooit meer een dubbele boeking.', icon: '🗓️', price: 'v.a. €700/maand' },
  { href: '/diensten/ai-seo-content-generator/', title: 'AI SEO Content Generator', description: 'SEO-artikelen, landingspagina\'s en blogs in uw tone of voice. Ranken in Google.', icon: '✍️', price: 'v.a. €1.000/maand' },
  { href: '/diensten/ai-verkoopagent-outbound/', title: 'AI Verkoopagent Outbound', description: 'Prospects automatisch bellen, kwalificeren en opvolgen. Schaalbare outbound sales.', icon: '📣', price: 'v.a. €1.500/maand' },
  { href: '/ai-vindbaarheid/', title: 'AI-vindbaarheid (GEO)', description: 'Word gevonden en aanbevolen in ChatGPT, Gemini en Claude. Generative Engine Optimization voor het Nederlandse MKB.', icon: '🔎', price: 'Gratis scan · v.a. €595/mnd' },
];
const allDiensten = [...websites, ...producten, ...catalog];
const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': 'https://aanloopai.nl/diensten/#collection',
  name: 'Alle Diensten — Aanloop AI',
  description: '17 diensten voor het Nederlandse MKB: AI-Website Bundel, website-bouw, webshop-bouw, AI receptionist (WhatsApp inbegrepen), telefooncentrale, document processing, e-mail assistent en meer.',
  url: 'https://aanloopai.nl/diensten/',
  inLanguage: 'nl-NL',
  isPartOf: { '@type': 'WebSite', '@id': 'https://aanloopai.nl/#website' },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: allDiensten.length,
    itemListElement: allDiensten.map((d, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: `https://aanloopai.nl${d.href}`,
      name: d.title,
    })),
  },
};

const faqItems = [
  { question: 'Welke AI-diensten biedt Aanloop AI aan?', answer: 'Aanloop AI biedt 17 diensten voor het Nederlandse MKB: kant-en-klare AI-assistenten (Emma AI-receptionist met WhatsApp inbegrepen, AI telefoon-assistent), website- en webshop-bouw, de AI-Website Bundel, en gespecialiseerde AI-agents zoals document processing, e-mail-assistent, lead-qualification, omnichannel klantenservice en custom workflows.' },
  { question: 'Wat kost een AI-dienst bij Aanloop AI?', answer: 'De prijzen zijn vast en transparant. Kant-en-klare assistenten starten bij €497/maand (Emma), de Groei-bundel met Emma kost €997/maand. Gespecialiseerde diensten lopen van €600 tot €2.000/maand. De AI-Website Bundel start bij €5.950 setup + €649/maand all-in. Custom workflows zijn op maat geprijsd. Alle prijzen exclusief 21% btw.' },
  { question: 'Hoe snel is een AI-dienst live?', answer: 'Kant-en-klare AI-assistenten zoals Emma zijn live binnen 7 werkdagen. Website- en webshop-trajecten duren 4 tot 8 weken. Custom workflows hangen af van de scope; na de gratis AI-scan ontvangt u een exacte planning.' },
  { question: 'Kan ik diensten los afnemen of alleen als bundel?', answer: 'Beide. U kunt elke dienst los afnemen, of kiezen voor een bundel met meer voordeel. De AI-Website Bundel combineert website, Emma in één traject met één factuur en is op jaarbasis voordeliger dan losse afname.' },
  { question: 'Welke AI-dienst past het beste bij mijn bedrijf?', answer: 'Dat hangt af van uw grootste knelpunt. Mist u telefonische bereikbaarheid, dan past Emma. Krijgt u veel WhatsApp-vragen, dan Emma. Heeft u een uniek proces, dan een custom workflow. Twijfelt u, plan dan de gratis AI-scan van 30 minuten — wij analyseren uw processen en adviseren de meest rendabele aanpak met ROI-berekening.' },
];
---
<BaseLayout
  title="Alle Diensten — Websites, Webshops & AI"
  description="AI-implementatie voor het MKB: 17 diensten. AI-Website Bundel, website + webshop, AI-receptionist Emma (WhatsApp inbegrepen) en document processing."
  schema={collectionSchema}
  faqSchema={faqItems}
>
  <section class="border-b border-slate-200 hero-gradient">
    <div class="container-page py-16 lg:py-24">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div class="max-w-3xl">
        <div class="flex items-center gap-4 mb-6 reveal"><div class="accent-band"><span></span><span></span><span></span><span></span></div><span class="eyebrow">Onze diensten</span></div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tightest text-navy text-balance leading-[1.05] reveal reveal-delay-1">Websites, webshops en AI — alles van één partner.</h1>
        <p class="mt-6 text-lg text-slate-600 leading-relaxed max-w-2xl reveal reveal-delay-2">Wij bouwen uw website of webshop AI-ready vanaf dag 1, en leveren Emma en chatbots als één geïntegreerd systeem. Van losse modules tot complete bundels — altijd in het Nederlands, altijd met vaste prijzen.</p>
        <div class="mt-8 flex gap-3 flex-wrap reveal reveal-delay-3">
          <a href="/demo-aanvragen/" class="btn-primary text-base px-6 py-3.5">Gratis demo aanvragen <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></a>
          <a href="/gratis-ai-scan/" class="btn-outline text-base px-6 py-3.5">Gratis AI scan</a>
        </div>
      </div>
      <div class="reveal reveal-delay-2">
        <Image src={pageImage} alt="Process flow op whiteboard — overzicht van 15 AI-oplossingen voor Nederlandse MKB" class="w-full rounded-2xl shadow-xl object-cover aspect-[4/3]" loading="eager" decoding="async" fetchpriority="high" widths={[480, 800, 1200, 1400]} sizes="(min-width: 1024px) 600px, 100vw" format="webp" quality={82} />
      </div>
      </div>
    </div>
  </section>

  <!-- Websites & Webshops (NIEUW — top-positie voor maximale zichtbaarheid) -->
  <section class="section">
    <div class="container-page">
      <div class="mb-10 reveal">
        <p class="eyebrow mb-2">Websites &amp; Webshops</p>
        <h2 class="text-2xl font-bold text-navy">Wij bouwen uw site én de AI eromheen</h2>
        <p class="mt-2 text-slate-600 text-sm max-w-xl">Eén partner voor uw hele digitale presentie. AI-ready architectuur vanaf dag 1, schema.org + Speakable, AVG/UAVG-conform, eigendom 100% bij u.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {websites.map((s, i) => (
          <a href={s.href} class:list={['group block card hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200 relative', i === 0 && 'border-2 border-brand-emerald']}>
            {s.badge && <span class="absolute -top-3 left-5 px-2.5 py-0.5 bg-brand-emerald text-white text-[11px] font-medium tracking-wide uppercase rounded">{s.badge}</span>}
            <div class="flex items-start gap-4">
              <span class="text-2xl flex-shrink-0">{s.icon}</span>
              <div class="flex-1 min-w-0">
                <h3 class="font-bold text-navy group-hover:text-brand-indigo transition-colors text-sm">{s.title}</h3>
                <p class="text-xs text-slate-500 mt-1 leading-relaxed">{s.description}</p>
                <p class="text-xs font-semibold text-brand-indigo mt-3">{s.price}</p>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Kernproducten -->
  <section class="section bg-slate-50 border-y border-slate-200">
    <div class="container-page">
      <div class="mb-10 reveal">
        <p class="eyebrow mb-2">Kernproducten</p>
        <h2 class="text-2xl font-bold text-navy">Kant-en-klare AI-assistenten</h2>
        <p class="mt-2 text-slate-600 text-sm max-w-xl">Live binnen 7 werkdagen. Inclusief setup, training en onboarding.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {producten.map((s, i) => (
          <a href={s.href} class:list={['group block card hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200 relative', i === 0 && 'border-2 border-navy']}>
            {i === 0 && <span class="absolute -top-3 left-5 px-2.5 py-0.5 bg-navy text-white text-[11px] font-medium tracking-wide uppercase rounded">Meest gekozen</span>}
            <div class="flex items-start gap-4">
              <span class="text-2xl flex-shrink-0">{s.icon}</span>
              <div class="flex-1 min-w-0">
                <h3 class="font-bold text-navy group-hover:text-brand-indigo transition-colors text-sm">{s.title}</h3>
                <p class="text-xs text-slate-500 mt-1 leading-relaxed">{s.description}</p>
                <p class="text-xs font-semibold text-brand-indigo mt-3">{s.price}</p>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Service catalog -->
  <section class="section">
    <div class="container-page">
      <div class="mb-10 reveal">
        <p class="eyebrow mb-2">Service Catalog</p>
        <h2 class="text-2xl font-bold text-navy">Gespecialiseerde AI-diensten</h2>
        <p class="mt-2 text-slate-600 text-sm max-w-xl">Op maat gebouwde AI-agents voor specifieke bedrijfsprocessen.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {catalog.map(s => (
          <a href={s.href} class="group block card hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200">
            <div class="flex items-start gap-4">
              <span class="text-2xl flex-shrink-0">{s.icon}</span>
              <div class="flex-1 min-w-0">
                <h3 class="font-bold text-navy group-hover:text-brand-indigo transition-colors text-sm">{s.title}</h3>
                <p class="text-xs text-slate-500 mt-1 leading-relaxed">{s.description}</p>
                <p class="text-xs font-semibold text-brand-indigo mt-3">{s.price}</p>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section bg-slate-50 border-y border-slate-200">
    <div class="container-page max-w-3xl mx-auto">
      <div class="mb-10 reveal">
        <p class="eyebrow mb-2">FAQ</p>
        <h2 class="text-2xl font-bold text-navy">Veelgestelde vragen over onze diensten</h2>
      </div>
      <div class="space-y-3">
        {faqItems.map(item => (
          <details class="card group reveal">
            <summary class="flex items-center justify-between cursor-pointer list-none">
              <span class="text-base font-bold text-navy pr-6">{item.question}</span>
              <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <p class="mt-4 text-sm text-slate-600 leading-relaxed">{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA band -->
  <section class="section-tight bg-midnight text-pearl">
    <div class="container-page max-w-3xl">
      <h2 class="text-3xl font-bold text-pearl reveal">Weet u niet welke oplossing past?</h2>
      <p class="mt-4 text-slate-300 reveal reveal-delay-1">Doe in 30 seconden onze gratis <a href="/ai-oplossing-matcher/" class="text-white underline underline-offset-4 hover:text-brand-indigo">AI-oplossing matcher</a> — of plan een gratis AI-audit van 45 minuten waarin we uw processen analyseren en de meest rendabele aanpak adviseren.</p>
      <div class="mt-6 flex gap-3 flex-wrap reveal reveal-delay-2">
        <a href="/ai-oplossing-matcher/" class="btn bg-pearl text-navy hover:bg-white text-base px-6 py-3.5">Doe de AI-matcher (30 sec)</a>
        <a href="/demo-aanvragen/" class="btn border border-slate-700 text-pearl hover:bg-slate-800 text-base px-6 py-3.5">Gratis demo aanvragen</a>
        <a href="/gratis-ai-scan/" class="btn border border-slate-700 text-pearl hover:bg-slate-800 text-base px-6 py-3.5">Gratis AI scan</a>
      </div>
    </div>
  </section>
</BaseLayout>
