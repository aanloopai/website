---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { EMMA, EMMA_SETUP, WEBSITE_BUNDEL } from '../../data/pricing';

// Website-onderhoud bij losse afname (niet in pricing.ts — losse dienst, geen Emma-tier).
const WEBSITE_ONDERHOUD_MND = 197;
const WEBSITE_SETUP_LOS = 5950;
const INTEGRATIE_LOS = 1500;

const euro = (n: number) => `€${n.toLocaleString('nl-NL')}`;

const inhoud = [
  { categorie: 'Website (Groei pakket)', items: ['Tot 30 paginas + CMS', 'Schema.org + Speakable + WCAG 2.2 AA', 'Astro/Next.js framework, GitHub bij u', 'Multilingual NL/EN/DE', 'Cloudflare Pages hosting'] },
  { categorie: 'Emma AI-receptie', items: ['24/7 NL-telefoonbeantwoording', 'Agenda-koppeling Google/Outlook', 'Lead-samenvattingen via e-mail/WhatsApp', 'CRM-integratie (HubSpot/Pipedrive/etc)', 'Live transcripts in dashboard'] },
  { categorie: 'Emma WhatsApp Agent', items: ['Klantvragen 24/7 in seconden', 'Getraind op uw kennisbank', 'Menselijke handover bij complex', 'WhatsApp Business API', 'Lead-capture naar CRM'] },
  { categorie: 'Operational tooling', items: ['ROI-calc widget op uw site', 'AI-scan formulier (lead-magnet)', 'GA4 + GrowthBook A/B-test setup', 'Maandelijkse performance-rapport', 'Prioriteit support binnen 4u werkdag'] },
];

// Wat u apart inkoopt vs. wat er in de bundel zit. Onze eigen listprijzen —
// geen opgeblazen "marktprijzen", en geen jaar-1-optelsom: wie los inkoopt,
// koopt niet alles tegelijk. Eén regel per post, en per post wat de bundel
// ermee doet. WhatsApp staat er niet apart in: die zit al in Emma AI-receptie.
const setupPosten = [
  { item: 'Website Groei — eenmalige bouw', toelichting: 'Tot 30 paginas, CMS, multilingual NL/EN/DE', los: euro(WEBSITE_SETUP_LOS), bundel: euro(WEBSITE_BUNDEL.setup) },
  { item: 'Emma AI-receptie — eenmalige setup', toelichting: 'Belscript, stem-training, telefoonnummer, koppeling agenda en CRM', los: euro(EMMA_SETUP), bundel: 'Inbegrepen' },
  { item: 'Integratie tussen website, telefonie en WhatsApp', toelichting: 'Bij losse leveranciers doet niemand dit voor u', los: euro(INTEGRATIE_LOS), bundel: 'Inbegrepen' },
];
const maandPosten = [
  { item: 'Website-onderhoud', toelichting: 'Hosting, updates, security, monitoring', los: `${euro(WEBSITE_ONDERHOUD_MND)}/mnd`, bundel: 'Inbegrepen' },
  { item: 'Emma AI-receptie', toelichting: 'Neemt 24/7 uw telefoon op, plant de afspraak, stuurt de lead naar uw CRM. WhatsApp-agent inbegrepen', los: `${euro(EMMA.monthly)}/mnd`, bundel: `${euro(WEBSITE_BUNDEL.maand)}/mnd all-in` },
];

const bundelPrijs = { setup: WEBSITE_BUNDEL.setup, mnd: WEBSITE_BUNDEL.maand };

// Het pakketvoordeel, eerlijk gerekend: de setup-fee van Emma en het
// integratiewerk vervallen, en het maandbedrag ligt onder de som van de twee
// losse abonnementen. Geen jaar-1-optelsom, geen kunstmatig grote korting.
const setupVoordeel = (WEBSITE_SETUP_LOS + EMMA_SETUP + INTEGRATIE_LOS) - bundelPrijs.setup;
const losseMaandlast = WEBSITE_ONDERHOUD_MND + EMMA.monthly;
const maandVoordeel = losseMaandlast - bundelPrijs.mnd;

const waaromUniek = [
  { titel: 'Eén partner, één factuur, één SLA', body: 'Geen "verwijst u naar de webdeveloper" als de chatbot bug heeft. Wij leveren website + AI als één geïntegreerd systeem en zijn aanspreekpunt voor alles.' },
  { titel: 'Architectuur is vanaf dag 1 AI-ready', body: 'Webbureaus bouwen meestal eerst de site, AI komt achteraf. Bij ons zijn de plug-in-slots, schema.org-markup en data-flows al ingebouwd op launch-dag — geen €5-15k retrofit-kosten.' },
  { titel: 'Een pakketkorting die klopt', body: `De setup-fee van Emma (${euro(EMMA_SETUP)}) en het integratiewerk (${euro(INTEGRATIE_LOS)}) vervallen: samen ${euro(setupVoordeel)} voordeel op de eenmalige kosten. Maandelijks betaalt u ${euro(bundelPrijs.mnd)} in plaats van ${euro(losseMaandlast)} voor twee losse abonnementen — ${euro(maandVoordeel)} per maand lager. Geen dramatische kortingspercentages: onze losse prijzen zijn de echte prijzen, en de bundel is precies zoveel voordeliger als het scheelt om alles bij één partij te doen.` },
  { titel: 'Time-to-revenue 6-8 weken ipv 12-20', body: 'Parallel design + AI-training in één traject. Concurrent-route (eerst webdev klaar, dan AI-agency briefen) duurt 3-5 maanden langer. U bent 2-4 maanden eerder live met €30-60k extra omzet.' },
];

const idealVoor = [
  'ZZP/MKB die in 1 keer professioneel online wil komen met AI-eerstelijns-support',
  'Bestaande bedrijven met een verouderde site die zowel design als AI-laag willen vernieuwen',
  'Praktijken (zorg/juridisch/accountancy) die NEN 7510-conform website + AI-receptie nodig hebben',
  'Webshop-eigenaren die ook een content-website willen met cart-recovery via WhatsApp',
  'Multi-locatie ondernemers die 24/7 telefoon + chat over alle vestigingen willen centraliseren',
];

const proces = [
  { stap: '01', titel: 'Discovery (1 sessie, 90 min)', body: 'Business-model, doelgroep, bestaande systemen, telefoon-volume, FAQs, agenda-tools. We mappen direct in welke systemen Emma moeten koppelen en welke website-architectuur er omheen past.' },
  { stap: '02', titel: 'Bouw (week 2-6)', body: 'Parallel-tracks: (a) website-build met AI-ready plug-in slots, (b) Emma-training met uw scripts/escalatie, (c) Emma-training met uw kennisbank. U keurt elke vrijdag voortgang goed in 30-min demo.' },
  { stap: '03', titel: 'Launch + 30-dagen optimalisatie', body: 'Soft-launch week 7 (uw team test). Public-launch week 8. Daarna 30 dagen wekelijkse fine-tuning op basis van echte gespreks-/conversie-data. Bij maand 2 staat alles op auto-pilot.' },
];

const faqItems = [
  { question: 'Wat zit er precies in de bundel?', answer: 'Website (Groei pakket: tot 30 paginas, CMS, multilingual NL/EN/DE) + Emma AI-receptionist (24/7 NL-telefoon, agenda, CRM-koppeling) + Emma WhatsApp Agent (24/7 chat, lead-capture) + alle koppelingen tussen de 3 systemen + ROI-calc/AI-scan widgets op uw site + GA4/GrowthBook setup + maandelijks onderhoud op alles. Eén factuur, één contract, één aanspreekpunt.' },
  { question: 'Wat scheelt de bundel tegenover losse afname?', answer: `Eenmalig: los betaalt u ${euro(WEBSITE_SETUP_LOS)} voor de website-bouw, ${euro(EMMA_SETUP)} Emma-setup en ${euro(INTEGRATIE_LOS)} integratiewerk. In de bundel kost de setup ${euro(bundelPrijs.setup)} — de Emma-setup en het integratiewerk vervallen, samen ${euro(setupVoordeel)} voordeel. Maandelijks: los is dat ${euro(WEBSITE_ONDERHOUD_MND)} website-onderhoud + ${euro(EMMA.monthly)} Emma = ${euro(losseMaandlast)} bij twee contracten; in de bundel ${euro(bundelPrijs.mnd)} all-in, dus ${euro(maandVoordeel)} per maand lager. We tellen die posten bewust niet op tot één jaarbedrag: wie los inkoopt, koopt niet alles op dezelfde dag, en zo'n optelsom laat de korting groter lijken dan hij is.` },
  { question: 'Emma AI-receptie of Emma WhatsApp Agent — wat is het verschil?', answer: 'Emma bestaat in twee smaken. Emma WhatsApp Agent (vanaf €49/mnd, Standard €197/mnd) doet alleen chat: zij beantwoordt WhatsApp-berichten met tekst — FAQ, offerte-aanvragen, lead-capture. Geen telefonie. Emma AI-receptie (€497/mnd) neemt daarnaast ook écht uw telefoon op: een gesprek in het Nederlands, afspraak in de agenda, lead in het CRM. Belangrijk: bij Emma AI-receptie is de WhatsApp-agent al inbegrepen — u betaalt dus niet twee keer. Het prijsverschil komt door telefonie: spraakherkenning, stem-synthese en telefoonminuten zijn fors duurder dan tekstberichten. In deze bundel zit de volledige Emma AI-receptie, dus telefoon én WhatsApp.' },
  { question: 'Kan ik bestaande website behouden en alleen Emma toevoegen?', answer: 'Ja, dat kan via een los Emma-abonnement (zie /diensten/emma/ — daar staan zowel de telefoon- als de WhatsApp-variant). De bundel is voordeliger als u sowieso een nieuwe of vernieuwde site wilt. Als uw huidige site jonger dan 2 jaar is en al schema.org markup heeft, adviseren we losse AI-modules ipv bundel.' },
  { question: 'Wat als ik later wil opzeggen?', answer: 'Maandelijks onderhoud is opzegbaar per maand met 1 maand opzegtermijn. De setup-fee is eenmalig. Bij opzegging behoudt u: uw website-code (in eigen GitHub), uw domeinnaam, alle CRM-data van Emma. Emma stoppen we met doorschakelen, maar de transcripts/lead-data exporteren we naar u toe.' },
  { question: 'Hoe lang duurt het tot we live zijn?', answer: 'Discovery week 1, design + AI-training parallel weken 2-6, soft-launch week 7, public-launch week 8. Bij complexe integraties (zoals zorg-EPD of advocaten-DMS koppeling) kan het 10-12 weken zijn. We werken in vaste sprints met wekelijkse demo-momenten.' },
  { question: 'Krijg ik training om zelf updates te doen?', answer: 'Ja. Bij oplevering 2u Loom-video training over: CMS-bewerking (paginas/blogs aanpassen), Emma script-aanpassingen, Emma FAQ-uitbreiden, dashboard-rapporten lezen. Daarna 1u/maand telefonische support voor vragen over zelfbeheer. Wij doen de technische updates, u doet de content-updates.' },
  { question: 'Is dit AVG- en NEN 7510-compliant?', answer: 'Ja. Standaard AVG/UAVG-conform: cookie-banner, DPA-template, EU-only hosting (Frankfurt/Amsterdam), encryptie at-rest en in-transit. Voor zorg/juridische klanten leveren we NEN 7510-compatibele opzet (DPIA-template, pseudonimiseringsbeleid, audit-logs). Aanloop AI is een Nederlandse B.V. (KvK 88606902).' },
  { question: 'Kan ik later upgraden naar Pro?', answer: 'Ja. Bundel Groei → Bundel Pro upgrade (vanaf €11.500 setup + €797/mnd) voegt toe: Pro website-features (headless CMS, custom componenten, ERP-integratie), Emma AI-receptie zonder gespreks-cap (onbeperkt bellen), Emma WhatsApp Agent uitgebreid naar meer kanalen (Instagram DM + Facebook Messenger + Telegram), dedicated DevOps SLA. Geen nieuwe setup-fee voor reeds gebouwde delen.' },
  { question: 'Wat als ik alleen een webshop nodig heb (geen content-website)?', answer: 'Dan is de webshop-bouw service (vanaf €4.950 setup) plus losse Emma WhatsApp (€197/mnd) een betere fit. De AI-Website Bundel is bedoeld voor content-websites met telefoon-intake en chat-support. Voor pure webshop-scenarios met cart-recovery is een aparte bundel logischer — vraag tijdens discovery.' },
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': 'https://aanloopai.nl/diensten/ai-website-bundel-mkb-nederland/#service',
  name: 'AI-Website Bundel MKB Nederland — Website + Emma all-in-one',
  serviceType: 'Integrated Web Development & AI Service Bundle',
  description: 'Combo-pakket: AI-ready website (Groei) + Emma AI-receptie + Emma WhatsApp Agent + integraties. Eén factuur, één SLA, €5.950 setup + €649/maand all-in.',
  url: 'https://aanloopai.nl/diensten/ai-website-bundel-mkb-nederland/',
  provider: { '@type': 'Organization', '@id': 'https://aanloopai.nl/#organization', name: 'Aanloop AI', url: 'https://aanloopai.nl' },
  areaServed: { '@type': 'Country', name: 'Nederland' },
  audience: { '@type': 'BusinessAudience', audienceType: 'MKB Nederland' },
  offers: {
    '@type': 'Offer',
    name: 'AI-Website Bundel',
    priceCurrency: 'EUR',
    price: '5950',
    description: '€5.950 eenmalige setup + €649/maand all-in onderhoud + AI-licentie',
    availability: 'https://schema.org/InStock',
    seller: { '@type': 'Organization', name: 'Aanloop AI', url: 'https://aanloopai.nl' },
  },
};

const speakableSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage', name: 'AI-Website Bundel MKB Nederland — Website + Emma',
  speakable: { '@type': 'SpeakableSpecification', cssSelector: ['h1', '.hero-gradient .max-w-3xl > p'] },
  url: 'https://aanloopai.nl/diensten/ai-website-bundel-mkb-nederland/',
  inLanguage: 'nl-NL',
};
---

<BaseLayout
  title="AI-Website Bundel MKB Nederland — Website + Emma"
  description="AI-Website Bundel: AI-ready website + Emma AI-receptionist + Emma WhatsApp-agent in één pakket. €5.950 setup + €649 per maand all-in. Eén factuur, één SLA."
  schema={[serviceSchema, speakableSchema]}
  faqSchema={faqItems}
>
  <section class="border-b border-slate-200 hero-gradient">
    <div class="container-page py-16 lg:py-24">
      <div class="max-w-3xl">
        <div class="flex items-center gap-3 mb-6 reveal">
          <div class="accent-band"><span></span><span></span><span></span><span></span></div>
          <span class="eyebrow">Diensten · Combo-bundel</span>
        </div>
        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-brand-emerald/15 text-brand-emerald mb-4">Meest waardevol</span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tightest text-navy text-balance leading-[1.05] reveal reveal-delay-1">
          AI-Website Bundel - Website + Emma in één pakket, één factuur.
        </h1>
        <p class="mt-6 text-lg lg:text-xl text-slate-600 leading-relaxed text-pretty reveal reveal-delay-2">
          De meeste MKB-eigenaren tekenen 3 contracten: een webbureau voor de site, een AI-leverancier voor de telefoon, een chat-tool voor WhatsApp. 3 facturen, 3 aanspreekpunten, 3 SLA's. Wij leveren alles als één integraal systeem: AI-ready website met Emma AI-receptie en Emma WhatsApp Agent direct ingebouwd. Eén partner, één SLA, structureel voordeliger op jaarbasis.
        </p>
        <div class="mt-8 flex gap-3 flex-wrap reveal reveal-delay-3">
          <a href="/demo-aanvragen/" class="btn-primary text-base px-6 py-3.5">Gratis discovery-gesprek <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></a>
          <a href="#kosten" class="btn-outline text-base px-6 py-3.5">Bekijk kosten-overzicht</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-tight bg-slate-50 border-b border-slate-200">
    <div class="container-page">
      <p class="text-xs text-slate-400 text-center mb-4">Indicatieve cijfers · resultaten verschillen per situatie</p>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        {[{v:euro(bundelPrijs.setup),l:'eenmalige setup'},{v:euro(bundelPrijs.mnd),l:'per maand all-in'},{v:euro(setupVoordeel),l:'lager bij de start'},{v:'6-8 wk',l:'live na briefing'}].map(s=>(
          <div class="reveal"><p class="text-2xl font-bold text-navy">{s.v}</p><p class="text-xs text-slate-500 mt-1">{s.l}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page">
      <div class="max-w-3xl mb-12 reveal">
        <p class="eyebrow mb-3">Wat zit erin</p>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tightest text-navy text-balance">3 producten + integraties + tooling = 1 bundel.</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {inhoud.map(g => (
          <div class="card">
            <h3 class="text-base font-bold text-navy mb-4">{g.categorie}</h3>
            <ul class="space-y-2.5">
              {g.items.map(i => (
                <li class="flex items-start gap-2 text-sm text-slate-700">
                  <svg class="w-4 h-4 mt-0.5 flex-shrink-0 text-brand-emerald" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                  {i}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="kosten" class="section bg-slate-50/60 border-y border-slate-200">
    <div class="container-page">
      <div class="max-w-3xl mb-12 reveal">
        <p class="eyebrow mb-3">Kosten-vergelijking</p>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tightest text-navy text-balance">Wat u los betaalt, en wat de bundel ermee doet.</h2>
        <p class="mt-4 text-slate-600 leading-relaxed">Post voor post, tegen onze eigen listprijzen. Geen opgetelde jaartotalen — wie los inkoopt, koopt niet alles op dezelfde dag. Het verschil is wat het scheelt om alles bij één partij te doen, niet meer dan dat.</p>
      </div>

      <div class="card overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b-2 border-slate-200">
              <th class="text-left font-bold text-navy pb-3">Post</th>
              <th class="text-right font-bold text-slate-600 pb-3 whitespace-nowrap px-4">Los afgenomen</th>
              <th class="text-right font-bold text-brand-emerald pb-3 whitespace-nowrap">In de bundel</th>
            </tr>
          </thead>
          <tbody>
            <tr><td colspan="3" class="pt-4 pb-1 text-xs font-semibold uppercase tracking-wide text-slate-400">Eenmalig</td></tr>
            {setupPosten.map(p => (
              <tr class="border-b border-slate-100">
                <td class="py-2.5 pr-4">
                  <span class="font-medium text-slate-700">{p.item}</span>
                  <p class="mt-0.5 text-xs text-slate-500 leading-snug">{p.toelichting}</p>
                </td>
                <td class="py-2.5 px-4 text-right font-medium text-slate-700 whitespace-nowrap align-top">{p.los}</td>
                <td class={`py-2.5 text-right font-medium whitespace-nowrap align-top ${p.bundel === 'Inbegrepen' ? 'text-brand-emerald' : 'text-slate-700'}`}>{p.bundel}</td>
              </tr>
            ))}
            <tr><td colspan="3" class="pt-5 pb-1 text-xs font-semibold uppercase tracking-wide text-slate-400">Per maand</td></tr>
            {maandPosten.map(p => (
              <tr class="border-b border-slate-100">
                <td class="py-2.5 pr-4">
                  <span class="font-medium text-slate-700">{p.item}</span>
                  <p class="mt-0.5 text-xs text-slate-500 leading-snug">{p.toelichting}</p>
                </td>
                <td class="py-2.5 px-4 text-right font-medium text-slate-700 whitespace-nowrap align-top">{p.los}</td>
                <td class={`py-2.5 text-right font-medium whitespace-nowrap align-top ${p.bundel === 'Inbegrepen' ? 'text-brand-emerald' : 'text-slate-700'}`}>{p.bundel}</td>
              </tr>
            ))}
          </tbody>
        </table>

        <div class="mt-6 grid sm:grid-cols-2 gap-4">
          <div class="p-4 rounded-lg bg-brand-emerald/10">
            <p class="text-sm font-bold text-brand-emerald">{euro(setupVoordeel)} lager bij de start</p>
            <p class="mt-1 text-xs text-slate-600 leading-relaxed">De Emma-setup ({euro(EMMA_SETUP)}) en het integratiewerk ({euro(INTEGRATIE_LOS)}) vervallen. De bouw van de website kost hetzelfde als los.</p>
          </div>
          <div class="p-4 rounded-lg bg-brand-emerald/10">
            <p class="text-sm font-bold text-brand-emerald">{euro(maandVoordeel)} per maand lager</p>
            <p class="mt-1 text-xs text-slate-600 leading-relaxed">{euro(bundelPrijs.mnd)} all-in in plaats van {euro(WEBSITE_ONDERHOUD_MND)} onderhoud + {euro(EMMA.monthly)} Emma bij twee losse contracten.</p>
          </div>
        </div>
      </div>

      <p class="mt-6 text-xs text-slate-500 max-w-3xl">De WhatsApp-agent staat bewust <strong>niet</strong> als aparte regel: die zit al in het Emma-abonnement van {euro(EMMA.monthly)}/mnd. Hem er los bij optellen zou het voordeel kunstmatig opblazen. Alle genoemde bedragen zijn onze eigen listprijzen — dezelfde die op <a href="/diensten/website-laten-maken-mkb-nederland-2026/" class="underline">de website-pagina</a> en <a href="/diensten/emma/" class="underline">de Emma-pagina</a> staan. Het integratiewerk is een vaste post voor het koppelen van website, telefonie en WhatsApp. Alle bedragen exclusief BTW.</p>
    </div>
  </section>

  <section class="section">
    <div class="container-page">
      <div class="max-w-3xl mb-12 reveal">
        <p class="eyebrow mb-3">Waarom uniek</p>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tightest text-navy text-balance">4 redenen waarom de bundel beter is dan losse afname.</h2>
      </div>
      <div class="grid md:grid-cols-2 gap-5">
        {waaromUniek.map((w, i) => (
          <div class="card">
            <div class="text-3xl font-bold text-brand-indigo mb-3">0{i + 1}</div>
            <h3 class="text-lg font-bold text-navy mb-2">{w.titel}</h3>
            <p class="text-sm text-slate-600 leading-relaxed">{w.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-slate-50/60 border-y border-slate-200">
    <div class="container-page">
      <div class="max-w-3xl mb-12 reveal">
        <p class="eyebrow mb-3">Voor wie</p>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tightest text-navy text-balance">Ideaal voor deze 5 profielen.</h2>
      </div>
      <ul class="grid md:grid-cols-2 gap-3 max-w-4xl">
        {idealVoor.map(p => (
          <li class="flex items-start gap-3 p-4 rounded-xl bg-white border border-slate-200">
            <svg class="w-5 h-5 mt-0.5 flex-shrink-0 text-brand-emerald" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            <span class="text-sm text-slate-700">{p}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container-page">
      <div class="max-w-3xl mb-12 reveal">
        <p class="eyebrow mb-3">Hoe werkt het</p>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tightest text-navy text-balance">3 fases, 6-8 weken tot live.</h2>
      </div>
      <ol class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {proces.map(p => (
          <li class="card">
            <div class="text-3xl font-bold text-brand-indigo mb-2">{p.stap}</div>
            <h3 class="text-lg font-bold text-navy mb-2">{p.titel}</h3>
            <p class="text-sm text-slate-600 leading-relaxed">{p.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section bg-slate-50/60 border-y border-slate-200">
    <div class="container-page max-w-4xl">
