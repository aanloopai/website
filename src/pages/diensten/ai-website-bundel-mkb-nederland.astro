---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MobileProof from '../../components/MobileProof.astro';
import { EMMA, GEO, WEBSITE_BUNDEL, GARANTIE_KORT } from '../../data/pricing';
import { KERNPUNTEN, RESULTATEN, RESULTATEN_PEILDATUM } from '../../data/resultaten';

// Bundel per 2026-10-16 (owner): "een website waar AI achter draait en die écht
// klanten oplevert". Website + Emma + AI-vindbaarheid + meetpaneel; €4.500
// eenmalig en €1.000/mnd, beide publiek. Elk bewijscijfer op deze pagina komt
// uit src/data/resultaten.ts (guard: test/resultaten.test.js).
const euro = (n: number) => `€${n.toLocaleString('nl-NL')}`;
const datum = (iso: string) => new Date(`${iso}T12:00:00Z`).toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' });

const bundelPrijs = { setup: WEBSITE_BUNDEL.setup, mnd: WEBSITE_BUNDEL.maand };
const losseMaandlast = EMMA.monthly + GEO.maand; // zonder website-onderhoud
const jaarVoordeel = (losseMaandlast - bundelPrijs.mnd) * 12;
const gemetenSites = RESULTATEN.filter((s) => s.cijfers.length);

const inhoud = [
  { categorie: 'Website die klanten oplevert', items: ['Tot 30 pagina\'s + CMS, Astro of Next.js, code in uw eigen GitHub', 'Eén rijk lead-formulier op elke pagina, ook in de header', 'Schema.org, Speakable, FAQ-schema, WCAG 2.2 AA, Core Web Vitals groen', 'Hosting, updates, back-ups en monitoring inbegrepen'] },
  { categorie: 'Emma — AI-receptie (telefoon + WhatsApp)', items: ['Neemt 24/7 op in vloeiend Nederlands, plant afspraken in uw agenda', 'WhatsApp Business inbegrepen, geen los abonnement', 'Elke lead direct naar uw CRM of inbox, met transcript', 'Menselijke overdracht bij complexe vragen'] },
  { categorie: 'AI-vindbaarheid (GEO Maandelijks inbegrepen)', items: ['llms.txt, AI-crawlertoegang, entiteiten en answer-first pagina\'s', 'Maandelijkse meting in ChatGPT, Claude, Perplexity en Gemini', 'Datasets en feitenpagina\'s die AI-assistenten letterlijk kunnen citeren', 'Bijsturing op wat wél geciteerd wordt'] },
  { categorie: 'Meetpaneel en leadmotor', items: ['Cookieloze beacon: bezoek via AI-assistenten, contactacties, formulieren', 'Dezelfde meting als op /resultaten/, voor uw eigen site', 'Lead-notificaties geteld in de afleverstatistiek — geen schattingen', 'Maandelijkse rapportage en prioriteit support binnen 4 uur op werkdagen'] },
];

const setupPosten = [
  { item: 'Website — bouw', toelichting: 'Tot 30 pagina\'s, CMS, formulier overal, schema', los: 'Op aanvraag', bundel: `${euro(bundelPrijs.setup)} eenmalig` },
  { item: 'Emma — setup', toelichting: 'Belscript, stem, nummer, agenda- en CRM-koppeling', los: 'Op aanvraag', bundel: 'Inbegrepen' },
  { item: 'GEO — setup', toelichting: 'llms.txt, schema, AI-crawlertoegang, nulmeting', los: 'Op aanvraag', bundel: 'Inbegrepen' },
  { item: 'Integratie website ↔ telefonie ↔ WhatsApp ↔ meting', toelichting: 'Bij losse leveranciers doet niemand dit voor u', los: 'Op aanvraag', bundel: 'Inbegrepen' },
];
const maandPosten = [
  { item: 'Website-onderhoud en hosting', toelichting: 'Updates, security, back-ups, monitoring', los: 'Op aanvraag', bundel: 'Inbegrepen' },
  { item: 'Emma Compleet', toelichting: 'Onbeperkt volume, telefoon + WhatsApp, workflows', los: `${euro(EMMA.monthly)}/mnd`, bundel: 'Inbegrepen' },
  { item: 'GEO Maandelijks', toelichting: 'Meting in vier AI-engines, content-bijsturing, rapportage', los: `${euro(GEO.maand)}/mnd`, bundel: 'Inbegrepen' },
  { item: 'Meetpaneel', toelichting: 'AI-bezoek, contactacties, formulieren, leads', los: 'Niet los verkrijgbaar', bundel: 'Inbegrepen' },
];

const waaromUniek = [
  { titel: 'Wij laten de cijfers zien vóór u tekent', body: `Zeven sites die wij bouwden staan met hun meting op /resultaten/: bezoek via ChatGPT, Perplexity en Gemini, contactratio tegenover Google, afgeleverde leads. Met methode en meetdatum, ook waar het cijfer klein is. Geen bureau in de GEO Agency Index doet dat.` },
  { titel: 'AI-bezoek neemt vaker contact op', body: `Op ${KERNPUNTEN[0].waarde} gemeten sites doet bezoek via AI-assistenten vaker een contactactie dan Google-bezoek; op keukeninbeeld.nl is de lead-ratio uit AI-bezoek ${KERNPUNTEN[1].waarde} hoger. Daarom bouwen we de site vanaf dag 1 voor AI-citatie, niet als retrofit.` },
  { titel: 'Eén partner, één factuur, één meting', body: 'Website, telefoon, WhatsApp, AI-vindbaarheid en de meting zijn één systeem. Als de chatbot hapert, verwijst niemand u naar "de webbouwer". En u ziet in hetzelfde paneel als wij wat elk kanaal doet.' },
  { titel: 'Een pakketprijs die klopt', body: `Emma Compleet (${euro(EMMA.monthly)}) en GEO Maandelijks (${euro(GEO.maand)}) kosten los al ${euro(losseMaandlast)} per maand, zonder website-onderhoud. De bundel is ${euro(bundelPrijs.mnd)} all-in: ${euro(jaarVoordeel)} per jaar lager dan die twee abonnementen, mét website, hosting en meetpaneel erbij. Geen opgeblazen kortingspercentages.` },
];

const idealVoor = [
  'MKB-bedrijven waarvan de website nu wel bezoek maar geen aanvragen oplevert',
  'Dienstverleners die in ChatGPT, Gemini en Perplexity genoemd willen worden als een klant om een aanbieder vraagt',
  'Bedrijven met een verouderde site die ontwerp, AI-laag en meting in één keer willen vernieuwen',
  'Praktijken (zorg, juridisch, accountancy) die telefoon-intake en AVG-conforme opzet nodig hebben',
  'Ondernemers die willen zien wat elk kanaal oplevert in plaats van een maandrapport met schattingen',
];

const proces = [
  { stap: '01', titel: 'Discovery en nulmeting (week 1)', body: 'Doelgroep, aanbod, bestaande systemen, telefoonvolume. We meten direct hoe vindbaar u nu bent in AI-assistenten en in Google, zodat we straks tegen een echte nulmeting kunnen afzetten.' },
  { stap: '02', titel: 'Bouw in drie parallelle sporen (week 2-6)', body: 'Website met formulier overal en schema; Emma getraind op uw scripts en kennisbank; GEO-basis (llms.txt, entiteiten, datasets, answer-first pagina\'s). Elke vrijdag een demo van 30 minuten.' },
  { stap: '03', titel: 'Live, meten, bijsturen (week 7 en verder)', body: 'Soft-launch, dan publiek. Vanaf dag 1 meet de beacon AI-bezoek, contactacties en formulieren; de AI-radar stelt elke week dezelfde vragen. Maandelijks sturen we content en techniek bij op wat gemeten wordt.' },
];

const faqItems = [
  { question: 'Wat zit er precies in de bundel?', answer: `Website (tot 30 pagina's, CMS, lead-formulier op elke pagina, schema, hosting en onderhoud) + Emma AI-receptionist (24/7 telefoon en WhatsApp, agenda- en CRM-koppeling) + AI-vindbaarheid (GEO Maandelijks: llms.txt, entiteiten, datasets, maandelijkse meting in ChatGPT, Claude, Perplexity en Gemini) + het meetpaneel (AI-bezoek, contactacties, formulieren, leads). Eén contract, één factuur, één aanspreekpunt.` },
  { question: 'Wat kost het en wat is daar bijzonder aan?', answer: `${euro(bundelPrijs.setup)} eenmalig en ${euro(bundelPrijs.mnd)} per maand, exclusief 21% btw. We publiceren beide bedragen; de meeste bureaus noemen alleen "op aanvraag". Los kosten Emma Compleet en GEO Maandelijks samen ${euro(losseMaandlast)} per maand zonder website; in de bundel vervallen de Emma-setup, de GEO-setup en het integratiewerk.` },
  { question: 'Garanderen jullie leads of vermeldingen in ChatGPT?', answer: 'Nee, en wie dat wel garandeert, moet u wantrouwen: geen enkel bureau bepaalt wat een AI-assistent antwoordt of hoeveel mensen bellen. Wat we wél garanderen is dat u elke maand ziet wat er gemeten is — dezelfde cijfers die wij op /resultaten/ over onze eigen sites publiceren — en dat we daarop bijsturen.' },
  { question: 'Hoe weet ik dat jullie cijfers kloppen?', answer: `Elk cijfer op /resultaten/ draagt de meetmethode, de periode en de meetdatum (momentopname ${datum(RESULTATEN_PEILDATUM)}; de tabel ververst elk uur uit onze meting). Eigen bedrijven staan er als eigen bedrijven, klanten met hun akkoord. We tellen contactacties en afgeleverde leads apart en tellen ze nooit bij elkaar op.` },
  { question: 'Zit WhatsApp bij Emma inbegrepen?', answer: 'Ja. De bundel gebruikt Emma Compleet: telefoon én WhatsApp in hetzelfde abonnement, onbeperkt volume. U betaalt nooit twee keer voor hetzelfde kanaal.' },
  { question: 'Kan ik mijn bestaande website houden en alleen Emma of GEO afnemen?', answer: 'Ja, beide zijn los verkrijgbaar (zie /diensten/emma/ en /ai-vindbaarheid/). De bundel is bedoeld voor wie een nieuwe of vernieuwde site wil waarin de AI-laag en de meting vanaf dag 1 zitten; retrofit op een bestaande site is meestal duurder en meet minder.' },
  { question: 'Wat als ik later wil opzeggen?', answer: 'U behoudt uw website-code (in uw eigen GitHub), uw domein en alle lead- en gespreksdata, die we naar u exporteren. Het maandabonnement stopt per maand na de eerste termijn; de eenmalige bouw is dan al van u.' },
  { question: 'Hoe lang duurt het tot we live zijn?', answer: 'Discovery en nulmeting in week 1, bouw in drie parallelle sporen in week 2 tot 6, soft-launch in week 7 en publiek in week 8. Bij complexe koppelingen (EPD, DMS, ERP) kan het 10 tot 12 weken zijn.' },
  { question: 'Is dit AVG-conform?', answer: 'Ja. Verwerkersovereenkomst bij elke samenwerking, cookieloze meting zonder persoonsgegevens, hosting op ISO 27001-gecertificeerde infrastructuur, openbaar sub-verwerkersregister. Aanloop AI heeft zelf geen SOC 2- of ISO-certificaat en zegt dat ook; zie /beveiliging/. Aanloop AI B.V., KvK 88606902.' },
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': 'https://aanloopai.nl/diensten/ai-website-bundel-mkb-nederland/#service',
  name: 'AI-Website Bundel — website die klanten oplevert, met Emma en AI-vindbaarheid',
  serviceType: 'Web Development, AI Receptionist and Generative Engine Optimization bundle',
  description: `Website + Emma AI-receptie + AI-vindbaarheid (GEO) + meetpaneel in één contract. ${euro(bundelPrijs.setup)} eenmalig, ${euro(bundelPrijs.mnd)} per maand, exclusief btw. Gemeten resultaten op aanloopai.nl/resultaten/.`,
  url: 'https://aanloopai.nl/diensten/ai-website-bundel-mkb-nederland/',
  provider: { '@type': 'Organization', '@id': 'https://aanloopai.nl/#organization', name: 'Aanloop AI', url: 'https://aanloopai.nl' },
  areaServed: { '@type': 'Country', name: 'Nederland' },
  audience: { '@type': 'BusinessAudience', audienceType: 'MKB Nederland' },
  offers: [
    { '@type': 'Offer', name: 'AI-Website Bundel — maandabonnement', priceCurrency: 'EUR', price: String(bundelPrijs.mnd), priceSpecification: { '@type': 'UnitPriceSpecification', price: bundelPrijs.mnd, priceCurrency: 'EUR', billingIncrement: 1, unitCode: 'MON', valueAddedTaxIncluded: false }, availability: 'https://schema.org/InStock', seller: { '@id': 'https://aanloopai.nl/#organization' } },
    { '@type': 'Offer', name: 'AI-Website Bundel — eenmalige bouw', priceCurrency: 'EUR', price: String(bundelPrijs.setup), priceSpecification: { '@type': 'PriceSpecification', price: bundelPrijs.setup, priceCurrency: 'EUR', valueAddedTaxIncluded: false }, availability: 'https://schema.org/InStock', seller: { '@id': 'https://aanloopai.nl/#organization' } },
  ],
};

const speakableSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage', name: 'AI-Website Bundel — website die klanten oplevert',
  speakable: { '@type': 'SpeakableSpecification', cssSelector: ['h1', '.hero-gradient .max-w-3xl > p'] },
  url: 'https://aanloopai.nl/diensten/ai-website-bundel-mkb-nederland/',
  inLanguage: 'nl-NL',
};
---

<BaseLayout
  title="AI-Website Bundel: website die klanten oplevert"
  description={`Website + Emma AI-receptionist + AI-vindbaarheid in ChatGPT en Gemini + meetpaneel. ${euro(bundelPrijs.setup)} eenmalig, ${euro(bundelPrijs.mnd)} per maand. Gemeten resultaten.`}
  schema={[serviceSchema, speakableSchema]}
  faqSchema={faqItems}
>
  <section class="border-b border-slate-200 hero-gradient">
    <div class="container-page py-16 lg:py-24">
      <div class="max-w-3xl">
        <div class="flex items-center gap-3 mb-6 reveal">
          <div class="accent-band"><span></span><span></span><span></span><span></span></div>
          <span class="eyebrow">Diensten · AI-Website Bundel</span>
        </div>
        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-brand-emerald/15 text-brand-emerald mb-4">Meest gekozen</span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-semibold tracking-tighter text-navy text-balance leading-[1.05] reveal reveal-delay-1">
          Een website waar AI achter draait — en die écht klanten oplevert.
        </h1>
        <p class="mt-6 text-lg lg:text-xl text-slate-600 leading-relaxed text-pretty reveal reveal-delay-2">
          Website, Emma als AI-receptionist voor telefoon en WhatsApp, AI-vindbaarheid zodat ChatGPT, Gemini en Perplexity u noemen, en een meetpaneel dat laat zien wat elk kanaal oplevert. Eén partner, één contract: {euro(bundelPrijs.setup)} eenmalig en {euro(bundelPrijs.mnd)} per maand. Wat dat op onze eigen sites doet, staat gemeten op /resultaten/.
        </p>
        <div class="mt-8 flex gap-3 flex-wrap reveal reveal-delay-3">
          <a href="/demo-aanvragen/" class="btn-primary text-base px-6 py-3.5">Plan een gesprek <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></a>
          <a href="/resultaten/" class="btn-outline text-base px-6 py-3.5">Bekijk de gemeten resultaten</a>
        </div>
        <div class="mt-6"><MobileProof visual /></div>
      </div>
    </div>
  </section>

  <section class="section-tight bg-slate-50 border-b border-slate-200">
    <div class="container-page">
      <p class="text-xs text-slate-500 text-center mb-4">Gemeten op sites die wij bouwden · momentopname {datum(RESULTATEN_PEILDATUM)} · methode per cijfer op <a href="/resultaten/" class="underline">/resultaten/</a></p>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        {KERNPUNTEN.map((k) => (
          <div class="reveal"><p class="text-2xl lg:text-3xl font-bold text-navy">{k.waarde}</p><p class="text-xs text-slate-600 mt-1 leading-snug">{k.label}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page">
      <div class="max-w-3xl mb-12 reveal">
        <p class="eyebrow mb-3">Wat zit erin</p>
        <h2 class="text-3xl sm:text-4xl font-semibold tracking-tighter text-navy text-balance">Vier onderdelen, één systeem.</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {inhoud.map(g => (
          <div class="card">
            <h3 class="text-base font-bold text-navy mb-4">{g.categorie}</h3>
            <ul class="space-y-2.5">
              {g.items.map(i => (
                <li class="flex items-start gap-2 text-sm text-slate-700">
                  <svg class="w-4 h-4 mt-0.5 flex-shrink-0 text-brand-emerald" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                  {i}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-slate-50/60 border-y border-slate-200">
    <div class="container-page">
      <div class="max-w-3xl mb-10 reveal">
        <p class="eyebrow mb-3">Bewijs</p>
        <h2 class="text-3xl sm:text-4xl font-semibold tracking-tighter text-navy text-balance">Sites die wij zo bouwden, en wat ze meten.</h2>
        <p class="mt-4 text-slate-600 leading-relaxed">Eigen bedrijven heten eigen bedrijven; klanten staan er met hun akkoord. Per site het eerste cijfer uit de meting; alle cijfers, met methode, op /resultaten/.</p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
        {gemetenSites.map((s) => (
          <a href={`/werk/${s.key}/`} class="card hover:border-brand-indigo transition-colors">
            <p class="text-xs text-slate-500">{s.eigenaar === 'eigen' ? 'Eigen bedrijf' : 'Klant'} · {s.sector}</p>
            <h3 class="mt-1 text-lg font-bold text-navy">{s.naam}</h3>
            <p class="mt-3 text-2xl font-semibold tracking-tight text-navy">{s.cijfers[0].waarde}</p>
            <p class="text-sm text-slate-600 leading-snug">{s.cijfers[0].label}</p>
            <p class="mt-2 text-[11px] text-slate-400">{s.cijfers[0].methode} · {s.cijfers[0].periode}</p>
          </a>
        ))}
      </div>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="/resultaten/" class="btn-primary text-sm">Alle live cijfers</a>
        <a href="/werk/" class="btn-outline text-sm">Alle sites</a>
      </div>
    </div>
  </section>

  <section id="kosten" class="section">
    <div class="container-page">
      <div class="max-w-3xl mb-12 reveal">
        <p class="eyebrow mb-3">Kosten</p>
        <h2 class="text-3xl sm:text-4xl font-semibold tracking-tighter text-navy text-balance">{euro(bundelPrijs.setup)} eenmalig, {euro(bundelPrijs.mnd)} per maand. Post voor post.</h2>
        <p class="mt-4 text-slate-600 leading-relaxed">Tegen onze eigen listprijzen, exclusief 21% btw. Geen opgetelde jaartotalen — wie los inkoopt, koopt niet alles op dezelfde dag. Het verschil is wat het scheelt om alles bij één partij te doen.</p>
      </div>

      <div class="card overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b-2 border-slate-200">
              <th class="text-left font-bold text-navy pb-3">Post</th>
              <th class="text-right font-bold text-slate-600 pb-3 whitespace-nowrap px-4">Los afgenomen</th>
              <th class="text-right font-bold text-brand-emerald pb-3 whitespace-nowrap">In de bundel</th>
            </tr>
          </thead>
          <tbody>
            <tr><td colspan="3" class="pt-4 pb-1 text-xs font-semibold uppercase tracking-wide text-slate-400">Eenmalig</td></tr>
            {setupPosten.map(p => (
              <tr class="border-b border-slate-100">
                <td class="py-2.5 pr-4"><span class="font-medium text-slate-700">{p.item}</span><p class="mt-0.5 text-xs text-slate-500 leading-snug">{p.toelichting}</p></td>
                <td class="py-2.5 px-4 text-right font-medium text-slate-700 whitespace-nowrap align-top">{p.los}</td>
                <td class={`py-2.5 text-right font-medium whitespace-nowrap align-top ${p.bundel === 'Inbegrepen' ? 'text-brand-emerald' : 'text-navy'}`}>{p.bundel}</td>
              </tr>
            ))}
            <tr><td colspan="3" class="pt-5 pb-1 text-xs font-semibold uppercase tracking-wide text-slate-400">Per maand</td></tr>
            {maandPosten.map(p => (
              <tr class="border-b border-slate-100">
                <td class="py-2.5 pr-4"><span class="font-medium text-slate-700">{p.item}</span><p class="mt-0.5 text-xs text-slate-500 leading-snug">{p.toelichting}</p></td>
                <td class="py-2.5 px-4 text-right font-medium text-slate-700 whitespace-nowrap align-top">{p.los}</td>
                <td class={`py-2.5 text-right font-medium whitespace-nowrap align-top ${p.bundel === 'Inbegrepen' ? 'text-brand-emerald' : 'text-navy'}`}>{p.bundel}</td>
              </tr>
            ))}
            <tr class="border-t-2 border-slate-200">
              <td class="py-3 pr-4 font-bold text-navy">Totaal per maand</td>
              <td class="py-3 px-4 text-right font-medium text-slate-700 whitespace-nowrap">{euro(losseMaandlast)} + onderhoud</td>
              <td class="py-3 text-right font-bold text-navy whitespace-nowrap">{euro(bundelPrijs.mnd)} all-in</td>
            </tr>
          </tbody>
        </table>

        <div class="mt-6 grid sm:grid-cols-2 gap-4">
          <div class="p-4 rounded-lg bg-brand-emerald/10">
            <p class="text-sm font-bold text-brand-emerald">Eén eenmalig bedrag, publiek</p>
            <p class="mt-1 text-xs text-slate-600 leading-relaxed">{euro(bundelPrijs.setup)} voor bouw, Emma-setup, GEO-setup en integratie samen. Geen "op aanvraag", geen verrassing in het gesprek.</p>
          </div>
          <div class="p-4 rounded-lg bg-brand-emerald/10">
            <p class="text-sm font-bold text-brand-emerald">{euro(jaarVoordeel)} per jaar lager</p>
            <p class="mt-1 text-xs text-slate-600 leading-relaxed">{euro(bundelPrijs.mnd)} all-in tegenover {euro(losseMaandlast)} voor Emma Compleet + GEO Maandelijks los — en dan zit het website-onderhoud er nog niet eens bij.</p>
          </div>
        </div>
        <p class="mt-4 text-xs text-slate-500 leading-relaxed">Op het Emma-abonnementsdeel: {GARANTIE_KORT} (eenmalige bouw uitgezonderd). Alle bedragen exclusief btw.</p>
      </div>
    </div>
  </section>

  <section class="section bg-slate-50/60 border-y border-slate-200">
    <div class="container-page">
      <div class="max-w-3xl mb-12 reveal">
        <p class="eyebrow mb-3">Waarom deze bundel</p>
        <h2 class="text-3xl sm:text-4xl font-semibold tracking-tighter text-navy text-balance">Vier redenen, allemaal controleerbaar.</h2>
      </div>
      <div class="grid md:grid-cols-2 gap-5">
        {waaromUniek.map((w, i) => (
          <div class="card">
            <div class="text-3xl font-bold text-brand-indigo mb-3">0{i + 1}</div>
            <h3 class="text-lg font-bold text-navy mb-2">{w.titel}</h3>
            <p class="text-sm text-slate-600 leading-relaxed">{w.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page">
      <div class="max-w-3xl mb-12 reveal">
        <p class="eyebrow mb-3">Voor wie</p>
        <h2 class="text-3xl sm:text-4xl font-semibold tracking-tighter text-navy text-balance">Past bij deze vijf situaties.</h2>
      </div>
      <ul class="grid md:grid-cols-2 gap-3 max-w-4xl">
        {idealVoor.map(p => (
