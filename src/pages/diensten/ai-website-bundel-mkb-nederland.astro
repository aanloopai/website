---
import BaseLayout from '../../layouts/BaseLayout.astro';

const inhoud = [
  { categorie: 'Website (Groei pakket)', items: ['Tot 30 paginas + CMS', 'Schema.org + Speakable + WCAG 2.2 AA', 'Astro/Next.js framework, GitHub bij u', 'Multilingual NL/EN/DE', 'Cloudflare Pages hosting'] },
  { categorie: 'Marco AI-receptie', items: ['24/7 NL-telefoonbeantwoording', 'Agenda-koppeling Google/Outlook', 'Lead-samenvattingen via e-mail/WhatsApp', 'CRM-integratie (HubSpot/Pipedrive/etc)', 'Live transcripts in dashboard'] },
  { categorie: 'Emma WhatsApp Agent', items: ['Klantvragen 24/7 in seconden', 'Getraind op uw kennisbank', 'Menselijke handover bij complex', 'WhatsApp Business API', 'Lead-capture naar CRM'] },
  { categorie: 'Operational tooling', items: ['ROI-calc widget op uw site', 'AI-scan formulier (lead-magnet)', 'GA4 + GrowthBook A/B-test setup', 'Maandelijkse performance-rapport', 'Prioriteit support binnen 4u werkdag'] },
];

const losseFacturen = [
  { item: 'Website Groei pakket setup', prijs: '€5.950' },
  { item: 'Website onderhoud (12 mnd × €197)', prijs: '€2.364' },
  { item: 'Marco Starter (12 mnd × €597)', prijs: '€7.164' },
  { item: 'Emma Starter (12 mnd × €197)', prijs: '€2.364' },
  { item: 'Setup-koppeling website ↔ Marco/Emma', prijs: '€1.500' },
];
const totaalLos = 5950 + 2364 + 7164 + 2364 + 1500;

const bundelPrijs = { setup: 4950, mnd: 397 };
const bundelJaar1 = bundelPrijs.setup + (bundelPrijs.mnd * 12);
const besparing = totaalLos - bundelJaar1;

const waaromUniek = [
  { titel: 'Eén partner, één factuur, één SLA', body: 'Geen "verwijst u naar de webdeveloper" als de chatbot bug heeft. Wij leveren website + AI als één geïntegreerd systeem en zijn aanspreekpunt voor alles.' },
  { titel: 'Architectuur is vanaf dag 1 AI-ready', body: 'Webbureaus bouwen meestal eerst de site, AI komt achteraf. Bij ons zijn de plug-in-slots, schema.org-markup en data-flows al ingebouwd op launch-dag — geen €5-15k retrofit-kosten.' },
  { titel: 'Korting tov losse afname (€8-15k op jaar 1)', body: `Losse afname kost ~€${totaalLos.toLocaleString('nl-NL')}. Bundel jaar 1 = €${bundelJaar1.toLocaleString('nl-NL')}. Besparing: €${besparing.toLocaleString('nl-NL')}.` },
  { titel: 'Time-to-revenue 6-8 weken ipv 12-20', body: 'Parallel design + AI-training in één traject. Concurrent-route (eerst webdev klaar, dan AI-agency briefen) duurt 3-5 maanden langer. U bent 2-4 maanden eerder live met €30-60k extra omzet.' },
];

const idealVoor = [
  'ZZP/MKB die in 1 keer professioneel online wil komen met AI-eerstelijns-support',
  'Bestaande bedrijven met een verouderde site die zowel design als AI-laag willen vernieuwen',
  'Praktijken (zorg/juridisch/accountancy) die NEN 7510-conform website + AI-receptie nodig hebben',
  'Webshop-eigenaren die ook een content-website willen met cart-recovery via WhatsApp',
  'Multi-locatie ondernemers die 24/7 telefoon + chat over alle vestigingen willen centraliseren',
];

const proces = [
  { stap: '01', titel: 'Discovery (1 sessie, 90 min)', body: 'Business-model, doelgroep, bestaande systemen, telefoon-volume, FAQs, agenda-tools. We mappen direct in welke systemen Marco/Emma moeten koppelen en welke website-architectuur er omheen past.' },
  { stap: '02', titel: 'Bouw (week 2-6)', body: 'Parallel-tracks: (a) website-build met AI-ready plug-in slots, (b) Marco-training met uw scripts/escalatie, (c) Emma-training met uw kennisbank. U keurt elke vrijdag voortgang goed in 30-min demo.' },
  { stap: '03', titel: 'Launch + 30-dagen optimalisatie', body: 'Soft-launch week 7 (uw team test). Public-launch week 8. Daarna 30 dagen wekelijkse fine-tuning op basis van echte gespreks-/conversie-data. Bij maand 2 staat alles op auto-pilot.' },
];

const faqItems = [
  { question: 'Wat zit er precies in de bundel?', answer: 'Website (Groei pakket: tot 30 paginas, CMS, multilingual NL/EN/DE) + Marco AI-receptionist (24/7 NL-telefoon, agenda, CRM-koppeling) + Emma WhatsApp Agent (24/7 chat, lead-capture) + alle koppelingen tussen de 3 systemen + ROI-calc/AI-scan widgets op uw site + GA4/GrowthBook setup + maandelijks onderhoud op alles. Eén factuur, één contract, één aanspreekpunt.' },
  { question: 'Hoeveel bespaar ik tegenover losse afname?', answer: `Losse afname jaar 1 (website setup €5.950 + onderhoud €2.364 + Marco €7.164 + Emma €2.364 + integratie €1.500) = €${totaalLos.toLocaleString('nl-NL')}. Bundel jaar 1 (€${bundelPrijs.setup.toLocaleString('nl-NL')} setup + 12 × €${bundelPrijs.mnd}) = €${bundelJaar1.toLocaleString('nl-NL')}. Besparing: €${besparing.toLocaleString('nl-NL')} in jaar 1, structureel ~€2.400/jaar daarna.` },
  { question: 'Kan ik bestaande website behouden en alleen Marco/Emma toevoegen?', answer: 'Ja, dat kan via losse Marco + Emma abonnementen (zie /diensten/marco/ en /diensten/emma/). De bundel is voordeliger als u sowieso een nieuwe of vernieuwde site wilt. Als uw huidige site jonger dan 2 jaar is en al schema.org markup heeft, adviseren we losse AI-modules ipv bundel.' },
  { question: 'Wat als ik later wil opzeggen?', answer: 'Maandelijks onderhoud is opzegbaar per maand met 1 maand opzegtermijn. De setup-fee is eenmalig. Bij opzegging behoudt u: uw website-code (in eigen GitHub), uw domeinnaam, alle CRM-data van Marco/Emma. Marco/Emma stoppen we met doorschakelen, maar de transcripts/lead-data exporteren we naar u toe.' },
  { question: 'Hoe lang duurt het tot we live zijn?', answer: 'Discovery week 1, design + AI-training parallel weken 2-6, soft-launch week 7, public-launch week 8. Bij complexe integraties (zoals zorg-EPD of advocaten-DMS koppeling) kan het 10-12 weken zijn. We werken in vaste sprints met wekelijkse demo-momenten.' },
  { question: 'Krijg ik training om zelf updates te doen?', answer: 'Ja. Bij oplevering 2u Loom-video training over: CMS-bewerking (paginas/blogs aanpassen), Marco script-aanpassingen, Emma FAQ-uitbreiden, dashboard-rapporten lezen. Daarna 1u/maand telefonische support voor vragen over zelfbeheer. Wij doen de technische updates, u doet de content-updates.' },
  { question: 'Is dit AVG- en NEN 7510-compliant?', answer: 'Ja. Standaard AVG/UAVG-conform: cookie-banner, DPA-template, EU-only hosting (Frankfurt/Amsterdam), encryptie at-rest en in-transit. Voor zorg/juridische klanten leveren we NEN 7510-compatibele opzet (DPIA-template, pseudonimiseringsbeleid, audit-logs). Aanloop AI is een Nederlandse B.V. (KvK 88606902).' },
  { question: 'Kan ik later upgraden naar Pro?', answer: 'Ja. Bundel Groei → Bundel Pro upgrade (vanaf €11.500 setup + €797/mnd) voegt toe: Pro website-features (headless CMS, custom componenten, ERP-integratie), Marco Onbeperkt (geen gespreks-cap), Emma Multi-channel (Instagram DM + Facebook Messenger + Telegram), dedicated DevOps SLA. Geen nieuwe setup-fee voor reeds gebouwde delen.' },
  { question: 'Wat als ik alleen een webshop nodig heb (geen content-website)?', answer: 'Dan is de webshop-bouw service (vanaf €4.950 setup) plus losse Emma WhatsApp (€197/mnd) een betere fit. De AI-Website Bundel is bedoeld voor content-websites met telefoon-intake en chat-support. Voor pure webshop-scenarios met cart-recovery is een aparte bundel logischer — vraag tijdens discovery.' },
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': 'https://aanloopai.nl/diensten/ai-website-bundel-mkb-nederland/#service',
  name: 'AI-Website Bundel MKB Nederland — Website + Marco + Emma all-in-one',
  serviceType: 'Integrated Web Development & AI Service Bundle',
  description: 'Combo-pakket: AI-ready website (Groei) + Marco AI-receptie + Emma WhatsApp Agent + integraties. Eén factuur, één SLA, €4.950 setup + €397/maand. Bespaart €8.000+ tov losse afname jaar 1.',
  url: 'https://aanloopai.nl/diensten/ai-website-bundel-mkb-nederland/',
  provider: { '@type': 'Organization', '@id': 'https://aanloopai.nl/#organization', name: 'Aanloop AI', url: 'https://aanloopai.nl' },
  areaServed: { '@type': 'Country', name: 'Nederland' },
  audience: { '@type': 'BusinessAudience', audienceType: 'MKB Nederland' },
  offers: {
    '@type': 'Offer',
    name: 'AI-Website Bundel',
    priceCurrency: 'EUR',
    price: '4950',
    description: '€4.950 eenmalige setup + €397/maand all-in onderhoud + AI-licentie',
    availability: 'https://schema.org/InStock',
    seller: { '@type': 'Organization', name: 'Aanloop AI', url: 'https://aanloopai.nl' },
  },
};

const speakableSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage', name: 'AI-Website Bundel MKB Nederland — Website + Marco + Emma',
  speakable: { '@type': 'SpeakableSpecification', cssSelector: ['h1', '.hero-gradient .max-w-3xl > p'] },
  url: 'https://aanloopai.nl/diensten/ai-website-bundel-mkb-nederland/',
  inLanguage: 'nl-NL',
};
---

<BaseLayout
  title="AI-Website Bundel MKB Nederland — Website + Marco + Emma"
  description="AI-Website Bundel MKB Nederland: AI-ready website + Marco AI-receptionist + Emma WhatsApp-agent in één pakket. 4.950 setup + 397 per maand. Eén factuur, één SLA."
  schema={[serviceSchema, speakableSchema]}
  faqSchema={faqItems}
>
  <section class="border-b border-slate-200 hero-gradient">
    <div class="container-page py-16 lg:py-24">
      <div class="max-w-3xl">
        <div class="flex items-center gap-3 mb-6 reveal">
          <div class="accent-band"><span></span><span></span><span></span><span></span></div>
          <span class="eyebrow">Diensten · Combo-bundel</span>
        </div>
        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-brand-emerald/15 text-brand-emerald mb-4">Meest waardevol</span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tightest text-navy text-balance leading-[1.05] reveal reveal-delay-1">
          AI-Website Bundel - Website + Marco + Emma in één pakket, één factuur.
        </h1>
        <p class="mt-6 text-lg lg:text-xl text-slate-600 leading-relaxed text-pretty reveal reveal-delay-2">
          De meeste MKB-eigenaren tekenen 3 contracten: een webbureau voor de site, een AI-leverancier voor de telefoon, een chat-tool voor WhatsApp. 3 facturen, 3 aanspreekpunten, 3 SLA's. Wij leveren alles als één integraal systeem: AI-ready website met Marco AI-receptie en Emma WhatsApp Agent direct ingebouwd. Eén partner, één SLA, structureel €8.000+ goedkoper in jaar 1.
        </p>
        <div class="mt-8 flex gap-3 flex-wrap reveal reveal-delay-3">
          <a href="/demo-aanvragen/" class="btn-primary text-base px-6 py-3.5">Gratis discovery-gesprek <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></a>
          <a href="#kosten" class="btn-outline text-base px-6 py-3.5">Bekijk kosten-overzicht</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-tight bg-slate-50 border-b border-slate-200">
    <div class="container-page">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        {[{v:'€4.950',l:'eenmalige setup'},{v:'€397',l:'per maand all-in'},{v:`€${besparing.toLocaleString('nl-NL')}`,l:'besparing jaar 1'},{v:'6-8 wk',l:'live na briefing'}].map(s=>(
          <div class="reveal"><p class="text-2xl font-bold text-navy">{s.v}</p><p class="text-xs text-slate-500 mt-1">{s.l}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page">
      <div class="max-w-3xl mb-12 reveal">
        <p class="eyebrow mb-3">Wat zit erin</p>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tightest text-navy text-balance">3 producten + integraties + tooling = 1 bundel.</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {inhoud.map(g => (
          <div class="card">
            <h3 class="text-base font-bold text-navy mb-4">{g.categorie}</h3>
            <ul class="space-y-2.5">
              {g.items.map(i => (
                <li class="flex items-start gap-2 text-sm text-slate-700">
                  <svg class="w-4 h-4 mt-0.5 flex-shrink-0 text-brand-emerald" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                  {i}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="kosten" class="section bg-slate-50/60 border-y border-slate-200">
    <div class="container-page">
      <div class="max-w-3xl mb-12 reveal">
        <p class="eyebrow mb-3">Kosten-vergelijking</p>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tightest text-navy text-balance">Bundel vs losse afname — jaar 1.</h2>
        <p class="mt-4 text-slate-600 leading-relaxed">Honest math. Wij tonen wat losse afname werkelijk zou kosten als u alles afzonderlijk inkoopt.</p>
      </div>
      <div class="grid lg:grid-cols-2 gap-6">
        <div class="card">
          <h3 class="text-base font-bold text-slate-600 mb-4">Losse afname (3 leveranciers)</h3>
          <ul class="space-y-2.5 mb-4">
            {losseFacturen.map(f => (
              <li class="flex items-center justify-between text-sm border-b border-slate-100 pb-2">
                <span class="text-slate-700">{f.item}</span>
                <span class="font-medium text-slate-700">{f.prijs}</span>
              </li>
            ))}
          </ul>
          <div class="flex items-center justify-between pt-2 border-t-2 border-slate-300">
            <span class="font-bold text-navy">Totaal jaar 1</span>
            <span class="text-xl font-bold text-slate-700">€{totaalLos.toLocaleString('nl-NL')}</span>
          </div>
        </div>
        <div class="card border-2 border-brand-emerald relative">
          <span class="absolute -top-3 left-5 px-2.5 py-0.5 bg-brand-emerald text-white text-[11px] font-medium tracking-wide uppercase rounded">Bundel</span>
          <h3 class="text-base font-bold text-navy mb-4">AI-Website Bundel (1 partner)</h3>
          <ul class="space-y-2.5 mb-4">
            <li class="flex items-center justify-between text-sm border-b border-slate-100 pb-2"><span class="text-slate-700">Eenmalige setup (alles inbegrepen)</span><span class="font-medium text-slate-700">€{bundelPrijs.setup.toLocaleString('nl-NL')}</span></li>
            <li class="flex items-center justify-between text-sm border-b border-slate-100 pb-2"><span class="text-slate-700">Maandelijks (12 × €{bundelPrijs.mnd})</span><span class="font-medium text-slate-700">€{(bundelPrijs.mnd * 12).toLocaleString('nl-NL')}</span></li>
            <li class="flex items-center justify-between text-sm border-b border-slate-100 pb-2"><span class="text-slate-700">Integratie-setup</span><span class="font-medium text-brand-emerald">Inbegrepen</span></li>
            <li class="flex items-center justify-between text-sm border-b border-slate-100 pb-2"><span class="text-slate-700">Onderhoud + monitoring</span><span class="font-medium text-brand-emerald">Inbegrepen</span></li>
            <li class="flex items-center justify-between text-sm border-b border-slate-100 pb-2"><span class="text-slate-700">SLA + 1 aanspreekpunt</span><span class="font-medium text-brand-emerald">Inbegrepen</span></li>
          </ul>
          <div class="flex items-center justify-between pt-2 border-t-2 border-brand-emerald">
            <span class="font-bold text-navy">Totaal jaar 1</span>
            <span class="text-xl font-bold text-brand-emerald">€{bundelJaar1.toLocaleString('nl-NL')}</span>
          </div>
          <div class="mt-4 p-3 rounded-lg bg-brand-emerald/10 text-center">
            <p class="text-sm font-bold text-brand-emerald">U bespaart €{besparing.toLocaleString('nl-NL')} in jaar 1</p>
          </div>
        </div>
      </div>
      <p class="mt-6 text-xs text-slate-500 max-w-3xl">Cijfers gebaseerd op listprijzen Aanloop AI per 2026-05-04. Losse setup-koppeling is geschatte gemiddelde marktprijs voor integratie-werk wanneer 3 verschillende leveranciers betrokken zijn. Exclusief BTW.</p>
    </div>
  </section>

  <section class="section">
    <div class="container-page">
      <div class="max-w-3xl mb-12 reveal">
        <p class="eyebrow mb-3">Waarom uniek</p>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tightest text-navy text-balance">4 redenen waarom de bundel beter is dan losse afname.</h2>
      </div>
      <div class="grid md:grid-cols-2 gap-5">
        {waaromUniek.map((w, i) => (
          <div class="card">
            <div class="text-3xl font-bold text-brand-indigo mb-3">0{i + 1}</div>
            <h3 class="text-lg font-bold text-navy mb-2">{w.titel}</h3>
            <p class="text-sm text-slate-600 leading-relaxed">{w.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-slate-50/60 border-y border-slate-200">
    <div class="container-page">
      <div class="max-w-3xl mb-12 reveal">
        <p class="eyebrow mb-3">Voor wie</p>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tightest text-navy text-balance">Ideaal voor deze 5 profielen.</h2>
      </div>
      <ul class="grid md:grid-cols-2 gap-3 max-w-4xl">
        {idealVoor.map(p => (
          <li class="flex items-start gap-3 p-4 rounded-xl bg-white border border-slate-200">
            <svg class="w-5 h-5 mt-0.5 flex-shrink-0 text-brand-emerald" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            <span class="text-sm text-slate-700">{p}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container-page">
      <div class="max-w-3xl mb-12 reveal">
        <p class="eyebrow mb-3">Hoe werkt het</p>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tightest text-navy text-balance">3 fases, 6-8 weken tot live.</h2>
      </div>
      <ol class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {proces.map(p => (
          <li class="card">
            <div class="text-3xl font-bold text-brand-indigo mb-2">{p.stap}</div>
            <h3 class="text-lg font-bold text-navy mb-2">{p.titel}</h3>
            <p class="text-sm text-slate-600 leading-relaxed">{p.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section bg-slate-50/60 border-y border-slate-200">
    <div class="container-page max-w-4xl">
      <div class="mb-10 reveal">
        <p class="eyebrow mb-3">Veelgestelde vragen</p>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tightest text-navy text-balance">Wat klanten vragen vóór ze tekenen.</h2>
      </div>
      <div class="space-y-3">
        {faqItems.map(f => (
          <details class="group card">
            <summary class="flex items-start justify-between gap-4 cursor-pointer list-none">
              <span class="font-semibold text-navy text-sm sm:text-base">{f.question}</span>
              <svg class="w-5 h-5 flex-shrink-0 text-slate-400 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <p class="mt-4 text-sm text-slate-600 leading-relaxed">{f.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page">
      <div class="bg-slate-50 border border-slate-200 rounded-xl p-6 max-w-3xl">
        <p class="text-sm font-bold text-navy mb-3">Gerelateerde diensten</p>
        <ul class="flex flex-wrap gap-3">
          <li><a href="/diensten/website-laten-maken-mkb-nederland-2026/" class="text-sm text-brand-indigo hover:underline">Alleen website (Groei) →</a></li>
          <li><a href="/diensten/webshop-laten-maken-shopify-woocommerce-nederland-2026/" class="text-sm text-brand-indigo hover:underline">Webshop laten maken →</a></li>
          <li><a href="/diensten/marco/" class="text-sm text-brand-indigo hover:underline">Alleen Marco →</a></li>
          <li><a href="/diensten/emma/" class="text-sm text-brand-indigo hover:underline">Alleen Emma →</a></li>
          <li><a href="/ai-roi-calculator/" class="text-sm text-brand-indigo hover:underline">Bereken uw ROI →</a></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section-tight bg-midnight text-pearl">
    <div class="container-page max-w-3xl">
      <h2 class="text-3xl font-bold text-pearl reveal">Klaar voor één partner voor uw hele digitale presentie?</h2>
      <p class="mt-4 text-slate-300 reveal reveal-delay-1">Gratis 90-min discovery-gesprek. We mappen uw site, telefoon en chat in één plan, en u krijgt een vaste-prijs offerte binnen 5 werkdagen.</p>
      <div class="mt-6 flex gap-3 reveal reveal-delay-2">
        <a href="/demo-aanvragen/" class="btn bg-pearl text-navy hover:bg-white text-base px-6 py-3.5">Gratis discovery-gesprek</a>
        <a href="/contact/" class="btn border border-slate-700 text-pearl hover:bg-slate-800 text-base px-6 py-3.5">Direct contact</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // GrowthBook A/B experiments — Phase 2
  import { initExperimentsOnConsent } from '../../lib/ab-experiments';
  initExperimentsOnConsent();
</script>
