---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import pageImage from '../../assets/images/pages/audit.jpg';
---

<BaseLayout
  title="AI Strategie & Implementatie Advies voor MKB Nederland | Aanloop AI"
  description="Grondige AI-audit van uw bedrijfsprocessen + concrete implementatie-roadmap met ROI-analyse en prioritering. Voor MKB-ondernemers die AI strategisch willen inzetten."
>
  <section class="border-b border-slate-200 hero-gradient">
    <div class="container-page py-16 lg:py-28">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div class="max-w-3xl">
        <div class="flex items-center gap-3 mb-6">
          <div class="accent-band"><span></span><span></span><span></span><span></span></div>
          <span class="eyebrow">AI strategie & audit</span>
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tightest text-navy text-balance leading-[1.05]">
          Weet waar AI het meeste oplevert.
        </h1>
        <p class="mt-6 text-lg text-slate-600 leading-relaxed max-w-2xl">
          Een grondige analyse van uw bedrijfsprocessen, gevolgd door een concrete implementatieroadmap met ROI-prioritering. U weet precies waar te beginnen en wat het oplevert.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row gap-3">
          <a href="/contact/?type=offerte" class="btn-primary text-base px-6 py-3.5">
            Audit aanvragen
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
        </div>
      </div>
      <div class="reveal reveal-delay-2">
        <Image src={pageImage} alt="Twee laptops met paperwork analyse — Aanloop AI audit voor Nederlandse MKB-bedrijven" class="w-full rounded-2xl shadow-xl object-cover aspect-[4/3]" loading="eager" decoding="async" fetchpriority="high" widths={[480, 800, 1200, 1400]} sizes="(min-width: 1024px) 600px, 100vw" format="webp" quality={82} />
      </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page">
      <div class="grid lg:grid-cols-2 gap-16">
        <div class="reveal">
          <p class="eyebrow mb-3">Wat u krijgt</p>
          <h2 class="text-3xl font-bold tracking-tightest text-navy mb-6">Inhoud van de audit.</h2>
          <ul class="space-y-4">
            {[
              'Procesanalyse: welke taken kosten het meest tijd?',
              'AI-geschiktheidsscan per proces',
              'ROI-berekening per automatiseringskans',
              'Prioriteringsmatrix: impact vs. implementatiekosten',
              'Concrete aanbevelingen met tijdlijn',
              'Tech-stack advies: welke tools passen bij u',
              'Presentatie aan uw management-team',
            ].map(item => (
              <li class="flex items-start gap-3 text-sm text-slate-700">
                <svg class="w-5 h-5 mt-0.5 flex-shrink-0 text-brand-emerald" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
        <div class="reveal reveal-delay-2">
          <p class="eyebrow mb-3">Investering</p>
          <h2 class="text-3xl font-bold tracking-tightest text-navy mb-6">Transparante prijzen.</h2>
          <div class="space-y-4">
            {[
              { name: 'Quick scan', price: 'Gratis', desc: '45 min gesprek + globale kansen-analyse. Ideaal voor oriëntatie.' },
              { name: 'Basis audit', price: '€1.950', desc: 'Volledige procesanalyse + prioriteringsmatrix + roadmap. 2 weken doorlooptijd.' },
              { name: 'Strategie-traject', price: 'Op maat', desc: 'Meerdaagse deep-dive met managementpresentatie en implementatieondersteuning.' },
            ].map(p => (
              <div class="card">
                <div class="flex justify-between items-start mb-2">
                  <h3 class="font-bold text-navy">{p.name}</h3>
                  <span class="font-bold text-brand-indigo">{p.price}</span>
                </div>
                <p class="text-sm text-slate-600">{p.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-tight bg-midnight text-pearl">
    <div class="container-page">
      <div class="max-w-2xl">
        <h2 class="text-3xl font-bold tracking-tightest text-pearl">Begin met een gratis quick scan.</h2>
        <p class="mt-4 text-slate-300">45 minuten, geen kosten, geen verplichtingen. U vertrekt met concrete inzichten.</p>
        <div class="mt-6">
          <a href="/contact/?type=offerte" class="btn bg-pearl text-navy hover:bg-white text-base px-6 py-3.5">Quick scan aanvragen</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
