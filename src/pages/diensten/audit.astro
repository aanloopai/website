---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import pageImage from '../../assets/images/pages/audit.jpg';

const auditSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': 'https://aanloopai.nl/diensten/audit/#service',
    name: 'AI Audit voor MKB Nederland',
    serviceType: 'AI strategie + implementatie-roadmap',
    description: 'Grondige analyse van bedrijfsprocessen, ROI-prioritering per AI-kans en concrete 90-dagen implementatieroadmap. Vaste prijs €1.950, oplevering binnen 14 werkdagen.',
    provider: { '@type': 'Organization', '@id': 'https://aanloopai.nl/#organization' },
    areaServed: { '@type': 'Country', name: 'Nederland' },
    audience: { '@type': 'BusinessAudience', audienceType: 'MKB Nederland (10-200 medewerkers)' },
    offers: {
      '@type': 'Offer',
      '@id': 'https://aanloopai.nl/diensten/audit/#offer',
      name: 'AI Audit — vaste prijs',
      price: '1950',
      priceCurrency: 'EUR',
      availability: 'https://schema.org/InStock',
      validFrom: '2026-05-03',
      url: 'https://aanloopai.nl/diensten/audit/',
      itemOffered: { '@id': 'https://aanloopai.nl/diensten/audit/#service' },
      eligibleDuration: { '@type': 'QuantitativeValue', value: 14, unitCode: 'DAY', description: 'Oplevering binnen 14 werkdagen' },
    },
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Audit-pakketten',
      itemListElement: [
        { '@type': 'Offer', name: 'Quick scan', price: '0', priceCurrency: 'EUR', description: '45-min adviesgesprek met kansen-mapping. Gratis.' },
        { '@type': 'Offer', name: 'Basis AI Audit', price: '1950', priceCurrency: 'EUR', description: 'Volledige procesanalyse + ROI-prioritering + roadmap. 14 werkdagen.' },
        { '@type': 'Offer', name: 'Strategie-traject', priceCurrency: 'EUR', priceSpecification: { '@type': 'PriceSpecification', priceCurrency: 'EUR', description: 'Op maat — offerte binnen 24 uur' }, description: 'Meerdaagse deep-dive met managementpresentatie + implementatie-begeleiding. Op maat geprijsd.' },
      ],
    },
  },
];

const auditFaq = [
  { question: 'Wat krijg ik voor €1.950?', answer: 'Een grondige procesanalyse (5-10 processen), ROI-berekening per AI-automatiseringskans, prioriteringsmatrix (impact vs implementatiekosten), tech-stack advies en een concrete 90-dagen implementatieroadmap. Plus 1 presentatie aan uw managementteam. Oplevering binnen 14 werkdagen na intake.' },
  { question: 'Hoe lang duurt de audit echt?', answer: 'Van intake tot oplevering: 14 werkdagen (3 kalenderweken). Week 1: workshops + interviews met uw team. Week 2: data-analyse + ROI-berekeningen. Week 3: roadmap-finalisatie + management-presentatie.' },
  { question: 'Wat is het verschil met de gratis Quick Scan?', answer: 'De Quick Scan is een gratis 45-minuten gesprek met een globale kansen-mapping — voldoende voor oriëntatie. De Basis Audit (€1.950) is een gestructureerd traject met diepgaande procesanalyse, kwantitatieve ROI-berekeningen en een gevalideerde 90-dagen roadmap.' },
  { question: 'Kan ik de audit-investering verrekenen als ik daarna implementeer?', answer: 'Ja. Bij doorgang naar implementatie binnen 90 dagen wordt €1.000 van het audit-bedrag verrekend met het eerste maand-abonnement van Emma.' },
  { question: 'Wie voert de audit uit?', answer: 'De audit wordt geleid door Mustafa Agah Dogan (Oprichter Aanloop AI, bijna 20 jaar ervaring met workflow-automatisering en AI in NL MKB). Voor zorg- of juridische sectoren werken we samen met sector-specialisten.' },
  { question: 'Voor welke bedrijfsgrootte is dit geschikt?', answer: 'Sweet spot: MKB met 10-200 medewerkers en €1-50M jaaromzet. Voor kleinere ZZP/freelancers is de Quick Scan vaak voldoende. Voor enterprise (200+ medewerkers) bieden we een uitgebreider Strategie-traject op maat.' },
];
---

<BaseLayout
  title="AI Audit voor MKB — €1.950 vaste prijs"
  description="Productized AI-audit voor Nederlandse MKB: procesanalyse, ROI-prioritering en 90-dagen roadmap. Vaste prijs €1.950, geen verrassingen."
  schema={auditSchema}
  faqSchema={auditFaq}
>
  <section class="border-b border-slate-200 hero-gradient">
    <div class="container-page py-16 lg:py-28">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div class="max-w-3xl">
        <div class="flex items-center gap-3 mb-6">
          <div class="accent-band"><span></span><span></span><span></span><span></span></div>
          <span class="eyebrow">AI Audit · vaste prijs</span>
        </div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-emerald/10 text-brand-emerald text-xs font-semibold mb-5">
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
          €1.950 vaste prijs · oplevering in 14 dagen
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tightest text-navy text-balance leading-[1.05]">
          Concrete AI-roadmap voor uw MKB.<br/>Binnen 14 dagen.
        </h1>
        <p class="mt-6 text-lg text-slate-600 leading-relaxed max-w-2xl">
          Geen vage strategie-deck. Een productized AI-audit met procesanalyse, kwantitatieve ROI-berekening per kans en een gevalideerde 90-dagen implementatieroadmap. Vaste prijs €1.950 — geen verrassingen, geen scope-creep.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row gap-3">
          <a href="/contact/?type=audit" class="btn-primary text-base px-6 py-3.5">
            Audit boeken — €1.950
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
          <a href="#audit-detail" class="btn-outline text-base px-6 py-3.5">Wat zit erin?</a>
        </div>
        <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-xs text-slate-500">
          <li class="flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-brand-emerald" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
            5-10 processen geanalyseerd
          </li>
          <li class="flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-brand-emerald" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
            Kwantitatieve ROI per kans
          </li>
          <li class="flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-brand-emerald" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
            90-dagen roadmap
          </li>
          <li class="flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-brand-emerald" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
            Doorgangs-korting €1.000
          </li>
        </ul>
      </div>
      <div class="reveal reveal-delay-2">
        <Image src={pageImage} alt="Twee laptops met paperwork analyse — Aanloop AI audit voor Nederlandse MKB-bedrijven" class="w-full rounded-2xl shadow-xl object-cover aspect-[4/3]" loading="eager" decoding="async" fetchpriority="high" widths={[480, 800, 1200, 1400]} sizes="(min-width: 1024px) 600px, 100vw" format="webp" quality={82} />
      </div>
      </div>
    </div>
  </section>

  <section id="audit-detail" class="section scroll-mt-20">
    <div class="container-page">
      <div class="grid lg:grid-cols-2 gap-16">
        <div class="reveal">
          <p class="eyebrow mb-3">Wat u krijgt</p>
          <h2 class="text-3xl font-bold tracking-tightest text-navy mb-6">Inhoud van de audit.</h2>
          <ul class="space-y-4">
            {[
              'Procesanalyse: welke taken kosten het meest tijd?',
              'AI-geschiktheidsscan per proces',
              'ROI-berekening per automatiseringskans',
              'Prioriteringsmatrix: impact vs. implementatiekosten',
              'Concrete aanbevelingen met tijdlijn',
              'Tech-stack advies: welke tools passen bij u',
              'Presentatie aan uw management-team',
            ].map(item => (
              <li class="flex items-start gap-3 text-sm text-slate-700">
                <svg class="w-5 h-5 mt-0.5 flex-shrink-0 text-brand-emerald" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
        <div class="reveal reveal-delay-2">
          <p class="eyebrow mb-3">Investering</p>
          <h2 class="text-3xl font-bold tracking-tightest text-navy mb-6">Transparante prijzen.</h2>
          <div class="space-y-4">
            {[
              { name: 'Quick scan', price: 'Gratis', desc: '45 min gesprek + globale kansen-analyse. Ideaal voor oriëntatie.' },
              { name: 'Basis audit', price: '€1.950', desc: 'Volledige procesanalyse + prioriteringsmatrix + roadmap. 2 weken doorlooptijd.' },
              { name: 'Strategie-traject', price: 'Op maat', desc: 'Meerdaagse deep-dive met managementpresentatie en implementatieondersteuning.' },
            ].map(p => (
              <div class="card">
                <div class="flex justify-between items-start mb-2">
                  <h3 class="font-bold text-navy">{p.name}</h3>
                  <span class="font-bold text-brand-indigo">{p.price}</span>
                </div>
                <p class="text-sm text-slate-600">{p.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-slate-50 border-y border-slate-200">
    <div class="container-page max-w-4xl">
      <p class="eyebrow text-brand-indigo mb-2">Website + AI = 1 partner</p>
      <h2 class="text-2xl lg:text-3xl font-bold text-navy mb-4">Na de audit: kies één partner voor website én AI</h2>
      <p class="text-slate-600 mb-8 leading-relaxed">Een audit identificeert kansen — implementatie volgt vaak met meerdere leveranciers. Aanloop AI biedt website + Emma in één pakket (AI-Website Bundel), bespaart op jaarbasis t.o.v. losse leveranciers, met één contract en één aanspreekpunt voor de hele uitvoering.</p>
      <div class="grid md:grid-cols-3 gap-4">
        <a href="/diensten/ai-website-bundel-mkb-nederland/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">AI-Website Bundel</h3>
          <p class="text-xs text-slate-600 mb-3">Website + Emma in 1 pakket. €5.950 setup + €649/mnd all-in. Eén factuur, één SLA.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk bundel →</span>
        </a>
        <a href="/diensten/website-laten-maken-mkb-nederland-2026/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">Website laten maken</h3>
          <p class="text-xs text-slate-600 mb-3">Astro/Next/WordPress AI-ready. Schema.org + Speakable + WCAG 2.2 AA + Core Web Vitals groen.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk pakketten →</span>
        </a>
        <a href="/cases/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">Combo-cases bekijken</h3>
          <p class="text-xs text-slate-600 mb-3">5 branche-scenarios met Website + AI bundel: detailhandel, zorg, horeca, advocatuur, accountancy.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk cases →</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section-tight bg-midnight text-pearl">
    <div class="container-page">
      <div class="max-w-2xl">
        <h2 class="text-3xl font-bold tracking-tightest text-pearl">Begin met een gratis quick scan.</h2>
        <p class="mt-4 text-slate-300">45 minuten, geen kosten, geen verplichtingen. U vertrekt met concrete inzichten.</p>
        <div class="mt-6">
          <a href="/contact/?type=offerte" class="btn bg-pearl text-navy hover:bg-white text-base px-6 py-3.5">Quick scan aanvragen</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
