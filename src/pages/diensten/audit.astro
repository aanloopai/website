---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FaqSection from '../../components/FaqSection.astro';
import pageImage from '../../assets/images/pages/audit.jpg';

const auditSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': 'https://aanloopai.nl/diensten/audit/#service',
    name: 'AI Audit voor MKB Nederland',
    serviceType: 'AI strategie + implementatie-roadmap',
    description: 'Grondige analyse van bedrijfsprocessen, ROI-prioritering per AI-kans en concrete 90-dagen implementatieroadmap. Vaste prijs, op aanvraag. Oplevering binnen 14 werkdagen.',
    provider: { '@type': 'Organization', '@id': 'https://aanloopai.nl/#organization' },
    areaServed: { '@type': 'Country', name: 'Nederland' },
    audience: { '@type': 'BusinessAudience', audienceType: 'MKB Nederland (10-200 medewerkers)' },
    offers: {
      '@type': 'Offer',
      '@id': 'https://aanloopai.nl/diensten/audit/#offer',
      name: 'AI Audit — vaste prijs, op aanvraag',
      priceCurrency: 'EUR',
      priceSpecification: { '@type': 'PriceSpecification', priceCurrency: 'EUR', description: 'Vaste prijs — op aanvraag, offerte in het gesprek' },
      availability: 'https://schema.org/InStock',
      validFrom: '2026-05-03',
      url: 'https://aanloopai.nl/diensten/audit/',
      itemOffered: { '@id': 'https://aanloopai.nl/diensten/audit/#service' },
      eligibleDuration: { '@type': 'QuantitativeValue', value: 14, unitCode: 'DAY', description: 'Oplevering binnen 14 werkdagen' },
    },
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Audit-pakketten',
      itemListElement: [
        { '@type': 'Offer', name: 'Quick scan', price: '0', priceCurrency: 'EUR', description: '45-min adviesgesprek met kansen-mapping. Gratis.' },
        { '@type': 'Offer', name: 'Basis AI Audit', priceCurrency: 'EUR', priceSpecification: { '@type': 'PriceSpecification', priceCurrency: 'EUR', description: 'Vaste prijs — op aanvraag' }, description: 'Volledige procesanalyse + ROI-prioritering + roadmap. 14 werkdagen.' },
        { '@type': 'Offer', name: 'Strategie-traject', priceCurrency: 'EUR', priceSpecification: { '@type': 'PriceSpecification', priceCurrency: 'EUR', description: 'Op maat — offerte binnen 24 uur' }, description: 'Meerdaagse deep-dive met managementpresentatie + implementatie-begeleiding. Op maat geprijsd.' },
      ],
    },
  },
];

const auditFaq = [
  { question: 'Wat krijg ik bij de Basis Audit?', answer: 'Een grondige procesanalyse (5-10 processen), ROI-berekening per AI-automatiseringskans, prioriteringsmatrix (impact vs implementatiekosten), tech-stack advies en een concrete 90-dagen implementatieroadmap. Plus 1 presentatie aan uw managementteam. Oplevering binnen 14 werkdagen na intake.' },
  { question: 'Hoe lang duurt de audit echt?', answer: 'Van intake tot oplevering: 14 werkdagen (3 kalenderweken). Week 1: workshops + interviews met uw team. Week 2: data-analyse + ROI-berekeningen. Week 3: roadmap-finalisatie + management-presentatie.' },
  { question: 'Wat is het verschil met de gratis Quick Scan?', answer: 'De Quick Scan is een gratis 45-minuten gesprek met een globale kansen-mapping — voldoende voor oriëntatie. De Basis Audit (vaste prijs, op aanvraag) is een gestructureerd traject met diepgaande procesanalyse, kwantitatieve ROI-berekeningen en een gevalideerde 90-dagen roadmap.' },
  { question: 'Kan ik de audit-investering verrekenen als ik daarna implementeer?', answer: 'Ja. Bij doorgang naar implementatie binnen 90 dagen wordt een deel van het audit-bedrag verrekend met het eerste maand-abonnement van Emma.' },
  { question: 'Wie voert de audit uit?', answer: 'De audit wordt geleid door het team van Aanloop AI (bijna 20 jaar ervaring met workflow-automatisering en AI in NL MKB). Voor zorg- of juridische sectoren werken we samen met sector-specialisten.' },
  { question: 'Wat kost een AI-audit in Nederland?', answer: 'Bij Aanloop AI is de Quick Scan gratis, de Basis AI Audit een vaste prijs die wij op aanvraag offreren na de intake, en het Strategie-traject maatwerk. Wij noemen geen bedragen die we niet kunnen onderbouwen: de omvang hangt af van het aantal processen en afdelingen. Ter vergelijking staan de vervolgstappen openbaar op de tarievenpagina: GEO Maandelijks €595 per maand, en de AI-Website Bundel €4.500 eenmalig plus €1.000 per maand (alle bedragen exclusief 21% btw).' },
  { question: 'Wat is het verschil tussen een AI-audit en een GEO-audit?', answer: 'Een AI-audit kijkt naar uw interne processen: waar kan AI tijd of omzet terugwinnen. Een GEO-audit kijkt naar uw zichtbaarheid naar buiten: wordt uw bedrijf genoemd door ChatGPT, Perplexity en Google bij vragen van klanten. Beide kunnen los of samen. De GEO-kant staat beschreven bij ons GEO-bureau.' },
  { question: 'Garanderen jullie een bepaald resultaat of besparing?', answer: 'Nee. De audit rekent per kans een onderbouwde bandbreedte uit op basis van uw eigen cijfers (uren, aantallen, uurtarief) en benoemt de aannames. Verwachte besparingen zijn dus een schatting, geen garantie. Gemeten uitkomsten van onze eigen projecten publiceren wij op de resultatenpagina.' },
  { question: 'Wat is een AI-audit?', answer: 'Een AI-audit is een gestructureerd onderzoek naar waar kunstmatige intelligentie in uw bedrijf aantoonbaar tijd of omzet oplevert. U ontvangt een procesanalyse, een ROI-bandbreedte per kans, een prioriteringsmatrix en een 90-dagenroadmap. Het is geen softwarepakket en geen garantie op besparing.' },
  { question: 'Werken jullie ook als AI-audit bureau in Amsterdam, Utrecht of Eindhoven?', answer: 'Ja. Wij werken voor MKB-bedrijven door heel Nederland, per video of op locatie, tegen dezelfde vaste prijs. Met kantoor in Rotterdam zijn wij snel in de Randstad; zie ook de locatiepagina voor Amsterdam, Utrecht en Eindhoven.' },
  { question: 'Voor welke bedrijfsgrootte is dit geschikt?', answer: 'Sweet spot: MKB met 10-200 medewerkers en €1-50M jaaromzet. Voor kleinere ZZP/freelancers is de Quick Scan vaak voldoende. Voor enterprise (200+ medewerkers) bieden we een uitgebreider Strategie-traject op maat.' },
];
---

<BaseLayout
  title="AI-audit Nederland voor MKB | Vaste prijs, 14 dagen"
  description="AI-audit Nederland voor het MKB: procesanalyse, ROI per kans en een 90-dagenroadmap in 14 werkdagen. Vaste prijs op aanvraag, eerst een gratis Quick Scan."
  schema={auditSchema}
  faqSchema={auditFaq}
>
  <section class="border-b border-slate-200 hero-gradient">
    <div class="container-page py-16 lg:py-28">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div class="max-w-3xl">
        <div class="flex items-center gap-3 mb-6">
          <div class="accent-band"><span></span><span></span><span></span><span></span></div>
          <span class="eyebrow">AI Audit · vaste prijs</span>
        </div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-emerald/10 text-brand-emerald text-xs font-semibold mb-5">
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
          Vaste prijs, op aanvraag · oplevering in 14 dagen
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-semibold tracking-tighter text-navy text-balance leading-[1.05]">
          AI-audit Nederland voor het MKB.<br/>Concrete roadmap in 14 dagen.
        </h1>
        <p class="mt-6 text-lg text-slate-600 leading-relaxed max-w-2xl">
          Een AI-audit laat zien waar AI in uw bedrijf aantoonbaar tijd of omzet oplevert, en waar niet. Geen vage strategie-deck, maar een AI-audit met procesanalyse, kwantitatieve ROI-berekening per kans en een gevalideerde 90-dagen implementatieroadmap. Vaste prijs, op aanvraag — geen verrassingen, geen scope-creep.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row gap-3">
          <a href="/contact/?type=audit" class="btn-primary text-base px-6 py-3.5">
            Audit boeken — offerte aanvragen
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
          <a href="#audit-detail" class="btn-outline text-base px-6 py-3.5">Wat zit erin?</a>
        </div>
        <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-xs text-slate-500">
          <li class="flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-brand-emerald" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
            5-10 processen geanalyseerd
          </li>
          <li class="flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-brand-emerald" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
            Kwantitatieve ROI per kans
          </li>
          <li class="flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-brand-emerald" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
            90-dagen roadmap
          </li>
          <li class="flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-brand-emerald" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
            Doorgangs-korting bij implementatie
          </li>
        </ul>
      </div>
      <div class="reveal reveal-delay-2">
        <Image src={pageImage} alt="Consultantbureau met procesdiagrammen waarvan één stap wordt uitgelicht — Aanloop AI audit voor Nederlandse MKB-bedrijven" class="w-full rounded-lg shadow-xl object-cover aspect-[4/3]" loading="eager" decoding="async" fetchpriority="high" widths={[480, 800, 1200, 1400]} sizes="(min-width: 1024px) 600px, 100vw" format="webp" quality={82} />
      </div>
      </div>
    </div>
  </section>

  <section id="audit-detail" class="section scroll-mt-20">
    <div class="container-page">
      <div class="grid lg:grid-cols-2 gap-16">
        <div class="reveal">
          <p class="eyebrow mb-3">Wat u krijgt</p>
          <h2 class="text-3xl font-semibold tracking-tighter text-navy mb-6">Inhoud van de audit.</h2>
          <ul class="space-y-4">
            {[
              'Procesanalyse: welke taken kosten het meest tijd?',
              'AI-geschiktheidsscan per proces',
              'ROI-berekening per automatiseringskans',
              'Prioriteringsmatrix: impact vs. implementatiekosten',
              'Concrete aanbevelingen met tijdlijn',
              'Tech-stack advies: welke tools passen bij u',
              'Presentatie aan uw management-team',
            ].map(item => (
              <li class="flex items-start gap-3 text-sm text-slate-700">
                <svg class="w-5 h-5 mt-0.5 flex-shrink-0 text-brand-emerald" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
        <div class="reveal reveal-delay-2">
          <p class="eyebrow mb-3">Investering</p>
          <h2 class="text-3xl font-semibold tracking-tighter text-navy mb-6">Transparante prijzen.</h2>
          <div class="space-y-4">
            {[
              { name: 'Quick scan', price: 'Gratis', desc: '45 min gesprek + globale kansen-analyse. Ideaal voor oriëntatie.' },
              { name: 'Basis audit', price: 'Op aanvraag', desc: 'Volledige procesanalyse + prioriteringsmatrix + roadmap. 2 weken doorlooptijd.' },
              { name: 'Strategie-traject', price: 'Op maat', desc: 'Meerdaagse deep-dive met managementpresentatie en implementatieondersteuning.' },
            ].map(p => (
              <div class="card">
                <div class="flex justify-between items-start mb-2">
                  <h3 class="font-bold text-navy">{p.name}</h3>
                  <span class="font-bold text-brand-indigo">{p.price}</span>
                </div>
                <p class="text-sm text-slate-600">{p.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section scroll-mt-20" id="welke-stap">
    <div class="container-page max-w-5xl">
      <p class="eyebrow mb-3">Kiezen</p>
      <h2 class="text-3xl font-semibold tracking-tighter text-navy mb-4">AI-audit of eerst een kansenonderzoek? Vier stappen vergeleken.</h2>
      <p class="text-slate-600 leading-relaxed mb-8">Veel MKB-bedrijven in Nederland weten dat ze iets met AI moeten, maar niet waar te beginnen. De vier stappen hieronder bouwen op elkaar voort. U hoeft niet alle vier te nemen: de eerste is gratis en zegt vaak al genoeg om te besluiten of een volgende stap loont.</p>
      <div class="overflow-x-auto">
        <table class="w-full text-sm text-left border border-slate-200 rounded-lg">
          <caption class="sr-only">Vergelijking van kansenonderzoek, audit, strategie en implementatie</caption>
          <thead class="bg-slate-50 text-navy">
            <tr>
              <th scope="col" class="p-3 font-semibold">Stap</th>
              <th scope="col" class="p-3 font-semibold">Onze naam</th>
              <th scope="col" class="p-3 font-semibold">Wat u krijgt</th>
              <th scope="col" class="p-3 font-semibold">Prijs</th>
              <th scope="col" class="p-3 font-semibold">Past bij</th>
            </tr>
          </thead>
          <tbody class="text-slate-700 align-top">
            <tr class="border-t border-slate-200">
              <th scope="row" class="p-3 font-semibold text-navy">1. Kansenonderzoek</th>
              <td class="p-3">Quick Scan (45 min) en GEO Quick Scan</td>
              <td class="p-3">Globale kansen-mapping van uw aanvraagstromen en een eerste inschatting van uw AI-zichtbaarheid.</td>
              <td class="p-3">Gratis</td>
              <td class="p-3">Oriëntatie, ZZP en kleine teams, of u twijfelt of AI voor u relevant is.</td>
            </tr>
            <tr class="border-t border-slate-200">
              <th scope="row" class="p-3 font-semibold text-navy">2. Audit</th>
              <td class="p-3">Basis AI Audit</td>
              <td class="p-3">Analyse van 5-10 processen, ROI per kans, prioriteringsmatrix, tech-stack advies en 90-dagenroadmap. Oplevering in 14 werkdagen.</td>
              <td class="p-3">Vaste prijs, op aanvraag</td>
              <td class="p-3">MKB met 10-200 medewerkers dat een onderbouwd plan wil voordat het investeert.</td>
            </tr>
            <tr class="border-t border-slate-200">
              <th scope="row" class="p-3 font-semibold text-navy">3. Strategie</th>
              <td class="p-3">Strategie-traject</td>
              <td class="p-3">Meerdaagse deep-dive over meerdere afdelingen, managementpresentatie en begeleiding bij de uitvoering.</td>
              <td class="p-3">Op maat, offerte binnen 24 uur</td>
              <td class="p-3">Grotere organisaties of meerdere vestigingen met uiteenlopende processen.</td>
            </tr>
            <tr class="border-t border-slate-200">
              <th scope="row" class="p-3 font-semibold text-navy">4. Implementatie</th>
              <td class="p-3">Emma (AI-receptionist), AI-Website Bundel, GEO Maandelijks</td>
              <td class="p-3">De gekozen kansen worden gebouwd en gemeten: telefoon en WhatsApp opvangen, een AI-ready website, maandelijkse AI-vindbaarheid.</td>
              <td class="p-3">Emma vanaf €149 per maand; bundel €4.500 + €1.000 per maand; GEO €595 per maand (excl. btw)</td>
              <td class="p-3">Bedrijven die al weten wat ze willen of uit de audit een roadmap hebben.</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="mt-4 text-sm text-slate-600">Alle prijzen staan op de <a href="/tarieven/" class="text-brand-indigo hover:underline">tarievenpagina</a>. Een prijs voor de Basis AI Audit noemen wij niet vooraf op de website: de omvang hangt af van het aantal processen, dus de vaste prijs volgt na de intake.</p>
    </div>
  </section>

  <section class="section bg-slate-50 border-y border-slate-200">
    <div class="container-page max-w-4xl">
      <p class="eyebrow text-brand-indigo mb-2">Uitleg</p>
      <h2 class="text-2xl lg:text-3xl font-bold text-navy mb-4">Wat is een AI-audit voor het MKB, en wat niet?</h2>
      <p class="text-slate-600 leading-relaxed mb-4">Een AI-audit (ook geschreven als AI audit of AI-scan) is een gestructureerd onderzoek naar waar kunstmatige intelligentie in uw bedrijf aantoonbaar iets oplevert. Het is geen softwarepakket en geen tool-demo. Het resultaat is een document en een gesprek: welke processen verdienen automatisering, wat levert dat op in uren of omzet, wat kost het, en in welke volgorde pakt u het aan.</p>
      <p class="text-slate-600 leading-relaxed mb-4">Het begint bij uw eigen cijfers. In de intake bepalen we welke processen zich lenen voor analyse. Denk aan het afhandelen van offerteaanvragen, het inplannen van afspraken, het beantwoorden van veelgestelde vragen, het opvolgen van leads of het verwerken van facturen. Per proces leggen we vast hoeveel tijd het kost, hoe vaak het voorkomt, waar fouten ontstaan en hoeveel aanvragen verloren gaan doordat niemand op tijd reageert.</p>
      <p class="text-slate-600 leading-relaxed mb-4">Daarna volgt de AI-geschiktheidsscan. Niet alles hoort geautomatiseerd te worden. Taken met veel herhaling, duidelijke regels en genoeg volume zijn goede kandidaten. Taken die persoonlijk oordeel of vertrouwen vragen blijven bij uw team. De audit zegt dat ook, zelfs als het betekent dat een kans niet de moeite waard blijkt.</p>
      <h3 class="text-xl font-bold text-navy mt-8 mb-3">Wat de audit niet is</h3>
      <p class="text-slate-600 leading-relaxed mb-4">Een audit is geen garantie op besparing en geen certificering. Wij doen geen uitspraken over certificeringen die wij niet hebben; wij verwerken gegevens volgens de AVG en benoemen in de audit welke gegevens een gekozen oplossing zou raken. Wij bieden ook geen betaalde advertentiecampagnes aan: de audit kijkt naar uw eigen processen en naar uw vindbaarheid, niet naar mediabudget.</p>

      <h2 class="text-2xl lg:text-3xl font-bold text-navy mt-12 mb-4">Zo verloopt de audit in drie weken</h2>
      <ol class="space-y-4 text-slate-600 leading-relaxed">
        <li><strong class="text-navy">Week 1, intake en workshops.</strong> We spreken met de mensen die het werk doen, niet alleen met de directie. Zij weten waar tijd verdwijnt. We verzamelen telefoon-, mail- en formuliervolumes en kijken mee in de systemen die u gebruikt.</li>
        <li><strong class="text-navy">Week 2, analyse en berekening.</strong> Per kans rekenen we een bandbreedte uit op basis van uw eigen aantallen en uurtarief, en leggen we elke aanname vast. Daarna volgt de prioriteringsmatrix: wat levert veel op tegen weinig inspanning, en wat kan wachten.</li>
        <li><strong class="text-navy">Week 3, roadmap en presentatie.</strong> U ontvangt een 90-dagenroadmap met volgorde, verantwoordelijken en meetpunten, en een presentatie voor uw managementteam. Alles wat in het rapport staat is los te gebruiken, ook als u de uitvoering bij een andere partij onderbrengt.</li>
      </ol>

      <h2 class="text-2xl lg:text-3xl font-bold text-navy mt-12 mb-4">Audit en zichtbaarheid in AI-assistenten</h2>
      <p class="text-slate-600 leading-relaxed mb-4">Een AI-audit gaat bij ons niet alleen over intern werk. Steeds vaker beginnen klanten hun zoektocht bij ChatGPT, Perplexity of Google AI-overzichten. Of uw bedrijf daar genoemd wordt is meetbaar. Dat meten we met dezelfde vragen, dezelfde assistenten en een vaste frequentie, zodat verandering te zien is. Onze aanpak, de sectorpagina's en de tarieven staan bij het <a href="/geo-bureau/" class="text-brand-indigo hover:underline">GEO-bureau</a>; de gemeten cijfers van ons eigen werk vindt u op de <a href="/resultaten/" class="text-brand-indigo hover:underline">resultatenpagina</a>.</p>
      <p class="text-slate-600 leading-relaxed mb-4">Beide kanten versterken elkaar. Wie een AI-receptionist inzet maar niet gevonden wordt, krijgt weinig gesprekken om op te volgen. Wie wel gevonden wordt maar traag reageert, verliest de aanvraag aan een concurrent. De audit laat zien welke van de twee bij u het zwakst is, zodat u daar begint.</p>

      <h2 class="text-2xl lg:text-3xl font-bold text-navy mt-12 mb-4">AI-audit Nederland: voor wie en waar</h2>
      <p class="text-slate-600 leading-relaxed mb-4">Wij werken voor MKB-bedrijven door heel Nederland, per video of op locatie. De prijs is overal gelijk. Met kantoor in Rotterdam zijn we snel aanwezig in de Randstad, en voor Amsterdam, Utrecht en Eindhoven komen wij graag langs (zie de <a href="/locaties/" class="text-brand-indigo hover:underline">locatiepagina's</a>). Typische opdrachtgevers zijn dienstverleners, installatie- en bouwbedrijven, horeca, webshops, zorgpraktijken en kantoren met 10 tot 200 medewerkers. Een praktische vuistregel: als uw team elke week meer dan een paar uur kwijt is aan herhalend telefoon-, mail- of planningswerk, levert een audit meestal concrete kansen op.</p>
      <p class="text-slate-600 leading-relaxed">Zoekt u een bureau dat ook de uitvoering doet? Bekijk dan ons overzicht <a href="/ai-marketing-bureau/" class="text-brand-indigo hover:underline">AI marketing bureau Nederland</a>, of boek direct een gratis Quick Scan.</p>
    </div>
  </section>

  <section class="section bg-slate-50 border-y border-slate-200">
    <div class="container-page max-w-4xl">
      <p class="eyebrow text-brand-indigo mb-2">Website + AI = 1 partner</p>
      <h2 class="text-2xl lg:text-3xl font-bold text-navy mb-4">Na de audit: kies één partner voor website én AI</h2>
      <p class="text-slate-600 mb-8 leading-relaxed">Een audit identificeert kansen — implementatie volgt vaak met meerdere leveranciers. Aanloop AI biedt website + Emma in één pakket (AI-Website Bundel), bespaart op jaarbasis t.o.v. losse leveranciers, met één contract en één aanspreekpunt voor de hele uitvoering.</p>
