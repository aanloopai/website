---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import emmaWhatsapp from '../../assets/images/emma-whatsapp.png';

const sectorUseCases = [
  { title: 'Webshops & e-commerce', slug: '/sectoren/ai-voor-webshops/', body: 'Emma beantwoordt vragen over voorraad, levertijden, retouren en orderstatus 24/7. Gekoppeld aan uw Shopify of WooCommerce winkel zoekt ze realtime in uw bestellingen — minder ticketdruk, hogere conversie.' },
  { title: 'Horeca & restaurants', slug: '/sectoren/horeca/', body: 'Reserveringen, openingstijden, allergeneninformatie en bestellingen via WhatsApp. Emma synchroniseert direct met uw reserveringssysteem (Resengo, Formitable, eigen agenda) zonder personeel uit de keuken te halen.' },
  { title: 'Vastgoed & makelaars', slug: '/sectoren/vastgoed/', body: 'Inkomende WhatsApp-aanvragen worden direct gekwalificeerd: budget, locatie, gewenste woning. Emma stuurt eerste objectvoorstellen en plant bezichtigingen in uw agenda — uw kandidaten landen warm in het CRM.' },
  { title: 'Zakelijke dienstverlening', slug: '/sectoren/zakelijk/', body: 'Voor consultants, accountants en juristen: Emma vangt eerstelijnsvragen op (fees, beschikbaarheid, dossierstatus), en escaleert naar de juiste collega met volledige gespreksgeschiedenis.' },
  { title: 'ZZP & freelancers', slug: '/sectoren/ai-voor-zzp/', body: 'Eén ZZP&apos;er, één agenda, vele klanten. Emma neemt vragen op terwijl u werkt, plant kennismakingen in en stuurt offertes uit — u beantwoordt alleen wat écht persoonlijke aandacht vraagt.' },
];

const integrations = {
  Messaging: ['WhatsApp Business API (Meta)', 'WhatsApp Cloud API', 'Telegram', 'Facebook Messenger', 'Webchat-widget'],
  CRM: ['HubSpot', 'Pipedrive', 'Salesforce', 'Microsoft Dynamics', 'Custom REST API'],
  'E-commerce': ['Shopify', 'WooCommerce', 'Magento 2', 'Lightspeed', 'PrestaShop'],
  Helpdesk: ['Zendesk', 'Freshdesk', 'Intercom', 'Crisp', 'Eigen ticketsysteem'],
};

const comparison = [
  { feature: '24/7 beschikbaar zonder bemensing', emma: true, livechat: 'Tijdens kantooruren', chatgpt: true, email: false },
  { feature: 'Officieel WhatsApp Business API geverifieerd', emma: true, livechat: 'Variabel', chatgpt: false, email: false },
  { feature: 'Getraind op eigen kennisbank', emma: true, livechat: false, chatgpt: 'Beperkt', email: false },
  { feature: 'Realtime productdata (voorraad, orders)', emma: true, livechat: 'Handmatig', chatgpt: false, email: false },
  { feature: 'Naadloze handover naar mens', emma: true, livechat: true, chatgpt: false, email: 'Manueel' },
  { feature: 'CRM-koppeling met conversatiehistorie', emma: true, livechat: 'Variabel', chatgpt: false, email: 'Variabel' },
  { feature: 'Maandelijkse kosten (MKB-volume)', emma: 'Vanaf €49', livechat: '€500-2.000', chatgpt: '€20/user', email: 'Personeelskosten' },
  { feature: 'AVG/GDPR-compliant + EU-data', emma: true, livechat: 'Variabel', chatgpt: false, email: 'Variabel' },
];

const faqItems = [
  { question: 'Heb ik een WhatsApp Business account nodig?', answer: 'Niet bij start. Wij regelen de WhatsApp Business API-aanmelding bij Meta (gratis verificatie via een 360dialog of Twilio-partner). U behoudt eigenaarschap van het nummer en de history. Als u al een WhatsApp Business-account heeft, koppelen we Emma aan uw bestaande nummer.' },
  { question: 'Hoe wordt Emma getraind voor mijn bedrijf?', answer: 'Tijdens onboarding voeden we Emma met uw FAQ-sectie, productcatalogus, leveringsvoorwaarden en eventuele interne documenten. We doen twee testrondes met u — u stelt lastige vragen en stuurt op het antwoordgedrag. Pas daarna gaat Emma live.' },
  { question: 'Wat doet Emma bij een vraag die ze niet kan beantwoorden?', answer: 'Emma escaleert volgens uw protocol: kan doorzetten naar een specifiek teamlid, een ticket openen in uw helpdesk, een terugbelafspraak plannen of de klant doorverwijzen naar het juiste contactkanaal. U bepaalt zelf de escalatieregels.' },
  { question: 'Wat kost Emma precies?', answer: 'Emma heeft vier prijspunten: Emma Lite €49/maand standalone (tot 500 berichten, standaard FAQ-training, NL/EN auto-detect — instap voor budget-MKB die WhatsApp wil testen). Emma Standard €197/maand standalone (onbeperkte berichten, eigen kennisbank, native Shopify/WooCommerce/HubSpot-koppeling, multilingual NL/EN/FR/DE). In bundels: gratis inbegrepen vanaf het Marco Groei-pakket €997/maand (onbeperkt, met Marco AI-telefoniste). Custom-volume of multi-team setups via Partner-pakket. WhatsApp-conversatiekosten van Meta (gemiddeld €0,03-0,08 per uniek 24-uurs venster) zijn niet inbegrepen — u betaalt deze direct aan Meta. Wij rekenen geen marge op WhatsApp-fees. Zie /tarieven voor de volledige opbouw.' },
  { question: 'Werkt Emma met mijn bestaande Shopify of WooCommerce?', answer: 'Ja. Voor Shopify, WooCommerce, Magento, Lightspeed en PrestaShop hebben we native koppelingen. Emma kan voorraad, orderstatus, retourstatus en levertijden realtime opzoeken en delen met de klant.' },
  { question: 'Worden gesprekken opgeslagen en hoe lang?', answer: 'Conversaties worden bewaard in EU-datacenters (Amsterdam/Frankfurt) met encryptie at-rest en in-transit. Default bewaartermijn is 90 dagen, configureerbaar tussen 7 en 365 dagen. Voor klanten met aparte compliance-eisen leveren we een dedicated tenant.' },
  { question: 'Kan Emma in meerdere talen tegelijk werken?', answer: 'Ja. Emma detecteert automatisch de taal van de klant (NL, EN, FR, DE standaard; ES, IT, PL op aanvraag) en antwoordt in dezelfde taal. Voor toeristische gebieden of internationale webshops is dit een grote conversie-booster.' },
  { question: 'Wat is het verschil tussen Emma en een gewone ChatGPT-koppeling?', answer: 'Emma is een productie-grade WhatsApp-integratie met officiële Meta-verificatie, getrainde kennisbank, CRM-routing, multilingual support, AVG-compliance en handover-protocollen. Een ChatGPT-koppeling die u zelf bouwt mist deze lagen en kan na een Meta API-update zomaar offline gaan. Wij zorgen voor uptime en compliance.' },
  { question: 'Hoe snel is Emma live in mijn bedrijf?', answer: 'Standaard 7 werkdagen. Onboarding-vragenlijst (1 uur), kennisbank-import (1 dag), Meta API-verificatie (2-3 dagen), training & testrondes (2 dagen). Bij urgentie kunnen we versnellen naar 3 werkdagen voor een express-fee.' },
  { question: 'Is Emma AVG/GDPR-compliant?', answer: 'Ja. Aanloop AI is een Nederlandse B.V. (KVK 56312075), alle data wordt binnen de EU verwerkt en bewaard, we leveren een verwerkersovereenkomst-template en ondersteunen recht op verwijdering binnen 24 uur. Voor zorg- en juridische klanten leveren we een NEN 7510-compatibele opzet.' },
  { question: 'Kan ik Emma testen voordat ik teken?', answer: 'Ja, gratis. Tijdens een 30-minuten demo laten we Emma uw exacte branche-scenario afhandelen via een testnummer. U mag zelf vragen stellen, lastige edge-cases proberen en sturen op het script. Pas daarna beslist u.' },
  { question: 'Wat als ik Emma wil opzeggen?', answer: 'Maandelijkse opzegtermijn van één maand. Geen exit-fees. WhatsApp-nummer en conversatiehistorie blijven uw eigendom — wij leveren een export in JSON of CSV. Bij jaarbetaling krijgt u 16% korting maar bij vroegtijdige opzegging is er geen restitutie.' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Emma — AI WhatsApp Bot voor MKB',
  alternateName: ['AI chatbot bouwen Nederland', 'chatbot laten maken MKB', 'MKB chatbot', 'AI chat-assistent', 'klantenservice chatbot Nederland'],
  description: 'AI WhatsApp Business bot voor het Nederlandse MKB die klantvragen 24/7 beantwoordt, getraind op uw eigen kennisbank, met naadloze handover naar uw team.',
  brand: { '@type': 'Brand', name: 'Aanloop AI' },
  category: 'AI WhatsApp Bot Software',
  url: 'https://aanloopai.nl/diensten/emma/',
  audience: { '@type': 'BusinessAudience', audienceType: 'MKB Nederland' },
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'EUR',
    lowPrice: '49',
    highPrice: '2500',
    offerCount: '4',
    availability: 'https://schema.org/InStock',
    seller: { '@type': 'Organization', name: 'Aanloop AI', url: 'https://aanloopai.nl' },
  },
};

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Emma — AI WhatsApp Bot',
  alternateName: ['AI chatbot bouwen Nederland', 'chatbot laten maken MKB', 'MKB chatbot', 'AI chat-assistent', 'klantenservice chatbot'],
  description: 'Cloud-gebaseerde AI WhatsApp Business agent voor MKB Nederland: 24/7 klantvragen, getraind op eigen kennisbank, native koppeling met Shopify/WooCommerce/HubSpot, multilingual auto-detect, EU-only data.',
  url: 'https://aanloopai.nl/diensten/emma/',
  applicationCategory: 'BusinessApplication',
  applicationSubCategory: 'AI Chatbot / WhatsApp Business Agent',
  operatingSystem: 'Cloud (WhatsApp Business API + browser dashboard)',
  inLanguage: ['nl-NL', 'en', 'de', 'fr', 'es', 'it', 'pl'],
  isAccessibleForFree: false,
  creator: { '@type': 'Organization', '@id': 'https://aanloopai.nl/#organization', name: 'Aanloop AI', url: 'https://aanloopai.nl' },
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'EUR',
    lowPrice: '49',
    highPrice: '2500',
    offerCount: '4',
    availability: 'https://schema.org/InStock',
  },
  featureList: [
    'WhatsApp Business API officieel Meta-verified',
    '24/7 klantvragen automatisch beantwoorden',
    'Getraind op eigen FAQ + productcatalogus + interne documenten',
    'Realtime productdata via Shopify, WooCommerce, Magento, Lightspeed, PrestaShop',
    'Native CRM-koppeling (HubSpot, Pipedrive, Salesforce, Microsoft Dynamics)',
    'Helpdesk integratie (Zendesk, Freshdesk, Intercom, Crisp)',
    'Multilingual auto-detection (NL/EN/FR/DE standaard, ES/IT/PL op aanvraag)',
    'Naadloze handover naar uw team met conversatie-history',
    'AVG/GDPR-compliant — EU datacenters, encryptie at-rest + in-transit',
    'Conversatie-bewaartermijn configureerbaar (default 90 dagen)',
  ],
  audience: { '@type': 'BusinessAudience', audienceType: 'MKB Nederland' },
};
---

<BaseLayout
  title="Emma — AI Chatbot voor Website & WhatsApp Business"
  description="Emma is uw AI-klantenservicechatbot voor WhatsApp Business en website. Chatbot laten maken in 7 werkdagen, getraind op uw eigen kennisbank."
  schema={[schema, softwareSchema]}
  faqSchema={faqItems}
>
  <section class="border-b border-slate-200 hero-gradient">
    <div class="container-page py-16 lg:py-28">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <span class="eyebrow mb-6 block">Emma — WhatsApp agent</span>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tightest text-navy text-balance leading-[1.05]">
            Emma — AI-Chatbot voor uw Website + WhatsApp (NL bouwen)
          </h1>
          <p class="mt-6 text-lg text-slate-600 leading-relaxed max-w-lg">
            Emma is uw MKB chatbot voor WhatsApp Business en website: beantwoordt klantvragen in seconden, getraind op uw eigen kennisbank, met naadloze handover naar uw team. AI chatbot bouwen voor uw bedrijf — live in 7 werkdagen.
          </p>
          <div class="mt-8 flex flex-col sm:flex-row gap-3">
            <a href="/demo-aanvragen/" class="btn-primary text-base px-6 py-3.5">
              Gratis demo boeken
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </a>
            <a href="/tarieven/" class="btn-outline text-base px-6 py-3.5">Bekijk tarieven</a>
          </div>
          <!-- Quick stats -->
          <div class="mt-10 grid grid-cols-3 gap-4">
            <div class="text-center">
              <div class="text-2xl font-bold text-brand-rose">80%</div>
              <div class="text-xs text-slate-500 mt-1">auto beantwoord</div>
            </div>
            <div class="text-center">
              <div class="text-2xl font-bold text-brand-indigo">&lt;5s</div>
              <div class="text-xs text-slate-500 mt-1">reactietijd</div>
            </div>
            <div class="text-center">
              <div class="text-2xl font-bold text-brand-emerald">24/7</div>
              <div class="text-xs text-slate-500 mt-1">beschikbaar</div>
            </div>
          </div>
        </div>
        <!-- WhatsApp mockup -->
        <div class="flex justify-center reveal reveal-delay-2">
          <Image
            src={emmaWhatsapp}
            alt="Emma WhatsApp AI agent — klantgesprek voorbeeld"
            class="w-72 lg:w-80 rounded-3xl shadow-2xl border border-slate-200"
            loading="eager"
            decoding="async"
            fetchpriority="high"
            widths={[400, 640, 800]}
            sizes="(min-width: 1024px) 320px, 288px"
            format="webp"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page">
      <div class="max-w-3xl mb-14 reveal">
        <p class="eyebrow mb-3">Functionaliteiten</p>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tightest text-navy text-balance">
          Alles wat Emma voor u doet.
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {[
          'Eigen kennisbank — getraind op uw FAQ, website, documenten',
          'Naadloze handover naar mens bij complexe vragen',
          'Herkent terugkerende klanten en personaliseert antwoord',
          'Meertalig: NL, EN, FR, DE op aanvraag',
          'WhatsApp Business API — officieel geverifieerd',
          'CRM-koppeling: HubSpot, Pipedrive, eigen systeem',
          'Conversatie-analytics en maandrapportage',
          'Escalatie via e-mail, Telegram of interne chat',
          'Afspraken plannen via WhatsApp (Google Calendar koppeling)',
          'GDPR-conform — data binnen de EU',
        ].map((f, i) => (
          <div class={`flex items-start gap-3 p-4 rounded-xl bg-slate-50 border border-slate-100 reveal reveal-delay-${(i % 4) + 1}`}>
            <svg class="w-5 h-5 mt-0.5 flex-shrink-0 text-brand-emerald" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            <span class="text-sm text-slate-700">{f}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Een AI-chatbot bouwen — uitleg -->
  <section class="section border-b border-slate-200">
    <div class="container-page">
      <div class="max-w-3xl reveal">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tightest text-navy mb-4">Een AI-chatbot bouwen voor uw bedrijf — wat houdt het in?</h2>
        <p class="text-slate-600 leading-relaxed mb-4">
          <strong>AI chatbot bouwen</strong> voor uw bedrijf is niet hetzelfde als een simpel FAQ-formulier online zetten. Een moderne <strong>MKB chatbot</strong> zoals Emma begrijpt de intentie achter een vraag, haalt realtime data op uit uw webshop of CRM, en geeft een contextgevoelig antwoord — zonder dat een medewerker daarvoor aanwezig hoeft te zijn.
        </p>
        <p class="text-slate-600 leading-relaxed mb-4">
          Het proces van <strong>chatbot laten maken</strong> bij Aanloop AI verloopt in drie fases. Eerst voeden we de <strong>AI chat-assistent</strong> met uw kennisbank: FAQ-documenten, productcatalogus, leveringsvoorwaarden en eventuele interne procedures. Daarna configureren we de integraties — WhatsApp Business API (officieel Meta-geverifieerd), uw CRM (HubSpot, Pipedrive of eigen systeem) en eventueel uw webshop (Shopify, WooCommerce). Ten slotte doorlopen we twee testrondes waarbij u zelf lastige vragen stelt en op het antwoordgedrag stuurt. Pas daarna gaat de <strong>klantenservice chatbot</strong> live.
        </p>
        <p class="text-slate-600 leading-relaxed mb-4">
          Het resultaat is een productie-grade AI chat-assistent die officieel via WhatsApp Business API werkt, multilingual is (NL/EN/FR/DE standaard), AVG-compliant is met EU-only dataopslag, en zich via een handover-protocol naadloos overdraagt aan een menselijke medewerker bij complexe situaties. Voor webshops koppelen we realtime voorraad- en orderstatus zodat de chatbot altijd actuele informatie geeft — iets wat een klassieke regel-gebaseerde chatbot nooit kan bieden.
        </p>
        <p class="text-slate-600 leading-relaxed mb-4">
          Standaard levert Aanloop AI een volledig ingerichte MKB chatbot binnen 7 werkdagen. De maandelijkse kosten zijn vast en voorspelbaar — geen extra kosten per gesprek of per bericht. Wilt u weten wat een AI-chatbot voor uw specifieke situatie kost?
        </p>
        <a href="/kennisbank/hoeveel-kost-een-ai-agent/" class="inline-flex items-center gap-1.5 text-brand-indigo font-medium hover:underline text-sm">
          Lees: Wat kost een AI-agent of chatbot in Nederland? (volledig kostenoverzicht)
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Sector use cases -->
  <section class="section bg-slate-50/60 border-y border-slate-200">
    <div class="container-page">
      <div class="max-w-3xl mb-14 reveal">
        <p class="eyebrow mb-3">Emma voor uw sector</p>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tightest text-navy text-balance">
          Eén WhatsApp bot, branche-specifieke configuratie.
        </h2>
        <p class="mt-4 text-slate-600 leading-relaxed">
          Emma is geen generieke chatbot. Per sector configureren we andere intents, productdata-koppelingen
          en escalatieregels zodat ze direct waarde levert vanaf dag één.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {sectorUseCases.map((s, i) => (
          <a href={s.slug} class={`card group hover:border-navy transition-colors reveal reveal-delay-${(i % 4) + 1}`}>
            <h3 class="text-lg font-bold text-navy mb-2 group-hover:text-brand-indigo transition-colors">{s.title}</h3>
            <p class="text-sm text-slate-600 leading-relaxed">{s.body}</p>
            <span class="inline-flex items-center gap-1 mt-4 text-sm font-medium text-brand-indigo">
              Meer over {s.title.split(' ')[0].toLowerCase()} →
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Comparison: Emma vs alternatives -->
  <section class="section">
    <div class="container-page">
      <div class="max-w-3xl mb-14 reveal">
        <p class="eyebrow mb-3">Vergelijking</p>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tightest text-navy text-balance">
          Emma vs. live chat, ChatGPT en e-mail support
        </h2>
        <p class="mt-4 text-slate-600 leading-relaxed">
          De meeste MKB-bedrijven zoeken een WhatsApp- of klantcontact-oplossing en kiezen tussen vier opties.
          Hieronder de eerlijke vergelijking — inclusief kostenrange, schaalbaarheid en compliance.
        </p>
      </div>
      <div class="overflow-x-auto reveal">
        <table class="w-full text-sm border-collapse">
          <thead>
            <tr class="border-b border-slate-200 bg-slate-50">
              <th class="text-left py-4 pr-4 pl-3 text-slate-600 font-semibold w-2/5">Functie / kenmerk</th>
              <th class="text-center py-4 px-3 font-bold text-navy bg-brand-indigo/5">Emma (AI)</th>
              <th class="text-center py-4 px-3 font-medium text-slate-600">Live chat</th>
              <th class="text-center py-4 px-3 font-medium text-slate-600">ChatGPT plugin</th>
              <th class="text-center py-4 px-3 font-medium text-slate-600">E-mail support</th>
            </tr>
          </thead>
          <tbody>
            {comparison.map(row => (
              <tr class="border-b border-slate-100">
                <td class="py-3 pr-4 pl-3 text-slate-700">{row.feature}</td>
                <td class="text-center py-3 px-3 bg-brand-indigo/5">
                  {row.emma === true ? (<span class="text-brand-emerald font-bold">✓</span>) : row.emma === false ? (<span class="text-slate-300">—</span>) : (<span class="text-navy font-medium text-xs">{row.emma}</span>)}
                </td>
                <td class="text-center py-3 px-3">
                  {row.livechat === true ? (<span class="text-brand-emerald">✓</span>) : row.livechat === false ? (<span class="text-slate-300">—</span>) : (<span class="text-slate-600 text-xs">{row.livechat}</span>)}
                </td>
                <td class="text-center py-3 px-3">
                  {row.chatgpt === true ? (<span class="text-brand-emerald">✓</span>) : row.chatgpt === false ? (<span class="text-slate-300">—</span>) : (<span class="text-slate-600 text-xs">{row.chatgpt}</span>)}
                </td>
                <td class="text-center py-3 px-3">
                  {row.email === true ? (<span class="text-brand-emerald">✓</span>) : row.email === false ? (<span class="text-slate-300">—</span>) : (<span class="text-slate-600 text-xs">{row.email}</span>)}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Integrations -->
  <section class="section bg-slate-50/60 border-y border-slate-200">
    <div class="container-page">
      <div class="max-w-3xl mb-12 reveal">
        <p class="eyebrow mb-3">Integraties</p>
        <h2 class="text-3xl font-bold tracking-tightest text-navy text-balance">
          Emma werkt met de tools die uw klantcontact al gebruikt.
        </h2>
        <p class="mt-4 text-slate-600 leading-relaxed">
          Native koppelingen voor de populairste Nederlandse e-commerce, CRM en helpdesk-systemen.
          Mist u iets? We bouwen op aanvraag een custom integratie via REST API of webhook.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {Object.entries(integrations).map(([category, tools]) => (
          <div class="card reveal">
            <h3 class="text-sm font-semibold text-slate-500 uppercase tracking-[0.1em] mb-4">{category}</h3>
            <ul class="space-y-2">
              {tools.map(tool => (
                <li class="text-sm text-navy flex items-center gap-2">
                  <svg class="w-3.5 h-3.5 text-brand-emerald flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                  {tool}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container-page">
      <div class="max-w-3xl mb-14 reveal">
        <p class="eyebrow mb-3">Veelgestelde vragen</p>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tightest text-navy text-balance">
          Antwoorden op de 12 meest gestelde vragen over Emma.
        </h2>
      </div>
      <div class="max-w-3xl mx-auto space-y-3">
