---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import emmaWhatsapp from '../../assets/images/emma-whatsapp.png';

const sectorUseCases = [
  { title: 'Webshops & e-commerce', slug: '/sectoren/ai-voor-webshops/', body: 'Emma beantwoordt vragen over voorraad, levertijden, retouren en orderstatus 24/7 — via telefoon én WhatsApp. Gekoppeld aan uw Shopify of WooCommerce winkel zoekt ze realtime in uw bestellingen — minder ticketdruk, hogere conversie.' },
  { title: 'Horeca & restaurants', slug: '/sectoren/horeca/', body: 'Reserveringen, openingstijden, allergeneninformatie en bestellingen via telefoon én WhatsApp. Emma neemt inkomende gesprekken zelf aan, synchroniseert direct met uw reserveringssysteem (Resengo, Formitable, eigen agenda) en verbindt door wanneer nodig — zonder personeel uit de keuken te halen.' },
  { title: 'Vastgoed & makelaars', slug: '/sectoren/vastgoed/', body: 'Inkomende aanvragen via telefoon én WhatsApp worden direct gekwalificeerd: budget, locatie, gewenste woning. Emma stuurt eerste objectvoorstellen en plant bezichtigingen in uw agenda — uw kandidaten landen warm in het CRM.' },
  { title: 'Zakelijke dienstverlening', slug: '/sectoren/zakelijk/', body: 'Voor consultants, accountants en juristen: Emma vangt eerstelijnsvragen op (fees, beschikbaarheid, dossierstatus) aan de telefoon en op WhatsApp, en verbindt door of escaleert naar de juiste collega met volledige gespreksgeschiedenis en transcript.' },
  { title: 'ZZP & freelancers', slug: '/sectoren/ai-voor-zzp/', body: 'Eén ZZP&apos;er, één agenda, vele klanten. Emma neemt telefoon én WhatsApp op terwijl u werkt, plant kennismakingen in en stuurt offertes uit — u beantwoordt alleen wat écht persoonlijke aandacht vraagt.' },
];

const integrations = {
  Telefonie: ['Inkomende telefonie (ElevenLabs NL-stem)', 'Doorverbinden naar team', 'Voicemail & gesprekstranscripts', 'Eigen NL-telefoonnummer of porting'],
  Messaging: ['WhatsApp Business API (Meta)', 'WhatsApp Cloud API', 'Telegram', 'Facebook Messenger', 'Webchat-widget'],
  CRM: ['HubSpot', 'Pipedrive', 'Salesforce', 'Microsoft Dynamics', 'Custom REST API'],
  'E-commerce': ['Shopify', 'WooCommerce', 'Magento 2', 'Lightspeed', 'PrestaShop'],
  Helpdesk: ['Zendesk', 'Freshdesk', 'Intercom', 'Crisp', 'Eigen ticketsysteem'],
};

const comparison = [
  { feature: '24/7 beschikbaar zonder bemensing', emma: true, livechat: 'Tijdens kantooruren', chatgpt: true, email: false },
  { feature: 'Omnichannel: telefoon + WhatsApp + workflow', emma: true, livechat: 'Alleen chat', chatgpt: false, email: false },
  { feature: 'Inkomende telefonie aannemen + doorverbinden', emma: true, livechat: false, chatgpt: false, email: false },
  { feature: 'Officieel WhatsApp Business API geverifieerd', emma: true, livechat: 'Variabel', chatgpt: false, email: false },
  { feature: 'Getraind op eigen kennisbank', emma: true, livechat: false, chatgpt: 'Beperkt', email: false },
  { feature: 'Realtime productdata (voorraad, orders)', emma: true, livechat: 'Handmatig', chatgpt: false, email: false },
  { feature: 'Naadloze handover naar mens', emma: true, livechat: true, chatgpt: false, email: 'Manueel' },
  { feature: 'CRM-koppeling met conversatiehistorie', emma: true, livechat: 'Variabel', chatgpt: false, email: 'Variabel' },
  { feature: 'Maandelijkse kosten (MKB-volume)', emma: 'Vanaf €49 (Lite) / €497 (Omnichannel)', livechat: '€500-2.000', chatgpt: '€20/user', email: 'Personeelskosten' },
  { feature: 'AVG-bewust, EU-only data, DPA mogelijk', emma: true, livechat: 'Variabel', chatgpt: false, email: 'Variabel' },
];

const faqItems = [
  { question: 'Neemt Emma ook echt de telefoon aan?', answer: 'Ja. Emma is uw omnichannel AI-agent: ze neemt inkomende telefoongesprekken 24/7 zelf aan met een natuurlijke NL-stem (ElevenLabs), beantwoordt vragen, plant afspraken in uw agenda, verbindt door naar de juiste collega en levert van elk gesprek een transcript. Daarnaast handelt ze WhatsApp en webchat af en triggert ze workflows — telefoon, chat en automatisering in één agent, op één nummer, met één gespreksgeschiedenis.' },
  { question: 'Heb ik een WhatsApp Business account of telefoonnummer nodig?', answer: 'Niet bij start. Wij regelen de WhatsApp Business API-aanmelding bij Meta (gratis verificatie via een 360dialog of Twilio-partner) én een Nederlands telefoonnummer voor de AI-receptionist — of we porten uw bestaande nummer. U behoudt eigenaarschap van nummer en history. Heeft u al een WhatsApp Business-nummer of vaste lijn, dan koppelt Emma aan uw bestaande nummers.' },
  { question: 'Hoe wordt Emma getraind voor mijn bedrijf?', answer: 'Tijdens onboarding voeden we Emma met uw FAQ-sectie, productcatalogus, leveringsvoorwaarden en eventuele interne documenten — voor zowel telefoon als WhatsApp. We doen twee testrondes met u — u belt en appt met lastige vragen en stuurt op het antwoordgedrag. Pas daarna gaat Emma live.' },
  { question: 'Wat doet Emma bij een vraag die ze niet kan beantwoorden?', answer: 'Emma escaleert volgens uw protocol: aan de telefoon verbindt ze direct door naar een specifiek teamlid, op WhatsApp zet ze het gesprek door, opent ze een ticket in uw helpdesk, plant ze een terugbelafspraak of verwijst ze door naar het juiste kanaal. U bepaalt zelf de escalatie- en doorverbindregels.' },
  { question: 'Wat kost Emma precies?', answer: 'Emma kent drie pakketten, allemaal zonder setup-kosten: Emma Lite €49/mnd (WhatsApp-only AI-assistent, tot 1.000 conversaties). Emma €497/mnd (AI-telefoniste + WhatsApp + workflow-automatisering, tot 150 gesprekken). Groei €997/mnd (onbeperkt volume + WhatsApp + CRM-koppeling + multi-number + priority support — meest gekozen). Emma Enterprise op aanvraag (SLA, dedicated tenant, custom workflows). WhatsApp-conversatiekosten van Meta (gemiddeld €0,03-0,08 per uniek 24-uurs venster) zijn niet inbegrepen — die factureert Meta direct aan u; wij rekenen er geen marge op. Zie /tarieven voor de volledige opbouw.' },
  { question: 'Werkt Emma met mijn bestaande Shopify of WooCommerce?', answer: 'Ja. Voor Shopify, WooCommerce, Magento, Lightspeed en PrestaShop hebben we native koppelingen. Emma kan voorraad, orderstatus, retourstatus en levertijden realtime opzoeken en delen met de klant.' },
  { question: 'Worden gesprekken opgeslagen en hoe lang?', answer: 'Conversaties worden bewaard in EU-datacenters (Amsterdam/Frankfurt) met encryptie at-rest en in-transit. Default bewaartermijn is 90 dagen, configureerbaar tussen 7 en 365 dagen. Voor klanten met aparte compliance-eisen leveren we een dedicated tenant.' },
  { question: 'Kan Emma in meerdere talen tegelijk werken?', answer: 'Ja. Emma detecteert automatisch de taal van de klant (NL, EN, FR, DE standaard; ES, IT, PL op aanvraag) en antwoordt in dezelfde taal. Voor toeristische gebieden of internationale webshops is dit een grote conversie-booster.' },
  { question: 'Wat is het verschil tussen Emma en een gewone ChatGPT-koppeling?', answer: 'Emma is een productie-grade omnichannel agent: inkomende telefonie met NL-stem, officieel Meta-geverifieerde WhatsApp, workflow-automatisering, getrainde kennisbank, CRM-routing, multilingual support, AVG-compliance en handover-protocollen — alles in één agent. Een ChatGPT-koppeling die u zelf bouwt mist deze lagen, kan geen telefoon aannemen en kan na een Meta API-update zomaar offline gaan. Wij zorgen voor uptime en compliance.' },
  { question: 'Hoe snel is Emma live in mijn bedrijf?', answer: 'Standaard 7 werkdagen. Onboarding-vragenlijst (1 uur), kennisbank-import (1 dag), Meta API-verificatie (2-3 dagen), training & testrondes (2 dagen). Bij urgentie kunnen we versnellen naar 3 werkdagen voor een express-fee.' },
  { question: 'Is Emma AVG/GDPR-compliant?', answer: 'Ja. Aanloop AI is een Nederlandse B.V. (KVK 88606902), alle data wordt binnen de EU verwerkt en bewaard, we leveren een verwerkersovereenkomst-template en ondersteunen recht op verwijdering binnen 24 uur. Voor zorg- en juridische klanten leveren we een NEN 7510-compatibele opzet.' },
  { question: 'Kan ik Emma testen voordat ik teken?', answer: 'Ja, gratis. Tijdens een 30-minuten demo laten we Emma uw exacte branche-scenario afhandelen via een testnummer. U mag zelf vragen stellen, lastige edge-cases proberen en sturen op het script. Pas daarna beslist u.' },
  { question: 'Wat als ik Emma wil opzeggen?', answer: 'Maandelijkse opzegtermijn van één maand. Geen exit-fees. Uw telefoonnummer, WhatsApp-nummer en conversatie- en gesprekshistorie blijven uw eigendom — wij leveren een export in JSON of CSV. Bij jaarbetaling krijgt u 16% korting maar bij vroegtijdige opzegging is er geen restitutie.' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Emma — Omnichannel AI-agent (telefoon + WhatsApp + workflow)',
  alternateName: ['AI-receptionist Nederland', 'AI-telefoniste MKB', 'AI WhatsApp agent', 'omnichannel AI-agent', 'AI klantenservice telefoon en WhatsApp Nederland'],
  description: 'Omnichannel AI-agent voor het Nederlandse MKB: neemt 24/7 de telefoon aan (NL-stem, doorverbinden, afspraken inplannen), handelt WhatsApp af en automatiseert workflows — getraind op uw eigen kennisbank, met naadloze handover naar uw team.',
  brand: { '@type': 'Brand', name: 'Aanloop AI' },
  category: 'Omnichannel AI-agent Software (telefoon + WhatsApp + workflow)',
  url: 'https://aanloopai.nl/diensten/emma/',
  audience: { '@type': 'BusinessAudience', audienceType: 'MKB Nederland' },
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'EUR',
    lowPrice: '49',
    highPrice: '997',
    offerCount: '4',
    availability: 'https://schema.org/InStock',
    seller: { '@type': 'Organization', name: 'Aanloop AI', url: 'https://aanloopai.nl' },
  },
};

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Emma — Omnichannel AI-agent (telefoon + WhatsApp + workflow)',
  alternateName: ['AI-receptionist Nederland', 'AI-telefoniste MKB', 'AI WhatsApp agent', 'omnichannel AI-agent', 'AI klantenservice telefoon en WhatsApp'],
  description: 'Cloud-gebaseerde omnichannel AI-agent voor MKB Nederland: neemt 24/7 de telefoon aan (NL-stem, doorverbinden, afspraken inplannen, transcripts), handelt WhatsApp af en automatiseert workflows. Getraind op eigen kennisbank, native koppeling met Shopify/WooCommerce/HubSpot, multilingual auto-detect, EU-only data.',
  url: 'https://aanloopai.nl/diensten/emma/',
  applicationCategory: 'BusinessApplication',
  applicationSubCategory: 'Omnichannel AI-agent (telefoon + WhatsApp + workflow)',
  operatingSystem: 'Cloud (inkomende telefonie + WhatsApp Business API + browser dashboard)',
  inLanguage: ['nl-NL', 'en', 'de', 'fr', 'es', 'it', 'pl'],
  isAccessibleForFree: false,
  creator: { '@type': 'Organization', '@id': 'https://aanloopai.nl/#organization', name: 'Aanloop AI', url: 'https://aanloopai.nl' },
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'EUR',
    lowPrice: '49',
    highPrice: '997',
    offerCount: '4',
    availability: 'https://schema.org/InStock',
  },
  featureList: [
    'Inkomende telefonie 24/7 aannemen met natuurlijke NL-stem (ElevenLabs)',
    'Doorverbinden naar het juiste teamlid + gesprekstranscripts',
    'Afspraken inplannen in uw agenda via telefoon én WhatsApp',
    'WhatsApp Business API officieel Meta-verified',
    'Workflow-automatisering en escalatie volgens uw protocol',
    'Getraind op eigen FAQ + productcatalogus + interne documenten',
    'Realtime productdata via Shopify, WooCommerce, Magento, Lightspeed, PrestaShop',
    'Native CRM-koppeling (HubSpot, Pipedrive, Salesforce, Microsoft Dynamics)',
    'Helpdesk integratie (Zendesk, Freshdesk, Intercom, Crisp)',
    'Multilingual auto-detection (NL/EN/FR/DE standaard, ES/IT/PL op aanvraag)',
    'Naadloze handover naar uw team met conversatie- en gesprekshistorie',
    'AVG-bewust — EU datacenters, encryptie at-rest + in-transit, DPA mogelijk',
    'Conversatie-bewaartermijn configureerbaar (default 90 dagen)',
  ],
  audience: { '@type': 'BusinessAudience', audienceType: 'MKB Nederland' },
};
---

<BaseLayout
  title="Emma — uw omnichannel AI-agent (telefoon + WhatsApp + workflow)"
  description="Emma is uw omnichannel AI-agent: neemt 24/7 de telefoon aan (NL-stem, doorverbinden, afspraken), handelt WhatsApp af en automatiseert workflows. Live in 7 werkdagen, getraind op uw eigen kennisbank."
  schema={[schema, softwareSchema]}
  faqSchema={faqItems}
>
  <section class="border-b border-slate-200 hero-gradient">
    <div class="container-page py-16 lg:py-28">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <span class="eyebrow mb-6 block">Emma — uw omnichannel AI-agent</span>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tightest text-navy text-balance leading-[1.05]">
            Emma — uw omnichannel AI-agent: telefoon + WhatsApp + workflow
          </h1>
          <p class="mt-6 text-lg text-slate-600 leading-relaxed max-w-lg">
            Eén AI-agent voor uw hele klantcontact: Emma neemt 24/7 de telefoon aan (Nederlandse stem, doorverbinden, afspraken inplannen), handelt WhatsApp en webchat af en automatiseert uw workflows. Getraind op uw eigen kennisbank, met naadloze handover naar uw team — live in 7 werkdagen.
          </p>
          <div class="mt-8 flex flex-col sm:flex-row gap-3">
            <a href="/demo-aanvragen/" class="btn-primary text-base px-6 py-3.5">
              Gratis demo boeken
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </a>
            <a href="/tarieven/" class="btn-outline text-base px-6 py-3.5">Bekijk tarieven</a>
          </div>
          <!-- Quick stats -->
          <div class="mt-10 grid grid-cols-3 gap-4">
            <div class="text-center">
              <div class="text-2xl font-bold text-brand-rose">80%</div>
              <div class="text-xs text-slate-500 mt-1">auto beantwoord</div>
            </div>
            <div class="text-center">
              <div class="text-2xl font-bold text-brand-indigo">&lt;5s</div>
              <div class="text-xs text-slate-500 mt-1">reactietijd</div>
            </div>
            <div class="text-center">
              <div class="text-2xl font-bold text-brand-emerald">24/7</div>
              <div class="text-xs text-slate-500 mt-1">beschikbaar</div>
            </div>
          </div>
        </div>
        <!-- WhatsApp mockup -->
        <div class="flex justify-center reveal reveal-delay-2">
          <Image
            src={emmaWhatsapp}
            alt="Emma omnichannel AI-agent — telefoon- en WhatsApp-gesprek voorbeeld"
            class="w-72 lg:w-80 rounded-3xl shadow-2xl border border-slate-200"
            loading="eager"
            decoding="async"
            fetchpriority="high"
            widths={[400, 640, 800]}
            sizes="(min-width: 1024px) 320px, 288px"
            format="webp"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page">
      <div class="max-w-3xl mb-14 reveal">
        <p class="eyebrow mb-3">Functionaliteiten</p>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tightest text-navy text-balance">
          Alles wat Emma voor u doet.
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {[
          'Inkomende telefonie 24/7 aannemen — natuurlijke NL-stem (ElevenLabs)',
          'Doorverbinden naar het juiste teamlid + gesprekstranscripts',
          'WhatsApp Business API — officieel geverifieerd',
          'Workflow-automatisering en escalatie volgens uw protocol',
          'Eigen kennisbank — getraind op uw FAQ, website, documenten',
          'Naadloze handover naar mens bij complexe vragen',
          'Meertalig: NL, EN, FR, DE op aanvraag',
          'CRM-koppeling: HubSpot, Pipedrive, eigen systeem',
          'Afspraken plannen via telefoon én WhatsApp (Google Calendar)',
          'GDPR-conform — data binnen de EU',
        ].map((f, i) => (
          <div class={`flex items-start gap-3 p-4 rounded-xl bg-slate-50 border border-slate-100 reveal reveal-delay-${(i % 4) + 1}`}>
            <svg class="w-5 h-5 mt-0.5 flex-shrink-0 text-brand-emerald" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            <span class="text-sm text-slate-700">{f}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Een AI-chatbot bouwen — uitleg -->
  <section class="section border-b border-slate-200">
    <div class="container-page">
      <div class="max-w-3xl reveal">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tightest text-navy mb-4">Een omnichannel AI-agent voor uw bedrijf — wat houdt het in?</h2>
        <p class="text-slate-600 leading-relaxed mb-4">
          Een <strong>omnichannel AI-agent</strong> opzetten is meer dan een chatbot online zetten. Emma begrijpt de intentie achter een vraag — of die nu binnenkomt via de telefoon, WhatsApp of webchat — haalt realtime data op uit uw webshop of CRM, en geeft een contextgevoelig antwoord. Als <strong>AI-receptionist</strong> neemt ze inkomende gesprekken zelf aan, verbindt door en plant afspraken in, zonder dat een medewerker daarvoor aanwezig hoeft te zijn.
        </p>
        <p class="text-slate-600 leading-relaxed mb-4">
          Het inrichten bij Aanloop AI verloopt in drie fases. Eerst voeden we de <strong>AI-agent</strong> met uw kennisbank: FAQ-documenten, productcatalogus, leveringsvoorwaarden en eventuele interne procedures. Daarna configureren we de kanalen en integraties — inkomende telefonie met Nederlandse stem (ElevenLabs), WhatsApp Business API (officieel Meta-geverifieerd), uw CRM (HubSpot, Pipedrive of eigen systeem) en eventueel uw webshop (Shopify, WooCommerce). Ten slotte doorlopen we twee testrondes waarbij u zelf belt en appt met lastige vragen en op het antwoordgedrag stuurt. Pas daarna gaat de <strong>AI-agent</strong> live.
        </p>
        <p class="text-slate-600 leading-relaxed mb-4">
          Het resultaat is een productie-grade AI-agent die de telefoon aanneemt én via WhatsApp Business API werkt, workflows automatiseert, multilingual is (NL/EN/FR/DE standaard), AVG-compliant is met EU-only dataopslag, en zich via een handover-protocol naadloos overdraagt — doorverbinden aan de telefoon of doorzetten op WhatsApp — bij complexe situaties. Voor webshops koppelen we realtime voorraad- en orderstatus zodat de agent altijd actuele informatie geeft — iets wat een klassieke regel-gebaseerde chatbot nooit kan bieden.
        </p>
        <p class="text-slate-600 leading-relaxed mb-4">
          Standaard levert Aanloop AI een volledig ingerichte omnichannel AI-agent binnen 7 werkdagen. De maandelijkse kosten zijn vast en voorspelbaar, zonder setup-kosten. Wilt u weten wat Emma voor uw specifieke situatie kost?
        </p>
        <a href="/kennisbank/hoeveel-kost-een-ai-agent/" class="inline-flex items-center gap-1.5 text-brand-indigo font-medium hover:underline text-sm">
          Lees: Wat kost een AI-agent of chatbot in Nederland? (volledig kostenoverzicht)
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Sector use cases -->
  <section class="section bg-slate-50/60 border-y border-slate-200">
    <div class="container-page">
      <div class="max-w-3xl mb-14 reveal">
        <p class="eyebrow mb-3">Emma voor uw sector</p>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tightest text-navy text-balance">
          Eén AI-agent, branche-specifieke configuratie.
        </h2>
        <p class="mt-4 text-slate-600 leading-relaxed">
          Emma is geen generieke chatbot. Per sector configureren we andere intents, telefonie- en WhatsApp-flows,
          productdata-koppelingen en escalatieregels zodat ze direct waarde levert vanaf dag één — op elk kanaal.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {sectorUseCases.map((s, i) => (
          <a href={s.slug} class={`card group hover:border-navy transition-colors reveal reveal-delay-${(i % 4) + 1}`}>
            <h3 class="text-lg font-bold text-navy mb-2 group-hover:text-brand-indigo transition-colors">{s.title}</h3>
            <p class="text-sm text-slate-600 leading-relaxed">{s.body}</p>
            <span class="inline-flex items-center gap-1 mt-4 text-sm font-medium text-brand-indigo">
              Meer over {s.title.split(' ')[0].toLowerCase()} →
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Comparison: Emma vs alternatives -->
  <section class="section">
    <div class="container-page">
      <div class="max-w-3xl mb-14 reveal">
        <p class="eyebrow mb-3">Vergelijking</p>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tightest text-navy text-balance">
          Emma vs. live chat, ChatGPT en e-mail support
        </h2>
        <p class="mt-4 text-slate-600 leading-relaxed">
          De meeste MKB-bedrijven zoeken een klantcontact-oplossing en kiezen tussen vier opties. Emma is de enige
          die telefoon, WhatsApp én workflow in één agent combineert. Hieronder de eerlijke vergelijking — inclusief
          kostenrange, schaalbaarheid en compliance.
        </p>
      </div>
      <div class="overflow-x-auto reveal">
        <table class="w-full text-sm border-collapse">
          <thead>
            <tr class="border-b border-slate-200 bg-slate-50">
              <th class="text-left py-4 pr-4 pl-3 text-slate-600 font-semibold w-2/5">Functie / kenmerk</th>
              <th class="text-center py-4 px-3 font-bold text-navy bg-brand-indigo/5">Emma (AI)</th>
              <th class="text-center py-4 px-3 font-medium text-slate-600">Live chat</th>
              <th class="text-center py-4 px-3 font-medium text-slate-600">ChatGPT plugin</th>
              <th class="text-center py-4 px-3 font-medium text-slate-600">E-mail support</th>
            </tr>
          </thead>
          <tbody>
            {comparison.map(row => (
              <tr class="border-b border-slate-100">
                <td class="py-3 pr-4 pl-3 text-slate-700">{row.feature}</td>
                <td class="text-center py-3 px-3 bg-brand-indigo/5">
                  {row.emma === true ? (<span class="text-brand-emerald font-bold">✓</span>) : row.emma === false ? (<span class="text-slate-300">—</span>) : (<span class="text-navy font-medium text-xs">{row.emma}</span>)}
                </td>
                <td class="text-center py-3 px-3">
                  {row.livechat === true ? (<span class="text-brand-emerald">✓</span>) : row.livechat === false ? (<span class="text-slate-300">—</span>) : (<span class="text-slate-600 text-xs">{row.livechat}</span>)}
                </td>
                <td class="text-center py-3 px-3">
