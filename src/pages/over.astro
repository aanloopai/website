---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import officeRotterdam from '../assets/images/office-rotterdam.png';

// ── Kernwaarden ────────────────────────────────────────────────────
const waarden = [
  {
    icon: '💰',
    title: 'Eerlijke, transparante prijzen',
    desc: 'Geen verborgen kosten, geen eindeloze offertetrajecten. Onze tarieven staan op de website — u weet precies wat u betaalt voordat u een handtekening zet.',
  },
  {
    icon: '⚖️',
    title: 'Wft-bewuste adviesgrenzen',
    desc: 'Wij zijn een AI-implementatiebureau, geen gecertificeerd financieel adviseur. Klanten in de financiële sector worden altijd doorverwezen naar een Wft-gecertificeerde partij voor gereguleerd advies. Eerlijkheid stelt vertrouwen.',
  },
  {
    icon: '🇳🇱',
    title: 'NL-only dataverwerking',
    desc: 'Alle klantdata blijft binnen Nederland en de EU. Geen Amerikaanse clouds, geen data doorverkoop. AVG-compliant vanaf dag één, met een DPA voor elke klant.',
  },
  {
    icon: '🔗',
    title: 'Onafhankelijk — geen vendor lock-in',
    desc: 'Wij bouwen op open standaarden en geven u eigenaarschap over uw AI-stack. Als u morgen wilt overstappen, heeft u alle data en documentatie in eigen hand.',
  },
  {
    icon: '🏪',
    title: 'MKB-eerst',
    desc: 'Wij richten ons uitsluitend op het Nederlandse MKB. Geen enterprise-consultancytarieven, geen PowerPoint-strategie zonder implementatie — alleen werkende AI die binnen 14 dagen live staat.',
  },
  {
    icon: '🤖',
    title: 'EU AI Act-bewust',
    desc: 'Wij volgen de EU AI Act op de voet. Klanten in hoog-risico toepassingen (zorg, HR, financiën) worden proactief geïnformeerd over compliance-verplichtingen — ook als dat commercieel ongemakkelijk is.',
  },
];

// ── Bedrijfsfeiten ─────────────────────────────────────────────────
const feiten = [
  { label: 'KvK-nummer', value: '88606902', link: 'https://www.kvk.nl/zoeken/?source=all&q=88606902', linkText: 'Verifieer bij KvK' },
  { label: 'Vestigingsplaats', value: 'Rotterdam, Nederland', link: null, linkText: null },
  // TODO: Vervang "Rotterdam" door volledig straat + huisnummer zodra KvK-registratie bijgewerkt is met fysiek adres
  { label: 'Opgericht', value: '2024', link: null, linkText: null },
  { label: 'Rechtsvorm', value: 'Besloten Vennootschap (B.V.)', link: null, linkText: null },
  { label: 'Sector', value: 'AI-consultancy / IT-dienstverlening', link: null, linkText: null },
  { label: 'Email', value: 'hello@aanloopai.nl', link: 'mailto:hello@aanloopai.nl', linkText: null },
  { label: 'Telefoon', value: '+31 6 24741597', link: 'tel:+31624741597', linkText: null },
  { label: 'Klanten bediend', value: '80+ MKB-bedrijven', link: null, linkText: null },
  { label: 'Sectoren actief', value: 'Zorg, advocatuur, accountancy, bouw, retail, horeca, vastgoed', link: null, linkText: null },
  // TODO: Voeg 2025 jaarresultaten toe zodra beschikbaar (klanttevredenheid NPS, jaaromzet)
];

// ── FAQ ────────────────────────────────────────────────────────────
const faqSchema = [
  { question: 'Waar is Aanloop AI gevestigd?', answer: 'Aanloop AI B.V. is gevestigd in Rotterdam, Nederland. KvK-nummer: 88606902. Alle data wordt verwerkt binnen de EU.' },
  { question: 'Is Aanloop AI een echt bedrijf met een KvK-inschrijving?', answer: 'Ja. Aanloop AI B.V. staat ingeschreven bij de Kamer van Koophandel onder nummer 88606902. U kunt dit zelf verifiëren op kvk.nl.' },
  { question: 'Wie is de oprichter van Aanloop AI?', answer: 'Mustafa Agah Dogan richtte Aanloop AI op in 2023. Hij heeft bijna 20 jaar ervaring in technologie en processautomatisering en begeleidt inmiddels 80+ Nederlandse MKB-bedrijven.' },
  { question: 'Is Aanloop AI AVG-compliant?', answer: 'Ja. Aanloop AI is volledig AVG-compliant. Alle data wordt verwerkt binnen de EU en elke klant ontvangt een Data Processing Agreement (DPA).' },
  { question: 'Wat zijn de adviesgrenzen van Aanloop AI op financieel gebied?', answer: 'Aanloop AI is een AI-implementatiebureau en geen gecertificeerd financieel adviseur. Voor gereguleerd financieel advies verwijzen wij altijd door naar een Wft-gecertificeerde partij.' },
];

// ── Schema ─────────────────────────────────────────────────────────
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': 'https://aanloopai.nl/over-ons/#mustafa-agah-dogan',
  name: 'Mustafa Agah Dogan',
  givenName: 'Mustafa',
  additionalName: 'Agah',
  familyName: 'Dogan',
  jobTitle: 'Oprichter & AI-strateeg',
  description: 'Oprichter en AI-strateeg bij Aanloop AI B.V. Specialiseert zich in AI-implementatie voor het Nederlandse MKB: voice AI, WhatsApp Business, n8n workflow automatisering, ElevenLabs voice AI en custom AI agents. BSc Computer Engineering (2012), 20+ jaar IT-ervaring, voormalig AI-lead Big 4-consultancy.',
  url: 'https://aanloopai.nl/over-ons/',
  image: {
    '@type': 'ImageObject',
    // TODO: vervang door echte profielfoto-URL zodra beschikbaar
    url: 'https://aanloopai.nl/brand/magahdogan.jpg',
    width: 400,
    height: 400,
  },
  alumniOf: {
    '@type': 'EducationalOrganization',
    name: 'BSc Computer Engineering 2012',
  },
  worksFor: {
    '@type': 'Organization',
    '@id': 'https://aanloopai.nl/#organization',
    name: 'Aanloop AI B.V.',
    url: 'https://aanloopai.nl',
  },
  knowsAbout: [
    'AI agents',
    'AI chatbots',
    'AVG compliance',
    'EU AI Act',
    'MKB digitalisering',
    'Cloudflare Workers',
    'Schema.org structured data',
    'Voice AI met ElevenLabs',
    'WhatsApp Business AI',
    'n8n workflow automatisering',
    'LLM integratie',
    'Custom AI workflows',
    'NEN 7510 voor zorgsector',
    'Self-hosted AI-infrastructuur',
  ],
  knowsLanguage: ['nl', 'en', 'tr'],
  nationality: { '@type': 'Country', name: 'Netherlands' },
  sameAs: [
    'https://www.linkedin.com/in/magahdogan/',
    'https://aanloopai.nl/over-ons/',
  ],
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://aanloopai.nl/' },
    { '@type': 'ListItem', position: 2, name: 'Over Aanloop AI', item: 'https://aanloopai.nl/over/' },
  ],
};
---

<BaseLayout
  title="Over Aanloop AI — Oprichtersverhaal, Missie & Bedrijfsfeiten"
  description="Aanloop AI B.V. opgericht door Mustafa Agah Dogan in Rotterdam (KvK: 88606902). Lees het oprichtersverhaal, onze missie en waarom wij MKB-AI anders aanpakken."
  schema={[personSchema, breadcrumbSchema]}
  faqSchema={faqSchema}
>

  <!-- Breadcrumb -->
  <nav class="border-b border-slate-100 bg-white" aria-label="Breadcrumb">
    <div class="container-page py-3">
      <ol class="flex items-center gap-2 text-xs text-slate-500">
        <li><a href="/" class="hover:text-navy transition-colors">Home</a></li>
        <li aria-hidden="true">›</li>
        <li class="text-navy font-medium" aria-current="page">Over Aanloop AI</li>
      </ol>
    </div>
  </nav>

  <!-- Hero — oprichtersverhaal -->
  <section class="relative overflow-hidden hero-gradient border-b border-slate-200">
    <div class="absolute inset-0 -z-10 dot-grid opacity-[0.03]"></div>
    <div class="container-page py-20 lg:py-32">
      <div class="max-w-4xl">
        <span class="eyebrow mb-3">Over ons</span>
        <h1 class="text-4xl sm:text-5xl lg:text-7xl font-bold tracking-tightest text-navy text-balance leading-[1.05] reveal reveal-delay-1">
          Waarom Aanloop AI<br/>
          <span class="text-brand-indigo">bestaat.</span>
        </h1>
        <div class="mt-8 space-y-5 text-lg lg:text-xl text-slate-600 leading-relaxed text-pretty max-w-2xl reveal reveal-delay-2">
          <p>
            In 2023 zag Mustafa Agah Dogan hoe een bevriende MKB-ondernemer — een fysiotherapeut in Rotterdam — elke maand duizenden euro's misliep door gemiste telefoontjes buiten kantoortijden. Hij belde drie AI-bureaus. Twee vroegen om een budget van €50.000+. Eén beloofde een werkende demo en leverde een PowerPoint.
          </p>
          <p>
            Mustafa bouwde de oplossing zelf. Drie maanden later beantwoordde een AI-assistent elke oproep. Dat was het moment waarop hij besefte: de technologie bestaat al, maar toegankelijkheid voor het MKB niet. Aanloop AI is gebouwd om dat gat te sluiten.
          </p>
        </div>
        <div class="mt-10 flex flex-col sm:flex-row gap-4 reveal reveal-delay-3">
          <a href="/demo-aanvragen/" class="btn-primary text-base px-8 py-4">
            Boek een gratis demo →
          </a>
          <a href="/werkwijze/" class="btn-outline text-base px-8 py-4">
            Hoe we werken
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="border-b border-slate-200 bg-white">
    <div class="container-page py-12">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        {[
          { value: '80+', label: 'MKB-klanten', sub: 'Actief in 7 sectoren', color: 'text-brand-indigo' },
          { value: '14 dgn', label: 'Gemiddeld live', sub: 'Van akkoord tot go-live', color: 'text-brand-rose' },
          { value: 'KvK', label: '88606902', sub: 'Verifieerbaar NL B.V.', color: 'text-brand-amber' },
          { value: '100%', label: 'EU-dataverwerking', sub: 'AVG-compliant dag één', color: 'text-brand-emerald' },
        ].map(s => (
          <div class="reveal">
            <div class={`text-4xl font-bold ${s.color} mb-1`}>{s.value}</div>
            <div class="font-semibold text-navy text-sm">{s.label}</div>
            <div class="text-xs text-slate-400 mt-0.5">{s.sub}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Onze missie -->
  <section class="section">
    <div class="container-page">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div class="reveal">
          <span class="eyebrow mb-3">Onze missie</span>
          <h2 class="text-3xl lg:text-4xl font-bold tracking-tightest text-navy mt-2 mb-6">
            AI die werkt voor Nederland — niet voor Silicon Valley.
          </h2>
          <div class="space-y-5 text-slate-600 leading-relaxed">
            <p>
              Het Nederlandse MKB verdient AI die werkt binnen de kaders van de AVG, de EU AI Act en het Nederlandse ondernemersklimaat — niet AI die in Amerikaanse datacenters draait, achter ondoorzichtige contracten verborgen zit, of alleen betaalbaar is voor bedrijven met een IT-afdeling.
            </p>
            <p>
              Wij bouwen uitsluitend met EU-gehoste infrastructuur, hanteren transparante vaste tarieven zonder urenregistratie, en geven elke klant volledige data-eigenaarschap. Vendor lock-in is bewust uitgesloten van ons bedrijfsmodel — want een klant die bij ons blijft, kiest dat zelf.
            </p>
            <p>
              Onze focus: het MKB in Nederland. Niet de Fortune 500, niet de overheid, niet de startup-markt. Eén doelgroep, diep begrepen, goed bediend.
            </p>
            <p class="font-semibold text-navy">
              Aanloop — de stap voorwaarts. Elke dag, voor elke ondernemer die AI wil inzetten zonder onnodig risico of kosten.
            </p>
          </div>
        </div>

        <div class="reveal reveal-delay-2">
          <Image
            src={officeRotterdam}
            alt="Aanloop AI kantoor Rotterdam — Mustafa Agah Dogan aan het werk"
            class="w-full rounded-2xl shadow-xl object-cover"
            loading="lazy"
            decoding="async"
            widths={[480, 800, 1400]}
            sizes="(min-width: 1024px) 700px, 100vw"
            format="webp"
          />
          <p class="text-xs text-slate-400 mt-3 text-center">Rotterdam — thuis van Aanloop AI B.V. (KvK 88606902)</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Oprichter bio -->
  <section class="section bg-slate-50 border-y border-slate-200">
    <div class="container-page">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12 reveal">
          <span class="eyebrow mb-3">Oprichter</span>
          <h2 class="text-3xl lg:text-4xl font-bold tracking-tightest text-navy mt-2">Mustafa Agah Dogan</h2>
          <p class="mt-3 text-slate-500 text-sm">Founder &amp; CEO · Aanloop AI B.V.</p>
        </div>

        <div class="grid lg:grid-cols-3 gap-10 items-start reveal">
          <!-- Foto + contactinfo -->
          <div class="text-center lg:text-left">
            <div class="aspect-square w-48 mx-auto lg:mx-0 bg-gradient-to-br from-navy to-brand-emerald rounded-2xl overflow-hidden ring-2 ring-slate-200 flex items-center justify-center mb-6">
              <!-- TODO: vervang door echte profielfoto src (400×400 webp). Bijv.: <Image src={import('../assets/images/magahdogan.jpg')} alt="Mustafa Agah Dogan, oprichter Aanloop AI" ... /> -->
              <span class="text-5xl font-bold text-white tracking-tight" aria-label="Profielfoto Mustafa Agah Dogan (placeholder)">MA</span>
            </div>
            <div class="space-y-3">
              <a
                href="https://www.linkedin.com/in/magahdogan/"
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-center lg:justify-start gap-2 text-sm text-slate-600 hover:text-brand-indigo transition-colors"
              >
                <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
                LinkedIn profiel
              </a>
              <a href="mailto:magahdogan@aanloopai.nl" class="flex items-center justify-center lg:justify-start gap-2 text-sm text-slate-600 hover:text-brand-indigo transition-colors">
                <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
                magahdogan@aanloopai.nl
              </a>
              <a href="/team/magahdogan/" class="flex items-center justify-center lg:justify-start gap-2 text-sm font-semibold text-navy hover:text-brand-indigo transition-colors">
                Volledig profiel →
              </a>
            </div>
          </div>

          <!-- Bio -->
          <div class="lg:col-span-2 space-y-5 text-slate-600 leading-relaxed">
            <p>
              Mustafa Agah Dogan richtte Aanloop AI B.V. op in 2023 na bijna 20 jaar ervaring in technologie en processautomatisering. Hij werkte met Nederlandse MKB-bedrijven in de zorg, advocatuur, accountancy, bouw en horeca, en zag steeds dezelfde kloof: enterprise-grade AI-technologie was beschikbaar, maar onbetaalbaar en ontoegankelijk voor bedrijven zonder interne IT-capaciteit.
            </p>
            <p>
              Zijn praktische expertise omvat voice AI met ElevenLabs, WhatsApp Business-integraties, n8n self-hosted workflow automatisering en op maat gebouwde AI agents. Hij is goed thuis in de Wft-adviesgrenzen voor financiële AI-toepassingen, AVG-compliance, NEN 7510 voor de zorgsector en de verplichtingen onder de EU AI Act voor hoog-risico toepassingen.
            </p>
            <p>
              Mustafa publiceert regelmatig over AI-implementatie voor het Nederlandse MKB via de kennisbank op aanloopai.nl — artikelen gebaseerd op directe klantdata en implementatiepraktijk, niet op theoretische frameworks.
            </p>

            <div class="flex flex-wrap gap-2 pt-2">
              {[
                'Voice AI', 'ElevenLabs', 'n8n automatisering', 'WhatsApp Business',
                'AVG-compliance', 'EU AI Act', 'Wft-adviesgrenzen', 'Custom AI agents',
                'LLM-integratie', 'Self-hosted AI', 'NEN 7510', 'MKB-implementatie',
              ].map(tag => (
                <span class="text-xs px-2.5 py-1 rounded-full bg-white border border-slate-200 text-slate-600 font-medium">{tag}</span>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Kernwaarden -->
  <section class="section">
    <div class="container-page">
      <div class="text-center mb-14 reveal">
        <span class="eyebrow mb-3">Kernwaarden</span>
        <h2 class="text-3xl lg:text-4xl font-bold tracking-tightest text-navy mt-2">Waar we voor staan.</h2>
        <p class="mt-4 text-slate-600 max-w-xl mx-auto">
          Zes principes die bepalen hoe we adviseren, wat we afspreken en waarom klanten ons vertrouwen.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {waarden.map((w, i) => (
          <div class={`card hover:shadow-lg transition-all reveal reveal-delay-${(i % 4) + 1}`}>
            <div class="text-2xl mb-3" aria-hidden="true">{w.icon}</div>
            <h3 class="font-bold text-navy mb-2">{w.title}</h3>
            <p class="text-sm text-slate-600 leading-relaxed">{w.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Bedrijfsfeiten -->
  <section class="section bg-slate-50 border-y border-slate-200">
    <div class="container-page">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-10 reveal">
          <span class="eyebrow mb-3">Bedrijfsfeiten</span>
          <h2 class="text-3xl lg:text-4xl font-bold tracking-tightest text-navy mt-2">Transparantie als fundament.</h2>
          <p class="mt-4 text-slate-600 max-w-xl mx-auto">
            Verifieerbare gegevens — geen marketingclaims. KvK-nummer, vestigingsplaats en contactgegevens zijn publiek en controleerbaar.
          </p>
        </div>
        <div class="bg-white rounded-2xl border border-slate-200 divide-y divide-slate-100 reveal">
          {feiten.map(f => (
            <div class="flex items-start justify-between gap-4 px-6 py-4">
              <span class="text-sm text-slate-500 font-medium shrink-0 w-44">{f.label}</span>
              <span class="text-sm text-navy font-semibold text-right">
                {f.link ? (
                  <a
                    href={f.link}
                    target={f.link.startsWith('http') ? '_blank' : undefined}
                    rel={f.link.startsWith('http') ? 'noopener noreferrer' : undefined}
                    class="hover:text-brand-indigo transition-colors underline underline-offset-2"
                  >
                    {f.linkText ?? f.value}
                  </a>
                ) : f.value}
                {f.link && f.linkText ? <span class="text-slate-400 ml-2 text-xs font-normal">({f.value})</span> : null}
              </span>
            </div>
          ))}
        </div>
        {/* TODO: Voeg volledig straatadres toe zodra KvK-registratie is bijgewerkt met fysiek kantooradres */}
        <p class="mt-4 text-xs text-slate-400 text-center">
          Volledig straatadres wordt gepubliceerd zodra kantoorregistratie bij KvK is bijgewerkt.
        </p>
      </div>
    </div>
  </section>

  <!-- Werkwijze preview -->
  <section class="section">
    <div class="container-page">
      <div class="max-w-3xl mx-auto text-center reveal">
        <span class="eyebrow mb-3">Onze werkwijze</span>
        <h2 class="text-3xl lg:text-4xl font-bold tracking-tightest text-navy mt-2 mb-6">
          Van gesprek naar werkende AI in 14 dagen.
        </h2>
        <p class="text-slate-600 mb-8 leading-relaxed">
          Geen maandenlange trajecten, geen vage deliverables. U weet van dag één wat we bouwen, wanneer het klaar is en hoe u het meet.
        </p>
        <div class="grid sm:grid-cols-3 gap-4 mb-10 text-left">
          {[
            { stap: '1', title: 'Intake & analyse', desc: 'Gratis 30-minuten gesprek. We begrijpen uw bedrijfsproces voor we iets bouwen.' },
            { stap: '2', title: 'Bouwen & testen', desc: 'AI-assistent gebouwd op uw kennisbank, getest in uw omgeving.' },
            { stap: '3', title: 'Live & monitoren', desc: 'Go-live binnen 14 dagen. Maandelijkse rapportage met ROI-metrics.' },
          ].map(s => (
            <div class="card p-5">
              <div class="text-2xl font-bold text-brand-indigo mb-2">{s.stap}</div>
              <h3 class="font-semibold text-navy text-sm mb-1">{s.title}</h3>
              <p class="text-xs text-slate-500 leading-relaxed">{s.desc}</p>
            </div>
          ))}
        </div>
        <a href="/werkwijze/" class="btn-outline text-base px-8 py-4">
          Bekijk volledige werkwijze →
        </a>
      </div>
    </div>
  </section>

  <!-- Trust & Compliance -->
  <section class="section bg-navy text-white">
    <div class="container-page">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <span class="eyebrow text-brand-indigo mb-3">Vertrouwen &amp; compliance</span>
          <h2 class="text-3xl lg:text-4xl font-bold text-white mt-2 mb-6">
            Gebouwd op vertrouwen. Verifieerbaar bewijs.
          </h2>
          <p class="text-slate-300 leading-relaxed mb-8">
            Enterprise-grade beveiliging voor MKB-prijzen. Elke klant krijgt een Data Processing Agreement, alle data blijft in de EU, en we volgen de AVG en EU AI Act actief op.
          </p>
          <div class="grid grid-cols-2 gap-4">
            {[
              '✅ AVG/GDPR compliant',
              '✅ EU-dataverwerking',
              '✅ DPA beschikbaar',
              '✅ KvK: 88606902',
              '✅ EU AI Act-bewust',
              '✅ Wft-adviesgrenzen gerespecteerd',
            ].map(item => (
              <div class="flex items-center gap-2 text-sm text-slate-300">{item}</div>
            ))}
          </div>
        </div>
