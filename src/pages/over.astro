---
import BaseLayout from '../layouts/BaseLayout.astro';

const teamleden = [
  {
    name: 'Daan Verhoeven',
    role: 'Oprichter & CEO',
    bio: 'Voormalig AI-lead bij een Big 4-consultancy. Bouwde AI-oplossingen voor 40+ enterprise klanten voordat hij Aanloop oprichtte om AI toegankelijk te maken voor het MKB.',
    initials: 'DV',
    color: 'from-brand-indigo to-blue-600',
    linkedin: 'https://linkedin.com/company/aanloopai',
    expertise: ['Strategie', 'Enterprise AI', 'Partnerships'],
  },
  {
    name: 'Sara Hofman',
    role: 'CTO',
    bio: 'AI-engineer met 8 jaar ervaring in conversational AI en NLP. Architecte van het Aanloop AI-platform. Bouwde eerder spraaksystemen voor drie Fortune 500-bedrijven.',
    initials: 'SH',
    color: 'from-brand-rose to-pink-600',
    linkedin: 'https://linkedin.com/company/aanloopai',
    expertise: ['Conversational AI', 'NLP', 'Platform'],
  },
  {
    name: 'Niels Bakker',
    role: 'Head of Customer Success',
    bio: 'Zorgt dat elke klant binnen 7 dagen live is en daarna blijft groeien. Voormalig operations-manager in de horeca — hij begrijpt uw branche van binnenuit.',
    initials: 'NB',
    color: 'from-brand-amber to-orange-500',
    linkedin: 'https://linkedin.com/company/aanloopai',
    expertise: ['Implementatie', 'Horeca', 'Operaties'],
  },
  {
    name: 'Lena de Groot',
    role: 'Lead AI-trainer',
    bio: 'Traint alle AI-assistenten op de kennisbank van de klant. Specialist in spraaktechnologie en AI-persona-ontwikkeling. Promoveerde op menselijk-AI interactie.',
    initials: 'LG',
    color: 'from-brand-emerald to-teal-600',
    linkedin: 'https://linkedin.com/company/aanloopai',
    expertise: ['AI Training', 'Spraaktechnologie', 'UX'],
  },
];

const waarden = [
  {
    icon: '🎯',
    title: 'Eerlijkheid boven hype',
    desc: 'We beloven alleen wat AI aantoonbaar kan leveren. Geen AI-washing, geen overdreven claims — alleen resultaten die u zelf kunt meten in uw dashboard.',
  },
  {
    icon: '⚡',
    title: 'Snelheid = respect',
    desc: 'Uw tijd is waardevol. Wij reageren dezelfde dag, leveren binnen 14 dagen en maken AI direct operationeel. Geen maandenlange trajecten voor een telefonist.',
  },
  {
    icon: '🤝',
    title: 'Partner, niet leverancier',
    desc: 'We zijn er niet alleen bij de go-live. We monitoren, optimaliseren en rapporteren maandelijks. Uw groei is onze groei — we groeien met u mee.',
  },
  {
    icon: '🇳🇱',
    title: 'Gemaakt voor Nederland',
    desc: 'AI die Nederlands spreekt — niet alleen de taal, maar ook de cultuur, het zakendoen, de SIDN-regelgeving, de AVG-eisen en de Nederlandse klantverwachtingen.',
  },
  {
    icon: '🔒',
    title: 'Privacy by design',
    desc: 'Alle data verwerkt binnen de EU. AVG-compliant vanaf dag één. Geen data doorverkoop. Geen Amerikaanse clouds. Uw klantdata blijft in Nederland.',
  },
  {
    icon: '📈',
    title: 'ROI of geen contract',
    desc: 'Als wij niet kunnen aantonen dat onze AI uw bedrijf geld bespaart of omzet verhoogt, betaalt u niet. Zo eenvoudig is ons verdienmodel.',
  },
];

const tijdlijn = [
  { jaar: '2023', event: 'Oprichting', desc: 'Aanloop AI opgericht vanuit de overtuiging dat enterprise AI ook voor het MKB bereikbaar moet zijn.' },
  { jaar: 'Q1 2024', event: 'Eerste 10 klanten', desc: 'Eerste AI-receptionisten live bij horecabedrijven en makelaars in Rotterdam en Den Haag.' },
  { jaar: 'Q3 2024', event: '100 klanten', desc: 'Platform uitgebreid met WhatsApp AI en custom workflow-builder. Eerste enterprise pilot.' },
  { jaar: 'Q1 2025', event: '€2M+ bespaard', desc: 'Klanten samen meer dan €2 miljoen bespaard aan personeels- en proceskosten. 4.9/5 klanttevredenheid.' },
  { jaar: '2025', event: 'Enterprise launch', desc: 'Lancering van Aanloop AI Enterprise met SLA, SSO en dedicated account management.' },
  { jaar: '2026', event: '500+ klanten', desc: 'Actief in 6 sectoren, van zorg tot vastgoed. Klaar voor internationale uitrol.' },
];

const faqSchema = [
  { question: 'Waar is Aanloop AI gevestigd?', answer: 'Aanloop AI is gevestigd in Rotterdam, Nederland. Alle data wordt verwerkt binnen de EU.' },
  { question: 'Hoe groot is het Aanloop AI team?', answer: 'We zijn een team van 10-25 specialisten, inclusief AI-engineers, trainers en customer success managers.' },
  { question: 'Is Aanloop AI AVG-compliant?', answer: 'Ja, Aanloop AI is volledig AVG-compliant. Alle data wordt verwerkt binnen de EU en we beschikken over een Data Processing Agreement (DPA) voor elke klant.' },
];
---

<BaseLayout
  title="Over Aanloop AI — Ons verhaal, team en missie"
  description="Leer Aanloop AI kennen. Opgericht in Rotterdam, actief bij 500+ MKB-bedrijven. Ontdek wie we zijn, wat we geloven en wie er achter Aanloop AI werkt."
  faqSchema={faqSchema}
>
  <!-- Hero -->
  <section class="relative overflow-hidden hero-gradient border-b border-slate-200">
    <div class="absolute inset-0 -z-10 dot-grid opacity-[0.03]"></div>
    <div class="container-page py-20 lg:py-32">
      <div class="max-w-4xl">
        <div class="flex items-center gap-4 mb-8 reveal">
          <div class="accent-band"><span></span><span></span><span></span><span></span></div>
          <span class="eyebrow">Over ons</span>
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-7xl font-bold tracking-tightest text-navy text-balance leading-[1.05] reveal reveal-delay-1">
          AI voor ondernemers,<br/>
          <span class="text-brand-indigo">niet voor enterprises.</span>
        </h1>
        <p class="mt-8 text-lg lg:text-xl text-slate-600 leading-relaxed text-pretty max-w-2xl reveal reveal-delay-2">
          Aanloop AI is opgericht vanuit één overtuiging: de krachtige AI die grote bedrijven al gebruiken,
          moet ook beschikbaar zijn voor de MKB-ondernemer in Rotterdam, Utrecht of Groningen.
          Zonder IT-afdeling. Zonder maandenlang traject. Zonder astronomisch budget.
        </p>
        <div class="mt-10 flex flex-col sm:flex-row gap-4 reveal reveal-delay-3">
          <a href="/contact/?type=demo" class="btn-primary text-base px-8 py-4">
            Boek een gratis demo →
          </a>
          <a href="/werkwijze/" class="btn-outline text-base px-8 py-4">
            Hoe we werken
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="border-b border-slate-200 bg-white">
    <div class="container-page py-12">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        {[
          { value: '500+', label: 'MKB-klanten', sub: 'In 6 sectoren', color: 'text-brand-indigo' },
          { value: '14 dgn', label: 'Gemiddeld live', sub: 'Van akkoord tot go-live', color: 'text-brand-rose' },
          { value: '€2.4M+', label: 'Bespaard', sub: 'Voor onze klanten', color: 'text-brand-amber' },
          { value: '4.9/5', label: 'Klanttevredenheid', sub: 'Gemiddelde score', color: 'text-brand-emerald' },
        ].map(s => (
          <div class="reveal">
            <div class={`text-4xl font-bold ${s.color} mb-1`}>{s.value}</div>
            <div class="font-semibold text-navy text-sm">{s.label}</div>
            <div class="text-xs text-slate-400 mt-0.5">{s.sub}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Missie -->
  <section class="section">
    <div class="container-page">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div class="reveal">
          <span class="eyebrow mb-3">Onze missie</span>
          <h2 class="text-3xl lg:text-4xl font-bold tracking-tightest text-navy mt-2 mb-6">
            Waarom Aanloop AI bestaat.
          </h2>
          <div class="space-y-5 text-slate-600 leading-relaxed">
            <p>
              Het Nederlandse MKB is de ruggengraat van onze economie — goed voor 99% van alle bedrijven
              en 60% van de werkgelegenheid. Maar terwijl grote bedrijven miljoenen investeren in AI,
              worstelen MKB-ondernemers nog steeds met gemiste telefoontjes, overvolle WhatsApp-inboxen
              en handmatige processen die kostbare uren opslokken.
            </p>
            <p>
              Wij geloven dat dit anders kan. Met kant-en-klare AI-assistenten die u dezelfde dag kunt
              inzetten — gebouwd door mensen die zowel AI begrijpen als het dagelijks leven van een
              MKB-ondernemer kennen.
            </p>
            <p class="font-semibold text-navy">
              Aanloop — de stap voorwaarts. Dat is wat AI voor uw bedrijf doet.
            </p>
          </div>
        </div>

        <!-- Timeline -->
        <div class="reveal reveal-delay-2">
          <h3 class="font-bold text-navy mb-6 text-lg">Ons verhaal</h3>
          <div class="relative">
            <div class="absolute left-4 top-0 bottom-0 w-px bg-slate-200"></div>
            <div class="space-y-6">
              {tijdlijn.map((item, i) => (
                <div class="flex gap-6 relative">
                  <div class="w-8 h-8 rounded-full bg-brand-indigo flex-shrink-0 flex items-center justify-center z-10">
                    <div class="w-2 h-2 rounded-full bg-white"></div>
                  </div>
                  <div class="pb-2">
                    <div class="flex items-center gap-2 mb-1">
                      <span class="text-xs font-bold text-brand-indigo uppercase tracking-wide">{item.jaar}</span>
                      <span class="font-semibold text-navy text-sm">{item.event}</span>
                    </div>
                    <p class="text-xs text-slate-500 leading-relaxed">{item.desc}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Waarden -->
  <section class="section bg-slate-50 border-y border-slate-200">
    <div class="container-page">
      <div class="text-center mb-14 reveal">
        <span class="eyebrow mb-3">Onze waarden</span>
        <h2 class="text-3xl lg:text-4xl font-bold tracking-tightest text-navy mt-2">Waar we voor staan.</h2>
        <p class="mt-4 text-slate-600 max-w-xl mx-auto">Zes principes die bepalen hoe we werken, wat we beloven en waarom onze klanten bij ons blijven.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {waarden.map((w, i) => (
          <div class={`card hover:shadow-lg transition-all reveal reveal-delay-${(i % 4) + 1}`}>
            <div class="text-3xl mb-4">{w.icon}</div>
            <h3 class="font-bold text-navy mb-2">{w.title}</h3>
            <p class="text-sm text-slate-600 leading-relaxed">{w.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Team -->
  <section class="section">
    <div class="container-page">
      <div class="text-center mb-14 reveal">
        <span class="eyebrow mb-3">Het team</span>
        <h2 class="text-3xl lg:text-4xl font-bold tracking-tightest text-navy mt-2">De mensen achter Aanloop AI.</h2>
        <p class="mt-4 text-slate-600 max-w-xl mx-auto">Een team van AI-engineers, branchespecialisten en customer success managers — allemaal met één doel.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {teamleden.map((lid, i) => (
          <div class={`card text-center hover:shadow-xl transition-all reveal reveal-delay-${i + 1}`}>
            <div class={`w-20 h-20 bg-gradient-to-br ${lid.color} rounded-2xl flex items-center justify-center text-white font-bold text-2xl mx-auto mb-5`}>
              {lid.initials}
            </div>
            <h3 class="font-bold text-navy text-lg">{lid.name}</h3>
            <p class="text-xs text-brand-indigo font-semibold uppercase tracking-wide mt-1 mb-3">{lid.role}</p>
            <p class="text-xs text-slate-500 leading-relaxed mb-4">{lid.bio}</p>
            <div class="flex flex-wrap gap-1 justify-center mb-4">
              {lid.expertise.map(tag => (
                <span class="text-[10px] px-2 py-0.5 rounded-full bg-slate-100 text-slate-600 font-medium">{tag}</span>
              ))}
            </div>
            <a href={lid.linkedin} target="_blank" rel="noopener noreferrer"
               class="inline-flex items-center gap-1.5 text-xs text-slate-400 hover:text-brand-indigo transition-colors">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
              LinkedIn
            </a>
          </div>
        ))}
      </div>

      <!-- Growing team notice -->
      <div class="mt-10 text-center">
        <div class="inline-flex items-center gap-3 px-6 py-4 rounded-2xl bg-slate-50 border border-slate-200">
          <span class="text-2xl">🚀</span>
          <div class="text-left">
            <div class="font-semibold text-navy text-sm">We groeien snel</div>
            <div class="text-xs text-slate-500">Ons team breidt uit — bekijk onze <a href="/vacatures/" class="text-brand-indigo underline">openstaande vacatures</a></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust & Compliance -->
  <section class="section bg-navy text-white">
    <div class="container-page">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <span class="eyebrow text-brand-indigo mb-3">Vertrouwen & compliance</span>
          <h2 class="text-3xl lg:text-4xl font-bold text-white mt-2 mb-6">
            Gebouwd op een fundament van vertrouwen.
          </h2>
          <p class="text-slate-300 leading-relaxed mb-8">
            Enterprise-grade beveiliging voor MKB-prijzen. Elke klant krijgt een Data Processing Agreement,
            alle data blijft in de EU, en we volgen de AVG tot op de letter.
          </p>
          <div class="grid grid-cols-2 gap-4">
            {[
              '✅ AVG/GDPR compliant',
              '✅ EU dataverwerking',
              '✅ DPA beschikbaar',
              '✅ KvK: 88606902',
              '✅ Rotterdam gevestigd',
              '✅ 24/7 monitoring',
            ].map(item => (
              <div class="flex items-center gap-2 text-sm text-slate-300">{item}</div>
            ))}
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          {[
            { icon: '🏆', title: '4.9/5', sub: 'Klanttevredenheid' },
            { icon: '⚡', title: '14 dgn', sub: 'Gemiddeld live' },
            { icon: '🔒', title: '99.9%', sub: 'Uptime SLA' },
            { icon: '🇳🇱', title: '100%', sub: 'EU dataverwerking' },
          ].map(s => (
            <div class="bg-white/5 border border-white/10 rounded-2xl p-6 text-center">
              <div class="text-3xl mb-2">{s.icon}</div>
              <div class="text-2xl font-bold text-white">{s.title}</div>
              <div class="text-xs text-slate-400 mt-1">{s.sub}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section">
    <div class="container-page">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl lg:text-4xl font-bold text-navy mb-4">Klaar om kennis te maken?</h2>
        <p class="text-slate-600 mb-8">Boek een gratis demo van 30 minuten. We laten u zien wat AI concreet voor uw branche kan doen.</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/contact/?type=demo" class="btn-primary text-base px-8 py-4">
            Boek een gratis demo →
          </a>
          <a href="/contact/?type=contact" class="btn-outline text-base px-8 py-4">
            Stel een vraag
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
