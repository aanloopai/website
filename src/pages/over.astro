---
import BaseLayout from '../layouts/BaseLayout.astro';

const teamleden = [
  {
    name: 'Daan Verhoeven',
    role: 'Oprichter & CEO',
    bio: 'Voormalig AI-lead bij een Big 4-consultancy. Bouwde AI-oplossingen voor 40+ enterprise klanten voordat hij Aanloop oprichtte om AI toegankelijk te maken voor het MKB.',
    initials: 'DV',
    color: 'bg-brand-indigo',
    linkedin: 'https://linkedin.com/',
  },
  {
    name: 'Sara Hofman',
    role: 'CTO',
    bio: 'AI-engineer met 8 jaar ervaring in conversational AI en NLP. Architecte van het Aanloop AI-platform. Spreekt vloeiend Duits, Frans en Python.',
    initials: 'SH',
    color: 'bg-brand-rose',
    linkedin: 'https://linkedin.com/',
  },
  {
    name: 'Niels Bakker',
    role: 'Head of Customer Success',
    bio: 'Zorgt dat elke klant binnen 7 dagen live is en daarna blijft groeien. Voormalig operations-manager in de horeca-sector.',
    initials: 'NB',
    color: 'bg-brand-amber',
    linkedin: 'https://linkedin.com/',
  },
  {
    name: 'Lena de Groot',
    role: 'AI-trainer & Implementatie',
    bio: 'Traint alle AI-assistenten op de kennisbank van de klant en zorgt voor een perfecte stem, toon en inhoud. Spraaktechnologie-specialist.',
    initials: 'LG',
    color: 'bg-brand-emerald',
    linkedin: 'https://linkedin.com/',
  },
];

const waarden = [
  { icon: '🎯', title: 'Eerlijkheid boven hype', desc: 'We beloven alleen wat AI aantoonbaar kan leveren. Geen AI-washing, geen overdreven claims — alleen resultaten die u zelf kunt meten.' },
  { icon: '⚡', title: 'Snelheid = respect', desc: 'Uw tijd is waardevol. Wij reageren snel, leveren snel en maken AI snel operationeel. Geen maandenlange trajecten voor een telefonist.' },
  { icon: '🤝', title: 'Partner, niet leverancier', desc: 'We zijn niet weg na de go-live. We monitoren, optimaliseren en rapporteren maandelijks. Uw succes is ons succes.' },
  { icon: '🇳🇱', title: 'Gemaakt voor Nederland', desc: 'AI die Nederlands spreekt — niet alleen de taal, maar ook de cultuur, het zakendoen, de regelgeving en de AVG-eisen.' },
];
---

<BaseLayout
  title="Over Aanloop AI · Ons verhaal, team en missie"
  description="Leer Aanloop AI kennen. Wie we zijn, waarom we AI toegankelijk willen maken voor het Nederlandse MKB, en wie er achter de schermen werkt."
>
  <!-- Hero -->
  <section class="border-b border-slate-200 hero-gradient">
    <div class="container-page py-16 lg:py-24">
      <div class="max-w-3xl">
        <div class="flex items-center gap-4 mb-6 reveal">
          <div class="accent-band"><span></span><span></span><span></span><span></span></div>
          <span class="eyebrow">Over ons</span>
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tightest text-navy text-balance leading-[1.05] reveal reveal-delay-1">
          AI voor ondernemers, niet voor enterprises.
        </h1>
        <p class="mt-6 text-lg lg:text-xl text-slate-600 leading-relaxed text-pretty max-w-2xl reveal reveal-delay-2">
          Aanloop AI is opgericht vanuit één overtuiging: de krachtige AI die grote bedrijven al gebruiken, moet ook beschikbaar zijn voor de MKB-ondernemer in Rotterdam, Utrecht of Eindhoven. Zonder IT-afdeling, zonder maandenlangs traject, zonder astronomisch budget.
        </p>
      </div>
    </div>
  </section>

  <!-- Mission & numbers -->
  <section class="section">
    <div class="container-page">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div class="reveal">
          <p class="eyebrow mb-3">Onze missie</p>
          <h2 class="text-3xl font-bold tracking-tightest text-navy mb-6">Waarom Aanloop AI bestaat.</h2>
          <div class="space-y-5 text-slate-600 leading-relaxed">
            <p>Het Nederlandse MKB is de ruggengraat van onze economie. Maar terwijl grote bedrijven miljoenen investeren in AI, worstelen MKB-ondernemers nog steeds met gemiste telefoontjes, overvolle WhatsApp-inboxen en handmatige processen die uren kosten.</p>
            <p>Wij geloven dat dit anders kan. Kant-en-klare AI-assistenten die je dezelfde dag in kan zetten, gebouwd door mensen die zowel AI begrijpen als het dagelijks leven van een MKB-ondernemer.</p>
            <p>Aanloop — de stap voorwaarts. Dat is wat AI voor uw bedrijf doet.</p>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4 reveal reveal-delay-2">
          {[
            { value: '500+', label: 'tevreden MKB-klanten', color: 'text-brand-indigo' },
            { value: '14 dgn', label: 'gemiddeld live', color: 'text-brand-rose' },
            { value: '€2.4M', label: 'bespaard voor klanten', color: 'text-brand-amber' },
            { value: '4.9/5', label: 'gemiddelde review', color: 'text-brand-emerald' },
          ].map(s => (
            <div class="card text-center">
              <div class={`text-3xl font-bold ${s.color}`}>{s.value}</div>
              <div class="text-xs text-slate-500 mt-1">{s.label}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="section bg-slate-50/60 border-y border-slate-200">
    <div class="container-page">
      <div class="max-w-3xl mb-14 reveal">
        <p class="eyebrow mb-3">Onze waarden</p>
        <h2 class="text-3xl font-bold tracking-tightest text-navy">Waar we voor staan.</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {waarden.map((w, i) => (
          <div class={`card reveal reveal-delay-${i + 1}`}>
            <div class="text-2xl mb-3">{w.icon}</div>
            <h3 class="font-bold text-navy mb-2">{w.title}</h3>
            <p class="text-sm text-slate-600 leading-relaxed">{w.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Team -->
  <section class="section">
    <div class="container-page">
      <div class="max-w-3xl mb-14 reveal">
        <p class="eyebrow mb-3">Het team</p>
        <h2 class="text-3xl font-bold tracking-tightest text-navy">De mensen achter Aanloop AI.</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {teamleden.map((lid, i) => (
          <div class={`card text-center reveal reveal-delay-${i + 1}`}>
            <div class={`w-16 h-16 ${lid.color} rounded-2xl flex items-center justify-center text-white font-bold text-xl mx-auto mb-4`}>
              {lid.initials}
            </div>
            <h3 class="font-bold text-navy">{lid.name}</h3>
            <p class="text-xs text-brand-indigo font-medium mt-0.5 mb-3">{lid.role}</p>
            <p class="text-xs text-slate-600 leading-relaxed mb-4">{lid.bio}</p>
            <a href={lid.linkedin} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 text-xs text-slate-400 hover:text-navy transition-colors">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              LinkedIn
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Vacatures teaser -->
  <section class="section-tight bg-midnight text-pearl relative overflow-hidden">
    <div class="absolute inset-0 dot-grid opacity-[0.04]"></div>
    <div class="container-page relative">
      <div class="max-w-3xl">
        <h2 class="text-3xl font-bold tracking-tightest text-pearl text-balance reveal">
          Wil jij meehelpen AI toegankelijk te maken?
        </h2>
        <p class="mt-4 text-slate-300 reveal reveal-delay-1">
          We zijn altijd op zoek naar gedreven mensen die ons team willen versterken. Van AI-trainers tot salesmanagers — bekijk onze openstaande vacatures.
        </p>
        <div class="mt-6 flex flex-col sm:flex-row gap-3 reveal reveal-delay-2">
          <a href="/vacatures/" class="btn bg-pearl text-navy hover:bg-white text-base px-6 py-3.5">
            Bekijk openstaande vacatures
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
          <a href="/contact/?type=contact" class="btn border border-slate-700 text-pearl hover:bg-slate-800 text-base px-6 py-3.5">
            Spontaan solliciteren
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
