<script>
  function fmt(n: number): string {
    return '€ ' + Math.round(n).toLocaleString('nl-NL');
  }

  function onSectorChange(): void {
    const sectorEl = document.getElementById('sector') as HTMLSelectElement;
    const opt = sectorEl.options[sectorEl.selectedIndex];
    const cv = parseInt(opt.getAttribute('data-cv') || '1500', 10);
    const sliderEl = document.getElementById('client-value') as HTMLInputElement;
    // Slider min=100, max=10000, step=100 — snap naar dichtsbijzijnde stap.
    const snapped = Math.round(cv / 100) * 100;
    sliderEl.value = String(Math.min(10000, Math.max(100, snapped)));
    updateCalc();
  }

  function updateCalc(): void {
    const calls = parseInt((document.getElementById('calls-per-day') as HTMLInputElement).value);
    const missedPct = parseInt((document.getElementById('missed-pct') as HTMLInputElement).value) / 100;
    const clientValue = parseInt((document.getElementById('client-value') as HTMLInputElement).value);
    const manualHours = parseInt((document.getElementById('manual-hours') as HTMLInputElement).value);
    const hourlyRate = parseInt((document.getElementById('hourly-rate') as HTMLInputElement).value);
    const sectorMult = parseFloat((document.getElementById('sector') as HTMLSelectElement).value);

    // Update display labels
    (document.getElementById('calls-display') as HTMLElement).textContent = `${calls} calls/dag`;
    (document.getElementById('missed-display') as HTMLElement).textContent = `${Math.round(missedPct * 100)}%`;
    (document.getElementById('value-display') as HTMLElement).textContent = `€${clientValue.toLocaleString('nl-NL')}`;
    (document.getElementById('hours-display') as HTMLElement).textContent = `${manualHours} uur/week`;
    (document.getElementById('rate-display') as HTMLElement).textContent = `€${hourlyRate}/uur`;

    // Calculations
    const missedCallsPerDay = calls * missedPct;
    const workDaysPerYear = 250;
    const aiRecoveryRate = 0.68; // AI recovers 68% of missed calls
    const leadConversionRate = 0.15; // 15% of recovered calls convert

    const recoveredLeadsPerYear = missedCallsPerDay * workDaysPerYear * aiRecoveryRate * leadConversionRate;
    const leadsValue = recoveredLeadsPerYear * clientValue * sectorMult;

    const aiTimeSaving = 0.45; // AI handles 45% of manual work
    const timeSavingPerYear = manualHours * 52 * aiTimeSaving * hourlyRate;

    const totalSaving = leadsValue + timeSavingPerYear;

    // Aanbevolen pakket o.b.v. dagvolume — Starter (lt 50) / Groei (50-200) / Partner (gt 200)
    let monthlyPrice: number;
    let tierLabel: string;
    if (calls < 50) {
      monthlyPrice = 597;
      tierLabel = 'Starter pakket (€597/mnd)';
    } else if (calls <= 200) {
      monthlyPrice = 1197;
      tierLabel = 'Groei pakket (€1.197/mnd)';
    } else {
      monthlyPrice = 1497; // Indicatie Partner-tier; finale prijs op aanvraag
      tierLabel = 'Partner pakket (op aanvraag, indicatie €1.497+/mnd)';
    }

    const annualCost = monthlyPrice * 12;
    const netROI = totalSaving - annualCost;
    const paybackMonths = annualCost / (totalSaving / 12);
    const extraAppointmentsPerMonth = (missedCallsPerDay * 30 * aiRecoveryRate * leadConversionRate);

    // FTE-equivalent: 1 FTE bruto + werkgeverslasten ≈ €4.000/mnd (NL CBS gemiddelde 2026)
    const ftePerMonthCost = 4000;
    const fteEquivalent = (totalSaving / 12) / ftePerMonthCost;
    const fteFormatted = fteEquivalent.toFixed(1).replace('.', ',') + ' FTE/mnd';

    // Update results
    (document.getElementById('result-total') as HTMLElement).textContent = fmt(totalSaving);
    (document.getElementById('result-leads') as HTMLElement).textContent = fmt(leadsValue) + '/jaar';
    (document.getElementById('result-time') as HTMLElement).textContent = fmt(timeSavingPerYear) + '/jaar';
    (document.getElementById('result-appointments') as HTMLElement).textContent = Math.round(extraAppointmentsPerMonth) + ' extra afspraken';
    (document.getElementById('result-fte') as HTMLElement).textContent = fteFormatted;
    (document.getElementById('result-roi') as HTMLElement).textContent = fmt(netROI);
    (document.getElementById('result-tier-label') as HTMLElement).textContent = tierLabel;
    (document.getElementById('result-payback') as HTMLElement).textContent =
      paybackMonths < 1 ? '< 1 maand' : `${Math.round(paybackMonths)} maanden`;

    // Sync hidden form inputs voor email-capture (lees-route, geen UI-impact)
    const sectorEl = document.getElementById('sector') as HTMLSelectElement;
    const sectorLabel = sectorEl.options[sectorEl.selectedIndex]?.textContent || '';
    const setHidden = (id: string, val: string): void => {
      const el = document.getElementById(id) as HTMLInputElement | null;
      if (el) el.value = val;
    };
    setHidden('hf-sector', sectorLabel);
    setHidden('hf-calls', String(calls));
    setHidden('hf-missed', `${Math.round(missedPct * 100)}%`);
    setHidden('hf-cv', `€${clientValue.toLocaleString('nl-NL')}`);
    setHidden('hf-hours', `${manualHours} uur/week`);
    setHidden('hf-rate', `€${hourlyRate}/uur`);
    setHidden('hf-saving', fmt(totalSaving) + '/jaar');
    setHidden('hf-tier', tierLabel);
    setHidden('hf-payback', paybackMonths < 1 ? '< 1 maand' : `${Math.round(paybackMonths)} maanden`);
    setHidden('hf-fte', fteFormatted);
    setHidden('hf-roi', fmt(netROI) + '/jaar');
    setHidden('hf-apps', Math.round(extraAppointmentsPerMonth) + '/maand');
  }

  function applyPreset(card: HTMLElement): void {
    const get = (k: string): string => card.getAttribute(`data-${k}`) || '';
    const setSlider = (id: string, val: string): void => {
      const el = document.getElementById(id) as HTMLInputElement | null;
      if (el && val) el.value = val;
    };
    setSlider('calls-per-day', get('calls'));
    setSlider('missed-pct', get('missed'));
    setSlider('client-value', get('cv'));
    setSlider('manual-hours', get('hours'));
    setSlider('hourly-rate', get('rate'));
    const sectorEl = document.getElementById('sector') as HTMLSelectElement | null;
    if (sectorEl) {
      const idx = parseInt(get('sector-idx') || '0', 10);
      if (idx >= 0 && idx < sectorEl.options.length) sectorEl.selectedIndex = idx;
    }
    document.querySelectorAll('.preset-card').forEach(b => {
      b.classList.remove('border-brand-indigo', 'bg-brand-indigo/5', 'ring-2', 'ring-brand-indigo');
    });
    card.classList.add('border-brand-indigo', 'bg-brand-indigo/5', 'ring-2', 'ring-brand-indigo');
    if (typeof navigator !== 'undefined' && navigator.vibrate) navigator.vibrate(15);
    updateCalc();
    // Smooth scroll naar resultaat-kaart op mobile (preset = directe sector-keuze, user wil zien wat het oplevert)
    if (window.innerWidth < 1024) {
      document.getElementById('result-main')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }

  async function downloadPdf(): Promise<void> {
    const btnText = document.getElementById('roi-pdf-btn-text') as HTMLElement;
    const btn = document.getElementById('roi-pdf-btn') as HTMLButtonElement;
    const orig = btnText.textContent || 'Download als PDF';
    btn.disabled = true;
    btnText.textContent = 'PDF wordt gegenereerd…';

    try {
      // jsPDF via CDN ESM — geen npm dependency, geen bundle bloat
      const mod = await import(/* @vite-ignore */ 'https://cdn.jsdelivr.net/npm/jspdf@2.5.2/+esm') as any;
      const jsPDF = mod.jsPDF || mod.default?.jsPDF || mod.default;
      const doc = new jsPDF({ unit: 'mm', format: 'a4' });

      const sectorSel = document.getElementById('sector') as HTMLSelectElement;
      const sectorLabel = sectorSel.options[sectorSel.selectedIndex]?.textContent || '';
      const total = (document.getElementById('result-total') as HTMLElement).textContent || '';
      const tier = (document.getElementById('result-tier-label') as HTMLElement).textContent || '';
      const payback = (document.getElementById('result-payback') as HTMLElement).textContent || '';
      const fte = (document.getElementById('result-fte') as HTMLElement).textContent || '';
      const leads = (document.getElementById('result-leads') as HTMLElement).textContent || '';
      const time = (document.getElementById('result-time') as HTMLElement).textContent || '';
      const apps = (document.getElementById('result-appointments') as HTMLElement).textContent || '';
      const roi = (document.getElementById('result-roi') as HTMLElement).textContent || '';

      const today = new Date().toLocaleDateString('nl-NL', { day: '2-digit', month: 'long', year: 'numeric' });

      // Header
      doc.setFillColor(15, 23, 42); // navy
      doc.rect(0, 0, 210, 35, 'F');
      doc.setTextColor(255, 255, 255);
      doc.setFontSize(18);
      doc.setFont('helvetica', 'bold');
      doc.text('Aanloop AI — ROI Rapport', 15, 18);
      doc.setFontSize(10);
      doc.setFont('helvetica', 'normal');
      doc.text(`Gegenereerd op ${today}  ·  Sector: ${sectorLabel}`, 15, 27);

      // Headline besparing
      doc.setTextColor(15, 23, 42);
      doc.setFontSize(11);
      doc.text('Geschatte jaarlijkse besparing', 15, 50);
      doc.setFontSize(28);
      doc.setFont('helvetica', 'bold');
      doc.text(total, 15, 62);
      doc.setFontSize(10);
      doc.setFont('helvetica', 'normal');
      doc.setTextColor(100, 116, 139);
      doc.text(`Aanbevolen pakket: ${tier}`, 15, 70);

      // Resultaten tabel
      doc.setTextColor(15, 23, 42);
      doc.setFontSize(12);
      doc.setFont('helvetica', 'bold');
      doc.text('Uw resultaten', 15, 90);
      doc.setFont('helvetica', 'normal');
      doc.setFontSize(10);

      const rows: [string, string][] = [
        ['Terugverdientijd', payback],
        ['Teruggewonnen leads', leads],
        ['Tijdsbesparing', time],
        ['Extra afspraken/maand', apps],
        ['FTE-equivalent bespaard', fte],
        ['Netto ROI jaar 1', roi],
      ];
      let y = 100;
      rows.forEach((row, i) => {
        if (i % 2 === 0) {
          doc.setFillColor(248, 250, 252);
          doc.rect(15, y - 5, 180, 8, 'F');
        }
        doc.setTextColor(71, 85, 105);
        doc.text(row[0], 18, y);
        doc.setTextColor(15, 23, 42);
        doc.setFont('helvetica', 'bold');
        doc.text(row[1], 192, y, { align: 'right' });
        doc.setFont('helvetica', 'normal');
        y += 8;
      });

      // CTA
      y += 10;
      doc.setFillColor(79, 70, 229);
      doc.roundedRect(15, y, 180, 14, 2, 2, 'F');
      doc.setTextColor(255, 255, 255);
      doc.setFontSize(11);
      doc.setFont('helvetica', 'bold');
      doc.text('Gratis 30-min AI-scan: aanloopai.nl/gratis-ai-scan/', 105, y + 9, { align: 'center' });

      // Disclaimer
      doc.setTextColor(100, 116, 139);
      doc.setFontSize(8);
      doc.setFont('helvetica', 'normal');
      const disclaimer = 'Berekeningen zijn schattingen op basis van gemiddelden bij 80+ live MKB-implementaties bij Aanloop AI. Werkelijke resultaten kunnen afwijken. Een gratis AI-scan levert een nauwkeurige op-maat berekening.';
      const wrapped = doc.splitTextToSize(disclaimer, 180);
      doc.text(wrapped, 15, y + 25);

      // Footer
      doc.setFontSize(8);
      doc.text('Aanloop AI · hello@aanloopai.nl · aanloopai.nl · KvK 88606902', 105, 285, { align: 'center' });

      const stamp = new Date().toISOString().split('T')[0];
      doc.save(`aanloop-roi-rapport-${stamp}.pdf`);
      if (typeof navigator !== 'undefined' && navigator.vibrate) navigator.vibrate(20);
    } catch (err) {
      console.error('PDF generation failed:', err);
      alert('PDF kon niet gegenereerd worden — probeer opnieuw of gebruik de e-mail optie.');
    } finally {
      btn.disabled = false;
      btnText.textContent = orig;
    }
  }

  // Initialize on load
  document.addEventListener('DOMContentLoaded', () => {
    updateCalc();

    // Preset cards click handlers
    document.querySelectorAll<HTMLElement>('.preset-card').forEach(btn => {
      btn.addEventListener('click', () => applyPreset(btn));
    });

    // PDF download handler
    document.getElementById('roi-pdf-btn')?.addEventListener('click', () => { void downloadPdf(); });

    // Subtle haptic on slider input (mobile only — desktop browsers ignore vibrate)
    document.querySelectorAll<HTMLInputElement>('input[type="range"]').forEach(slider => {
      let last = 0;
      slider.addEventListener('input', () => {
        const now = Date.now();
        if (now - last > 80 && navigator.vibrate) {
          navigator.vibrate(5);
          last = now;
        }
      });
    });

    // Email-capture form submit handler
    const form = document.getElementById('roi-email-form') as HTMLFormElement | null;
    if (!form) return;

    const btn = document.getElementById('roi-email-btn') as HTMLButtonElement;
    const btnText = document.getElementById('roi-email-btn-text') as HTMLElement;
    const msg = document.getElementById('roi-email-msg') as HTMLElement;

    const showMsg = (text: string, kind: 'success' | 'error'): void => {
      msg.textContent = text;
      msg.classList.remove('hidden', 'text-brand-emerald', 'text-red-600');
      msg.classList.add(kind === 'success' ? 'text-brand-emerald' : 'text-red-600');
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // HTML5 validity check (required, email format, consent checkbox)
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      btn.disabled = true;
      btnText.textContent = 'Versturen…';
      msg.classList.add('hidden');

      try {
        const res = await fetch('/api/submit', {
          method: 'POST',
          body: new FormData(form),
        });
        const data = await res.json().catch(() => ({ success: false, message: 'Ongeldig antwoord' }));

        if (res.ok && data.success) {
          showMsg('✓ Rapport onderweg — controleer uw inbox.', 'success');
          form.reset();
        } else {
          showMsg(data.message || 'Versturen mislukt — probeer opnieuw.', 'error');
        }
      } catch {
        showMsg('Netwerkfout — probeer opnieuw.', 'error');
      } finally {
        btn.disabled = false;
        btnText.textContent = 'Stuur rapport per e-mail →';
      }
    });
  });
</script>
