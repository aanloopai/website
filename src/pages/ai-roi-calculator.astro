---
import BaseLayout from '../layouts/BaseLayout.astro';

const toolSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'AI ROI Calculator — Bereken uw besparing met AI automatisering',
  description: 'Gratis online calculator om de ROI van AI automatisering voor uw MKB-bedrijf te berekenen. Bereken hoeveel tijd en geld u bespaart op basis van 80+ live MKB-implementaties bij Aanloop AI.',
  url: 'https://aanloopai.nl/ai-roi-calculator/',
  applicationCategory: 'BusinessApplication',
  applicationSubCategory: 'ROI Calculator',
  operatingSystem: 'All (browser-based)',
  inLanguage: 'nl-NL',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  creator: { '@type': 'Organization', '@id': 'https://aanloopai.nl/#organization', name: 'Aanloop AI', url: 'https://aanloopai.nl' },
  featureList: [
    'Realtime ROI-berekening op 5 inputs',
    'Aanbevolen Aanloop AI pakket op basis van dagvolume',
    'Sector-specifieke multipliers voor 8 branches',
    'FTE-equivalent en terugverdientijd in maanden',
    'Methodologie en sector-benchmarks transparant',
  ],
  // Google Assistant + spraak-zoekassistenten kunnen deze elementen voorlezen
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['#result-total', '#result-tier-label', '#result-payback', '[data-speakable]'],
  },
};

// 1-click preset profielen — zet de 5 sliders + sector dropdown in één keer op realistische defaults
// per sector. Calls / missedPct / clientValue / hours / hourlyRate / sectorIndex (0-based: zakelijk, bouw,
// horeca, vastgoed, logistiek, zorg, accountancy, e-commerce).
const presetProfiles = [
  { id: 'huisarts', label: 'Huisartsenpraktijk', icon: '🩺', calls: 80, missed: 30, cv: 1200, hours: 18, rate: 35, sectorIdx: 5 },
  { id: 'installateur', label: 'Installateur / Loodgieter', icon: '🔧', calls: 35, missed: 35, cv: 3500, hours: 12, rate: 30, sectorIdx: 1 },
  { id: 'notaris', label: 'Notariskantoor', icon: '⚖️', calls: 25, missed: 20, cv: 2800, hours: 15, rate: 45, sectorIdx: 6 },
  { id: 'rijschool', label: 'Rijschool', icon: '🚗', calls: 40, missed: 40, cv: 1800, hours: 14, rate: 25, sectorIdx: 0 },
  { id: 'webshop', label: 'E-commerce / Webshop', icon: '🛒', calls: 50, missed: 25, cv: 180, hours: 20, rate: 25, sectorIdx: 7 },
  { id: 'dierenarts', label: 'Dierenartspraktijk', icon: '🐾', calls: 55, missed: 30, cv: 350, hours: 16, rate: 30, sectorIdx: 5 },
];

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'AI ROI berekenen voor uw MKB in 5 stappen',
  description: 'Stappenplan om de ROI van AI-automatisering voor uw MKB-bedrijf te berekenen via de Aanloop AI ROI calculator. Doorlooptijd circa 60 seconden.',
  totalTime: 'PT1M',
  inLanguage: 'nl-NL',
  step: [
    { '@type': 'HowToStep', position: 1, name: 'Dagvolume inkomende telefoontjes invoeren', text: 'Vul het aantal inkomende telefoongesprekken per werkdag in. Schatting op basis van uw KPN/VoIP-rapportage of grove inschatting van uw team.' },
    { '@type': 'HowToStep', position: 2, name: 'Percentage gemiste of slecht-afgehandelde calls', text: 'Schat hoeveel procent van inkomende calls op dit moment gemist worden of niet goed afgehandeld (geen terugbel, lange wachttijd, geen escalatie).' },
    { '@type': 'HowToStep', position: 3, name: 'Gemiddelde nieuwe klantwaarde invullen', text: 'Vul de gemiddelde lifetime value van een nieuwe klant in. Voor solo-praktijk gebruik gemiddelde jaaromzet per klant; voor MKB jaaromzet/aantal klanten.' },
    { '@type': 'HowToStep', position: 4, name: 'Manuele werkuren en uurtarief invoeren', text: 'Schat hoeveel uur per week uw team besteedt aan repetitieve handmatige taken (administratie, planning, FAQ, follow-ups) en welk uurtarief daarbij hoort.' },
    { '@type': 'HowToStep', position: 5, name: 'Sector kiezen en resultaat aflezen', text: 'Selecteer uw sector — de calculator past sector-multipliers toe en toont uw geschatte jaarlijkse besparing, terugverdientijd, FTE-equivalent en aanbevolen Aanloop AI pakket.' },
  ],
};

const faqItems = [
  { question: 'Hoe nauwkeurig is de AI ROI calculator?', answer: 'De calculator gebruikt gemiddelden gebaseerd op onze implementaties bij 500+ MKB-bedrijven in Nederland. De werkelijke besparing is afhankelijk van uw specifieke situatie. Onze gratis AI scan geeft een nauwkeurig, op maat gemaakt beeld.' },
  { question: 'Hoe snel verdient mijn investering zich terug?', answer: 'Op basis van onze klantdata is de gemiddelde terugverdientijd 2-4 maanden bij het Starter pakket. Bedrijven met meer dan 50 inkomende calls per dag realiseren dit vaak al in de eerste maand.' },
  { question: 'Wat is inbegrepen in de berekende besparing?', answer: 'De calculator rekent met directe kostenbesparingen (minder personeel voor routinetaken), omzetgroei door minder gemiste leads, en tijdsbesparing. Indirecte voordelen zoals hogere klanttevredenheid zijn niet meegenomen.' },
];
---

<BaseLayout
  title="AI ROI Calculator — Bereken uw Besparing met AI Automatisering | Aanloop AI"
  description="Bereken gratis hoeveel tijd en geld uw bedrijf bespaart met AI automatisering. Vul uw situatie in en zie direct uw ROI. Tool door Aanloop AI."
  schema={[toolSchema, howToSchema]}
  faqSchema={faqItems}
>
  <section class="border-b border-slate-200 hero-gradient">
    <div class="container-page py-16 lg:py-20">
      <div class="max-w-3xl">
        <div class="flex items-center gap-4 mb-6 reveal">
          <div class="accent-band"><span></span><span></span><span></span><span></span></div>
          <span class="eyebrow">Gratis Tool · AI ROI Calculator</span>
        </div>
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tightest text-navy text-balance leading-[1.08] reveal reveal-delay-1">
          Hoeveel bespaart<br />AI voor uw bedrijf?
        </h1>
        <p class="mt-6 text-lg text-slate-600 leading-relaxed reveal reveal-delay-2">
          Vul uw huidige situatie in en bereken in 60 seconden uw geschatte jaarlijkse besparing met AI automatisering. Gebaseerd op 500+ MKB-implementaties.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page max-w-5xl mx-auto">

      <!-- Preset profile cards — 1-click sector defaults -->
      <div class="mb-8">
        <p class="text-sm font-semibold text-navy mb-3">Snelstart — kies uw situatie:</p>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2" id="preset-cards">
          {presetProfiles.map(p => (
            <button
              type="button"
              class="preset-card text-left p-3 rounded-xl border border-slate-200 bg-white hover:border-brand-indigo hover:bg-brand-indigo/5 transition-colors focus:outline-none focus:ring-2 focus:ring-brand-indigo"
              data-preset={p.id}
              data-calls={p.calls}
              data-missed={p.missed}
              data-cv={p.cv}
              data-hours={p.hours}
              data-rate={p.rate}
              data-sector-idx={p.sectorIdx}
            >
              <span class="text-xl block mb-1" aria-hidden="true">{p.icon}</span>
              <span class="text-xs font-semibold text-navy leading-tight block">{p.label}</span>
            </button>
          ))}
        </div>
      </div>

      <div class="grid lg:grid-cols-2 gap-10">

        <!-- Calculator Input -->
        <div class="card">
          <h2 class="text-xl font-bold text-navy mb-6">Stap 1 — Uw huidige situatie</h2>

          <div class="space-y-6" id="calc-form">

            <div>
              <label class="block text-sm font-semibold text-navy mb-2">Hoeveel inkomende telefoontjes ontvangt u per dag?</label>
              <input type="range" id="calls-per-day" min="5" max="150" value="30" step="5"
                class="w-full accent-blue-700" oninput="updateCalc()">
              <div class="flex justify-between text-xs text-slate-500 mt-1">
                <span>5</span><span id="calls-display" class="font-bold text-navy">30 calls/dag</span><span>150+</span>
              </div>
            </div>

            <div>
              <label class="block text-sm font-semibold text-navy mb-2">Hoeveel calls worden momenteel gemist of niet goed afgehandeld?</label>
              <input type="range" id="missed-pct" min="5" max="60" value="25" step="5"
                class="w-full accent-blue-700" oninput="updateCalc()">
              <div class="flex justify-between text-xs text-slate-500 mt-1">
                <span>5%</span><span id="missed-display" class="font-bold text-navy">25%</span><span>60%</span>
              </div>
            </div>

            <div>
              <label class="block text-sm font-semibold text-navy mb-2">Wat is de gemiddelde waarde van een nieuwe klant voor u?</label>
              <input type="range" id="client-value" min="100" max="10000" value="1500" step="100"
                class="w-full accent-blue-700" oninput="updateCalc()">
              <div class="flex justify-between text-xs text-slate-500 mt-1">
                <span>€100</span><span id="value-display" class="font-bold text-navy">€1.500</span><span>€10.000</span>
              </div>
            </div>

            <div>
              <label class="block text-sm font-semibold text-navy mb-2">Hoeveel uur per week besteedt uw team aan handmatige, repetitieve taken?</label>
              <input type="range" id="manual-hours" min="2" max="40" value="15" step="1"
                class="w-full accent-blue-700" oninput="updateCalc()">
              <div class="flex justify-between text-xs text-slate-500 mt-1">
                <span>2u</span><span id="hours-display" class="font-bold text-navy">15 uur/week</span><span>40u</span>
              </div>
            </div>

            <div>
              <label class="block text-sm font-semibold text-navy mb-2">Gemiddeld uurtarief van medewerkers die routinetaken uitvoeren</label>
              <input type="range" id="hourly-rate" min="15" max="80" value="30" step="5"
                class="w-full accent-blue-700" oninput="updateCalc()">
              <div class="flex justify-between text-xs text-slate-500 mt-1">
                <span>€15</span><span id="rate-display" class="font-bold text-navy">€30/uur</span><span>€80</span>
              </div>
            </div>

            <div>
              <label class="block text-sm font-semibold text-navy mb-2">Sector</label>
              <select id="sector" class="w-full px-3 py-2 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-brand-indigo focus:outline-none" onchange="onSectorChange()">
                <option value="1.0" data-cv="2500">Zakelijke dienstverlening</option>
                <option value="1.2" data-cv="3500">Bouw & Installatie</option>
                <option value="0.9" data-cv="150">Horeca</option>
                <option value="1.3" data-cv="5000">Vastgoed & Makelaars</option>
                <option value="1.1" data-cv="4000">Logistiek & Transport</option>
                <option value="1.0" data-cv="1200">Zorg & Welzijn</option>
                <option value="1.2" data-cv="2800">Accountancy & Financieel</option>
                <option value="1.1" data-cv="180">E-commerce & Retail</option>
              </select>
              <p class="text-xs text-slate-500 mt-1">Sectorkeuze stelt automatisch een typische klantwaarde in — u kunt de slider daarna handmatig overschrijven.</p>
            </div>

          </div>
        </div>

        <!-- Results -->
        <div class="space-y-4">

          <!-- Main result card (sticky on mobile zodra slider sectie buiten viewport) -->
          <div id="result-main" class="card bg-navy text-pearl relative overflow-hidden lg:static" data-speakable>
            <div class="absolute inset-0 dot-grid opacity-[0.04]"></div>
            <div class="relative">
              <p class="text-xs font-semibold uppercase tracking-widest text-slate-400 mb-2">Geschatte jaarlijkse besparing</p>
              <p id="result-total" class="text-5xl font-bold text-pearl mb-1">€ —</p>
              <p class="text-slate-400 text-sm">Inclusief teruggewonnen leads + tijdsbesparing</p>
              <div class="mt-6 pt-6 border-t border-white/10">
                <p class="text-xs text-slate-400 mb-3">Terugverdientijd bij <span id="result-tier-label">Starter pakket (€597/mnd)</span></p>
                <p id="result-payback" class="text-2xl font-bold text-brand-emerald">— maanden</p>
              </div>
            </div>
          </div>

          <!-- Breakdown -->
          <div class="card">
            <p class="text-sm font-bold text-navy mb-4">Uitsplitsing</p>
            <div class="space-y-3">
              <div class="flex justify-between items-center py-2 border-b border-slate-100">
                <span class="text-sm text-slate-600">💰 Teruggewonnen leads/jaar</span>
                <span id="result-leads" class="text-sm font-bold text-navy">—</span>
              </div>
              <div class="flex justify-between items-center py-2 border-b border-slate-100">
                <span class="text-sm text-slate-600">⏱ Tijdsbesparing/jaar</span>
                <span id="result-time" class="text-sm font-bold text-navy">—</span>
              </div>
              <div class="flex justify-between items-center py-2 border-b border-slate-100">
                <span class="text-sm text-slate-600">📞 Extra afspraken/maand</span>
                <span id="result-appointments" class="text-sm font-bold text-navy">—</span>
              </div>
              <div class="flex justify-between items-center py-2 border-b border-slate-100">
                <span class="text-sm text-slate-600" title="1 FTE bruto + werkgeverslasten ≈ €4.000/maand">👥 FTE-equivalent bespaard</span>
                <span id="result-fte" class="text-sm font-bold text-navy">—</span>
              </div>
              <div class="flex justify-between items-center py-2">
                <span class="text-sm text-slate-600">📈 Netto ROI (jaar 1)</span>
                <span id="result-roi" class="text-sm font-bold text-brand-emerald">—</span>
              </div>
            </div>
          </div>

          <!-- PDF download — direct, geen email vereist -->
          <button
            type="button"
            id="roi-pdf-btn"
            class="w-full flex items-center justify-center gap-2 px-4 py-3 rounded-xl border border-slate-200 bg-white text-sm font-semibold text-navy hover:border-brand-indigo hover:bg-brand-indigo/5 transition-colors focus:outline-none focus:ring-2 focus:ring-brand-indigo"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
            <span id="roi-pdf-btn-text">Download als PDF</span>
          </button>

          <!-- Email-capture: stuur dit rapport naar uzelf -->
          <div class="card border-2 border-brand-emerald/30 bg-brand-emerald/5">
            <div class="flex items-start gap-3 mb-4">
              <div class="w-10 h-10 rounded-xl bg-brand-emerald/15 flex items-center justify-center flex-shrink-0" aria-hidden="true">
                <svg class="w-5 h-5 text-brand-emerald" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              </div>
              <div>
                <p class="font-bold text-navy text-sm mb-1">Stuur dit rapport naar mijn e-mail</p>
                <p class="text-xs text-slate-600">Ontvang uw ROI-berekening + aanbevolen pakket per mail. Geen verplichtingen.</p>
              </div>
            </div>

            <form id="roi-email-form" class="space-y-3" novalidate>
              <input type="hidden" name="form_type" value="roi_calculator" />
              <input type="hidden" name="subject" value="ROI-rapport aanvraag via aanloopai.nl" />
              <input type="hidden" name="source" value="ai-roi-calculator" />
              <!-- Honeypot — bots vullen dit, mensen zien het niet -->
              <input type="text" name="botcheck" tabindex="-1" autocomplete="off"
                style="position:absolute;left:-9999px;opacity:0;height:0;width:0" aria-hidden="true" />

              <!-- Hidden berekening-velden — automatisch gevuld door updateCalc() -->
              <input type="hidden" name="sector" id="hf-sector" value="" />
              <input type="hidden" name="calls_per_day" id="hf-calls" value="" />
              <input type="hidden" name="missed_percentage" id="hf-missed" value="" />
              <input type="hidden" name="client_value" id="hf-cv" value="" />
              <input type="hidden" name="manual_hours_per_week" id="hf-hours" value="" />
              <input type="hidden" name="hourly_rate" id="hf-rate" value="" />
              <input type="hidden" name="annual_saving" id="hf-saving" value="" />
              <input type="hidden" name="recommended_tier" id="hf-tier" value="" />
              <input type="hidden" name="payback_months" id="hf-payback" value="" />
              <input type="hidden" name="fte_equivalent" id="hf-fte" value="" />
              <input type="hidden" name="net_roi_year1" id="hf-roi" value="" />
              <input type="hidden" name="extra_appointments_per_month" id="hf-apps" value="" />

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <input type="text" name="voornaam" required placeholder="Voornaam"
                  class="px-3 py-2 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-brand-emerald focus:outline-none" />
                <input type="email" name="email" required placeholder="E-mailadres"
                  class="px-3 py-2 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-brand-emerald focus:outline-none" />
              </div>

              <label class="flex items-start gap-2 text-xs text-slate-600 leading-relaxed cursor-pointer">
                <input type="checkbox" name="consent" required
                  class="mt-0.5 w-4 h-4 accent-brand-emerald flex-shrink-0" />
                <span>
                  Ik ga akkoord dat Aanloop AI mijn gegevens gebruikt om mij dit ROI-rapport te sturen en eventueel binnen 14 dagen contact op te nemen voor een gratis vervolggesprek. Zie het <a href="/privacy/" class="text-brand-indigo hover:underline">privacybeleid</a>.
                </span>
              </label>

              <button type="submit" id="roi-email-btn"
                class="btn-primary text-sm w-full justify-center bg-brand-emerald hover:bg-brand-emerald/90">
                <span id="roi-email-btn-text">Stuur rapport per e-mail →</span>
              </button>

              <p id="roi-email-msg" class="text-xs text-center hidden" role="status" aria-live="polite"></p>
            </form>
          </div>

          <!-- CTA -->
          <div class="bg-brand-indigo/5 border border-brand-indigo/20 rounded-2xl p-5">
            <p class="font-bold text-navy text-sm mb-1">Wilt u een nauwkeurige berekening op maat?</p>
            <p class="text-xs text-slate-600 mb-4">Onze gratis AI scan (30 min) geeft u een exacte analyse van uw specifieke situatie en besparingspotentieel.</p>
            <a href="/gratis-ai-scan/" class="btn-primary text-sm w-full justify-center">
              Gratis AI Scan aanvragen →
            </a>
          </div>

          <p class="text-xs text-slate-400 text-center">Berekeningen zijn schattingen op basis van gemiddelden bij 500+ MKB-implementaties.<br>Werkelijke resultaten kunnen afwijken.</p>
        </div>
      </div>

      <!-- FAQ -->
      <div class="mt-16 max-w-3xl mx-auto">
        <h2 class="text-2xl font-bold text-navy mb-6">Veelgestelde vragen over AI ROI</h2>
        <div class="space-y-3">
          {faqItems.map(item => (
            <details class="card group">
              <summary class="flex items-center justify-between cursor-pointer list-none">
                <span class="text-sm font-bold text-navy pr-6">{item.question}</span>
                <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
              </summary>
              <p class="mt-4 text-sm text-slate-600 leading-relaxed">{item.answer}</p>
            </details>
          ))}
        </div>
      </div>

      <!-- Sector benchmarks -->
      <div class="mt-16 max-w-5xl mx-auto">
        <h2 class="text-2xl font-bold text-navy mb-2">Sector-benchmarks 2026</h2>
        <p class="text-sm text-slate-600 mb-6">Gemiddelde ROI-multiplier en typische terugverdientijd op basis van 80+ live klanten van Aanloop AI per sector.</p>
        <div class="overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm">
          <table class="w-full text-sm">
            <thead class="bg-slate-50">
              <tr>
                <th class="text-left p-4 font-semibold text-navy">Sector</th>
                <th class="text-left p-4 font-semibold text-navy">ROI-multiplier</th>
                <th class="text-left p-4 font-semibold text-navy">Terugverdientijd</th>
                <th class="text-left p-4 font-semibold text-navy">Aanbevolen pakket</th>
              </tr>
            </thead>
            <tbody>
              <tr><td class="p-4 font-medium text-navy">Rijschool</td><td class="p-4 text-slate-700">25-50x</td><td class="p-4 text-slate-700">3-6 weken</td><td class="p-4 text-slate-700">Groei €1.197 (Emma WhatsApp)</td></tr>
              <tr class="bg-slate-50/40"><td class="p-4 font-medium text-navy">Huisartsenpraktijk</td><td class="p-4 text-slate-700">10-20x</td><td class="p-4 text-slate-700">1-2 maanden</td><td class="p-4 text-slate-700">Groei €1.197 (onbeperkt)</td></tr>
              <tr><td class="p-4 font-medium text-navy">Installatiebedrijf</td><td class="p-4 text-slate-700">5-12x</td><td class="p-4 text-slate-700">2-4 maanden</td><td class="p-4 text-slate-700">Groei €1.197 (Marco + Emma)</td></tr>
              <tr class="bg-slate-50/40"><td class="p-4 font-medium text-navy">Notariskantoor</td><td class="p-4 text-slate-700">8-18x</td><td class="p-4 text-slate-700">2-3 maanden</td><td class="p-4 text-slate-700">Starter €597 (Marco, 150 gesprekken)</td></tr>
              <tr><td class="p-4 font-medium text-navy">Webshop / e-commerce</td><td class="p-4 text-slate-700">6-15x</td><td class="p-4 text-slate-700">1-3 maanden</td><td class="p-4 text-slate-700">Groei €1.197 (Marco + Emma)</td></tr>
              <tr class="bg-slate-50/40"><td class="p-4 font-medium text-navy">Schoonheidssalon / kapper</td><td class="p-4 text-slate-700">8-15x</td><td class="p-4 text-slate-700">1-2 maanden</td><td class="p-4 text-slate-700">Groei €1.197 (Emma WhatsApp)</td></tr>
              <tr><td class="p-4 font-medium text-navy">Dierenartspraktijk</td><td class="p-4 text-slate-700">12-20x</td><td class="p-4 text-slate-700">1-2 maanden</td><td class="p-4 text-slate-700">Groei €1.197 (24/7 spoedlijn)</td></tr>
              <tr class="bg-slate-50/40"><td class="p-4 font-medium text-navy">Restaurant</td><td class="p-4 text-slate-700">4-10x</td><td class="p-4 text-slate-700">2-4 maanden</td><td class="p-4 text-slate-700">Groei €1.197 (reserveringen)</td></tr>
