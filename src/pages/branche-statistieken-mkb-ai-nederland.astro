---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': 'https://aanloopai.nl/branche-statistieken-mkb-ai-nederland/#webpage',
  name: 'AI-statistieken Nederlands MKB 2026',
  description: 'Het ene verifieerbare CBS-cijfer over AI-gebruik door Nederlandse bedrijven, en eerlijk wat wij niet weten: per sector, use case en rendement. Plus hoe u het zelf meet.',
  url: 'https://aanloopai.nl/branche-statistieken-mkb-ai-nederland/',
  inLanguage: 'nl-NL',
  isPartOf: { '@id': 'https://aanloopai.nl/#website' },
  datePublished: '2026-05-02',
  dateModified: '2026-05-02',
};

const datasetJsonUrl = 'https://aanloopai.nl/data/branche-statistieken-mkb-ai.json';
const datasetCitation = 'Bron: Aanloop AI – AI-statistieken Nederlands MKB, aanloopai.nl/branche-statistieken-mkb-ai-nederland/';

const datasetSchema = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  '@id': 'https://aanloopai.nl/branche-statistieken-mkb-ai-nederland/#dataset',
  name: 'AI-gebruik Nederlandse bedrijven - CBS-cijfer en wat we niet weten',
  alternateName: 'AI-statistieken NL MKB 2026',
  description: 'Cijfers over AI-gebruik door Nederlandse bedrijven met een traceerbare primaire bron (bron-URL en letterlijk citaat). Cijfers zonder primaire bron zijn bewust niet opgenomen.',
  url: 'https://aanloopai.nl/branche-statistieken-mkb-ai-nederland/',
  identifier: 'aanloop-ai-mkb-stats-2026',
  inLanguage: 'nl-NL',
  creator: {
    '@type': 'Organization',
    '@id': 'https://aanloopai.nl/#organization',
    name: 'Aanloop AI',
    url: 'https://aanloopai.nl/',
  },
  publisher: { '@id': 'https://aanloopai.nl/#organization' },
  isAccessibleForFree: true,
  license: 'https://creativecommons.org/licenses/by/4.0/',
  datePublished: '2026-05-02',
  dateModified: '2026-05-02',
  version: '2026.05',
  keywords: 'AI adoptie Nederland, CBS AI-gebruik bedrijven, AI statistieken MKB',
  spatialCoverage: { '@type': 'Place', name: 'Nederland', address: { '@type': 'PostalAddress', addressCountry: 'NL' } },
  temporalCoverage: '2025-01/2026-12',
  variableMeasured: [
    { '@type': 'PropertyValue', name: 'AI-gebruik bedrijven met 10 of meer werkzame personen (2024)', unitText: 'percentage van bedrijven', description: 'Aandeel bedrijven met 10 of meer werkzame personen dat in 2024 een of meer AI-technologieën gebruikte (bron: CBS)' },
  ],
  distribution: [
    {
      '@type': 'DataDownload',
      name: 'AI-statistieken NL MKB 2026 (HTML)',
      encodingFormat: 'text/html',
      contentUrl: 'https://aanloopai.nl/branche-statistieken-mkb-ai-nederland/',
    },
    {
      '@type': 'DataDownload',
      name: 'AI-statistieken NL MKB 2026 (JSON, met bron per datapunt)',
      encodingFormat: 'application/json',
      contentUrl: datasetJsonUrl,
    },
  ],
  citation: datasetCitation,
};

const stats = [
  { value: '22,7%', label: 'van de bedrijven met 10 of meer werkzame personen gebruikte in 2024 AI', source: 'CBS' },
];

const nietBekend = [
  { titel: 'AI-gebruik per sector in het MKB', toelichting: 'Wij hebben geen gecontroleerde sectorcijfers voor MKB-bedrijven met minder dan 10 werkzame personen, en publiceren daarom geen tabel.' },
  { titel: 'Populariteit per use case', toelichting: 'Welk aandeel bedrijven een voicebot, WhatsApp-AI of factuurverwerking gebruikt, is bij ons niet gemeten. Eerdere schattingen hebben we verwijderd.' },
  { titel: 'Rendement (ROI) en terugverdientijd', toelichting: 'Een algemeen MKB-gemiddelde bestaat bij ons niet. Het hangt af van uw belvolume, klantwaarde en uurtarief.' },
  { titel: 'Effect op no-shows of afgehandelde klantvragen', toelichting: 'Wij hebben hier geen eigen meting die we als algemene uitkomst durven te presenteren.' },
];

const zelfMeten = [
  { titel: 'Gemiste oproepen', toelichting: 'Tel een week lang hoeveel oproepen u niet aanneemt en hoeveel daarvan terugbellen. Dat is uw nulmeting.' },
  { titel: 'No-shows', toelichting: 'Tel een paar weken het aantal afspraken en het aantal dat niet komt opdagen. Voer daarna een herinnering in en tel opnieuw.' },
  { titel: 'Handmatige uren', toelichting: 'Laat uw team twee weken bijhouden hoeveel tijd naar herhaalwerk gaat. Reken met uw eigen uurtarief.' },
  { titel: 'Rekenvoorbeeld', toelichting: 'Zet uw cijfers in de ROI-calculator. De aannames daarin stelt u zelf in; het resultaat is een voorbeeld, geen voorspelling.' },
];
---

<BaseLayout
  title="AI-statistieken Nederlands MKB — wat we weten"
  description="Het CBS-cijfer over AI-gebruik door Nederlandse bedrijven, met bron. Plus eerlijk welke cijfers wij niet hebben en hoe u effect zelf meet."
  schema={[pageSchema, datasetSchema]}
>
  <section class="section">
    <div class="container-page max-w-4xl">
      <p class="eyebrow text-brand-indigo mb-3">Dataset · gecontroleerd 9 oktober 2026</p>
      <h1 class="text-3xl lg:text-5xl font-bold text-navy tracking-tightest mb-6">AI Statistieken Nederlands MKB 2026</h1>
      <p class="text-lg text-slate-600 leading-relaxed mb-8">
        Op deze pagina staat alleen wat wij kunnen onderbouwen: een CBS-cijfer met bronlink. Cijfers per sector, per use case en over rendement hebben wij niet gecontroleerd, dus noemen we ze niet. Vrij te citeren onder CC-BY 4.0 — vermeld <strong>Aanloop AI</strong> als bron.
      </p>
      <div class="bg-brand-indigo/5 border border-brand-indigo/20 rounded-xl p-5 text-sm text-slate-700">
        <strong>Voor journalisten en onderzoekers:</strong> het CBS-cijfer is vrij te gebruiken met bronvermelding. Voor vragen over onze data: <a href="mailto:pers@aanloopai.nl" class="text-brand-indigo underline">pers@aanloopai.nl</a>.
      </div>
    </div>
  </section>

  <section class="section bg-slate-50/60 border-y border-slate-200">
    <div class="container-page max-w-5xl">
      <h2 class="text-2xl lg:text-3xl font-bold text-navy mb-8">Het ene cijfer met bron</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {stats.map((s) => (
          <div class="card p-6 bg-white">
            <div class="text-3xl lg:text-4xl font-bold text-brand-indigo mb-2">{s.value}</div>
            <p class="text-sm text-slate-700 leading-snug mb-3">{s.label}</p>
            <p class="text-xs text-slate-500">Bron: <a href="https://www.cbs.nl/nl-nl/nieuws/2025/09/gebruik-kunstmatige-intelligentie--ai---door-bedrijven-neemt-toe" class="text-brand-indigo underline" rel="noopener">{s.source}</a></p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page max-w-5xl">
      <h2 class="text-2xl lg:text-3xl font-bold text-navy mb-3">Wat we (nog) niet weten</h2>
      <p class="text-slate-600 mb-8 text-sm">Eerdere versies van deze pagina noemden sector-, use-case- en rendementscijfers. Die hadden geen primaire bron en zijn verwijderd.</p>
      <div class="grid sm:grid-cols-2 gap-4">
        {nietBekend.map((n) => (
          <div class="card p-6 bg-white">
            <p class="font-semibold text-navy mb-2">{n.titel}</p>
            <p class="text-sm text-slate-600 leading-relaxed">{n.toelichting}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-slate-50/60 border-y border-slate-200">
    <div class="container-page max-w-5xl">
      <h2 class="text-2xl lg:text-3xl font-bold text-navy mb-8">Hoe meet u het zelf?</h2>
      <div class="grid sm:grid-cols-2 gap-4">
        {zelfMeten.map((n) => (
          <div class="card p-6 bg-white">
            <p class="font-semibold text-navy mb-2">{n.titel}</p>
            <p class="text-sm text-slate-600 leading-relaxed">{n.toelichting}</p>
          </div>
        ))}
      </div>
      <p class="mt-6 text-sm"><a href="/ai-roi-calculator/" class="text-brand-indigo underline">Naar de ROI-calculator →</a></p>
    </div>
  </section>

  <section class="section bg-slate-50/60 border-y border-slate-200">
    <div class="container-page max-w-3xl">
      <h2 class="text-2xl lg:text-3xl font-bold text-navy mb-6">Methodologie</h2>
      <div class="space-y-4 text-slate-600 text-sm leading-relaxed">
        <p><strong class="text-navy">Alleen primaire bronnen:</strong> een cijfer komt alleen op deze pagina en in de JSON als het een bron-URL, een letterlijk citaat en een leesdatum heeft.</p>
        <p><strong class="text-navy">CBS:</strong> persbericht over het gebruik van kunstmatige intelligentie door bedrijven (2025). Het cijfer geldt voor bedrijven met 10 of meer werkzame personen, niet voor het hele MKB.</p>
        <p><strong class="text-navy">Geen eigen schattingen:</strong> wat wij niet kunnen onderbouwen, publiceren we niet.</p>
      </div>
    </div>
  </section>

  <section class="section-tight border-t border-slate-200">
    <div class="container-page max-w-3xl">
      <div class="card p-6 bg-white border border-slate-200 text-sm text-slate-700 leading-relaxed">
        <p><strong class="text-navy">Data downloaden (JSON):</strong> <a href={datasetJsonUrl} class="text-brand-indigo underline">branche-statistieken-mkb-ai.json</a> (CC BY 4.0). Bevat alleen cijfers met bron-URL en letterlijk citaat.</p>
        <p class="mt-2"><strong class="text-navy">Citeren als:</strong> {datasetCitation}</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page max-w-3xl text-center">
      <h2 class="text-2xl lg:text-3xl font-bold text-navy mb-4">Vragen over deze data?</h2>
      <p class="text-slate-600 mb-8">Stuur ons een bericht als u de bron wilt controleren of een correctie heeft.</p>
      <div class="flex flex-wrap justify-center gap-3">
        <a href="mailto:pers@aanloopai.nl" class="btn-primary">pers@aanloopai.nl</a>
        <a href="/pers/" class="btn-outline">Pers &amp; media</a>
      </div>
    </div>
  </section>
</BaseLayout>
