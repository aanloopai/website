---
import BaseLayout from '../../layouts/BaseLayout.astro';
const city = 'Enschede';
const region = 'Overijssel';
const lat = '52.2215';
const lon = '6.8937';
const localSchema = {
  '@context': 'https://schema.org', '@type': 'LocalBusiness',
  name: `Aanloop AI — AI Agency ${city}`,
  url: `https://aanloopai.nl/locaties/${city.toLowerCase()}/`,
  image: 'https://aanloopai.nl/logo-mark-light-1024.png',
  address: { '@type': 'PostalAddress', addressLocality: city, addressRegion: region, addressCountry: 'NL' },
  geo: { '@type': 'GeoCoordinates', latitude: lat, longitude: lon },
  areaServed: { '@type': 'City', name: city },
  openingHoursSpecification: { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '09:00', closes: '17:00' },
  priceRange: '€€',
  telephone: '+31624741597',
  email: 'hello@aanloopai.nl',
};
const faqItems = [
  { question: `Werkt Aanloop AI ook voor bedrijven in ${city}?`, answer: `Ja. Aanloop AI (KVK: 88606902, Rotterdam) bedient bedrijven in heel Nederland, inclusief ${city} en de regio ${region}. Alle trajecten verlopen remote — snel en efficiënt.` },
  { question: `Welke AI-oplossingen zijn populair bij bedrijven in ${city}?`, answer: `In ${city} zien we veel vraag naar AI-telefoonassistent (24/7 bereikbaar), WhatsApp automatisering en workflow automation via n8n. Onze gratis AI scan bepaalt wat het beste bij uw situatie past.` },
  { question: `Hoe snel kan Aanloop AI starten voor een bedrijf in ${city}?`, answer: 'Direct na de gratis AI scan (remote, 30 minuten) plannen we de implementatie. Standaard live binnen 7 werkdagen.' },
  { question: `Biedt Aanloop AI een gratis AI scan aan voor ${city}?`, answer: `Ja, de gratis AI scan is beschikbaar voor alle Nederlandse bedrijven, inclusief ${city}. Volledig remote via videocall.` },
];
---
<BaseLayout
  title="AI Agency Enschede — AI Bureau & Automatisering MKB"
  description="AI bureau Enschede: Aanloop AI helpt het MKB met AI-agents en automatisering. AI agency Enschede — gratis AI-scan, live in 7 werkdagen."
  schema={localSchema}
  faqSchema={faqItems}
>
  <section class="border-b border-slate-200 hero-gradient">
    <div class="container-page py-16 lg:py-20">
      <div class="max-w-3xl">
        <div class="flex items-center gap-4 mb-6"><div class="accent-band"><span></span><span></span><span></span><span></span></div><span class="eyebrow">Locatie · {city} · {region}</span></div>
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tightest text-navy text-balance leading-[1.08] reveal reveal-delay-1">AI Agency {city}:<br/>AI Automatisering voor MKB</h1>
        <p class="mt-6 text-lg text-slate-600 leading-relaxed reveal reveal-delay-2">Aanloop AI helpt MKB-bedrijven in {city} en omgeving met AI automatisering, voice AI en workflow oplossingen. Geen technische kennis vereist — wij regelen alles.</p>
        <div class="mt-8 flex flex-col sm:flex-row gap-3 reveal reveal-delay-3">
          <a href="/gratis-ai-scan/" class="btn-primary">Gratis AI Scan voor {city}<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></a>
          <a href="/ai-roi-calculator/" class="btn-outline">Bereken uw ROI</a>
        </div>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container-page max-w-4xl mx-auto">
      <div class="mb-10">
        <h2 class="text-2xl font-bold text-navy">AI voor {city}se Bedrijven</h2>
        <p class="mt-3 text-slate-600">Of u nu een klein installatiebedrijf of een groeiende dienstverlener bent in {city} — AI automatisering helpt u meer te doen met minder mensen en lagere kosten.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-12">
        {[
          { icon: '📞', title: 'AI Receptionist', desc: 'Telefoon 24/7 beantwoorden, afspraken inplannen en leads doorsturen.', link: '/diensten/emma/' },
          { icon: '💬', title: 'WhatsApp AI', desc: 'Klantvragen automatisch beantwoorden via WhatsApp. Direct en professioneel.', link: '/diensten/emma/' },
          { icon: '⚙️', title: 'Workflow Automation', desc: 'n8n workflows voor facturatie, e-mail, rapportages en meer.', link: '/diensten/custom/' },
        ].map(s => (
          <div class="card reveal">
            <div class="text-2xl mb-3" aria-hidden="true">{s.icon}</div>
            <h3 class="font-bold text-navy text-sm mb-2">{s.title}</h3>
            <p class="text-xs text-slate-600 mb-4">{s.desc}</p>
            <a href={s.link} class="text-xs font-medium text-brand-indigo hover:underline">AI in Enschede bekijken →</a>
          </div>
        ))}
      </div>
      <div class="bg-brand-indigo/5 border border-brand-indigo/20 rounded-2xl p-6 mb-8">
        <p class="font-bold text-navy mb-2">Bereken uw besparing</p>
        <p class="text-sm text-slate-600 mb-4">Gebruik onze gratis ROI calculator om te zien hoeveel tijd en geld AI u bespaart.</p>
        <a href="/ai-roi-calculator/" class="btn-primary text-sm">ROI Calculator openen →</a>
      </div>
      <h2 class="text-2xl font-bold text-navy mb-6">Veelgestelde Vragen — AI Agency {city}</h2>
      <div class="space-y-3 mb-8">
        {faqItems.map(item => (
          <details class="card group">
            <summary class="flex items-center justify-between cursor-pointer list-none">
              <span class="text-sm font-bold text-navy pr-6">{item.question}</span>
              <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <p class="mt-4 text-sm text-slate-600 leading-relaxed">{item.answer}</p>
          </details>
        ))}
      </div>
      <div class="bg-slate-50 border border-slate-200 rounded-xl p-6">
        <p class="text-sm font-bold text-navy mb-3">Andere steden</p>
        <div class="flex flex-wrap gap-3 text-sm">
          <a href="/locaties/rotterdam/" class="text-brand-indigo hover:underline">Rotterdam</a>
          <a href="/locaties/amsterdam/" class="text-brand-indigo hover:underline">Amsterdam</a>
          <a href="/locaties/den-haag/" class="text-brand-indigo hover:underline">Den Haag</a>
          <a href="/locaties/utrecht/" class="text-brand-indigo hover:underline">Utrecht</a>
          <a href="/locaties/eindhoven/" class="text-brand-indigo hover:underline">Eindhoven</a>
          <a href="/locaties/groningen/" class="text-brand-indigo hover:underline">Groningen</a>
          <a href="/locaties/tilburg/" class="text-brand-indigo hover:underline">Tilburg</a>
          <a href="/locaties/breda/" class="text-brand-indigo hover:underline">Breda</a>
        </div>
      </div>
    </div>
  </section>
  <section class="section-tight bg-slate-50/60 border-t border-slate-200">
    <div class="container-page max-w-4xl">
      <p class="eyebrow text-brand-indigo mb-2">Kennisbank</p>
      <h2 class="text-2xl font-bold text-navy mb-6">Verdiepende AI-gidsen</h2>
      <div class="grid sm:grid-cols-2 gap-3">
        <a href="/kennisbank/wat-is-een-ai-agent/" class="card p-4 hover:shadow-md transition-all bg-white"><p class="text-xs text-brand-indigo mb-1">Gids</p><p class="text-sm font-semibold text-navy">Wat is een AI agent? Complete gids</p></a>
        <a href="/kennisbank/ai-roi-berekenen-mkb-nederland-2026/" class="card p-4 hover:shadow-md transition-all bg-white"><p class="text-xs text-brand-indigo mb-1">Gids</p><p class="text-sm font-semibold text-navy">AI ROI berekenen voor MKB 2026</p></a>
        <a href="/kennisbank/ai-implementatie-stappen-mkb-nederland/" class="card p-4 hover:shadow-md transition-all bg-white"><p class="text-xs text-brand-indigo mb-1">Gids</p><p class="text-sm font-semibold text-navy">AI implementatie in 7 stappen</p></a>
        <a href="/kennisbank/ai-avg-gdpr-compliance-mkb-nederland/" class="card p-4 hover:shadow-md transition-all bg-white"><p class="text-xs text-brand-indigo mb-1">Gids</p><p class="text-sm font-semibold text-navy">AI en AVG-compliance voor MKB</p></a>
      </div>
    </div>
  </section>


  <section class="section bg-slate-50 border-y border-slate-200">
    <div class="container-page max-w-4xl">
      <p class="eyebrow text-brand-indigo mb-2">Website + AI = 1 partner</p>
      <h2 class="text-2xl lg:text-3xl font-bold text-navy mb-4">Enschedees MKB kiest één partner voor website én AI</h2>
      <p class="text-slate-600 mb-8 leading-relaxed">Veel Enschedese bedrijven (UT-spinouts, maakindustrie) hebben verouderde websites van lokale webbureaus, en sluiten daarnaast losse AI-leveranciers aan. Bij Aanloop AI is dat één traject: AI-ready website + Emma (telefoon + WhatsApp) in één pakket — bespaart op jaarbasis t.o.v. losse leveranciers, met één contract en één aanspreekpunt.</p>
      <div class="grid md:grid-cols-3 gap-4">
        <a href="/diensten/ai-website-bundel-mkb-nederland/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">AI-Website Bundel</h3>
          <p class="text-xs text-slate-600 mb-3">Website + Emma in 1 pakket. Vanaf €649/mnd all-in — setup op aanvraag. Eén factuur, één SLA.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk bundel →</span>
        </a>
        <a href="/diensten/website-laten-maken-mkb-nederland-2026/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">Website laten maken</h3>
          <p class="text-xs text-slate-600 mb-3">Astro/Next/WordPress AI-ready. Schema.org + Speakable + WCAG 2.2 AA + Core Web Vitals groen.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk pakketten →</span>
        </a>
        <a href="/cases/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">Combo-cases bekijken</h3>
          <p class="text-xs text-slate-600 mb-3">5 branche-scenarios met Website + AI bundel: detailhandel, zorg, horeca, advocatuur, accountancy.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk cases →</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section-tight bg-midnight text-pearl relative overflow-hidden">
    <div class="absolute inset-0 dot-grid opacity-[0.04]"></div>
    <div class="container-page relative max-w-3xl">
      <h2 class="text-3xl font-bold tracking-tightest text-pearl text-balance reveal">Bedrijf in {city}? Start gratis.</h2>
      <p class="mt-4 text-slate-300 reveal reveal-delay-1">Gratis AI scan van 30 minuten. We laten u zien wat AI concreet oplevert voor uw bedrijf in {city}.</p>
      <div class="mt-6 flex flex-col sm:flex-row gap-3 reveal reveal-delay-2">
        <a href="/gratis-ai-scan/" class="btn bg-pearl text-navy hover:bg-white text-base px-6 py-3.5">Gratis AI Scan<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></a>
        <a href="/tarieven/" class="btn border border-slate-700 text-pearl hover:bg-slate-800 text-base px-6 py-3.5">Bekijk tarieven</a>
      </div>
    </div>
  </section>
</BaseLayout>
