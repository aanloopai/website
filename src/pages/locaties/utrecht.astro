---
import BaseLayout from '../../layouts/BaseLayout.astro';
const faqItems = [
  { question: 'Is Aanloop AI actief in Utrecht?', answer: 'Ja. Aanloop AI bedient klanten in Utrecht en de provincie Utrecht. We werken remote en on-site voor klanten in de regio.' },
  { question: 'Welke sectoren bedient Aanloop AI in Utrecht?', answer: 'In Utrecht zijn zakelijke dienstverlening, zorg & welzijn, makelaars, horeca en technologiebedrijven onze voornaamste klantgroepen.' },
  { question: 'Hoe kan Aanloop AI helpen bij Utrechtse zorgorganisaties?', answer: 'Aanloop AI heeft AVG-compliant AI-oplossingen voor zorginstellingen: afsprakenbeheer, patiëntcommunicatie en administratie-automatisering. Data blijft uitsluitend in Nederland via n8n self-hosted.' },
  { question: 'Wat kost een AI agent voor een Utrechts bedrijf?', answer: 'Onze prijzen zijn landelijk gelijk: Emma €497/maand, Groei €997/maand, Enterprise op maat. Geen regiopremie.' },
  { question: 'Is Aanloop AI beschikbaar voor persoonlijke afspraken in Utrecht?', answer: 'Ja, we plannen graag een persoonlijk gesprek in Utrecht. Neem contact op via hello@aanloopai.nl of plan direct een gratis AI scan.' },
];
const localSchema = { '@context': 'https://schema.org', '@type': 'LocalBusiness', name: 'Aanloop AI — AI Agency Utrecht', url: 'https://aanloopai.nl/locaties/utrecht/', address: { '@type': 'PostalAddress', addressLocality: 'Utrecht', addressRegion: 'Utrecht', addressCountry: 'NL' }, geo: { '@type': 'GeoCoordinates', latitude: '52.0907', longitude: '5.1214' }, areaServed: { '@type': 'City', name: 'Utrecht' }, telephone: '+31624741597', openingHoursSpecification: { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '09:00', closes: '17:00' }, priceRange: '€€' };
---
<BaseLayout title="AI Agency Utrecht — AI Bureau & Automatisering MKB" description="AI bureau Utrecht: Aanloop AI helpt het MKB met AI-agents en automatisering. AI agency Utrecht — gratis AI-scan, live in 7 werkdagen." schema={localSchema} faqSchema={faqItems}>
  <section class="border-b border-slate-200 hero-gradient">
    <div class="container-page py-16 lg:py-20">
      <div class="max-w-3xl">
        <div class="flex items-center gap-4 mb-6"><div class="accent-band"><span></span><span></span><span></span><span></span></div><span class="eyebrow">Locatie · Utrecht</span></div>
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tightest text-navy text-balance leading-[1.08] reveal reveal-delay-1">AI Agency Utrecht:<br/>AI Agents & Automation voor Utrechtse Bedrijven</h1>
        <p class="mt-6 text-lg text-slate-600 leading-relaxed reveal reveal-delay-2">Aanloop AI helpt Utrechtse MKB-bedrijven, zorgorganisaties en zakelijke dienstverleners met AI agents en workflow automation. Transparant geprijsd, AVG-compliant.</p>
        <div class="mt-8 flex flex-col sm:flex-row gap-3 reveal reveal-delay-3">
          <a href="/gratis-ai-scan/" class="btn-primary">Gratis AI Scan voor Utrecht<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></a>
          <a href="/tarieven/" class="btn-outline">Bekijk prijzen</a>
        </div>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container-page max-w-4xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 mb-12">
        {[
          { icon: '💊', sector: 'Zorg Utrecht', desc: 'AVG-compliant AI voor zorgafspraken en patiëntcommunicatie.', link: '/sectoren/zorg/' },
          { icon: '🏠', sector: 'Makelaars Utrecht', desc: 'AI receptionist voor bezichtigingen, 24/7 bereikbaar.', link: '/sectoren/vastgoed/' },
          { icon: '💼', sector: 'Zakelijke Dienstverlening', desc: 'Workflow automation voor consultants en dienstverleners.', link: '/diensten/custom/' },
          { icon: '🍽️', sector: 'Horeca Utrecht', desc: 'WhatsApp AI voor reserveringen en klantenservice.', link: '/sectoren/horeca/' },
          { icon: '📊', sector: 'Accountants Utrecht', desc: 'AI factuurverwerking, 85% tijdsbesparing.', link: '/sectoren/accountancy/' },
          { icon: '💻', sector: 'Tech Startups Utrecht', desc: 'Schaalbare AI-workflows voor snel groeiende technologiebedrijven.', link: '/diensten/custom/' },
        ].map(s => (
          <div class="card reveal">
            <div class="text-2xl mb-3">{s.icon}</div>
            <h3 class="font-bold text-navy text-sm mb-2">{s.sector}</h3>
            <p class="text-xs text-slate-600 mb-4">{s.desc}</p>
            <a href={s.link} class="text-xs font-medium text-brand-indigo hover:underline">AI in Utrecht bekijken →</a>
          </div>
        ))}
      </div>
      <h2 class="text-2xl font-bold text-navy mb-6">Veelgestelde Vragen — AI Agency Utrecht</h2>
      <div class="space-y-3 mb-8">
        {faqItems.map(item => (
          <details class="card group">
            <summary class="flex items-center justify-between cursor-pointer list-none">
              <span class="text-sm font-bold text-navy pr-6">{item.question}</span>
              <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <p class="mt-4 text-sm text-slate-600 leading-relaxed">{item.answer}</p>
          </details>
        ))}
      </div>
      <div class="bg-slate-50 border border-slate-200 rounded-xl p-6">
        <p class="text-sm font-bold text-navy mb-3">Andere locaties</p>
        <div class="flex flex-wrap gap-3">
          <a href="/locaties/amsterdam/" class="text-sm text-brand-indigo hover:underline">AI Agency Amsterdam →</a>
          <a href="/locaties/rotterdam/" class="text-sm text-brand-indigo hover:underline">AI Agency Rotterdam →</a>
          <a href="/locaties/den-haag/" class="text-sm text-brand-indigo hover:underline">AI Agency Den Haag →</a>
        </div>
      </div>
    </div>
  </section>
  <section class="section-tight bg-slate-50/60 border-t border-slate-200">
    <div class="container-page max-w-4xl">
      <p class="eyebrow text-brand-indigo mb-2">Kennisbank</p>
      <h2 class="text-2xl font-bold text-navy mb-6">Verdiepende AI-gidsen</h2>
      <div class="grid sm:grid-cols-2 gap-3">
        <a href="/kennisbank/wat-is-een-ai-agent/" class="card p-4 hover:shadow-md transition-all bg-white"><p class="text-xs text-brand-indigo mb-1">Gids</p><p class="text-sm font-semibold text-navy">Wat is een AI agent? Complete gids</p></a>
        <a href="/kennisbank/ai-roi-berekenen-mkb-nederland-2026/" class="card p-4 hover:shadow-md transition-all bg-white"><p class="text-xs text-brand-indigo mb-1">Gids</p><p class="text-sm font-semibold text-navy">AI ROI berekenen voor MKB 2026</p></a>
        <a href="/kennisbank/ai-implementatie-stappen-mkb-nederland/" class="card p-4 hover:shadow-md transition-all bg-white"><p class="text-xs text-brand-indigo mb-1">Gids</p><p class="text-sm font-semibold text-navy">AI implementatie in 7 stappen</p></a>
        <a href="/kennisbank/ai-avg-gdpr-compliance-mkb-nederland/" class="card p-4 hover:shadow-md transition-all bg-white"><p class="text-xs text-brand-indigo mb-1">Gids</p><p class="text-sm font-semibold text-navy">AI en AVG-compliance voor MKB</p></a>
      </div>
    </div>
  </section>


  <section class="section bg-slate-50 border-y border-slate-200">
    <div class="container-page max-w-4xl">
      <p class="eyebrow text-brand-indigo mb-2">Website + AI = 1 partner</p>
      <h2 class="text-2xl lg:text-3xl font-bold text-navy mb-4">Utrechtse MKB kiest één partner voor website én AI</h2>
      <p class="text-slate-600 mb-8 leading-relaxed">Veel Utrechtse bedrijven hebben verouderde websites van lokale webbureaus, en sluiten daarnaast losse AI-leveranciers aan. Bij Aanloop AI is dat één traject: AI-ready website + Emma (telefoon + WhatsApp) in één pakket — bespaart op jaarbasis t.o.v. losse leveranciers, met één contract en één aanspreekpunt.</p>
      <div class="grid md:grid-cols-3 gap-4">
        <a href="/diensten/ai-website-bundel-mkb-nederland/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">AI-Website Bundel</h3>
          <p class="text-xs text-slate-600 mb-3">Website + Emma in 1 pakket. Vanaf €649/mnd all-in — setup op aanvraag. Eén factuur, één SLA.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk bundel →</span>
        </a>
        <a href="/diensten/website-laten-maken-mkb-nederland-2026/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">Website laten maken</h3>
          <p class="text-xs text-slate-600 mb-3">Astro/Next/WordPress AI-ready. Schema.org + Speakable + WCAG 2.2 AA + Core Web Vitals groen.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk pakketten →</span>
        </a>
        <a href="/cases/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">Combo-cases bekijken</h3>
          <p class="text-xs text-slate-600 mb-3">5 branche-scenarios met Website + AI bundel: detailhandel, zorg, horeca, advocatuur, accountancy.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk cases →</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section-tight bg-midnight text-pearl relative overflow-hidden">
    <div class="absolute inset-0 dot-grid opacity-[0.04]"></div>
    <div class="container-page relative max-w-3xl">
      <h2 class="text-3xl font-bold tracking-tightest text-pearl text-balance reveal">Bent u een Utrechts bedrijf?</h2>
      <p class="mt-4 text-slate-300 reveal reveal-delay-1">Plan een gratis AI scan en ontdek hoe AI uw Utrechts bedrijf kan versterken. Remote of on-site mogelijk.</p>
      <div class="mt-6 flex flex-col sm:flex-row gap-3 reveal reveal-delay-2">
        <a href="/gratis-ai-scan/" class="btn bg-pearl text-navy hover:bg-white text-base px-6 py-3.5">Gratis AI Scan aanvragen<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></a>
        <a href="/tarieven/" class="btn border border-slate-700 text-pearl hover:bg-slate-800 text-base px-6 py-3.5">Bekijk AI prijzen</a>
      </div>
    </div>
  </section>
</BaseLayout>
