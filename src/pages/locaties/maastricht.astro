---
import BaseLayout from '../../layouts/BaseLayout.astro';
const city = "Maastricht";
const region = "Limburg";
const localSchema = {
  '@context': 'https://schema.org', '@type': 'LocalBusiness',
  name: 'Aanloop AI — AI Agency Maastricht',
  url: 'https://aanloopai.nl/locaties/maastricht/',
  image: 'https://aanloopai.nl/logo-mark-light-1024.png',
  address: { '@type': 'PostalAddress', addressLocality: 'Maastricht', addressRegion: 'Limburg', addressCountry: 'NL', postalCode: '6200-6229' },
  geo: { '@type': 'GeoCoordinates', latitude: '50.8514', longitude: '5.6909' },
  areaServed: { '@type': 'City', name: 'Maastricht' },
  priceRange: '€€',
  telephone: '+31624741597',
  email: 'hello@aanloopai.nl',
  openingHoursSpecification: { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '09:00', closes: '17:00' },
  sameAs: ['https://aanloopai.nl/'],
  author: { '@type': 'Person', '@id': 'https://aanloopai.nl/team/daan-verhoeven/#person', name: 'Daan Verhoeven' },
};
const faqItems = [
  { question: 'Werkt Aanloop AI ook voor bedrijven in Maastricht?', answer: 'Ja. Aanloop AI (KVK: 88606902, Rotterdam) bedient MKB in Maastricht, Heuvelland en de regio Zuid-Limburg. Implementaties verlopen volledig remote — geen reistijd, geen vertraging. Voor strategische sessies rijden wij desgewenst naar Maastricht (circa 2 uur 15 vanaf Rotterdam).' },
  { question: 'Welke Maastrichtse sectoren zijn populair voor AI-implementatie?', answer: 'In Maastricht zien we sterke vraag uit de medische sector (rond MUMC+ en Universiteit Maastricht), juridische dienstverlening, hospitality (Vrijthof, Stokstraat) en internationale studenten-services. Ook grensoverschrijdende logistiek (België/Duitsland) is een groeiniche.' },
  { question: 'Is data verwerking AVG-compliant voor Limburgse bedrijven?', answer: 'Ja. Wij verwerken uitsluitend EU-data via Europese cloud-providers met AVG-conform Data Processing Agreement. Voor medische klanten in Maastricht (LUMC-stijl praktijken) leveren we extra DPIA-documentatie.' },
  { question: 'Hoe snel kan een AI-agent live zijn in Maastricht?', answer: 'Standaard 7 werkdagen na intake — identiek aan ons Rotterdamse hoofdkantoor-tempo. De gratis AI scan duurt 30 minuten en gebeurt remote via videocall.' },
  { question: 'Bedient Aanloop AI ook drietalige praktijken in Maastricht?', answer: 'Ja. Onze voice-AI ondersteunt Nederlands, Engels en Duits — relevant voor Maastrichtse bedrijven met Belgisch-Duitse grensklanten en internationale studenten van Universiteit Maastricht.' },
];
---
<BaseLayout
  title="AI Agency Maastricht — AI Agents en Automatisering voor MKB"
  description="Aanloop AI helpt MKB in Maastricht en Zuid-Limburg met AI agents, voice AI en workflow automation. Drietalig (NL/EN/DE), AVG-compliant, live in 7 werkdagen."
  schema={localSchema}
  faqSchema={faqItems}
>
  <section class="border-b border-slate-200 hero-gradient">
    <div class="container-page py-16 lg:py-20">
      <div class="max-w-3xl">
        <div class="flex items-center gap-4 mb-6"><div class="accent-band"><span></span><span></span><span></span><span></span></div><span class="eyebrow">Locatie - {city} - {region}</span></div>
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tightest text-navy text-balance leading-[1.08] reveal reveal-delay-1">AI Agency {city}:<br/>AI Automatisering voor Limburgs MKB</h1>
        <p class="mt-6 text-lg text-slate-600 leading-relaxed reveal reveal-delay-2">Aanloop AI bedient MKB-bedrijven in {city} en de Heuvelland-regio met AI agents, voice AI en workflow automation. Drietalige ondersteuning (Nederlands, Engels, Duits) voor de internationaal georiënteerde Maastrichtse markt.</p>
        <div class="mt-8 flex flex-col sm:flex-row gap-3 reveal reveal-delay-3">
          <a href="/gratis-ai-scan/" class="btn-primary">Gratis AI Scan voor {city}<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></a>
          <a href="/prijzen/" class="btn-outline">Bekijk prijzen</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page max-w-4xl mx-auto">
      <div class="mb-10 reveal">
        <h2 class="text-2xl font-bold text-navy">AI voor Maastrichtse bedrijven</h2>
        <p class="mt-3 text-slate-600">Maastricht is uniek: hoofdstad van Limburg, thuisbasis van Universiteit Maastricht en Maastricht UMC+, knooppunt voor grensoverschrijdende handel met België en Duitsland, en hot-spot voor toerisme rond het Vrijthof. Het MKB-landschap weerspiegelt die diversiteit — medische praktijken, advocatenkantoren, hotels en restaurants, internationale dienstverleners en grensoverschrijdende logistiek. Onze AI-implementaties spelen direct in op die meertalige, multinationale realiteit.</p>
        <p class="mt-3 text-slate-600">Postcoderegio 6200-6229 (Maastricht-centrum tot Heer en Amby) ligt binnen ons standaard servicegebied. Implementatie verloopt remote via videocall en gedeelde n8n-omgeving — geen reistijd nodig. Voor strategische workshops rijden wij vanaf Rotterdam naar Maastricht (circa 2 uur 15 minuten via A2/A79) wanneer dat waarde toevoegt.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 mb-12">
        {[
          { title: 'Medisch & Zorg Maastricht', desc: 'Voice-AI voor huisartsenpraktijken en specialisten rond MUMC+. Drietalige triage, AVG-compliant intake.', link: '/sectoren/zorg/' },
          { title: 'Advocatenkantoren Maastricht', desc: 'AI-intake voor cliëntdossiers, automatische contractanalyse en agendabeheer.', link: '/sectoren/ai-voor-advocaten/' },
          { title: 'Hotels & Hospitality', desc: 'WhatsApp AI voor reserveringen rond het Vrijthof en de Stokstraat. Meertalig, 24/7 bereikbaar.', link: '/sectoren/horeca/' },
          { title: 'Grensoverschrijdende Logistiek', desc: 'Workflow automation voor BE/DE-routes, douaneformulieren en orderverwerking.', link: '/sectoren/logistiek/' },
          { title: 'Accountants Maastricht', desc: 'AI-document agent voor factuurverwerking. Bespaar tot 85% tijd op administratie.', link: '/sectoren/accountancy/' },
          { title: 'Internationale Dienstverleners', desc: 'AI-receptionist met meertalige flow voor expat-services rond Universiteit Maastricht.', link: '/diensten/marco/' },
        ].map(s => (
          <div class="card reveal">
            <h3 class="font-bold text-navy text-sm mb-2">{s.title}</h3>
            <p class="text-xs text-slate-600 mb-4">{s.desc}</p>
            <a href={s.link} class="text-xs font-medium text-brand-indigo hover:underline">AI in {city} bekijken →</a>
          </div>
        ))}
      </div>

      <div class="bg-slate-50 border border-slate-200 rounded-2xl p-8 mb-12 reveal">
        <h3 class="text-xl font-bold text-navy mb-4">Wij rijden naar Maastricht</h3>
        <p class="text-sm text-slate-600 mb-3">Standaard werken wij remote — vanaf onze basis in Rotterdam implementeren we uw AI-agent zonder dat u reistijd kwijt bent. Voor strategische workshops, kick-off sessies of complexe integratietrajecten rijden wij naar Maastricht. Reistijd via A2/A79 is circa 2 uur 15 minuten.</p>
        <p class="text-sm text-slate-600">Heuvelland (Valkenburg, Gulpen, Vaals) en Maastrichtse randgemeenten (Eijsden-Margraten, Meerssen) vallen onder hetzelfde servicegebied.</p>
      </div>

      <div class="bg-brand-indigo/5 border border-brand-indigo/20 rounded-2xl p-6 mb-10 reveal">
        <p class="font-bold text-navy mb-2">Lokale AI use cases — Maastricht</p>
        <ul class="text-sm text-slate-600 space-y-2 mt-3">
          <li><strong>Huisartsenpraktijk Heuvelland:</strong> drietalige voice-AI vangt 70% van standaardvragen op, vrijgeeft 14 uur assistentencapaciteit per week.</li>
          <li><strong>Advocatenkantoor Vrijthof:</strong> AI-document agent classificeert binnenkomende stukken automatisch, scheelt 8 uur administratie per week.</li>
          <li><strong>Restaurant Stokstraat:</strong> WhatsApp-reserveringsbot met automatische bevestiging en herinnering, 90% no-show reductie.</li>
          <li><strong>Logistiek bedrijf Beatrixhaven:</strong> n8n-workflow voor douane-aangiftes BE/DE, orderdoorlooptijd 60% korter.</li>
        </ul>
      </div>

      <h2 class="text-2xl font-bold text-navy mb-6">Veelgestelde Vragen — AI Agency {city}</h2>
      <div class="space-y-3 mb-8">
        {faqItems.map(item => (
          <details class="card group">
            <summary class="flex items-center justify-between cursor-pointer list-none">
              <span class="text-sm font-bold text-navy pr-6">{item.question}</span>
              <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <p class="mt-4 text-sm text-slate-600 leading-relaxed">{item.answer}</p>
          </details>
        ))}
      </div>

      <div class="bg-slate-50 border border-slate-200 rounded-xl p-6">
        <p class="text-sm font-bold text-navy mb-3">Andere locaties</p>
        <div class="flex flex-wrap gap-3 text-sm">
          <a href="/locaties/heerlen/" class="text-brand-indigo hover:underline">Heerlen</a>
          <a href="/locaties/sittard-geleen/" class="text-brand-indigo hover:underline">Sittard-Geleen</a>
          <a href="/locaties/venlo/" class="text-brand-indigo hover:underline">Venlo</a>
          <a href="/locaties/eindhoven/" class="text-brand-indigo hover:underline">Eindhoven</a>
          <a href="/locaties/den-bosch/" class="text-brand-indigo hover:underline">Den Bosch</a>
          <a href="/locaties/rotterdam/" class="text-brand-indigo hover:underline">Rotterdam</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-slate-50 border-y border-slate-200">
    <div class="container-page max-w-4xl">
      <p class="eyebrow text-brand-indigo mb-2">Website + AI = 1 partner</p>
      <h2 class="text-2xl lg:text-3xl font-bold text-navy mb-4">Maastrichtse MKB kiest één partner voor website én AI</h2>
      <p class="text-slate-600 mb-8 leading-relaxed">Veel Maastrichtse bedrijven (drietalig: NL/EN/DE-FR) hebben verouderde websites van lokale webbureaus, en sluiten daarnaast losse AI-leveranciers aan. Bij Aanloop AI is dat één traject: AI-ready website + Marco (telefoon) + Emma (WhatsApp) in één pakket — bespaart €8.014 jaar 1 t.o.v. losse leveranciers, met één contract en één aanspreekpunt.</p>
      <div class="grid md:grid-cols-3 gap-4">
        <a href="/diensten/ai-website-bundel-mkb-nederland/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">AI-Website Bundel</h3>
          <p class="text-xs text-slate-600 mb-3">Website + Marco + Emma in 1 pakket. €4.950 setup + €397/mnd. Bespaart €8.014 jaar 1.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk bundel →</span>
        </a>
        <a href="/diensten/website-laten-maken-mkb-nederland-2026/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">Website laten maken</h3>
          <p class="text-xs text-slate-600 mb-3">Astro/Next/WordPress AI-ready. Schema.org + Speakable + WCAG 2.2 AA + Core Web Vitals groen.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk pakketten →</span>
        </a>
        <a href="/cases/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">Combo-cases bekijken</h3>
          <p class="text-xs text-slate-600 mb-3">5 branche-scenarios met Website + AI bundel: detailhandel, zorg, horeca, advocatuur, accountancy.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk pakketten →</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section-tight bg-midnight text-pearl relative overflow-hidden">
    <div class="absolute inset-0 dot-grid opacity-[0.04]"></div>
    <div class="container-page relative max-w-3xl">
      <h2 class="text-3xl font-bold tracking-tightest text-pearl text-balance reveal">Bedrijf in {city}? Start gratis.</h2>
      <p class="mt-4 text-slate-300 reveal reveal-delay-1">Gratis AI scan van 30 minuten. Drietalige flows, EU-data, AVG-compliant. We laten u zien wat AI concreet oplevert voor uw Maastrichtse bedrijf.</p>
      <div class="mt-6 flex flex-col sm:flex-row gap-3 reveal reveal-delay-2">
        <a href="/aanvragen/" class="btn bg-pearl text-navy hover:bg-white text-base px-6 py-3.5">Gratis AI Scan<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></a>
        <a href="/diensten/" class="btn border border-slate-700 text-pearl hover:bg-slate-800 text-base px-6 py-3.5">Bekijk diensten</a>
        <a href="/prijzen/" class="btn border border-slate-700 text-pearl hover:bg-slate-800 text-base px-6 py-3.5">Bekijk prijzen</a>
      </div>
    </div>
  </section>
</BaseLayout>
