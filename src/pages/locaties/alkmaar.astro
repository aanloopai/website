---
import BaseLayout from '../../layouts/BaseLayout.astro';
const city = "Alkmaar";
const region = "Noord-Holland";
const localSchema = {
  '@context': 'https://schema.org', '@type': 'LocalBusiness',
  name: 'Aanloop AI — AI Agency Alkmaar',
  url: 'https://aanloopai.nl/locaties/alkmaar/',
  image: 'https://aanloopai.nl/logo-mark-light-1024.png',
  address: { '@type': 'PostalAddress', addressLocality: 'Alkmaar', addressRegion: 'Noord-Holland', addressCountry: 'NL', postalCode: '1800-1829' },
  geo: { '@type': 'GeoCoordinates', latitude: '52.6324', longitude: '4.7534' },
  areaServed: { '@type': 'City', name: 'Alkmaar' },
  priceRange: '€€',
  telephone: '+31624741597',
  email: 'hello@aanloopai.nl',
  openingHoursSpecification: { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '09:00', closes: '17:00' },
  sameAs: ['https://aanloopai.nl/'],
  author: { '@type': 'Person', '@id': 'https://aanloopai.nl/team/magahdogan/#person', name: 'Mustafa Agah Dogan' },
};
const faqItems = [
  { question: 'Werkt Aanloop AI voor bedrijven in Alkmaar?', answer: 'Ja. Wij bedienen MKB in Alkmaar, Heerhugowaard, Heiloo, Bergen en de West-Friese regio. Reistijd vanaf Rotterdam circa 1 uur 30 via A4/A9 — voor strategische workshops komen wij ter plaatse.' },
  { question: 'Welke Alkmaarse sectoren zijn relevant voor AI?', answer: 'Alkmaar telt sterke retail (Kaasmarkt-omgeving, Mient), agrarische dienstverlening en handel (West-Friese tuinbouw), accountantskantoren, advocatenkantoren en bouwbedrijven. Onze AI-agents richten zich op klantcontact, offerte-automatisering en administratie.' },
  { question: 'Bedient Aanloop AI ook tuinbouwbedrijven in West-Friesland?', answer: 'Ja. Tuinbouw-MKB rond Alkmaar (bollenstreek, glastuinbouw) heeft baat bij workflow-automatisering: orderverwerking, levering-planning en supplier-communicatie. Wij koppelen aan bestaande tuinbouwsoftware via n8n.' },
  { question: 'Wat kost AI voor een Alkmaars MKB-bedrijf?', answer: 'Tarieven landelijk uniform: Starter €597/maand, Groei €1.197/maand. Voor seizoengevoelige tuinbouwbedrijven bieden wij flexibele opschaal-opties.' },
  { question: 'Hoe verloopt implementatie voor een Alkmaars bedrijf?', answer: 'Remote, met optionele on-site sessies. Standaard live binnen 7 werkdagen na de gratis AI scan. Geen technische voorkennis nodig — wij regelen alles.' },
];
---
<BaseLayout
  title="AI Agency Alkmaar — AI Bureau & Automatisering MKB"
  description="AI bureau Alkmaar: Aanloop AI helpt het MKB met AI-agents en automatisering. AI agency Alkmaar — gratis AI-scan, live in 7-14 werkdagen."
  schema={localSchema}
  faqSchema={faqItems}
>
  <section class="border-b border-slate-200 hero-gradient">
    <div class="container-page py-16 lg:py-20">
      <div class="max-w-3xl">
        <div class="flex items-center gap-4 mb-6"><div class="accent-band"><span></span><span></span><span></span><span></span></div><span class="eyebrow">Locatie - {city} - {region}</span></div>
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tightest text-navy text-balance leading-[1.08] reveal reveal-delay-1">AI Agency {city}:<br/>AI voor MKB in West-Friesland</h1>
        <p class="mt-6 text-lg text-slate-600 leading-relaxed reveal reveal-delay-2">Aanloop AI bedient MKB-bedrijven in {city} en de West-Friese regio met AI agents, voice AI en workflow automation. Sterke retail, agrarische dienstverlening en zakelijke kantoren — concrete AI-toepassingen voor elk segment.</p>
        <div class="mt-8 flex flex-col sm:flex-row gap-3 reveal reveal-delay-3">
          <a href="/gratis-ai-scan/" class="btn-primary">Gratis AI Scan voor {city}<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></a>
          <a href="/tarieven/" class="btn-outline">Bekijk prijzen</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page max-w-4xl mx-auto">
      <div class="mb-10 reveal">
        <h2 class="text-2xl font-bold text-navy">AI voor Alkmaarse bedrijven</h2>
        <p class="mt-3 text-slate-600">Alkmaar — kaasstad bij uitstek — is regiocentrum voor West-Friesland. Het MKB-landschap omvat traditionele retail rond de Mient en de Kaasmarkt, agrarische dienstverlening rondom de bollenstreek en glastuinbouw, accountants- en advocatenkantoren, plus een groeiende cluster bouw- en installatiebedrijven. Heerhugowaard, Heiloo en Bergen vallen in dezelfde economische schil.</p>
        <p class="mt-3 text-slate-600">Postcoderegio 1800-1829 valt binnen ons standaard servicegebied. Onze AI-implementaties richten zich op pragmatische tijdwinst — automatische offerte-respons, AVG-compliant klantcontact en koppeling met bestaande sectorsoftware (tuinbouw-ERP, accountancy-pakketten, bouwsoftware).</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 mb-12">
        {[
          { title: 'Retail Mient & Kaasmarkt', desc: 'WhatsApp AI voor klantvragen, voorraadcheck en reserveringen. 24/7 bereikbaar.', link: '/sectoren/horeca/' },
          { title: 'Agrarisch / Tuinbouw', desc: 'n8n-workflow voor orderverwerking, levering-planning en supplier-communicatie.', link: '/diensten/custom/' },
          { title: 'Accountants Alkmaar', desc: 'AI-document agent verwerkt facturen automatisch. 85% tijdsbesparing.', link: '/sectoren/accountancy/' },
          { title: 'Advocatenkantoren', desc: 'AI-intake voor cliëntdossiers en contract-classificatie.', link: '/sectoren/ai-voor-advocaten/' },
          { title: 'Bouw & Installatie', desc: 'AI-receptionist voor offerte-aanvragen en planning. Geen gemiste klant.', link: '/sectoren/bouw/' },
          { title: 'ZZP West-Friesland', desc: 'Betaalbare AI vanaf €597/maand. Starter-pakket inclusief setup.', link: '/sectoren/ai-voor-zzp/' },
        ].map(s => (
          <div class="card reveal">
            <h3 class="font-bold text-navy text-sm mb-2">{s.title}</h3>
            <p class="text-xs text-slate-600 mb-4">{s.desc}</p>
            <a href={s.link} class="text-xs font-medium text-brand-indigo hover:underline">AI in {city} bekijken →</a>
          </div>
        ))}
      </div>

      <div class="bg-slate-50 border border-slate-200 rounded-2xl p-8 mb-12 reveal">
        <h3 class="text-xl font-bold text-navy mb-4">Wij rijden naar Alkmaar</h3>
        <p class="text-sm text-slate-600">Vanaf Rotterdam ongeveer 1 uur 30 via A4/A9. Voor agrarische workshops, retail-implementaties of complexe stakeholdersessies komen wij naar uw locatie. Heerhugowaard, Heiloo, Bergen, Castricum en Schagen vallen onder hetzelfde servicegebied.</p>
      </div>

      <div class="bg-brand-indigo/5 border border-brand-indigo/20 rounded-2xl p-6 mb-10 reveal">
        <p class="font-bold text-navy mb-2">Lokale AI use cases — Alkmaar</p>
        <ul class="text-sm text-slate-600 space-y-2 mt-3">
          <li><strong>Tuinbouwbedrijf bollenstreek:</strong> n8n synchroniseert orders met veiling- en transportsysteem, doorlooptijd halveert.</li>
          <li><strong>Retailwinkel Mient:</strong> WhatsApp-bot beantwoordt voorraad- en openingstijdvragen, eigenaar bespaart 8 uur per week.</li>
          <li><strong>Accountantskantoor centrum:</strong> AI-document agent classificeert facturen direct in Exact, administratie 80% sneller.</li>
          <li><strong>Bouwbedrijf Heerhugowaard:</strong> AI-receptionist beantwoordt offerte-aanvragen na kantooruren, conversie 40% hoger.</li>
        </ul>
      </div>

      <h2 class="text-2xl font-bold text-navy mb-6">Veelgestelde Vragen — AI Agency {city}</h2>
      <div class="space-y-3 mb-8">
        {faqItems.map(item => (
          <details class="card group">
            <summary class="flex items-center justify-between cursor-pointer list-none">
              <span class="text-sm font-bold text-navy pr-6">{item.question}</span>
              <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <p class="mt-4 text-sm text-slate-600 leading-relaxed">{item.answer}</p>
          </details>
        ))}
      </div>

      <div class="bg-slate-50 border border-slate-200 rounded-xl p-6">
        <p class="text-sm font-bold text-navy mb-3">Andere locaties</p>
        <div class="flex flex-wrap gap-3 text-sm">
          <a href="/locaties/zaanstad/" class="text-brand-indigo hover:underline">Zaanstad</a>
          <a href="/locaties/haarlem/" class="text-brand-indigo hover:underline">Haarlem</a>
          <a href="/locaties/amsterdam/" class="text-brand-indigo hover:underline">Amsterdam</a>
          <a href="/locaties/hilversum/" class="text-brand-indigo hover:underline">Hilversum</a>
          <a href="/locaties/lelystad/" class="text-brand-indigo hover:underline">Lelystad</a>
          <a href="/locaties/leiden/" class="text-brand-indigo hover:underline">Leiden</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-slate-50 border-y border-slate-200">
    <div class="container-page max-w-4xl">
      <p class="eyebrow text-brand-indigo mb-2">Website + AI = 1 partner</p>
      <h2 class="text-2xl lg:text-3xl font-bold text-navy mb-4">Alkmaarse MKB kiest één partner voor website én AI</h2>
      <p class="text-slate-600 mb-8 leading-relaxed">Veel Alkmaarse bedrijven hebben verouderde websites van lokale webbureaus, en sluiten daarnaast losse AI-leveranciers aan. Bij Aanloop AI is dat één traject: AI-ready website + Marco (telefoon) + Emma (WhatsApp) in één pakket — bespaart €8.014 jaar 1 t.o.v. losse leveranciers, met één contract en één aanspreekpunt.</p>
      <div class="grid md:grid-cols-3 gap-4">
        <a href="/diensten/ai-website-bundel-mkb-nederland/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">AI-Website Bundel</h3>
          <p class="text-xs text-slate-600 mb-3">Website + Marco + Emma in 1 pakket. €4.950 setup + €397/mnd. Bespaart €8.014 jaar 1.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk bundel →</span>
        </a>
        <a href="/diensten/website-laten-maken-mkb-nederland-2026/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">Website laten maken</h3>
          <p class="text-xs text-slate-600 mb-3">Astro/Next/WordPress AI-ready. Schema.org + Speakable + WCAG 2.2 AA + Core Web Vitals groen.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk pakketten →</span>
        </a>
        <a href="/cases/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">Combo-cases bekijken</h3>
          <p class="text-xs text-slate-600 mb-3">5 branche-scenarios met Website + AI bundel: detailhandel, zorg, horeca, advocatuur, accountancy.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk cases →</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section-tight bg-midnight text-pearl relative overflow-hidden">
    <div class="absolute inset-0 dot-grid opacity-[0.04]"></div>
    <div class="container-page relative max-w-3xl">
      <h2 class="text-3xl font-bold tracking-tightest text-pearl text-balance reveal">Bedrijf in Alkmaar? Start gratis.</h2>
      <p class="mt-4 text-slate-300 reveal reveal-delay-1">Gratis AI scan van 30 minuten. EU-data only, AVG-compliant. Wij rekenen door wat AI uw Alkmaarse bedrijf concreet bespaart.</p>
      <div class="mt-6 flex flex-col sm:flex-row gap-3 reveal reveal-delay-2">
        <a href="/aanvragen/" class="btn bg-pearl text-navy hover:bg-white text-base px-6 py-3.5">Gratis AI Scan<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></a>
        <a href="/diensten/" class="btn border border-slate-700 text-pearl hover:bg-slate-800 text-base px-6 py-3.5">Bekijk diensten</a>
        <a href="/tarieven/" class="btn border border-slate-700 text-pearl hover:bg-slate-800 text-base px-6 py-3.5">Bekijk prijzen</a>
      </div>
    </div>
  </section>
</BaseLayout>
