---
import BaseLayout from '../../layouts/BaseLayout.astro';
const city = "Eindhoven";
const region = "Noord-Brabant";
const localSchema = {
  '@context': 'https://schema.org', '@type': 'LocalBusiness',
  name: `Aanloop AI — AI Agency ${city}`,
  url: `https://aanloopai.nl/locaties/${city.toLowerCase()}/`,
  image: 'https://aanloopai.nl/logo-mark-light-1024.png',
  address: { '@type': 'PostalAddress', addressLocality: city, addressRegion: region, addressCountry: 'NL' },
  geo: { '@type': 'GeoCoordinates', latitude: '51.4416', longitude: '5.4697' },
  areaServed: { '@type': 'City', name: city },
  openingHoursSpecification: { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '09:00', closes: '17:00' },
  priceRange: '€€',
  telephone: '+31624741597',
  email: 'hello@aanloopai.nl',
  url: 'https://aanloopai.nl',
};
const faqItems = [
  { question: `Werkt Aanloop AI ook voor bedrijven in ${city}?`, answer: `Ja. Aanloop AI (KVK: 56312075, gevestigd in Rotterdam) bedient bedrijven in heel Nederland, inclusief ${city} en de regio ${region}. Alle trajecten verlopen remote, met optioneel een persoonlijke afspraak.` },
  { question: `Welke sectoren in ${city} zijn populair bij Aanloop AI?`, answer: `In ${city} bedienen we voornamelijk bedrijven in technologie, hightech industrie, productie en zakelijke dienstverlening. De regio heeft een sterk MKB-landschap dat goed past bij AI-automatisering.` },
  { question: `Hoe snel kan Aanloop AI starten voor een bedrijf in ${city}?`, answer: `We starten direct. Na de gratis AI scan (remote via video) plannen we de implementatie: standaard binnen 7 werkdagen live.` },
  { question: `Biedt Aanloop AI ook een AI telefoniste voor ${city}?`, answer: `Ja. Onze AI-receptionist Marco is volledig geschikt voor bedrijven in ${city}. Het systeem neemt uw inkomende calls aan in vloeiend Nederlands, plant afspraken in en stuurt leads door.` },
];
---
<BaseLayout
  title="AI Agency Eindhoven — AI Bureau & Automatisering MKB"
  description="AI bureau Eindhoven: Aanloop AI helpt het MKB met AI-agents en automatisering. AI agency Eindhoven — gratis AI-scan, live in 7-14 werkdagen."
  schema={localSchema}
  faqSchema={faqItems}
>
  <section class="border-b border-slate-200 hero-gradient">
    <div class="container-page py-16 lg:py-20">
      <div class="max-w-3xl">
        <div class="flex items-center gap-4 mb-6"><div class="accent-band"><span></span><span></span><span></span><span></span></div><span class="eyebrow">Locatie · {city} · {region}</span></div>
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tightest text-navy text-balance leading-[1.08] reveal reveal-delay-1">AI Agency {city}:<br/>AI Agents & Automatisering voor MKB</h1>
        <p class="mt-6 text-lg text-slate-600 leading-relaxed reveal reveal-delay-2">Aanloop AI helpt MKB-bedrijven in {city} en de regio {region} met AI-automatisering, voice AI en workflow oplossingen. Geen technische kennis nodig — wij regelen alles.</p>
        <div class="mt-8 flex flex-col sm:flex-row gap-3 reveal reveal-delay-3">
          <a href="/gratis-ai-scan/" class="btn-primary">Gratis AI Scan voor {city}<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></a>
          <a href="/tarieven/" class="btn-outline">Bekijk tarieven</a>
        </div>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container-page max-w-4xl mx-auto">
      <div class="mb-10 reveal">
        <h2 class="text-2xl font-bold text-navy">AI voor {city}se Bedrijven</h2>
        <p class="mt-3 text-slate-600">{city} is een van de snelst groeiende technologieregio's van Nederland. MKB-bedrijven in de regio profiteren steeds meer van AI-automatisering om te concurreren met grotere spelers.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 mb-12">
        {[
          { icon: '🏭', sector: `Technologie & Hightech ${city}`, desc: 'AI workflow automation voor technologiebedrijven in de Brainport-regio.', link: '/diensten/' },
          { icon: '🏗️', sector: `Productie & Maakindustrie`, desc: 'AI-agent voor offerteaanvragen, klantenservice en documentverwerking.', link: '/diensten/' },
          { icon: '💼', sector: `Zakelijke Dienstverlening ${city}`, desc: 'Automatiseer e-mail, telefonie en leadkwalificatie voor meer billable uren.', link: '/sectoren/zakelijk/' },
          { icon: '🏠', sector: `Vastgoed ${city}`, desc: 'AI receptionist voor bezichtigingen. 68% minder gemiste calls.', link: '/sectoren/vastgoed/' },
          { icon: '📊', sector: `Accountancy ${city}`, desc: 'AI factuurverwerking en cliëntcommunicatie. 85% tijdsbesparing.', link: '/sectoren/accountancy/' },
          { icon: '💬', sector: `WhatsApp AI ${city}`, desc: 'Automatische WhatsApp klantenservice voor Eindhovense MKB-bedrijven.', link: '/diensten/emma/' },
        ].map(s => (
          <div class="card reveal">
            <div class="text-2xl mb-3">{s.icon}</div>
            <h3 class="font-bold text-navy text-sm mb-2">{s.sector}</h3>
            <p class="text-xs text-slate-600 mb-4">{s.desc}</p>
            <a href={s.link} class="text-xs font-medium text-brand-indigo hover:underline">AI in Eindhoven bekijken →</a>
          </div>
        ))}
      </div>
      <div class="grid md:grid-cols-3 gap-4 mb-10">
        {[
          { stat: '24/7', label: 'Bereikbaar voor uw klanten' },
          { stat: '7 dgn', label: 'Gemiddeld live na aanvraag' },
          { stat: '€497', label: 'Marco pakket per maand' },
        ].map(s => (
          <div class="card text-center reveal">
            <p class="text-3xl font-bold text-navy">{s.stat}</p>
            <p class="text-sm text-slate-600 mt-1">{s.label}</p>
          </div>
        ))}
      </div>
      <h2 class="text-2xl font-bold text-navy mb-6">Veelgestelde Vragen — AI Agency {city}</h2>
      <div class="space-y-3 mb-8">
        {faqItems.map(item => (
          <details class="card group">
            <summary class="flex items-center justify-between cursor-pointer list-none">
              <span class="text-sm font-bold text-navy pr-6">{item.question}</span>
              <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <p class="mt-4 text-sm text-slate-600 leading-relaxed">{item.answer}</p>
          </details>
        ))}
      </div>
      <div class="bg-slate-50 border border-slate-200 rounded-xl p-6">
        <p class="text-sm font-bold text-navy mb-3">Andere steden</p>
        <div class="flex flex-wrap gap-3">
          <a href="/locaties/rotterdam/" class="text-sm text-brand-indigo hover:underline">AI Agency Rotterdam →</a>
          <a href="/locaties/amsterdam/" class="text-sm text-brand-indigo hover:underline">AI Agency Amsterdam →</a>
          <a href="/locaties/den-haag/" class="text-sm text-brand-indigo hover:underline">AI Agency Den Haag →</a>
          <a href="/locaties/utrecht/" class="text-sm text-brand-indigo hover:underline">AI Agency Utrecht →</a>
          <a href="/locaties/tilburg/" class="text-sm text-brand-indigo hover:underline">AI Agency Tilburg →</a>
          <a href="/locaties/breda/" class="text-sm text-brand-indigo hover:underline">AI Agency Breda →</a>
        </div>
      </div>
    </div>
  </section>
  <section class="section-tight bg-slate-50/60 border-t border-slate-200">
    <div class="container-page max-w-4xl">
      <p class="eyebrow text-brand-indigo mb-2">Kennisbank</p>
      <h2 class="text-2xl font-bold text-navy mb-6">Verdiepende AI-gidsen</h2>
      <div class="grid sm:grid-cols-2 gap-3">
        <a href="/kennisbank/wat-is-een-ai-agent/" class="card p-4 hover:shadow-md transition-all bg-white"><p class="text-xs text-brand-indigo mb-1">Gids</p><p class="text-sm font-semibold text-navy">Wat is een AI agent? Complete gids</p></a>
        <a href="/kennisbank/ai-roi-berekenen-mkb-nederland-2026/" class="card p-4 hover:shadow-md transition-all bg-white"><p class="text-xs text-brand-indigo mb-1">Gids</p><p class="text-sm font-semibold text-navy">AI ROI berekenen voor MKB 2026</p></a>
        <a href="/kennisbank/ai-implementatie-stappen-mkb-nederland/" class="card p-4 hover:shadow-md transition-all bg-white"><p class="text-xs text-brand-indigo mb-1">Gids</p><p class="text-sm font-semibold text-navy">AI implementatie in 7 stappen</p></a>
        <a href="/kennisbank/ai-avg-gdpr-compliance-mkb-nederland/" class="card p-4 hover:shadow-md transition-all bg-white"><p class="text-xs text-brand-indigo mb-1">Gids</p><p class="text-sm font-semibold text-navy">AI en AVG-compliance voor MKB</p></a>
      </div>
    </div>
  </section>


  <section class="section bg-slate-50 border-y border-slate-200">
    <div class="container-page max-w-4xl">
      <p class="eyebrow text-brand-indigo mb-2">Website + AI = 1 partner</p>
      <h2 class="text-2xl lg:text-3xl font-bold text-navy mb-4">Eindhovens MKB kiest één partner voor website én AI</h2>
      <p class="text-slate-600 mb-8 leading-relaxed">Veel Eindhovense bedrijven (Brainport-regio incluis) hebben verouderde websites van lokale webbureaus, en sluiten daarnaast losse AI-leveranciers aan. Bij Aanloop AI is dat één traject: AI-ready website + Marco (telefoon) + Emma (WhatsApp) in één pakket — bespaart op jaarbasis t.o.v. losse leveranciers, met één contract en één aanspreekpunt.</p>
      <div class="grid md:grid-cols-3 gap-4">
        <a href="/diensten/ai-website-bundel-mkb-nederland/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">AI-Website Bundel</h3>
          <p class="text-xs text-slate-600 mb-3">Website + Marco + Emma in 1 pakket. €4.950 setup + €397/mnd. Bespaart op jaarbasis.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk bundel →</span>
        </a>
        <a href="/diensten/website-laten-maken-mkb-nederland-2026/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">Website laten maken</h3>
          <p class="text-xs text-slate-600 mb-3">Astro/Next/WordPress AI-ready. Schema.org + Speakable + WCAG 2.2 AA + Core Web Vitals groen.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk pakketten →</span>
        </a>
        <a href="/cases/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">Combo-cases bekijken</h3>
          <p class="text-xs text-slate-600 mb-3">5 branche-scenarios met Website + AI bundel: detailhandel, zorg, horeca, advocatuur, accountancy.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk cases →</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section-tight bg-midnight text-pearl relative overflow-hidden">
    <div class="absolute inset-0 dot-grid opacity-[0.04]"></div>
    <div class="container-page relative max-w-3xl">
      <h2 class="text-3xl font-bold tracking-tightest text-pearl text-balance reveal">Bedrijf in {city}? Start met een gratis AI scan.</h2>
      <p class="mt-4 text-slate-300 reveal reveal-delay-1">We analyseren uw processen en laten u zien wat AI concreet oplevert voor uw bedrijf in {city}. Gratis en vrijblijvend.</p>
      <div class="mt-6 flex flex-col sm:flex-row gap-3 reveal reveal-delay-2">
        <a href="/gratis-ai-scan/" class="btn bg-pearl text-navy hover:bg-white text-base px-6 py-3.5">Gratis AI Scan aanvragen<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></a>
        <a href="/tarieven/" class="btn border border-slate-700 text-pearl hover:bg-slate-800 text-base px-6 py-3.5">Bekijk prijzen</a>
      </div>
    </div>
  </section>
</BaseLayout>
