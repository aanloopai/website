---
import BaseLayout from '../../layouts/BaseLayout.astro';

const localSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'Aanloop AI — AI Agency Amsterdam',
  url: 'https://aanloopai.nl/locaties/amsterdam/',
  image: 'https://aanloopai.nl/logo-mark-light-1024.png',
  address: { '@type': 'PostalAddress', addressLocality: 'Amsterdam', addressRegion: 'Noord-Holland', addressCountry: 'NL' },
  geo: { '@type': 'GeoCoordinates', latitude: '52.3676', longitude: '4.9041' },
  areaServed: { '@type': 'City', name: 'Amsterdam' },
  telephone: '+31624741597',
  priceRange: '€€',
  openingHoursSpecification: { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '09:00', closes: '17:00' },
};

const faqItems = [
  { question: 'Is Aanloop AI actief in Amsterdam?', answer: 'Ja. Aanloop AI bedient klanten in Amsterdam en de gehele Randstad. Wij werken remote en on-site, afhankelijk van de wensen van de klant. Voor Amsterdamse klanten zijn we beschikbaar voor persoonlijke afspraken.' },
  { question: 'Welke Amsterdamse sectoren bedient Aanloop AI?', answer: 'In Amsterdam bedienen we met name: makelaars (Jordaan, Zuid, Oost), horecabedrijven (restaurants, cafés, hotels), advocatenkantoren (Zuidas, centrum) en technologie-startups.' },
  { question: 'Hoe snel kan Aanloop AI een AI agent implementeren voor een Amsterdams bedrijf?', answer: 'Voor Amsterdamse klanten geldt dezelfde implementatietijd: standaard 7 werkdagen. We plannen een intake-gesprek (remote of op locatie), waarna we direct aan de slag gaan.' },
  { question: 'Wat kost een AI agent voor een Amsterdams MKB-bedrijf?', answer: 'Onze prijzen zijn voor heel Nederland gelijk: Emma €497/maand, Groei €997/maand. Er zijn geen toeslag voor Amsterdam. Meer details op onze prijzen pagina.' },
  { question: 'Biedt Aanloop AI ook AI consultancy aan voor Amsterdamse bedrijven?', answer: 'Ja. Via onze gratis AI scan bieden we Amsterdamse bedrijven een vrijblijvend adviesgesprek. We analyseren uw processen en geven concrete aanbevelingen voor AI-implementaties.' },
];
---

<BaseLayout
  title="AI Agency Amsterdam — AI Bureau & Automatisering MKB"
  description="AI bureau Amsterdam: Aanloop AI helpt het MKB met AI-agents en automatisering. AI agency Amsterdam — gratis AI-scan, live in 7-14 werkdagen."
  schema={localSchema}
  faqSchema={faqItems}
>
  <section class="border-b border-slate-200 hero-gradient">
    <div class="container-page py-16 lg:py-20">
      <div class="max-w-3xl">
        <div class="flex items-center gap-4 mb-6"><div class="accent-band"><span></span><span></span><span></span><span></span></div><span class="eyebrow">Locatie · Amsterdam</span></div>
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tightest text-navy text-balance leading-[1.08] reveal reveal-delay-1">AI Agency Amsterdam:<br/>AI Agents & Automation voor Amsterdamse Bedrijven</h1>
        <p class="mt-6 text-lg text-slate-600 leading-relaxed reveal reveal-delay-2">Aanloop AI helpt Amsterdamse MKB-bedrijven met AI agents, voice AI en workflow automation. Transparante prijzen, live in 7 werkdagen, AVG-compliant.</p>
        <div class="mt-8 flex flex-col sm:flex-row gap-3 reveal reveal-delay-3">
          <a href="/gratis-ai-scan/" class="btn-primary">Gratis AI Scan voor Amsterdam<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></a>
          <a href="/tarieven/" class="btn-outline">Bekijk tarieven</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page max-w-4xl mx-auto">
      <div class="mb-10 reveal">
        <h2 class="text-2xl font-bold text-navy">AI voor Amsterdamse Bedrijven</h2>
        <p class="mt-3 text-slate-600">Amsterdam heeft een uniek en divers MKB-landschap. Aanloop AI heeft sectorspecifieke AI-oplossingen voor de meest voorkomende Amsterdamse branches:</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 mb-12">
        {[
          { icon: '🏠', sector: 'Makelaars Amsterdam', desc: 'AI receptionist voor bezichtigingsafspraken. 24/7 bereikbaar, leads automatisch in uw CRM.', link: '/sectoren/vastgoed/' },
          { icon: '🍽️', sector: 'Horeca Amsterdam', desc: 'WhatsApp AI agent voor reserveringen. Geen overboeking, automatische bevestiging.', link: '/sectoren/horeca/' },
          { icon: '⚖️', sector: 'Advocatenkantoren Zuidas', desc: 'AI intake-screening voor efficiëntere cliëntopname. Bespaar 12+ uur per week.', link: '/sectoren/ai-voor-advocaten/' },
          { icon: '🛒', sector: 'E-commerce Amsterdam', desc: 'AI klantenservice voor webshops. 70% van vragen automatisch afgehandeld.', link: '/sectoren/ai-voor-webshops/' },
          { icon: '💼', sector: 'ZZP Amsterdam', desc: 'Betaalbare AI-oplossingen speciaal voor Amsterdamse ZZP\'ers. Emma vanaf €497/maand.', link: '/sectoren/ai-voor-zzp/' },
          { icon: '📊', sector: 'Accountants Amsterdam', desc: 'Automatische factuurverwerking, 85% tijdsbesparing op administratie.', link: '/sectoren/accountancy/' },
        ].map(s => (
          <div class="card reveal">
            <div class="text-2xl mb-3">{s.icon}</div>
            <h3 class="font-bold text-navy text-sm mb-2">{s.sector}</h3>
            <p class="text-xs text-slate-600 mb-4">{s.desc}</p>
            <a href={s.link} class="text-xs font-medium text-brand-indigo hover:underline">AI in Amsterdam bekijken →</a>
          </div>
        ))}
      </div>

      <div class="bg-slate-50 border border-slate-200 rounded-2xl p-8 mb-12 reveal">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
          {[
            { n: '7', l: 'werkdagen', d: 'live implementatie' },
            { n: '€497', l: 'per maand', d: 'Emma pakket' },
            { n: '24/7', l: 'bereikbaar', d: 'ook buiten kantoortijd' },
            { n: '100%', l: 'AVG-compliant', d: 'data in Nederland' },
          ].map(s => (
            <div>
              <p class="text-2xl font-bold text-navy">{s.n}</p>
              <p class="text-xs font-medium text-slate-600">{s.l}</p>
              <p class="text-xs text-slate-400">{s.d}</p>
            </div>
          ))}
        </div>
      </div>

      <h2 class="text-2xl font-bold text-navy mb-6">Veelgestelde Vragen — AI Agency Amsterdam</h2>
      <div class="space-y-3 mb-8">
        {faqItems.map(item => (
          <details class="card group">
            <summary class="flex items-center justify-between cursor-pointer list-none">
              <span class="text-sm font-bold text-navy pr-6">{item.question}</span>
              <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <p class="mt-4 text-sm text-slate-600 leading-relaxed">{item.answer}</p>
          </details>
        ))}
      </div>

      <div class="bg-slate-50 border border-slate-200 rounded-xl p-6">
        <p class="text-sm font-bold text-navy mb-3">Andere locaties</p>
        <div class="flex flex-wrap gap-3">
          <a href="/locaties/rotterdam/" class="text-sm text-brand-indigo hover:underline">AI Agency Rotterdam →</a>
          <a href="/locaties/den-haag/" class="text-sm text-brand-indigo hover:underline">AI Agency Den Haag →</a>
          <a href="/locaties/utrecht/" class="text-sm text-brand-indigo hover:underline">AI Agency Utrecht →</a>
        </div>
      </div>
    </div>
  </section>
  <section class="section-tight bg-slate-50/60 border-t border-slate-200">
    <div class="container-page max-w-4xl">
      <p class="eyebrow text-brand-indigo mb-2">Kennisbank</p>
      <h2 class="text-2xl font-bold text-navy mb-6">Verdiepende AI-gidsen</h2>
      <div class="grid sm:grid-cols-2 gap-3">
        <a href="/kennisbank/wat-is-een-ai-agent/" class="card p-4 hover:shadow-md transition-all bg-white"><p class="text-xs text-brand-indigo mb-1">Gids</p><p class="text-sm font-semibold text-navy">Wat is een AI agent? Complete gids</p></a>
        <a href="/kennisbank/ai-roi-berekenen-mkb-nederland-2026/" class="card p-4 hover:shadow-md transition-all bg-white"><p class="text-xs text-brand-indigo mb-1">Gids</p><p class="text-sm font-semibold text-navy">AI ROI berekenen voor MKB 2026</p></a>
        <a href="/kennisbank/ai-implementatie-stappen-mkb-nederland/" class="card p-4 hover:shadow-md transition-all bg-white"><p class="text-xs text-brand-indigo mb-1">Gids</p><p class="text-sm font-semibold text-navy">AI implementatie in 7 stappen</p></a>
        <a href="/kennisbank/ai-avg-gdpr-compliance-mkb-nederland/" class="card p-4 hover:shadow-md transition-all bg-white"><p class="text-xs text-brand-indigo mb-1">Gids</p><p class="text-sm font-semibold text-navy">AI en AVG-compliance voor MKB</p></a>
      </div>
    </div>
  </section>



  <section class="section bg-slate-50 border-y border-slate-200">
    <div class="container-page max-w-4xl">
      <p class="eyebrow text-brand-indigo mb-2">Website + AI = 1 partner</p>
      <h2 class="text-2xl lg:text-3xl font-bold text-navy mb-4">Amsterdamse MKB kiest één partner voor website én AI</h2>
      <p class="text-slate-600 mb-8 leading-relaxed">Veel Amsterdamse bedrijven hebben verouderde websites van lokale webbureaus, en sluiten daarnaast losse AI-leveranciers aan. Bij Aanloop AI is dat één traject: AI-ready website + Emma (telefoon + WhatsApp) in één pakket — bespaart op jaarbasis t.o.v. losse leveranciers, met één contract en één aanspreekpunt.</p>
      <div class="grid md:grid-cols-3 gap-4">
        <a href="/diensten/ai-website-bundel-mkb-nederland/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">AI-Website Bundel</h3>
          <p class="text-xs text-slate-600 mb-3">Website + Emma in 1 pakket. €4.950 setup + €397/mnd. Bespaart op jaarbasis.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk bundel →</span>
        </a>
        <a href="/diensten/website-laten-maken-mkb-nederland-2026/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">Website laten maken</h3>
          <p class="text-xs text-slate-600 mb-3">Astro/Next/WordPress AI-ready. Schema.org + Speakable + WCAG 2.2 AA + Core Web Vitals groen.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk pakketten →</span>
        </a>
        <a href="/cases/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">Combo-cases bekijken</h3>
          <p class="text-xs text-slate-600 mb-3">5 branche-scenarios met Website + AI bundel: detailhandel, zorg, horeca, advocatuur, accountancy.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk cases →</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section-tight bg-midnight text-pearl relative overflow-hidden">
    <div class="absolute inset-0 dot-grid opacity-[0.04]"></div>
    <div class="container-page relative max-w-3xl">
      <h2 class="text-3xl font-bold tracking-tightest text-pearl text-balance reveal">Bent u een Amsterdams bedrijf?</h2>
      <p class="mt-4 text-slate-300 reveal reveal-delay-1">Plan een gratis AI scan en ontdek hoe AI uw Amsterdamse bedrijf kan versterken. Geen verplichting.</p>
      <div class="mt-6 flex flex-col sm:flex-row gap-3 reveal reveal-delay-2">
        <a href="/gratis-ai-scan/" class="btn bg-pearl text-navy hover:bg-white text-base px-6 py-3.5">Gratis AI Scan aanvragen<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></a>
        <a href="/tarieven/" class="btn border border-slate-700 text-pearl hover:bg-slate-800 text-base px-6 py-3.5">Bekijk AI prijzen</a>
      </div>
    </div>
  </section>
</BaseLayout>
