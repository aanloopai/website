---
import BaseLayout from '../../layouts/BaseLayout.astro';
const city = "Zaanstad";
const region = "Noord-Holland";
const localSchema = {
  '@context': 'https://schema.org', '@type': 'ProfessionalService',
  name: 'Aanloop AI — AI Agency Zaanstad',
  url: 'https://aanloopai.nl/locaties/zaanstad/',
  image: 'https://aanloopai.nl/logo-mark-light-1024.png',
  address: { '@type': 'PostalAddress', addressLocality: 'Zaandam', addressRegion: 'Noord-Holland', addressCountry: 'NL', postalCode: '1500-1567' },
  geo: { '@type': 'GeoCoordinates', latitude: '52.4574', longitude: '4.7507' },
  areaServed: { '@type': 'City', name: 'Zaanstad' },
  priceRange: '€€',
  telephone: '+31624741597',
  email: 'hello@aanloopai.nl',
  openingHoursSpecification: { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '09:00', closes: '17:00' },
  sameAs: ['https://aanloopai.nl/'],
  author: { '@type': 'Person', '@id': 'https://aanloopai.nl/team/daan-verhoeven/#person', name: 'Daan Verhoeven' },
};
const faqItems = [
  { question: 'Werkt Aanloop AI voor bedrijven in Zaanstad?', answer: 'Ja. Wij bedienen MKB in Zaandam, Wormerveer, Krommenie, Koog aan de Zaan en de gehele Zaanstreek. Vanaf Rotterdam rijden wij in circa 1 uur 15 via A4/A10/A8 naar Zaanstad voor strategische sessies.' },
  { question: 'Welke Zaanse sectoren bedient Aanloop AI?', answer: 'De Zaanstreek heeft een sterk historisch industrieel profiel: voedingsmiddelen (Verkade, Olam Cocoa), houtverwerking, papierfabrieken en familieagrarische bedrijven. Daarnaast e-commerce (Hoogtij), bouw en logistiek. Wij implementeren AI voor productie-administratie, klantcommunicatie en supply-chain workflows.' },
  { question: 'Werkt AI voor productiebedrijven in Zaandam?', answer: 'Zeker. Klassieke productiebedrijven hebben vaak repetitieve administratieve taken (orderbevestigingen, voorraadrapporten, kwaliteitscontrole-logging). Onze n8n-workflows automatiseren die zonder dat productiemedewerkers nieuwe systemen leren.' },
  { question: 'Wat kost AI voor een Zaans MKB-bedrijf?', answer: 'Landelijk uniform: Starter €997/maand, Growth €2.500/maand. Geen toeslag voor regio Zaanstreek. Bekijk prijzen-pagina voor details.' },
  { question: 'Hoe snel kan een AI-agent live zijn in Zaanstad?', answer: 'Standaard 7 werkdagen na de gratis AI scan. Ook voor productiebedrijven met legacy-systemen (Exact, AFAS, custom ERP) blijft die doorlooptijd haalbaar.' },
];
---
<BaseLayout
  title="AI Agency Zaanstad — AI Agents voor Industrie en MKB Zaanstreek | Aanloop AI"
  description="Aanloop AI helpt MKB in Zaandam, Wormerveer en Krommenie met AI agents, voice AI en workflow automation. Voor productie, voedingsmiddelen en familiebedrijven. Live in 7 werkdagen."
  schema={localSchema}
  faqSchema={faqItems}
>
  <section class="border-b border-slate-200 hero-gradient">
    <div class="container-page py-16 lg:py-20">
      <div class="max-w-3xl">
        <div class="flex items-center gap-4 mb-6"><div class="accent-band"><span></span><span></span><span></span><span></span></div><span class="eyebrow">Locatie - {city} - {region}</span></div>
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tightest text-navy text-balance leading-[1.08] reveal reveal-delay-1">AI Agency {city}:<br/>AI voor Industrie en Familiebedrijven</h1>
        <p class="mt-6 text-lg text-slate-600 leading-relaxed reveal reveal-delay-2">Aanloop AI bedient MKB-bedrijven in {city} en de Zaanstreek met AI agents, voice AI en workflow automation. Industriestreek met klassieke productie en moderne e-commerce — ideaal terrein voor pragmatische AI-implementaties.</p>
        <div class="mt-8 flex flex-col sm:flex-row gap-3 reveal reveal-delay-3">
          <a href="/gratis-ai-scan/" class="btn-primary">Gratis AI Scan voor {city}<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></a>
          <a href="/prijzen/" class="btn-outline">Bekijk prijzen</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page max-w-4xl mx-auto">
      <div class="mb-10 reveal">
        <h2 class="text-2xl font-bold text-navy">AI voor Zaanse bedrijven</h2>
        <p class="mt-3 text-slate-600">De Zaanstreek (Zaandam, Wormerveer, Krommenie, Koog aan de Zaan, Westzaan) heeft een uniek economisch profiel: van oudsher een industriële regio met voedingsmiddelen (Verkade, Olam Cocoa, Tate & Lyle), houtverwerking, papierfabrieken en agrarische familiebedrijven. Tegelijk is Hoogtij een groeiend bedrijventerrein voor logistiek en e-commerce, en blijft Zaandam-centrum een levendig MKB-centrum voor retail, horeca en zakelijke dienstverlening.</p>
        <p class="mt-3 text-slate-600">Postcoderegio 1500-1567 valt binnen ons standaard servicegebied. Onze AI-implementaties zijn pragmatisch: respect voor bestaande werkwijzen, koppeling met legacy-ERP (Exact, AFAS, custom) en focus op tijdwinst die productiemedewerkers direct merken — niet op modieuze trends.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 mb-12">
        {[
          { title: 'Voedingsmiddelen-MKB', desc: 'Workflow automation voor batch-administratie, kwaliteitscontrole-logging en HACCP-rapportages.', link: '/diensten/custom/' },
          { title: 'Houtverwerking & Industrie', desc: 'AI-receptionist voor offerte-aanvragen en orderintake. 24/7 bereikbaar.', link: '/sectoren/bouw/' },
          { title: 'E-commerce Hoogtij', desc: 'AI klantenservice voor webshops. 70% van vragen automatisch afgehandeld.', link: '/sectoren/ai-voor-webshops/' },
          { title: 'Familiebedrijven Zaanstreek', desc: 'AI op maat voor generatie-overstijgende processen. Custom n8n-flows.', link: '/diensten/custom/' },
          { title: 'Logistiek & Transport', desc: 'AI workflow voor orderverwerking, ritplanning en facturatie.', link: '/sectoren/logistiek/' },
          { title: 'Horeca centrum Zaandam', desc: 'WhatsApp AI voor reserveringen. Geen overboeking, automatische bevestiging.', link: '/sectoren/horeca/' },
        ].map(s => (
          <div class="card reveal">
            <h3 class="font-bold text-navy text-sm mb-2">{s.title}</h3>
            <p class="text-xs text-slate-600 mb-4">{s.desc}</p>
            <a href={s.link} class="text-xs font-medium text-brand-indigo hover:underline">AI in {city} bekijken →</a>
          </div>
        ))}
      </div>

      <div class="bg-slate-50 border border-slate-200 rounded-2xl p-8 mb-12 reveal">
        <h3 class="text-xl font-bold text-navy mb-4">Wij rijden naar Zaanstad</h3>
        <p class="text-sm text-slate-600">Vanaf Rotterdam ongeveer 1 uur 15 minuten via A4/A10/A8. Voor industriële kick-off workshops, complexe ERP-integraties of stakeholder-sessies in productiebedrijven komen wij ter plaatse. Wormerveer, Krommenie, Koog aan de Zaan, Westzaan en Wormerland vallen onder hetzelfde servicegebied.</p>
      </div>

      <div class="bg-brand-indigo/5 border border-brand-indigo/20 rounded-2xl p-6 mb-10 reveal">
        <p class="font-bold text-navy mb-2">Lokale AI use cases — Zaanstad</p>
        <ul class="text-sm text-slate-600 space-y-2 mt-3">
          <li><strong>Voedingsproducent Wormerveer:</strong> n8n-workflow logt HACCP-data automatisch, kwaliteitsmanager bespaart 12 uur per week.</li>
          <li><strong>Houtbedrijf Hoogtij:</strong> AI-receptionist beantwoordt offerte-aanvragen 24/7, conversie 35% hoger.</li>
          <li><strong>Webshop Zaandam:</strong> AI klantenservice handelt retouren, track-and-trace en standaardvragen autonoom af.</li>
          <li><strong>Familiebedrijf Krommenie:</strong> custom workflow integreert legacy-ERP met moderne CRM zonder bestaande processen te breken.</li>
        </ul>
      </div>

      <h2 class="text-2xl font-bold text-navy mb-6">Veelgestelde Vragen — AI Agency {city}</h2>
      <div class="space-y-3 mb-8">
        {faqItems.map(item => (
          <details class="card group">
            <summary class="flex items-center justify-between cursor-pointer list-none">
              <span class="text-sm font-bold text-navy pr-6">{item.question}</span>
              <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <p class="mt-4 text-sm text-slate-600 leading-relaxed">{item.answer}</p>
          </details>
        ))}
      </div>

      <div class="bg-slate-50 border border-slate-200 rounded-xl p-6">
        <p class="text-sm font-bold text-navy mb-3">Andere locaties</p>
        <div class="flex flex-wrap gap-3 text-sm">
          <a href="/locaties/amsterdam/" class="text-brand-indigo hover:underline">Amsterdam</a>
          <a href="/locaties/haarlem/" class="text-brand-indigo hover:underline">Haarlem</a>
          <a href="/locaties/alkmaar/" class="text-brand-indigo hover:underline">Alkmaar</a>
          <a href="/locaties/almere/" class="text-brand-indigo hover:underline">Almere</a>
          <a href="/locaties/hilversum/" class="text-brand-indigo hover:underline">Hilversum</a>
          <a href="/locaties/lelystad/" class="text-brand-indigo hover:underline">Lelystad</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-tight bg-midnight text-pearl relative overflow-hidden">
    <div class="absolute inset-0 dot-grid opacity-[0.04]"></div>
    <div class="container-page relative max-w-3xl">
      <h2 class="text-3xl font-bold tracking-tightest text-pearl text-balance reveal">Zaans bedrijf? Start gratis.</h2>
      <p class="mt-4 text-slate-300 reveal reveal-delay-1">Gratis AI scan van 30 minuten. EU-data only, AVG-compliant. We laten zien welk proces het meest baat heeft bij AI.</p>
      <div class="mt-6 flex flex-col sm:flex-row gap-3 reveal reveal-delay-2">
        <a href="/aanvragen/" class="btn bg-pearl text-navy hover:bg-white text-base px-6 py-3.5">Gratis AI Scan<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></a>
        <a href="/diensten/" class="btn border border-slate-700 text-pearl hover:bg-slate-800 text-base px-6 py-3.5">Bekijk diensten</a>
        <a href="/prijzen/" class="btn border border-slate-700 text-pearl hover:bg-slate-800 text-base px-6 py-3.5">Bekijk prijzen</a>
      </div>
    </div>
  </section>
</BaseLayout>
