---
import BaseLayout from '../../layouts/BaseLayout.astro';
const city = "Lelystad";
const region = "Flevoland";
const localSchema = {
  '@context': 'https://schema.org', '@type': 'LocalBusiness',
  name: 'Aanloop AI — AI Agency Lelystad',
  url: 'https://aanloopai.nl/locaties/lelystad/',
  image: 'https://aanloopai.nl/logo-mark-light-1024.png',
  address: { '@type': 'PostalAddress', addressLocality: 'Lelystad', addressRegion: 'Flevoland', addressCountry: 'NL', postalCode: '8200-8244' },
  geo: { '@type': 'GeoCoordinates', latitude: '52.5185', longitude: '5.4714' },
  areaServed: { '@type': 'City', name: 'Lelystad' },
  priceRange: '€€',
  telephone: '+31624741597',
  email: 'hello@aanloopai.nl',
  openingHoursSpecification: { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '09:00', closes: '17:00' },
  sameAs: ['https://aanloopai.nl/'],
  author: { '@type': 'Person', '@id': 'https://aanloopai.nl/team/magahdogan/#person', name: 'Mustafa Agah Dogan' },
};
const faqItems = [
  { question: 'Werkt Aanloop AI voor bedrijven in Lelystad?', answer: 'Ja. Wij bedienen MKB in Lelystad, Dronten, Zeewolde en de gehele Flevoland-regio. Vanaf Rotterdam circa 1 uur 45 via A6/A1. Voor strategische sessies komen wij ter plaatse.' },
  { question: 'Welke Lelystadse sectoren bedient Aanloop AI?', answer: 'Lelystad heeft een sterk profiel in agrarisch (akkerbouw, melkveehouderij), logistiek (Lelystad Airport, Flevokust haven), provinciale overheid en groothandel. Wij implementeren AI voor klantenservice, supply-chain workflows en administratieve automatisering.' },
  { question: 'Werkt AI voor agrarische bedrijven in Flevoland?', answer: 'Ja. Akkerbouw- en melkveehouderijbedrijven hebben veel administratie (RVO-registratie, leveringen, contracten). Onze n8n-workflows automatiseren rapportages, facturatie en supplier-communicatie zonder dat de boer een nieuw systeem moet leren.' },
  { question: 'Wat kost AI voor een Lelystads MKB-bedrijf?', answer: 'Tarieven landelijk uniform: Emma €497/maand, Groei €997/maand. Geen toeslag voor Flevoland. Voor seizoengevoelige agrarische bedrijven bieden wij flexibele opschaal-opties.' },
  { question: 'Hoe verloopt AI-implementatie voor een Flevolands bedrijf?', answer: 'Standaard 7 werkdagen na de gratis AI scan. Implementatie remote, met optionele on-site sessies in Lelystad voor stakeholder-workshops.' },
];
---
<BaseLayout
  title="AI Agency Lelystad — AI Bureau & Automatisering MKB"
  description="AI bureau Lelystad: Aanloop AI helpt het MKB met AI-agents en automatisering. AI agency Lelystad — gratis AI-scan, live in 7-14 werkdagen."
  schema={localSchema}
  faqSchema={faqItems}
>
  <section class="border-b border-slate-200 hero-gradient">
    <div class="container-page py-16 lg:py-20">
      <div class="max-w-3xl">
        <div class="flex items-center gap-4 mb-6"><div class="accent-band"><span></span><span></span><span></span><span></span></div><span class="eyebrow">Locatie - {city} - {region}</span></div>
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tightest text-navy text-balance leading-[1.08] reveal reveal-delay-1">AI Agency {city}:<br/>AI voor Flevolands MKB</h1>
        <p class="mt-6 text-lg text-slate-600 leading-relaxed reveal reveal-delay-2">Aanloop AI bedient MKB-bedrijven in {city} en de Flevoland-regio met AI agents, voice AI en workflow automation. Hoofdstad van een jonge provincie met sterke agrarische sector, logistieke knooppunten en groeiend zakelijk MKB.</p>
        <div class="mt-8 flex flex-col sm:flex-row gap-3 reveal reveal-delay-3">
          <a href="/gratis-ai-scan/" class="btn-primary">Gratis AI Scan voor {city}<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></a>
          <a href="/tarieven/" class="btn-outline">Bekijk prijzen</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page max-w-4xl mx-auto">
      <div class="mb-10 reveal">
        <h2 class="text-2xl font-bold text-navy">AI voor Lelystadse bedrijven</h2>
        <p class="mt-3 text-slate-600">Lelystad is hoofdstad van Flevoland — Nederlands jongste provincie met een uniek economisch profiel. De omringende polders herbergen grootschalige akkerbouw en melkveehouderij, terwijl Lelystad zelf groeit als logistiek knooppunt (Lelystad Airport, Flevokust haven, distributie-MKB) en provinciaal bestuurscentrum. Daarnaast een groeiend zakelijk-dienstverleningscluster en retail rond Stadshart Lelystad.</p>
        <p class="mt-3 text-slate-600">Postcoderegio 8200-8244 valt binnen ons standaard servicegebied. Onze AI-implementaties zijn praktisch gericht op de Flevolandse realiteit: koppeling met agrarische ERP (Crop-R, Dairy Data), automatische RVO-rapportages, supply-chain workflows en EU-data only voor compliance-gevoelige sectoren.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 mb-12">
        {[
          { title: 'Agrarisch (Akkerbouw)', desc: 'n8n-workflow voor RVO-registratie, leveringen en supplier-communicatie. Koppeling Crop-R.', link: '/diensten/custom/' },
          { title: 'Melkveehouderij Flevoland', desc: 'AI-document agent voor facturen, contracten en compliance-rapportages.', link: '/sectoren/accountancy/' },
          { title: 'Logistiek Lelystad Airport', desc: 'AI workflow voor orderverwerking, ritplanning en facturatie. AVG-compliant.', link: '/sectoren/logistiek/' },
          { title: 'Groothandel Flevokust', desc: 'AI-receptionist voor offerte-aanvragen en orderintake. 24/7 bereikbaar.', link: '/diensten/emma/' },
          { title: 'Provincie & overheid-MKB', desc: 'AI voor leverancier-helpdesks en aanbestedingsadministratie.', link: '/diensten/emma/' },
          { title: 'ZZP Flevoland', desc: 'Betaalbare AI vanaf €497/maand. Emma-pakket inclusief setup.', link: '/sectoren/ai-voor-zzp/' },
        ].map(s => (
          <div class="card reveal">
            <h3 class="font-bold text-navy text-sm mb-2">{s.title}</h3>
            <p class="text-xs text-slate-600 mb-4">{s.desc}</p>
            <a href={s.link} class="text-xs font-medium text-brand-indigo hover:underline">AI in {city} bekijken →</a>
          </div>
        ))}
      </div>

      <div class="bg-slate-50 border border-slate-200 rounded-2xl p-8 mb-12 reveal">
        <h3 class="text-xl font-bold text-navy mb-4">Wij rijden naar Lelystad</h3>
        <p class="text-sm text-slate-600">Vanaf Rotterdam circa 1 uur 45 minuten via A6/A1/A27. Voor agrarische workshops, logistieke kick-offs of provinciale stakeholder-sessies komen wij ter plaatse. Dronten, Zeewolde, Almere en Urk vallen onder hetzelfde servicegebied.</p>
      </div>

      <div class="bg-brand-indigo/5 border border-brand-indigo/20 rounded-2xl p-6 mb-10 reveal">
        <p class="font-bold text-navy mb-2">Lokale AI use cases — Lelystad</p>
        <ul class="text-sm text-slate-600 space-y-2 mt-3">
          <li><strong>Akkerbouwbedrijf Flevopolder:</strong> n8n automatiseert RVO-rapportages en leverancier-orders, agrariër bespaart 10 uur administratie per week.</li>
          <li><strong>Melkveehouderij Dronten:</strong> AI-document agent verwerkt facturen direct in administratie, voorraadbeheer geautomatiseerd.</li>
          <li><strong>Logistieke MKB Flevokust:</strong> workflow synchroniseert orders met transportplanning, doorlooptijd halveert.</li>
          <li><strong>Groothandel Lelystad-Noord:</strong> AI-receptionist beantwoordt offertes 24/7, conversie 35% hoger.</li>
        </ul>
      </div>

      <h2 class="text-2xl font-bold text-navy mb-6">Veelgestelde Vragen — AI Agency {city}</h2>
      <div class="space-y-3 mb-8">
        {faqItems.map(item => (
          <details class="card group">
            <summary class="flex items-center justify-between cursor-pointer list-none">
              <span class="text-sm font-bold text-navy pr-6">{item.question}</span>
              <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <p class="mt-4 text-sm text-slate-600 leading-relaxed">{item.answer}</p>
          </details>
        ))}
      </div>

      <div class="bg-slate-50 border border-slate-200 rounded-xl p-6">
        <p class="text-sm font-bold text-navy mb-3">Andere locaties</p>
        <div class="flex flex-wrap gap-3 text-sm">
          <a href="/locaties/almere/" class="text-brand-indigo hover:underline">Almere</a>
          <a href="/locaties/zwolle/" class="text-brand-indigo hover:underline">Zwolle</a>
          <a href="/locaties/amersfoort/" class="text-brand-indigo hover:underline">Amersfoort</a>
          <a href="/locaties/emmen/" class="text-brand-indigo hover:underline">Emmen</a>
          <a href="/locaties/utrecht/" class="text-brand-indigo hover:underline">Utrecht</a>
          <a href="/locaties/leeuwarden/" class="text-brand-indigo hover:underline">Leeuwarden</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-slate-50 border-y border-slate-200">
    <div class="container-page max-w-4xl">
      <p class="eyebrow text-brand-indigo mb-2">Website + AI = 1 partner</p>
      <h2 class="text-2xl lg:text-3xl font-bold text-navy mb-4">Lelystads MKB kiest één partner voor website én AI</h2>
      <p class="text-slate-600 mb-8 leading-relaxed">Veel Lelystadse bedrijven (agrarisch, logistiek, zakelijk) hebben verouderde websites van lokale webbureaus, en sluiten daarnaast losse AI-leveranciers aan. Bij Aanloop AI is dat één traject: AI-ready website + Emma (telefoon + WhatsApp) in één pakket — bespaart op jaarbasis t.o.v. losse leveranciers, met één contract en één aanspreekpunt.</p>
      <div class="grid md:grid-cols-3 gap-4">
        <a href="/diensten/ai-website-bundel-mkb-nederland/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">AI-Website Bundel</h3>
          <p class="text-xs text-slate-600 mb-3">Website + Emma in 1 pakket. €4.950 setup + €397/mnd. Bespaart op jaarbasis.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk bundel →</span>
        </a>
        <a href="/diensten/website-laten-maken-mkb-nederland-2026/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">Website laten maken</h3>
          <p class="text-xs text-slate-600 mb-3">Astro/Next/WordPress AI-ready. Schema.org + Speakable + WCAG 2.2 AA + Core Web Vitals groen.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk pakketten →</span>
        </a>
        <a href="/cases/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">Combo-cases bekijken</h3>
          <p class="text-xs text-slate-600 mb-3">5 branche-scenarios met Website + AI bundel: detailhandel, zorg, horeca, advocatuur, accountancy.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk pakketten →</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section-tight bg-midnight text-pearl relative overflow-hidden">
    <div class="absolute inset-0 dot-grid opacity-[0.04]"></div>
    <div class="container-page relative max-w-3xl">
      <h2 class="text-3xl font-bold tracking-tightest text-pearl text-balance reveal">Bedrijf in Lelystad? Start gratis.</h2>
      <p class="mt-4 text-slate-300 reveal reveal-delay-1">Gratis AI scan van 30 minuten. EU-data, AVG-compliant. Wij koppelen aan agrarische, logistieke en zakelijke systemen.</p>
      <div class="mt-6 flex flex-col sm:flex-row gap-3 reveal reveal-delay-2">
        <a href="/aanvragen/" class="btn bg-pearl text-navy hover:bg-white text-base px-6 py-3.5">Gratis AI Scan<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></a>
        <a href="/diensten/" class="btn border border-slate-700 text-pearl hover:bg-slate-800 text-base px-6 py-3.5">Bekijk diensten</a>
        <a href="/tarieven/" class="btn border border-slate-700 text-pearl hover:bg-slate-800 text-base px-6 py-3.5">Bekijk prijzen</a>
      </div>
    </div>
  </section>
</BaseLayout>
