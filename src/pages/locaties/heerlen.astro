---
import BaseLayout from '../../layouts/BaseLayout.astro';
const city = "Heerlen";
const region = "Limburg";
const localSchema = {
  '@context': 'https://schema.org', '@type': 'LocalBusiness',
  name: 'Aanloop AI — AI Agency Heerlen',
  url: 'https://aanloopai.nl/locaties/heerlen/',
  image: 'https://aanloopai.nl/logo-mark-light-1024.png',
  address: { '@type': 'PostalAddress', addressLocality: 'Heerlen', addressRegion: 'Limburg', addressCountry: 'NL', postalCode: '6400-6422' },
  geo: { '@type': 'GeoCoordinates', latitude: '50.8882', longitude: '5.9795' },
  areaServed: { '@type': 'City', name: 'Heerlen' },
  priceRange: '€€',
  telephone: '+31624741597',
  email: 'hello@aanloopai.nl',
  openingHoursSpecification: { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '09:00', closes: '17:00' },
  sameAs: ['https://aanloopai.nl/'],
  author: { '@type': 'Person', '@id': 'https://aanloopai.nl/team/magahdogan/#person', name: 'Mustafa Agah Dogan' },
};
const faqItems = [
  { question: 'Werkt Aanloop AI voor bedrijven in Heerlen?', answer: 'Ja. Wij bedienen MKB in Heerlen, Kerkrade, Brunssum, Landgraaf en de Parkstad-regio. Vanaf Rotterdam circa 2 uur via A2/A76. Reistijd vanuit Aachen (DE) en Luik (BE) is voor uw klanten interessant — voor ons komen we ter plaatse voor strategische sessies.' },
  { question: 'Welke Heerlense sectoren bedient Aanloop AI?', answer: 'Heerlen heeft een sterke financiële sector (CBS, APG-pensioenuitvoerder, Belastingdienst), zorg (Zuyderland MC, GGD), zakelijke dienstverlening en retail rond het centrum. Wij implementeren AI voor klantenservice, document-automatisering en CRM-koppeling.' },
  { question: 'Werkt AI voor de Parkstad-grensregio?', answer: 'Zeker. De ligging tegen de Duitse en Belgische grens maakt drietalige (NL/DE/EN) AI-flows waardevol. Onze voice-AI ondersteunt grensoverschrijdende klantcommunicatie zonder dat u extra personeel hoeft aan te nemen.' },
  { question: 'Wat kost AI voor een Heerlens MKB-bedrijf?', answer: 'Tarieven landelijk uniform: Emma €497/maand, Groei €997/maand. Geen toeslag voor Limburg. Voor multinationals met BE/DE-klanten bieden wij meertalige uitbreidingen.' },
  { question: 'Hoe verloopt implementatie in Heerlen?', answer: '7 werkdagen na de gratis AI scan, identiek aan ons landelijke tempo. Implementatie remote, on-site sessies optioneel.' },
];
---
<BaseLayout
  title="AI Agency Heerlen — AI Bureau & Automatisering MKB"
  description="AI bureau Heerlen: Aanloop AI helpt het MKB met AI-agents en automatisering. AI agency Heerlen — gratis AI-scan, live in 7-14 werkdagen."
  schema={localSchema}
  faqSchema={faqItems}
>
  <section class="border-b border-slate-200 hero-gradient">
    <div class="container-page py-16 lg:py-20">
      <div class="max-w-3xl">
        <div class="flex items-center gap-4 mb-6"><div class="accent-band"><span></span><span></span><span></span><span></span></div><span class="eyebrow">Locatie - {city} - {region}</span></div>
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tightest text-navy text-balance leading-[1.08] reveal reveal-delay-1">AI Agency {city}:<br/>AI voor MKB in Parkstad Limburg</h1>
        <p class="mt-6 text-lg text-slate-600 leading-relaxed reveal reveal-delay-2">Aanloop AI bedient MKB-bedrijven in {city} en de Parkstad-regio met AI agents, voice AI en workflow automation. Drietalige ondersteuning voor de grens met Duitsland en België — relevant voor zorg, financiën en zakelijke dienstverlening.</p>
        <div class="mt-8 flex flex-col sm:flex-row gap-3 reveal reveal-delay-3">
          <a href="/gratis-ai-scan/" class="btn-primary">Gratis AI Scan voor {city}<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></a>
          <a href="/tarieven/" class="btn-outline">Bekijk prijzen</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page max-w-4xl mx-auto">
      <div class="mb-10 reveal">
        <h2 class="text-2xl font-bold text-navy">AI voor Heerlense bedrijven</h2>
        <p class="mt-3 text-slate-600">Heerlen is centrumstad van Parkstad Limburg en huisvest opvallend veel grote organisaties: CBS, APG (pensioenuitvoerder ABP), Belastingdienst, Open Universiteit. Daaromheen een sterk MKB in zakelijke dienstverlening, financieel advies, zorg (Zuyderland MC), retail en horeca. De ligging dicht bij Aken (DE) en Luik (BE) maakt grensoverschrijdende dienstverlening een continue factor.</p>
        <p class="mt-3 text-slate-600">Postcoderegio 6400-6422 valt binnen ons standaard servicegebied. Voor Heerlense MKB ligt de AI-winst in: drietalige voice-AI (NL/DE/EN), AVG-compliant document-automatisering voor financiële en zorgdienstverleners, en CRM-integratie voor zakelijke kantoren.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 mb-12">
        {[
          { title: 'Financiële Dienstverlening', desc: 'AI-intake voor klantvragen rond pensioen, hypotheek en verzekering. CRM-koppeling.', link: '/sectoren/accountancy/' },
          { title: 'Zorg & Medisch', desc: 'Voice-AI voor huisartsenpraktijken en specialisten. Drietalige triage, AVG-compliant.', link: '/sectoren/zorg/' },
          { title: 'Grensoverschrijdend MKB', desc: 'Voice-AI met NL/DE/EN-flow. Voor klanten in Aken, Luik en Maastricht.', link: '/diensten/emma/' },
          { title: 'Advocatenkantoren', desc: 'AI-document agent voor contract-classificatie en cliëntdossiers.', link: '/sectoren/ai-voor-advocaten/' },
          { title: 'Retail & Horeca centrum', desc: 'WhatsApp AI voor reserveringen en klantvragen. 24/7 bereikbaar.', link: '/sectoren/horeca/' },
          { title: 'ZZP Parkstad', desc: 'Betaalbare AI vanaf €497/maand. Emma-pakket inclusief setup.', link: '/sectoren/ai-voor-zzp/' },
        ].map(s => (
          <div class="card reveal">
            <h3 class="font-bold text-navy text-sm mb-2">{s.title}</h3>
            <p class="text-xs text-slate-600 mb-4">{s.desc}</p>
            <a href={s.link} class="text-xs font-medium text-brand-indigo hover:underline">AI in {city} bekijken →</a>
          </div>
        ))}
      </div>

      <div class="bg-slate-50 border border-slate-200 rounded-2xl p-8 mb-12 reveal">
        <h3 class="text-xl font-bold text-navy mb-4">Wij rijden naar Heerlen</h3>
        <p class="text-sm text-slate-600">Vanaf Rotterdam circa 2 uur via A2/A76. Voor strategische workshops, complexe drietalige implementaties of stakeholder-sessies in zorg- en financiële sector komen wij ter plaatse. Kerkrade, Brunssum, Landgraaf, Voerendaal en Hoensbroek vallen onder hetzelfde servicegebied.</p>
      </div>

      <div class="bg-brand-indigo/5 border border-brand-indigo/20 rounded-2xl p-6 mb-10 reveal">
        <p class="font-bold text-navy mb-2">Lokale AI use cases — Heerlen</p>
        <ul class="text-sm text-slate-600 space-y-2 mt-3">
          <li><strong>Pensioenadviseur centrum:</strong> AI-intake screent klantvragen, doorlooptijd 50% korter, compliance-trail automatisch.</li>
          <li><strong>Huisartsenpraktijk Heerlerheide:</strong> drietalige voice-AI (NL/DE/EN) vangt 70% van standaardvragen op.</li>
          <li><strong>Advocatenkantoor centrum:</strong> AI-document agent classificeert binnenkomende stukken, partners besparen 10 uur per week.</li>
          <li><strong>Grenshandel-MKB:</strong> n8n synchroniseert orders en facturen tussen NL/DE-systemen, douane-trail automatisch.</li>
        </ul>
      </div>

      <h2 class="text-2xl font-bold text-navy mb-6">Veelgestelde Vragen — AI Agency {city}</h2>
      <div class="space-y-3 mb-8">
        {faqItems.map(item => (
          <details class="card group">
            <summary class="flex items-center justify-between cursor-pointer list-none">
              <span class="text-sm font-bold text-navy pr-6">{item.question}</span>
              <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <p class="mt-4 text-sm text-slate-600 leading-relaxed">{item.answer}</p>
          </details>
        ))}
      </div>

      <div class="bg-slate-50 border border-slate-200 rounded-xl p-6">
        <p class="text-sm font-bold text-navy mb-3">Andere locaties</p>
        <div class="flex flex-wrap gap-3 text-sm">
          <a href="/locaties/maastricht/" class="text-brand-indigo hover:underline">Maastricht</a>
          <a href="/locaties/sittard-geleen/" class="text-brand-indigo hover:underline">Sittard-Geleen</a>
          <a href="/locaties/venlo/" class="text-brand-indigo hover:underline">Venlo</a>
          <a href="/locaties/eindhoven/" class="text-brand-indigo hover:underline">Eindhoven</a>
          <a href="/locaties/den-bosch/" class="text-brand-indigo hover:underline">Den Bosch</a>
          <a href="/locaties/nijmegen/" class="text-brand-indigo hover:underline">Nijmegen</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-slate-50 border-y border-slate-200">
    <div class="container-page max-w-4xl">
      <p class="eyebrow text-brand-indigo mb-2">Website + AI = 1 partner</p>
      <h2 class="text-2xl lg:text-3xl font-bold text-navy mb-4">Heerlens MKB kiest één partner voor website én AI</h2>
      <p class="text-slate-600 mb-8 leading-relaxed">Veel Heerlense bedrijven (zorg + Limburgs zakelijk) hebben verouderde websites van lokale webbureaus, en sluiten daarnaast losse AI-leveranciers aan. Bij Aanloop AI is dat één traject: AI-ready website + Emma (telefoon + WhatsApp) in één pakket — bespaart op jaarbasis t.o.v. losse leveranciers, met één contract en één aanspreekpunt.</p>
      <div class="grid md:grid-cols-3 gap-4">
        <a href="/diensten/ai-website-bundel-mkb-nederland/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">AI-Website Bundel</h3>
          <p class="text-xs text-slate-600 mb-3">Website + Emma in 1 pakket. €5.950 setup + €649/mnd all-in. Eén factuur, één SLA.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk bundel →</span>
        </a>
        <a href="/diensten/website-laten-maken-mkb-nederland-2026/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">Website laten maken</h3>
          <p class="text-xs text-slate-600 mb-3">Astro/Next/WordPress AI-ready. Schema.org + Speakable + WCAG 2.2 AA + Core Web Vitals groen.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk pakketten →</span>
        </a>
        <a href="/cases/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">Combo-cases bekijken</h3>
          <p class="text-xs text-slate-600 mb-3">5 branche-scenarios met Website + AI bundel: detailhandel, zorg, horeca, advocatuur, accountancy.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk pakketten →</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section-tight bg-midnight text-pearl relative overflow-hidden">
    <div class="absolute inset-0 dot-grid opacity-[0.04]"></div>
    <div class="container-page relative max-w-3xl">
      <h2 class="text-3xl font-bold tracking-tightest text-pearl text-balance reveal">Bedrijf in Heerlen? Start gratis.</h2>
      <p class="mt-4 text-slate-300 reveal reveal-delay-1">Gratis AI scan van 30 minuten. Drietalige flows, EU-data, AVG-compliant. Voor Limburgs zakelijk en zorg-MKB.</p>
      <div class="mt-6 flex flex-col sm:flex-row gap-3 reveal reveal-delay-2">
        <a href="/aanvragen/" class="btn bg-pearl text-navy hover:bg-white text-base px-6 py-3.5">Gratis AI Scan<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></a>
        <a href="/diensten/" class="btn border border-slate-700 text-pearl hover:bg-slate-800 text-base px-6 py-3.5">Bekijk diensten</a>
        <a href="/tarieven/" class="btn border border-slate-700 text-pearl hover:bg-slate-800 text-base px-6 py-3.5">Bekijk prijzen</a>
      </div>
    </div>
  </section>
</BaseLayout>
