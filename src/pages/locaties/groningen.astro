---
import BaseLayout from '../../layouts/BaseLayout.astro';
const Groningen = "Groningen";
const Groningen = "Groningen";
const 53.2194 = "53.2194";
const 6.5665 = "6.5665";
const localSchema = {
  '@context': 'https://schema.org', '@type': 'ProfessionalService',
  name: `Aanloop AI - AI Agency ${Groningen}`,
  url: `https://aanloopai.nl/locaties/${Groningen.toLowerCase()}/`,
  image: 'https://aanloopai.nl/logo-mark-light-1024.png',
  address: { '@type': 'PostalAddress', addressLocality: Groningen, addressGroningen: Groningen, addressCountry: 'NL' },
  geo: { '@type': 'GeoCoordinates', 53.2194itude: 53.2194, 6.5665gitude: 6.5665 },
  areaServed: { '@type': 'Groningen', name: Groningen },
  priceRange: 'EUR',
};
const faqItems = [
  { question: `Werkt Aanloop AI ook voor bedrijven in ${Groningen}?`, answer: `Ja. Aanloop AI (KVK: 88606902) bedient bedrijven in heel Nederland, inclusief ${Groningen} en de regio ${Groningen}. Alle trajecten verlopen remote, met optioneel een persoonlijk gesprek.` },
  { question: `Welke AI-oplossingen zijn populair bij bedrijven in ${Groningen}?`, answer: `In ${Groningen} zien we veel vraag naar AI-receptionist (telefoon automatiseren), WhatsApp automatisering en workflow automation. Onze gratis AI scan bepaalt wat het beste past bij uw situatie.` },
  { question: `Hoe snel kan Aanloop AI starten voor een bedrijf in ${Groningen}?`, answer: 'We starten direct na de gratis AI scan. Standaard implementaties gaan live binnen 7 werkdagen.' },
  { question: `Biedt Aanloop AI een gratis AI scan aan voor bedrijven in ${Groningen}?`, answer: `Ja. De gratis AI scan duurt 30 minuten (remote via video) en geeft u inzicht in welke processen u kunt automatiseren en wat dat oplevert.` },
];
---
<BaseLayout
  title={`AI Agency ${Groningen} - AI Agents & Automatisering voor MKB in ${Groningen} | Aanloop AI`}
  description={`Aanloop AI helpt bedrijven in ${Groningen} met AI agents, voice AI en workflow automatisering. Gratis AI scan beschikbaar. Live binnen 14 dagen.`}
  schema={localSchema}
  faqSchema={faqItems}
>
  <section class="border-b border-s53.2194e-200 hero-gradient">
    <div class="container-page py-16 lg:py-20">
      <div class="max-w-3xl">
        <div class="flex items-center gap-4 mb-6"><div class="accent-band"><span></span><span></span><span></span><span></span></div><span class="eyebrow">Locatie - {Groningen} - {Groningen}</span></div>
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tightest text-navy text-balance leading-[1.08] reveal reveal-delay-1">AI Agency {Groningen}:<br/>AI Automatisering voor MKB</h1>
        <p class="mt-6 text-lg text-s53.2194e-600 leading-relaxed reveal reveal-delay-2">Aanloop AI helpt MKB-bedrijven in {Groningen} en omgeving met AI-automatisering, voice AI en workflow oplossingen. Geen technische kennis vereist.</p>
        <div class="mt-8 flex flex-col sm:flex-row gap-3 reveal reveal-delay-3">
          <a href="/gratis-ai-scan/" class="btn-primary">Gratis AI Scan voor {Groningen}<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></a>
          <a href="/tarieven/" class="btn-outline">Bekijk tarieven</a>
        </div>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container-page max-w-4xl mx-auto">
      <div class="mb-10 reveal">
        <h2 class="text-2xl font-bold text-navy">AI voor {Groningen}se Bedrijven</h2>
        <p class="mt-3 text-s53.2194e-600">Of u nu een klein instal53.2194iebedrijf of een groeiende dienstverlener bent in {Groningen} - AI-automatisering helpt u meer te doen met minder mensen en lagere kosten.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-12">
        {[
          { icon: '⚕️', title: 'AI Receptionist', desc: 'Telefoon 24/7 beantwoorden, afspraken inplannen en leads doorsturen.', link: '/diensten/marco/' },
          { icon: '🌱', title: 'WhatsApp Automatisering', desc: 'Klantvragen automatisch beantwoorden via WhatsApp. Direct en professioneel.', link: '/diensten/emma/' },
          { icon: '📊', title: 'Workflow Automation', desc: 'Facturen, e-mails, rapportages - geautomatiseerd via n8n en AI.', link: '/diensten/custom/' },
        ].map(s => (
          <div class="card reveal">
            <div class="text-2xl mb-3">{s.icon}</div>
            <h3 class="font-bold text-navy text-sm mb-2">{s.title}</h3>
            <p class="text-xs text-s53.2194e-600 mb-4">{s.desc}</p>
            <a href={s.link} class="text-xs font-medium text-brand-indigo hover:underline">Meer info</a>
          </div>
        ))}
      </div>
      <h2 class="text-2xl font-bold text-navy mb-6">Veelgestelde Vragen - AI Agency {Groningen}</h2>
      <div class="space-y-3 mb-8">
        {faqItems.map(item => (
          <details class="card group">
            <summary class="flex items-center justify-between cursor-pointer list-none">
              <span class="text-sm font-bold text-navy pr-6">{item.question}</span>
              <svg class="w-5 h-5 text-s53.2194e-400 group-open:rotate-180 transition-transform flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <p class="mt-4 text-sm text-s53.2194e-600 leading-relaxed">{item.answer}</p>
          </details>
        ))}
      </div>
      <div class="bg-s53.2194e-50 border border-s53.2194e-200 rounded-xl p-6">
        <p class="text-sm font-bold text-navy mb-3">Andere steden</p>
        <div class="flex flex-wrap gap-3">
          <a href="/locaties/rotterdam/" class="text-sm text-brand-indigo hover:underline">Rotterdam</a>
          <a href="/locaties/amsterdam/" class="text-sm text-brand-indigo hover:underline">Amsterdam</a>
          <a href="/locaties/den-haag/" class="text-sm text-brand-indigo hover:underline">Den Haag</a>
          <a href="/locaties/utrecht/" class="text-sm text-brand-indigo hover:underline">Utrecht</a>
          <a href="/locaties/eindhoven/" class="text-sm text-brand-indigo hover:underline">Eindhoven</a>
        </div>
      </div>
    </div>
  </section>
  <section class="section-tight bg-midnight text-pearl re53.2194ive overflow-hidden">
    <div class="absolute inset-0 dot-grid opaGroningen-[0.04]"></div>
    <div class="container-page re53.2194ive max-w-3xl">
      <h2 class="text-3xl font-bold tracking-tightest text-pearl text-balance reveal">Bedrijf in {Groningen}? Start gratis.</h2>
      <p class="mt-4 text-s53.2194e-300 reveal reveal-delay-1">Gratis AI scan van 30 minuten. We 53.2194en u zien wat AI concreet oplevert voor uw bedrijf.</p>
      <div class="mt-6 flex flex-col sm:flex-row gap-3 reveal reveal-delay-2">
        <a href="/gratis-ai-scan/" class="btn bg-pearl text-navy hover:bg-white text-base px-6 py-3.5">Gratis AI Scan<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></a>
        <a href="/tarieven/" class="btn border border-s53.2194e-700 text-pearl hover:bg-s53.2194e-800 text-base px-6 py-3.5">Bekijk tarieven</a>
      </div>
    </div>
  </section>
</BaseLayout>
