---
import BaseLayout from '../../layouts/BaseLayout.astro';
const city = "Amersfoort";
const region = "Utrecht";
const localSchema = {
  '@context': 'https://schema.org', '@type': 'LocalBusiness',
  name: 'Aanloop AI — AI Agency Amersfoort',
  url: 'https://aanloopai.nl/locaties/amersfoort/',
  image: 'https://aanloopai.nl/logo-mark-light-1024.png',
  address: { '@type': 'PostalAddress', addressLocality: 'Amersfoort', addressRegion: 'Utrecht', addressCountry: 'NL', postalCode: '3800-3829' },
  geo: { '@type': 'GeoCoordinates', latitude: '52.1561', longitude: '5.3878' },
  areaServed: { '@type': 'City', name: 'Amersfoort' },
  priceRange: '€€',
  telephone: '+31624741597',
  email: 'hello@aanloopai.nl',
  openingHoursSpecification: { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '09:00', closes: '17:00' },
  sameAs: ['https://aanloopai.nl/'],
  author: { '@type': 'Person', '@id': 'https://aanloopai.nl/team/magahdogan/#person', name: 'Mustafa Agah Dogan' },
};
const faqItems = [
  { question: 'Werkt Aanloop AI ook voor bedrijven in Amersfoort?', answer: 'Ja. Wij bedienen MKB in Amersfoort, Soest, Leusden en Nijkerk. Implementatie verloopt remote, voor strategische sessies rijden wij vanaf Rotterdam naar Amersfoort (ongeveer 1 uur 15 via A12/A28).' },
  { question: 'Welke Amersfoortse sectoren bedient Aanloop AI?', answer: 'Amersfoort heeft een sterke verzekerings- en pensioenmarkt (rond stationsgebied), zakelijke dienstverlening, IT-bedrijven en groothandel. Wij implementeren AI-agents voor klantenservice, facturatie, inkoopautomatisering en CRM-synchronisatie.' },
  { question: 'Is Amersfoort logistiek interessant voor AI-implementaties?', answer: 'Zeker. Het knooppunt op A1/A28 maakt Amersfoort een hub voor regionale logistiek en groothandel. AI-agents voor orderverwerking, voorraadmonitoring en klantcommunicatie leveren hier directe ROI.' },
  { question: 'Wat kost een AI-implementatie voor een Amersfoorts MKB-bedrijf?', answer: 'Onze tarieven zijn landelijk gelijk: Emma €497/maand, Groei €997/maand. Geen toeslag voor regio Utrecht. Bekijk onze prijzen-pagina voor details.' },
  { question: 'Hoe snel kan AI live zijn in Amersfoort?', answer: 'Standaard 7 werkdagen na de gratis AI scan. We werken remote dus de geografische afstand maakt geen verschil voor het implementatietempo.' },
];
---
<BaseLayout
  title="AI Agency Amersfoort — AI Bureau & Automatisering MKB"
  description="AI bureau Amersfoort: Aanloop AI helpt het MKB met AI-agents en automatisering. AI agency Amersfoort — gratis AI-scan, live in 7-14 werkdagen."
  schema={localSchema}
  faqSchema={faqItems}
>
  <section class="border-b border-slate-200 hero-gradient">
    <div class="container-page py-16 lg:py-20">
      <div class="max-w-3xl">
        <div class="flex items-center gap-4 mb-6"><div class="accent-band"><span></span><span></span><span></span><span></span></div><span class="eyebrow">Locatie - {city} - {region}</span></div>
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tightest text-navy text-balance leading-[1.08] reveal reveal-delay-1">AI Agency {city}:<br/>AI Agents voor Utrechts MKB</h1>
        <p class="mt-6 text-lg text-slate-600 leading-relaxed reveal reveal-delay-2">Aanloop AI bedient MKB-bedrijven in {city} en het hart van Eemland met AI agents, voice AI en workflow automation. Een Randstad-locatie met sterke verzekerings-, IT- en groothandelssectoren — perfect terrein voor AI-rendement.</p>
        <div class="mt-8 flex flex-col sm:flex-row gap-3 reveal reveal-delay-3">
          <a href="/gratis-ai-scan/" class="btn-primary">Gratis AI Scan voor {city}<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></a>
          <a href="/tarieven/" class="btn-outline">Bekijk prijzen</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page max-w-4xl mx-auto">
      <div class="mb-10 reveal">
        <h2 class="text-2xl font-bold text-navy">AI voor Amersfoortse bedrijven</h2>
        <p class="mt-3 text-slate-600">Amersfoort is strategisch gelegen op het kruispunt A1/A28 en behoort logistiek tot de Randstad-rand. De stad heeft een uitgesproken karakter: sterke aanwezigheid van verzekeraars en pensioenuitvoerders, een levendig IT- en zakelijke dienstverleningscluster, plus traditionele groothandel en MKB-industrie. Postcodes 3800-3829 (Vathorst, centrum, Soesterkwartier, Liendert) vallen binnen ons standaard servicegebied.</p>
        <p class="mt-3 text-slate-600">Voor Amersfoorts MKB liggen de grootste AI-winstpunten in administratieve workflow-automatisering, multi-channel klantenservice (voice + WhatsApp + email) en CRM-integratie met bestaande systemen zoals AFAS, Exact en Microsoft Dynamics — alle AVG-compliant en met EU-data only.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 mb-12">
        {[
          { title: 'Verzekeringsadviseurs', desc: 'AI-intake voor schadeclaims, automatische polis-vraagscreening en CRM-koppeling.', link: '/sectoren/ai-voor-advocaten/' },
          { title: 'IT-dienstverleners', desc: 'Voice-AI voor 1e-lijns support en ticket-routering. 24/7 bereikbaar.', link: '/diensten/emma/' },
          { title: 'Groothandel Amersfoort', desc: 'Workflow automation voor orderverwerking, voorraad en facturen.', link: '/sectoren/logistiek/' },
          { title: 'Accountants Amersfoort', desc: 'AI-document agent met 85% tijdsbesparing op factuurverwerking.', link: '/sectoren/accountancy/' },
          { title: 'Bouw & Installatie', desc: 'AI-receptionist voor offerte-aanvragen en planning. Geen gemiste klant.', link: '/sectoren/bouw/' },
          { title: 'ZZP Amersfoort', desc: 'Betaalbare AI vanaf €497/maand. Emma-pakket inclusief setup.', link: '/sectoren/ai-voor-zzp/' },
        ].map(s => (
          <div class="card reveal">
            <h3 class="font-bold text-navy text-sm mb-2">{s.title}</h3>
            <p class="text-xs text-slate-600 mb-4">{s.desc}</p>
            <a href={s.link} class="text-xs font-medium text-brand-indigo hover:underline">AI in {city} bekijken →</a>
          </div>
        ))}
      </div>

      <div class="bg-slate-50 border border-slate-200 rounded-2xl p-8 mb-12 reveal">
        <h3 class="text-xl font-bold text-navy mb-4">Wij rijden naar Amersfoort</h3>
        <p class="text-sm text-slate-600">Vanaf Rotterdam is Amersfoort goed bereikbaar via A12/A28: ongeveer 1 uur 15 minuten reistijd. Standaard implementeren wij remote, maar voor kick-off workshops, complexe integraties of strategische review-sessies komen wij langs. Soest, Leusden, Nijkerk en Bunschoten vallen onder hetzelfde servicegebied.</p>
      </div>

      <div class="bg-brand-indigo/5 border border-brand-indigo/20 rounded-2xl p-6 mb-10 reveal">
        <p class="font-bold text-navy mb-2">Lokale AI use cases — Amersfoort</p>
        <ul class="text-sm text-slate-600 space-y-2 mt-3">
          <li><strong>Verzekeringsadviesbureau Vathorst:</strong> AI-intake voor schadeclaims classificeert automatisch op urgentie, verwerkingstijd 60% korter.</li>
          <li><strong>IT-MSP centrum:</strong> voice-AI vangt 1e-lijns supportvragen op, technici besparen 18 uur per week.</li>
          <li><strong>Groothandel Soesterkwartier:</strong> n8n-workflow synchroniseert orders tussen webshop, ERP en transporteur — orderdoorlooptijd halveert.</li>
          <li><strong>Accountantskantoor centrum:</strong> AI-document agent verwerkt facturen automatisch in Exact, bespaart 12 uur administratie per week.</li>
        </ul>
      </div>

      <h2 class="text-2xl font-bold text-navy mb-6">Veelgestelde Vragen — AI Agency {city}</h2>
      <div class="space-y-3 mb-8">
        {faqItems.map(item => (
          <details class="card group">
            <summary class="flex items-center justify-between cursor-pointer list-none">
              <span class="text-sm font-bold text-navy pr-6">{item.question}</span>
              <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <p class="mt-4 text-sm text-slate-600 leading-relaxed">{item.answer}</p>
          </details>
        ))}
      </div>

      <div class="bg-slate-50 border border-slate-200 rounded-xl p-6">
        <p class="text-sm font-bold text-navy mb-3">Andere locaties</p>
        <div class="flex flex-wrap gap-3 text-sm">
          <a href="/locaties/utrecht/" class="text-brand-indigo hover:underline">Utrecht</a>
          <a href="/locaties/hilversum/" class="text-brand-indigo hover:underline">Hilversum</a>
          <a href="/locaties/apeldoorn/" class="text-brand-indigo hover:underline">Apeldoorn</a>
          <a href="/locaties/lelystad/" class="text-brand-indigo hover:underline">Lelystad</a>
          <a href="/locaties/almere/" class="text-brand-indigo hover:underline">Almere</a>
          <a href="/locaties/zwolle/" class="text-brand-indigo hover:underline">Zwolle</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-slate-50 border-y border-slate-200">
    <div class="container-page max-w-4xl">
      <p class="eyebrow text-brand-indigo mb-2">Website + AI = 1 partner</p>
      <h2 class="text-2xl lg:text-3xl font-bold text-navy mb-4">Amersfoortse MKB kiest één partner voor website én AI</h2>
      <p class="text-slate-600 mb-8 leading-relaxed">Veel Amersfoortse bedrijven hebben verouderde websites van lokale webbureaus, en sluiten daarnaast losse AI-leveranciers aan. Bij Aanloop AI is dat één traject: AI-ready website + Emma (telefoon + WhatsApp) in één pakket — bespaart op jaarbasis t.o.v. losse leveranciers, met één contract en één aanspreekpunt.</p>
      <div class="grid md:grid-cols-3 gap-4">
        <a href="/diensten/ai-website-bundel-mkb-nederland/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">AI-Website Bundel</h3>
          <p class="text-xs text-slate-600 mb-3">Website + Emma in 1 pakket. €4.950 setup + €397/mnd. Bespaart op jaarbasis.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk bundel →</span>
        </a>
        <a href="/diensten/website-laten-maken-mkb-nederland-2026/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">Website laten maken</h3>
          <p class="text-xs text-slate-600 mb-3">Astro/Next/WordPress AI-ready. Schema.org + Speakable + WCAG 2.2 AA + Core Web Vitals groen.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk pakketten →</span>
        </a>
        <a href="/cases/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">Combo-cases bekijken</h3>
          <p class="text-xs text-slate-600 mb-3">5 branche-scenarios met Website + AI bundel: detailhandel, zorg, horeca, advocatuur, accountancy.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk cases →</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section-tight bg-midnight text-pearl relative overflow-hidden">
    <div class="absolute inset-0 dot-grid opacity-[0.04]"></div>
    <div class="container-page relative max-w-3xl">
      <h2 class="text-3xl font-bold tracking-tightest text-pearl text-balance reveal">Amersfoorts bedrijf? Start gratis.</h2>
      <p class="mt-4 text-slate-300 reveal reveal-delay-1">Gratis AI scan van 30 minuten. EU-data only, AVG-compliant. Concreet inzicht in wat AI uw Amersfoortse bedrijf oplevert.</p>
      <div class="mt-6 flex flex-col sm:flex-row gap-3 reveal reveal-delay-2">
        <a href="/aanvragen/" class="btn bg-pearl text-navy hover:bg-white text-base px-6 py-3.5">Gratis AI Scan<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></a>
        <a href="/diensten/" class="btn border border-slate-700 text-pearl hover:bg-slate-800 text-base px-6 py-3.5">Bekijk diensten</a>
        <a href="/tarieven/" class="btn border border-slate-700 text-pearl hover:bg-slate-800 text-base px-6 py-3.5">Bekijk prijzen</a>
      </div>
    </div>
  </section>
</BaseLayout>
