---
import BaseLayout from '../../layouts/BaseLayout.astro';
const city = "Sittard-Geleen";
const region = "Limburg";
const localSchema = {
  '@context': 'https://schema.org', '@type': 'LocalBusiness',
  name: 'Aanloop AI — AI Agency Sittard-Geleen',
  url: 'https://aanloopai.nl/locaties/sittard-geleen/',
  image: 'https://aanloopai.nl/logo-mark-light-1024.png',
  address: { '@type': 'PostalAddress', addressLocality: 'Sittard', addressRegion: 'Limburg', addressCountry: 'NL', postalCode: '6130-6166' },
  geo: { '@type': 'GeoCoordinates', latitude: '50.9983', longitude: '5.8606' },
  areaServed: { '@type': 'City', name: 'Sittard-Geleen' },
  priceRange: '€€',
  telephone: '+31624741597',
  email: 'hello@aanloopai.nl',
  openingHoursSpecification: { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '09:00', closes: '17:00' },
  sameAs: ['https://aanloopai.nl/'],
  author: { '@type': 'Person', '@id': 'https://aanloopai.nl/team/daan-verhoeven/#person', name: 'Daan Verhoeven' },
};
const faqItems = [
  { question: 'Werkt Aanloop AI voor bedrijven in Sittard-Geleen?', answer: 'Ja. Wij bedienen MKB in Sittard, Geleen, Born, Stein en de gehele Westelijke Mijnstreek. Vanaf Rotterdam circa 1 uur 50 via A2/A76. Onze voice-AI is tweetalig NL/DE — relevant voor Chemelot-toeleveranciers en grensregio.' },
  { question: 'Welke Sittard-Geleense sectoren zijn relevant voor AI?', answer: 'Sittard-Geleen huisvest het Chemelot-industriepark (DSM, OCI, Sabic, AnQore) en heeft daaromheen een uitgebreide cluster maakindustrie, technische dienstverleners, logistiek en zakelijke dienstverlening. Wij implementeren AI voor compliance-rapportages, supplier-communicatie en orderverwerking.' },
  { question: 'Werkt AI voor Chemelot-toeleveranciers?', answer: 'Zeker. Chemie-toeleveranciers hebben strenge compliance-eisen (REACH, ATEX, ISO). Onze workflow automation logt rapportages automatisch, koppelt aan ERP en levert audit-trail zonder dat operators extra werk hebben.' },
  { question: 'Wat kost AI voor een Sittard-Geleens MKB-bedrijf?', answer: 'Tarieven landelijk uniform: Starter €597/maand, Groei €1.197/maand. Voor industriële bedrijven met complexe compliance-eisen bieden wij custom-trajecten via onze maatwerk-route.' },
  { question: 'Hoe verloopt AI-implementatie voor industriële bedrijven?', answer: 'Voor Chemelot-toeleveranciers en industrieel MKB doorlopen wij een DPIA-check vooraf, gevolgd door 7-werkdagen implementatie. Sandboxen voor productie-omgevingen mogelijk.' },
];
---
<BaseLayout
  title="AI Agency Sittard-Geleen — AI voor Chemelot-toeleveranciers en MKB | Aanloop AI"
  description="Aanloop AI helpt MKB in Sittard, Geleen en Born met AI agents, voice AI en workflow automation. Voor Chemelot-toeleveranciers, maakindustrie en logistiek. AVG en compliance-trail."
  schema={localSchema}
  faqSchema={faqItems}
>
  <section class="border-b border-slate-200 hero-gradient">
    <div class="container-page py-16 lg:py-20">
      <div class="max-w-3xl">
        <div class="flex items-center gap-4 mb-6"><div class="accent-band"><span></span><span></span><span></span><span></span></div><span class="eyebrow">Locatie - {city} - {region}</span></div>
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tightest text-navy text-balance leading-[1.08] reveal reveal-delay-1">AI Agency {city}:<br/>AI voor Chemelot en Limburgs Industrieel MKB</h1>
        <p class="mt-6 text-lg text-slate-600 leading-relaxed reveal reveal-delay-2">Aanloop AI bedient MKB in {city} en de Westelijke Mijnstreek met AI agents, voice AI en workflow automation. Industrieel zwaartepunt rond Chemelot — AI met compliance-trail, AVG-conform en koppeling met legacy ERP-systemen.</p>
        <div class="mt-8 flex flex-col sm:flex-row gap-3 reveal reveal-delay-3">
          <a href="/gratis-ai-scan/" class="btn-primary">Gratis AI Scan voor Sittard<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></a>
          <a href="/prijzen/" class="btn-outline">Bekijk prijzen</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page max-w-4xl mx-auto">
      <div class="mb-10 reveal">
        <h2 class="text-2xl font-bold text-navy">AI voor Sittard-Geleense bedrijven</h2>
        <p class="mt-3 text-slate-600">Sittard-Geleen is met afstand het industriële zwaartepunt van Limburg. Het Chemelot-park (DSM, OCI, Sabic, AnQore en circa 60 andere chemiebedrijven) genereert een uitgebreide schil van toeleveranciers, technische dienstverleners en specialistische logistiek. Daarbuiten een sterk MKB in maakindustrie (Born/Sittard-Noord), zakelijke dienstverlening en regionale retail. De ligging tegen Duitsland en België maakt grensoverschrijdende dienstverlening relevant.</p>
        <p class="mt-3 text-slate-600">Postcoderegio 6130-6166 valt binnen ons standaard servicegebied. Voor Sittard-Geleens MKB ligt de AI-winst vooral in: compliance-trail-automatisering (REACH, ATEX, ISO), tweetalige voice-AI (NL/DE) voor grensklanten, supplier-workflow-automatisering met ERP-koppeling en AVG-compliant document-classificatie.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 mb-12">
        {[
          { title: 'Chemelot-toeleveranciers', desc: 'n8n-workflow voor REACH/ATEX-rapportages, supplier-communicatie en compliance-trail.', link: '/diensten/custom/' },
          { title: 'Maakindustrie Born', desc: 'AI-receptionist voor offerte-aanvragen en orderintake. Tweetalig NL/DE.', link: '/sectoren/bouw/' },
          { title: 'Technische Dienstverlening', desc: 'AI-document agent voor onderhoudscontracten en ATEX-certificaten.', link: '/diensten/custom/' },
          { title: 'Logistiek Westelijke Mijnstreek', desc: 'Workflow automation voor vrachtbrieven en orderverwerking. AVG-compliant.', link: '/sectoren/logistiek/' },
          { title: 'Zakelijke Dienstverlening', desc: 'AI-intake voor klantvragen en CRM-koppeling. 24/7 bereikbaar.', link: '/diensten/marco/' },
          { title: 'ZZP Westelijke Mijnstreek', desc: 'Betaalbare AI vanaf €597/maand. Starter-pakket inclusief setup.', link: '/sectoren/ai-voor-zzp/' },
        ].map(s => (
          <div class="card reveal">
            <h3 class="font-bold text-navy text-sm mb-2">{s.title}</h3>
            <p class="text-xs text-slate-600 mb-4">{s.desc}</p>
            <a href={s.link} class="text-xs font-medium text-brand-indigo hover:underline">AI in {city} bekijken →</a>
          </div>
        ))}
      </div>

      <div class="bg-slate-50 border border-slate-200 rounded-2xl p-8 mb-12 reveal">
        <h3 class="text-xl font-bold text-navy mb-4">Wij rijden naar Sittard-Geleen</h3>
        <p class="text-sm text-slate-600">Vanaf Rotterdam circa 1 uur 50 via A2/A76. Voor Chemelot-toeleveranciers, complexe ERP-integraties of compliance-workshops komen wij ter plaatse. Born, Stein, Beek, Echt-Susteren en Geleen vallen onder hetzelfde servicegebied.</p>
      </div>

      <div class="bg-brand-indigo/5 border border-brand-indigo/20 rounded-2xl p-6 mb-10 reveal">
        <p class="font-bold text-navy mb-2">Lokale AI use cases — Sittard-Geleen</p>
        <ul class="text-sm text-slate-600 space-y-2 mt-3">
          <li><strong>Chemelot-toeleverancier:</strong> n8n logt REACH-rapportages automatisch, compliance-officer bespaart 14 uur per week en audit-trail is real-time beschikbaar.</li>
          <li><strong>Maakindustrie Born:</strong> tweetalige voice-AI vangt Duitse offerte-aanvragen op, conversie uit NRW 40% hoger.</li>
          <li><strong>Technisch dienstverlener:</strong> AI-document agent classificeert ATEX-certificaten direct in dossier.</li>
          <li><strong>Logistieke MKB Westelijke Mijnstreek:</strong> orderverwerking en facturatie geautomatiseerd, doorlooptijd halveert.</li>
        </ul>
      </div>

      <h2 class="text-2xl font-bold text-navy mb-6">Veelgestelde Vragen — AI Agency Sittard-Geleen</h2>
      <div class="space-y-3 mb-8">
        {faqItems.map(item => (
          <details class="card group">
            <summary class="flex items-center justify-between cursor-pointer list-none">
              <span class="text-sm font-bold text-navy pr-6">{item.question}</span>
              <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <p class="mt-4 text-sm text-slate-600 leading-relaxed">{item.answer}</p>
          </details>
        ))}
      </div>

      <div class="bg-slate-50 border border-slate-200 rounded-xl p-6">
        <p class="text-sm font-bold text-navy mb-3">Andere locaties</p>
        <div class="flex flex-wrap gap-3 text-sm">
          <a href="/locaties/maastricht/" class="text-brand-indigo hover:underline">Maastricht</a>
          <a href="/locaties/heerlen/" class="text-brand-indigo hover:underline">Heerlen</a>
          <a href="/locaties/venlo/" class="text-brand-indigo hover:underline">Venlo</a>
          <a href="/locaties/eindhoven/" class="text-brand-indigo hover:underline">Eindhoven</a>
          <a href="/locaties/den-bosch/" class="text-brand-indigo hover:underline">Den Bosch</a>
          <a href="/locaties/tilburg/" class="text-brand-indigo hover:underline">Tilburg</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-slate-50 border-y border-slate-200">
    <div class="container-page max-w-4xl">
      <p class="eyebrow text-brand-indigo mb-2">Website + AI = 1 partner</p>
      <h2 class="text-2xl lg:text-3xl font-bold text-navy mb-4">Sittard-Geleens MKB kiest één partner voor website én AI</h2>
      <p class="text-slate-600 mb-8 leading-relaxed">Veel Sittard-Geleense bedrijven (Chemelot-toeleveranciers + industrieel MKB) hebben verouderde websites van lokale webbureaus, en sluiten daarnaast losse AI-leveranciers aan. Bij Aanloop AI is dat één traject: AI-ready website + Marco (telefoon) + Emma (WhatsApp) in één pakket — bespaart €8.014 jaar 1 t.o.v. losse leveranciers, met één contract en één aanspreekpunt.</p>
      <div class="grid md:grid-cols-3 gap-4">
        <a href="/diensten/ai-website-bundel-mkb-nederland/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">AI-Website Bundel</h3>
          <p class="text-xs text-slate-600 mb-3">Website + Marco + Emma in 1 pakket. €4.950 setup + €397/mnd. Bespaart €8.014 jaar 1.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk bundel →</span>
        </a>
        <a href="/diensten/website-laten-maken-mkb-nederland-2026/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">Website laten maken</h3>
          <p class="text-xs text-slate-600 mb-3">Astro/Next/WordPress AI-ready. Schema.org + Speakable + WCAG 2.2 AA + Core Web Vitals groen.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk pakketten →</span>
        </a>
        <a href="/cases/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">Combo-cases bekijken</h3>
          <p class="text-xs text-slate-600 mb-3">5 branche-scenarios met Website + AI bundel: detailhandel, zorg, horeca, advocatuur, accountancy.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk pakketten →</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section-tight bg-midnight text-pearl relative overflow-hidden">
    <div class="absolute inset-0 dot-grid opacity-[0.04]"></div>
    <div class="container-page relative max-w-3xl">
      <h2 class="text-3xl font-bold tracking-tightest text-pearl text-balance reveal">Industrieel MKB Westelijke Mijnstreek? Start gratis.</h2>
      <p class="mt-4 text-slate-300 reveal reveal-delay-1">Gratis AI scan van 30 minuten. Compliance-trail, EU-data, AVG-conform. Voor Chemelot-toeleveranciers en industrieel MKB.</p>
      <div class="mt-6 flex flex-col sm:flex-row gap-3 reveal reveal-delay-2">
        <a href="/aanvragen/" class="btn bg-pearl text-navy hover:bg-white text-base px-6 py-3.5">Gratis AI Scan<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></a>
        <a href="/diensten/" class="btn border border-slate-700 text-pearl hover:bg-slate-800 text-base px-6 py-3.5">Bekijk diensten</a>
        <a href="/prijzen/" class="btn border border-slate-700 text-pearl hover:bg-slate-800 text-base px-6 py-3.5">Bekijk prijzen</a>
      </div>
    </div>
  </section>
</BaseLayout>
