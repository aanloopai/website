---
import BaseLayout from '../../layouts/BaseLayout.astro';
const city = "Leeuwarden";
const region = "Friesland";
const localSchema = {
  '@context': 'https://schema.org', '@type': 'LocalBusiness',
  name: 'Aanloop AI — AI Agency Leeuwarden',
  url: 'https://aanloopai.nl/locaties/leeuwarden/',
  image: 'https://aanloopai.nl/logo-mark-light-1024.png',
  address: { '@type': 'PostalAddress', addressLocality: 'Leeuwarden', addressRegion: 'Friesland', addressCountry: 'NL', postalCode: '8900-8939' },
  geo: { '@type': 'GeoCoordinates', latitude: '53.2014', longitude: '5.8083' },
  areaServed: { '@type': 'City', name: 'Leeuwarden' },
  priceRange: '€€',
  telephone: '+31624741597',
  email: 'hello@aanloopai.nl',
  openingHoursSpecification: { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '09:00', closes: '17:00' },
  sameAs: ['https://aanloopai.nl/'],
  author: { '@type': 'Person', '@id': 'https://aanloopai.nl/team/magahdogan/#person', name: 'Mustafa Agah Dogan' },
};
const faqItems = [
  { question: 'Werkt Aanloop AI voor bedrijven in Leeuwarden?', answer: 'Ja. Wij bedienen MKB in Leeuwarden, Drachten, Heerenveen, Sneek en de gehele Friese regio. Vanaf Rotterdam circa 2 uur 15 via A6/A32. Onze remote implementatie betekent dat de afstand geen vertraging oplevert.' },
  { question: 'Welke Friese sectoren bedient Aanloop AI?', answer: 'Leeuwarden is hoofdstad van Friesland: provinciale overheid, financiële dienstverlening (Friesland Bank, Achmea), zorg (MCL, Tjongerschans), agrarisch (melkveehouderij, FrieslandCampina-toeleveranciers) en groeiende watertechnologie-cluster (WaterCampus). Wij implementeren AI voor klantenservice, document-automatisering en CRM-koppeling.' },
  { question: 'Bedient Aanloop AI ook Friestalige communicatie?', answer: 'Onze voice-AI werkt primair in het Nederlands. Voor Friestalige klantcontacten leveren we Nederlandstalige flows met optionele Friestalige openingsboodschap; ervaring leert dat Friese MKB-klanten Nederlandstalige AI-flows breed accepteren.' },
  { question: 'Wat kost AI voor een Fries MKB-bedrijf?', answer: 'Landelijk uniform: Emma €497/maand, Groei €997/maand. Geen toeslag voor Friesland. Voor melkveehouderij en zuivel-toeleveranciers bieden wij seizoenflexibele opties.' },
  { question: 'Werkt AI voor Friese melkveehouderij?', answer: 'Ja. Melkveehouderij heeft veel administratie (CRV-registratie, leveringen, contracten). Onze workflow-automatisering integreert met bestaande software (Dairy Data, FarmWalk) en automatiseert rapportages.' },
];
---
<BaseLayout
  title="AI Agency Leeuwarden — AI Bureau & Automatisering MKB"
  description="AI bureau Leeuwarden: Aanloop AI helpt het MKB met AI-agents en automatisering. AI agency Leeuwarden — gratis AI-scan, live in 7 werkdagen."
  schema={localSchema}
  faqSchema={faqItems}
>
  <section class="border-b border-slate-200 hero-gradient">
    <div class="container-page py-16 lg:py-20">
      <div class="max-w-3xl">
        <div class="flex items-center gap-4 mb-6"><div class="accent-band"><span></span><span></span><span></span><span></span></div><span class="eyebrow">Locatie - {city} - {region}</span></div>
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tightest text-navy text-balance leading-[1.08] reveal reveal-delay-1">AI Agency {city}:<br/>AI voor Fries MKB</h1>
        <p class="mt-6 text-lg text-slate-600 leading-relaxed reveal reveal-delay-2">Aanloop AI bedient MKB-bedrijven in {city} en de gehele Friese regio met AI agents, voice AI en workflow automation. Hoofdstad van Friesland — sterke financiële sector, zorg-cluster, melkveehouderij en watertechnologie.</p>
        <div class="mt-8 flex flex-col sm:flex-row gap-3 reveal reveal-delay-3">
          <a href="/gratis-ai-scan/" class="btn-primary">Gratis AI Scan voor {city}<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></a>
          <a href="/tarieven/" class="btn-outline">Bekijk prijzen</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page max-w-4xl mx-auto">
      <div class="mb-10 reveal">
        <h2 class="text-2xl font-bold text-navy">AI voor Leeuwarder bedrijven</h2>
        <p class="mt-3 text-slate-600">Leeuwarden is de provinciehoofdstad en economisch zwaartepunt van Friesland. Het MKB-landschap is opvallend divers: financiële dienstverlening (Achmea, Friesland Bank), zorg-cluster rond MCL en Tjongerschans, regionale overheidsdienstverlening, en de groeiende WaterCampus-cluster (technologie, waterbeheer, datasciences). Daarbuiten een sterke melkveehouderij in Friese platteland (FrieslandCampina-toeleveranciers), agrarische dienstverlening en regionale retail rond binnenstad en winkelcentra.</p>
        <p class="mt-3 text-slate-600">Postcoderegio 8900-8939 valt binnen ons standaard servicegebied. Voor Fries MKB ligt de AI-winst in: AVG-compliant document-stroom voor financiële en zorgsector, agrarische workflow-automatisering met koppeling aan Dairy Data, en multi-channel klantenservice (voice + WhatsApp + email) voor regionale dienstverleners.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 mb-12">
        {[
          { title: 'Financiële Dienstverlening', desc: 'AI-intake voor klantvragen, hypotheek-screening en CRM-koppeling.', link: '/sectoren/accountancy/' },
          { title: 'Zorg MCL & Tjongerschans', desc: 'Voice-AI voor huisartsenpraktijken en specialisten. AVG-compliant intake.', link: '/sectoren/zorg/' },
          { title: 'Melkveehouderij Friesland', desc: 'Workflow voor CRV-registratie, leveringen en contracten. Koppeling Dairy Data.', link: '/diensten/custom/' },
          { title: 'Watertechnologie WaterCampus', desc: 'AI-document agent voor R&D-administratie, projectdocumentatie en CRM.', link: '/diensten/custom/' },
          { title: 'Advocatenkantoren', desc: 'AI-intake voor cliëntdossiers en contract-classificatie.', link: '/sectoren/ai-voor-advocaten/' },
          { title: 'Retail centrum / horeca', desc: 'WhatsApp AI voor reserveringen en klantvragen. 24/7 bereikbaar.', link: '/sectoren/horeca/' },
        ].map(s => (
          <div class="card reveal">
            <h3 class="font-bold text-navy text-sm mb-2">{s.title}</h3>
            <p class="text-xs text-slate-600 mb-4">{s.desc}</p>
            <a href={s.link} class="text-xs font-medium text-brand-indigo hover:underline">AI in {city} bekijken →</a>
          </div>
        ))}
      </div>

      <div class="bg-slate-50 border border-slate-200 rounded-2xl p-8 mb-12 reveal">
        <h3 class="text-xl font-bold text-navy mb-4">Wij rijden naar Leeuwarden</h3>
        <p class="text-sm text-slate-600">Vanaf Rotterdam circa 2 uur 15 via A6/A32. Voor strategische workshops, complexe ERP-integraties of stakeholder-sessies in zorg, financieel of melkveehouderij komen wij ter plaatse. Drachten, Heerenveen, Sneek, Harlingen en Dokkum vallen onder hetzelfde servicegebied.</p>
      </div>

      <div class="bg-brand-indigo/5 border border-brand-indigo/20 rounded-2xl p-6 mb-10 reveal">
        <p class="font-bold text-navy mb-2">Lokale AI use cases — Leeuwarden</p>
        <ul class="text-sm text-slate-600 space-y-2 mt-3">
          <li><strong>Financieel adviesbureau centrum:</strong> AI-intake screent klantvragen, doorlooptijd 50% korter en compliance-trail automatisch gelogd.</li>
          <li><strong>Huisartsenpraktijk Camminghaburen:</strong> voice-AI vangt 70% van standaardvragen op, assistenten besparen 14 uur per week.</li>
          <li><strong>Melkveehouderij Friese platteland:</strong> n8n synchroniseert CRV-registratie en leveringen direct met administratie.</li>
          <li><strong>Watertechnologie startup WaterCampus:</strong> AI-document agent classificeert projectdocumentatie, R&D-team bespaart 10 uur per week.</li>
        </ul>
      </div>

      <h2 class="text-2xl font-bold text-navy mb-6">Veelgestelde Vragen — AI Agency {city}</h2>
      <div class="space-y-3 mb-8">
        {faqItems.map(item => (
          <details class="card group">
            <summary class="flex items-center justify-between cursor-pointer list-none">
              <span class="text-sm font-bold text-navy pr-6">{item.question}</span>
              <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <p class="mt-4 text-sm text-slate-600 leading-relaxed">{item.answer}</p>
          </details>
        ))}
      </div>

      <div class="bg-slate-50 border border-slate-200 rounded-xl p-6">
        <p class="text-sm font-bold text-navy mb-3">Andere locaties</p>
        <div class="flex flex-wrap gap-3 text-sm">
          <a href="/locaties/groningen/" class="text-brand-indigo hover:underline">Groningen</a>
          <a href="/locaties/emmen/" class="text-brand-indigo hover:underline">Emmen</a>
          <a href="/locaties/zwolle/" class="text-brand-indigo hover:underline">Zwolle</a>
          <a href="/locaties/lelystad/" class="text-brand-indigo hover:underline">Lelystad</a>
          <a href="/locaties/alkmaar/" class="text-brand-indigo hover:underline">Alkmaar</a>
          <a href="/locaties/enschede/" class="text-brand-indigo hover:underline">Enschede</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-slate-50 border-y border-slate-200">
    <div class="container-page max-w-4xl">
      <p class="eyebrow text-brand-indigo mb-2">Website + AI = 1 partner</p>
      <h2 class="text-2xl lg:text-3xl font-bold text-navy mb-4">Leeuwarder MKB kiest één partner voor website én AI</h2>
      <p class="text-slate-600 mb-8 leading-relaxed">Veel Friese bedrijven (financieel, zorg, melkveehouderij, watertechnologie) hebben verouderde websites van lokale webbureaus, en sluiten daarnaast losse AI-leveranciers aan. Bij Aanloop AI is dat één traject: AI-ready website + Emma (telefoon + WhatsApp) in één pakket — bespaart op jaarbasis t.o.v. losse leveranciers, met één contract en één aanspreekpunt.</p>
      <div class="grid md:grid-cols-3 gap-4">
        <a href="/diensten/ai-website-bundel-mkb-nederland/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">AI-Website Bundel</h3>
          <p class="text-xs text-slate-600 mb-3">Website + Emma in 1 pakket. €5.950 setup + €649/mnd all-in. Eén factuur, één SLA.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk bundel →</span>
        </a>
        <a href="/diensten/website-laten-maken-mkb-nederland-2026/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">Website laten maken</h3>
          <p class="text-xs text-slate-600 mb-3">Astro/Next/WordPress AI-ready. Schema.org + Speakable + WCAG 2.2 AA + Core Web Vitals groen.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk pakketten →</span>
        </a>
        <a href="/cases/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">Combo-cases bekijken</h3>
          <p class="text-xs text-slate-600 mb-3">5 branche-scenarios met Website + AI bundel: detailhandel, zorg, horeca, advocatuur, accountancy.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk pakketten →</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section-tight bg-midnight text-pearl relative overflow-hidden">
    <div class="absolute inset-0 dot-grid opacity-[0.04]"></div>
    <div class="container-page relative max-w-3xl">
      <h2 class="text-3xl font-bold tracking-tightest text-pearl text-balance reveal">Fries bedrijf? Start gratis.</h2>
      <p class="mt-4 text-slate-300 reveal reveal-delay-1">Gratis AI scan van 30 minuten. EU-data, AVG-compliant. Voor financieel, zorg, melkveehouderij en watertechnologie.</p>
      <div class="mt-6 flex flex-col sm:flex-row gap-3 reveal reveal-delay-2">
        <a href="/aanvragen/" class="btn bg-pearl text-navy hover:bg-white text-base px-6 py-3.5">Gratis AI Scan<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></a>
        <a href="/diensten/" class="btn border border-slate-700 text-pearl hover:bg-slate-800 text-base px-6 py-3.5">Bekijk diensten</a>
        <a href="/tarieven/" class="btn border border-slate-700 text-pearl hover:bg-slate-800 text-base px-6 py-3.5">Bekijk prijzen</a>
      </div>
    </div>
  </section>
</BaseLayout>
