---
import BaseLayout from '../../layouts/BaseLayout.astro';
const faqItems = [
  { question: 'Is Aanloop AI actief in Den Haag?', answer: 'Ja. Aanloop AI bedient klanten in Den Haag en de regio Haaglanden. We werken remote en on-site voor zakelijke klanten in de hofstad.' },
  { question: 'Welke sectoren bedient Aanloop AI in Den Haag?', answer: 'In Den Haag zijn advocatenkantoren, overheidsgelieerde instellingen (voor zover privaat), makelaars, zakelijke dienstverlening en zorgorganisaties onze voornaamste klantgroepen.' },
  { question: 'Hoe verschilt een AI agent voor een Den Haags bedrijf?', answer: 'De technologie is identiek. De configuratie past zich aan aan uw sector en klanttype. Aanloop AI heeft ervaring met de zakelijke en formele communicatiestijl die past bij Den Haagse instellingen.' },
  { question: 'Wat kost een AI agent in Den Haag?', answer: 'Onze prijzen zijn landelijk gelijk: Starter €597/maand, Groei €1.197/maand. U betaalt geen regioproemie.' },
  { question: 'Kan Aanloop AI ook helpen bij advocatenkantoren in Den Haag?', answer: 'Absoluut. Aanloop AI heeft een specifieke AI-oplossing voor advocatenkantoren: intake-screening, agendabeheer en documentverwerking. Meer info op onze advocaten-pagina.' },
];
const localSchema = { '@context': 'https://schema.org', '@type': 'LocalBusiness', name: 'Aanloop AI — AI Agency Den Haag', url: 'https://aanloopai.nl/locaties/den-haag/', address: { '@type': 'PostalAddress', addressLocality: 'Den Haag', addressRegion: 'Zuid-Holland', addressCountry: 'NL' }, geo: { '@type': 'GeoCoordinates', latitude: '52.0705', longitude: '4.3007' }, areaServed: { '@type': 'City', name: 'Den Haag' }, telephone: '+31624741597', openingHoursSpecification: { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '09:00', closes: '17:00' }, priceRange: '€€' };
---
<BaseLayout title="AI Bureau Den Haag — Aanloop AI | Den Haag AI Agents MKB en Advocatuur" description="AI bureau Den Haag: Aanloop AI helpt Den Haagse MKB-bedrijven met AI-agents, voice AI en automatisering. AI agency Den Haag — gratis AI-scan, live binnen 7-14 werkdagen. KVK 88606902." schema={localSchema} faqSchema={faqItems}>
  <section class="border-b border-slate-200 hero-gradient">
    <div class="container-page py-16 lg:py-20">
      <div class="max-w-3xl">
        <div class="flex items-center gap-4 mb-6"><div class="accent-band"><span></span><span></span><span></span><span></span></div><span class="eyebrow">Locatie · Den Haag</span></div>
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tightest text-navy text-balance leading-[1.08] reveal reveal-delay-1">AI Agency Den Haag:<br/>AI Agents & Automation voor Den Haagse Bedrijven</h1>
        <p class="mt-6 text-lg text-slate-600 leading-relaxed reveal reveal-delay-2">Aanloop AI helpt Den Haagse MKB-bedrijven, advocatenkantoren en zakelijke dienstverleners met AI agents en workflow automation. Transparant geprijsd, AVG-compliant.</p>
        <div class="mt-8 flex flex-col sm:flex-row gap-3 reveal reveal-delay-3">
          <a href="/gratis-ai-scan/" class="btn-primary">Gratis AI Scan voor Den Haag<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></a>
          <a href="/prijzen/" class="btn-outline">Bekijk prijzen</a>
        </div>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container-page max-w-4xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 mb-12">
        {[
          { icon: '⚖️', sector: 'Advocatenkantoren Den Haag', desc: 'AI intake-screening en agendabeheer voor advocaten.', link: '/sectoren/ai-voor-advocaten/' },
          { icon: '🏠', sector: 'Makelaars Den Haag', desc: 'AI receptionist voor bezichtigingsafspraken 24/7.', link: '/sectoren/vastgoed/' },
          { icon: '💼', sector: 'Zakelijke Dienstverlening', desc: 'Workflow automation voor administratie en klantenservice.', link: '/diensten/custom/' },
          { icon: '🍽️', sector: 'Horeca Den Haag', desc: 'WhatsApp AI voor reserveringen en klantenservice.', link: '/sectoren/horeca/' },
          { icon: '📊', sector: 'Accountants Den Haag', desc: 'AI factuurverwerking, 85% tijdsbesparing.', link: '/sectoren/accountancy/' },
          { icon: '💊', sector: 'Zorg Den Haag', desc: 'AI voor afspraken en klantenservice in zorgomgevingen.', link: '/sectoren/zorg/' },
        ].map(s => (
          <div class="card reveal">
            <div class="text-2xl mb-3">{s.icon}</div>
            <h3 class="font-bold text-navy text-sm mb-2">{s.sector}</h3>
            <p class="text-xs text-slate-600 mb-4">{s.desc}</p>
            <a href={s.link} class="text-xs font-medium text-brand-indigo hover:underline">AI in Den Haag bekijken →</a>
          </div>
        ))}
      </div>
      <h2 class="text-2xl font-bold text-navy mb-6">Veelgestelde Vragen — AI Agency Den Haag</h2>
      <div class="space-y-3 mb-8">
        {faqItems.map(item => (
          <details class="card group">
            <summary class="flex items-center justify-between cursor-pointer list-none">
              <span class="text-sm font-bold text-navy pr-6">{item.question}</span>
              <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <p class="mt-4 text-sm text-slate-600 leading-relaxed">{item.answer}</p>
          </details>
        ))}
      </div>
      <div class="bg-slate-50 border border-slate-200 rounded-xl p-6">
        <p class="text-sm font-bold text-navy mb-3">Andere locaties</p>
        <div class="flex flex-wrap gap-3">
          <a href="/locaties/amsterdam/" class="text-sm text-brand-indigo hover:underline">AI Agency Amsterdam →</a>
          <a href="/locaties/rotterdam/" class="text-sm text-brand-indigo hover:underline">AI Agency Rotterdam →</a>
          <a href="/locaties/utrecht/" class="text-sm text-brand-indigo hover:underline">AI Agency Utrecht →</a>
        </div>
      </div>
    </div>
  </section>
  <section class="section-tight bg-slate-50/60 border-t border-slate-200">
    <div class="container-page max-w-4xl">
      <p class="eyebrow text-brand-indigo mb-2">Kennisbank</p>
      <h2 class="text-2xl font-bold text-navy mb-6">Verdiepende AI-gidsen</h2>
      <div class="grid sm:grid-cols-2 gap-3">
        <a href="/kennisbank/wat-is-een-ai-agent/" class="card p-4 hover:shadow-md transition-all bg-white"><p class="text-xs text-brand-indigo mb-1">Gids</p><p class="text-sm font-semibold text-navy">Wat is een AI agent? Complete gids</p></a>
        <a href="/kennisbank/ai-roi-berekenen-mkb-nederland-2026/" class="card p-4 hover:shadow-md transition-all bg-white"><p class="text-xs text-brand-indigo mb-1">Gids</p><p class="text-sm font-semibold text-navy">AI ROI berekenen voor MKB 2026</p></a>
        <a href="/kennisbank/ai-implementatie-stappen-mkb-nederland/" class="card p-4 hover:shadow-md transition-all bg-white"><p class="text-xs text-brand-indigo mb-1">Gids</p><p class="text-sm font-semibold text-navy">AI implementatie in 7 stappen</p></a>
        <a href="/kennisbank/ai-avg-gdpr-compliance-mkb-nederland/" class="card p-4 hover:shadow-md transition-all bg-white"><p class="text-xs text-brand-indigo mb-1">Gids</p><p class="text-sm font-semibold text-navy">AI en AVG-compliance voor MKB</p></a>
      </div>
    </div>
  </section>


  <section class="section bg-slate-50 border-y border-slate-200">
    <div class="container-page max-w-4xl">
      <p class="eyebrow text-brand-indigo mb-2">Website + AI = 1 partner</p>
      <h2 class="text-2xl lg:text-3xl font-bold text-navy mb-4">Den Haagse MKB kiest één partner voor website én AI</h2>
      <p class="text-slate-600 mb-8 leading-relaxed">Veel Den Haagse bedrijven hebben verouderde websites van lokale webbureaus, en sluiten daarnaast losse AI-leveranciers aan. Bij Aanloop AI is dat één traject: AI-ready website + Marco (telefoon) + Emma (WhatsApp) in één pakket — bespaart €8.014 jaar 1 t.o.v. losse leveranciers, met één contract en één aanspreekpunt.</p>
      <div class="grid md:grid-cols-3 gap-4">
        <a href="/diensten/ai-website-bundel-mkb-nederland/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">AI-Website Bundel</h3>
          <p class="text-xs text-slate-600 mb-3">Website + Marco + Emma in 1 pakket. €4.950 setup + €397/mnd. Bespaart €8.014 jaar 1.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk bundel →</span>
        </a>
        <a href="/diensten/website-laten-maken-mkb-nederland-2026/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">Website laten maken</h3>
          <p class="text-xs text-slate-600 mb-3">Astro/Next/WordPress AI-ready. Schema.org + Speakable + WCAG 2.2 AA + Core Web Vitals groen.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk pakketten →</span>
        </a>
        <a href="/cases/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">Combo-cases bekijken</h3>
          <p class="text-xs text-slate-600 mb-3">5 branche-scenarios met Website + AI bundel: detailhandel, zorg, horeca, advocatuur, accountancy.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk cases →</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section-tight bg-midnight text-pearl relative overflow-hidden">
    <div class="absolute inset-0 dot-grid opacity-[0.04]"></div>
    <div class="container-page relative max-w-3xl">
      <h2 class="text-3xl font-bold tracking-tightest text-pearl text-balance reveal">Bent u een Den Haags bedrijf?</h2>
      <p class="mt-4 text-slate-300 reveal reveal-delay-1">Plan een gratis AI scan en ontdek hoe AI uw Den Haagse bedrijf kan versterken.</p>
      <div class="mt-6 flex flex-col sm:flex-row gap-3 reveal reveal-delay-2">
        <a href="/gratis-ai-scan/" class="btn bg-pearl text-navy hover:bg-white text-base px-6 py-3.5">Gratis AI Scan aanvragen<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></a>
        <a href="/prijzen/" class="btn border border-slate-700 text-pearl hover:bg-slate-800 text-base px-6 py-3.5">Bekijk AI prijzen</a>
      </div>
    </div>
  </section>
</BaseLayout>
