---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import sectorImage from '../../assets/images/sectoren/bouw.jpg';

const faqSchema = [
  {
    question: 'Hoe helpt AI bij bouwbedrijven en installatiebedrijven?',
    answer: 'Aanloop AI neemt telefonische offerte-aanvragen en planningsoproepen 24/7 aan, stuurt automatisch bevestigingen via WhatsApp en helpt bij het inplannen van monteurs — zodat uw team op de werf kan blijven zonder iets te missen.',
  },
  {
    question: 'Kan de AI afspraken inplannen voor monteurs en inspecteurs?',
    answer: 'Ja. De AI koppelt aan uw agenda (Google Calendar, Outlook) en plant automatisch afspraken op basis van beschikbaarheid, locatie en type klus. Bevestigingen en herinneringen gaan automatisch via WhatsApp of e-mail.',
  },
  {
    question: 'Wat kost AI voor een bouwbedrijf of installatiebedrijf?',
    answer: 'AI voor bouw- en installatiebedrijven start vanaf €597/maand bij Aanloop AI (Starter pakket met Marco AI-telefoniste, tot 150 gesprekken). Dit is inclusief setup, training op uw diensten en maandelijkse optimalisatie. Gebruik onze ROI calculator om uw specifieke besparing te berekenen.',
  },
  {
    question: 'Werkt de AI ook buiten kantooruren voor spoedmeldingen?',
    answer: 'Ja. De AI herkent urgente meldingen (lekkage, stroomstoring, breuk) en escaleert direct naar de bereikbaarheidsdienst of juiste monteur. Klanten worden 24/7 geholpen, ook buiten kantooruren.',
  },
  {
    question: 'Met welke software koppelt de AI voor bouwbedrijven?',
    answer: 'Aanloop AI koppelt met Google Calendar, Outlook, WhatsApp Business API, HubSpot, Exact Online en de meeste gangbare planningssoftware via API. Maatwerk koppelingen zijn ook mogelijk.',
  },
];

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'AI voor Bouw & Installatiebedrijven',
  description: 'Aanloop AI levert AI-automatisering voor bouw- en installatiebedrijven. Nooit meer gemiste offerte-aanvragen, automatische monteurplanning en 24/7 telefonische bereikbaarheid.',
  provider: { '@type': 'Organization', name: 'Aanloop AI', url: 'https://aanloopai.nl' },
  areaServed: 'NL',
  offers: {
    '@type': 'Offer',
    price: '997',
    priceCurrency: 'EUR',
    priceSpecification: { '@type': 'UnitPriceSpecification', priceType: 'monthly' },
  },
};
---

<BaseLayout
  title="AI voor Bouwbedrijven & Installatiebedrijven — Nooit Meer Gemiste Aanvragen | Aanloop AI"
  description="AI-assistent voor bouw- en installatiebedrijven. 24/7 telefonisch bereikbaar, automatische monteurplanning en WhatsApp klantenservice. Live in 14 dagen. Gratis scan."
  faqSchema={faqSchema}
  schema={articleSchema}
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-navy text-white">
    <div class="absolute inset-0 bg-gradient-to-br from-navy via-[#0f2040] to-brand-indigo/20"></div>
    <div class="container-page py-24 lg:py-36 relative">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div class="max-w-4xl">
          <div class="flex items-center gap-3 mb-6">
            <span class="text-4xl">🏗️</span>
            <span class="eyebrow text-brand-indigo">Bouw & Installatie</span>
          </div>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tightest text-white text-balance leading-[1.05] mb-6">
            Nooit meer een offerte-aanvraag missen.
          </h1>
          <p class="text-lg lg:text-xl text-slate-300 leading-relaxed max-w-2xl mb-10">
            Uw telefoon rinkelt terwijl uw team op de steiger staat. De AI-assistent neemt aan, registreert de aanvraag en plant de afspraak in — terwijl u doorwerkt.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="/demo-aanvragen/" class="btn-primary text-base px-8 py-4">Boek een gratis demo →</a>
            <a href="/tarieven/" class="inline-flex items-center gap-2 px-8 py-4 border border-white/20 rounded-2xl text-white font-semibold hover:bg-white/10 transition-all">Bekijk tarieven</a>
          </div>
        </div>
        <div class="relative">
          <div class="absolute -inset-6 -z-0 bg-gradient-to-br from-brand-indigo/20 via-transparent to-brand-amber/10 blur-3xl"></div>
          <div class="relative rounded-3xl overflow-hidden shadow-2xl ring-1 ring-white/10">
            <Image src={sectorImage} alt="Bouwprofessional bekijkt blauwdrukken — AI voor bouw- en installatiebedrijven Nederland" class="w-full h-auto object-cover aspect-[4/3]" loading="eager" decoding="async" fetchpriority="high" widths={[480, 800, 1200, 1400]} sizes="(min-width: 1024px) 600px, 100vw" format="webp" quality={82} />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Pain points -->
  <section class="section border-b border-slate-200">
    <div class="container-page">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-navy">Herkenbaar voor bouw & installatie?</h2>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        {[
          { icon: '📞', pain: 'Telefoontjes missen op de werf', fix: 'AI neemt 24/7 aan en registreert elk verzoek' },
          { icon: '📅', pain: 'Planning kost uren per week', fix: 'Automatische agenda-integratie en bevestigingen' },
          { icon: '📋', pain: 'Offertes blijven liggen', fix: 'Directe opvolging via WhatsApp of e-mail' },
        ].map(item => (
          <div class="card">
            <div class="text-3xl mb-3">{item.icon}</div>
            <div class="text-sm font-semibold text-brand-rose mb-2">❌ {item.pain}</div>
            <div class="text-sm text-brand-emerald font-medium">✅ {item.fix}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="section bg-slate-50">
    <div class="container-page">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-navy">Wat de AI voor u doet</h2>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          { icon: '📞', title: '24/7 telefonisch aanwezig', desc: 'Neemt aan, vraagt naar de klus, locatie en urgentie. Geeft direct een realistische planning terug.' },
          { icon: '📱', title: 'WhatsApp offerte-opvolging', desc: 'Stuurt automatisch een bevestiging en vraagt aanvullende foto\'s of informatie op.' },
          { icon: '🗓️', title: 'Monteur-planning', desc: 'Koppelt aan uw agenda en plant de inspectie of uitvoering in op het eerste vrije slot.' },
          { icon: '🔔', title: 'Automatische herinneringen', desc: 'Klanten ontvangen een dag van tevoren een WhatsApp-herinnering met het tijdstip en de naam van de monteur.' },
          { icon: '📊', title: 'Lead-registratie', desc: 'Elk contact wordt gelogd met naam, adres, type klus en urgentie — direct in uw CRM of e-mail.' },
          { icon: '🌙', title: 'Spoed buiten kantooruren', desc: 'Herkent urgente meldingen (lekkage, storing) en escaleert direct naar de juiste monteur.' },
        ].map(f => (
          <div class="card hover:shadow-lg transition-all">
            <div class="text-3xl mb-3">{f.icon}</div>
            <h3 class="font-bold text-navy mb-2">{f.title}</h3>
            <p class="text-sm text-slate-600 leading-relaxed">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page max-w-3xl mx-auto text-center">
      <h2 class="text-3xl font-bold text-navy mb-8">Gemiddeld resultaat bij bouwbedrijven</h2>
      <div class="grid grid-cols-3 gap-6 mb-10">
        {[
          { value: '−68%', label: 'Gemiste aanvragen', color: 'text-brand-emerald' },
          { value: '+34%', label: 'Meer offertes uitgebracht', color: 'text-brand-indigo' },
          { value: '6.2u', label: 'Planning bespaard per week', color: 'text-brand-amber' },
        ].map(s => (
          <div class="card text-center">
            <div class={`text-3xl font-bold ${s.color}`}>{s.value}</div>
            <div class="text-xs text-slate-500 mt-1">{s.label}</div>
          </div>
        ))}
      </div>
      <div class="bg-brand-indigo/5 border border-brand-indigo/20 rounded-2xl p-6 mb-6">
        <p class="font-bold text-navy mb-2">Bereken uw besparing</p>
        <p class="text-sm text-slate-600 mb-4">Gebruik onze gratis ROI calculator om te zien hoeveel tijd en geld AI uw bouw- of installatiebedrijf bespaart.</p>
        <a href="/ai-roi-calculator/" class="btn-primary text-sm">ROI Calculator openen →</a>
      </div>
      <a href="/demo-aanvragen/" class="btn-primary text-base px-8 py-4">Start gratis — boek een demo →</a>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section bg-slate-50">
    <div class="container-page max-w-2xl mx-auto">
      <h2 class="text-2xl font-bold text-navy mb-8 text-center">Veelgestelde vragen</h2>
      <div class="space-y-4">
        {faqSchema.map(item => (
          <div class="card">
            <h3 class="font-semibold text-navy mb-2">{item.question}</h3>
            <p class="text-slate-600 text-sm leading-relaxed">{item.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page max-w-3xl">
      <p class="eyebrow text-brand-indigo mb-2">Verdiepende kennisbank-gidsen</p>
      <h2 class="text-2xl lg:text-3xl font-bold text-navy mb-6">Lees verder: praktische AI-gidsen voor de bouwsector</h2>
      <ul class="space-y-3">
        <li><a href="/kennisbank/ai-bouwbedrijf-offerte-automatisering/" class="flex items-center justify-between gap-4 p-4 rounded-xl bg-white border border-slate-200 hover:border-brand-indigo hover:shadow-sm transition-all"><span class="text-sm font-medium text-navy">AI offerte-automatisering voor bouwbedrijven</span><span class="text-xs text-brand-indigo flex-shrink-0">Lees gids →</span></a></li>
        <li><a href="/kennisbank/ai-voor-installatiebedrijf-loodgieter-nederland/" class="flex items-center justify-between gap-4 p-4 rounded-xl bg-white border border-slate-200 hover:border-brand-indigo hover:shadow-sm transition-all"><span class="text-sm font-medium text-navy">AI voor installatiebedrijf en loodgieter</span><span class="text-xs text-brand-indigo flex-shrink-0">Lees gids →</span></a></li>
        <li><a href="/kennisbank/ai-roi-berekenen-mkb-nederland-2026/" class="flex items-center justify-between gap-4 p-4 rounded-xl bg-white border border-slate-200 hover:border-brand-indigo hover:shadow-sm transition-all"><span class="text-sm font-medium text-navy">AI ROI berekenen voor MKB 2026</span><span class="text-xs text-brand-indigo flex-shrink-0">Lees gids →</span></a></li>
      </ul>
      <div class="mt-8">
        <a href="/kennisbank/" class="text-sm text-brand-indigo hover:underline font-medium">Alle 54 kennisbank-gidsen bekijken →</a>
      </div>
    </div>
  </section>
</BaseLayout>
