---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import sectorImage from '../../assets/images/sectoren/webshops.jpg';
const faqItems = [
  { question: 'Kan AI helpen bij klantenservice voor webshops?', answer: 'Ja, zeer effectief. Een AI agent beantwoordt tot 70% van alle klantvragen automatisch: orderstatus, retourinformatie, verzendtijden en productinformatie. Alleen complexe klachten of uitzonderingen worden doorgezet naar een menselijke medewerker.' },
  { question: 'Werkt een AI agent met mijn webshop-platform (WooCommerce, Shopify)?', answer: 'Ja. Aanloop AI koppelt AI agents via n8n met WooCommerce, Shopify, Magento en maatwerk webshops. De agent heeft real-time toegang tot orderdata, voorraad en klantinformatie.' },
  { question: 'Hoe gaat een AI agent om met retourvragen?', answer: 'De AI agent heeft uw retourbeleid geladen en kan direct antwoorden geven, een retourlabel genereren (via API-koppeling) en de status van een retouraanvraag bijhouden.' },
  { question: 'Is een AI klantenservice voor webshops AVG-compliant?', answer: 'Ja. Aanloop AI gebruikt n8n self-hosted, waardoor klantdata op een Nederlandse server wordt verwerkt. Transactielog en klantgegevens blijven uitsluitend bij u.' },
  { question: 'Wat kost een AI agent voor een webshop?', answer: 'Het Groei pakket (€1.197/maand, Marco + Emma) is het meest populair voor webshops met hoog volume. Het Starter pakket (€597/maand) is geschikt voor webshops met minder dan 150 klantvragen per maand. Voor enkel WhatsApp-support is Emma standalone vanaf €197/maand een goedkopere optie.' },
];
const schema = { '@context': 'https://schema.org', '@type': 'Service', name: 'AI voor Webshops en E-commerce', serviceType: 'AI voor Webshops en E-commerce', provider: { '@type': 'Organization', name: 'Aanloop AI', url: 'https://aanloopai.nl' }, areaServed: { '@type': 'Country', name: 'Nederland' }, description: 'AI agents en workflow automation voor Nederlandse webshops. 70% van klantvragen automatisch afgehandeld.' };
---
<BaseLayout title="AI voor Webshops: 70% Minder Klantenservicevragen" description="AI klantenservice voor webshops in Nederland. Automatisch orderstatus, retourvragen, productinfo en meer. Koppelt met WooCommerce, Shopify. KVK: 88606902." schema={schema} faqSchema={faqItems}>
  <section class="border-b border-slate-200 hero-gradient">
    <div class="container-page py-16 lg:py-20">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div class="max-w-3xl">
        <div class="flex items-center gap-4 mb-6"><div class="accent-band"><span></span><span></span><span></span><span></span></div><span class="eyebrow">Sectoren · E-commerce</span></div>
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tightest text-navy text-balance leading-[1.08] reveal reveal-delay-1">AI voor Webshops:<br/>70% Minder Klantenservicevragen</h1>
        <p class="mt-6 text-lg text-slate-600 leading-relaxed reveal reveal-delay-2">Een AI agent beantwoordt automatisch orderstatus, retourvragen, verzendinfo en productadvies — via chat, WhatsApp of telefoon. Koppelt met WooCommerce, Shopify en meer.</p>
        <div class="mt-8 flex flex-col sm:flex-row gap-3 reveal reveal-delay-3">
          <a href="/gratis-ai-scan/" class="btn-primary">Gratis AI Scan voor webshops<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></a>
          <a href="/prijzen/" class="btn-outline">Bekijk tarieven</a>
        </div>
      </div>
      <div class="reveal reveal-delay-2">
        <Image src={sectorImage} alt="Online shopping met laptop en creditcard — AI voor webshops en e-commerce" class="w-full rounded-2xl shadow-xl object-cover aspect-[4/3]" loading="eager" decoding="async" fetchpriority="high" widths={[480, 800, 1200, 1400]} sizes="(min-width: 1024px) 600px, 100vw" format="webp" quality={82} />
      </div>
      </div>
    </div>
  </section>
  <!-- Sector-specifieke uitdagingen -->
  <section class="section border-b border-slate-200">
    <div class="container-page max-w-4xl mx-auto">
      <div class="mb-10 reveal">
        <p class="eyebrow mb-2">Uitdagingen voor webshops & e-commerce</p>
        <h2 class="text-2xl font-bold text-navy mb-6">Waarom klantenservice bij webshops zonder AI escaleert</h2>
        <p class="text-slate-600 leading-relaxed mb-6">Nederlandse webshops ontvangen gemiddeld 3–8 klantenservice-contacten per 100 bestellingen. Bij een webshop met 500 bestellingen per maand zijn dat 15–40 contactmomenten per dag — over orderstatus, retourvragen, leveringstijden en productadvies. Zonder AI-ondersteuning kost dit een fulltime equivalent of leidt tot lange reactietijden en dalende klanttevredenheid.</p>
      </div>
      <div class="space-y-5 reveal">
        {[
          { title: 'Klantenservice volume domineert de werkdag', body: 'Tot 70% van alle klantenservice-vragen bij webshops zijn repetitief: "Waar is mijn bestelling?", "Hoe retourneer ik?", "Wanneer wordt bezorgd?" AI agent Emma beantwoordt deze vragen automatisch via WhatsApp en chat — met real-time koppeling aan uw WooCommerce of Shopify orderdata.' },
          { title: 'Retourafhandeling drukt de marge bij hoog volume', body: 'Elk retourproces kost gemiddeld €4–8 aan personeelskosten. Bij webshops met een retourpercentage van 20–30% (mode, elektronica) loopt dit snel op. AI automatiseert de retouraanvraag, genereert retourlabels via koppeling met PostNL/DHL Parcel en houdt de retourstatus bij — zonder menselijke ingreep.' },
          { title: 'Seizoenspieken zijn niet op te vangen met vast personeel', body: 'Singles Day, Black Friday en de kerstperiode verveelvoudigen het klantenservice-volume binnen enkele dagen. Vast personeel aannemen voor piekperiodes is niet kostenefficiënt. AI schaalt automatisch op: geen extra kosten, geen inwerktijd, dezelfde responstijd.' },
          { title: 'Productadvies en cross-selling blijven onderbenut', body: 'Klanten die via WhatsApp of chat contact opnemen, zijn koopbereid. Zonder AI-ondersteuning worden ze standaard doorverwezen naar de website. Met AI wordt de klantintentie herkend en wordt direct het juiste product aanbevolen — inclusief cross-sell op basis van eerdere aankopen.' },
        ].map(item => (
          <div class="border border-slate-200 rounded-xl p-5 bg-white">
            <h3 class="font-semibold text-navy mb-2 text-sm">{item.title}</h3>
            <p class="text-sm text-slate-600 leading-relaxed">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Trust signals -->
  <section class="section border-b border-slate-200">
    <div class="container-page max-w-4xl mx-auto">
      <div class="mb-8 reveal">
        <p class="eyebrow mb-2">Compliance & integraties</p>
        <h2 class="text-2xl font-bold text-navy mb-4">Voor webshops werken wij speciaal met</h2>
      </div>
      <div class="grid md:grid-cols-2 gap-4 reveal">
        {[
          { icon: '🛒', title: 'Shopify, WooCommerce & Lightspeed koppelingen', body: 'Directe API-koppeling met Shopify, WooCommerce, Magento en Lightspeed. De AI agent heeft real-time toegang tot orderdata, voorraadstatus en klantinformatie. Bestellingsupdates worden automatisch gesynchroniseerd.' },
          { icon: '📦', title: 'PostNL, DHL Parcel & Sendcloud integraties', body: 'Track & trace informatie wordt direct opgehaald uit PostNL, DHL Parcel of via Sendcloud. Klanten ontvangen automatisch een statusupdate bij elke nieuwe scan — proactief, zonder dat ze hoeven te bellen.' },
          { icon: '💳', title: 'Mollie, iDeal & betalingsstatus', body: 'Betalingsstatus, terugbetalingen en openstaande facturen worden real-time gecheckt via koppeling met Mollie. Bij retour wordt automatisch een terugbetaling geïnitieerd zodra het pakket is ontvangen — volledig traceerbaar.' },
          { icon: '🔒', title: 'AVG-conforme klantdata verwerking', body: 'Klantdata van uw webshop wordt verwerkt op een Nederlandse server via n8n self-hosted. Geen doorgifte aan Amerikaanse cloudproviders. Transactielogboek beschikbaar voor AVG-audits. Verwerkersovereenkomst inbegrepen conform AVG artikel 28.' },
        ].map(t => (
          <div class="flex gap-4 p-4 rounded-xl border border-slate-200 bg-slate-50">
            <span class="text-2xl">{t.icon}</span>
            <div>
              <p class="font-semibold text-navy text-sm mb-1">{t.title}</p>
              <p class="text-xs text-slate-600 leading-relaxed">{t.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page max-w-4xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
        {[
          { icon: '📦', t: 'Orderstatus', d: 'Klanten vragen de status van hun bestelling op via chat of WhatsApp. De AI agent raadpleegt real-time uw webshop.' },
          { icon: '🔄', t: 'Retourvragen', d: 'Retourbeleid uitleggen, retourlabel aanmaken en aanvraag bijhouden — volledig automatisch.' },
          { icon: '🚚', t: 'Verzend- & Leverinfo', d: 'Levertijden, verzendkosten en tracking automatisch beantwoord per klant en per bestelling.' },
          { icon: '💬', t: 'Productadvies', d: 'Op basis van de klantvraag het juiste product aanbevelen uit uw assortiment.' },
          { icon: '⭐', t: 'Review Opvolging', d: 'Na levering automatisch een review-uitnodiging sturen en opvolgen bij negatieve ervaringen.' },
          { icon: '📊', t: 'Analytics & Rapportage', d: 'Wekelijks overzicht van meest gestelde vragen, responstijden en escalaties.' },
        ].map(u => (
          <div class="card reveal">
            <div class="text-2xl mb-3">{u.icon}</div>
            <h3 class="font-bold text-navy text-sm mb-2">{u.t}</h3>
            <p class="text-sm text-slate-600">{u.d}</p>
          </div>
        ))}
      </div>
      <div class="bg-slate-50 border border-slate-200 rounded-2xl p-8 mb-12 reveal">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
          {[
            { n: '70%', l: 'Vragen automatisch', d: 'zonder menselijke ingreep' },
            { n: '< 1s', l: 'Reactietijd', d: 'vs. minuten bij handmatig' },
            { n: '24/7', l: 'Beschikbaar', d: 'ook in het weekend' },
            { n: '€1.500', l: 'Besparing/maand', d: 'gemiddeld voor MKB-webshop' },
          ].map(s => (
            <div>
              <p class="text-2xl font-bold text-navy">{s.n}</p>
              <p class="text-xs font-medium text-slate-600">{s.l}</p>
              <p class="text-xs text-slate-400">{s.d}</p>
            </div>
          ))}
        </div>
      </div>
      <h2 class="text-2xl font-bold text-navy mb-6">Veelgestelde Vragen — AI voor Webshops</h2>
      <div class="space-y-3 mb-8">
        {faqItems.map(item => (
          <details class="card group">
            <summary class="flex items-center justify-between cursor-pointer list-none">
              <span class="text-sm font-bold text-navy pr-6">{item.question}</span>
              <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <p class="mt-4 text-sm text-slate-600 leading-relaxed">{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container-page max-w-3xl">
      <p class="eyebrow text-brand-indigo mb-2">Verdiepende kennisbank-gidsen</p>
      <h2 class="text-2xl lg:text-3xl font-bold text-navy mb-6">Lees verder: praktische AI-gidsen voor deze sector</h2>
      <ul class="space-y-3">
        <li><a href="/kennisbank/ai-voor-shopify-webshop-nederland/" class="flex items-center justify-between gap-4 p-4 rounded-xl bg-white border border-slate-200 hover:border-brand-indigo hover:shadow-sm transition-all"><span class="text-sm font-medium text-navy">AI voor Shopify webshop</span><span class="text-xs text-brand-indigo flex-shrink-0">Lees gids →</span></a></li>
        <li><a href="/kennisbank/ai-voor-detailhandel-klantcontact-voorraad/" class="flex items-center justify-between gap-4 p-4 rounded-xl bg-white border border-slate-200 hover:border-brand-indigo hover:shadow-sm transition-all"><span class="text-sm font-medium text-navy">AI voor detailhandel</span><span class="text-xs text-brand-indigo flex-shrink-0">Lees gids →</span></a></li>
        <li><a href="/kennisbank/ai-voor-pensioenadviseur-nederland-2026/" class="flex items-center justify-between gap-4 p-4 rounded-xl bg-white border border-slate-200 hover:border-brand-indigo hover:shadow-sm transition-all"><span class="text-sm font-medium text-navy">AI voor pensioenadviseur — DGA-pensioen voor e-commerce ondernemers</span><span class="text-xs text-brand-indigo flex-shrink-0">Lees gids →</span></a></li>
        <li><a href="/kennisbank/ai-voor-financieel-planner-nederland-2026/" class="flex items-center justify-between gap-4 p-4 rounded-xl bg-white border border-slate-200 hover:border-brand-indigo hover:shadow-sm transition-all"><span class="text-sm font-medium text-navy">AI voor financieel-planner — fiscale planning webshop-eigenaren</span><span class="text-xs text-brand-indigo flex-shrink-0">Lees gids →</span></a></li>
      </ul>
      <div class="mt-8">
        <a href="/kennisbank/" class="text-sm text-brand-indigo hover:underline font-medium">Alle 48 kennisbank-gidsen bekijken →</a>
      </div>
    </div>
  </section>

  <section class="section bg-slate-50 border-y border-slate-200">
    <div class="container-page max-w-4xl">
      <p class="eyebrow text-brand-indigo mb-2">Webshop + AI = 1 partner</p>
      <h2 class="text-2xl lg:text-3xl font-bold text-navy mb-4">Bouwen we ook uw webshop? Ja — Shopify, WooCommerce of headless</h2>
      <p class="text-slate-600 mb-8 leading-relaxed">Veel MKB-webshops hebben twee partijen: een webbureau dat de webshop bouwt en een AI-leverancier die er later iets bovenop plakt. Bij Aanloop AI is dat één traject. Wij bouwen de webshop AI-ready vanaf dag één, en zetten Marco (telefoon) + Emma (WhatsApp cart-recovery) er direct op.</p>
      <div class="grid md:grid-cols-3 gap-4">
        <a href="/diensten/webshop-laten-maken-shopify-woocommerce-nederland-2026/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">Webshop laten maken</h3>
          <p class="text-xs text-slate-600 mb-3">Shopify, WooCommerce, Lightspeed, headless. iDeal/Mollie + PostNL/DHL.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk pakketten →</span>
        </a>
        <a href="/diensten/ai-website-bundel-mkb-nederland/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">AI-Website Bundel</h3>
          <p class="text-xs text-slate-600 mb-3">Webshop + Marco + Emma in 1 pakket. Bespaart €8.014 in jaar 1.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk bundel →</span>
        </a>
        <a href="/kennisbank/website-bouwer-vs-ai-ready-partner-mkb-nederland-2026/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">Webbureau vs AI-ready partner</h3>
          <p class="text-xs text-slate-600 mb-3">TCO 3-jaar tabel + 8-punts checklist voor elke webbureau-evaluatie.</p>
          <span class="text-xs text-brand-indigo font-medium">Lees vergelijking →</span>
        </a>
        <a href="/ai-voor-ecommerce-webshops-nederland/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">Diepere pillar-gids e-commerce</h3>
          <p class="text-xs text-slate-600 mb-3">Volledige gids: WhatsApp Business klantcontact, retour-flow, voorraadkoppeling Shopify/WooCommerce.</p>
          <span class="text-xs text-brand-indigo font-medium">Lees pillar-gids →</span>
        </a>
      </div>
    </div>
  </section>


  <section class="section-tight bg-midnight text-pearl relative overflow-hidden">
    <div class="absolute inset-0 dot-grid opacity-[0.04]"></div>
    <div class="container-page relative max-w-3xl">
      <h2 class="text-3xl font-bold tracking-tightest text-pearl text-balance reveal">Minder klantenservicevragen, meer omzet?</h2>
      <p class="mt-4 text-slate-300 reveal reveal-delay-1">Plan een gratis AI scan voor uw webshop en ontdek hoeveel klantvragen automatisch kunnen worden afgehandeld.</p>
      <div class="mt-6 flex flex-col sm:flex-row gap-3 reveal reveal-delay-2">
        <a href="/gratis-ai-scan/" class="btn bg-pearl text-navy hover:bg-white text-base px-6 py-3.5">Gratis AI Scan aanvragen<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></a>
        <a href="/prijzen/" class="btn border border-slate-700 text-pearl hover:bg-slate-800 text-base px-6 py-3.5">Bekijk AI prijzen</a>
      </div>
    </div>
  </section>
</BaseLayout>
