---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import sectorImage from '../../assets/images/sectoren/advocaten.jpg';

const faqItems = [
  { question: 'Hoe kan AI een advocatenkantoor helpen?', answer: 'AI helpt advocatenkantoren op drie gebieden: (1) intake-screening — automatisch kwalificerende vragen stellen aan potentiële cliënten, (2) agendabeheer — afspraken inplannen en bevestigen zonder receptionist, (3) documentverwerking — contracten en dossiers snel indexeren. Het resultaat: meer factureerbare uren, minder administratie.' },
  { question: 'Is AI voor advocaten AVG/GDPR-compliant?', answer: 'Ja, mits correct geconfigureerd. Aanloop AI gebruikt n8n self-hosted, waardoor alle cliëntdata op een Nederlandse server wordt verwerkt. Er worden geen persoonsgegevens naar buitenlandse clouddiensten gestuurd. We leveren documentatie voor uw verwerkingsregister (AVG Art. 30).' },
  { question: 'Vervangt een AI agent mijn secretaresse?', answer: 'Niet volledig — maar het vermindert wel de werklast significant. Een AI agent verwerkt routinetaken (afspraken, FAQ, intake-screening) zodat uw secretaresse zich kan richten op meer complexe taken die menselijke aanwezigheid vereisen.' },
  { question: 'Kan de AI agent vertrouwelijke cliëntinformatie verwerken?', answer: 'Ja, veilig. Met n8n self-hosted draait alle data op uw eigen server. We configureren de AI agent zo dat vertrouwelijke informatie nooit gedeeld wordt met derden. Advocatengeheim wordt technisch geborgd door strikte data-isolatie.' },
  { question: 'Hoeveel uur per week bespaart een AI agent voor een advocatenkantoor?', answer: 'Gemiddeld 10-20 uur per week op intake-gesprekken, telefonische vragen en agendabeheer. Een kantoor met 4 advocaten bespaard zo circa €6.000-12.000 per maand aan niet-factureerbaar werk.' },
];
const schema = { '@context': 'https://schema.org', '@type': 'Service', name: 'AI voor Advocatenkantoren', serviceType: 'AI voor Advocatenkantoren', provider: { '@type': 'Organization', name: 'Aanloop AI', url: 'https://aanloopai.nl' }, areaServed: { '@type': 'Country', name: 'Nederland' }, description: 'AI agents en workflow automation voor advocatenkantoren in Nederland. AVG-compliant, intake-screening, agendabeheer.' };
---
<BaseLayout title="AI voor Advocatenkantoor Nederland - Intake, Agenda, Documenten" description="AI voor advocatenkantoor Nederland: AI-agent voor intake-screening, agendabeheer en documentverwerking. AVG-compliant en geheimhoudingsplicht-veilig. Bespaar 10-20 uur per week. KVK 88606902." schema={schema} faqSchema={faqItems}>
  <section class="border-b border-slate-200 hero-gradient">
    <div class="container-page py-16 lg:py-20">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div class="max-w-3xl">
        <div class="flex items-center gap-4 mb-6"><div class="accent-band"><span></span><span></span><span></span><span></span></div><span class="eyebrow">Sectoren · Juridisch</span></div>
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tightest text-navy text-balance leading-[1.08] reveal reveal-delay-1">AI voor Advocatenkantoren:<br/>Meer Factureerbare Uren, Minder Administratie</h1>
        <p class="mt-6 text-lg text-slate-600 leading-relaxed reveal reveal-delay-2">Aanloop AI bouwt AVG-compliant AI agents voor Nederlandse advocatenkantoren. Van automatische intake-screening tot 24/7 agendabeheer — zodat advocaten zich richten op de zaken die ertoe doen.</p>
        <div class="mt-8 flex flex-col sm:flex-row gap-3 reveal reveal-delay-3">
          <a href="/gratis-ai-scan/" class="btn-primary">Gratis AI Scan voor advocaten<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></a>
          <a href="/prijzen/" class="btn-outline">Bekijk tarieven</a>
        </div>
      </div>
      <div class="reveal reveal-delay-2">
        <Image src={sectorImage} alt="Vrouwe Justitia statue — AI voor advocatenkantoren en juridische dienstverlening" class="w-full rounded-2xl shadow-xl object-cover aspect-[4/3]" loading="eager" decoding="async" fetchpriority="high" widths={[480, 800, 1200, 1400]} sizes="(min-width: 1024px) 600px, 100vw" format="webp" quality={82} />
      </div>
      </div>
    </div>
  </section>

  <section class="section bg-slate-50 border-b border-slate-200">
    <div class="container-page">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        {[
          { n: '10-20u', l: 'bespaard/week', d: 'op niet-factureerbaar werk' },
          { n: '40%', l: 'hogere cliëntkwaliteit', d: 'door AI intake-screening' },
          { n: '24/7', l: 'bereikbaar', d: 'ook buiten kantooruren' },
          { n: '100%', l: 'AVG-compliant', d: 'data op NL server' },
        ].map(s => (
          <div class="reveal">
            <p class="text-2xl font-bold text-navy">{s.n}</p>
            <p class="text-sm font-medium text-slate-600">{s.l}</p>
            <p class="text-xs text-slate-400">{s.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page max-w-4xl mx-auto">
      <div class="mb-10 reveal">
        <p class="eyebrow mb-2">Use cases</p>
        <h2 class="text-2xl font-bold text-navy">Wat doet een AI agent voor uw advocatenkantoor?</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
        {[
          { icon: '📋', t: 'Intake-screening', d: 'De AI agent stelt kwalificerende vragen aan potentiële cliënten via telefoon of formulier. Alleen relevante dossiers worden doorgezet naar de advocaat. Besparing: 8-12 uur per week op niet-factureerbare intakegesprekken.' },
          { icon: '📅', t: 'Agendabeheer & Afspraken', d: 'Cliënten kunnen 24/7 een consult inplannen via telefoon of WhatsApp. De agent controleert beschikbaarheid, plant in en stuurt automatisch een bevestiging en herinnering.' },
          { icon: '📞', t: '24/7 Bereikbaarheid', d: 'Buiten kantooruren neemt de AI agent calls aan, beantwoordt basale vragen en legt urgentie vast. U start elke ochtend met een overzicht van alle gemiste calls.' },
          { icon: '📄', t: 'Documentintake', d: 'Nieuwe cliënten kunnen documenten uploaden. De AI agent indexeert, categoriseert en koppelt aan het juiste dossier — klaar voor de behandelend advocaat.' },
          { icon: '📧', t: 'E-mail Opvolging', d: 'Automatische e-mail workflows voor standaardcommunicatie: opdrachtbevestiging, facturering, voortgangsupdate. Geen handmatig werk meer voor routinecorrespondentie.' },
          { icon: '🔒', t: 'AVG-compliant & Veilig', d: 'Alle data blijft op een Nederlandse server (n8n self-hosted). Advocatengeheim is technisch geborgd. Wij leveren documentatie voor uw verwerkingsregister.' },
        ].map(u => (
          <div class="card reveal">
            <div class="text-2xl mb-3">{u.icon}</div>
            <h3 class="font-bold text-navy mb-2">{u.t}</h3>
            <p class="text-sm text-slate-600">{u.d}</p>
          </div>
        ))}
      </div>

      <div class="bg-slate-50 border border-slate-200 rounded-2xl p-8 mb-12 reveal">
        <p class="eyebrow mb-2">Casestudy</p>
        <h3 class="text-xl font-bold text-navy mb-4">Advocatenkantoor: 12 uur/week bespaard op intake</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-sm">
          <div>
            <p class="font-semibold text-slate-700 mb-2">Situatie</p>
            <p class="text-slate-600">Een advocatenkantoor met 6 advocaten ontving wekelijks 40+ telefoontjes van potentiële cliënten. 70% was niet gekwalificeerd. De advocaten verloren 15 uur per week aan ongeschikt intakewerk.</p>
          </div>
          <div>
            <p class="font-semibold text-slate-700 mb-2">Oplossing & Resultaat</p>
            <ul class="space-y-1 text-slate-600">
              <li class="flex items-start gap-2"><span class="text-brand-emerald mt-0.5">✓</span> AI intake-agent kwalificeert alle inkomende calls</li>
              <li class="flex items-start gap-2"><span class="text-brand-emerald mt-0.5">✓</span> 12 uur/week bespaard op intake</li>
              <li class="flex items-start gap-2"><span class="text-brand-emerald mt-0.5">✓</span> 40% hogere kwaliteit van nieuwe cliënten</li>
              <li class="flex items-start gap-2"><span class="text-brand-emerald mt-0.5">✓</span> €7.200/maand meer factureerbaar werk</li>
            </ul>
          </div>
        </div>
      </div>

      <h2 class="text-2xl font-bold text-navy mb-6">Veelgestelde Vragen — AI voor Advocaten</h2>
      <div class="space-y-3 mb-8">
        {faqItems.map(item => (
          <details class="card group">
            <summary class="flex items-center justify-between cursor-pointer list-none">
              <span class="text-sm font-bold text-navy pr-6">{item.question}</span>
              <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <p class="mt-4 text-sm text-slate-600 leading-relaxed">{item.answer}</p>
          </details>
        ))}
      </div>

      <div class="bg-slate-50 border border-slate-200 rounded-xl p-6">
        <p class="text-sm font-bold text-navy mb-3">Meer over AI agents</p>
        <ul class="space-y-2">
          <li><a href="/kennisbank/wat-is-een-ai-agent/" class="text-sm text-brand-indigo hover:underline">Wat is een AI Agent? De Complete Gids voor MKB →</a></li>
          <li><a href="/kennisbank/voice-ai-klantenservice/" class="text-sm text-brand-indigo hover:underline">Voice AI Agents voor Klantenservice →</a></li>
          <li><a href="/kennisbank/ai-agent-kosten-mkb/" class="text-sm text-brand-indigo hover:underline">Hoeveel kost een AI agent? (2026 prijzen) →</a></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Locations cross-link -->
  <section class="section-tight border-t border-slate-200">
    <div class="container-page">
      <p class="eyebrow mb-3">AI voor advocaten in heel Nederland</p>
      <h2 class="text-2xl lg:text-3xl font-bold tracking-tighter-2 text-navy text-balance mb-6">
        Advocatenkantoren in elke stad — landelijke dekking.
      </h2>
      <p class="text-slate-600 leading-relaxed mb-6 max-w-2xl">
        Van de Zuidas in Amsterdam tot Rotterdamse en Haagse advocatenkantoren: Aanloop AI bedient
        juridische praktijken in heel Nederland. AVG- en geheimhoudingsplicht-compliant, met optionele
        NEN 7510-opzet voor extra-gevoelige dossiers.
      </p>
      <div class="flex flex-wrap gap-2">
        <a href="/locaties/amsterdam/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-slate-50 hover:bg-slate-100 border border-slate-200 hover:border-slate-300 rounded-lg text-xs font-medium text-navy transition-all">AI advocaten Amsterdam →</a>
        <a href="/locaties/rotterdam/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-slate-50 hover:bg-slate-100 border border-slate-200 hover:border-slate-300 rounded-lg text-xs font-medium text-navy transition-all">AI advocaten Rotterdam →</a>
        <a href="/locaties/den-haag/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-slate-50 hover:bg-slate-100 border border-slate-200 hover:border-slate-300 rounded-lg text-xs font-medium text-navy transition-all">AI advocaten Den Haag →</a>
        <a href="/locaties/utrecht/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-slate-50 hover:bg-slate-100 border border-slate-200 hover:border-slate-300 rounded-lg text-xs font-medium text-navy transition-all">AI advocaten Utrecht →</a>
        <a href="/locaties/eindhoven/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-slate-50 hover:bg-slate-100 border border-slate-200 hover:border-slate-300 rounded-lg text-xs font-medium text-navy transition-all">AI advocaten Eindhoven →</a>
        <a href="/locaties/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-brand-indigo/5 hover:bg-brand-indigo/10 border border-brand-indigo/20 rounded-lg text-xs font-medium text-brand-indigo transition-all">Alle steden →</a>
      </div>
    </div>
  </section>

  <!-- Other sectors cross-link -->
  <section class="section-tight bg-slate-50/60 border-y border-slate-200">
    <div class="container-page">
      <p class="eyebrow mb-3">Andere sectoren</p>
      <h2 class="text-2xl lg:text-3xl font-bold tracking-tighter-2 text-navy text-balance mb-6">
        AI-oplossingen voor zakelijke dienstverlening.
      </h2>
      <div class="flex flex-wrap gap-2">
        <a href="/sectoren/accountancy/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white hover:bg-slate-50 border border-slate-200 hover:border-navy rounded-lg text-xs font-medium text-navy transition-all">AI voor accountancy →</a>
        <a href="/sectoren/zakelijk/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white hover:bg-slate-50 border border-slate-200 hover:border-navy rounded-lg text-xs font-medium text-navy transition-all">AI voor zakelijke dienstverlening →</a>
        <a href="/sectoren/zorg/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white hover:bg-slate-50 border border-slate-200 hover:border-navy rounded-lg text-xs font-medium text-navy transition-all">AI voor zorg →</a>
        <a href="/sectoren/ai-voor-zzp/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white hover:bg-slate-50 border border-slate-200 hover:border-navy rounded-lg text-xs font-medium text-navy transition-all">AI voor ZZP →</a>
        <a href="/sectoren/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-brand-indigo/5 hover:bg-brand-indigo/10 border border-brand-indigo/20 rounded-lg text-xs font-medium text-brand-indigo transition-all">Alle sectoren →</a>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container-page max-w-3xl">
      <p class="eyebrow text-brand-indigo mb-2">Verdiepende kennisbank-gidsen</p>
      <h2 class="text-2xl lg:text-3xl font-bold text-navy mb-6">Lees verder: praktische AI-gidsen voor deze sector</h2>
      <ul class="space-y-3">
        <li><a href="/kennisbank/ai-voor-advocatenkantoor-2026/" class="flex items-center justify-between gap-4 p-4 rounded-xl bg-white border border-slate-200 hover:border-brand-indigo hover:shadow-sm transition-all"><span class="text-sm font-medium text-navy">AI voor advocatenkantoor 2026</span><span class="text-xs text-brand-indigo flex-shrink-0">Lees gids →</span></a></li>
        <li><a href="/kennisbank/ai-avg-gdpr-compliance-mkb-nederland/" class="flex items-center justify-between gap-4 p-4 rounded-xl bg-white border border-slate-200 hover:border-brand-indigo hover:shadow-sm transition-all"><span class="text-sm font-medium text-navy">AI en AVG-compliance MKB</span><span class="text-xs text-brand-indigo flex-shrink-0">Lees gids →</span></a></li>
        <li><a href="/kennisbank/ai-voor-financieel-planner-nederland-2026/" class="flex items-center justify-between gap-4 p-4 rounded-xl bg-white border border-slate-200 hover:border-brand-indigo hover:shadow-sm transition-all"><span class="text-sm font-medium text-navy">AI voor financieel-planner — estate planning en vermogensoverdracht</span><span class="text-xs text-brand-indigo flex-shrink-0">Lees gids →</span></a></li>
        <li><a href="/kennisbank/ai-voor-pensioenadviseur-nederland-2026/" class="flex items-center justify-between gap-4 p-4 rounded-xl bg-white border border-slate-200 hover:border-brand-indigo hover:shadow-sm transition-all"><span class="text-sm font-medium text-navy">AI voor pensioenadviseur — WTP-transitie en scheidingsdossier pensioenverdeling</span><span class="text-xs text-brand-indigo flex-shrink-0">Lees gids →</span></a></li>
        <li><a href="/kennisbank/ai-voor-hypotheekadviseur-nederland-2026/" class="flex items-center justify-between gap-4 p-4 rounded-xl bg-white border border-slate-200 hover:border-brand-indigo hover:shadow-sm transition-all"><span class="text-sm font-medium text-navy">AI voor hypotheekadviseur — huwelijksvermogen en samenlevingscontracten</span><span class="text-xs text-brand-indigo flex-shrink-0">Lees gids →</span></a></li>
      </ul>
      <div class="mt-8">
        <a href="/kennisbank/" class="text-sm text-brand-indigo hover:underline font-medium">Alle 84 kennisbank-gidsen bekijken →</a>
      </div>
    </div>
  </section>

  <section class="section bg-slate-50 border-y border-slate-200">
    <div class="container-page max-w-4xl">
      <p class="eyebrow text-brand-indigo mb-2">Website + AI = 1 partner</p>
      <h2 class="text-2xl lg:text-3xl font-bold text-navy mb-4">Advocatenkantoor-website nodig? Wij bouwen 'm AI-ready met intake-screening en agendabeheer</h2>
      <p class="text-slate-600 mb-8 leading-relaxed">Veel advocatenkantoren hebben een verouderde website en koppelen apart een AI-tool voor cliënt-intake of telefoon. Bij Aanloop AI is dat één traject: een AI-ready advocatenwebsite met expertise-pagina's, intake-formulieren, conflict-of-interest pre-check en Marco (24/7 telefoon-AI voor afspraken en first-line triage) ingebouwd vanaf dag één — inclusief AVG- en NOvA-toets.</p>
      <div class="grid md:grid-cols-3 gap-4">
        <a href="/diensten/website-laten-maken-mkb-nederland-2026/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">Advocaten-website laten maken</h3>
          <p class="text-xs text-slate-600 mb-3">Astro/Next/WordPress AI-ready. Schema.org LegalService + Speakable + WCAG 2.2 AA + AVG-checks.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk pakketten →</span>
        </a>
        <a href="/diensten/ai-website-bundel-mkb-nederland/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">AI-Website Bundel</h3>
          <p class="text-xs text-slate-600 mb-3">Website + Marco (telefoon) + Emma (WhatsApp) in 1 pakket. Bespaart €8.014 jaar 1.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk bundel →</span>
        </a>
        <a href="/kennisbank/website-bouwer-vs-ai-ready-partner-mkb-nederland-2026/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">Webbureau vs AI-ready partner</h3>
          <p class="text-xs text-slate-600 mb-3">TCO 3-jaar tabel + 8-punts checklist voor elke webbureau-evaluatie.</p>
          <span class="text-xs text-brand-indigo font-medium">Lees vergelijking →</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section-tight bg-midnight text-pearl relative overflow-hidden">
    <div class="absolute inset-0 dot-grid opacity-[0.04]"></div>
    <div class="container-page relative max-w-3xl">
      <h2 class="text-3xl font-bold tracking-tightest text-pearl text-balance reveal">Meer factureerbare uren voor uw kantoor?</h2>
      <p class="mt-4 text-slate-300 reveal reveal-delay-1">Plan een gratis AI scan en ontdek hoeveel uur uw advocaten kunnen terugwinnen op administratie en intake.</p>
      <div class="mt-6 flex flex-col sm:flex-row gap-3 reveal reveal-delay-2">
        <a href="/gratis-ai-scan/" class="btn bg-pearl text-navy hover:bg-white text-base px-6 py-3.5">Gratis AI Scan aanvragen<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></a>
        <a href="/prijzen/" class="btn border border-slate-700 text-pearl hover:bg-slate-800 text-base px-6 py-3.5">Bekijk AI prijzen</a>
      </div>
    </div>
  </section>
</BaseLayout>
