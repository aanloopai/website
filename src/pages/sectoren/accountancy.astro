---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import sectorImage from '../../assets/images/sectoren/accountancy.jpg';

const faqItems = [
  { question: 'Kan AI boekhoudkundige vragen beantwoorden?', answer: 'De AI-assistent beantwoordt veelgestelde vragen over uw diensten, aanlevertermijnen, benodigde documenten en tarieven. Complexe fiscale vragen worden doorgeleid naar de juiste medewerker.' },
  { question: 'Hoe gaat de AI om met vertrouwelijke klantinformatie?', answer: 'Aanloop AI verwerkt alle data AVG-compliant via n8n self-hosted op een Nederlandse server. De AI heeft alleen toegang tot informatie die u zelf deelt in de kennisbank. Financiële klantdata wordt nooit opgeslagen of verwerkt buiten uw eigen systemen.' },
  { question: 'Kan de AI afspraken inplannen voor belastingaangifteperiode?', answer: 'Ja. De AI plant automatisch afspraken in uw agenda, stuurt bevestigingen en herinneringen, en vraagt vooraf welke documenten de klant moet meenemen.' },
  { question: 'Hoeveel uur bespaar ik per week met een AI agent voor mijn boekhoudkantoor?', answer: 'Accountantskantoren besparen gemiddeld 10-20 uur per week op routinetaken: telefonische vragen (-72% minder onderbrekingen), documentverzameling en afspraakplanning. Dit staat gelijk aan €3.000-6.000/maand meer billable capaciteit.' },
  { question: 'Kan de AI facturen automatisch verwerken?', answer: 'Ja. Via een n8n koppeling met Exact Online, Twinfield of Visma verwerkt de AI facturen automatisch: extraheren van data, categoriseren en boeken. Gemiddeld 85% tijdsbesparing op factuurverwerking. Zie onze kennisbank voor meer details.' },
];
const schema = { '@context': 'https://schema.org', '@type': 'Service', name: 'AI voor Accountancy en Financieel Advies', serviceType: 'AI voor Accountancy en Financieel Advies', provider: { '@type': 'Organization', name: 'Aanloop AI', url: 'https://aanloopai.nl' }, areaServed: { '@type': 'Country', name: 'Nederland' }, description: 'AI agents voor accountants en boekhouders. Automatische factuurverwerking, afspraakinplanning, klantenservice. AVG-compliant.' };
---
<BaseLayout title="AI voor Accountantskantoor Nederland - Minder Bellen, Meer Advies" description="AI voor accountantskantoor Nederland: AI-assistent voor accountants en boekhouders. Automatische factuurverwerking, afspraakinplanning, documentverzameling. 72% minder onderbrekingen. KVK 88606902." schema={schema} faqSchema={faqItems}>
  <section class="border-b border-slate-200 hero-gradient">
    <div class="container-page py-16 lg:py-24">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div class="max-w-3xl">
        <div class="flex items-center gap-4 mb-6"><div class="accent-band"><span></span><span></span><span></span><span></span></div><span class="eyebrow">Accountancy &amp; Administratie</span></div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tightest text-navy text-balance leading-[1.05] reveal reveal-delay-1">Minder telefoneren, meer adviseren.</h1>
        <p class="mt-6 text-lg text-slate-600 leading-relaxed max-w-2xl reveal reveal-delay-2">Uw klanten bellen voor standaardvragen terwijl uw team bezig is met dossiers. De AI-assistent beantwoordt routinevragen, plant afspraken in en verzamelt documenten — automatisch.</p>
        <div class="mt-8 flex flex-col sm:flex-row gap-3 reveal reveal-delay-3">
          <a href="/gratis-ai-scan/" class="btn-primary text-base px-6 py-3.5">Gratis AI scan aanvragen <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></a>
          <a href="/prijzen/" class="btn-outline text-base px-6 py-3.5">Bekijk tarieven</a>
        </div>
      </div>
      <div class="reveal reveal-delay-2">
        <Image src={sectorImage} alt="Accountant aan bureau met financiele documenten — AI voor accountantskantoren" class="w-full rounded-2xl shadow-xl object-cover aspect-[4/3]" loading="eager" decoding="async" fetchpriority="high" widths={[480, 800, 1200, 1400]} sizes="(min-width: 1024px) 600px, 100vw" format="webp" quality={82} />
      </div>
      </div>
    </div>
  </section>

  <!-- Pain points -->
  <section class="section border-b border-slate-200">
    <div class="container-page">
      <div class="text-center mb-10 reveal"><h2 class="text-2xl font-bold text-navy">Herkenbaar voor uw kantoor?</h2></div>
      <div class="grid md:grid-cols-3 gap-6 mb-0">
        {[
          { icon: '📞', pain: 'Klantvragen onderbreken uw werk', fix: 'AI beantwoordt routinevragen direct en 24/7' },
          { icon: '📄', pain: 'Klanten leveren documenten te laat aan', fix: 'Automatische herinneringen via WhatsApp' },
          { icon: '🗓️', pain: 'Agenda vol met planningstelefoons', fix: 'Zelfservice afspraakinplanning voor klanten' },
        ].map(item => (
          <div class="card reveal">
            <div class="text-3xl mb-3">{item.icon}</div>
            <div class="text-sm font-semibold text-slate-500 mb-2 line-through">{item.pain}</div>
            <div class="text-sm text-brand-emerald font-medium">✅ {item.fix}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-slate-50 border-b border-slate-200">
    <div class="container-page">
      <div class="text-center mb-10 reveal"><h2 class="text-2xl font-bold text-navy">Wat de AI voor uw kantoor doet</h2></div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          { icon: '💬', title: 'Routievragen afhandelen', desc: 'BTW-termijnen, aanlevertijden, benodigde documenten — de AI antwoordt direct en correct.' },
          { icon: '🗓️', title: 'Afspraakinplanning', desc: 'Klanten plannen zelf een gesprek in uw agenda. Bevestiging en herinnering gaan automatisch.' },
          { icon: '📋', title: 'Documentverzameling', desc: 'AI stuurt een checklist met benodigde documenten en herinnert klanten die niet tijdig aanleveren.' },
          { icon: '🔄', title: 'Aangifteperiode support', desc: 'Extra capaciteit tijdens drukke periodes. De AI vangt de piek op zonder extra personeel.' },
          { icon: '📱', title: 'WhatsApp integratie', desc: 'Klanten communiceren via hun favoriete kanaal. De AI reageert binnen seconden.' },
          { icon: '🔒', title: 'AVG-compliant', desc: 'Alle data op een Nederlandse server. n8n self-hosted. DPA op verzoek beschikbaar.' },
        ].map(f => (
          <div class="card hover:shadow-lg transition-all reveal">
            <div class="text-3xl mb-3">{f.icon}</div>
            <h3 class="font-bold text-navy mb-2">{f.title}</h3>
            <p class="text-sm text-slate-600 leading-relaxed">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Results -->
  <section class="section">
    <div class="container-page max-w-4xl mx-auto">
      <div class="text-center mb-10 reveal"><h2 class="text-2xl font-bold text-navy">Gemiddeld resultaat bij accountantskantoren</h2></div>
      <div class="grid grid-cols-3 gap-6 mb-12 reveal reveal-delay-1">
        {[
          { value: '−72%', label: 'Minder telefonische onderbrekingen', color: 'text-brand-emerald' },
          { value: '+28%', label: 'Meer billable uren', color: 'text-brand-indigo' },
          { value: '4.8/5', label: 'Klanttevredenheid', color: 'text-brand-amber' },
        ].map(s => (
          <div class="card text-center">
            <div class={`text-3xl font-bold ${s.color}`}>{s.value}</div>
            <div class="text-xs text-slate-500 mt-1">{s.label}</div>
          </div>
        ))}
      </div>

      <!-- FAQ -->
      <h2 class="text-2xl font-bold text-navy mb-6">Veelgestelde Vragen — AI voor Accountancy</h2>
      <div class="space-y-3 mb-8">
        {faqItems.map(item => (
          <details class="card group">
            <summary class="flex items-center justify-between cursor-pointer list-none">
              <span class="text-base font-bold text-navy pr-6">{item.question}</span>
              <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <p class="mt-4 text-sm text-slate-600 leading-relaxed">{item.answer}</p>
          </details>
        ))}
      </div>
      <div class="bg-slate-50 border border-slate-200 rounded-xl p-6">
        <p class="text-sm font-bold text-navy mb-3">Gerelateerde artikelen</p>
        <ul class="space-y-2">
          <li><a href="/kennisbank/ai-facturering-automatisering/" class="text-sm text-brand-indigo hover:underline">Hoe Automatiseer je Je Facturering met AI? (Stap-voor-Stap) →</a></li>
          <li><a href="/kennisbank/ai-workflow-automation/" class="text-sm text-brand-indigo hover:underline">AI Workflow Automation: Complete Uitleg →</a></li>
          <li><a href="/kennisbank/n8n-vs-make-com/" class="text-sm text-brand-indigo hover:underline">n8n vs Make.com vs Zapier: Welke is het Beste voor MKB? →</a></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Locations cross-link -->
  <section class="section-tight border-t border-slate-200">
    <div class="container-page">
      <p class="eyebrow mb-3">AI voor accountancy in heel Nederland</p>
      <h2 class="text-2xl lg:text-3xl font-bold tracking-tighter-2 text-navy text-balance mb-6">
        Accountantskantoren in elke stad — landelijke dekking.
      </h2>
      <p class="text-slate-600 leading-relaxed mb-6 max-w-2xl">
        Van Amsterdam-Zuid tot Eindhoven en Groningen: Aanloop AI bedient accountancy-praktijken in heel
        Nederland. Trajecten verlopen remote met optionele on-site gesprekken voor grotere kantoren.
      </p>
      <div class="flex flex-wrap gap-2">
        <a href="/locaties/rotterdam/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-slate-50 hover:bg-slate-100 border border-slate-200 hover:border-slate-300 rounded-lg text-xs font-medium text-navy transition-all">AI accountants Rotterdam →</a>
        <a href="/locaties/amsterdam/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-slate-50 hover:bg-slate-100 border border-slate-200 hover:border-slate-300 rounded-lg text-xs font-medium text-navy transition-all">AI accountants Amsterdam →</a>
        <a href="/locaties/den-haag/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-slate-50 hover:bg-slate-100 border border-slate-200 hover:border-slate-300 rounded-lg text-xs font-medium text-navy transition-all">AI accountants Den Haag →</a>
        <a href="/locaties/utrecht/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-slate-50 hover:bg-slate-100 border border-slate-200 hover:border-slate-300 rounded-lg text-xs font-medium text-navy transition-all">AI accountants Utrecht →</a>
        <a href="/locaties/eindhoven/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-slate-50 hover:bg-slate-100 border border-slate-200 hover:border-slate-300 rounded-lg text-xs font-medium text-navy transition-all">AI accountants Eindhoven →</a>
        <a href="/locaties/breda/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-slate-50 hover:bg-slate-100 border border-slate-200 hover:border-slate-300 rounded-lg text-xs font-medium text-navy transition-all">AI accountants Breda →</a>
        <a href="/locaties/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-brand-indigo/5 hover:bg-brand-indigo/10 border border-brand-indigo/20 rounded-lg text-xs font-medium text-brand-indigo transition-all">Alle steden →</a>
      </div>
    </div>
  </section>

  <!-- Other sectors cross-link -->
  <section class="section-tight bg-slate-50/60 border-y border-slate-200">
    <div class="container-page">
      <p class="eyebrow mb-3">Andere sectoren</p>
      <h2 class="text-2xl lg:text-3xl font-bold tracking-tighter-2 text-navy text-balance mb-6">
        AI-oplossingen voor zakelijke dienstverlening.
      </h2>
      <div class="flex flex-wrap gap-2">
        <a href="/sectoren/ai-voor-advocaten/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white hover:bg-slate-50 border border-slate-200 hover:border-navy rounded-lg text-xs font-medium text-navy transition-all">AI voor advocaten →</a>
        <a href="/sectoren/zakelijk/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white hover:bg-slate-50 border border-slate-200 hover:border-navy rounded-lg text-xs font-medium text-navy transition-all">AI voor zakelijke dienstverlening →</a>
        <a href="/sectoren/ai-voor-zzp/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white hover:bg-slate-50 border border-slate-200 hover:border-navy rounded-lg text-xs font-medium text-navy transition-all">AI voor ZZP →</a>
        <a href="/sectoren/vastgoed/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white hover:bg-slate-50 border border-slate-200 hover:border-navy rounded-lg text-xs font-medium text-navy transition-all">AI voor vastgoed →</a>
        <a href="/sectoren/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-brand-indigo/5 hover:bg-brand-indigo/10 border border-brand-indigo/20 rounded-lg text-xs font-medium text-brand-indigo transition-all">Alle sectoren →</a>
      </div>
      <div class="mt-8">
        <p class="text-sm font-medium text-navy mb-3">Relevante kennisbank-artikelen</p>
        <div class="flex flex-wrap gap-2">
          <a href="/kennisbank/ai-facturering-automatisering/" class="text-sm text-brand-indigo hover:underline">AI factuurverwerking automatiseren →</a>
          <a href="/kennisbank/ai-automatisering-mkb/" class="text-sm text-brand-indigo hover:underline">AI automatisering voor MKB →</a>
          <a href="/kennisbank/ai-workflow-automation/" class="text-sm text-brand-indigo hover:underline">AI workflow automation uitleg →</a>
        </div>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container-page max-w-3xl">
      <p class="eyebrow text-brand-indigo mb-2">Verdiepende kennisbank-gidsen</p>
      <h2 class="text-2xl lg:text-3xl font-bold text-navy mb-6">Lees verder: praktische AI-gidsen voor deze sector</h2>
      <ul class="space-y-3">
        <li><a href="/kennisbank/ai-voor-accountantskantoor-nederland/" class="flex items-center justify-between gap-4 p-4 rounded-xl bg-white border border-slate-200 hover:border-brand-indigo hover:shadow-sm transition-all"><span class="text-sm font-medium text-navy">AI voor accountantskantoor</span><span class="text-xs text-brand-indigo flex-shrink-0">Lees gids →</span></a></li>
        <li><a href="/kennisbank/ai-facturering-automatisering/" class="flex items-center justify-between gap-4 p-4 rounded-xl bg-white border border-slate-200 hover:border-brand-indigo hover:shadow-sm transition-all"><span class="text-sm font-medium text-navy">AI facturering automatisering</span><span class="text-xs text-brand-indigo flex-shrink-0">Lees gids →</span></a></li>
        <li><a href="/kennisbank/ai-avg-gdpr-compliance-mkb-nederland/" class="flex items-center justify-between gap-4 p-4 rounded-xl bg-white border border-slate-200 hover:border-brand-indigo hover:shadow-sm transition-all"><span class="text-sm font-medium text-navy">AI en AVG-compliance MKB</span><span class="text-xs text-brand-indigo flex-shrink-0">Lees gids →</span></a></li>
        <li><a href="/kennisbank/ai-voor-pensioenadviseur-nederland-2026/" class="flex items-center justify-between gap-4 p-4 rounded-xl bg-white border border-slate-200 hover:border-brand-indigo hover:shadow-sm transition-all"><span class="text-sm font-medium text-navy">AI voor pensioenadviseur 2026 — Wft Pensioenadvies</span><span class="text-xs text-brand-indigo flex-shrink-0">Lees gids →</span></a></li>
        <li><a href="/kennisbank/ai-voor-financieel-planner-nederland-2026/" class="flex items-center justify-between gap-4 p-4 rounded-xl bg-white border border-slate-200 hover:border-brand-indigo hover:shadow-sm transition-all"><span class="text-sm font-medium text-navy">AI voor financieel-planner 2026 — Wft Vermogen</span><span class="text-xs text-brand-indigo flex-shrink-0">Lees gids →</span></a></li>
        <li><a href="/kennisbank/ai-voor-hypotheekadviseur-nederland-2026/" class="flex items-center justify-between gap-4 p-4 rounded-xl bg-white border border-slate-200 hover:border-brand-indigo hover:shadow-sm transition-all"><span class="text-sm font-medium text-navy">AI voor hypotheekadviseur 2026 — Wft Hypothecair</span><span class="text-xs text-brand-indigo flex-shrink-0">Lees gids →</span></a></li>
      </ul>
      <div class="mt-8">
        <a href="/kennisbank/" class="text-sm text-brand-indigo hover:underline font-medium">Alle 48 kennisbank-gidsen bekijken →</a>
      </div>
    </div>
  </section>

  <section class="section bg-slate-50 border-y border-slate-200">
    <div class="container-page max-w-4xl">
      <p class="eyebrow text-brand-indigo mb-2">Website + AI = 1 partner</p>
      <h2 class="text-2xl lg:text-3xl font-bold text-navy mb-4">Accountantskantoor-website nodig? Wij bouwen 'm AI-ready met intake, document-upload en planning</h2>
      <p class="text-slate-600 mb-8 leading-relaxed">Veel accountants- en administratiekantoren hebben een verouderde website en koppelen apart een AI-tool voor klant-intake of document-verwerking. Bij Aanloop AI is dat één traject: een AI-ready kantoor-website met cliënt-portal, document-upload en Marco (24/7 telefoon-AI voor afspraken en standaardvragen) ingebouwd vanaf dag één.</p>
      <div class="grid md:grid-cols-3 gap-4">
        <a href="/diensten/website-laten-maken-mkb-nederland-2026/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">Accountancy-website laten maken</h3>
          <p class="text-xs text-slate-600 mb-3">Astro/Next/WordPress AI-ready. Schema.org AccountingService + Speakable + WCAG 2.2 AA + AVG-checks.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk pakketten →</span>
        </a>
        <a href="/diensten/ai-website-bundel-mkb-nederland/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">AI-Website Bundel</h3>
          <p class="text-xs text-slate-600 mb-3">Website + Marco (telefoon) + Emma (WhatsApp) in 1 pakket. Bespaart €8.014 jaar 1.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk bundel →</span>
        </a>
        <a href="/kennisbank/website-bouwer-vs-ai-ready-partner-mkb-nederland-2026/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">Webbureau vs AI-ready partner</h3>
          <p class="text-xs text-slate-600 mb-3">TCO 3-jaar tabel + 8-punts checklist voor elke webbureau-evaluatie.</p>
          <span class="text-xs text-brand-indigo font-medium">Lees vergelijking →</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section-tight bg-midnight text-pearl relative overflow-hidden">
    <div class="absolute inset-0 dot-grid opacity-[0.04]"></div>
    <div class="container-page relative max-w-3xl">
      <h2 class="text-3xl font-bold tracking-tightest text-pearl text-balance reveal">Meer billable uren voor uw kantoor?</h2>
      <p class="mt-4 text-slate-300 reveal reveal-delay-1">Plan een gratis AI scan en ontdek hoeveel uur u terugwint op routinewerk. Live in 7 werkdagen.</p>
      <div class="mt-6 flex flex-col sm:flex-row gap-3 reveal reveal-delay-2">
        <a href="/gratis-ai-scan/" class="btn bg-pearl text-navy hover:bg-white text-base px-6 py-3.5">Gratis AI Scan aanvragen<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></a>
        <a href="/prijzen/" class="btn border border-slate-700 text-pearl hover:bg-slate-800 text-base px-6 py-3.5">Bekijk AI prijzen</a>
      </div>
    </div>
  </section>
<!-- xref-orphan-fix-2026-05-07 -->
<section class="border-t border-pearl/10 bg-midnight/60 py-12" aria-labelledby="xref-orphan-heading-accountancy">
  <div class="mx-auto max-w-6xl px-6">
    <h2 id="xref-orphan-heading-accountancy" class="text-xl font-semibold text-pearl mb-6">Lees ook</h2>
    <ul class="grid gap-3 sm:grid-cols-2 text-sm text-pearl/80">
      <li><a href="/kennisbank/ai-voor-pensioenadviseur-nederland-2026/" class="text-brand-blue hover:text-brand-blue/80 underline-offset-4 hover:underline">AI voor pensioenadviseur — Wft Pensioenadvies</a></li>
      <li><a href="/kennisbank/ai-voor-financieel-planner-nederland-2026/" class="text-brand-blue hover:text-brand-blue/80 underline-offset-4 hover:underline">AI voor financieel-planner — Wft Vermogen</a></li>
      <li><a href="/kennisbank/ai-voor-hypotheekadviseur-nederland-2026/" class="text-brand-blue hover:text-brand-blue/80 underline-offset-4 hover:underline">AI voor hypotheekadviseur — Wft Hypothecair</a></li>
      <li><a href="/kennisbank/ai-voor-verzekeringsmakelaar-financieel-adviseur/" class="text-brand-blue hover:text-brand-blue/80 underline-offset-4 hover:underline">AI voor verzekeringsmakelaar — Wwft &amp; Wft</a></li>
      <li><a href="/kennisbank/ai-cashflow-prognose-finance-mkb-nederland-2026/" class="text-brand-blue hover:text-brand-blue/80 underline-offset-4 hover:underline">AI cashflow-prognose — Finance forecasting</a></li>
      <li><a href="/kennisbank/ai-roi-berekenen-mkb-nederland-2026/" class="text-brand-blue hover:text-brand-blue/80 underline-offset-4 hover:underline">AI ROI-calculator — TCO-analyse</a></li>
      <li><a href="/sectoren/zakelijk/" class="text-brand-blue hover:text-brand-blue/80 underline-offset-4 hover:underline">AI voor zakelijke dienstverlening — Breed overzicht</a></li>
      <li><a href="/sectoren/" class="text-brand-blue hover:text-brand-blue/80 underline-offset-4 hover:underline">Alle sectoren met AI-oplossingen</a></li>
      <li><a href="/diensten/ai-website-bundel-mkb-nederland/" class="text-brand-blue hover:text-brand-blue/80 underline-offset-4 hover:underline">AI-Website Bundel — Marco + Emma</a></li>
    </ul>
  </div>
</section>
<!-- /xref-orphan-fix-2026-05-07 -->
</BaseLayout>
