---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import sectorImage from '../../assets/images/sectoren/zakelijk.jpg';
const schema = {
  '@context': 'https://schema.org',
  '@type': ['Service', 'FAQPage'],
  name: 'AI voor Zakelijke Dienstverlening',
  provider: { '@type': 'Organization', name: 'Aanloop AI', url: 'https://aanloopai.nl' },
  areaServed: 'NL',
  mainEntity: [
    { '@type': 'Question', name: 'Welke zakelijke dienstverleners profiteren het meest van AI?', acceptedAnswer: { '@type': 'Answer', text: 'Adviesbureaus, consultants, interim-bureaus en zakelijke dienstverleners die veel telefonisch contact hebben of repetitieve administratieve taken uitvoeren. AI bespaart gemiddeld 8-12 uur per week per medewerker.' } },
  ],
};
---
<BaseLayout title="AI voor Zakelijke Dienstverlening MKB" description="AI voor adviesbureaus, consultants en zakelijke dienstverleners. Automatiseer offertes, e-mails, afspraken en rapportages. Starter €597/maand. KVK: 88606902." schema={schema}>
  <section class="border-b border-slate-200 hero-gradient">
    <div class="container-page py-16 lg:py-24">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div class="max-w-3xl">
        <div class="flex items-center gap-4 mb-6 reveal"><div class="accent-band"><span></span><span></span><span></span><span></span></div><span class="eyebrow">Sector: Zakelijke Dienstverlening</span></div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tightest text-navy text-balance leading-[1.05] reveal reveal-delay-1">AI voor adviesbureaus en consultants</h1>
        <p class="mt-6 text-lg text-slate-600 leading-relaxed max-w-2xl reveal reveal-delay-2">Minder tijd aan e-mails, offertes en rapportages — meer tijd voor uw klanten. AI automatiseert de administratieve kant van uw dienstverlening zodat u kunt focussen op klantwaarde.</p>
        <div class="mt-8 flex gap-3 flex-wrap reveal reveal-delay-3">
          <a href="/demo-aanvragen/" class="btn-primary text-base px-6 py-3.5">Gratis demo aanvragen <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></a>
          <a href="/gratis-ai-scan/" class="btn-outline text-base px-6 py-3.5">Gratis AI scan</a>
        </div>
      </div>
      <div class="reveal reveal-delay-2">
        <Image src={sectorImage} alt="Zakelijke teampresentatie — AI voor adviesbureaus en consultancy" class="w-full rounded-2xl shadow-xl object-cover aspect-[4/3]" loading="eager" decoding="async" fetchpriority="high" widths={[480, 800, 1200, 1400]} sizes="(min-width: 1024px) 600px, 100vw" format="webp" quality={82} />
      </div>
      </div>
    </div>
  </section>
  <section class="section-tight bg-slate-50 border-b border-slate-200">
    <div class="container-page">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        {[{v:'8–12 uur',l:'bespaard per week'},{v:'−70%',l:'tijd aan e-mailbeheer'},{v:'3×',l:'snellere offertes'},{v:'7 dgn',l:'time-to-live'}].map(s=>(
          <div class="reveal"><p class="text-2xl font-bold text-navy">{s.v}</p><p class="text-xs text-slate-500 mt-1">{s.l}</p></div>
        ))}
      </div>
    </div>
  </section>
  <!-- Sector-specifieke uitdagingen -->
  <section class="section border-b border-slate-200">
    <div class="container-page max-w-4xl mx-auto">
      <div class="mb-10 reveal">
        <p class="eyebrow mb-2">Uitdagingen in zakelijke dienstverlening</p>
        <h2 class="text-2xl font-bold text-navy mb-6">Waarom adviesbureaus en consultants vastlopen op administratie</h2>
        <p class="text-slate-600 leading-relaxed mb-6">Zakelijke dienstverleners — adviesbureaus, consultants, interim-bureaus, accountants en juristen — hebben één ding gemeen: hun omzet hangt af van billable uren, maar gemiddeld 35–45% van de werkweek gaat op aan niet-factureerbare activiteiten. E-mails beantwoorden, offertes samenstellen, afspraken inplannen en rapportages produceren. AI lost precies dat op.</p>
      </div>
      <div class="space-y-5 reveal">
        {[
          { title: 'E-mailbeheer kost consultants dagelijks 1,5–2 uur', body: 'Een gemiddeld adviesbureau ontvangt 60–120 e-mails per dag. De helft zijn statusvragen, vergaderverzoeken of informatieverzoeken die via een standaard antwoord beantwoord kunnen worden. AI verwerkt inkomende e-mails, categoriseert ze op prioriteit en stelt antwoorden op ter goedkeuring — of beantwoordt ze direct voor routinevragen.' },
          { title: 'Offertes samenstellen duurt te lang voor het resultaat', body: 'Een offerte voor een standaard consultancyproject kost gemiddeld 2–4 uur per voorstel. Met AI worden offertes automatisch samengesteld op basis van het klantprofiel, scope en urentarief — inclusief standaard voorwaarden, deliverables en betalingstermijnen. Goedkeuring door de consultant is één klik.' },
          { title: 'Rapportages en presentaties zijn repetitief maar tijdrovend', body: 'Maandelijkse statusrapportages, kwartaalpresentaties en voortgangsoverzichten worden bij veel bureaus handmatig samengesteld vanuit spreadsheets en projectdata. AI automatiseert het genereren van rapportages uit uw bestaande databronnen, inclusief grafieken en managementsamenvatting.' },
          { title: 'Klantopvolging en follow-up valt tussen de wal en het schip', body: 'In drukke projectfasen worden follow-up e-mails na offertes, kennismakingsgesprekken en afgeronde opdrachten vergeten. AI beheert automatisch een follow-up schema: na 3 werkdagen een herinnering, na 7 werkdagen een alternatief voorstel. Nooit meer een warme lead verloren door te late opvolging.' },
        ].map(item => (
          <div class="border border-slate-200 rounded-xl p-5 bg-white">
            <h3 class="font-semibold text-navy mb-2 text-sm">{item.title}</h3>
            <p class="text-sm text-slate-600 leading-relaxed">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Trust signals -->
  <section class="section border-b border-slate-200">
    <div class="container-page max-w-4xl mx-auto">
      <div class="mb-8 reveal">
        <p class="eyebrow mb-2">Compliance & werkwijze</p>
        <h2 class="text-2xl font-bold text-navy mb-4">Voor zakelijke dienstverleners werken wij speciaal met</h2>
      </div>
      <div class="grid md:grid-cols-2 gap-4 reveal">
        {[
          { icon: '🔒', title: 'AVG-conforme verwerking via n8n self-hosted', body: 'Alle klantdata, e-mailcorrespondentie en offertedata worden verwerkt op een Nederlandse server via n8n self-hosted. Geen doorgifte aan Amerikaanse cloudproviders voor gevoelige klantinformatie. Verwerkersovereenkomst inbegrepen conform AVG artikel 28.' },
          { icon: '📊', title: 'Exact, Twinfield & CRM-koppelingen', body: 'Directe koppeling met de meeste gangbare boekhoud- en CRM-systemen: Exact Online, Twinfield, Visma, HubSpot en Salesforce. Offertes worden automatisch gesynchroniseerd met uw facturatiesysteem zodra ze zijn geaccepteerd.' },
          { icon: '⚖️', title: 'Wft-grens en geheimhoudingsplicht geborgd', body: 'AI geeft nooit financieel of juridisch advies dat de Wft-grens overschrijdt. De AI stelt vragen, verzamelt informatie en plant afspraken — maar geeft geen concreet beleggings-, fiscaal of juridisch advies. Dit is contractueel vastgelegd in onze verwerkersovereenkomst.' },
          { icon: '🏗️', title: 'EU AI Act ready — transparantie geborgd', body: 'Aanloop AI past de EU AI Act toe per augustus 2026. Klanten worden transparant geïnformeerd dat zij met een AI agent communiceren. Onze systemen voldoen aan de transparantie- en menselijk-toezicht-eisen van de EU AI Act voor zakelijke toepassingen.' },
        ].map(t => (
          <div class="flex gap-4 p-4 rounded-xl border border-slate-200 bg-slate-50">
            <span class="text-2xl">{t.icon}</span>
            <div>
              <p class="font-semibold text-navy text-sm mb-1">{t.title}</p>
              <p class="text-xs text-slate-600 leading-relaxed">{t.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page">
      <div class="grid lg:grid-cols-2 gap-16 mb-16">
        <div class="reveal">
          <h2 class="text-2xl font-bold text-navy mb-6">AI-toepassingen voor zakelijke dienstverlening</h2>
          <ul class="space-y-4">
            {['Offertes automatisch samenstellen op basis van klantprofiel','Inkomende e-mails sorteren, prioriteren en beantwoorden','Klantcontact en follow-ups automatisch inplannen','Rapportages en presentaties genereren vanuit data','Contracten en voorwaarden doorzoekbaar maken via AI','Urenregistratie automatisch bijhouden en samenvatten','Kennisbank voor intern gebruik — AI beantwoordt interne vragen'].map(f=>(
              <li class="flex items-start gap-3 text-sm text-slate-700"><svg class="w-5 h-5 mt-0.5 flex-shrink-0 text-brand-emerald" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>{f}</li>
            ))}
          </ul>
        </div>
        <div class="reveal reveal-delay-2">
          <h2 class="text-2xl font-bold text-navy mb-4">Case study: adviesbureau</h2>
          <div class="bg-slate-50 border border-slate-200 rounded-xl p-5 mb-6">
            <p class="text-sm text-slate-700 italic">"We besteedden 40% van onze tijd aan e-mails, offertes en rapportages. Na AI-implementatie is dat teruggebracht naar 15%. Onze consultants hebben nu echt meer tijd voor strategisch advies."</p>
            <p class="text-xs text-slate-500 mt-3 font-medium">— Directeur, strategie-adviesbureau Amsterdam</p>
          </div>
          <div class="grid grid-cols-2 gap-3">
            {[{v:'−60%',l:'admin-tijd'},{v:'3×',l:'sneller offertes'},{v:'+35%',l:'klanttevredenheid'},{v:'€62.000',l:'jaarlijkse besparing'}].map(s=>(
              <div class="bg-white border border-slate-200 rounded-xl p-4 text-center"><p class="text-xl font-bold text-brand-indigo">{s.v}</p><p class="text-xs text-slate-500 mt-1">{s.l}</p></div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container-page max-w-3xl">
      <p class="eyebrow text-brand-indigo mb-2">Verdiepende kennisbank-gidsen</p>
      <h2 class="text-2xl lg:text-3xl font-bold text-navy mb-6">Lees verder: praktische AI-gidsen voor deze sector</h2>
      <ul class="space-y-3">
        <li><a href="/kennisbank/ai-klantenservice-voor-mkb-2026/" class="flex items-center justify-between gap-4 p-4 rounded-xl bg-white border border-slate-200 hover:border-brand-indigo hover:shadow-sm transition-all"><span class="text-sm font-medium text-navy">AI klantenservice voor MKB 2026</span><span class="text-xs text-brand-indigo flex-shrink-0">Lees gids →</span></a></li>
        <li><a href="/kennisbank/ai-voor-marketingbureau-nederland-2026/" class="flex items-center justify-between gap-4 p-4 rounded-xl bg-white border border-slate-200 hover:border-brand-indigo hover:shadow-sm transition-all"><span class="text-sm font-medium text-navy">AI voor marketingbureau</span><span class="text-xs text-brand-indigo flex-shrink-0">Lees gids →</span></a></li>
        <li><a href="/kennisbank/ai-voicebot-vs-chatbot-mkb-vergelijking/" class="flex items-center justify-between gap-4 p-4 rounded-xl bg-white border border-slate-200 hover:border-brand-indigo hover:shadow-sm transition-all"><span class="text-sm font-medium text-navy">AI Voicebot vs Chatbot vergelijking</span><span class="text-xs text-brand-indigo flex-shrink-0">Lees gids →</span></a></li>
      </ul>
      <div class="mt-8">
        <a href="/kennisbank/" class="text-sm text-brand-indigo hover:underline font-medium">Alle 48 kennisbank-gidsen bekijken →</a>
      </div>
    </div>
  </section>

  <section class="section bg-slate-50 border-y border-slate-200">
    <div class="container-page max-w-4xl">
      <p class="eyebrow text-brand-indigo mb-2">Website + AI = 1 partner</p>
      <h2 class="text-2xl lg:text-3xl font-bold text-navy mb-4">Bedrijfswebsite of corporate site nodig? Wij bouwen 'm AI-ready met intake en lead-routing</h2>
      <p class="text-slate-600 mb-8 leading-relaxed">Veel zakelijke dienstverleners hebben een corporate website van jaren terug en koppelen apart een AI-tool voor lead-intake of telefoon. Bij Aanloop AI is dat één traject: een AI-ready zakelijke website met intake-formulieren, automatische lead-scoring en Marco (24/7 telefoon-AI) ingebouwd vanaf dag één.</p>
      <div class="grid md:grid-cols-3 gap-4">
        <a href="/diensten/website-laten-maken-mkb-nederland-2026/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">Zakelijke website laten maken</h3>
          <p class="text-xs text-slate-600 mb-3">Astro/Next/WordPress AI-ready. Schema.org + Speakable + WCAG 2.2 AA + B2B intake-flow.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk pakketten →</span>
        </a>
        <a href="/diensten/ai-website-bundel-mkb-nederland/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">AI-Website Bundel</h3>
          <p class="text-xs text-slate-600 mb-3">Website + Marco (telefoon) + Emma (WhatsApp) in 1 pakket. Bespaart €8.014 jaar 1.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk bundel →</span>
        </a>
        <a href="/kennisbank/website-bouwer-vs-ai-ready-partner-mkb-nederland-2026/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">Webbureau vs AI-ready partner</h3>
          <p class="text-xs text-slate-600 mb-3">TCO 3-jaar tabel + 8-punts checklist voor elke webbureau-evaluatie.</p>
          <span class="text-xs text-brand-indigo font-medium">Lees vergelijking →</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section-tight bg-midnight text-pearl">
    <div class="container-page max-w-3xl">
      <h2 class="text-3xl font-bold text-pearl reveal">Meer tijd voor klantwaarde, minder voor administratie?</h2>
      <p class="mt-4 text-slate-300 reveal reveal-delay-1">Plan een gratis demo en ontdek waar AI uw dienstverlening kan versterken.</p>
      <a href="/demo-aanvragen/" class="mt-6 btn bg-pearl text-navy hover:bg-white text-base px-6 py-3.5 reveal reveal-delay-2">Gratis demo aanvragen</a>
    </div>
  </section>
</BaseLayout>
