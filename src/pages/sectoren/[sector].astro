---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sectors, serviceLabels } from '../../data/sectors';

export async function getStaticPaths() {
  return sectors.map((sector) => ({
    params: { sector: sector.slug },
    props: { sector },
  }));
}

const { sector } = Astro.props;
---

<BaseLayout
  title={`AI voor ${sector.title} in Nederland — AI Agents & Automatisering MKB | Aanloop AI`}
  description={`${sector.description} Concrete AI-oplossingen voor ${sector.title.toLowerCase()}: AI receptionist, WhatsApp bot, workflow automatisering. Live binnen 7 werkdagen.`}
>
  <!-- Hero -->
  <section class="border-b border-slate-200">
    <div class="container-page py-16 lg:py-24">
      <div class="max-w-4xl">
        <div class="flex items-center gap-4 mb-6">
          <div class="accent-band"><span></span><span></span><span></span><span></span></div>
          <span class="eyebrow">Sector · {sector.title}</span>
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tightest text-navy text-balance leading-[1.05]">
          {sector.hero.headline}
        </h1>
        <p class="mt-6 text-lg lg:text-xl text-slate-600 leading-relaxed text-pretty max-w-2xl">
          {sector.hero.subheadline}
        </p>
        <div class="mt-8 flex flex-col sm:flex-row gap-3">
          <a href={`/contact/?type=${sector.slug}`} class="btn-primary text-base px-6 py-3.5">
            Plan een sector-specifiek adviesgesprek
          </a>
          <a href="#oplossingen" class="btn-outline text-base px-6 py-3.5">
            Bekijk oplossingen
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Challenges -->
  <section class="section">
    <div class="container-page">
      <div class="grid lg:grid-cols-12 gap-12 lg:gap-16">
        <div class="lg:col-span-5">
          <p class="eyebrow mb-3">Uitdagingen</p>
          <h2 class="text-3xl lg:text-4xl font-bold tracking-tightest text-navy text-balance">
            Wat we vaak horen van {sector.title.toLowerCase()}-ondernemers.
          </h2>
        </div>
        <ul class="lg:col-span-7 space-y-4">
          {sector.challenges.map((c) => (
            <li class="flex items-start gap-3 pb-4 border-b border-slate-200 last:border-0">
              <svg class="w-5 h-5 mt-0.5 flex-shrink-0 text-brand-rose" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10" />
                <line x1="12" y1="8" x2="12" y2="12" />
                <line x1="12" y1="16" x2="12.01" y2="16" />
              </svg>
              <span class="text-base text-slate-700 leading-relaxed">{c}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Solutions -->
  <section id="oplossingen" class="section bg-slate-50/60 border-y border-slate-200">
    <div class="container-page">
      <div class="max-w-3xl mb-14">
        <p class="eyebrow mb-3">Oplossingen</p>
        <h2 class="text-3xl lg:text-4xl font-bold tracking-tightest text-navy text-balance">
          Hoe Aanloop AI deze uitdagingen aanpakt.
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {sector.solutions.map((solution, i) => {
          const colors = ['indigo', 'rose', 'amber', 'emerald'];
          const color = colors[i % colors.length];
          return (
            <div class="card relative overflow-hidden">
              <div class:list={[
                'absolute top-0 left-0 w-1 h-full',
                color === 'indigo' && 'bg-brand-indigo',
                color === 'rose' && 'bg-brand-rose',
                color === 'amber' && 'bg-brand-amber',
                color === 'emerald' && 'bg-brand-emerald',
              ]}></div>
              <h3 class="text-lg font-bold text-navy">{solution.title}</h3>
              <p class="mt-3 text-sm text-slate-600 leading-relaxed">{solution.description}</p>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Case study -->
  <section class="section">
    <div class="container-page">
      <div class="max-w-4xl mx-auto">
        <p class="eyebrow mb-3 text-center">Klant in deze sector</p>
        <figure>
          <blockquote class="text-2xl lg:text-3xl font-medium text-navy text-balance leading-relaxed text-center">
            "{sector.caseExample.quote}"
          </blockquote>
          <figcaption class="mt-8 text-center text-sm text-slate-600">
            <strong class="text-navy font-bold">{sector.caseExample.company}</strong>
            <span class="block mt-1">{sector.caseExample.location}</span>
          </figcaption>
        </figure>

        <div class="mt-12 grid grid-cols-1 sm:grid-cols-3 gap-6">
          {sector.caseExample.metrics.map((m) => (
            <div class="card text-center">
              <div class="text-3xl lg:text-4xl font-bold text-navy">{m.value}</div>
              <div class="text-xs text-slate-500 mt-2 uppercase tracking-wide">{m.label}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Recommended services -->
  <section class="section-tight bg-slate-50/60 border-t border-slate-200">
    <div class="container-page">
      <p class="eyebrow mb-3">Aanbevolen voor {sector.title.toLowerCase()}</p>
      <h2 class="text-2xl lg:text-3xl font-bold tracking-tighter-2 text-navy text-balance mb-8">
        Onze geadviseerde diensten voor uw sector.
      </h2>
      <div class="flex flex-wrap gap-3">
        {sector.recommendedServices.map((slug) => (
          <a
            href={`/diensten/${slug}/`}
            class="inline-flex items-center gap-2 px-4 py-2.5 bg-white border border-slate-200 rounded-lg text-sm font-medium text-navy hover:border-navy transition-all"
          >
            {serviceLabels[slug]}
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Locations cross-link (local SEO + internal linking) -->
  <section class="section-tight border-t border-slate-200">
    <div class="container-page">
      <p class="eyebrow mb-3">AI voor {sector.title.toLowerCase()} in heel Nederland</p>
      <h2 class="text-2xl lg:text-3xl font-bold tracking-tighter-2 text-navy text-balance mb-6">
        Lokaal aanwezig — landelijk inzetbaar.
      </h2>
      <p class="text-slate-600 leading-relaxed mb-6 max-w-2xl">
        Aanloop AI bedient {sector.title.toLowerCase()}-bedrijven in heel Nederland. Onze trajecten verlopen
        remote (videocall + dashboard), maar we zijn beschikbaar voor on-site gesprekken in de grote steden.
      </p>
      <div class="flex flex-wrap gap-2">
        {[
          { slug: 'rotterdam', name: 'Rotterdam' },
          { slug: 'amsterdam', name: 'Amsterdam' },
          { slug: 'den-haag', name: 'Den Haag' },
          { slug: 'utrecht', name: 'Utrecht' },
          { slug: 'eindhoven', name: 'Eindhoven' },
          { slug: 'tilburg', name: 'Tilburg' },
          { slug: 'breda', name: 'Breda' },
          { slug: 'groningen', name: 'Groningen' },
          { slug: 'nijmegen', name: 'Nijmegen' },
          { slug: 'haarlem', name: 'Haarlem' },
          { slug: 'enschede', name: 'Enschede' },
          { slug: 'almere', name: 'Almere' },
        ].map((loc) => (
          <a href={`/locaties/${loc.slug}/`} class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-slate-50 hover:bg-slate-100 border border-slate-200 hover:border-slate-300 rounded-lg text-xs font-medium text-navy transition-all">
            AI in {loc.name}
            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Other sectors cross-link (topic clustering) -->
  <section class="section-tight bg-slate-50/60 border-y border-slate-200">
    <div class="container-page">
      <p class="eyebrow mb-3">Andere sectoren</p>
      <h2 class="text-2xl lg:text-3xl font-bold tracking-tighter-2 text-navy text-balance mb-6">
        AI-oplossingen per branche
      </h2>
      <div class="flex flex-wrap gap-2">
        {sectors.filter(s => s.slug !== sector.slug).map((s) => (
          <a href={`/sectoren/${s.slug}/`} class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white hover:bg-slate-50 border border-slate-200 hover:border-navy rounded-lg text-xs font-medium text-navy transition-all">
            AI voor {s.title.toLowerCase()}
            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-tight bg-midnight text-pearl">
    <div class="container-page">
      <div class="max-w-2xl">
        <h2 class="text-3xl lg:text-4xl font-bold tracking-tightest text-pearl text-balance">
          Wilt u zien hoe AI in uw {sector.title.toLowerCase()}-bedrijf werkt?
        </h2>
        <p class="mt-4 text-base text-slate-300">
          Plan een 30-minuten gesprek met een specialist die uw sector kent.
        </p>
        <div class="mt-6">
          <a href={`/contact/?type=${sector.slug}`} class="btn bg-pearl text-navy hover:bg-white text-base px-6 py-3.5">
            Plan een gesprek
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
