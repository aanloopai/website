---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import sectorImage from '../../assets/images/sectoren/logistiek.jpg';
const schema = {
  '@context': 'https://schema.org',
  '@type': ['Service', 'FAQPage'],
  name: 'AI voor Logistiek & Transport',
  provider: { '@type': 'Organization', name: 'Aanloop AI', url: 'https://aanloopai.nl' },
  areaServed: 'NL',
  mainEntity: [
    { '@type': 'Question', name: 'Kan AI mijn chauffeurs bereikbaar houden voor klanten?', acceptedAnswer: { '@type': 'Answer', text: 'Ja. Een AI-telefoniste neemt 24/7 calls aan, verwerkt bezorgvragen en stuurt updates — zonder dat de chauffeur gestoord wordt.' } },
    { '@type': 'Question', name: 'Werkt de AI met mijn TMS of planningssofteem?', acceptedAnswer: { '@type': 'Answer', text: 'Aanloop AI integreert met de meeste TMS-systemen via API of webhook. We ondersteunen o.a. Trimble, Transics en eigen systemen.' } },
    { '@type': 'Question', name: 'Hoe lang duurt de implementatie?', acceptedAnswer: { '@type': 'Answer', text: 'De eerste AI-agent is live binnen 7–14 werkdagen. We koppelen aan uw systemen en testen grondig voor de livegang.' } },
  ],
};
---
<BaseLayout title="AI voor Logistiek: Track-and-Trace" description="AI-oplossingen voor transporteurs en logistiek: automatische track-and-trace updates, klantvragen 24/7 beantwoorden, CMR-documentverwerking en" schema={schema}>
  <section class="border-b border-slate-200 hero-gradient">
    <div class="container-page py-16 lg:py-24">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div class="max-w-3xl">
        <div class="flex items-center gap-4 mb-6 reveal"><div class="accent-band"><span></span><span></span><span></span><span></span></div><span class="eyebrow">Sector: Logistiek & Transport</span></div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tightest text-navy text-balance leading-[1.05] reveal reveal-delay-1">AI voor transporteurs en logistiek</h1>
        <p class="mt-6 text-lg text-slate-600 leading-relaxed max-w-2xl reveal reveal-delay-2">Van automatische track-and-trace updates tot het verwerken van CMR-documenten — AI houdt uw klanten geïnformeerd en bespaart uw medewerkers uren per dag.</p>
        <div class="mt-8 flex gap-3 flex-wrap reveal reveal-delay-3">
          <a href="/demo-aanvragen/" class="btn-primary text-base px-6 py-3.5">Gratis demo aanvragen <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></a>
          <a href="/gratis-ai-scan/" class="btn-outline text-base px-6 py-3.5">Gratis AI scan</a>
        </div>
      </div>
      <div class="reveal reveal-delay-2">
        <Image src={sectorImage} alt="Modern logistiek-distributiecentrum — AI voor transporteurs en MKB Nederland" class="w-full rounded-2xl shadow-xl object-cover aspect-[4/3]" loading="eager" decoding="async" fetchpriority="high" widths={[480, 800, 1200, 1400]} sizes="(min-width: 1024px) 600px, 100vw" format="webp" quality={82} />
      </div>
      </div>
    </div>
  </section>
  <section class="section-tight bg-slate-50 border-b border-slate-200">
    <div class="container-page">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        {[{v:'−60%',l:'inbound klantvragen'},{v:'+40%',l:'klanttevredenheid'},{v:'2 uur/dag',l:'bespaard per medewerker'},{v:'10 dgn',l:'time-to-live'}].map(s=>(
          <div class="reveal"><p class="text-2xl font-bold text-navy">{s.v}</p><p class="text-xs text-slate-500 mt-1">{s.l}</p></div>
        ))}
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container-page">
      <div class="grid lg:grid-cols-2 gap-16 mb-16">
        <div class="reveal">
          <p class="eyebrow mb-2">Toepassingen</p>
          <h2 class="text-2xl font-bold text-navy mb-6">Logistiek-specifieke AI-use cases</h2>
          <ul class="space-y-4">
            {['Automatische track-and-trace updates via WhatsApp, SMS of e-mail','Klantvragen over leveringstijden en vertragingen 24/7 beantwoorden','CMR-documenten en vrachtbrieven automatisch uitlezen en verwerken','Chauffeur-dispatch ondersteuning via AI-routing-assistent','Klachten registreren, classificeren en doorsturen naar juiste afdeling','Leveranciers automatisch aanschrijven bij afwijkingen of vertraging','Maandrapportages genereren vanuit TMS-data'].map(f=>(
              <li class="flex items-start gap-3 text-sm text-slate-700"><svg class="w-5 h-5 mt-0.5 flex-shrink-0 text-brand-emerald" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>{f}</li>
            ))}
          </ul>
        </div>
        <div class="reveal reveal-delay-2">
          <p class="eyebrow mb-2">Case study</p>
          <h2 class="text-2xl font-bold text-navy mb-4">Transportbedrijf bespaart 2.000 uur/jaar</h2>
          <div class="bg-slate-50 border border-slate-200 rounded-xl p-5 mb-6">
            <p class="text-sm text-slate-700 italic">"Onze planners werden overspoeld met calls over zendingstijden. Na de AI-implementatie beantwoordt de agent 80% van deze vragen automatisch — mijn team kan nu focussen op complexe planningsvraagstukken."</p>
            <p class="text-xs text-slate-500 mt-3 font-medium">— Operationeel manager, regionaal transportbedrijf</p>
          </div>
          <div class="grid grid-cols-2 gap-3">
            {[{v:'−80%',l:'calls over zendingstatus'},{v:'€48.000',l:'kostenbesparing/jaar'},{v:'4.8/5',l:'klanttevredenheid'},{v:'14 dgn',l:'implementatietijd'}].map(s=>(
              <div class="bg-white border border-slate-200 rounded-xl p-4 text-center"><p class="text-xl font-bold text-brand-indigo">{s.v}</p><p class="text-xs text-slate-500 mt-1">{s.l}</p></div>
            ))}
          </div>
        </div>
      </div>
      <div class="max-w-3xl">
        <h2 class="text-2xl font-bold text-navy mb-6 reveal">Veelgestelde vragen — AI voor logistiek</h2>
        <div class="space-y-4 reveal">
          {[
            { v: 'Kan AI mijn chauffeurs bereikbaar houden voor klanten?', a: 'Ja. Een AI-telefoniste neemt 24/7 calls aan, verwerkt bezorgvragen en stuurt updates — zonder dat de chauffeur gestoord wordt.' },
            { v: 'Werkt de AI met mijn TMS of planningssoftware?', a: 'Aanloop AI integreert met de meeste TMS-systemen via API of webhook. We ondersteunen o.a. Trimble, Transics en eigen maatwerksystemen.' },
            { v: 'Hoe lang duurt de implementatie?', a: 'De eerste AI-agent is live binnen 7–14 werkdagen. We koppelen aan uw systemen en testen grondig vóór de livegang.' },
            { v: 'Is de AI AVG-compliant?', a: 'Ja. Alle data wordt verwerkt binnen de EU. We leveren een verwerkersovereenkomst en onze n8n-workflows draaien optioneel op uw eigen server.' },
          ].map(faq=>(
            <details class="group border border-slate-200 rounded-xl overflow-hidden">
              <summary class="flex items-center justify-between cursor-pointer p-5 font-semibold text-navy text-sm hover:bg-slate-50">
                {faq.v}
                <svg class="w-4 h-4 flex-shrink-0 text-slate-400 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
              </summary>
              <div class="px-5 pb-5 text-sm text-slate-600">{faq.a}</div>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container-page max-w-3xl">
      <p class="eyebrow text-brand-indigo mb-2">Verdiepende kennisbank-gidsen</p>
      <h2 class="text-2xl lg:text-3xl font-bold text-navy mb-6">Lees verder: praktische AI-gidsen voor deze sector</h2>
      <ul class="space-y-3">
        <li><a href="/kennisbank/ai-voor-logistiek-mkb-track-trace/" class="flex items-center justify-between gap-4 p-4 rounded-xl bg-white border border-slate-200 hover:border-brand-indigo hover:shadow-sm transition-all"><span class="text-sm font-medium text-navy">AI voor MKB logistiek met track-and-trace</span><span class="text-xs text-brand-indigo flex-shrink-0">Lees gids →</span></a></li>
        <li><a href="/kennisbank/ai-voor-hypotheekadviseur-nederland-2026/" class="flex items-center justify-between gap-4 p-4 rounded-xl bg-white border border-slate-200 hover:border-brand-indigo hover:shadow-sm transition-all"><span class="text-sm font-medium text-navy">AI voor hypotheekadviseur — ZZP-chauffeur en transport-eigenaar hypotheek</span><span class="text-xs text-brand-indigo flex-shrink-0">Lees gids →</span></a></li>
        <li><a href="/kennisbank/ai-voor-financieel-planner-nederland-2026/" class="flex items-center justify-between gap-4 p-4 rounded-xl bg-white border border-slate-200 hover:border-brand-indigo hover:shadow-sm transition-all"><span class="text-sm font-medium text-navy">AI voor financieel-planner — fiscale planning transport-ondernemer</span><span class="text-xs text-brand-indigo flex-shrink-0">Lees gids →</span></a></li>
      </ul>
      <div class="mt-8">
        <a href="/kennisbank/" class="text-sm text-brand-indigo hover:underline font-medium">Alle 48 kennisbank-gidsen bekijken →</a>
      </div>
    </div>
  </section>

  <section class="section bg-slate-50 border-y border-slate-200">
    <div class="container-page max-w-4xl">
      <p class="eyebrow text-brand-indigo mb-2">Website + AI = 1 partner</p>
      <h2 class="text-2xl lg:text-3xl font-bold text-navy mb-4">Transport-website nodig? Wij bouwen 'm AI-ready met track-and-trace en CMR-upload</h2>
      <p class="text-slate-600 mb-8 leading-relaxed">Veel transporteurs en logistieke MKB-bedrijven hebben een verouderde website en koppelen apart een AI-tool voor klantvragen of documentverwerking. Bij Aanloop AI is dat één traject: een AI-ready transport-website met track-and-trace, CMR-upload-portaal, klant-FAQ en Marco (24/7 telefoon-AI voor leverstatus en standaardvragen) ingebouwd vanaf dag één.</p>
      <div class="grid md:grid-cols-3 gap-4">
        <a href="/diensten/website-laten-maken-mkb-nederland-2026/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">Logistiek-website laten maken</h3>
          <p class="text-xs text-slate-600 mb-3">Astro/Next/WordPress AI-ready. Schema.org MovingCompany/ParcelService + Speakable + WCAG 2.2 AA.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk pakketten →</span>
        </a>
        <a href="/diensten/ai-website-bundel-mkb-nederland/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">AI-Website Bundel</h3>
          <p class="text-xs text-slate-600 mb-3">Website + Marco (telefoon) + Emma (WhatsApp) in 1 pakket. Bespaart €8.014 jaar 1.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk bundel →</span>
        </a>
        <a href="/kennisbank/website-bouwer-vs-ai-ready-partner-mkb-nederland-2026/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">Webbureau vs AI-ready partner</h3>
          <p class="text-xs text-slate-600 mb-3">TCO 3-jaar tabel + 8-punts checklist voor elke webbureau-evaluatie.</p>
          <span class="text-xs text-brand-indigo font-medium">Lees vergelijking →</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section-tight bg-midnight text-pearl">
    <div class="container-page max-w-3xl">
      <h2 class="text-3xl font-bold text-pearl reveal">Minder telefoondrukte, meer leveringen op tijd?</h2>
      <p class="mt-4 text-slate-300 reveal reveal-delay-1">Plan een gratis demo en ontdek wat AI voor uw logistieke operatie kan betekenen.</p>
      <div class="mt-6 flex gap-3 reveal reveal-delay-2">
        <a href="/demo-aanvragen/" class="btn bg-pearl text-navy hover:bg-white text-base px-6 py-3.5">Gratis demo aanvragen</a>
        <a href="/kennisbank/ai-workflow-automation/" class="btn border border-slate-700 text-pearl hover:bg-slate-800 text-base px-6 py-3.5">Lees meer over AI workflows</a>
      </div>
    </div>
  </section>
</BaseLayout>
