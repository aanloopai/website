---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Horeca · Aanloop AI" description="AI-oplossingen voor de horeca: reserveringen, no-show reductie, klantenservice en voorraadbeheer. Live binnen 14 dagen.">
  <section class="border-b border-slate-200 hero-gradient">
    <div class="container-page py-16 lg:py-24">
      <div class="max-w-3xl">
        <div class="flex items-center gap-4 mb-6"><div class="accent-band"><span></span><span></span><span></span><span></span></div><span class="eyebrow">Horeca</span></div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tightest text-navy text-balance leading-[1.05]">AI voor restaurants, hotels en cateraars.</h1>
        <p class="mt-6 text-lg text-slate-600 leading-relaxed max-w-2xl">Van reserveringen beheren en no-shows verminderen tot automatische herinneringen en klantenservice buiten openingstijden — AI neemt het routinewerk van uw team over.</p>
        <div class="mt-8 flex gap-3 flex-wrap">
          <a href="/contact/?type=demo" class="btn-primary text-base px-6 py-3.5">Boek een demo <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></a>
          <a href="/diensten/marco/" class="btn-outline text-base px-6 py-3.5">Bekijk Marco</a>
        </div>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container-page">
      <div class="grid lg:grid-cols-2 gap-16">
        <div class="reveal">
          <h2 class="text-2xl font-bold text-navy mb-6">Horeca-specifieke toepassingen</h2>
          <ul class="space-y-4">
            {['Reserveringen aannemen via telefoon & WhatsApp 24/7', 'Automatische bevestigingen en herinneringen versturen', 'No-show reductie via SMS-reminders en wachtlijstbeheer', 'Vragen over openingstijden, menu en allergieinformatie', 'Bezetting melden en alternatieve data voorstellen', 'Bestellingen doorzetten naar keukensoftware', 'Post-visit review-uitnodigingen sturen'].map(f => (
              <li class="flex items-start gap-3 text-sm text-slate-700"><svg class="w-5 h-5 mt-0.5 flex-shrink-0 text-brand-emerald" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>{f}</li>
            ))}
          </ul>
        </div>
        <div class="reveal reveal-delay-2">
          <div class="card bg-slate-50 border-slate-200">
            <p class="eyebrow mb-3">Resultaten</p>
            <div class="space-y-4">
              {[{v:'−35%', l:'no-show rate'},{v:'+28%', l:'online reserveringen'},{v:'24/7', l:'bereikbaar voor gasten'},{v:'7 dgn', l:'time-to-live'}].map(s=>(
                <div class="flex items-center justify-between py-3 border-b border-slate-200 last:border-0">
                  <span class="text-sm text-slate-600">{s.l}</span>
                  <span class="font-bold text-brand-indigo">{s.v}</span>
                </div>
              ))}
            </div>
          </div>
          <div class="mt-6 card">
            <blockquote class="text-sm text-slate-700 italic leading-relaxed">"Marco neemt 's avonds alle reserveringsgesprekken af. We missen geen tafel meer en onze staff kan zich focussen op de gasten in het restaurant."</blockquote>
            <div class="mt-4 text-xs text-slate-500"><strong class="text-navy">Jan Pieters</strong> · Eigenaar, Brasserie De Leeuw, Rotterdam</div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <section class="section-tight bg-midnight text-pearl">
    <div class="container-page">
      <div class="max-w-2xl">
        <h2 class="text-3xl font-bold tracking-tightest text-pearl">Meer gasten, minder gedoe.</h2>
        <p class="mt-4 text-slate-300">Boek een gratis demo en zie hoe AI uw horecabedrijf versterkt.</p>
        <div class="mt-6"><a href="/contact/?type=demo" class="btn bg-pearl text-navy hover:bg-white text-base px-6 py-3.5">Boek een demo</a></div>
      </div>
    </div>
  </section>
</BaseLayout>
