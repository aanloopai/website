---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import horecaRestaurant from '../../assets/images/horeca-restaurant.png';

const faqItems = [
  { question: 'Hoe helpt AI bij het reduceren van no-shows in de horeca?', answer: 'Een AI agent stuurt automatisch herinneringen via WhatsApp of SMS 24 uur en 2 uur voor de reservering. Bij geen reactie stelt de agent een wachtlijstgast voor. Horeca-ondernemers rapporteren een gemiddelde no-show reductie van 35-50%.' },
  { question: 'Kan een AI agent reserveringen verwerken via WhatsApp?', answer: 'Ja. De AI agent is volledig geïntegreerd met WhatsApp Business API. Gasten kunnen reserveringen maken, wijzigen en annuleren via WhatsApp — alsof ze met een medewerker chatten. U ontvangt een overzicht in uw reserveringssysteem.' },
  { question: 'Werkt een AI agent ook buiten openingstijden?', answer: 'Absoluut. De AI agent werkt 24/7, ook \'s nachts en in het weekend. Gasten die buiten openingstijden bellen of WhatsApp sturen, krijgen direct antwoord en kunnen een reservering plaatsen.' },
  { question: 'Kan de AI vragen over allergieën en menu beantwoorden?', answer: 'Ja. U voedt de AI agent met uw menukaart en allergie-informatie. De agent kan specifieke vragen beantwoorden over ingrediënten, allergenen en dieetwensen. Complexe vragen worden doorgezet naar uw keuken.' },
  { question: 'Hoe integreert de AI met mijn reserveringssysteem?', answer: 'Aanloop AI koppelt met de meeste gangbare reserveringssystemen: Formitable, Quandoo, ResDiary en custom systemen via API. Reserveringen zijn direct zichtbaar in uw bestaande overzicht.' },
];
const schema = { '@context': 'https://schema.org', '@type': 'Service', name: 'AI voor Horeca', serviceType: 'AI voor Horeca', provider: { '@type': 'Organization', name: 'Aanloop AI', url: 'https://aanloopai.nl' }, areaServed: { '@type': 'Country', name: 'Nederland' }, description: 'AI agents voor horeca: reserveringen, no-show reductie, WhatsApp klantenservice. 24/7 bereikbaar.' };
---
<BaseLayout title="AI voor Horeca Nederland — Reserveringen & No-Show" description="AI voor de horeca: AI-agent voor restaurants, hotels en cateraars. Automatische reserveringen via WhatsApp, 35% minder no-shows, 24/7 bereikbaar." schema={schema} faqSchema={faqItems}>
  <section class="border-b border-slate-200 hero-gradient">
    <div class="container-page py-16 lg:py-24">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <span class="eyebrow mb-6 block">Horeca</span>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tightest text-navy text-balance leading-[1.05] reveal reveal-delay-1">AI voor restaurants, hotels en cateraars.</h1>
          <p class="mt-6 text-lg text-slate-600 leading-relaxed max-w-2xl reveal reveal-delay-2">Van reserveringen beheren en no-shows verminderen tot automatische herinneringen en klantenservice buiten openingstijden — AI neemt het routinewerk van uw team over.</p>
          <div class="mt-8 flex gap-3 flex-wrap reveal reveal-delay-3">
            <a href="/gratis-ai-scan/" class="btn-primary text-base px-6 py-3.5">Gratis AI scan aanvragen <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></a>
            <a href="/tarieven/" class="btn-outline text-base px-6 py-3.5">Bekijk prijzen</a>
          </div>
        </div>
        <!-- Restaurant photo -->
        <div class="reveal reveal-delay-2">
          <Image
            src={horecaRestaurant}
            alt="Modern Nederlands restaurant — AI voor horeca sector"
            class="w-full rounded-2xl shadow-xl object-cover"
            loading="eager"
            decoding="async"
            fetchpriority="high"
            widths={[480, 800, 1200, 1400]}
            sizes="(min-width: 1024px) 700px, 100vw"
            format="webp"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="section-tight bg-slate-50 border-b border-slate-200">
    <div class="container-page">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        {[
          { v: '−35%', l: 'no-show rate' },
          { v: '+28%', l: 'online reserveringen' },
          { v: '24/7', l: 'bereikbaar voor gasten' },
          { v: '7 dgn', l: 'time-to-live' },
        ].map(s => (
          <div class="reveal"><p class="text-2xl font-bold text-navy">{s.v}</p><p class="text-xs text-slate-500 mt-1">{s.l}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page">
      <div class="grid lg:grid-cols-2 gap-12 mb-16">
        <div class="reveal">
          <p class="eyebrow mb-2">Toepassingen</p>
          <h2 class="text-2xl font-bold text-navy mb-6">Horeca-specifieke AI-toepassingen</h2>
          <ul class="space-y-4">
            {[
              'Reserveringen aannemen via telefoon & WhatsApp 24/7',
              'Automatische bevestigingen en herinneringen versturen',
              'No-show reductie via SMS-reminders en wachtlijstbeheer',
              'Vragen over openingstijden, menu en allergieinformatie',
              'Bezetting melden en alternatieve data voorstellen',
              'Post-visit review-uitnodigingen sturen',
              'Bijzondere gelegenheidsarrangementen verkopen',
            ].map(f => (
              <li class="flex items-start gap-3 text-sm text-slate-700"><svg class="w-5 h-5 mt-0.5 flex-shrink-0 text-brand-emerald" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>{f}</li>
            ))}
          </ul>
        </div>
        <div class="reveal reveal-delay-2">
          <div class="card mb-6">
            <blockquote class="text-sm text-slate-700 italic leading-relaxed">"De AI agent neemt 's avonds alle reserveringsgesprekken af. We missen geen tafel meer en onze staff kan zich focussen op de gasten in het restaurant."</blockquote>
            <div class="mt-4 text-xs text-slate-500"><strong class="text-navy">Jan Pieters</strong> · Eigenaar, Brasserie De Leeuw, Rotterdam</div>
          </div>
          <div class="card bg-slate-50">
            <p class="eyebrow mb-4">Casestudy: Restaurant Rotterdam</p>
            <p class="text-sm text-slate-600 mb-4">Een restaurant met 80 covers ontving wekelijks 60+ telefoontjes voor reserveringen, waarvan 30% buiten openingstijd. 25% resulteerde in no-show.</p>
            <ul class="space-y-2 text-sm">
              {['100% van reserveringen via AI afgehandeld', '35% minder no-shows door WhatsApp herinneringen', '18% meer covers per week door wachtlijst-AI', '3,5 uur/week bespaard op telefoneren'].map(r => (
                <li class="flex items-start gap-2"><span class="text-brand-emerald">✓</span>{r}</li>
              ))}
            </ul>
          </div>
        </div>
      </div>

      <!-- Types -->
      <div class="mb-16">
        <div class="mb-8 reveal"><h2 class="text-2xl font-bold text-navy">AI voor elk type horecabedrijf</h2></div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {[
            { icon: '🍽️', t: 'Restaurants & Bistros', d: 'Reserveringen, allergie-informatie, menukaart vragen en post-visit review-uitnodigingen volledig geautomatiseerd.' },
            { icon: '🏨', t: 'Hotels & B&B', d: 'Kamervragen, beschikbaarheid, inchecktijden en aanvullende diensten automatisch afgehandeld via telefoon of WhatsApp.' },
            { icon: '🎉', t: 'Evenementenlocaties', d: 'Informatieverstrekking over capaciteit, catering en voorzieningen. Automatisch verzoeken kwalificeren en offertes opstarten.' },
          ].map(u => (
            <div class="card reveal">
              <div class="text-2xl mb-3">{u.icon}</div>
              <h3 class="font-bold text-navy mb-2">{u.t}</h3>
              <p class="text-sm text-slate-600">{u.d}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- FAQ -->
      <div class="max-w-3xl">
        <h2 class="text-2xl font-bold text-navy mb-6">Veelgestelde Vragen — AI voor Horeca</h2>
        <div class="space-y-3 mb-8">
          {faqItems.map(item => (
            <details class="card group">
              <summary class="flex items-center justify-between cursor-pointer list-none">
                <span class="text-sm font-bold text-navy pr-6">{item.question}</span>
                <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
              </summary>
              <p class="mt-4 text-sm text-slate-600 leading-relaxed">{item.answer}</p>
            </details>
          ))}
        </div>
        <div class="bg-slate-50 border border-slate-200 rounded-xl p-6">
          <p class="text-sm font-bold text-navy mb-3">Gerelateerde artikelen</p>
          <ul class="space-y-2">
            <li><a href="/kennisbank/ai-agent-voorbeelden/" class="text-sm text-brand-indigo hover:underline">5 Voorbeelden van AI Agents voor Nederlandse Bedrijven →</a></li>
            <li><a href="/kennisbank/voice-ai-klantenservice/" class="text-sm text-brand-indigo hover:underline">Voice AI Agents voor Klantenservice: Werkt het Echt? →</a></li>
            <li><a href="/kennisbank/ai-workflow-automation/" class="text-sm text-brand-indigo hover:underline">AI Workflow Automation: Complete Uitleg →</a></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Locations cross-link -->
  <section class="section-tight border-t border-slate-200">
    <div class="container-page">
      <p class="eyebrow mb-3">AI voor horeca in heel Nederland</p>
      <h2 class="text-2xl lg:text-3xl font-bold tracking-tighter-2 text-navy text-balance mb-6">
        Restaurants, cafés en hotels — overal in Nederland.
      </h2>
      <p class="text-slate-600 leading-relaxed mb-6 max-w-2xl">
        Van Amsterdamse restaurants tot Rotterdams havenhoreca: Aanloop AI bedient horecaondernemers in
        heel Nederland. Trajecten verlopen remote (videocall + dashboard), met optionele on-site
        gesprekken in de grote steden.
      </p>
      <div class="flex flex-wrap gap-2">
        <a href="/locaties/rotterdam/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-slate-50 hover:bg-slate-100 border border-slate-200 hover:border-slate-300 rounded-lg text-xs font-medium text-navy transition-all">AI horeca Rotterdam →</a>
        <a href="/locaties/amsterdam/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-slate-50 hover:bg-slate-100 border border-slate-200 hover:border-slate-300 rounded-lg text-xs font-medium text-navy transition-all">AI horeca Amsterdam →</a>
        <a href="/locaties/den-haag/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-slate-50 hover:bg-slate-100 border border-slate-200 hover:border-slate-300 rounded-lg text-xs font-medium text-navy transition-all">AI horeca Den Haag →</a>
        <a href="/locaties/utrecht/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-slate-50 hover:bg-slate-100 border border-slate-200 hover:border-slate-300 rounded-lg text-xs font-medium text-navy transition-all">AI horeca Utrecht →</a>
        <a href="/locaties/eindhoven/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-slate-50 hover:bg-slate-100 border border-slate-200 hover:border-slate-300 rounded-lg text-xs font-medium text-navy transition-all">AI horeca Eindhoven →</a>
        <a href="/locaties/breda/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-slate-50 hover:bg-slate-100 border border-slate-200 hover:border-slate-300 rounded-lg text-xs font-medium text-navy transition-all">AI horeca Breda →</a>
        <a href="/locaties/groningen/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-slate-50 hover:bg-slate-100 border border-slate-200 hover:border-slate-300 rounded-lg text-xs font-medium text-navy transition-all">AI horeca Groningen →</a>
        <a href="/locaties/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-brand-indigo/5 hover:bg-brand-indigo/10 border border-brand-indigo/20 rounded-lg text-xs font-medium text-brand-indigo transition-all">Alle steden →</a>
      </div>
    </div>
  </section>

  <!-- Other sectors cross-link -->
  <section class="section-tight bg-slate-50/60 border-y border-slate-200">
    <div class="container-page">
      <p class="eyebrow mb-3">Andere sectoren</p>
      <h2 class="text-2xl lg:text-3xl font-bold tracking-tighter-2 text-navy text-balance mb-6">
        AI-oplossingen voor uw branche.
      </h2>
      <div class="flex flex-wrap gap-2">
        <a href="/sectoren/accountancy/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white hover:bg-slate-50 border border-slate-200 hover:border-navy rounded-lg text-xs font-medium text-navy transition-all">AI voor accountancy →</a>
        <a href="/sectoren/ai-voor-advocaten/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white hover:bg-slate-50 border border-slate-200 hover:border-navy rounded-lg text-xs font-medium text-navy transition-all">AI voor advocaten →</a>
        <a href="/sectoren/vastgoed/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white hover:bg-slate-50 border border-slate-200 hover:border-navy rounded-lg text-xs font-medium text-navy transition-all">AI voor vastgoed →</a>
        <a href="/sectoren/zorg/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white hover:bg-slate-50 border border-slate-200 hover:border-navy rounded-lg text-xs font-medium text-navy transition-all">AI voor zorg →</a>
        <a href="/sectoren/ai-voor-webshops/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white hover:bg-slate-50 border border-slate-200 hover:border-navy rounded-lg text-xs font-medium text-navy transition-all">AI voor webshops →</a>
        <a href="/sectoren/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-brand-indigo/5 hover:bg-brand-indigo/10 border border-brand-indigo/20 rounded-lg text-xs font-medium text-brand-indigo transition-all">Alle sectoren →</a>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container-page max-w-3xl">
      <p class="eyebrow text-brand-indigo mb-2">Verdiepende kennisbank-gidsen</p>
      <h2 class="text-2xl lg:text-3xl font-bold text-navy mb-6">Lees verder: praktische AI-gidsen voor deze sector</h2>
      <ul class="space-y-3">
        <li><a href="/kennisbank/ai-voor-restaurant-nederland/" class="flex items-center justify-between gap-4 p-4 rounded-xl bg-white border border-slate-200 hover:border-brand-indigo hover:shadow-sm transition-all"><span class="text-sm font-medium text-navy">AI voor restaurants Nederland</span><span class="text-xs text-brand-indigo flex-shrink-0">Lees gids →</span></a></li>
        <li><a href="/kennisbank/ai-voor-evenementenbureau-cateraar-nederland-2026/" class="flex items-center justify-between gap-4 p-4 rounded-xl bg-white border border-slate-200 hover:border-brand-indigo hover:shadow-sm transition-all"><span class="text-sm font-medium text-navy">AI voor evenementen en catering</span><span class="text-xs text-brand-indigo flex-shrink-0">Lees gids →</span></a></li>
        <li><a href="/kennisbank/ai-voor-pensioenadviseur-nederland-2026/" class="flex items-center justify-between gap-4 p-4 rounded-xl bg-white border border-slate-200 hover:border-brand-indigo hover:shadow-sm transition-all"><span class="text-sm font-medium text-navy">AI voor pensioenadviseur — DGA-pensioen en horeca-CAO regelingen</span><span class="text-xs text-brand-indigo flex-shrink-0">Lees gids →</span></a></li>
        <li><a href="/kennisbank/ai-voor-financieel-planner-nederland-2026/" class="flex items-center justify-between gap-4 p-4 rounded-xl bg-white border border-slate-200 hover:border-brand-indigo hover:shadow-sm transition-all"><span class="text-sm font-medium text-navy">AI voor financieel-planner — fiscale planning horeca-ondernemers</span><span class="text-xs text-brand-indigo flex-shrink-0">Lees gids →</span></a></li>
      </ul>
      <div class="mt-8">
        <a href="/kennisbank/" class="text-sm text-brand-indigo hover:underline font-medium">Alle 48 kennisbank-gidsen bekijken →</a>
      </div>
    </div>
  </section>

  <section class="section bg-slate-50 border-y border-slate-200">
    <div class="container-page max-w-4xl">
      <p class="eyebrow text-brand-indigo mb-2">Website + AI = 1 partner</p>
      <h2 class="text-2xl lg:text-3xl font-bold text-navy mb-4">Restaurant- of café-website nodig? Wij bouwen 'm AI-ready</h2>
      <p class="text-slate-600 mb-8 leading-relaxed">Veel horecabedrijven hebben een verouderde website met losse boekingstool en een aparte AI-leverancier voor de telefoon. Bij Aanloop AI is dat één traject: een AI-ready website met menu, reserveringen en Marco (24/7 telefoon-AI) ingebouwd vanaf dag één.</p>
      <div class="grid md:grid-cols-3 gap-4">
        <a href="/diensten/website-laten-maken-mkb-nederland-2026/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">Website laten maken</h3>
          <p class="text-xs text-slate-600 mb-3">Astro/Next/WordPress AI-ready. Schema.org + Speakable + WCAG 2.2 AA.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk pakketten →</span>
        </a>
        <a href="/diensten/ai-website-bundel-mkb-nederland/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">AI-Website Bundel</h3>
          <p class="text-xs text-slate-600 mb-3">Website + Marco (telefoon) + Emma (WhatsApp) in 1 pakket. Bespaart €8.014 jaar 1.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk bundel →</span>
        </a>
        <a href="/kennisbank/website-bouwer-vs-ai-ready-partner-mkb-nederland-2026/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">Webbureau vs AI-ready partner</h3>
          <p class="text-xs text-slate-600 mb-3">TCO 3-jaar tabel + 8-punts checklist voor elke webbureau-evaluatie.</p>
          <span class="text-xs text-brand-indigo font-medium">Lees vergelijking →</span>
        </a>
      </div>
    </div>
  </section>



  <section class="section-tight bg-midnight text-pearl relative overflow-hidden">
    <div class="absolute inset-0 dot-grid opacity-[0.04]"></div>
    <div class="container-page relative max-w-3xl">
      <h2 class="text-3xl font-bold tracking-tightest text-pearl text-balance reveal">Meer gasten, minder gedoe.</h2>
      <p class="mt-4 text-slate-300 reveal reveal-delay-1">Plan een gratis AI scan en ontdek hoe AI uw horecabedrijf versterkt. Live in 7 werkdagen.</p>
      <div class="mt-6 flex flex-col sm:flex-row gap-3 reveal reveal-delay-2">
        <a href="/gratis-ai-scan/" class="btn bg-pearl text-navy hover:bg-white text-base px-6 py-3.5">Gratis AI Scan aanvragen<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></a>
        <a href="/tarieven/" class="btn border border-slate-700 text-pearl hover:bg-slate-800 text-base px-6 py-3.5">Bekijk AI prijzen</a>
      </div>
    </div>
  </section>
<!-- xref-orphan-fix-2026-05-07 -->
<section class="border-t border-pearl/10 bg-midnight/60 py-12" aria-labelledby="xref-orphan-heading">
  <div class="mx-auto max-w-6xl px-6">
    <h2 id="xref-orphan-heading" class="text-xl font-semibold text-pearl mb-6">Lees ook</h2>
    <ul class="grid gap-3 sm:grid-cols-2 text-sm text-pearl/80">
        <li><a href="/kennisbank/ai-voor-reisbureau-touroperator-nederland/" class="text-brand-indigo hover:text-brand-indigo/80 underline-offset-4 hover:underline">AI voor reisbureau en touroperator: 24/7 boekingen</a></li>
        <li><a href="/kennisbank/ai-voor-schoonheidssalon-kapsalon-nederland-2026/" class="text-brand-indigo hover:text-brand-indigo/80 underline-offset-4 hover:underline">AI voor schoonheidssalon en kapsalon: agenda + recall</a></li>
    </ul>
  </div>
</section>
<!-- /xref-orphan-fix-2026-05-07 -->
</BaseLayout>
