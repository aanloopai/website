---
import BaseLayout from '../../layouts/BaseLayout.astro';
const schema = {
  '@context': 'https://schema.org',
  '@type': ['Service', 'FAQPage'],
  name: 'AI voor Detailhandel & E-commerce',
  provider: { '@type': 'Organization', name: 'Aanloop AI', url: 'https://aanloopai.nl' },
  areaServed: 'NL',
  mainEntity: [
    { '@type': 'Question', name: 'Kan AI mijn webshop klantenservice overnemen?', acceptedAnswer: { '@type': 'Answer', text: 'Ja. De AI beantwoordt vragen over bestellingen, verzending en retouren, en escaleert naar een medewerker bij complexe klachten.' } },
    { '@type': 'Question', name: 'Integreert de AI met Shopify, WooCommerce of Lightspeed?', acceptedAnswer: { '@type': 'Answer', text: 'Ja, we ondersteunen koppelingen met de meeste e-commerceplatformen via API. Bestelstatus, voorraadinformatie en klantgegevens zijn real-time beschikbaar voor de AI.' } },
  ],
};
---
<BaseLayout title="AI voor Detailhandel & E-commerce: Klantenservice, Bestellingen & Retouren | Aanloop AI" description="AI voor winkeliers en webshops: klantvragen automatisch beantwoorden, retouren verwerken, upsell aanbevelingen. Shopify & WooCommerce integratie. Starter €997/maand." schema={schema}>
  <section class="border-b border-slate-200 hero-gradient">
    <div class="container-page py-16 lg:py-24">
      <div class="max-w-3xl">
        <div class="flex items-center gap-4 mb-6 reveal"><div class="accent-band"><span></span><span></span><span></span><span></span></div><span class="eyebrow">Sector: Detailhandel & E-commerce</span></div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tightest text-navy text-balance leading-[1.05] reveal reveal-delay-1">AI voor retailers en webshops</h1>
        <p class="mt-6 text-lg text-slate-600 leading-relaxed max-w-2xl reveal reveal-delay-2">Meer omzet, minder klantenservice-kosten. AI beantwoordt vragen over bestellingen en retouren, doet persoonlijke productaanbevelingen en verhoogt uw gemiddelde orderwaarde.</p>
        <div class="mt-8 flex gap-3 flex-wrap reveal reveal-delay-3">
          <a href="/demo-aanvragen/" class="btn-primary text-base px-6 py-3.5">Gratis demo aanvragen <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></a>
          <a href="/sectoren/ai-voor-webshops/" class="btn-outline text-base px-6 py-3.5">Webshop specifiek</a>
        </div>
      </div>
    </div>
  </section>
  <section class="section-tight bg-slate-50 border-b border-slate-200">
    <div class="container-page">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        {[{v:'+18%',l:'gemiddelde orderwaarde'},{v:'−65%',l:'klantenservice tickets'},{v:'24/7',l:'beschikbaar'},{v:'Shopify/WooCommerce',l:'integratie'}].map(s=>(
          <div class="reveal"><p class="text-2xl font-bold text-navy">{s.v}</p><p class="text-xs text-slate-500 mt-1">{s.l}</p></div>
        ))}
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container-page">
      <div class="grid lg:grid-cols-2 gap-16 mb-16">
        <div class="reveal">
          <h2 class="text-2xl font-bold text-navy mb-6">AI-toepassingen voor detailhandel</h2>
          <ul class="space-y-4">
            {['Klantvragen over bestellingen, verzending en retouren automatisch beantwoorden','Persoonlijke productaanbevelingen op basis van aankoophistorie','Retouraanvragen automatisch verwerken en bevestigen','Voorraadstatus real-time communiceren via chat of e-mail','Upsell en cross-sell suggesties tijdens het koopproces','Review-verzoeken automatisch versturen na levering','Seizoensacties aankondigingen via WhatsApp-broadcast'].map(f=>(
              <li class="flex items-start gap-3 text-sm text-slate-700"><svg class="w-5 h-5 mt-0.5 flex-shrink-0 text-brand-emerald" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>{f}</li>
            ))}
          </ul>
        </div>
        <div class="reveal reveal-delay-2">
          <h2 class="text-2xl font-bold text-navy mb-4">Case study: webshop dames mode</h2>
          <div class="bg-slate-50 border border-slate-200 rounded-xl p-5 mb-6">
            <p class="text-sm text-slate-700 italic">"We hadden 120 klantenservice-e-mails per dag. Nu beantwoordt de AI 85% automatisch. Ons team focust op de complexe gevallen. De klanttevredenheid steeg van 7.2 naar 9.1."</p>
            <p class="text-xs text-slate-500 mt-3 font-medium">— E-commerce manager, damesmodewinkel met 3 locaties</p>
          </div>
          <div class="grid grid-cols-2 gap-3">
            {[{v:'85%',l:'vragen automatisch opgelost'},{v:'9.1/10',l:'klanttevredenheid'},{v:'−55%',l:'klantenservice kosten'},{v:'+22%',l:'herhaalaankopen'}].map(s=>(
              <div class="bg-white border border-slate-200 rounded-xl p-4 text-center"><p class="text-xl font-bold text-brand-indigo">{s.v}</p><p class="text-xs text-slate-500 mt-1">{s.l}</p></div>
            ))}
          </div>
        </div>
      </div>
      <div class="max-w-3xl">
        <h2 class="text-2xl font-bold text-navy mb-6 reveal">Veelgestelde vragen</h2>
        <div class="space-y-4 reveal">
          {[
            { v: 'Kan AI mijn webshop klantenservice overnemen?', a: 'Ja. De AI beantwoordt vragen over bestellingen, verzending en retouren, en escaleert naar een medewerker bij complexe klachten.' },
            { v: 'Integreert de AI met Shopify, WooCommerce of Lightspeed?', a: 'Ja, we ondersteunen koppelingen met de meeste e-commerceplatformen via API. Bestelstatus, voorraadinformatie en klantgegevens zijn real-time beschikbaar voor de AI.' },
            { v: 'Is de AI ook geschikt voor fysieke winkels?', a: 'Zeker. Een AI-telefoniste kan openingstijden, productvragen en reserveringen afhandelen voor uw fysieke locaties.' },
          ].map(faq=>(
            <details class="group border border-slate-200 rounded-xl overflow-hidden">
              <summary class="flex items-center justify-between cursor-pointer p-5 font-semibold text-navy text-sm hover:bg-slate-50">
                {faq.v}
                <svg class="w-4 h-4 flex-shrink-0 text-slate-400 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
              </summary>
              <div class="px-5 pb-5 text-sm text-slate-600">{faq.a}</div>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container-page max-w-3xl">
      <p class="eyebrow text-brand-indigo mb-2">Verdiepende kennisbank-gidsen</p>
      <h2 class="text-2xl lg:text-3xl font-bold text-navy mb-6">Lees verder: praktische AI-gidsen voor deze sector</h2>
      <ul class="space-y-3">
        <li><a href="/kennisbank/ai-voor-detailhandel-klantcontact-voorraad/" class="flex items-center justify-between gap-4 p-4 rounded-xl bg-white border border-slate-200 hover:border-brand-indigo hover:shadow-sm transition-all"><span class="text-sm font-medium text-navy">AI voor detailhandel klantcontact</span><span class="text-xs text-brand-indigo flex-shrink-0">Lees gids →</span></a></li>
        <li><a href="/kennisbank/ai-voor-shopify-webshop-nederland/" class="flex items-center justify-between gap-4 p-4 rounded-xl bg-white border border-slate-200 hover:border-brand-indigo hover:shadow-sm transition-all"><span class="text-sm font-medium text-navy">AI voor Shopify webshop</span><span class="text-xs text-brand-indigo flex-shrink-0">Lees gids →</span></a></li>
      </ul>
      <div class="mt-8">
        <a href="/kennisbank/" class="text-sm text-brand-indigo hover:underline font-medium">Alle 48 kennisbank-gidsen bekijken →</a>
      </div>
    </div>
  </section>


  <section class="section-tight bg-midnight text-pearl">
    <div class="container-page max-w-3xl">
      <h2 class="text-3xl font-bold text-pearl reveal">Meer omzet, minder klantenservice-kosten?</h2>
      <p class="mt-4 text-slate-300 reveal reveal-delay-1">Plan een gratis demo en zie hoe AI uw winkel of webshop versterkt.</p>
      <a href="/demo-aanvragen/" class="mt-6 btn bg-pearl text-navy hover:bg-white text-base px-6 py-3.5 reveal reveal-delay-2">Gratis demo aanvragen</a>
    </div>
  </section>
</BaseLayout>
