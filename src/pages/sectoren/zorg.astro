---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import sectorImage from '../../assets/images/sectoren/zorg.jpg';
const schema = {
  '@context': 'https://schema.org',
  '@type': ['Service', 'FAQPage'],
  name: 'AI voor Zorg & Welzijn',
  provider: { '@type': 'Organization', name: 'Aanloop AI', url: 'https://aanloopai.nl' },
  areaServed: 'NL',
  mainEntity: [
    { '@type': 'Question', name: 'Is de AI-oplossing AVG- en NEN 7510-compliant?', acceptedAnswer: { '@type': 'Answer', text: 'Ja. Alle data blijft binnen de EU. We leveren een verwerkersovereenkomst en onze systemen voldoen aan de NEN 7510-norm voor informatiebeveiliging in de zorg.' } },
    { '@type': 'Question', name: 'Kan de AI patiëntgegevens verwerken?', acceptedAnswer: { '@type': 'Answer', text: 'De AI verwerkt minimale persoonsgegevens (naam, afspraakdetails). Medische dossiers worden nooit opgeslagen in het AI-systeem.' } },
    { '@type': 'Question', name: 'Hoe snel is de implementatie?', acceptedAnswer: { '@type': 'Answer', text: 'Voor een huisartsenpraktijk of kleine zorginstelling gemiddeld 10–14 werkdagen, inclusief intake, koppeling aan uw agendapakket en testfase.' } },
  ],
};
---
<BaseLayout title="AI voor Zorg Nederland - Afspraken, Intake en No-Show Reductie" description="AI voor zorg Nederland: AVG-conforme assistent die afspraken 24/7 inplant, intake-vragenlijsten afneemt en no-shows met 30-50% reduceert. NEN 7510 gecertificeerd. Starter vanaf €597 per maand." schema={schema}>
  <section class="border-b border-slate-200 hero-gradient">
    <div class="container-page py-16 lg:py-24">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div class="max-w-3xl">
        <div class="flex items-center gap-4 mb-6 reveal"><div class="accent-band"><span></span><span></span><span></span><span></span></div><span class="eyebrow">Sector: Zorg & Welzijn</span></div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tightest text-navy text-balance leading-[1.05] reveal reveal-delay-1">AI voor zorgverleners — veilig en compliant</h1>
        <p class="mt-6 text-lg text-slate-600 leading-relaxed max-w-2xl reveal reveal-delay-2">Minder telefoondrukte, minder no-shows, meer tijd voor uw patiënten. Onze AI-oplossingen zijn volledig AVG-conform, NEN 7510 gecertificeerd en data blijft altijd binnen de EU.</p>
        <div class="mt-8 flex gap-3 flex-wrap reveal reveal-delay-3">
          <a href="/demo-aanvragen/" class="btn-primary text-base px-6 py-3.5">Gratis demo aanvragen <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></a>
          <a href="/gratis-ai-scan/" class="btn-outline text-base px-6 py-3.5">Gratis AI scan</a>
        </div>
      </div>
      <div class="reveal reveal-delay-2">
        <Image src={sectorImage} alt="Zorgprofessional met smartphone — AI voor zorgverleners NEN 7510 compliant" class="w-full rounded-2xl shadow-xl object-cover aspect-[4/3]" loading="eager" decoding="async" fetchpriority="high" widths={[480, 800, 1200, 1400]} sizes="(min-width: 1024px) 600px, 100vw" format="webp" quality={82} />
      </div>
      </div>
    </div>
  </section>
  <section class="section-tight bg-slate-50 border-b border-slate-200">
    <div class="container-page">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        {[{v:'−30%',l:'no-show percentage'},{v:'2 uur/dag',l:'bespaard op telefonische afspraken'},{v:'24/7',l:'bereikbaar voor patiënten'},{v:'100%',l:'EU data-verwerking'}].map(s=>(
          <div class="reveal"><p class="text-2xl font-bold text-navy">{s.v}</p><p class="text-xs text-slate-500 mt-1">{s.l}</p></div>
        ))}
      </div>
    </div>
  </section>
  <!-- Sector-specifieke uitdagingen -->
  <section class="section border-b border-slate-200">
    <div class="container-page max-w-4xl mx-auto">
      <div class="mb-10 reveal">
        <p class="eyebrow mb-2">Uitdagingen in zorg & welzijn</p>
        <h2 class="text-2xl font-bold text-navy mb-6">Waarom zorgpraktijken telefoondrukte niet meer bijhouden</h2>
        <p class="text-slate-600 leading-relaxed mb-6">Een gemiddelde huisartsenpraktijk of fysiotherapiepraktijk ontvangt 40–80 telefoontjes per dag. De helft gaat over afspraken plannen, bevestigen of verzetten — routinewerk dat te veel tijd kost van de assistenten. Tegelijkertijd neemt de no-show door het ontbreken van herinneringen toe, en wachttijden groeien. AI lost dit structureel op zonder medische rol over te nemen.</p>
      </div>
      <div class="space-y-5 reveal">
        {[
          { title: 'Telefoondrukte in de ochtend belemmert patiëntenzorg', body: 'Tussen 08:00 en 09:30 piekert de telefonie in elke praktijk. Assistenten zijn bezet met afsprakenbeheer terwijl de wachtkamer vol zit. AI agent Marco neemt routinegesprekken automatisch aan — ook buiten kantoortijden. Zo kunnen assistenten zich richten op de patiënt die voor hen staat.' },
          { title: 'No-show percentage loopt op tot 15–20% zonder herinneringen', body: 'Zorgorganisaties verliezen jaarlijks duizenden euro\'s aan geen-verschijn-consulten. Een geautomatiseerde herinnering 24 uur en 2 uur voor de afspraak — via SMS, WhatsApp of telefoon — verlaagt no-shows gemiddeld met 30%. Dit vereist een AVG-conforme verwerking van minimale persoonsgegevens.' },
          { title: 'Wachtlijstbeheer is handmatig en foutgevoelig', body: 'Bij annulering vrijgekomen plekken worden handmatig ingevuld, wat resulteert in lege slots en onnodige wachttijd. AI beheert automatisch een wachtlijst: bij annulering wordt de eerstvolgende beschikbare patiënt op de wachtlijst proactief benaderd en uitgenodigd voor het vrijgekomen slot.' },
          { title: 'NEN 7510 en AVG vereisen zorgvuldige dataverwerking', body: 'In de zorg gelden strengere eisen dan in andere sectoren: NEN 7510 voor informatiebeveiliging en de AVG voor persoonsgegevens. Aanloop AI verwerkt minimale persoonsdata (naam, afspraakdetails) op Nederlandse servers via n8n self-hosted. Medische dossiers worden nooit opgeslagen in het AI-systeem. Verwerkersovereenkomst inbegrepen.' },
        ].map(item => (
          <div class="border border-slate-200 rounded-xl p-5 bg-white">
            <h3 class="font-semibold text-navy mb-2 text-sm">{item.title}</h3>
            <p class="text-sm text-slate-600 leading-relaxed">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Trust signals -->
  <section class="section border-b border-slate-200">
    <div class="container-page max-w-4xl mx-auto">
      <div class="mb-8 reveal">
        <p class="eyebrow mb-2">Compliance & werkwijze</p>
        <h2 class="text-2xl font-bold text-navy mb-4">Voor de zorgsector werken wij speciaal met</h2>
      </div>
      <div class="grid md:grid-cols-2 gap-4 reveal">
        {[
          { icon: '🔒', title: 'NEN 7510 informatiebeveiliging', body: 'Onze AI-implementaties voor de zorg voldoen aan NEN 7510 — de Nederlandse norm voor informatiebeveiliging in de zorg. Alle communicatiestromen worden versleuteld en opgeslagen op EU-servers. We leveren een verwerkersovereenkomst conform AVG artikel 28.' },
          { icon: '📋', title: 'Medicom, Nexus & HIS-koppelingen', body: 'Koppeling met gangbare huisartspakketten (Medicom, Nexus, Promedico) voor directe agenda-integratie. Afspraken worden rechtstreeks in uw HIS-agenda gezet zonder handmatige overdracht — AVG-conform via geauthenticeerde API.' },
          { icon: '🏥', title: 'Triage zonder medisch advies', body: 'De AI agent plant afspraken in op basis van urgentie-indicaties (spoed / zelfde dag / regulier) maar geeft nooit medisch advies of diagnoses. De triage blijft altijd bij de zorgprofessional. Dit is contractueel vastgelegd in onze verwerkersovereenkomst.' },
          { icon: '🌐', title: '100% EU data-verwerking via n8n', body: 'Patiëntdata verlaat nooit de EU. We gebruiken n8n self-hosted op een Nederlandse Hetzner-server. Geen doorgifte aan Amerikaanse AI-providers voor persoonsgegevens. Volledig auditeerbaar met transactielogboek.' },
        ].map(t => (
          <div class="flex gap-4 p-4 rounded-xl border border-slate-200 bg-slate-50">
            <span class="text-2xl">{t.icon}</span>
            <div>
              <p class="font-semibold text-navy text-sm mb-1">{t.title}</p>
              <p class="text-xs text-slate-600 leading-relaxed">{t.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page">
      <div class="grid lg:grid-cols-2 gap-16 mb-16">
        <div class="reveal">
          <p class="eyebrow mb-2">Toepassingen</p>
          <h2 class="text-2xl font-bold text-navy mb-6">AI-use cases voor de zorg</h2>
          <ul class="space-y-4">
            {['Afspraken plannen en bevestigen via telefoon of WhatsApp','Intake-vragenlijsten automatisch afnemen vóór consult','Herinneringen sturen 24u en 2u voor afspraak (−30% no-show)','Basisvragen beantwoorden (openingstijden, locatie, verwijzingen)','Wachtlijstbeheer en urgentie-triage op basis van klachten','Herhaalrecepten-verzoeken registreren en doorsturen','Nazorg-communicatie na behandeling automatiseren'].map(f=>(
              <li class="flex items-start gap-3 text-sm text-slate-700"><svg class="w-5 h-5 mt-0.5 flex-shrink-0 text-brand-emerald" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>{f}</li>
            ))}
          </ul>
          <div class="mt-6 p-4 rounded-xl bg-brand-emerald/10 border border-brand-emerald/20">
            <p class="text-sm font-bold text-brand-emerald mb-1">🔒 Compliance-garantie</p>
            <p class="text-xs text-slate-600">AVG-conform · NEN 7510 · Data uitsluitend binnen EU · Verwerkersovereenkomst inbegrepen</p>
          </div>
        </div>
        <div class="reveal reveal-delay-2">
          <p class="eyebrow mb-2">Case study</p>
          <h2 class="text-2xl font-bold text-navy mb-4">Huisartsenpraktijk vermindert no-shows met 31%</h2>
          <div class="grid grid-cols-2 gap-3">
            {[{v:'−31%',l:'no-shows'},{v:'3 uur/dag',l:'bespaard op telefonie'},{v:'98%',l:'patiënttevredenheid'},{v:'10 dgn',l:'implementatietijd'}].map(s=>(
              <div class="bg-white border border-slate-200 rounded-xl p-4 text-center"><p class="text-xl font-bold text-brand-indigo">{s.v}</p><p class="text-xs text-slate-500 mt-1">{s.l}</p></div>
            ))}
          </div>
        </div>
      </div>
      <div class="max-w-3xl">
        <h2 class="text-2xl font-bold text-navy mb-6 reveal">Veelgestelde vragen — AI in de zorg</h2>
        <div class="space-y-4 reveal">
          {[
            { v: 'Is de AI-oplossing AVG- en NEN 7510-compliant?', a: 'Ja. Alle data blijft binnen de EU. We leveren een verwerkersovereenkomst en onze systemen voldoen aan de NEN 7510-norm voor informatiebeveiliging in de zorg.' },
            { v: 'Kan de AI patiëntgegevens verwerken?', a: 'De AI verwerkt minimale persoonsgegevens (naam, afspraakdetails). Medische dossiers worden nooit opgeslagen in het AI-systeem.' },
            { v: 'Hoe snel is de implementatie?', a: 'Voor een huisartsenpraktijk of kleine zorginstelling gemiddeld 10–14 werkdagen, inclusief intake, koppeling aan uw agendapakket en testfase.' },
            { v: 'Werkt de AI met mijn agendapakket (Medicom, Nexus)?', a: 'We ondersteunen koppeling met de meeste gangbare zorgpakketten via API. Neem contact op voor uw specifieke situatie.' },
          ].map(faq=>(
            <details class="group border border-slate-200 rounded-xl overflow-hidden">
              <summary class="flex items-center justify-between cursor-pointer p-5 font-semibold text-navy text-sm hover:bg-slate-50">
                {faq.v}
                <svg class="w-4 h-4 flex-shrink-0 text-slate-400 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
              </summary>
              <div class="px-5 pb-5 text-sm text-slate-600">{faq.a}</div>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>
  <!-- Locations cross-link -->
  <section class="section-tight border-t border-slate-200">
    <div class="container-page">
      <p class="eyebrow mb-3">AI voor zorg in heel Nederland</p>
      <h2 class="text-2xl lg:text-3xl font-bold tracking-tighter-2 text-navy text-balance mb-6">
        Praktijken en zorgorganisaties — landelijke dekking.
      </h2>
      <p class="text-slate-600 leading-relaxed mb-6 max-w-2xl">
        Aanloop AI bedient zorgpraktijken in heel Nederland — huisartsen, fysiotherapie, tandartsen,
        GGZ-instellingen. AVG-compliant met optionele NEN 7510-opzet voor extra-gevoelige patiëntdata.
      </p>
      <div class="flex flex-wrap gap-2">
        <a href="/locaties/rotterdam/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-slate-50 hover:bg-slate-100 border border-slate-200 hover:border-slate-300 rounded-lg text-xs font-medium text-navy transition-all">AI zorg Rotterdam →</a>
        <a href="/locaties/amsterdam/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-slate-50 hover:bg-slate-100 border border-slate-200 hover:border-slate-300 rounded-lg text-xs font-medium text-navy transition-all">AI zorg Amsterdam →</a>
        <a href="/locaties/den-haag/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-slate-50 hover:bg-slate-100 border border-slate-200 hover:border-slate-300 rounded-lg text-xs font-medium text-navy transition-all">AI zorg Den Haag →</a>
        <a href="/locaties/utrecht/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-slate-50 hover:bg-slate-100 border border-slate-200 hover:border-slate-300 rounded-lg text-xs font-medium text-navy transition-all">AI zorg Utrecht →</a>
        <a href="/locaties/eindhoven/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-slate-50 hover:bg-slate-100 border border-slate-200 hover:border-slate-300 rounded-lg text-xs font-medium text-navy transition-all">AI zorg Eindhoven →</a>
        <a href="/locaties/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-brand-indigo/5 hover:bg-brand-indigo/10 border border-brand-indigo/20 rounded-lg text-xs font-medium text-brand-indigo transition-all">Alle steden →</a>
      </div>
    </div>
  </section>

  <!-- Other sectors -->
  <section class="section-tight bg-slate-50/60 border-y border-slate-200">
    <div class="container-page">
      <p class="eyebrow mb-3">Andere sectoren</p>
      <h2 class="text-2xl lg:text-3xl font-bold tracking-tighter-2 text-navy text-balance mb-6">
        AI-oplossingen voor andere branches.
      </h2>
      <div class="flex flex-wrap gap-2">
        <a href="/sectoren/ai-voor-advocaten/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white hover:bg-slate-50 border border-slate-200 hover:border-navy rounded-lg text-xs font-medium text-navy transition-all">AI voor advocaten →</a>
        <a href="/sectoren/accountancy/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white hover:bg-slate-50 border border-slate-200 hover:border-navy rounded-lg text-xs font-medium text-navy transition-all">AI voor accountancy →</a>
        <a href="/sectoren/zakelijk/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white hover:bg-slate-50 border border-slate-200 hover:border-navy rounded-lg text-xs font-medium text-navy transition-all">AI voor zakelijke dienstverlening →</a>
        <a href="/sectoren/ai-voor-zzp/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white hover:bg-slate-50 border border-slate-200 hover:border-navy rounded-lg text-xs font-medium text-navy transition-all">AI voor ZZP →</a>
        <a href="/sectoren/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-brand-indigo/5 hover:bg-brand-indigo/10 border border-brand-indigo/20 rounded-lg text-xs font-medium text-brand-indigo transition-all">Alle sectoren →</a>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container-page max-w-3xl">
      <p class="eyebrow text-brand-indigo mb-2">Verdiepende kennisbank-gidsen</p>
      <h2 class="text-2xl lg:text-3xl font-bold text-navy mb-6">Lees verder: praktische AI-gidsen voor deze sector</h2>
      <ul class="space-y-3">
        <li><a href="/kennisbank/ai-voor-huisartsenpraktijk/" class="flex items-center justify-between gap-4 p-4 rounded-xl bg-white border border-slate-200 hover:border-brand-indigo hover:shadow-sm transition-all"><span class="text-sm font-medium text-navy">AI voor huisartsenpraktijk</span><span class="text-xs text-brand-indigo flex-shrink-0">Lees gids →</span></a></li>
        <li><a href="/kennisbank/ai-voor-fysiotherapiepraktijk-nederland/" class="flex items-center justify-between gap-4 p-4 rounded-xl bg-white border border-slate-200 hover:border-brand-indigo hover:shadow-sm transition-all"><span class="text-sm font-medium text-navy">AI voor fysiotherapiepraktijk</span><span class="text-xs text-brand-indigo flex-shrink-0">Lees gids →</span></a></li>
        <li><a href="/kennisbank/ai-voor-tandartspraktijk-nederland/" class="flex items-center justify-between gap-4 p-4 rounded-xl bg-white border border-slate-200 hover:border-brand-indigo hover:shadow-sm transition-all"><span class="text-sm font-medium text-navy">AI voor tandartspraktijk</span><span class="text-xs text-brand-indigo flex-shrink-0">Lees gids →</span></a></li>
        <li><a href="/kennisbank/ai-no-show-reductie-mkb-nederland/" class="flex items-center justify-between gap-4 p-4 rounded-xl bg-white border border-slate-200 hover:border-brand-indigo hover:shadow-sm transition-all"><span class="text-sm font-medium text-navy">AI no-show reductie voor MKB</span><span class="text-xs text-brand-indigo flex-shrink-0">Lees gids →</span></a></li>
        <li><a href="/kennisbank/ai-voor-pensioenadviseur-nederland-2026/" class="flex items-center justify-between gap-4 p-4 rounded-xl bg-white border border-slate-200 hover:border-brand-indigo hover:shadow-sm transition-all"><span class="text-sm font-medium text-navy">AI voor pensioenadviseur — ZZP-zorg en praktijkhouder pensioen</span><span class="text-xs text-brand-indigo flex-shrink-0">Lees gids →</span></a></li>
        <li><a href="/kennisbank/ai-voor-financieel-planner-nederland-2026/" class="flex items-center justify-between gap-4 p-4 rounded-xl bg-white border border-slate-200 hover:border-brand-indigo hover:shadow-sm transition-all"><span class="text-sm font-medium text-navy">AI voor financieel-planner — fiscale planning zorgondernemer</span><span class="text-xs text-brand-indigo flex-shrink-0">Lees gids →</span></a></li>
      </ul>
      <div class="mt-8">
        <a href="/kennisbank/" class="text-sm text-brand-indigo hover:underline font-medium">Alle 48 kennisbank-gidsen bekijken →</a>
      </div>
    </div>
  </section>

  <section class="section bg-slate-50 border-y border-slate-200">
    <div class="container-page max-w-4xl">
      <p class="eyebrow text-brand-indigo mb-2">Website + AI = 1 partner</p>
      <h2 class="text-2xl lg:text-3xl font-bold text-navy mb-4">Praktijk-website nodig? Wij bouwen 'm AI-ready met NEN 7510 + AVG ingebouwd</h2>
      <p class="text-slate-600 mb-8 leading-relaxed">Veel zorgpraktijken hebben een verouderde website van een lokaal bureau, en sluiten apart een AI-leverancier aan voor de telefoon of intake-formulieren. Bij Aanloop AI is dat één traject: een AI-ready praktijk-website met online afspraken, no-show reductie en Marco (24/7 telefoon-AI) ingebouwd vanaf dag één — inclusief NEN 7510 + AVG-toets.</p>
      <div class="grid md:grid-cols-3 gap-4">
        <a href="/diensten/website-laten-maken-mkb-nederland-2026/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">Praktijk-website laten maken</h3>
          <p class="text-xs text-slate-600 mb-3">Astro/Next/WordPress AI-ready. Schema.org + Speakable + WCAG 2.2 AA + AVG/NEN 7510-checks.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk pakketten →</span>
        </a>
        <a href="/diensten/ai-website-bundel-mkb-nederland/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">AI-Website Bundel</h3>
          <p class="text-xs text-slate-600 mb-3">Website + Marco (telefoon) + Emma (WhatsApp) in 1 pakket. Bespaart €8.014 jaar 1.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk bundel →</span>
        </a>
        <a href="/kennisbank/website-bouwer-vs-ai-ready-partner-mkb-nederland-2026/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">Webbureau vs AI-ready partner</h3>
          <p class="text-xs text-slate-600 mb-3">TCO 3-jaar tabel + 8-punts checklist voor elke webbureau-evaluatie.</p>
          <span class="text-xs text-brand-indigo font-medium">Lees vergelijking →</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section-tight bg-midnight text-pearl">
    <div class="container-page max-w-3xl">
      <h2 class="text-3xl font-bold text-pearl reveal">Meer tijd voor uw patiënten?</h2>
      <p class="mt-4 text-slate-300 reveal reveal-delay-1">Plan een gratis demo en ontdek hoe AI uw praktijk of instelling ondersteunt.</p>
      <div class="mt-6 flex gap-3 reveal reveal-delay-2">
        <a href="/demo-aanvragen/" class="btn bg-pearl text-navy hover:bg-white text-base px-6 py-3.5">Gratis demo aanvragen</a>
        <a href="/kennisbank/ai-agent-voorbeelden/" class="btn border border-slate-700 text-pearl hover:bg-slate-800 text-base px-6 py-3.5">Bekijk voorbeelden</a>
      </div>
    </div>
  </section>
<!-- xref-orphan-fix-2026-05-07 -->
