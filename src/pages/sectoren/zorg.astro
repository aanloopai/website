---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Zorg & welzijn · Aanloop AI" description="AI-oplossingen voor zorgverleners: afsprakenbeheer, intake-vragenlijsten, patiëntcommunicatie. AVG-conform en NEN 7510 gecertificeerd.">
  <section class="border-b border-slate-200 hero-gradient">
    <div class="container-page py-16 lg:py-24">
      <div class="max-w-3xl">
        <div class="flex items-center gap-4 mb-6"><div class="accent-band"><span></span><span></span><span></span><span></span></div><span class="eyebrow">Zorg & welzijn</span></div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tightest text-navy text-balance leading-[1.05]">AI voor zorgverleners — veilig en compliant.</h1>
        <p class="mt-6 text-lg text-slate-600 leading-relaxed max-w-2xl">Van afspraken plannen en intakes afnemen tot patiëntcommunicatie automatiseren — alles AVG-conform, data uitsluitend binnen de EU, NEN 7510 gecertificeerd.</p>
        <div class="mt-8 flex gap-3 flex-wrap">
          <a href="/contact/?type=demo" class="btn-primary text-base px-6 py-3.5">Boek een demo <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></a>
        </div>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container-page">
      <div class="grid lg:grid-cols-2 gap-16">
        <div class="reveal">
          <h2 class="text-2xl font-bold text-navy mb-6">Zorg-specifieke toepassingen</h2>
          <ul class="space-y-4">
            {['Afspraken plannen en bevestigen via telefoon of WhatsApp', 'Intake-vragenlijsten automatisch afnemen voor consult', 'Herinneringen sturen en no-shows verminderen', 'Basisvragen beantwoorden (openingstijden, locatie, verwijzing)', 'Wachtlijstbeheer en urgentie-triage', 'Herhaalrecepten-verzoeken registreren en routeren', 'Nazorg-communicatie automatiseren'].map(f => (
              <li class="flex items-start gap-3 text-sm text-slate-700"><svg class="w-5 h-5 mt-0.5 flex-shrink-0 text-brand-emerald" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>{f}</li>
            ))}
          </ul>
          <div class="mt-6 p-4 rounded-xl bg-brand-emerald/10 border border-brand-emerald/20">
            <p class="text-sm font-medium text-brand-emerald">🔒 Compliance-garantie</p>
            <p class="text-xs text-slate-600 mt-1">AVG-conform · NEN 7510 · Data uitsluitend binnen EU · Verwerkersovereenkomst inbegrepen</p>
          </div>
        </div>
        <div class="reveal reveal-delay-2">
          <div class="card bg-slate-50">
            <p class="eyebrow mb-3">Resultaten</p>
            <div class="space-y-4">
              {[{v:'−30%', l:'no-show percentage'},{v:'2 u/dag', l:'bespaard op telefonische afspraken'},{v:'24/7', l:'bereikbaar voor patiënten'},{v:'100%', l:'EU data-verwerking'}].map(s=>(
                <div class="flex items-center justify-between py-3 border-b border-slate-200 last:border-0">
                  <span class="text-sm text-slate-600">{s.l}</span>
                  <span class="font-bold text-brand-indigo">{s.v}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <section class="section-tight bg-midnight text-pearl">
    <div class="container-page">
      <div class="max-w-2xl">
        <h2 class="text-3xl font-bold tracking-tightest text-pearl">Meer tijd voor uw patiënten.</h2>
        <p class="mt-4 text-slate-300">Plan een gratis demo voor uw praktijk of instelling.</p>
        <div class="mt-6"><a href="/contact/?type=demo" class="btn bg-pearl text-navy hover:bg-white text-base px-6 py-3.5">Boek een demo</a></div>
      </div>
    </div>
  </section>
</BaseLayout>
