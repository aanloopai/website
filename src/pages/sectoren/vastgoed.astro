---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import sectorImage from '../../assets/images/sectoren/vastgoed.jpg';

const faqItems = [
  { question: 'Hoe helpt AI makelaars bij leadkwalificatie?', answer: 'Een AI agent stelt automatisch kwalificerende vragen aan inkomende leads: budget, gewenste locatie, tijdlijn en type woning. Alleen gekwalificeerde leads worden doorgezet naar de makelaar. Dit bespaart gemiddeld 8 uur per week op intakegesprekken.' },
  { question: 'Kan een AI agent bezichtigingen inplannen?', answer: 'Ja. Via een koppeling met uw agenda (Google Calendar, Outlook) plant de AI agent bezichtigingen direct in. De geïnteresseerde ontvangt automatisch een bevestiging inclusief adres, datum en aanvullende informatie over de woning.' },
  { question: 'Kan de AI vragen beantwoorden over specifieke woningen?', answer: 'Ja. De AI agent wordt gevoed met de woninggegevens uit uw CRM of MLS-systeem. Vragen over oppervlakte, bouwjaar, energielabel, vraagprijs en bijzonderheden worden direct en correct beantwoord — ook buiten kantooruren.' },
  { question: 'Is een AI agent AVG-compliant voor vastgoedkantoren?', answer: 'Ja. Aanloop AI gebruikt n8n self-hosted op een Nederlandse server. Gegevens van woningzoekenden worden niet gedeeld met derden en zijn volledig AVG-compliant verwerkt.' },
  { question: 'Hoeveel gemiste bezichtigingen voorkomen AI agents?', answer: 'Vastgoedkantoren die een AI agent inzetten rapporteren gemiddeld 68% minder gemiste inkomende calls buiten kantooruren. Gecombineerd met geautomatiseerde bevestigingen daalt de no-show bij bezichtigingen met 50%.' },
];
const schema = { '@context': 'https://schema.org', '@type': 'Service', name: 'AI voor Vastgoed en Makelaars', serviceType: 'AI voor Vastgoed en Makelaars', provider: { '@type': 'Organization', name: 'Aanloop AI', url: 'https://aanloopai.nl' }, areaServed: { '@type': 'Country', name: 'Nederland' }, description: 'AI agents voor makelaars: leadkwalificatie, bezichtigingen inplannen, 24/7 bereikbaar. AVG-compliant.' };
---
<BaseLayout title="AI voor Makelaars Nederland - Lead Kwalificatie en Bezichtigingen 24/7" description="AI voor makelaars Nederland: AI-agent voor makelaars en vastgoedbedrijven. Automatisch leads kwalificeren, bezichtigingen inplannen en 24/7 beschikbaar voor woningzoekenden. KVK 88606902." schema={schema} faqSchema={faqItems}>
  <section class="border-b border-slate-200 hero-gradient">
    <div class="container-page py-16 lg:py-24">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div class="max-w-3xl">
        <div class="flex items-center gap-4 mb-6"><div class="accent-band"><span></span><span></span><span></span><span></span></div><span class="eyebrow">Vastgoed &amp; Makelaars</span></div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tightest text-navy text-balance leading-[1.05] reveal reveal-delay-1">AI die uw vastgoedportfolio versterkt.</h1>
        <p class="mt-6 text-lg text-slate-600 leading-relaxed max-w-2xl reveal reveal-delay-2">Van leads kwalificeren en bezichtigingen plannen tot 24/7 bereikbaarheid voor woningzoekenden — AI werkt voor uw kantoor ook als u er niet bent.</p>
        <div class="mt-8 flex gap-3 flex-wrap reveal reveal-delay-3">
          <a href="/gratis-ai-scan/" class="btn-primary text-base px-6 py-3.5">Gratis AI scan aanvragen <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></a>
          <a href="/prijzen/" class="btn-outline text-base px-6 py-3.5">Bekijk prijzen</a>
        </div>
      </div>
      <div class="reveal reveal-delay-2">
        <Image src={sectorImage} alt="Modern Nederlands woninginterieur — AI voor makelaars en vastgoedkantoren" class="w-full rounded-2xl shadow-xl object-cover aspect-[4/3]" loading="eager" decoding="async" fetchpriority="high" widths={[480, 800, 1200, 1400]} sizes="(min-width: 1024px) 600px, 100vw" format="webp" quality={82} />
      </div>
      </div>
    </div>
  </section>

  <!-- Stats bar -->
  <section class="section-tight bg-slate-50 border-b border-slate-200">
    <div class="container-page">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        {[
          { v: '3×', l: 'meer gekwalificeerde leads' },
          { v: '−50%', l: 'no-show bezichtigingen' },
          { v: '24/7', l: 'bereikbaar voor geïnteresseerden' },
          { v: '7 dgn', l: 'time-to-live' },
        ].map(s => (
          <div class="reveal"><p class="text-2xl font-bold text-navy">{s.v}</p><p class="text-xs text-slate-500 mt-1">{s.l}</p></div>
        ))}
      </div>
    </div>
  </section>

  <!-- Sector-specifieke uitdagingen -->
  <section class="section border-b border-slate-200">
    <div class="container-page max-w-4xl mx-auto">
      <div class="mb-10 reveal">
        <p class="eyebrow mb-2">Uitdagingen in vastgoed & makelaardij</p>
        <h2 class="text-2xl font-bold text-navy mb-6">Waarom makelaars en vastgoedbedrijven leads mislopen</h2>
        <p class="text-slate-600 leading-relaxed mb-6">De vastgoedmarkt is 24/7 actief: woningzoekenden browsen op Funda tussen 19:00 en 22:00, bellen op zaterdag en sturen WhatsApp-berichten terwijl uw kantoor gesloten is. Zonder AI-ondersteuning leidt dat structureel tot gemiste leads, no-show bezichtigingen en tijdverlies op niet-gekwalificeerde intake.</p>
      </div>
      <div class="space-y-5 reveal">
        {[
          { title: 'Leads komen buiten kantooruren binnen', body: 'Funda-bezoekers zijn het actiefst tussen 19:00 en 22:00 en in het weekend. Een gemiste call of onbeantwoord WhatsApp-bericht betekent dat de woningzoekende binnen 10 minuten naar een concurrent belt. AI agent Marco vangt deze leads 24/7 op en kwalificeert direct: budget, gewenste locatie, tijdlijn en type woning.' },
          { title: 'Intake-kwalificatie kost 4–6 uur per week per makelaar', body: 'Makelaars besteden gemiddeld een volledige werkdag per week aan eerste gesprekken met leads die uiteindelijk niet serieus zijn of buiten het aanbod vallen. AI stelt automatisch kwalificerende vragen en stuurt alleen serieuze kopers door — zo focust u uw tijd op de warme leads.' },
          { title: 'No-show bij bezichtigingen treft gemiddeld 1 op 5 afspraken', body: 'Zonder geautomatiseerde bevestiging en herinnering loopt het no-show percentage bij bezichtigingen op tot 20%. AI verstuurt automatisch een bevestiging bij inplanning, een herinnering 24 uur van tevoren en een WhatsApp-bericht op de ochtend van de bezichtiging — bewezen effectief via Emma.' },
          { title: 'Huurderscommunicatie bij verhuurportefeuilles vergt structuur', body: 'Verhuurmakelaars en property managers ontvangen dagelijks huurdersvragen over onderhoud, huurverhoging en contractverlenging. Zonder gestructureerde intake escaleren kleine verzoeken. AI agent Emma verwerkt binnenkomende huurdersvragen via WhatsApp, categoriseert ze en plant technische inspecties direct in uw agenda.' },
        ].map(item => (
          <div class="border border-slate-200 rounded-xl p-5 bg-white">
            <h3 class="font-semibold text-navy mb-2 text-sm">{item.title}</h3>
            <p class="text-sm text-slate-600 leading-relaxed">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Trust signals -->
  <section class="section border-b border-slate-200">
    <div class="container-page max-w-4xl mx-auto">
      <div class="mb-8 reveal">
        <p class="eyebrow mb-2">Compliance & werkwijze</p>
        <h2 class="text-2xl font-bold text-navy mb-4">Voor makelaars en vastgoedbedrijven werken wij speciaal met</h2>
      </div>
      <div class="grid md:grid-cols-2 gap-4 reveal">
        {[
          { icon: '🔗', title: 'CRM & MLS koppelingen', body: 'Directe koppeling met uw bestaande makelaarssoftware: Real Works, Makelaarsland CRM, Brainware en generieke MLS-exports. Woningdata wordt automatisch geladen zodat de AI agent altijd actuele informatie geeft over uw aanbod.' },
          { icon: '📅', title: 'Agenda-integratie voor bezichtigingsplanning', body: 'Google Calendar en Outlook worden rechtstreeks gekoppeld. Bezichtigingen worden ingepland binnen uw beschikbaarheidsgrenzen, bevestigingen automatisch verstuurd en herinneringen getriggerd 24 uur voor aanvang — geen dubbele boekingen.' },
          { icon: '💬', title: 'WhatsApp Emma voor huurderscommunicatie', body: 'Emma verwerkt huurdersvragen via WhatsApp Business API: onderhoudsverzoeken, huurincasso-herinneringen en contractvragen. Urgente meldingen worden direct doorgestuurd; routinemeldingen worden gecategoriseerd en ingepland.' },
          { icon: '🔒', title: 'AVG-compliant leaddata verwerking', body: 'Alle leadgegevens worden verwerkt op een Nederlandse server via n8n self-hosted. Persoonsgegevens van woningzoekenden en huurders worden niet gedeeld met externe partijen. U ontvangt een verwerkersovereenkomst conform AVG artikel 28.' },
        ].map(t => (
          <div class="flex gap-4 p-4 rounded-xl border border-slate-200 bg-slate-50">
            <span class="text-2xl">{t.icon}</span>
            <div>
              <p class="font-semibold text-navy text-sm mb-1">{t.title}</p>
              <p class="text-xs text-slate-600 leading-relaxed">{t.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page">
      <div class="grid lg:grid-cols-2 gap-12 mb-16">
        <div class="reveal">
          <p class="eyebrow mb-2">Toepassingen</p>
          <h2 class="text-2xl font-bold text-navy mb-6">Vastgoed-specifieke AI-toepassingen</h2>
          <ul class="space-y-4">
            {[
              'Inkomende leads kwalificeren (budget, wensen, tijdlijn)',
              'Bezichtigingen plannen en bevestigen via telefoon & WhatsApp',
              'Vragen over woningen beantwoorden 24/7',
              'Huurders automatisch aanschrijven bij onderhoudsverzoeken',
              'Contracten samenvatten en afwijkingen signaleren',
              'Maandelijkse huurincasso-herinneringen versturen',
              'Post-bezichtiging follow-up automatiseren',
            ].map(f => (
              <li class="flex items-start gap-3 text-sm text-slate-700"><svg class="w-5 h-5 mt-0.5 flex-shrink-0 text-brand-emerald" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>{f}</li>
            ))}
          </ul>
        </div>
        <div class="reveal reveal-delay-2">
          <div class="card bg-slate-50 mb-6">
            <p class="eyebrow mb-4">Casestudy</p>
            <h3 class="text-lg font-bold text-navy mb-3">Makelaarskantoor: 68% minder gemiste calls</h3>
            <p class="text-sm text-slate-600 mb-4">Een makelaarskantoor in Amsterdam ontving dagelijks 25+ calls buiten kantooruren. 40% hiervan betrof bezichtigingsaanvragen die verloren gingen. Na implementatie van de AI agent:</p>
            <ul class="space-y-2 text-sm">
              {['68% minder gemiste inkomende calls', '50% reductie no-show bezichtigingen', '3× meer gekwalificeerde leads per maand', '€4.800 extra omzet in eerste 60 dagen'].map(r => (
                <li class="flex items-start gap-2"><span class="text-brand-emerald">✓</span>{r}</li>
              ))}
            </ul>
          </div>
          <div class="card">
            <blockquote class="text-sm text-slate-700 italic leading-relaxed">"De AI agent beantwoordt 's avonds en in het weekend alle vragen over onze woningen. We missen geen bezichtigingsaanvraag meer en onze makelaars kunnen zich focussen op persoonlijk contact."</blockquote>
            <div class="mt-3 text-xs text-slate-500"><strong class="text-navy">Petra Smeets</strong> · Eigenaar, Smeets Makelaars, Amsterdam</div>
          </div>
        </div>
      </div>

      <!-- Use cases per type -->
      <div class="mb-16">
        <div class="mb-8 reveal"><h2 class="text-2xl font-bold text-navy">AI voor elk type vastgoedkantoor</h2></div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {[
            { icon: '🏡', t: 'Verkoopmakelaar', d: 'AI qualificeert woningzoekers automatisch en plant bezichtigingen in. U ontvangt alleen serieuze kopers.' },
            { icon: '🏢', t: 'Verhuurmakelaar', d: 'Huurderscommunicatie, onderhoudsverzoeken en incasso-reminders — volledig geautomatiseerd via WhatsApp.' },
            { icon: '🏗️', t: 'Projectontwikkelaar', d: 'Informatieverstrekking over nieuwbouwprojecten, intakeformulieren en lead nurturing automatisch afgehandeld.' },
          ].map(u => (
            <div class="card reveal">
              <div class="text-2xl mb-3">{u.icon}</div>
              <h3 class="font-bold text-navy mb-2">{u.t}</h3>
              <p class="text-sm text-slate-600">{u.d}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- FAQ -->
      <div class="max-w-3xl">
        <h2 class="text-2xl font-bold text-navy mb-6">Veelgestelde Vragen — AI voor Makelaars</h2>
        <div class="space-y-3 mb-8">
          {faqItems.map(item => (
            <details class="card group">
              <summary class="flex items-center justify-between cursor-pointer list-none">
                <span class="text-sm font-bold text-navy pr-6">{item.question}</span>
                <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
              </summary>
              <p class="mt-4 text-sm text-slate-600 leading-relaxed">{item.answer}</p>
            </details>
          ))}
        </div>
        <div class="bg-slate-50 border border-slate-200 rounded-xl p-6">
          <p class="text-sm font-bold text-navy mb-3">Gerelateerde artikelen</p>
          <ul class="space-y-2">
            <li><a href="/kennisbank/ai-agent-voorbeelden/" class="text-sm text-brand-indigo hover:underline">5 Voorbeelden van AI Agents voor Nederlandse Bedrijven →</a></li>
            <li><a href="/kennisbank/voice-ai-klantenservice/" class="text-sm text-brand-indigo hover:underline">Voice AI Agents voor Klantenservice: Werkt het Echt? →</a></li>
            <li><a href="/locaties/amsterdam/" class="text-sm text-brand-indigo hover:underline">AI Agency Amsterdam — Makelaars en Vastgoed →</a></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Locations cross-link -->
  <section class="section-tight border-t border-slate-200">
    <div class="container-page">
      <p class="eyebrow mb-3">AI voor makelaars in heel Nederland</p>
      <h2 class="text-2xl lg:text-3xl font-bold tracking-tighter-2 text-navy text-balance mb-6">
        Makelaars en vastgoedbedrijven — overal in Nederland.
      </h2>
      <p class="text-slate-600 leading-relaxed mb-6 max-w-2xl">
        Van Randstad-makelaars tot regionale vastgoedkantoren in Brabant en het Noorden: Aanloop AI
        bedient makelaars en projectontwikkelaars in heel Nederland.
      </p>
      <div class="flex flex-wrap gap-2">
        <a href="/locaties/amsterdam/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-slate-50 hover:bg-slate-100 border border-slate-200 hover:border-slate-300 rounded-lg text-xs font-medium text-navy transition-all">AI makelaar Amsterdam →</a>
        <a href="/locaties/rotterdam/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-slate-50 hover:bg-slate-100 border border-slate-200 hover:border-slate-300 rounded-lg text-xs font-medium text-navy transition-all">AI makelaar Rotterdam →</a>
        <a href="/locaties/den-haag/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-slate-50 hover:bg-slate-100 border border-slate-200 hover:border-slate-300 rounded-lg text-xs font-medium text-navy transition-all">AI makelaar Den Haag →</a>
        <a href="/locaties/utrecht/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-slate-50 hover:bg-slate-100 border border-slate-200 hover:border-slate-300 rounded-lg text-xs font-medium text-navy transition-all">AI makelaar Utrecht →</a>
        <a href="/locaties/eindhoven/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-slate-50 hover:bg-slate-100 border border-slate-200 hover:border-slate-300 rounded-lg text-xs font-medium text-navy transition-all">AI makelaar Eindhoven →</a>
        <a href="/locaties/breda/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-slate-50 hover:bg-slate-100 border border-slate-200 hover:border-slate-300 rounded-lg text-xs font-medium text-navy transition-all">AI makelaar Breda →</a>
        <a href="/locaties/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-brand-indigo/5 hover:bg-brand-indigo/10 border border-brand-indigo/20 rounded-lg text-xs font-medium text-brand-indigo transition-all">Alle steden →</a>
      </div>
    </div>
  </section>

  <!-- Other sectors -->
  <section class="section-tight bg-slate-50/60 border-y border-slate-200">
    <div class="container-page">
      <p class="eyebrow mb-3">Andere sectoren</p>
      <h2 class="text-2xl lg:text-3xl font-bold tracking-tighter-2 text-navy text-balance mb-6">
        Verkennen wat AI in andere branches doet.
      </h2>
      <div class="flex flex-wrap gap-2">
        <a href="/sectoren/horeca/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white hover:bg-slate-50 border border-slate-200 hover:border-navy rounded-lg text-xs font-medium text-navy transition-all">AI voor horeca →</a>
        <a href="/sectoren/accountancy/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white hover:bg-slate-50 border border-slate-200 hover:border-navy rounded-lg text-xs font-medium text-navy transition-all">AI voor accountancy →</a>
        <a href="/sectoren/ai-voor-advocaten/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white hover:bg-slate-50 border border-slate-200 hover:border-navy rounded-lg text-xs font-medium text-navy transition-all">AI voor advocaten →</a>
        <a href="/sectoren/bouw/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white hover:bg-slate-50 border border-slate-200 hover:border-navy rounded-lg text-xs font-medium text-navy transition-all">AI voor bouw →</a>
        <a href="/sectoren/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-brand-indigo/5 hover:bg-brand-indigo/10 border border-brand-indigo/20 rounded-lg text-xs font-medium text-brand-indigo transition-all">Alle sectoren →</a>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container-page max-w-3xl">
      <p class="eyebrow text-brand-indigo mb-2">Verdiepende kennisbank-gidsen</p>
      <h2 class="text-2xl lg:text-3xl font-bold text-navy mb-6">Lees verder: praktische AI-gidsen voor deze sector</h2>
      <ul class="space-y-3">
        <li><a href="/kennisbank/ai-makelaar-software/" class="flex items-center justify-between gap-4 p-4 rounded-xl bg-white border border-slate-200 hover:border-brand-indigo hover:shadow-sm transition-all"><span class="text-sm font-medium text-navy">AI makelaar software 2026</span><span class="text-xs text-brand-indigo flex-shrink-0">Lees gids →</span></a></li>
        <li><a href="/kennisbank/ai-receptionist-vs-ai-telefoniste-vergelijking/" class="flex items-center justify-between gap-4 p-4 rounded-xl bg-white border border-slate-200 hover:border-brand-indigo hover:shadow-sm transition-all"><span class="text-sm font-medium text-navy">AI receptionist vs telefoniste</span><span class="text-xs text-brand-indigo flex-shrink-0">Lees gids →</span></a></li>
        <li><a href="/kennisbank/ai-voor-hypotheekadviseur-nederland-2026/" class="flex items-center justify-between gap-4 p-4 rounded-xl bg-white border border-slate-200 hover:border-brand-indigo hover:shadow-sm transition-all"><span class="text-sm font-medium text-navy">AI voor hypotheekadviseur — woningzoekers koppelen aan hypotheek-traject</span><span class="text-xs text-brand-indigo flex-shrink-0">Lees gids →</span></a></li>
        <li><a href="/kennisbank/ai-voor-financieel-planner-nederland-2026/" class="flex items-center justify-between gap-4 p-4 rounded-xl bg-white border border-slate-200 hover:border-brand-indigo hover:shadow-sm transition-all"><span class="text-sm font-medium text-navy">AI voor financieel-planner — vermogensoverdracht en estate planning</span><span class="text-xs text-brand-indigo flex-shrink-0">Lees gids →</span></a></li>
        <li><a href="/kennisbank/ai-voor-pensioenadviseur-nederland-2026/" class="flex items-center justify-between gap-4 p-4 rounded-xl bg-white border border-slate-200 hover:border-brand-indigo hover:shadow-sm transition-all"><span class="text-sm font-medium text-navy">AI voor pensioenadviseur — vastgoed in pensioenportefeuille</span><span class="text-xs text-brand-indigo flex-shrink-0">Lees gids →</span></a></li>
      </ul>
      <div class="mt-8">
        <a href="/kennisbank/" class="text-sm text-brand-indigo hover:underline font-medium">Alle 84 kennisbank-gidsen bekijken →</a>
      </div>
    </div>
  </section>

  <section class="section bg-slate-50 border-y border-slate-200">
    <div class="container-page max-w-4xl">
      <p class="eyebrow text-brand-indigo mb-2">Website + AI = 1 partner</p>
      <h2 class="text-2xl lg:text-3xl font-bold text-navy mb-4">Makelaars-website nodig? Wij bouwen 'm AI-ready met bezichtiging-automatisering en lead-kwalificatie</h2>
      <p class="text-slate-600 mb-8 leading-relaxed">Veel makelaarskantoren hebben een website van 5+ jaar oud en koppelen apart een AI-tool voor woningzoeker-vragen. Bij Aanloop AI is dat één traject: een AI-ready makelaars-website met aanbod-feed, bezichtiging-formulieren en Marco (24/7 telefoon-AI voor woningzoekers) ingebouwd vanaf dag één.</p>
      <div class="grid md:grid-cols-3 gap-4">
        <a href="/diensten/website-laten-maken-mkb-nederland-2026/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">Makelaars-website laten maken</h3>
          <p class="text-xs text-slate-600 mb-3">Astro/Next/WordPress AI-ready. Schema.org RealEstateAgent + Speakable + WCAG 2.2 AA.</p>
          <span class="text-xs text-brand-indigo font-medium">Bekijk pakketten →</span>
        </a>
        <a href="/diensten/ai-website-bundel-mkb-nederland/" class="card hover:border-brand-indigo transition-all">
          <h3 class="font-bold text-navy text-sm mb-2">AI-Website Bundel</h3>
          <p class="text-xs text-slate-600 mb-3">Website + Marco (telefoon) + Emma (WhatsApp) in 1 pakket. Bespaart €8.014 jaar 1.</p>
