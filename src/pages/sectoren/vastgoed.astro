---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Vastgoed & makelaars · Aanloop AI" description="AI-oplossingen voor vastgoedbedrijven en makelaars: lead-kwalificatie, bezichtigingen plannen, marktrapportages genereren.">
  <section class="border-b border-slate-200 hero-gradient">
    <div class="container-page py-16 lg:py-24">
      <div class="max-w-3xl">
        <div class="flex items-center gap-4 mb-6"><div class="accent-band"><span></span><span></span><span></span><span></span></div><span class="eyebrow">Vastgoed & makelaars</span></div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tightest text-navy text-balance leading-[1.05]">AI die uw vastgoedportfolio versterkt.</h1>
        <p class="mt-6 text-lg text-slate-600 leading-relaxed max-w-2xl">Van leads kwalificeren en bezichtigingen plannen tot marktrapportages genereren en huurderscommunicatie automatiseren — AI werkt 24/7 voor uw kantoor.</p>
        <div class="mt-8 flex gap-3 flex-wrap">
          <a href="/contact/?type=demo" class="btn-primary text-base px-6 py-3.5">Boek een demo <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></a>
        </div>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container-page">
      <div class="grid lg:grid-cols-2 gap-16">
        <div class="reveal">
          <h2 class="text-2xl font-bold text-navy mb-6">Vastgoed-specifieke toepassingen</h2>
          <ul class="space-y-4">
            {['Inkomende leads kwalificeren (budget, wensen, tijdlijn)', 'Bezichtigingen plannen en bevestigen via WhatsApp', 'Vragen over woningen beantwoorden 24/7', 'Marktwaarde-schattingen genereren op basis van data', 'Huurders automatisch aanschrijven bij onderhoudsverzoeken', 'Contracten samenvatten en afwijkingen signaleren', 'Maandelijkse huurincasso-herinneringen versturen'].map(f => (
              <li class="flex items-start gap-3 text-sm text-slate-700"><svg class="w-5 h-5 mt-0.5 flex-shrink-0 text-brand-emerald" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>{f}</li>
            ))}
          </ul>
        </div>
        <div class="reveal reveal-delay-2">
          <div class="card bg-slate-50">
            <p class="eyebrow mb-3">Resultaten</p>
            <div class="space-y-4">
              {[{v:'3×', l:'meer gekwalificeerde leads'},{v:'−50%', l:'no-show bezichtigingen'},{v:'24/7', l:'beschikbaar voor geïnteresseerden'},{v:'14 dgn', l:'time-to-live'}].map(s=>(
                <div class="flex items-center justify-between py-3 border-b border-slate-200 last:border-0">
                  <span class="text-sm text-slate-600">{s.l}</span>
                  <span class="font-bold text-brand-indigo">{s.v}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <section class="section-tight bg-midnight text-pearl">
    <div class="container-page">
      <div class="max-w-2xl">
        <h2 class="text-3xl font-bold tracking-tightest text-pearl">Meer bezichtigingen, minder gemiste leads.</h2>
        <p class="mt-4 text-slate-300">Plan een gratis demo en zie hoe AI uw vastgoedkantoor versterkt.</p>
        <div class="mt-6"><a href="/contact/?type=demo" class="btn bg-pearl text-navy hover:bg-white text-base px-6 py-3.5">Boek een demo</a></div>
      </div>
    </div>
  </section>
</BaseLayout>
