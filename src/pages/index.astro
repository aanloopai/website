---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import SectorCard from '../components/SectorCard.astro';
import dashboardMockup from '../assets/images/dashboard-mockup.png';

const services = [
  { href: '/diensten/marco/', title: 'Marco — AI Sekreter', description: 'Neemt uw telefoon 24/7 aan, plant afspraken, levert leads direct in uw inbox. Vloeiend Nederlands.', badge: 'Meest gekozen', accent: 'indigo' as const, features: ['Onbeperkte gesprekken', 'Lead-routering via Telegram of e-mail', 'Live binnen 7 dagen'] },
  { href: '/diensten/emma/', title: 'Emma — WhatsApp Agent', description: 'Beantwoordt klantvragen op WhatsApp in seconden. Getraind op uw kennisbank, met menselijke handover.', accent: 'rose' as const, features: ['Eigen kennisbank (Dify)', 'Naadloze handover naar mens', 'Werkt 24/7 zonder pauze'] },
  { href: '/diensten/ai-chatbot-website/', title: 'AI Chatbot voor Website', description: 'Leads kwalificeren, vragen beantwoorden en bezoekers begeleiden naar een aankoop. 24/7 actief.', accent: 'amber' as const, features: ['Lead qualification', 'Kennisbank integratie', 'v.a. €800/maand'] },
  { href: '/diensten/ai-email-assistent/', title: 'AI E-mail Assistent', description: 'Sorteert, prioriteert en beantwoordt automatisch inkomende e-mails. Bespaar 5+ uur per week.', accent: 'emerald' as const, features: ['Gmail & Outlook', 'Auto-antwoorden', 'v.a. €600/maand'] },
  { href: '/diensten/ai-lead-qualification/', title: 'AI Lead Qualification', description: 'BANT-kwalificatie van elke inkomende aanvraag. Alleen serieuze prospects bij uw salesteam.', accent: 'indigo' as const, features: ['BANT model', 'CRM-sync', 'v.a. €1.100/maand'] },
  { href: '/diensten/ai-klantenservice-omnichannel/', title: 'AI Klantenservice Omnichannel', description: 'Eén AI voor telefoon, chat, WhatsApp én e-mail. Consistente service, 24/7, zonder extra personeel.', accent: 'rose' as const, features: ['5 kanalen tegelijk', 'Sentiment-analyse', 'v.a. €2.000/maand'] },
  { href: '/diensten/ai-document-processing/', title: 'AI Document Processing', description: 'Facturen, contracten en PDF-documenten automatisch uitlezen, categoriseren en verwerken in uw systeem.', accent: 'amber' as const, features: ['99.2% nauwkeurigheid', 'Exact, Twinfield', 'v.a. €1.200/maand'] },
  { href: '/diensten/custom/', title: 'Custom AI Workflows', description: 'Maatwerk-automatisering voor uw unieke processen — van offerte-generatie tot voorraadbeheer.', accent: 'emerald' as const, features: ['Audit + roadmap inbegrepen', 'n8n & Make.com', 'Op maat geprijsd'] },
