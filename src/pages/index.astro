<script>
  // ─── Chart.js donut ───
  let roiChart: any = null;

  async function initChart() {
    const canvas = document.getElementById('roi-donut-chart') as HTMLCanvasElement;
    if (!canvas) return;
    // Dynamically import Chart.js from CDN
    if (!(window as any).Chart) {
      await new Promise<void>((resolve, reject) => {
        const s = document.createElement('script');
        s.src = 'https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js';
        s.onload = () => resolve();
        s.onerror = reject;
        document.head.appendChild(s);
      });
    }
    const Chart = (window as any).Chart;
    const ctx = canvas.getContext('2d');
    roiChart = new Chart(ctx, {
      type: 'doughnut',
      data: {
        datasets: [{
          data: [7164, 18720],
          backgroundColor: ['#6366f1', '#f43f5e'],
          borderWidth: 0,
          hoverOffset: 4,
        }]
      },
      options: {
        cutout: '72%',
        plugins: { legend: { display: false }, tooltip: { enabled: false } },
        animation: { duration: 600 },
      }
    });
  }

  // ─── ROI Calculator ───
  const callsEl = document.getElementById('roi-calls') as HTMLInputElement;
  const hourlyEl = document.getElementById('roi-hourly') as HTMLInputElement;
  const minutesEl = document.getElementById('roi-minutes') as HTMLInputElement;
  const AI_YEARLY = 7164; // €597 * 12

  function updateROI() {
    const calls = parseInt(callsEl?.value || '20');
    const hourly = parseInt(hourlyEl?.value || '18');
    const minutes = parseInt(minutesEl?.value || '4');

    const hoursPerYear = (calls * minutes / 60) * 250;
    const humanCost = Math.round(hoursPerYear * hourly);
    const saving = humanCost - AI_YEARLY;
    const month1 = Math.round(saving / 12 - 997);
    const savingPct = humanCost > 0 ? Math.round((saving / humanCost) * 100) : 0;

    (document.getElementById('roi-calls-val') as HTMLElement).textContent = String(calls);
    (document.getElementById('roi-hourly-val') as HTMLElement).textContent = `€${hourly}`;
    (document.getElementById('roi-minutes-val') as HTMLElement).textContent = `${minutes} min`;
    (document.getElementById('roi-saving') as HTMLElement).textContent = `€${Math.max(saving, 0).toLocaleString('nl-NL')}`;
    (document.getElementById('roi-hours') as HTMLElement).textContent = `${Math.round(hoursPerYear)} u`;
    (document.getElementById('roi-month') as HTMLElement).textContent = month1 > 0 ? `+€${month1.toLocaleString('nl-NL')}` : `€${month1.toLocaleString('nl-NL')}`;

    // Update chart labels
    const humanCostEl = document.getElementById('chart-human-cost');
    const savingDisplayEl = document.getElementById('chart-saving-display');
    const chartPctEl = document.getElementById('roi-chart-pct');
    if (humanCostEl) humanCostEl.textContent = `€${humanCost.toLocaleString('nl-NL')}`;
    if (savingDisplayEl) savingDisplayEl.textContent = `€${Math.max(saving, 0).toLocaleString('nl-NL')}`;
    if (chartPctEl) chartPctEl.textContent = `${Math.max(savingPct, 0)}%`;

    // Update donut chart
    if (roiChart) {
      roiChart.data.datasets[0].data = [AI_YEARLY, Math.max(humanCost, AI_YEARLY + 1)];
      roiChart.update();
    }

    // Update slider background
    [callsEl, hourlyEl, minutesEl].forEach(el => {
      if (!el) return;
      const pct = ((parseInt(el.value) - parseInt(el.min)) / (parseInt(el.max) - parseInt(el.min))) * 100;
      el.style.setProperty('--slider-pct', `${pct}%`);
    });
  }

  [callsEl, hourlyEl, minutesEl].forEach(el => el?.addEventListener('input', updateROI));
  updateROI();
  // Init chart after paint
  requestAnimationFrame(() => initChart().then(() => updateROI()));

  // ─── Testimonials carousel ───
  let current = 0;
  const track = document.getElementById('testimonial-track') as HTMLElement;
  const dots = document.querySelectorAll('.testimonial-dot');
  const total = dots.length;

  function goTo(idx: number) {
    current = (idx + total) % total;
    if (track) track.style.transform = `translateX(-${current * 100}%)`;
    dots.forEach((d, i) => {
      d.classList.toggle('bg-navy', i === current);
      d.classList.toggle('w-6', i === current);
      d.classList.toggle('bg-slate-300', i !== current);
    });
  }

  document.getElementById('prev-testimonial')?.addEventListener('click', () => goTo(current - 1));
  document.getElementById('next-testimonial')?.addEventListener('click', () => goTo(current + 1));
  dots.forEach((d) => d.addEventListener('click', () => goTo(parseInt((d as HTMLElement).dataset.idx || '0'))));

  // Auto-advance (skip if user prefers reduced motion — WCAG 2.2.2 Pause/Stop/Hide)
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    setInterval(() => goTo(current + 1), 6000);
  }
</script>

