  { href: '/sectoren/zorg/', title: 'Zorg & Welzijn', description: 'Afsprakenbeheer, intakes, patiëntcommunicatie — NEN 7510 compliant.', icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>' },
  { href: '/sectoren/accountancy/', title: 'Accountancy & Financieel', description: 'Routinevragen, afspraken, documenten verzamelen — meer billable uren.', icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>' },
  { href: '/sectoren/bouw/', title: 'Bouw & Installatie', description: 'Offerte-aanvragen opvangen, monteurs inplannen — terwijl u op de werf staat.', icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-2 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>' },
  { href: '/sectoren/ai-voor-advocaten/', title: 'Juridisch & Advocatuur', description: 'Klantintakes, dossiervoorbereiding, contractreview en klientvragen 24/7.', icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"/></svg>' },
  { href: '/sectoren/ai-voor-zzp/', title: 'ZZP & Freelancers', description: 'Offertes sturen, facturen opvolgen, klantcommunicatie — zodat u kunt focussen.', icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>' },
  { href: '/sectoren/ai-voor-webshops/', title: 'Webshops & Online Retail', description: 'Bestelstatus, retouren, upsell aanbevelingen — Shopify & WooCommerce integratie.', icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/></svg>' },
];

const testimonials = [
  { quote: '"Marco neemt nu 70% van onze inkomende calls af, plant zelf afspraken en levert leads in ons CRM. Binnen drie weken hadden we hem live."', name: 'Installatiebedrijf · Rotterdam', role: 'Voorbeeldscenario — vergelijkbaar resultaat bij klanten' },
  { quote: '"Emma beantwoordt 80% van de WhatsApp-vragen automatisch. Onze klanttevredenheid is omhoog gegaan en ons team heeft eindelijk tijd voor écht werk."', name: 'Logistiek bedrijf · Utrecht', role: 'Voorbeeldscenario — vergelijkbaar resultaat bij klanten' },
  { quote: '"De AI-telefoonassistent heeft onze receptie volledig ontlast. Nooit meer gemiste leads buiten kantooruren. Uitstekende service van het Aanloop-team."', name: 'Makelaarskantoor · Amsterdam', role: 'Voorbeeldscenario — vergelijkbaar resultaat bij klanten' },
];

const homeSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': 'https://aanloopai.nl/#webpage',
    url: 'https://aanloopai.nl/',
    name: 'Aanloop AI — AI Bureau Nederland voor MKB',
    description: 'Aanloop AI is het AI bureau voor het Nederlandse MKB. AI-receptionist, WhatsApp-agent, workflow automatisering en custom AI agents.',
    inLanguage: 'nl-NL',
    isPartOf: { '@type': 'WebSite', '@id': 'https://aanloopai.nl/#website' },
    about: { '@type': 'Organization', '@id': 'https://aanloopai.nl/#organization' },
    primaryImageOfPage: { '@type': 'ImageObject', url: 'https://aanloopai.nl/logo-mark-light-1024.png' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': 'https://aanloopai.nl/#service-catalog',
    name: 'AI Automatisering voor Nederlandse MKB',
    serviceType: 'AI Agents, Voice AI, Workflow Automation',
    provider: { '@type': 'Organization', '@id': 'https://aanloopai.nl/#organization' },
    areaServed: { '@type': 'Country', name: 'Nederland' },
    audience: { '@type': 'BusinessAudience', audienceType: 'MKB Nederland' },
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'AI Diensten Aanloop AI',
      itemListElement: [
        { '@type': 'Offer', name: 'Starter — Marco AI Receptionist', itemOffered: { '@type': 'Service', name: 'Marco — AI Receptionist & AI Telefoniste', url: 'https://aanloopai.nl/diensten/marco/' , provider: { '@id': 'https://aanloopai.nl/#organization' }}, price: '597', priceCurrency: 'EUR', priceSpecification: { '@type': 'UnitPriceSpecification', price: '597', priceCurrency: 'EUR', billingDuration: 'P1M', unitText: 'MONTH' }, url: 'https://aanloopai.nl/tarieven/#starter', availability: 'https://schema.org/InStock' },
        { '@type': 'Offer', name: 'Groei — Marco + Emma bundel', itemOffered: { '@type': 'Service', name: 'Marco + Emma — AI Telefoon + WhatsApp', url: 'https://aanloopai.nl/diensten/marco/' , provider: { '@id': 'https://aanloopai.nl/#organization' }}, price: '1197', priceCurrency: 'EUR', priceSpecification: { '@type': 'UnitPriceSpecification', price: '1197', priceCurrency: 'EUR', billingDuration: 'P1M', unitText: 'MONTH' }, url: 'https://aanloopai.nl/tarieven/#groei', availability: 'https://schema.org/InStock' },
        { '@type': 'Offer', name: 'Partner — Custom AI Workflows op maat', itemOffered: { '@type': 'Service', name: 'Marco + Emma + Custom n8n Workflows', url: 'https://aanloopai.nl/diensten/custom/' , provider: { '@id': 'https://aanloopai.nl/#organization' }}, priceCurrency: 'EUR', priceSpecification: { '@type': 'PriceSpecification', priceCurrency: 'EUR', description: 'Op maat — offerte binnen 24 uur' }, url: 'https://aanloopai.nl/tarieven/#partner', availability: 'https://schema.org/InStock' },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'AI Strategie & Implementatie Advies', url: 'https://aanloopai.nl/gratis-ai-scan/' , provider: { '@id': 'https://aanloopai.nl/#organization' }}, price: '0', priceCurrency: 'EUR' },
      ],
    },
  },
];
---

<BaseLayout
  title="AI Bureau MKB Nederland - Receptionist, WhatsApp en Workflows"
  description="AI bureau voor Nederlands MKB: AI-receptionist (Marco), WhatsApp-agent (Emma) en custom AI-workflows. Live binnen 14 dagen, vanaf 597 euro per maand. Gratis AI-scan."
  schema={homeSchema}
>
  <Hero />

  <!-- USP pivot: Website + AI = 1 partner -->
  <section class="section bg-slate-50 border-y border-slate-200">
    <div class="container-page max-w-5xl">
      <p class="eyebrow text-brand-indigo mb-3 reveal">Website + AI = 1 partner</p>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tightest text-navy text-balance reveal reveal-delay-1">
        Eén partner voor uw website <span class="text-brand-indigo">én</span> uw AI.
      </h2>
      <p class="mt-5 text-lg text-slate-600 leading-relaxed text-pretty max-w-3xl reveal reveal-delay-2">
        De meeste MKB-bedrijven kopen hun website bij een lokaal bureau en sluiten apart een AI-leverancier aan. Resultaat: dubbele kosten, twee aanspreekpunten en integratie-gedoe. Bij Aanloop AI bouwen wij uw website AI-ready vanaf dag één — met Marco (telefoon-AI), Emma (WhatsApp-AI) en uw site in één traject. Eén partner. Eén factuur. €8.014 minder kosten in jaar 1.
      </p>

      <div class="grid md:grid-cols-3 gap-4 mt-10">
        <a href="/diensten/website-laten-maken-mkb-nederland-2026/" class="card hover:border-brand-indigo transition-all reveal">
          <p class="eyebrow text-xs mb-2">1. Website</p>
          <h3 class="font-bold text-navy text-base mb-2">AI-ready website laten maken</h3>
          <p class="text-sm text-slate-600 mb-3 leading-relaxed">Astro/Next/WordPress AI-ready vanaf €1.997 setup. Schema.org + Speakable + WCAG 2.2 AA + AVG-checks.</p>
          <span class="text-sm text-brand-indigo font-medium">Bekijk pakketten →</span>
        </a>
        <a href="/diensten/ai-website-bundel-mkb-nederland/" class="card hover:border-brand-indigo transition-all relative reveal reveal-delay-1 ring-2 ring-brand-indigo/40">
          <span class="absolute -top-3 left-4 px-3 py-1 bg-brand-indigo text-white text-xs font-bold rounded-full">Meest gekozen</span>
          <p class="eyebrow text-xs mb-2">2. Bundel</p>
          <h3 class="font-bold text-navy text-base mb-2">AI-Website Bundel</h3>
          <p class="text-sm text-slate-600 mb-3 leading-relaxed">Website + Marco (telefoon-AI) + Emma (WhatsApp-AI) in 1 pakket. €4.950 setup + €397/mnd. Bespaart €8.014 in jaar 1 t.o.v. losse leveranciers.</p>
          <span class="text-sm text-brand-indigo font-medium">Bekijk bundel →</span>
        </a>
        <a href="/kennisbank/website-bouwer-vs-ai-ready-partner-mkb-nederland-2026/" class="card hover:border-brand-indigo transition-all reveal reveal-delay-2">
          <p class="eyebrow text-xs mb-2">3. Vergelijking</p>
          <h3 class="font-bold text-navy text-base mb-2">Webbureau vs AI-ready partner</h3>
          <p class="text-sm text-slate-600 mb-3 leading-relaxed">Volledige TCO 3-jaar tabel + 8-punts checklist. Lees waarom losse leveranciers €8.014 duurder uitvallen in jaar 1.</p>
          <span class="text-sm text-brand-indigo font-medium">Lees vergelijking →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Trust bar / stats -->
  <section class="border-y border-slate-200 bg-slate-50/50">
    <div class="container-page py-10">
      <p class="text-center text-xs uppercase tracking-[0.15em] text-slate-500 mb-8">
        AI-automatisering voor het Nederlandse MKB
      </p>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        <div class="reveal">
          <div class="text-3xl font-bold text-navy" data-counter data-target="14" data-suffix=" dgn">14 dgn</div>
          <div class="text-sm text-slate-600 mt-1">gemiddelde tijd tot live</div>
        </div>
        <div class="reveal reveal-delay-1">
          <div class="text-3xl font-bold text-navy">24/7</div>
          <div class="text-sm text-slate-600 mt-1">beschikbaarheid van AI</div>
        </div>
        <div class="reveal reveal-delay-2">
          <div class="text-3xl font-bold text-navy" data-counter data-target="73" data-suffix="%">73%</div>
          <div class="text-sm text-slate-600 mt-1">minder gemiste leads</div>
        </div>
        <div class="reveal reveal-delay-3">
          <div class="text-3xl font-bold text-navy">€597</div>
          <div class="text-sm text-slate-600 mt-1">vanaf per maand</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ROI Calculator Banner -->
  <section class="bg-gradient-to-r from-brand-indigo to-blue-700 text-white py-8">
    <div class="container-page">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-4">
          <span class="text-3xl">🧮</span>
          <div>
            <p class="font-bold text-lg text-white leading-tight">Bereken wat AI uw bedrijf bespaart</p>
            <p class="text-blue-100 text-sm">Gratis ROI calculator — resultaat in 60 seconden</p>
          </div>
        </div>
        <a href="/ai-roi-calculator/" class="btn bg-white text-brand-indigo hover:bg-blue-50 text-sm px-6 py-3 whitespace-nowrap flex-shrink-0">
          ROI Calculator openen →
        </a>
      </div>
    </div>
  </section>

  <!-- Services grid -->
  <section class="section">
    <div class="container-page">
      <div class="max-w-3xl mb-14">
        <p class="eyebrow mb-3 reveal">Onze diensten</p>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tightest text-navy text-balance reveal reveal-delay-1">
          15 AI-oplossingen voor uw bedrijf.
        </h2>
        <p class="mt-5 text-lg text-slate-600 leading-relaxed text-pretty reveal reveal-delay-2">
          Begin met een kant-en-klaar product, of laat ons een maatwerk-oplossing bouwen.
          We starten altijd met een gratis adviesgesprek om te zien wat werkt voor uw situatie.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5 lg:gap-6">
        {services.map((service, i) => (
          <div class={`reveal reveal-delay-${(i % 4) + 1}`}>
            <ServiceCard {...service} />
          </div>
        ))}
      </div>
      <div class="mt-8 text-center reveal">
        <a href="/diensten/" class="btn-outline">Alle 15 diensten bekijken →</a>
      </div>
    </div>
  </section>

  <!-- Scroll-triggered mid-page CTA band -->
  <section class="bg-brand-indigo text-white py-8 reveal">
    <div class="container-page">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <p class="font-bold text-white text-lg">Klaar om uw eerste AI-assistent live te zien?</p>
          <p class="text-indigo-200 text-sm mt-0.5">Gratis demo · 30 minuten · Geen verplichtingen</p>
        </div>
        <div class="flex gap-3 flex-shrink-0">
          <a href="https://wa.me/31624741597" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-white/15 hover:bg-white/25 text-white text-sm font-medium transition-all border border-white/20">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            WhatsApp
          </a>
          <a href="/demo-aanvragen/" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-white text-brand-indigo text-sm font-bold hover:bg-indigo-50 transition-all">
            Demo boeken →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ROI Calculator -->
  <section class="section bg-slate-50/60 border-y border-slate-200">
    <div class="container-page">
      <div class="max-w-3xl mb-12 reveal">
        <p class="eyebrow mb-3">ROI calculator</p>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tightest text-navy text-balance">
          Hoeveel levert AI uw bedrijf op?
        </h2>
        <p class="mt-5 text-lg text-slate-600 leading-relaxed">
          Bereken in 30 seconden wat u bespaart met een AI-assistent.
        </p>
      </div>

      <div class="grid lg:grid-cols-2 gap-12 items-start reveal reveal-delay-1">
        <div class="card">
          <div class="space-y-8">
            <!-- Slider 1 -->
            <div>
