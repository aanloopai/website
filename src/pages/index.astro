  { href: '/sectoren/detailhandel/', title: 'Detailhandel & E-commerce', description: 'Productadvies via chat, klantenservice 24/7, retourafhandeling.', icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>' },
