---
import BaseLayout from '../layouts/BaseLayout.astro';
import EmmaLiveDemo from '../components/EmmaLiveDemo.astro';
import { Hero as AnimatedHero } from '../components/ui/animated-hero';
import MobileProof from '../components/MobileProof.astro';
import AiAdoptieCbs from '../components/AiAdoptieCbs.astro';
import { WEBSITE_BUNDEL } from '../data/pricing';
import { KERNPUNTEN, RESULTATEN, RESULTATEN_PEILDATUM } from '../data/resultaten';

const euro = (n: number) => `€${n.toLocaleString('nl-NL')}`;

// Homepage = vier diensten, tane voor tane. Alles wat hier niet staat, staat
// op /diensten/ — de homepage moet in één scroll uitleggen wát we doen.
// 2026-10-16 (owner): de site deed te weinig met wat we écht doen — websites
// met AI bouwen die klanten opleveren en die AI-assistenten noemen. De bundel
// staat daarom voorop, met gemeten bewijs (src/data/resultaten.ts) eronder.
const services = [
  {
    n: '01',
    href: '/diensten/ai-website-bundel-mkb-nederland/',
    title: 'Website met AI die klanten oplevert',
    what: 'Website, Emma als AI-receptionist, AI-vindbaarheid in ChatGPT, Gemini en Perplexity en een meetpaneel dat laat zien wat elk kanaal oplevert. Eén partner, één contract.',
    price: `${euro(WEBSITE_BUNDEL.setup)} eenmalig · ${euro(WEBSITE_BUNDEL.maand)}/mnd all-in`,
    cta: 'Bekijk de bundel',
    badge: 'Meest gekozen',
  },
  {
    n: '02',
    href: '/diensten/emma/',
    title: 'Emma — AI-receptionist',
    what: 'Neemt uw telefoon en WhatsApp 24/7 aan, plant afspraken in uw agenda en stuurt elke lead direct door. Vloeiend Nederlands — voor praktijken, salons, garages en installateurs.',
    price: 'v.a. €149/mnd · 14 dagen geld terug',
    cta: 'Bekijk Emma',
  },
  {
    n: '03',
    href: '/ai-vindbaarheid/',
    title: 'AI-vindbaarheid (GEO)',
    what: 'Uw klant vraagt het aan ChatGPT, Gemini of Perplexity en krijgt drie tot vijf namen. Wij zorgen dat uw bedrijf in dat antwoord staat — en meten elke maand of dat lukt.',
    price: 'Gratis scan · v.a. €595/mnd',
    cta: 'Bekijk AI-vindbaarheid',
  },
  {
    n: '04',
    href: '/leads-kopen/',
    title: 'Leads kopen',
    what: 'Liever direct nieuwe aanvragen? Exclusieve, gecontroleerde leads uit uw regio en branche. Betaal per lead, geen abonnement.',
    price: 'Per lead · reclamatie binnen 48 uur',
    cta: 'Bekijk branches',
    badge: 'Nieuw',
  },
];

const moreServices = [
  { href: '/diensten/audit/', label: 'AI-audit Nederland' },
  { href: '/diensten/custom/', label: 'AI-automatisering op maat' },
  { href: '/diensten/website-laten-maken-mkb-nederland-2026/', label: 'Alleen een website' },
  { href: '/diensten/ai-chatbot-website/', label: 'AI-chatbot voor uw website' },
  { href: '/diensten/ai-email-assistent/', label: 'AI e-mailassistent' },
  { href: '/diensten/ai-document-processing/', label: 'Documentverwerking' },
  { href: '/geo-bureau/', label: 'GEO-bureau (AEO)' },
  { href: '/gratis-ai-scan/', label: 'Gratis AI-scan' },
];

const werk = RESULTATEN.filter((s) => s.cijfers.length);

const steps = [
  { n: '1', title: 'Gesprek', desc: 'Gratis adviesgesprek van 30 minuten. We kijken waar AI in uw bedrijf het meeste oplevert.' },
  { n: '2', title: 'Bouwen', desc: 'We richten de AI in, trainen hem op uw kennisbank en testen samen met uw team.' },
  { n: '3', title: 'Live', desc: 'Binnen 7 werkdagen live. Daarna maandelijkse rapportage en verbeteringen.' },
];

const sectors = [
  { href: '/sectoren/horeca/', title: 'Horeca' },
  { href: '/sectoren/logistiek/', title: 'Logistiek & transport' },
  { href: '/sectoren/vastgoed/', title: 'Vastgoed & makelaars' },
  { href: '/sectoren/detailhandel/', title: 'Detailhandel & e-commerce' },
  { href: '/sectoren/zakelijk/', title: 'Zakelijke dienstverlening' },
  { href: '/sectoren/zorg/', title: 'Zorg & welzijn' },
  { href: '/sectoren/accountancy/', title: 'Accountancy & financieel' },
  { href: '/sectoren/bouw/', title: 'Bouw & installatie' },
  { href: '/sectoren/ai-voor-advocaten/', title: 'Juridisch & advocatuur' },
  { href: '/sectoren/ai-voor-zzp/', title: 'ZZP & freelancers' },
  { href: '/sectoren/ai-voor-webshops/', title: 'Webshops & online retail' },
];

const homeSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': 'https://aanloopai.nl/#webpage',
    url: 'https://aanloopai.nl/',
    name: 'Aanloop AI — websites met AI die klanten opleveren',
    description: 'Aanloop AI bouwt websites met AI voor het Nederlandse MKB: website + Emma AI-receptionist + AI-vindbaarheid in ChatGPT, Gemini en Perplexity + meetpaneel. Gemeten resultaten op /resultaten/.',
    inLanguage: 'nl-NL',
    dateModified: '2026-10-19',
    isPartOf: { '@type': 'WebSite', '@id': 'https://aanloopai.nl/#website' },
    about: { '@type': 'Organization', '@id': 'https://aanloopai.nl/#organization' },
    primaryImageOfPage: { '@type': 'ImageObject', url: 'https://aanloopai.nl/logo-mark-light-1024.png' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': 'https://aanloopai.nl/#service-catalog',
    name: 'AI Automatisering voor Nederlandse MKB',
    serviceType: 'AI Agents, Voice AI, Workflow Automation',
    provider: { '@type': 'Organization', '@id': 'https://aanloopai.nl/#organization' },
    areaServed: { '@type': 'Country', name: 'Nederland' },
    audience: { '@type': 'BusinessAudience', audienceType: 'MKB Nederland' },
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'AI Diensten Aanloop AI',
      itemListElement: [
        { '@type': 'Offer', name: 'AI-Website Bundel — website die klanten oplevert', itemOffered: { '@type': 'Service', name: 'AI-Website Bundel: website + Emma + AI-vindbaarheid + meetpaneel', url: 'https://aanloopai.nl/diensten/ai-website-bundel-mkb-nederland/', provider: { '@id': 'https://aanloopai.nl/#organization' } }, price: String(WEBSITE_BUNDEL.maand), priceCurrency: 'EUR', priceSpecification: { '@type': 'UnitPriceSpecification', price: String(WEBSITE_BUNDEL.maand), priceCurrency: 'EUR', billingDuration: 'P1M', unitText: 'MONTH' }, url: 'https://aanloopai.nl/diensten/ai-website-bundel-mkb-nederland/', availability: 'https://schema.org/InStock' },
        { '@type': 'Offer', name: 'AI-vindbaarheid (GEO) — maandelijks', itemOffered: { '@type': 'Service', name: 'AI-vindbaarheid (Generative Engine Optimization)', url: 'https://aanloopai.nl/ai-vindbaarheid/', provider: { '@id': 'https://aanloopai.nl/#organization' } }, price: '595', priceCurrency: 'EUR', priceSpecification: { '@type': 'UnitPriceSpecification', price: '595', priceCurrency: 'EUR', billingDuration: 'P1M', unitText: 'MONTH' }, url: 'https://aanloopai.nl/ai-vindbaarheid/', availability: 'https://schema.org/InStock' },
        { '@type': 'Offer', name: 'Emma Start — AI-telefoniste', itemOffered: { '@type': 'Service', name: 'Emma Start — AI Receptionist & AI Telefoniste', url: 'https://aanloopai.nl/diensten/emma/' , provider: { '@id': 'https://aanloopai.nl/#organization' }}, price: '149', priceCurrency: 'EUR', priceSpecification: { '@type': 'UnitPriceSpecification', price: '149', priceCurrency: 'EUR', billingDuration: 'P1M', unitText: 'MONTH' }, url: 'https://aanloopai.nl/tarieven/#start', availability: 'https://schema.org/InStock' },
        { '@type': 'Offer', name: 'Emma Groei — telefoon + WhatsApp', itemOffered: { '@type': 'Service', name: 'Emma Groei — AI Telefoon + WhatsApp', url: 'https://aanloopai.nl/diensten/emma/' , provider: { '@id': 'https://aanloopai.nl/#organization' }}, price: '299', priceCurrency: 'EUR', priceSpecification: { '@type': 'UnitPriceSpecification', price: '299', priceCurrency: 'EUR', billingDuration: 'P1M', unitText: 'MONTH' }, url: 'https://aanloopai.nl/tarieven/#groei', availability: 'https://schema.org/InStock' },
        { '@type': 'Offer', name: 'Emma Compleet — onbeperkt + workflows', itemOffered: { '@type': 'Service', name: 'Emma Compleet — omnichannel AI-agent', url: 'https://aanloopai.nl/diensten/emma/' , provider: { '@id': 'https://aanloopai.nl/#organization' }}, price: '497', priceCurrency: 'EUR', priceSpecification: { '@type': 'UnitPriceSpecification', price: '497', priceCurrency: 'EUR', billingDuration: 'P1M', unitText: 'MONTH' }, url: 'https://aanloopai.nl/tarieven/#compleet', availability: 'https://schema.org/InStock' },
        { '@type': 'Offer', name: 'Enterprise — Custom AI Workflows op maat', itemOffered: { '@type': 'Service', name: 'Emma + Custom n8n Workflows', url: 'https://aanloopai.nl/diensten/custom/' , provider: { '@id': 'https://aanloopai.nl/#organization' }}, priceCurrency: 'EUR', priceSpecification: { '@type': 'PriceSpecification', priceCurrency: 'EUR', description: 'Op maat — offerte binnen 24 uur' }, url: 'https://aanloopai.nl/tarieven/#partner', availability: 'https://schema.org/InStock' },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'AI Strategie & Implementatie Advies', url: 'https://aanloopai.nl/gratis-ai-scan/' , provider: { '@id': 'https://aanloopai.nl/#organization' }}, price: '0', priceCurrency: 'EUR' },
      ],
    },
  },
];
---

<BaseLayout
  title="Websites met AI die klanten opleveren — Aanloop AI"
  description="Wij bouwen websites met AI die klanten opleveren en zorgen dat ChatGPT, Gemini en Perplexity u noemen. Emma inbegrepen. Gemeten resultaten, live."
  schema={homeSchema}
>
  <!-- Hero: shadcn animated-hero (React island). Server-rendered H1 toont het
       eerste rotatiewoord al; client:idle hydrateert daarna en start de
       spring-rotatie (uit bij prefers-reduced-motion). -->
  <section class="relative isolate overflow-hidden bg-background">
    <!-- Geen container-page eromheen: het component brengt zijn eigen shadcn
         `.container` (2rem gutter, max 1400px) mee; dubbel = 56px gutter op mobiel. -->
    <div>
      <AnimatedHero
        client:idle
        lead="Wij bouwen websites met AI die"
        titles={['klanten opleveren', 'door ChatGPT genoemd worden', 'uw telefoon opnemen', 'meetbaar groeien', 'écht werken']}
        tail="— gemeten, niet beloofd."
        badge={`AI-Website Bundel: ${euro(WEBSITE_BUNDEL.setup)} eenmalig · ${euro(WEBSITE_BUNDEL.maand)}/mnd all-in`}
        badgeHref="/diensten/ai-website-bundel-mkb-nederland/"
        description="Wij bouwen websites waar AI achter draait: Emma neemt uw telefoon en WhatsApp op, de site wordt genoemd door ChatGPT, Gemini en Perplexity, en een meetpaneel laat zien welk kanaal klanten oplevert. Onze eigen bedrijven draaien erop — de cijfers staan live op deze site."
        primaryLabel="Boek een gratis demo"
        primaryHref="/demo-aanvragen/"
        secondaryLabel="Bekijk de gemeten resultaten"
        secondaryHref="/resultaten/"
        trust={['Zeven sites, één meting', 'AVG-conform · cookieloos gemeten', 'Prijzen publiek, geen verrassingen', 'Rotterdam · heel Nederland']}
      ><MobileProof visual /></AnimatedHero>
    </div>
  </section>

  <AiAdoptieCbs sector="zakelijk" />

  <!-- Diensten: vier, genummerd, één zin per dienst -->
  <section class="section bg-slate-50 border-y border-slate-200">
    <div class="container-page">
      <div class="max-w-3xl mb-12">
        <p class="eyebrow mb-3 reveal">Wat wij doen</p>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-semibold tracking-tighter text-navy text-balance reveal reveal-delay-1">
          Vier diensten. Geen ruis.
        </h2>
      </div>

      <ol class="divide-y divide-slate-200 border-y border-slate-200">
        {services.map((s, i) => (
          <li class={`reveal reveal-delay-${i + 1}`}>
            <a href={s.href} class="group grid gap-4 py-8 md:grid-cols-[4rem_1fr_auto] md:items-start md:gap-8 hover:bg-white/60 transition-colors -mx-4 px-4 rounded-xl">
              <span class="text-sm font-bold tracking-widest text-brand-indigo">{s.n}</span>
              <div>
                <div class="flex flex-wrap items-center gap-3">
                  <h3 class="text-xl sm:text-2xl font-bold text-navy group-hover:text-brand-indigo transition-colors">{s.title}</h3>
                  {s.badge && <span class="px-2.5 py-0.5 rounded-full bg-brand-indigo/10 text-brand-indigo text-xs font-semibold">{s.badge}</span>}
                </div>
                <p class="mt-2 text-base text-slate-600 leading-relaxed max-w-2xl">{s.what}</p>
                <p class="mt-3 text-sm font-medium text-slate-500">{s.price}</p>
              </div>
              <span class="text-sm font-semibold text-brand-indigo whitespace-nowrap md:pt-1">{s.cta} →</span>
            </a>
          </li>
        ))}
      </ol>

      <p class="mt-8 text-sm text-slate-500 reveal">
        Ook:
        {moreServices.map((m, i) => (
          <>
            <a href={m.href} class="text-navy font-medium underline-offset-4 hover:underline">{m.label}</a>{i < moreServices.length - 1 ? ' · ' : ''}
          </>
        ))}
        — <a href="/diensten/" class="text-brand-indigo font-semibold hover:underline underline-offset-4">alle diensten →</a>
      </p>
    </div>
  </section>

  <!-- Bewijs: gemeten resultaten van sites die wij bouwden (src/data/resultaten.ts) -->
  <section class="section" aria-labelledby="bewijs-heading">
    <div class="container-page">
      <div class="max-w-3xl mb-10">
        <p class="eyebrow mb-3 reveal">Gemeten, niet beloofd</p>
        <h2 id="bewijs-heading" class="text-3xl sm:text-4xl lg:text-5xl font-semibold tracking-tighter text-navy text-balance reveal reveal-delay-1">
          Wat onze AI-websites opleveren. Live, met de methode erbij.
        </h2>
        <p class="mt-4 text-slate-600 leading-relaxed reveal reveal-delay-2">
          Wij bouwen onze eigen bedrijven op dezelfde websites die wij voor klanten maken, en meten op al die sites hetzelfde: bezoek via ChatGPT, Perplexity en Gemini, hoe vaak dat bezoek contact opneemt vergeleken met Google-bezoek, en hoeveel aanvragen er echt in de inbox landen. Momentopname {RESULTATEN_PEILDATUM}; de tabel op /resultaten/ ververst elk uur.
        </p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-5">
        {KERNPUNTEN.map((k, i) => (
          <a href="/resultaten/" class={`card hover:border-brand-indigo transition-colors reveal reveal-delay-${i + 1}`}>
            <p class="text-3xl lg:text-4xl font-semibold tracking-tighter text-navy">{k.waarde}</p>
            <p class="mt-1 text-sm font-medium text-slate-700 leading-snug">{k.label}</p>
            <p class="mt-2 text-xs text-slate-500 leading-snug">{k.toelichting}</p>
          </a>
        ))}
      </div>
      <ul class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm reveal">
        <li class="text-slate-500">Gebouwd door ons:</li>
        {werk.map((s) => (
          <li><a href={`/werk/${s.key}/`} class="font-medium text-navy underline-offset-4 hover:underline">{s.host}</a></li>
        ))}
        <li><a href="/werk/" class="font-semibold text-brand-indigo underline-offset-4 hover:underline">alle sites →</a></li>
        <li><a href="/resultaten/" class="font-semibold text-brand-indigo underline-offset-4 hover:underline">live cijfers →</a></li>
      </ul>
    </div>
  </section>

  <!-- Live bewijs: bel Emma nu -->
  <EmmaLiveDemo />

  <!-- Werkwijze: drie stappen -->
  <section class="section">
    <div class="container-page">
      <div class="max-w-3xl mb-12">
        <p class="eyebrow mb-3 reveal">Hoe het werkt</p>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-semibold tracking-tighter text-navy text-balance reveal reveal-delay-1">
          Van gesprek tot live in 7 werkdagen.
        </h2>
      </div>
      <ol class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {steps.map((step, i) => (
          <li class={`reveal reveal-delay-${i + 1}`}>
            <span class="inline-flex w-9 h-9 items-center justify-center rounded-full bg-brand-indigo text-white text-sm font-bold">{step.n}</span>
            <h3 class="mt-4 text-lg font-bold text-navy">{step.title}</h3>
            <p class="mt-2 text-sm text-slate-600 leading-relaxed">{step.desc}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Beveiliging: eerlijk over certificering. Guard: test/beveiliging-geen-valse-certificering.test.js -->
  <section class="section-tight border-t border-slate-200" aria-labelledby="beveiliging-heading">
    <div class="container-page">
      <div class="grid gap-8 md:grid-cols-[1fr_1.4fr] md:items-start">
        <div>
          <p class="eyebrow mb-3 reveal">Beveiliging</p>
          <h2 id="beveiliging-heading" class="text-2xl sm:text-3xl font-semibold tracking-tighter text-navy text-balance reveal reveal-delay-1">
            Eerlijk over certificering.
          </h2>
          <p class="mt-3 text-sm text-slate-600 leading-relaxed reveal reveal-delay-2">
            Aanloop AI heeft zelf geen SOC 2- of ISO 27001-certificaat, en HIPAA geldt niet in Nederland. Wel draaien we op gecertificeerde infrastructuur en werken we AVG-conform.
          </p>
          <a href="/beveiliging/" class="mt-4 inline-block text-sm font-semibold text-brand-indigo hover:underline underline-offset-4 reveal reveal-delay-2">Bekijk het volledige overzicht →</a>
        </div>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 reveal reveal-delay-2">
          <li class="rounded-lg border border-slate-200 bg-white p-4 text-sm"><strong class="block text-navy">AVG-verwerkersovereenkomst</strong><span class="text-slate-600">Bij elke samenwerking, conform art. 28 AVG.</span></li>
          <li class="rounded-lg border border-slate-200 bg-white p-4 text-sm"><strong class="block text-navy">ISO 27001-gecertificeerde hosting</strong><span class="text-slate-600">Hetzner (Duitsland) en Cloudflare.</span></li>
          <li class="rounded-lg border border-slate-200 bg-white p-4 text-sm"><strong class="block text-navy">Betalingen via Mollie</strong><span class="text-slate-600">PCI DSS Level 1; wij zien geen kaartgegevens.</span></li>
          <li class="rounded-lg border border-slate-200 bg-white p-4 text-sm"><strong class="block text-navy">Openbaar sub-verwerkersregister</strong><span class="text-slate-600">Per leverancier: waarvoor, waar en welk certificaat.</span></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Sectoren: alleen namen, geen kaarten -->
  <section class="section bg-slate-50 border-y border-slate-200">
    <div class="container-page">
      <div class="max-w-3xl mb-8">
        <p class="eyebrow mb-3 reveal">Voor wie</p>
        <h2 class="text-3xl sm:text-4xl font-semibold tracking-tighter text-navy text-balance reveal reveal-delay-1">
          Ingericht per branche.
        </h2>
      </div>
      <ul class="flex flex-wrap gap-2 reveal reveal-delay-2">
        {sectors.map((s) => (
          <li>
            <a href={s.href} class="inline-block px-4 py-2 rounded-full border border-slate-200 bg-white text-sm font-medium text-navy hover:border-brand-indigo hover:text-brand-indigo transition-colors">{s.title}</a>
          </li>
        ))}
        <li>
          <a href="/sectoren/" class="inline-block px-4 py-2 rounded-full text-sm font-semibold text-brand-indigo hover:underline underline-offset-4">Alle sectoren →</a>
        </li>
      </ul>
    </div>
  </section>

  <!-- Eén afsluitende CTA -->
  <section class="section-tight bg-midnight text-pearl relative overflow-hidden" data-cta-section>
    <div class="absolute inset-0 dot-grid opacity-[0.04]"></div>
    <div class="container-page relative">
      <div class="max-w-3xl">
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-semibold tracking-tighter text-pearl text-balance reveal">
          Benieuwd wat AI voor uw bedrijf kan doen?
        </h2>
        <p class="mt-5 text-lg text-slate-300 leading-relaxed text-pretty max-w-2xl reveal reveal-delay-1">
          Plan een gratis adviesgesprek van 30 minuten, of start met de gratis AI-scan en zie in 3 minuten waar uw kansen liggen.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row gap-3 reveal reveal-delay-2">
          <a href="/demo-aanvragen/" class="btn bg-pearl text-navy hover:bg-white text-base px-6 py-3.5">
            Boek een adviesgesprek
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
          <a href="/gratis-ai-scan/" class="btn border border-slate-700 text-pearl hover:bg-slate-800 text-base px-6 py-3.5">
            Start de gratis AI-scan
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- xref-orphan-fix-2026-05-07: deze drie pagina's hebben verder weinig inkomende links -->
  <section class="border-t border-pearl/10 bg-midnight py-10" aria-labelledby="xref-orphan-heading">
    <div class="container-page">
      <h2 id="xref-orphan-heading" class="text-sm font-semibold uppercase tracking-[0.15em] text-pearl/70 mb-4">Lees ook</h2>
      <ul class="flex flex-wrap gap-x-8 gap-y-2 text-sm text-pearl/80">
        <li><a href="/kennisbank/ai-agency-kiezen-mkb-nederland-2026/" class="hover:text-pearl underline-offset-4 hover:underline">AI agency kiezen (12 criteria)</a></li>
        <li><a href="/kennisbank/ai-receptionist-kiezen-vergelijkingsgids-mkb-nederland/" class="hover:text-pearl underline-offset-4 hover:underline">AI-receptionist vergelijken</a></li>
        <li><a href="/enterprise/" class="hover:text-pearl underline-offset-4 hover:underline">AI op enterprise-schaal</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>
