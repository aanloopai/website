---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FaqSection from '../../components/FaqSection.astro';
import GeoBureauBlok from '../../components/geo/GeoBureauBlok.astro';
import { KIEZEN } from '../../data/geo-gids';

const url = 'https://aanloopai.nl/geo-bureau/kiezen/';
const faqItems = KIEZEN.faq.map((f) => ({ question: f.q, answer: f.a }));
const schema = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: KIEZEN.titel,
  description: KIEZEN.intro.slice(0, 200),
  author: { '@id': 'https://aanloopai.nl/#organization' },
  publisher: { '@type': 'Organization', name: 'Aanloop AI', url: 'https://aanloopai.nl', logo: { '@type': 'ImageObject', url: 'https://aanloopai.nl/logo-mark-light-1024.png' } },
  datePublished: '2026-10-09', dateModified: '2026-10-09', inLanguage: 'nl-NL',
  mainEntityOfPage: url, articleSection: 'GEO-bureau',
};
---
<BaseLayout
  title="GEO-bureau kiezen: waar let u op? · Aanloop AI"
  description="Zeven criteria, zes rode vlaggen en de vraag specialist of fullservice: zo kiest u een GEO-bureau voor vindbaarheid in ChatGPT, Claude en Google AI."
  schema={schema}
  faqSchema={faqItems}
>
  <section class="border-b border-slate-200 hero-gradient">
    <div class="container-page py-16 lg:py-20">
      <div class="max-w-3xl">
        <div class="flex items-center gap-4 mb-6"><div class="accent-band"><span></span><span></span><span></span><span></span></div><span class="eyebrow">GEO-bureau · Kiezen</span></div>
        <h1 class="text-4xl sm:text-5xl font-semibold tracking-tighter text-navy text-balance leading-[1.08]">{KIEZEN.titel}</h1>
        <p class="mt-6 text-lg text-slate-600 leading-relaxed" data-speakable>{KIEZEN.intro}</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page max-w-3xl mx-auto">
      <h2 class="text-2xl font-bold text-navy mb-6">Zeven criteria voor een GEO-bureau</h2>
      <div class="space-y-4 mb-12">
        {KIEZEN.criteria.map((c, i) => (
          <div class="card">
            <p class="text-xs font-semibold text-brand-indigo uppercase tracking-wide mb-1">Criterium {i + 1}</p>
            <h3 class="font-semibold text-navy mb-2">{c.titel}</h3>
            <p class="text-sm text-slate-600 leading-relaxed mb-3">{c.body}</p>
            <p class="text-sm text-navy"><span class="font-semibold">Vraag aan het bureau:</span> "{c.vraagAanBureau}"</p>
          </div>
        ))}
      </div>

      <h2 class="text-2xl font-bold text-navy mb-4">Rode vlaggen</h2>
      <ul class="list-disc pl-5 space-y-2 text-slate-700 mb-12">
        {KIEZEN.rodeVlaggen.map((r) => <li>{r}</li>)}
      </ul>

      <h2 class="text-2xl font-bold text-navy mb-4">{KIEZEN.specialistOfFullservice.vraag}</h2>
      <div class="bg-brand-indigo/5 border-l-4 border-brand-indigo rounded-r-xl p-6 mb-6">
        <p class="text-sm font-bold text-brand-indigo uppercase tracking-wide mb-2">Direct antwoord</p>
        <p class="text-slate-700 leading-relaxed">{KIEZEN.specialistOfFullservice.antwoord}</p>
      </div>
      {KIEZEN.specialistOfFullservice.alinea.map((p) => <p class="text-slate-700 leading-relaxed mb-4">{p}</p>)}

      <p class="text-sm text-slate-600 mt-8 mb-4">Wilt u bureaus naast elkaar zien? Op <a href="/geo-bureau/vergelijken/" class="underline">GEO-bureaus vergelijken</a> staat de top 10 van de onafhankelijke GEO Agency Index Nederland, met bron. Wat GEO kost leest u op <a href="/geo-bureau/wat-kost-geo/" class="underline">Wat kost GEO?</a></p>

      <FaqSection items={faqItems} bare />
    </div>
  </section>

  <GeoBureauBlok compact />
</BaseLayout>
