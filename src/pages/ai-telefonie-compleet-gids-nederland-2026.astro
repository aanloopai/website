const ttsProviders = [
  { naam: 'ElevenLabs Multilingual v2', stem: 'Zeer natuurlijk, brede stem-bibliotheek, custom voice-clone', nederlands: 'Excellent (native NL stemmen)', latency: '180-280 ms', kosten: 'Vanaf 0,18 EUR per minuut', ehv: 'EU-cluster (Frankfurt)' },
  { naam: 'OpenAI Voice (GPT-4o Realtime)', stem: 'Zeer goed, geintegreerd met LLM', nederlands: 'Goed (geaccentueerd)', latency: '300-500 ms', kosten: 'Vanaf 0,30 EUR per minuut', ehv: 'EU-region beschikbaar' },
  { naam: 'Cartesia Sonic', stem: 'Ultra-laag latency, kleinere voice-bib', nederlands: 'Acceptabel (verbetert snel)', latency: '90-150 ms', kosten: 'Vanaf 0,15 EUR per minuut', ehv: 'EU-cluster' },
  { naam: 'Azure Neural Voice', stem: 'Microsoft-kwaliteit, breed dialect-aanbod', nederlands: 'Goed (Vlaams plus Nederlands)', latency: '250-400 ms', kosten: 'Vanaf 0,12 EUR per minuut', ehv: 'Azure NL-North/EU-West' },
  { naam: 'Google Cloud Text-to-Speech', stem: 'Polyglot, redelijk natuurlijk', nederlands: 'Redelijk (mechanisch op nuance)', latency: '300-450 ms', kosten: 'Vanaf 0,10 EUR per minuut', ehv: 'EU-region beschikbaar' },
  { naam: 'Coqui XTTS open-source', stem: 'Self-hosted optie', nederlands: 'Zwak voor Nederlands', latency: '500-800 ms (afh. server)', kosten: 'Compute-kosten alleen', ehv: 'Volledig EU self-host' },
];

const sipProviders = [
  { naam: 'Twilio Voice', focus: 'Marktleider, brede globale dekking', voordelen: 'Stabiel, goed gedocumenteerd, Programmable Voice SDK', nadelen: 'Duurder voor NL-nummers; data via VS tenzij EDGE-locatie EU' },
  { naam: 'Vonage (Nexmo)', focus: 'Sterk in EU, native NL-presence', voordelen: 'EU-data-residency, goede NL-quality, lokale kost-structuur', nadelen: 'Minder community-content versus Twilio' },
  { naam: 'Retell AI', focus: 'AI-native voice infrastructuur', voordelen: 'Ingebouwde latency-optimalisatie, barge-in, interruption-handling', nadelen: 'Jonger platform; minder volwassen ops-tooling' },
  { naam: 'Telnyx', focus: 'EU-eigen netwerk, ontwikkelaar-georienteerd', voordelen: 'Lage latency in EU, transparant tariefmodel, MRC-vrij', nadelen: 'Setup vereist meer technische kennis' },
  { naam: 'Plivo', focus: 'Concurrent met Twilio, lager kostenmodel', voordelen: 'Goed voor hoog-volume use-cases', nadelen: 'Minder advanced features dan Twilio' },
  { naam: 'KPN Smart Voice', focus: 'Nederlandse incumbent, traditionele PBX', voordelen: 'Bestaande NL-business-relatie, BHV-grade SLAs', nadelen: 'Niet AI-native; moeilijk te koppelen aan moderne LLM-stack' },
];

const latencyBudget = [
  { component: 'Audio capture en VAD (Voice Activity Detection)', tijd: '20-50 ms', uitleg: 'Microfoon-input plus pakkering naar SIP-trunk; VAD bepaalt einde van klantzin' },
  { component: 'ASR (Whisper-large of equivalent) streaming', tijd: '150-300 ms', uitleg: 'Speech-to-text; streaming-modus levert eerste tokens binnen 150 ms' },
  { component: 'LLM-inferentie (GPT-4o, Mistral Large of Claude)', tijd: '300-800 ms', uitleg: 'First-token-time; streaming start zodra eerste tokens er zijn' },
  { component: 'Tool-call (database, agenda, EPD-koppeling)', tijd: '100-400 ms', uitleg: 'Optioneel; alleen als AI externe data nodig heeft (orderstatus, agenda-slot)' },
  { component: 'TTS-generatie streaming', tijd: '90-280 ms', uitleg: 'Text-to-speech; ElevenLabs en Cartesia leveren eerste audio-bytes binnen 100-150 ms' },
  { component: 'Audio-uitlevering naar SIP-trunk', tijd: '20-50 ms', uitleg: 'Encoding naar G.711 of Opus, doorgifte naar telefoonnetwerk' },
  { component: 'TOTAAL eerste-respons (best case)', tijd: '680-1880 ms', uitleg: 'Onder 1 seconde voor barge-in; onder 2 seconden voor natuurlijke conversatie' },
];

const ivrVergelijking = [
  { aspect: 'Klant-routering', klassiek: 'Druk 1 voor verkoop, druk 2 voor service (DTMF-tonen)', ai: 'Vrije spraak: vertel waar u over belt — AI begrijpt context' },
  { aspect: 'Doorvoertijd tot juiste persoon', klassiek: '60-180 seconden door menu-bomen', ai: '8-25 seconden door direct begrip' },
  { aspect: 'Klanttevredenheid', klassiek: '3,2-3,8 op 5 (frustratie met menu)', ai: '4,1-4,5 op 5 (natuurlijk gevoel)' },
  { aspect: '24/7 bereikbaarheid buiten kantooruren', klassiek: 'Voicemail of hangtone', ai: 'Volledige eerstelijns afhandeling plus terugbel-afspraak' },
  { aspect: 'Schaalbaarheid bij piekmomenten', klassiek: 'Wachtrijen tot 10-20 minuten', ai: 'Onbeperkt parallel; geen wachttijd' },
  { aspect: 'Maandkosten klassiek IVR-systeem', klassiek: 'KPN of Belsimpel: 200-800 EUR per maand plus per-minuut kosten', ai: 'Aanloop AI: vanaf €597 per maand (Starter-pakket) all-in' },
  { aspect: 'Updates of script-wijzigingen', klassiek: 'Service-tickets, doorlooptijd 5-15 dagen', ai: 'Self-service prompt-aanpassing, doorlooptijd minuten' },
];

const dialecten = [
  { regio: 'Randstadse standaard-Nederlands', kwaliteit: 'Excellent — primaire training-data', notities: 'Best ondersteund; uitgangspunt voor alle providers' },
  { regio: 'Brabants accent', kwaliteit: 'Goed — herkenning 95-97 procent', notities: 'Whisper-large plus ElevenLabs hanteert dit goed; soms verwarring met diftongen' },
  { regio: 'Limburgs accent en dialect', kwaliteit: 'Acceptabel — herkenning 88-93 procent', notities: 'Sterke dialectvormen geven uitdaging; we adviseren bij volledig dialect een terugbel-flow' },
  { regio: 'Fries en Gronings', kwaliteit: 'Wisselend — herkenning 80-92 procent', notities: 'Fries als aparte taal; beste aanpak: AI vraagt of gesprek in NL of Fries voortgezet wordt' },
  { regio: 'Vlaams (Belgische klanten)', kwaliteit: 'Goed — Azure heeft native Vlaamse stem', notities: 'Voor NL-shops met BE-klanten: Azure of mengmodel werkt het beste' },
  { regio: 'Surinaams-Nederlands', kwaliteit: 'Goed — herkenning 92-96 procent', notities: 'Uitgesproken accent maar consistente fonetische structuur; goed te trainen' },
  { regio: 'Marokkaans-Nederlands', kwaliteit: 'Goed — herkenning 91-95 procent', notities: 'Multi-generationale variatie; nieuwe generatie standaarder' },
];

const useCases = [
  { title: '24/7 AI-receptionist huisartsenpraktijk', body: 'Triage volgens NHG-protocol, doorschakelen naar HAP buiten kantooruren, herhaalrecepten via spraak. Latency onder 1.2 seconden voor natuurlijke flow.', link: '/kennisbank/ai-voor-huisartsenpraktijk/' },
  { title: 'Spoedlijn dierenarts buiten praktijktijd', body: 'AI scant op spoed-trefwoorden, classificeert urgentie, schakelt direct door naar dienstdoende of bij levensgevaar 112-instructie. SIP via Vonage EU.', link: '/kennisbank/ai-voor-dierenarts-spoedlijn-triage-nederland/' },
  { title: '24/7 uitvaarttelefoon', body: 'Bij overlijden bereikbaar zijn is essentieel. AI vangt eerste contact op, registreert basisgegevens, plant terugbel met uitvaartondernemer binnen 1 uur.', link: '/kennisbank/ai-voor-uitvaartondernemer-24-7-telefoon-nederland/' },
  { title: 'Outbound sales-kwalificatie', body: 'AI belt warme leads (form-fill, demo-aanvraag), kwalificeert (BANT), boekt indien geschikt direct in agenda van accountmanager. 50-70 procent meer afspraken per AE.', link: '/diensten/marco/' },
  { title: 'After-hours klantenservice e-commerce', body: 'Buiten 17:00 vangt AI inkomende vragen op: orderstatus, retour, klacht. Volledige afhandeling 70-85 procent; rest gaat naar mens met context.', link: '/kennisbank/ai-voor-detailhandel-klantcontact-voorraad/' },
  { title: 'Restaurant-reserveringen', body: 'AI neemt op binnen 2 seconden, controleert beschikbaarheid in OpenTable of Resengo, bevestigt reservering, stuurt SMS-confirmatie. Gemist: 0 procent.', link: '/kennisbank/ai-voor-restaurant-nederland/' },
];

const faqItems = [
  { question: 'Welke voice-AI provider is het beste voor Nederlands?', answer: 'Voor pure stemkwaliteit en natuurlijkheid: ElevenLabs Multilingual v2 met een Nederlandse stem (custom-clone of native). Voor laagste latency (onder 150 ms TTS): Cartesia Sonic, met de kanttekening dat de NL-stem nog verfijnd wordt. Voor multi-talige enterprise (NL plus EN plus DE plus FR): Azure Neural Voice. Voor een geintegreerde stack waar LLM en stem in 1 model zitten: OpenAI GPT-4o Realtime, met iets hogere latency.' },
  { question: 'Wat is het verschil tussen ElevenLabs en OpenAI Voice?', answer: 'ElevenLabs is gespecialiseerd in TTS (text-to-speech) met de breedste stem-bibliotheek en de beste custom-voice-clone-technologie. Combineer met externe LLM (GPT-4, Claude, Mistral). OpenAI GPT-4o Realtime combineert ASR plus LLM plus TTS in 1 model: lagere coordinatie-overhead, simpeler architectuur, maar minder controle over individuele stappen plus iets hogere latency op TTS-deel. Aanloop AI gebruikt voornamelijk ElevenLabs vanwege NL-stem-kwaliteit.' },
  { question: 'Welke SIP-trunk provider werkt het beste voor Nederlandse telefoonnummers?', answer: 'Voor productie-stabiliteit en EU-data-residency: Vonage (sterke NL-presence) of Telnyx (eigen EU-netwerk). Voor maximale flexibiliteit en SDK-rijkdom: Twilio mits met EU-EDGE-locatie geconfigureerd. Voor AI-native voice met ingebouwde barge-in en interruption-handling: Retell AI. Voor zeer hoog volume (10.000+ minuten per maand): Plivo of directe SIP via een Nederlandse VoIP-leverancier zoals RoutIT of Solcon.' },
  { question: 'Wat is een acceptabele latency voor AI-telefonie?', answer: 'Onder 1 seconde tussen einde-klant-zin en begin AI-antwoord voelt natuurlijk. Tussen 1 en 1,5 seconden merkbaar maar acceptabel. Boven 2 seconden voelt vertraagd en breekt natuurlijke flow. In productie streven we 1100-1400 ms na (gemeten als first-audio-out na end-of-utterance). Voor barge-in (klant onderbreekt AI) is 200-400 ms detection-tijd noodzakelijk.' },
  { question: 'Werkt AI-telefonie met regionale dialecten en accenten?', answer: 'Ja, voor de meest gebruikte Nederlandse accenten (Brabants, Limburgs accent, Surinaams-Nederlands, Marokkaans-Nederlands, Vlaams) ligt de woord-herkenning op 91-97 procent met Whisper-large. Voor sterke dialectvormen (volledig Limburgs dialect, Fries) adviseren we een terugbel-flow waarbij AI vraagt of het gesprek in standaard-Nederlands voortgezet kan worden, of routeert naar menselijke medewerker.' },
  { question: 'Hoeveel kost AI-telefonie per minuut?', answer: 'Total-cost-per-minute (TCPM) voor productie-quality NL-AI-telefonie ligt tussen 0,28-0,55 euro per minuut, opgebouwd uit: SIP-trunk (0,03-0,08 EUR), ASR (0,03-0,08 EUR), LLM-inferentie (0,05-0,15 EUR), TTS (0,12-0,25 EUR). Daarbovenop maandelijkse infra-kosten 50-200 EUR per nummer. Aanloop AI biedt all-in pakketten vanaf €597 per maand (Starter-pakket) met 500 inbound-minuten inclusief.' },
  { question: 'Hoe werkt barge-in en interruption-handling?', answer: 'Barge-in betekent dat een klant de AI mag onderbreken zonder dat het gesprek mislukt. Implementatie: continue VAD op input-stream tijdens AI-spreken, na 250-400 ms aanhoudend spraak-signaal stopt AI direct, ASR pakt klant-zin op, LLM krijgt context dat AI onderbroken werd plus de oorspronkelijke onafgemaakte boodschap. Retell heeft dit native; bij ElevenLabs plus eigen orchestratie (zoals Aanloop AI gebruikt) bouwen we deze laag zelf.' },
  { question: 'Is AI-telefonie AVG-compliant voor zorg-praktijken?', answer: 'Ja, mits goed geconfigureerd. EU-only stack: Vonage of Telnyx EU voor SIP, ElevenLabs EU-cluster voor TTS, Mistral Large via Azure EU-West voor LLM, Hetzner of OVHcloud EU voor app-hosting. Verplicht: DPA met elke sub-verwerker, DPIA voor zorg-toepassingen, NEN 7510-bewijsstuk (zie nen.nl/nen-7510). Aanloop AI levert dit standaard. Geen data-export buiten EER. Bewaartermijn telefoongesprekken 90 dagen, transcripten 12 maanden. Toezichthouders: Autoriteit Persoonsgegevens (autoriteitpersoonsgegevens.nl) plus Rijksinspectie Digitale Infrastructuur (rdi.nl).' },
  { question: 'Hoe verhoudt AI-telefonie zich tot een klassieke IVR (KPN, Belsimpel, etc)?', answer: 'Klassieke IVR-systemen werken met DTMF-tonen (druk 1 voor X, druk 2 voor Y) en starre menu-bomen. AI-telefonie werkt met natuurlijke spraak en context-begrip. Voor klant: doorvoertijd tot juiste afhandeling daalt 60-80 procent, klanttevredenheid stijgt 0,5-1,2 punten op 5-schaal. Voor bedrijf: maandkosten typisch lager (Aanloop vanaf €597 per maand all-in versus klassiek IVR 200-800 EUR), updates self-service in plaats van service-tickets bij telefonie-leverancier.' },
  { question: 'Kan AI-telefonie sentiment detecteren tijdens een gesprek?', answer: 'Ja. Real-time sentiment-detectie werkt op twee assen: prosodisch (toonhoogte, snelheid, pauzes) en semantisch (woordkeuze, intentie). Bij detectie van frustratie of woede schakelt AI direct over op de-escalatie-prompt en escaleert tegelijkertijd naar mens. Voor zorg: detectie van crisis-signalen (suicidaliteit, zelfbeschadiging) escaleert direct naar BIG-geregistreerd zorgverlener of bij levensgevaar 113.' },
  { question: 'Hoe lang duurt setup voor een AI-telefoonnummer in Nederland?', answer: 'Bestaand Nederlands nummer porteren naar Vonage of Telnyx: 5-15 werkdagen (afhankelijk van vorige operator). Nieuw nummer aanvragen: 1-3 werkdagen. AI-laag configuratie (prompt, integraties, escalatie-flows): 5-10 werkdagen. Pilot live op tweede nummer (parallel): typisch binnen 7-10 werkdagen. Volledige overgang van bestaande lijn: na 4-6 weken inclusief monitoring en finetuning.' },
  { question: 'Wat als de internetverbinding van de praktijk uitvalt?', answer: 'AI-telefonie draait op cloud-infrastructuur, niet op de praktijk-locatie. Internet-uitval bij de praktijk heeft geen invloed op AI-bereikbaarheid. Bij doorschakeling naar mens (medewerker, dienstdoende arts) kan AI alternatieven suggereren: SMS terugbelverzoek, callback-afspraak, of bij spoed direct 112-instructie. Voor mission-critical zorg-AI biedt Aanloop een redundant SIP-trunk via twee verschillende providers met automatische failover.' },
];

