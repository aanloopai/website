  { url: '/vergelijk/marco-vs-voiceflow/', tekst: 'Marco versus Voiceflow — voice-AI vergelijking' },
  { url: '/vergelijk/marco-vs-make-com-voice/', tekst: 'Marco versus Make.com Voice — vergelijking' },
