---
// Customer portal — checkout return page. Mollie redirects here after payment.
// The redirect carries no status, so we poll the order status (the webhook
// flips it to 'ingediend' once payment is confirmed).
//
// Vanuit de bevestigingsmail van een voorstel (taak 11) landt de klant hier
// mét ?autostart=1: de order bestaat al (status 'concept', intake al gevuld
// vanuit het voorstel) maar er is nog nooit een Mollie-checkout gestart. In
// dat geval start deze pagina de checkout zelf, in plaats van de klant een
// knop te laten zoeken die hier niet bestaat.
import PortalLayout from '../../layouts/PortalLayout.astro';
---

<PortalLayout title="Betaling" active="ontdekken">
  <div class="mx-auto max-w-md">
    <div class="pcard">
      <div class="pcard-b text-center" style="padding:40px 24px">
        <div id="co-pending">
          <div class="pskel mx-auto h-12 w-12 rounded-full"></div>
          <h1 class="page-title mt-4">Betaling bevestigen…</h1>
          <p class="page-sub mt-1">Een moment — we controleren uw betaling.</p>
        </div>
        <div id="co-starting" class="hidden">
          <div class="pskel mx-auto h-12 w-12 rounded-full"></div>
          <h1 class="page-title mt-4">Betaalpagina openen…</h1>
          <p class="page-sub mt-1">Een moment — we sturen u door naar Mollie.</p>
        </div>
        <div id="co-ok" class="hidden">
          <svg style="width:48px;height:48px;margin:0 auto;color:#1a7f53" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <h1 class="page-title mt-4">Betaling geslaagd</h1>
          <p class="page-sub mx-auto mt-1" style="max-width:24rem">
            Bedankt! Uw abonnement is actief en wij starten direct met de inrichting van uw dienst.
          </p>
          <a href="/portal/diensten" class="pbtn pbtn--primary mt-5">Naar mijn diensten</a>
        </div>
        <div id="co-wait" class="hidden">
          <h1 class="page-title">Betaling in verwerking</h1>
          <p class="page-sub mx-auto mt-1" style="max-width:24rem">
            Uw betaling wordt nog verwerkt. Dit kan enkele minuten duren — u ontvangt een
            bevestiging per e-mail. U kunt deze pagina sluiten.
          </p>
          <a href="/portal/diensten" class="pbtn pbtn--subtle mt-5">Naar mijn diensten</a>
        </div>
        <div id="co-error" class="hidden">
          <h1 class="page-title">Betaling starten lukte niet</h1>
          <p class="page-sub mx-auto mt-1" style="max-width:24rem" id="co-error-msg">
            We konden de betaalpagina niet openen.
          </p>
          <div class="mt-5 flex items-center justify-center gap-3">
            <button id="co-retry" class="pbtn pbtn--primary">Opnieuw proberen</button>
            <a href="/portal/diensten" class="pbtn pbtn--subtle">Naar mijn diensten</a>
          </div>
        </div>
        <!-- Prijs is gewijzigd sinds het voorstel (H3) — nooit automatisch
             doorsturen tegen een ander bedrag dan de klant heeft gezien. -->
        <div id="co-price-changed" class="hidden">
          <h1 class="page-title">De prijs is gewijzigd</h1>
          <p class="page-sub mx-auto mt-1" style="max-width:24rem">
            Sinds uw voorstel is het tarief aangepast. Bevestig het nieuwe bedrag om verder te gaan — er wordt niets afgeschreven zonder uw akkoord.
          </p>
          <p class="mt-4 text-lg font-bold text-navy" id="co-price-new"></p>
          <div class="mt-5 flex items-center justify-center gap-3">
            <button id="co-price-confirm" class="pbtn pbtn--primary">Akkoord, ga door</button>
            <a href="/portal/diensten" class="pbtn pbtn--subtle">Naar mijn diensten</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    (function () {
      var orderId = new URLSearchParams(location.search).get('order');
      if (!orderId) { location.href = '/portal/diensten'; return; }
      var autostart = new URLSearchParams(location.search).get('autostart') === '1';
      var tries = 0;
      // Zodra de poll ziet dat de order niet meer 'concept' is (betaling is
      // ergens onderweg of al verwerkt), mag een trage/mislukte checkout-start
      // geen foutmelding meer over dat resultaat heen tekenen.
      var resolved = false;
      // Zolang een checkout-start-poging loopt (starting) mag de poll niet
      // opgeven en "u kunt deze pagina sluiten" tonen — dat zou een betaling
      // beloven die er nog niet is. Faalt de poging, dan is #co-error (met
      // retry-knop) de juiste eindstatus, niet co-wait: er bestaat dan geen
      // betaling om op te wachten, dus de poll geeft die status niet meer af.
      var starting = false;
      var autostartFailed = false;

      var panels = ['co-pending', 'co-starting', 'co-ok', 'co-wait', 'co-error', 'co-price-changed'];
      function showPanel(id) {
        panels.forEach(function (p) {
          document.getElementById(p).classList.toggle('hidden', p !== id);
        });
      }

      function check() {
        fetch('/api/portal/order?id=' + encodeURIComponent(orderId), { credentials: 'same-origin' })
          .then(function (r) { if (r.status === 401) { location.href = '/portal/login'; throw 0; } return r.json(); })
          .then(function (d) {
            var status = d.ok && d.order ? d.order.status : '';
            if (status && status !== 'concept') {
              resolved = true;
              showPanel('co-ok');
              return;
            }
            if (starting) {
              // Checkout-start onderweg — nog geen oordeel, gewoon blijven kijken.
              setTimeout(check, 3000);
              return;
            }
            if (autostartFailed) {
              // Er bestaat geen betaling (de poging is al mislukt, klant ziet
              // #co-error met een retry-knop) — niets meer te pollen.
              return;
            }
            tries++;
            if (tries >= 5) {
              resolved = true;
              showPanel('co-wait');
              return;
            }
            setTimeout(check, 3000);
          })
          .catch(function () {});
      }
      check();

      // ── Checkout automatisch starten (autostart=1) ────────────────────
      var FETCH_TIMEOUT_MS = 30000; // zelfde timeoutwaarde als elders (start.astro, start/voorstel)

      function euro(cent) {
        return '€' + Math.round(cent / 100).toLocaleString('nl-NL');
      }

      // confirmPrice: de klant heeft het nieuwe bedrag op #co-price-changed
      // gezien en expliciet akkoord gegeven — pas dan mag deze aanroep de
      // (afwijkende) prijs van de order accepteren (H3: nooit automatisch
      // doorsturen tegen een ander bedrag dan wat op het voorstel stond).
      function startCheckout(confirmPrice) {
        if (starting || resolved) return; // dubbele start voorkomen + race met een al-opgeloste poll
        starting = true;
        autostartFailed = false; // nieuwe poging — de vorige mislukking is niet meer het laatste woord
        showPanel('co-starting');
        document.getElementById('co-retry').disabled = true;

        var ctrl = new AbortController();
        var tid = setTimeout(function () { ctrl.abort(); }, FETCH_TIMEOUT_MS);

        fetch('/api/portal/checkout/start', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ order_id: orderId, confirm_price: confirmPrice === true }),
          signal: ctrl.signal,
        })
          .then(function (r) {
            clearTimeout(tid);
            if (r.status === 401) { location.href = '/portal/login'; throw 0; }
            return r.json().then(function (j) { return { ok: r.ok, j: j }; });
          })
          .then(function (res) {
            starting = false;
            // Poll won de race (order is intussen al bevestigd elders) — een
            // late uitkomst van deze aanroep, geslaagd of niet, mag het
            // successcherm niet meer overschrijven of alsnog doorsturen.
            if (resolved) return;
            if (res.ok && res.j && res.j.checkoutUrl) {
              location.href = res.j.checkoutUrl;
              return;
            }
            if (res.j && res.j.priceChanged) {
              autostartFailed = true;
              var j = res.j;
              var tekst = euro(j.nieuwMaandInclCent) + ' per maand incl. btw'
                + (j.nieuwSetupInclCent > 0 ? ' + ' + euro(j.nieuwSetupInclCent) + ' eenmalige inrichting incl. btw' : '');
              document.getElementById('co-price-new').textContent = tekst;
              showPanel('co-price-changed');
              return;
            }
            var msg = (res.j && res.j.error) || 'We konden de betaalpagina niet openen.';
            document.getElementById('co-error-msg').textContent = msg;
            document.getElementById('co-retry').disabled = false;
            autostartFailed = true;
            showPanel('co-error');
          })
          .catch(function (err) {
            clearTimeout(tid);
            starting = false;
            if (err === 0 || resolved) return; // 401-redirect al onderweg, of poll won de race
            var timeout = err && err.name === 'AbortError';
            document.getElementById('co-error-msg').textContent = timeout
              ? 'Het duurt te lang om de betaalpagina te openen. Probeer het opnieuw.'
              : 'Netwerkfout — probeer het opnieuw of neem contact op met support.';
            document.getElementById('co-retry').disabled = false;
            autostartFailed = true;
            showPanel('co-error');
          });
      }

      document.getElementById('co-retry').addEventListener('click', function () { startCheckout(false); });
      document.getElementById('co-price-confirm').addEventListener('click', function () { startCheckout(true); });

      // Kom je hier via de bevestigingsmail van een voorstel, dan is de keuze al
      // gemaakt — direct doorsturen naar Mollie in plaats van opnieuw laten klikken.
      // (confirm_price staat bewust op false: bij een prijswijziging moet de
      // klant het nieuwe bedrag altijd eerst zien, ook via autostart.)
      if (autostart) startCheckout(false);
    })();
  </script>
</PortalLayout>
