---
// Customer portal — Facturatie. Data: /api/portal/invoices.
import PortalLayout from '../../layouts/PortalLayout.astro';
---

<PortalLayout title="Facturatie" active="facturatie">
  <h1 class="text-2xl font-bold text-slate-900">Facturatie</h1>
  <p class="mt-1 text-sm text-slate-600">Uw facturen en betaalstatus.</p>

  <div id="f-loading" class="mt-6 text-sm text-slate-400">Bezig met laden...</div>

  <div id="f-content" class="hidden mt-6">
    <div class="grid gap-4 sm:grid-cols-2">
      <div class="rounded-xl border border-slate-200 bg-white p-4">
        <p class="text-xs uppercase tracking-wide text-slate-400">Openstaand</p>
        <p class="mt-1 text-2xl font-bold text-slate-900" id="f-open">—</p>
      </div>
      <div class="rounded-xl border border-slate-200 bg-white p-4">
        <p class="text-xs uppercase tracking-wide text-slate-400">Aantal facturen</p>
        <p class="mt-1 text-2xl font-bold text-slate-900" id="f-count">0</p>
      </div>
    </div>

    <div class="mt-6 overflow-hidden rounded-xl border border-slate-200 bg-white">
      <table class="w-full text-sm">
        <thead class="bg-slate-50 text-left text-xs uppercase tracking-wide text-slate-400">
          <tr>
            <th class="px-4 py-3">Periode</th>
            <th class="px-4 py-3">Bedrag</th>
            <th class="px-4 py-3">Status</th>
            <th class="px-4 py-3 text-right">Factuur</th>
          </tr>
        </thead>
        <tbody id="f-rows" class="divide-y divide-slate-100"></tbody>
      </table>
    </div>
    <p id="f-empty" class="mt-3 hidden text-sm text-slate-400">Nog geen facturen.</p>
    <p class="mt-4 text-xs text-slate-400">
      Vragen over een factuur? Stel ze via <a href="/portal/support" class="text-brand-indigo underline">Support</a>.
    </p>
  </div>

  <script is:inline>
    (function () {
      function esc(s) {
        return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
        });
      }
      function euro(cent) {
        return (Number(cent || 0) / 100).toLocaleString('nl-NL', { style: 'currency', currency: 'EUR' });
      }
      fetch('/api/portal/invoices', { credentials: 'same-origin' })
        .then(function (r) { if (r.status === 401) { location.href = '/portal/login'; throw 0; } return r.json(); })
        .then(function (d) {
          document.getElementById('f-loading').classList.add('hidden');
          document.getElementById('f-content').classList.remove('hidden');
          var list = d.invoices || [];
          document.getElementById('f-count').textContent = list.length;
          var openCent = list.filter(function (i) { return i.status === 'open'; })
            .reduce(function (a, i) { return a + Number(i.bedrag_cent || 0); }, 0);
          document.getElementById('f-open').textContent = euro(openCent);

          if (!list.length) { document.getElementById('f-empty').classList.remove('hidden'); return; }
          document.getElementById('f-rows').innerHTML = list.map(function (i) {
            var badge = i.status === 'betaald'
              ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800';
            var pdf = (i.pdf_url && /^https?:\/\//i.test(i.pdf_url))
              ? '<a href="' + esc(i.pdf_url) + '" target="_blank" rel="noopener" class="font-medium text-brand-indigo underline">PDF</a>'
              : '<span class="text-slate-400">—</span>';
            return '<tr>' +
              '<td class="px-4 py-3 text-slate-800">' + esc(i.periode) + '</td>' +
              '<td class="px-4 py-3 font-medium text-slate-900">' + euro(i.bedrag_cent) + '</td>' +
              '<td class="px-4 py-3"><span class="rounded-full px-2 py-0.5 text-xs font-medium ' + badge + '">' + esc(i.status) + '</span></td>' +
              '<td class="px-4 py-3 text-right">' + pdf + '</td>' +
              '</tr>';
          }).join('');
        })
        .catch(function () {});
    })();
  </script>
</PortalLayout>
