---
// Customer portal — Facturatie. Data: /api/portal/invoices.
import PortalLayout from '../../layouts/PortalLayout.astro';
---

<PortalLayout title="Facturatie" active="facturatie">
  <h1 class="page-title">Facturatie</h1>
  <p class="page-sub">Uw facturen en betaalstatus.</p>

  <div class="mt-6 grid gap-4 sm:grid-cols-2">
    <div class="kpi"><div class="kpi-label">Openstaand</div><div class="kpi-value" id="f-open"><span class="pskel inline-block h-7 w-20"></span></div></div>
    <div class="kpi"><div class="kpi-label">Aantal facturen</div><div class="kpi-value" id="f-count"><span class="pskel inline-block h-7 w-10"></span></div></div>
  </div>

  <section class="pcard mt-6">
    <div class="pcard-h">Facturen</div>
    <div id="f-filterbar" class="hidden" style="display:flex;gap:.5rem;padding:.75rem 1rem;border-bottom:1px solid var(--p-border)">
      <button type="button" class="pbtn pbtn--sm pbtn--primary" data-filter="alle">Alle</button>
      <button type="button" class="pbtn pbtn--sm pbtn--subtle" data-filter="open">Openstaand</button>
      <button type="button" class="pbtn pbtn--sm pbtn--subtle" data-filter="betaald">Betaald</button>
    </div>
    <div id="f-tablewrap" class="hidden">
      <table class="ptable">
        <thead><tr>
          <th>Factuurnr.</th><th>Periode</th><th class="num">Bedrag</th><th>Status</th><th>Factuur</th>
        </tr></thead>
        <tbody id="f-rows"></tbody>
      </table>
      <p id="f-filterempty" class="p-muted hidden" style="padding:.85rem 1rem;font-size:.85rem">Geen facturen in deze categorie.</p>
    </div>
    <div class="pcard-b" id="f-skel">
      <div class="pskel h-10 w-full"></div>
      <div class="pskel mt-2 h-10 w-full"></div>
    </div>
    <div id="f-empty" class="empty hidden">
      <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
      <p class="empty-title">Nog geen facturen</p>
      <p class="empty-text">Zodra er een factuur is, verschijnt die hier.</p>
    </div>
  </section>
  <p class="mt-4 text-xs" style="color:var(--p-ink-4)">
    Vragen over een factuur? Stel ze via <a href="/portal/support" class="p-link">Support</a>.
  </p>

  <script is:inline>
    (function () {
      function esc(s) {
        return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
        });
      }
      function euro(cent) {
        return (Number(cent || 0) / 100).toLocaleString('nl-NL', { style: 'currency', currency: 'EUR' });
      }
      fetch('/api/portal/invoices', { credentials: 'same-origin' })
        .then(function (r) { if (r.status === 401) { location.href = '/portal/login'; throw 0; } return r.json(); })
        .then(function (d) {
          document.getElementById('f-skel').classList.add('hidden');
          var list = d.invoices || [];
          document.getElementById('f-count').textContent = list.length;
          var openCent = list.filter(function (i) { return i.status === 'open'; })
            .reduce(function (a, i) { return a + Number(i.bedrag_cent || 0); }, 0);
          document.getElementById('f-open').textContent = euro(openCent);
          if (!list.length) { document.getElementById('f-empty').classList.remove('hidden'); return; }
          document.getElementById('f-tablewrap').classList.remove('hidden');
          document.getElementById('f-filterbar').classList.remove('hidden');

          function rowHtml(i) {
            var badge = i.status === 'betaald' ? 'pbadge--green' : 'pbadge--amber';
            var href = '/portal/factuur?id=' + encodeURIComponent(i.id);
            return '<tr style="cursor:pointer" data-href="' + esc(href) + '">' +
              '<td class="primary">' + esc(i.factuurnummer || '—') + '</td>' +
              '<td>' + esc(i.periode) + '</td>' +
              '<td class="num primary">' + euro(i.bedrag_cent) + '</td>' +
              '<td><span class="pbadge ' + badge + '">' + esc(i.status) + '</span></td>' +
              '<td><a class="p-link" href="' + esc(href) + '">Bekijken</a></td></tr>';
          }

          function render(filter) {
            var rows = filter === 'alle'
              ? list
              : list.filter(function (i) { return i.status === filter; });
            var rowsEl = document.getElementById('f-rows');
            var emptyEl = document.getElementById('f-filterempty');
            if (!rows.length) {
              rowsEl.innerHTML = '';
              emptyEl.classList.remove('hidden');
            } else {
              rowsEl.innerHTML = rows.map(rowHtml).join('');
              emptyEl.classList.add('hidden');
            }
          }

          var btns = document.querySelectorAll('#f-filterbar [data-filter]');
          btns.forEach(function (btn) {
            btn.addEventListener('click', function () {
              btns.forEach(function (b) {
                b.classList.remove('pbtn--primary');
                b.classList.add('pbtn--subtle');
              });
              btn.classList.remove('pbtn--subtle');
              btn.classList.add('pbtn--primary');
              render(btn.getAttribute('data-filter'));
            });
          });

          document.getElementById('f-rows').addEventListener('click', function (ev) {
            if (ev.target.closest('a')) return;
            var tr = ev.target.closest('tr[data-href]');
            if (tr) location.href = tr.getAttribute('data-href');
          });

          render('alle');
        })
        .catch(function () {});
    })();
  </script>
</PortalLayout>
