---
// Customer portal — Overzicht (dashboard). Data: /api/portal/overview.
import PortalLayout from '../../layouts/PortalLayout.astro';
---

<PortalLayout title="Overzicht" active="overzicht">
  <h1 class="text-2xl font-bold text-slate-900">Overzicht</h1>
  <p class="mt-1 text-sm text-slate-600" id="ov-intro">Welkom terug.</p>

  <div id="ov-loading" class="mt-6 text-sm text-slate-400">Bezig met laden...</div>

  <div id="ov-content" class="hidden">
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <div class="rounded-xl border border-slate-200 bg-white p-4">
        <p class="text-xs uppercase tracking-wide text-slate-400">Actieve diensten</p>
        <p class="mt-1 text-2xl font-bold text-slate-900" id="ov-svc">0</p>
      </div>
      <div class="rounded-xl border border-slate-200 bg-white p-4">
        <p class="text-xs uppercase tracking-wide text-slate-400">Open aanvragen</p>
        <p class="mt-1 text-2xl font-bold text-slate-900" id="ov-req">0</p>
      </div>
      <div class="rounded-xl border border-slate-200 bg-white p-4">
        <p class="text-xs uppercase tracking-wide text-slate-400">Open vragen</p>
        <p class="mt-1 text-2xl font-bold text-slate-900" id="ov-tkt">0</p>
      </div>
      <div class="rounded-xl border border-slate-200 bg-white p-4">
        <p class="text-xs uppercase tracking-wide text-slate-400">Openstaande factuur</p>
        <p class="mt-1 text-2xl font-bold text-slate-900" id="ov-inv">—</p>
      </div>
    </div>

    <div class="mt-8 grid gap-6 lg:grid-cols-3">
      <section class="rounded-xl border border-slate-200 bg-white p-5">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Aan de slag</h2>
        <div class="mt-3 h-2 overflow-hidden rounded-full bg-slate-100">
          <div id="ov-progress" class="h-full bg-brand-indigo" style="width:0%"></div>
        </div>
        <ul id="ov-onboarding" class="mt-4 space-y-2 text-sm"></ul>
      </section>

      <section class="rounded-xl border border-slate-200 bg-white p-5 lg:col-span-2">
        <div class="flex items-center justify-between">
          <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Uw diensten</h2>
          <a href="/portal/diensten" class="text-sm font-medium text-brand-indigo hover:underline">Alle diensten →</a>
        </div>
        <div id="ov-services" class="mt-3 space-y-2"></div>
        <p id="ov-services-empty" class="mt-3 hidden text-sm text-slate-400">
          Nog geen diensten. Bekijk <a href="/portal/ontdekken" class="text-brand-indigo underline">Diensten ontdekken</a>.
        </p>
      </section>
    </div>
  </div>

  <script is:inline>
    (function () {
      var STATUS = {
        actief: 'bg-emerald-100 text-emerald-800',
        onboarding: 'bg-amber-100 text-amber-800',
        gepauzeerd: 'bg-slate-200 text-slate-600',
      };
      function esc(s) {
        return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
        });
      }
      function euro(cent) {
        return (Number(cent || 0) / 100).toLocaleString('nl-NL', { style: 'currency', currency: 'EUR' });
      }

      fetch('/api/portal/overview', { credentials: 'same-origin' })
        .then(function (r) { if (r.status === 401) { location.href = '/portal/login'; throw 0; } return r.json(); })
        .then(function (d) {
          document.getElementById('ov-loading').classList.add('hidden');
          document.getElementById('ov-content').classList.remove('hidden');
          if (d.bedrijf) document.getElementById('ov-intro').textContent = 'Welkom terug — ' + d.bedrijf + '.';

          var services = d.services || [];
          document.getElementById('ov-svc').textContent = services.filter(function (s) { return s.status === 'actief'; }).length;
          document.getElementById('ov-req').textContent = d.openRequests || 0;
          document.getElementById('ov-tkt').textContent = d.openTickets || 0;
          document.getElementById('ov-inv').textContent = d.openInvoice ? euro(d.openInvoice.bedrag_cent) : 'Geen';

          var ob = d.onboarding || [];
          var done = ob.filter(function (s) { return s.done; }).length;
          document.getElementById('ov-progress').style.width = (ob.length ? Math.round((done / ob.length) * 100) : 0) + '%';
          document.getElementById('ov-onboarding').innerHTML = ob.map(function (s) {
            return '<li class="flex items-center gap-2">' +
              (s.done
                ? '<span class="text-emerald-600">✓</span><span class="text-slate-500 line-through">' + esc(s.label) + '</span>'
                : '<span class="text-slate-300">○</span><span class="text-slate-700">' + esc(s.label) + '</span>') +
              '</li>';
          }).join('');

          var box = document.getElementById('ov-services');
          if (!services.length) {
            document.getElementById('ov-services-empty').classList.remove('hidden');
          } else {
            box.innerHTML = services.map(function (s) {
              var badge = STATUS[s.status] || 'bg-slate-200 text-slate-600';
              return '<a href="/portal/diensten" class="flex items-center justify-between rounded-lg border border-slate-200 px-4 py-3 hover:bg-slate-50">' +
                '<span class="font-medium text-slate-900">' + esc(s.naam) + '</span>' +
                '<span class="rounded-full px-2 py-0.5 text-xs font-medium ' + badge + '">' + esc(s.status) + '</span>' +
                '</a>';
            }).join('');
          }
        })
        .catch(function () {});
    })();
  </script>
</PortalLayout>
