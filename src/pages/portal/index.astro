---
// Customer portal — Overzicht (dashboard). Data: /api/portal/overview.
import PortalLayout from '../../layouts/PortalLayout.astro';
---

<PortalLayout title="Overzicht" active="overzicht">
  <h1 class="page-title">Overzicht</h1>
  <p class="page-sub" id="ov-intro">Welkom terug.</p>

  <!-- KPI strip -->
  <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" id="ov-kpis">
    <div class="kpi"><div class="kpi-label">Actieve diensten</div><div class="kpi-value" id="ov-svc"><span class="pskel inline-block h-7 w-10"></span></div></div>
    <div class="kpi"><div class="kpi-label">Open aanvragen</div><div class="kpi-value" id="ov-req"><span class="pskel inline-block h-7 w-10"></span></div></div>
    <div class="kpi"><div class="kpi-label">Open vragen</div><div class="kpi-value" id="ov-tkt"><span class="pskel inline-block h-7 w-10"></span></div></div>
    <div class="kpi"><div class="kpi-label">Openstaande factuur</div><div class="kpi-value" id="ov-inv"><span class="pskel inline-block h-7 w-20"></span></div></div>
  </div>

  <div class="mt-6 grid gap-6 lg:grid-cols-3">
    <!-- Onboarding -->
    <section class="pcard lg:col-span-1">
      <div class="pcard-h">Aan de slag</div>
      <div class="pcard-b">
        <div class="h-1.5 overflow-hidden rounded-full" style="background:var(--p-border)">
          <div id="ov-progress" class="h-full" style="width:0%;background:var(--p-accent);transition:width .4s"></div>
        </div>
        <ul id="ov-onboarding" class="mt-4 space-y-2.5 text-sm">
          <li class="pskel h-4 w-3/4"></li>
          <li class="pskel h-4 w-2/3"></li>
          <li class="pskel h-4 w-3/5"></li>
        </ul>
      </div>
    </section>

    <!-- Services snapshot -->
    <section class="pcard lg:col-span-2">
      <div class="pcard-h">
        <span>Uw diensten</span>
        <a href="/portal/diensten" class="p-link text-sm">Alle diensten →</a>
      </div>
      <div class="pcard-b">
        <div id="ov-services" class="space-y-2">
          <div class="pskel h-12 w-full"></div>
          <div class="pskel h-12 w-full"></div>
        </div>
        <div id="ov-services-empty" class="empty hidden">
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
          <p class="empty-title">Nog geen diensten</p>
          <p class="empty-text">Ontdek wat Aanloop AI voor u kan doen.</p>
          <a href="/portal/ontdekken" class="pbtn pbtn--subtle pbtn--sm mt-3">Diensten ontdekken</a>
        </div>
      </div>
    </section>
  </div>

  <script is:inline>
    (function () {
      var STATUS = { actief: 'pbadge--green', onboarding: 'pbadge--amber', gepauzeerd: 'pbadge--gray' };
      function esc(s) {
        return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
        });
      }
      function euro(cent) {
        return (Number(cent || 0) / 100).toLocaleString('nl-NL', { style: 'currency', currency: 'EUR' });
      }

      fetch('/api/portal/overview', { credentials: 'same-origin' })
        .then(function (r) { if (r.status === 401) { location.href = '/portal/login'; throw 0; } return r.json(); })
        .then(function (d) {
          if (d.bedrijf) document.getElementById('ov-intro').textContent = 'Welkom terug — ' + d.bedrijf + '.';
          var services = d.services || [];
          document.getElementById('ov-svc').textContent = services.filter(function (s) { return s.status === 'actief'; }).length;
          document.getElementById('ov-req').textContent = d.openRequests || 0;
          document.getElementById('ov-tkt').textContent = d.openTickets || 0;
          document.getElementById('ov-inv').textContent = d.openInvoice ? euro(d.openInvoice.bedrag_cent) : 'Geen';

          var ob = d.onboarding || [];
          var done = ob.filter(function (s) { return s.done; }).length;
          document.getElementById('ov-progress').style.width = (ob.length ? Math.round((done / ob.length) * 100) : 0) + '%';
          document.getElementById('ov-onboarding').innerHTML = ob.map(function (s) {
            return '<li class="flex items-center gap-2">' +
              (s.done
                ? '<span style="color:#1a7f53">✓</span><span class="p-muted" style="text-decoration:line-through">' + esc(s.label) + '</span>'
                : '<span style="color:var(--p-ink-4)">○</span><span style="color:var(--p-ink-2)">' + esc(s.label) + '</span>') +
              '</li>';
          }).join('');

          var box = document.getElementById('ov-services');
          if (!services.length) {
            box.innerHTML = '';
            document.getElementById('ov-services-empty').classList.remove('hidden');
          } else {
            box.innerHTML = services.map(function (s) {
              return '<a href="/portal/diensten" class="flex items-center justify-between rounded-md border px-4 py-2.5" style="border-color:var(--p-border)">' +
                '<span class="primary" style="color:var(--p-ink);font-weight:500">' + esc(s.naam) + '</span>' +
                '<span class="pbadge ' + (STATUS[s.status] || 'pbadge--gray') + '">' + esc(s.status) + '</span></a>';
            }).join('');
          }
        })
        .catch(function () {});
    })();
  </script>
</PortalLayout>
