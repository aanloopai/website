---
// Customer portal login (V3, Stripe style) — passwordless. Self-contained:
// must NOT use the portal app shell (that shell runs the auth guard).
import '../../styles/global.css';
import '../../styles/portal.css';
---

<!DOCTYPE html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Inloggen · Aanloop AI Klantportaal</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  </head>
  <body class="portal flex min-h-screen flex-col">
    <header class="border-b px-5 py-4" style="background:var(--p-surface);border-color:var(--p-border)">
      <div class="mx-auto flex max-w-5xl items-center justify-between">
        <a href="/" aria-label="Aanloop AI home">
          <img src="/brand/logo-horizontal-light.svg" alt="Aanloop AI" class="h-7" />
        </a>
        <span class="section-title">Klantportaal</span>
      </div>
    </header>

    <main class="flex flex-1 items-center justify-center px-4 py-12">
      <div class="pcard w-full max-w-sm">
        <div class="pcard-b">
          <h1 class="page-title">Inloggen</h1>
          <p class="page-sub">Vul uw e-mailadres in — u ontvangt een veilige inloglink. Geen wachtwoord nodig.</p>

          <form id="login-form" class="mt-5" novalidate>
            <label for="email" class="plabel">E-mailadres</label>
            <input type="email" id="email" name="email" required autocomplete="email" class="pinput" />
            <button type="submit" id="submit-btn" class="pbtn pbtn--primary mt-3 w-full">Stuur inloglink</button>
          </form>

          <p id="message" class="palert mt-4 hidden"></p>

          <div class="mt-6 flex items-center gap-3" style="color:var(--p-ink-4)">
            <hr class="flex-1" style="border:none;border-top:1px solid var(--p-border)" />
            <span class="text-xs">of</span>
            <hr class="flex-1" style="border:none;border-top:1px solid var(--p-border)" />
          </div>

          <details class="mt-4">
            <summary class="text-xs cursor-pointer" style="color:var(--p-ink-4)">Inloggen met wachtwoord (beheer)</summary>
            <form id="password-login-form" class="mt-3" novalidate>
              <label for="password" class="plabel">Wachtwoord</label>
              <input type="password" id="password" name="password" required autocomplete="current-password" class="pinput" />
              <button type="submit" id="password-submit-btn" class="pbtn pbtn--subtle mt-3 w-full">Inloggen</button>
            </form>
          </details>

          <p class="mt-6 text-xs" style="color:var(--p-ink-4)">
            Nog geen klant? <a href="/contact/" class="p-link">Neem contact op</a> —
            het portaal is voor actieve Aanloop AI klanten.
          </p>
        </div>
      </div>
    </main>

    <script is:inline>
      (function () {
        var form = document.getElementById('login-form');
        var btn = document.getElementById('submit-btn');
        var msg = document.getElementById('message');

        function showMsg(text, ok) {
          msg.textContent = text;
          msg.className = 'palert mt-4 ' + (ok ? 'palert--ok' : 'palert--warn');
        }

        var err = new URLSearchParams(location.search).get('error');
        if (err === 'link') showMsg('Deze inloglink is ongeldig of verlopen. Vraag hieronder een nieuwe aan.', false);
        else if (err === 'invite') showMsg('Deze uitnodiging is ongeldig of verlopen. Vraag de eigenaar om een nieuwe.', false);
        else if (err === 'bestaat') showMsg('Dit e-mailadres heeft al een account. Log hieronder gewoon in.', false);

        form.addEventListener('submit', function (e) {
          e.preventDefault();
          var email = document.getElementById('email').value.trim();
          if (!email) return;
          btn.disabled = true;
          btn.textContent = 'Versturen...';
          fetch('/api/auth/request', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: email }),
          })
            .then(function (r) { return r.json().then(function (d) { return { status: r.status, body: d }; }); })
            .then(function (res) {
              if (res.status === 200) {
                showMsg(res.body.message || 'Controleer uw mailbox voor de inloglink.', true);
                form.reset();
              } else {
                showMsg(res.body.error || 'Er ging iets mis. Probeer het opnieuw.', false);
              }
            })
            .catch(function () { showMsg('Netwerkfout. Probeer het opnieuw.', false); })
            .finally(function () {
              btn.disabled = false;
              btn.textContent = 'Stuur inloglink';
            });
        });

        // Staff-only password login. Shares the #email input above (one
        // e-mail field, two submit buttons) — customer accounts still only
        // ever use the magic-link form; the server enforces role === 'staff'.
        var pwForm = document.getElementById('password-login-form');
        var pwBtn = document.getElementById('password-submit-btn');
        pwForm.addEventListener('submit', function (e) {
          e.preventDefault();
          var email = document.getElementById('email').value.trim();
          var password = document.getElementById('password').value;
          if (!email) { showMsg('Vul eerst uw e-mailadres in.', false); return; }
          if (!password) return;
          pwBtn.disabled = true;
          pwBtn.textContent = 'Bezig...';
          fetch('/api/auth/login', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: email, password: password }),
          })
            .then(function (r) { return r.json().then(function (d) { return { status: r.status, body: d }; }); })
            .then(function (res) {
              if (res.status === 200 && res.body && res.body.ok) {
                location.href = (res.body && res.body.redirect) || '/admin/';
              } else {
                showMsg((res.body && res.body.error) || 'Ongeldige inloggegevens.', false);
              }
            })
            .catch(function () { showMsg('Netwerkfout. Probeer het opnieuw.', false); })
            .finally(function () {
              pwBtn.disabled = false;
              pwBtn.textContent = 'Inloggen';
              document.getElementById('password').value = '';
            });
        });
      })();
    </script>
  </body>
</html>
