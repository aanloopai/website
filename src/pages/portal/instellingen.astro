---
// Customer portal — Instellingen. Tabs: Bedrijf, Profiel, Team, Notificaties.
import PortalLayout from '../../layouts/PortalLayout.astro';
---

<PortalLayout title="Instellingen" active="instellingen">
  <h1 class="page-title">Instellingen</h1>

  <div class="mt-5 flex gap-1 overflow-x-auto border-b" style="border-color:var(--p-border)">
    <button class="tab-btn" data-tab="bedrijf">Bedrijfsgegevens</button>
    <button class="tab-btn" data-tab="profiel">Profiel</button>
    <button class="tab-btn" data-tab="team">Team</button>
    <button class="tab-btn" data-tab="notificaties">Notificaties</button>
  </div>

  <div id="i-loading" class="mt-6"><div class="pskel h-40 w-full max-w-xl"></div></div>

  <section data-panel="bedrijf" class="i-panel mt-6 hidden max-w-xl">
    <p id="b-readonly" class="palert palert--info mb-3 hidden">Alleen de eigenaar kan bedrijfsgegevens wijzigen.</p>
    <div class="pcard"><div class="pcard-b space-y-3">
      <div><label class="plabel">Bedrijfsnaam</label><input id="b-bedrijf" disabled class="pinput" /></div>
      <div class="grid grid-cols-2 gap-3">
        <div><label class="plabel">KvK</label><input id="b-kvk" class="i-field pinput" /></div>
        <div><label class="plabel">Telefoon</label><input id="b-telefoon" class="i-field pinput" /></div>
      </div>
      <div><label class="plabel">Adres</label><input id="b-adres" class="i-field pinput" /></div>
      <div class="grid grid-cols-2 gap-3">
        <div><label class="plabel">Postcode</label><input id="b-postcode" class="i-field pinput" /></div>
        <div><label class="plabel">Stad</label><input id="b-stad" class="i-field pinput" /></div>
      </div>
      <div><label class="plabel">Factuur-e-mail</label><input id="b-factuur" type="email" class="i-field pinput" /></div>
      <div class="flex items-center gap-3 pt-1">
        <button id="b-save" data-eigenaar class="pbtn pbtn--primary">Opslaan</button>
        <span id="b-msg" class="text-sm"></span>
      </div>
    </div></div>
  </section>

  <section data-panel="profiel" class="i-panel mt-6 hidden max-w-xl">
    <div class="pcard"><div class="pcard-b space-y-3">
      <div><label class="plabel">Naam</label><input id="p-naam" class="pinput" /></div>
      <div><label class="plabel">E-mailadres</label><input id="p-email" disabled class="pinput" /></div>
      <div><label class="plabel">Rol</label><input id="p-role" disabled class="pinput capitalize" /></div>
      <div class="flex items-center gap-3 pt-1">
        <button id="p-save" class="pbtn pbtn--primary">Opslaan</button>
        <span id="p-msg" class="text-sm"></span>
      </div>
    </div></div>
  </section>

  <section data-panel="team" class="i-panel mt-6 hidden">
    <div id="t-list" class="space-y-2"></div>
    <div data-eigenaar class="pcard mt-6 max-w-xl">
      <div class="pcard-h">Teamlid uitnodigen</div>
      <div class="pcard-b">
        <div class="flex flex-col gap-2 sm:flex-row">
          <input id="t-email" type="email" placeholder="E-mailadres" class="pinput flex-1" />
          <select id="t-role" class="pselect" style="width:auto">
            <option value="bewerker">Bewerker</option>
            <option value="kijker">Kijker</option>
            <option value="eigenaar">Eigenaar</option>
          </select>
          <button id="t-invite" class="pbtn pbtn--primary">Uitnodigen</button>
        </div>
        <p id="t-msg" class="palert mt-3 hidden"></p>
        <p class="mt-3 text-xs" style="color:var(--p-ink-4)">Eigenaar = alles · Bewerker = aanvragen + support · Kijker = alleen lezen.</p>
      </div>
    </div>
  </section>

  <section data-panel="notificaties" class="i-panel mt-6 hidden max-w-xl">
    <div class="pcard"><div class="pcard-b space-y-3">
      <label class="flex items-center gap-3 rounded-md border px-4 py-3 text-sm" style="border-color:var(--p-border)">
        <input type="checkbox" id="n-ticket" class="h-4 w-4" /><span style="color:var(--p-ink-2)">E-mail bij een antwoord op mijn supportvraag</span>
      </label>
      <label class="flex items-center gap-3 rounded-md border px-4 py-3 text-sm" style="border-color:var(--p-border)">
        <input type="checkbox" id="n-maand" class="h-4 w-4" /><span style="color:var(--p-ink-2)">Maandelijks overzicht van mijn diensten</span>
      </label>
      <div class="flex items-center gap-3 pt-1">
        <button id="n-save" class="pbtn pbtn--primary">Opslaan</button>
        <span id="n-msg" class="text-sm"></span>
      </div>
    </div></div>
  </section>

  <style>
    .tab-btn { white-space: nowrap; border-bottom: 2px solid transparent; padding: 8px 14px; font-size: 14px; font-weight: 500; color: var(--p-ink-3); cursor: pointer; background: none; }
    .tab-btn:hover { color: var(--p-ink); }
    .tab-btn.on { border-bottom-color: var(--p-accent); color: var(--p-accent); }
  </style>

  <script is:inline>
    (function () {
      var ROLE = { eigenaar: 'pbadge--blue', bewerker: 'pbadge--gray', kijker: 'pbadge--gray' };
      function esc(s) {
        return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
        });
      }
      function msg(el, text, ok) {
        el.className = 'text-sm ' + (ok ? '' : '');
        el.textContent = text;
        el.style.color = ok ? '#0e6245' : '#b3093c';
      }
      var myRole = '', myId = '';

      var tabs = document.querySelectorAll('.tab-btn');
      var panels = document.querySelectorAll('.i-panel');
      function activate(name) {
        tabs.forEach(function (t) { t.classList.toggle('on', t.getAttribute('data-tab') === name); });
        panels.forEach(function (p) { p.classList.toggle('hidden', p.getAttribute('data-panel') !== name); });
      }
      tabs.forEach(function (t) { t.addEventListener('click', function () { activate(t.getAttribute('data-tab')); }); });

      fetch('/api/portal/settings', { credentials: 'same-origin' })
        .then(function (r) { if (r.status === 401) { location.href = '/portal/login'; throw 0; } return r.json(); })
        .then(function (d) {
          document.getElementById('i-loading').classList.add('hidden');
          activate('bedrijf');
          var c = d.customer || {}, pr = d.profiel || {}, n = d.notificaties || {};
          myRole = pr.role || '';
          document.getElementById('b-bedrijf').value = c.bedrijf || '';
          document.getElementById('b-kvk').value = c.kvk || '';
          document.getElementById('b-telefoon').value = c.telefoon || '';
          document.getElementById('b-adres').value = c.adres || '';
          document.getElementById('b-postcode').value = c.postcode || '';
          document.getElementById('b-stad').value = c.stad || '';
          document.getElementById('b-factuur').value = c.factuur_email || '';
          document.getElementById('p-naam').value = pr.naam || '';
          document.getElementById('p-email').value = pr.email || '';
          document.getElementById('p-role').value = pr.role || '';
          document.getElementById('n-ticket').checked = !!n.ticket_antwoord;
          document.getElementById('n-maand').checked = !!n.maandoverzicht;
          if (myRole !== 'eigenaar') {
            document.getElementById('b-readonly').classList.remove('hidden');
            document.querySelectorAll('.i-field').forEach(function (f) { f.setAttribute('disabled', 'disabled'); });
            document.querySelectorAll('[data-eigenaar]').forEach(function (el) { el.classList.add('hidden'); });
          }
        })
        .catch(function () {});

      document.getElementById('b-save').addEventListener('click', function () {
        patch('bedrijf', {
          kvk: document.getElementById('b-kvk').value.trim(),
          telefoon: document.getElementById('b-telefoon').value.trim(),
          adres: document.getElementById('b-adres').value.trim(),
          postcode: document.getElementById('b-postcode').value.trim(),
          stad: document.getElementById('b-stad').value.trim(),
          factuur_email: document.getElementById('b-factuur').value.trim(),
        }, document.getElementById('b-msg'));
      });
      document.getElementById('p-save').addEventListener('click', function () {
        patch('profiel', { naam: document.getElementById('p-naam').value.trim() }, document.getElementById('p-msg'));
      });
      document.getElementById('n-save').addEventListener('click', function () {
        patch('notificaties', { notif: {
          ticket_antwoord: document.getElementById('n-ticket').checked,
          maandoverzicht: document.getElementById('n-maand').checked,
        } }, document.getElementById('n-msg'));
      });
      function patch(section, data, msgEl) {
        data.section = section;
        fetch('/api/portal/settings', {
          method: 'PATCH', credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data),
        })
          .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
          .then(function (res) { msg(msgEl, res.ok ? (res.j.message || 'Opgeslagen') : (res.j.error || 'Fout'), res.ok); })
          .catch(function () { msg(msgEl, 'Netwerkfout', false); });
      }

      function loadTeam() {
        fetch('/api/portal/team', { credentials: 'same-origin' })
          .then(function (r) { return r.json(); })
          .then(function (d) {
            myId = d.currentUserId || '';
            var leden = d.leden || [], invites = d.openUitnodigingen || [];
            var html = leden.map(function (u) {
              var ctrl = '';
              if (myRole === 'eigenaar' && u.id !== myId) {
                ctrl = '<select data-uid="' + esc(u.id) + '" class="t-role pselect pbtn--sm" style="width:auto;height:30px">' +
                  ['eigenaar', 'bewerker', 'kijker'].map(function (r) {
                    return '<option value="' + r + '"' + (r === u.role ? ' selected' : '') + '>' + r + '</option>';
                  }).join('') + '</select>' +
                  '<button data-uid="' + esc(u.id) + '" class="t-remove pbtn pbtn--danger pbtn--sm">Verwijderen</button>';
              } else {
                ctrl = '<span class="pbadge ' + (ROLE[u.role] || 'pbadge--gray') + '">' + esc(u.role) + '</span>';
              }
              return '<div class="pcard"><div class="flex items-center justify-between gap-3 px-4 py-3">' +
                '<div><span class="primary" style="color:var(--p-ink);font-weight:500">' + esc(u.naam) + '</span>' +
                '<span class="ml-2 text-xs p-muted">' + esc(u.email) + '</span></div>' +
                '<div class="flex items-center gap-2">' + ctrl + '</div></div></div>';
            }).join('');
            html += invites.map(function (iv) {
              return '<div class="rounded-md border border-dashed px-4 py-3" style="border-color:var(--p-border-strong);background:var(--p-subtle)">' +
                '<span class="text-sm p-muted">' + esc(iv.email) + ' — uitgenodigd (' + esc(iv.role) + ')</span>' +
                '<span class="ml-2 pbadge pbadge--amber">In afwachting</span></div>';
            }).join('');
            document.getElementById('t-list').innerHTML = html || '<p class="text-sm p-muted">Geen teamleden.</p>';

            document.querySelectorAll('.t-role').forEach(function (sel) {
              sel.addEventListener('change', function () {
                fetch('/api/portal/team/role', {
                  method: 'PATCH', credentials: 'same-origin',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ user_id: sel.getAttribute('data-uid'), role: sel.value }),
                }).then(function () { loadTeam(); });
              });
            });
            document.querySelectorAll('.t-remove').forEach(function (b) {
              b.addEventListener('click', function () {
                if (!confirm('Dit teamlid verwijderen?')) return;
                fetch('/api/portal/team/remove', {
                  method: 'POST', credentials: 'same-origin',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ user_id: b.getAttribute('data-uid') }),
                }).then(function () { loadTeam(); });
              });
            });
          })
          .catch(function () {});
      }
      document.getElementById('t-invite').addEventListener('click', function () {
        var tmsg = document.getElementById('t-msg');
        fetch('/api/portal/team/invite', {
          method: 'POST', credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email: document.getElementById('t-email').value.trim(),
            role: document.getElementById('t-role').value,
          }),
        })
          .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
          .then(function (res) {
            tmsg.className = 'palert mt-3 ' + (res.ok ? 'palert--ok' : 'palert--warn');
            tmsg.textContent = res.ok ? (res.j.message || 'Uitnodiging verstuurd') : (res.j.error || 'Fout');
            if (res.ok) { document.getElementById('t-email').value = ''; loadTeam(); }
          })
          .catch(function () { tmsg.className = 'palert palert--warn mt-3'; tmsg.textContent = 'Netwerkfout'; });
      });
      loadTeam();
    })();
  </script>
</PortalLayout>
