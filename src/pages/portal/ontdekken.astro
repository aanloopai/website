---
// Customer portal — Diensten ontdekken (catalog). Start an intake order.
import PortalLayout from '../../layouts/PortalLayout.astro';
import { PORTAL_CATALOG } from '../../data/portal-catalog';
---

<PortalLayout title="Diensten ontdekken" active="ontdekken">
  <h1 class="page-title">Diensten ontdekken</h1>
  <p class="page-sub">Kies een dienst en start uw aanvraag — u vult zelf alle gegevens in.</p>

  <div class="mt-6 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
    {PORTAL_CATALOG.map((p) => (
      <article
        class="catalog-card pcard flex flex-col"
        data-key={p.key}
        data-naam={p.naam}
        data-tiers={JSON.stringify(p.tiers.map((t) => `${t.naam} — ${t.prijs}`))}
      >
        <div class="pcard-b flex flex-1 flex-col">
          <span class="pbadge pbadge--gray self-start">{p.categorie}</span>
          <h2 class="mt-2 text-base font-semibold" style="color:var(--p-ink)">{p.naam}</h2>
          <p class="mt-1 text-sm p-muted">{p.omschrijving}</p>
          <ul class="mt-3 space-y-1 text-sm">
            {p.tiers.map((t) => (
              <li class="flex justify-between gap-3 border-t py-1" style="border-color:var(--p-border)">
                <span class="p-muted">{t.naam}</span>
                <span class="font-medium" style="color:var(--p-ink)">{t.prijs}</span>
              </li>
            ))}
          </ul>
          <div class="mt-auto flex items-center gap-2 pt-4">
            <button class="catalog-start pbtn pbtn--primary pbtn--sm" data-write>Aanvraag starten</button>
            <a href={p.meerInfoUrl} target="_blank" rel="noopener" class="p-link text-sm">Meer info</a>
            <span class="catalog-owned pbadge pbadge--green hidden">U heeft dit al</span>
          </div>
        </div>
      </article>
    ))}
  </div>

  <div id="c-modal" class="pmodal-backdrop">
    <div class="pmodal">
      <h3 class="page-title" style="font-size:17px" id="c-modal-title">Aanvraag starten</h3>
      <p class="page-sub">Kies het gewenste pakket. Daarna vult u stap voor stap uw gegevens in.</p>
      <label class="plabel mt-4">Pakket</label>
      <select id="c-tier" class="pselect"></select>
      <p id="c-modal-msg" class="palert mt-3 hidden"></p>
      <div class="mt-4 flex justify-end gap-2">
        <button id="c-modal-cancel" class="pbtn pbtn--subtle pbtn--sm">Annuleren</button>
        <button id="c-modal-go" class="pbtn pbtn--primary pbtn--sm">Doorgaan naar intake →</button>
      </div>
    </div>
  </div>

  <script is:inline>
    (function () {
      var ctx = null;
      fetch('/api/portal/services', { credentials: 'same-origin' })
        .then(function (r) { if (r.status === 401) { location.href = '/portal/login'; throw 0; } return r.json(); })
        .then(function (d) {
          var owned = {};
          (d.services || []).forEach(function (s) { owned[s.product_key] = true; });
          Array.prototype.forEach.call(document.querySelectorAll('.catalog-card'), function (card) {
            if (owned[card.getAttribute('data-key')]) {
              card.querySelector('.catalog-owned').classList.remove('hidden');
            }
          });
        })
        .catch(function () {});

      function closeModal() { document.getElementById('c-modal').classList.remove('open'); }
      Array.prototype.forEach.call(document.querySelectorAll('.catalog-start'), function (b) {
        b.addEventListener('click', function () {
          var card = b.closest('.catalog-card');
          var tiers = [];
          try { tiers = JSON.parse(card.getAttribute('data-tiers')); } catch (e) {}
          ctx = { product_key: card.getAttribute('data-key') };
          document.getElementById('c-modal-title').textContent = card.getAttribute('data-naam');
          document.getElementById('c-tier').innerHTML = tiers.map(function (t) {
            return '<option value="' + t.split(' — ')[0] + '">' + t + '</option>';
          }).join('');
          document.getElementById('c-modal-msg').className = 'palert mt-3 hidden';
          document.getElementById('c-modal').classList.add('open');
        });
      });
      document.getElementById('c-modal-cancel').addEventListener('click', closeModal);
      document.getElementById('c-modal-go').addEventListener('click', function () {
        if (!ctx) return;
        var btn = this; btn.disabled = true;
        fetch('/api/portal/orders', {
          method: 'POST', credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ product_key: ctx.product_key, tier: document.getElementById('c-tier').value }),
        })
          .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
          .then(function (res) {
            if (res.ok) { location.href = '/portal/intake?order=' + encodeURIComponent(res.j.id); }
            else {
              var m = document.getElementById('c-modal-msg');
              m.className = 'palert palert--warn mt-3'; m.textContent = res.j.error || 'Er ging iets mis.';
              btn.disabled = false;
            }
          })
          .catch(function () { btn.disabled = false; });
      });
    })();
  </script>
</PortalLayout>
