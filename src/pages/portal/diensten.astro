---
// Customer portal — Mijn diensten. List + detail + change requests.
import PortalLayout from '../../layouts/PortalLayout.astro';
---

<PortalLayout title="Mijn diensten" active="diensten">
  <h1 class="page-title">Mijn diensten</h1>
  <p class="page-sub">Bekijk uw diensten en vraag een wijziging aan.</p>

  <div class="mt-6 grid gap-6 lg:grid-cols-2">
    <section class="pcard">
      <div class="pcard-h">Diensten</div>
      <div class="pcard-b">
        <div id="d-list" class="space-y-2">
          <div class="pskel h-14 w-full"></div>
          <div class="pskel h-14 w-full"></div>
        </div>
        <div id="d-empty" class="empty hidden">
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
          <p class="empty-title">Nog geen diensten</p>
          <p class="empty-text">Bekijk Diensten ontdekken om te starten.</p>
          <a href="/portal/ontdekken" class="pbtn pbtn--subtle pbtn--sm mt-3">Diensten ontdekken</a>
        </div>
      </div>
    </section>

    <section class="pcard">
      <div class="pcard-h">Detail</div>
      <div class="pcard-b" id="d-detail">
        <p class="text-sm p-muted">Kies een dienst om de details te zien.</p>
      </div>
    </section>
  </div>

  <section class="pcard mt-6" id="d-orders-wrap">
    <div class="pcard-h">Lopende aanvragen</div>
    <div class="pcard-b">
      <div id="d-orders" class="space-y-2"><div class="pskel h-14 w-full"></div></div>
      <div id="d-orders-empty" class="empty hidden">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
        <p class="empty-title">Geen lopende aanvragen</p>
        <p class="empty-text">Start een nieuwe via <a href="/portal/ontdekken" class="p-link">Diensten ontdekken</a>.</p>
      </div>
    </div>
  </section>

  <section class="pcard mt-6" id="d-requests-wrap">
    <div class="pcard-h">Mijn wijzigingsverzoeken</div>
    <div class="pcard-b">
      <div id="d-requests" class="space-y-2"><div class="pskel h-16 w-full"></div></div>
      <div id="d-requests-empty" class="empty hidden">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
        <p class="empty-title">Nog geen aanvragen</p>
        <p class="empty-text">Wijzigingsaanvragen verschijnen hier met hun status.</p>
      </div>
    </div>
  </section>

  <div id="d-modal" class="pmodal-backdrop">
    <div class="pmodal">
      <h3 class="page-title" style="font-size:17px" id="d-modal-title">Aanvraag</h3>
      <p class="page-sub" id="d-modal-sub"></p>
      <label class="plabel mt-4">Toelichting (optioneel)</label>
      <textarea id="d-modal-bericht" class="ptextarea"></textarea>
      <p id="d-modal-msg" class="palert mt-3 hidden"></p>
      <div class="mt-4 flex justify-end gap-2">
        <button id="d-modal-cancel" class="pbtn pbtn--subtle pbtn--sm">Annuleren</button>
        <button id="d-modal-submit" class="pbtn pbtn--primary pbtn--sm">Aanvraag versturen</button>
      </div>
    </div>
  </div>

  <script is:inline>
    (function () {
      var STATUS = { actief: 'pbadge--green', onboarding: 'pbadge--amber', gepauzeerd: 'pbadge--gray' };
      var REQ_STATUS = { open: 'pbadge--amber', in_behandeling: 'pbadge--blue', afgerond: 'pbadge--green', afgewezen: 'pbadge--red' };
      var TYPE_LABEL = {
        upgrade: 'Upgrade', downgrade: 'Downgrade', pause: 'Pauzeren',
        resume: 'Hervatten', new_product: 'Nieuw product', cancel: 'Opzeggen',
      };
      function esc(s) {
        return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
        });
      }
      var services = [], modalCtx = null;

      function load() {
        fetch('/api/portal/services', { credentials: 'same-origin' })
          .then(function (r) { if (r.status === 401) { location.href = '/portal/login'; throw 0; } return r.json(); })
          .then(function (d) { services = d.services || []; renderList(); })
          .catch(function () {});
        loadRequests();
      }

      function renderList() {
        var box = document.getElementById('d-list');
        if (!services.length) { box.innerHTML = ''; document.getElementById('d-empty').classList.remove('hidden'); return; }
        box.innerHTML = services.map(function (s) {
          return '<button data-id="' + esc(s.id) + '" class="d-pick flex w-full items-center justify-between rounded-md border px-4 py-3 text-left" style="border-color:var(--p-border)">' +
            '<span><span class="primary" style="color:var(--p-ink);font-weight:500">' + esc(s.naam) + '</span>' +
            (s.tier ? '<span class="ml-2 text-xs p-muted">' + esc(s.tier) + '</span>' : '') + '</span>' +
            '<span class="pbadge ' + (STATUS[s.status] || 'pbadge--gray') + '">' + esc(s.status) + '</span></button>';
        }).join('');
        Array.prototype.forEach.call(document.querySelectorAll('.d-pick'), function (b) {
          b.addEventListener('click', function () { showDetail(b.getAttribute('data-id')); });
        });
      }

      function showDetail(id) {
        var s = services.filter(function (x) { return x.id === id; })[0];
        if (!s) return;
        var cfg = s.config && typeof s.config === 'object' ? s.config : null;
        var cfgRows = cfg
          ? Object.keys(cfg).map(function (k) {
              return '<div class="flex justify-between gap-3 border-t py-1.5 text-sm" style="border-color:var(--p-border)">' +
                '<span class="p-muted">' + esc(k) + '</span><span style="color:var(--p-ink)">' + esc(cfg[k]) + '</span></div>';
            }).join('')
          : '<p class="text-sm p-muted">Geen configuratie vastgelegd.</p>';
        var actions = '<a href="/portal/dienst-config?service=' + esc(s.id) +
          '" class="pbtn pbtn--subtle pbtn--sm">Instellingen bewerken</a>';
        if (s.status !== 'gepauzeerd') {
          actions += btn('upgrade', s.id, 'Upgraden') + btn('downgrade', s.id, 'Downgraden') + btn('pause', s.id, 'Pauzeren');
        } else {
          actions += btn('resume', s.id, 'Hervatten');
        }
        actions += btn('cancel', s.id, 'Opzeggen');
        document.getElementById('d-detail').innerHTML =
          '<div class="flex items-center justify-between gap-3"><h3 style="font-size:16px;font-weight:600;color:var(--p-ink)">' + esc(s.naam) + '</h3>' +
          '<span class="pbadge ' + (STATUS[s.status] || 'pbadge--gray') + '">' + esc(s.status) + '</span></div>' +
          '<p class="mt-0.5 text-xs uppercase tracking-wide p-muted">' + esc(s.tier || '—') + '</p>' +
          (s.started_at ? '<p class="mt-0.5 text-xs" style="color:var(--p-ink-4)">Actief sinds ' + esc(s.started_at) + '</p>' : '') +
          '<p class="section-title mt-4">Configuratie</p><div class="mt-1">' + cfgRows + '</div>' +
          '<div class="mt-5 flex flex-wrap gap-2" data-write>' + actions + '</div>';
        Array.prototype.forEach.call(document.querySelectorAll('.d-act'), function (b) {
          b.addEventListener('click', function () { openModal(b.getAttribute('data-type'), b.getAttribute('data-svc')); });
        });
        if (window.__portalUser && window.__portalUser.role === 'kijker') {
          var w = document.querySelector('#d-detail [data-write]');
          if (w) w.classList.add('hidden');
        }
      }
      function btn(type, svc, label) {
        return '<button class="d-act pbtn pbtn--subtle pbtn--sm" data-type="' + type + '" data-svc="' + esc(svc) + '">' + label + '</button>';
      }

      function openModal(type, svc) {
        modalCtx = { type: type, service_id: svc };
        var s = services.filter(function (x) { return x.id === svc; })[0];
        document.getElementById('d-modal-title').textContent = TYPE_LABEL[type] + ' aanvragen';
        document.getElementById('d-modal-sub').textContent = (s ? s.naam : '') + ' — wij nemen binnen 1 werkdag contact met u op.';
        document.getElementById('d-modal-bericht').value = '';
        document.getElementById('d-modal-msg').className = 'palert mt-3 hidden';
        document.getElementById('d-modal').classList.add('open');
      }
      function closeModal() { document.getElementById('d-modal').classList.remove('open'); }
      document.getElementById('d-modal-cancel').addEventListener('click', closeModal);
      document.getElementById('d-modal-submit').addEventListener('click', function () {
        if (!modalCtx) return;
        var btnEl = this; btnEl.disabled = true;
        fetch('/api/portal/service-request', {
          method: 'POST', credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ type: modalCtx.type, service_id: modalCtx.service_id, bericht: document.getElementById('d-modal-bericht').value.trim() }),
        })
          .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
          .then(function (res) {
            var m = document.getElementById('d-modal-msg');
            if (res.ok) {
              m.className = 'palert palert--ok mt-3'; m.textContent = res.j.message || 'Aanvraag verstuurd.';
              setTimeout(function () { closeModal(); loadRequests(); }, 1200);
            } else {
              m.className = 'palert palert--warn mt-3'; m.textContent = res.j.error || 'Er ging iets mis.';
            }
          })
          .catch(function () {})
          .finally(function () { btnEl.disabled = false; });
      });

      function loadRequests() {
        fetch('/api/portal/requests', { credentials: 'same-origin' })
          .then(function (r) { return r.json(); })
          .then(function (d) {
            var list = d.requests || [];
            if (!list.length) {
              document.getElementById('d-requests').innerHTML = '';
              document.getElementById('d-requests-empty').classList.remove('hidden');
              return;
            }
            document.getElementById('d-requests-empty').classList.add('hidden');
            document.getElementById('d-requests').innerHTML = list.map(function (r) {
              var dt = new Date(r.created_at).toLocaleDateString('nl-NL');
              return '<div class="rounded-md border px-4 py-3" style="border-color:var(--p-border)">' +
                '<div class="flex items-center justify-between gap-2"><span class="primary" style="color:var(--p-ink);font-weight:500">' +
                esc(TYPE_LABEL[r.type] || r.type) + '</span>' +
                '<span class="pbadge ' + (REQ_STATUS[r.status] || 'pbadge--gray') + '">' + esc(r.status) + '</span></div>' +
                '<p class="mt-1 text-xs" style="color:var(--p-ink-4)">' + dt + (r.bericht ? ' — ' + esc(r.bericht) : '') + '</p>' +
                (r.admin_notitie ? '<p class="mt-1 text-xs p-muted">Reactie: ' + esc(r.admin_notitie) + '</p>' : '') +
                '</div>';
            }).join('');
          })
          .catch(function () {});
      }

      var ORDER_STATUS = {
        concept: 'pbadge--gray', ingediend: 'pbadge--amber',
        in_uitvoering: 'pbadge--blue', actief: 'pbadge--green', geannuleerd: 'pbadge--red',
      };
      var ORDER_LABEL = {
        concept: 'Concept', ingediend: 'Ingediend', in_uitvoering: 'In uitvoering',
        actief: 'Actief', geannuleerd: 'Geannuleerd',
      };
      function loadOrders() {
        fetch('/api/portal/orders', { credentials: 'same-origin' })
          .then(function (r) { return r.json(); })
          .then(function (d) {
            var list = d.orders || [];
            var box = document.getElementById('d-orders');
            if (!list.length) { box.innerHTML = ''; document.getElementById('d-orders-empty').classList.remove('hidden'); return; }
            document.getElementById('d-orders-empty').classList.add('hidden');
            box.innerHTML = list.map(function (o) {
              var badge = ORDER_STATUS[o.status] || 'pbadge--gray';
              var actie = o.status === 'concept'
                ? '<a href="/portal/intake?order=' + esc(o.id) + '" class="pbtn pbtn--subtle pbtn--sm">Verder invullen</a>'
                : '';
              return '<div class="flex items-center justify-between gap-3 rounded-md border px-4 py-3" style="border-color:var(--p-border)">' +
                '<div><span class="primary" style="color:var(--p-ink);font-weight:500">' + esc(o.product_key) + '</span>' +
                (o.tier ? '<span class="ml-2 text-xs p-muted">' + esc(o.tier) + '</span>' : '') + '</div>' +
                '<div class="flex items-center gap-2"><span class="pbadge ' + badge + '">' + esc(ORDER_LABEL[o.status] || o.status) + '</span>' + actie + '</div>' +
                '</div>';
            }).join('');
          })
          .catch(function () {});
      }

      load();
      loadOrders();
    })();
  </script>
</PortalLayout>
