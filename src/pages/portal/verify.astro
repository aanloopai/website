---
// Magic-link verify — POST-redirect flow.
// Mail link points here (instead of /api/auth/verify) so the token never lands
// in server access logs, browser history, or HTTP Referer headers. Also stops
// e-mail security scanners from silently consuming the one-time token by
// pre-fetching, because GET-pre-fetching this page does not POST the token.
//
// Self-contained shell, exactly like login.astro — this page must NOT use
// PortalLayout: that shell runs the auth guard (GET /api/portal/me → 401 →
// location.href = /portal/login), which in production wins the race against
// the verify-POST below (32 ms vs ~100+ ms). Result before this fix: the POST
// was aborted mid-flight, the one-time token was burned server-side and the
// customer landed on the login page without a session — every magic-link
// login failed. Seen live on 2026-09-16 (leadpartner go-live test).
import '../../styles/global.css';
import '../../styles/portal.css';
---

<!DOCTYPE html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Inloggen… · Aanloop AI Klantportaal</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  </head>
  <body class="portal flex min-h-screen flex-col">
    <header class="border-b px-5 py-4" style="background:var(--p-surface);border-color:var(--p-border)">
      <div class="mx-auto flex max-w-5xl items-center justify-between">
        <a href="/" aria-label="Aanloop AI home">
          <img src="/brand/logo-horizontal-light.svg" alt="Aanloop AI" class="h-7" />
        </a>
        <span class="section-title">Klantportaal</span>
      </div>
    </header>

    <main class="flex flex-1 items-center justify-center px-4 py-12">
  <div class="mx-auto w-full max-w-md">
    <div class="pcard">
      <div class="pcard-b text-center" style="padding:40px 24px">
        <div id="v-pending">
          <div class="pskel mx-auto h-12 w-12 rounded-full"></div>
          <h1 class="page-title mt-4">Inloggen…</h1>
          <p class="page-sub mt-1">Een moment, we controleren uw inloglink.</p>
        </div>
        <div id="v-err" class="hidden">
          <h1 class="page-title" style="color:#b3093c">Inloglink ongeldig</h1>
          <p class="page-sub mx-auto mt-1" style="max-width:24rem">
            De link is verlopen of al gebruikt. Vraag een nieuwe inloglink aan.
          </p>
          <a href="/portal/login/" class="pbtn pbtn--primary mt-5">Nieuwe link aanvragen</a>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    (function () {
      var token = new URLSearchParams(location.search).get('token');
      if (!token) { location.href = '/portal/login?error=link'; return; }

      var body = new URLSearchParams();
      body.set('token', token);
      var next = new URLSearchParams(location.search).get('next');
      if (next) body.set('next', next); // server: safeNextPath — alleen /portal/…
      // x-www-form-urlencoded is a CORS "simple request" — no preflight needed.
      fetch('/api/auth/verify', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'content-type': 'application/x-www-form-urlencoded' },
        body: body.toString(),
      })
        .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
        .then(function (res) {
          if (res.ok && res.j.redirect) {
            location.replace(res.j.redirect);
          } else {
            document.getElementById('v-pending').classList.add('hidden');
            document.getElementById('v-err').classList.remove('hidden');
          }
        })
        .catch(function () {
          document.getElementById('v-pending').classList.add('hidden');
          document.getElementById('v-err').classList.remove('hidden');
        });
    })();
  </script>
    </main>
  </body>
</html>
