---
// Customer portal — Support. Ticket list + new ticket form.
import PortalLayout from '../../layouts/PortalLayout.astro';
---

<PortalLayout title="Support" active="support">
  <h1 class="page-title">Support</h1>
  <p class="page-sub">Stel een vraag of bekijk de status van eerdere vragen.</p>

  <div class="mt-6 grid gap-6 lg:grid-cols-2">
    <section class="pcard" data-write id="s-form-wrap">
      <div class="pcard-h">Nieuwe vraag</div>
      <div class="pcard-b">
        <form id="s-form" novalidate>
          <label for="s-onderwerp" class="plabel">Onderwerp</label>
          <input type="text" id="s-onderwerp" required maxlength="200" class="pinput" />
          <label for="s-bericht" class="plabel mt-3">Uw vraag</label>
          <textarea id="s-bericht" required maxlength="4000" class="ptextarea"></textarea>
          <button type="submit" id="s-submit" class="pbtn pbtn--primary mt-3">Vraag versturen</button>
          <p id="s-msg" class="palert mt-3 hidden"></p>
        </form>
      </div>
    </section>

    <section>
      <p class="section-title">Mijn vragen</p>
      <div id="s-list" class="mt-3 space-y-3">
        <div class="pskel h-24 w-full"></div>
      </div>
      <div id="s-empty" class="pcard mt-3 hidden">
        <div class="empty">
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 4v-4z"/></svg>
          <p class="empty-title">Nog geen vragen</p>
          <p class="empty-text">Stel links uw eerste vraag — we reageren snel.</p>
        </div>
      </div>
    </section>
  </div>

  <script is:inline>
    (function () {
      var STATUS = { open: 'pbadge--amber', in_behandeling: 'pbadge--blue', beantwoord: 'pbadge--green', gesloten: 'pbadge--gray' };
      function esc(s) {
        return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
        });
      }
      function loadTickets() {
        fetch('/api/portal/tickets', { credentials: 'same-origin' })
          .then(function (r) { if (r.status === 401) { location.href = '/portal/login'; throw 0; } return r.json(); })
          .then(function (d) {
            var list = d.tickets || [];
            var box = document.getElementById('s-list');
            if (!list.length) { box.innerHTML = ''; document.getElementById('s-empty').classList.remove('hidden'); return; }
            document.getElementById('s-empty').classList.add('hidden');
            box.innerHTML = list.map(function (t) {
              var dt = new Date(t.created_at).toLocaleDateString('nl-NL');
              return '<div class="pcard"><div class="pcard-b">' +
                '<div class="flex items-center justify-between gap-2"><span class="primary" style="color:var(--p-ink);font-weight:600">' + esc(t.onderwerp) + '</span>' +
                '<span class="pbadge ' + (STATUS[t.status] || 'pbadge--gray') + '">' + esc(t.status) + '</span></div>' +
                '<p class="mt-1 text-xs" style="color:var(--p-ink-4)">' + dt + '</p>' +
                '<p class="mt-2 text-sm p-muted">' + esc(t.bericht) + '</p>' +
                (t.admin_antwoord
                  ? '<div class="mt-3 rounded-md p-3 text-sm" style="background:var(--p-subtle)"><p class="section-title">Antwoord van Aanloop AI</p><p class="mt-1" style="color:var(--p-ink-2)">' + esc(t.admin_antwoord) + '</p></div>'
                  : '') +
                '</div></div>';
            }).join('');
          })
          .catch(function () {});
      }

      document.getElementById('s-form').addEventListener('submit', function (e) {
        e.preventDefault();
        var onderwerp = document.getElementById('s-onderwerp').value.trim();
        var bericht = document.getElementById('s-bericht').value.trim();
        var msg = document.getElementById('s-msg');
        if (!onderwerp || !bericht) {
          msg.className = 'palert palert--warn mt-3'; msg.textContent = 'Vul onderwerp en vraag in.';
          return;
        }
        var btn = document.getElementById('s-submit');
        btn.disabled = true;
        fetch('/api/portal/tickets', {
          method: 'POST', credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ onderwerp: onderwerp, bericht: bericht }),
        })
          .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
          .then(function (res) {
            if (res.ok) {
              msg.className = 'palert palert--ok mt-3'; msg.textContent = res.j.message || 'Vraag verstuurd.';
              document.getElementById('s-form').reset();
              loadTickets();
            } else {
              msg.className = 'palert palert--warn mt-3'; msg.textContent = res.j.error || 'Er ging iets mis.';
            }
          })
          .catch(function () { msg.className = 'palert palert--warn mt-3'; msg.textContent = 'Netwerkfout.'; })
          .finally(function () { btn.disabled = false; });
      });

      loadTickets();
    })();
  </script>
</PortalLayout>
