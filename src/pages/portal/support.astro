---
// Customer portal — Support. Ticket list + new ticket form.
import PortalLayout from '../../layouts/PortalLayout.astro';
---

<PortalLayout title="Support" active="support">
  <h1 class="text-2xl font-bold text-slate-900">Support</h1>
  <p class="mt-1 text-sm text-slate-600">Stel een vraag of bekijk de status van eerdere vragen.</p>

  <div class="mt-6 grid gap-6 lg:grid-cols-2">
    <section class="rounded-xl border border-slate-200 bg-white p-5" data-write id="s-form-wrap">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Nieuwe vraag</h2>
      <form id="s-form" class="mt-3 space-y-3" novalidate>
        <div>
          <label for="s-onderwerp" class="block text-sm font-medium text-slate-700">Onderwerp</label>
          <input type="text" id="s-onderwerp" required maxlength="200"
            class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-brand-indigo focus:outline-none" />
        </div>
        <div>
          <label for="s-bericht" class="block text-sm font-medium text-slate-700">Uw vraag</label>
          <textarea id="s-bericht" rows="4" required maxlength="4000"
            class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-brand-indigo focus:outline-none"></textarea>
        </div>
        <button type="submit" id="s-submit"
          class="rounded-lg bg-brand-indigo px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700 disabled:opacity-60">
          Vraag versturen
        </button>
        <p id="s-msg" class="hidden rounded-lg px-3 py-2 text-sm"></p>
      </form>
    </section>

    <section>
      <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Mijn vragen</h2>
      <div id="s-loading" class="mt-3 text-sm text-slate-400">Bezig met laden...</div>
      <div id="s-tickets" class="mt-3 space-y-3"></div>
      <p id="s-empty" class="mt-3 hidden text-sm text-slate-400">Nog geen vragen gesteld.</p>
    </section>
  </div>

  <script is:inline>
    (function () {
      var STATUS = {
        open: 'bg-amber-100 text-amber-800',
        in_behandeling: 'bg-blue-100 text-blue-800',
        beantwoord: 'bg-emerald-100 text-emerald-800',
        gesloten: 'bg-slate-200 text-slate-600',
      };
      function esc(s) {
        return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
        });
      }
      function loadTickets() {
        fetch('/api/portal/tickets', { credentials: 'same-origin' })
          .then(function (r) { if (r.status === 401) { location.href = '/portal/login'; throw 0; } return r.json(); })
          .then(function (d) {
            document.getElementById('s-loading').classList.add('hidden');
            var list = d.tickets || [];
            if (!list.length) { document.getElementById('s-empty').classList.remove('hidden'); document.getElementById('s-tickets').innerHTML = ''; return; }
            document.getElementById('s-empty').classList.add('hidden');
            document.getElementById('s-tickets').innerHTML = list.map(function (t) {
              var badge = STATUS[t.status] || 'bg-slate-200 text-slate-600';
              var dt = new Date(t.created_at).toLocaleDateString('nl-NL');
              return '<div class="rounded-xl border border-slate-200 bg-white p-4">' +
                '<div class="flex items-center justify-between gap-2">' +
                '<span class="font-semibold text-slate-900">' + esc(t.onderwerp) + '</span>' +
                '<span class="shrink-0 rounded-full px-2 py-0.5 text-xs font-medium ' + badge + '">' + esc(t.status) + '</span></div>' +
                '<p class="mt-1 text-xs text-slate-400">' + dt + '</p>' +
                '<p class="mt-2 text-sm text-slate-600">' + esc(t.bericht) + '</p>' +
                (t.admin_antwoord
                  ? '<div class="mt-3 rounded-lg bg-slate-50 p-3 text-sm"><p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Antwoord van Aanloop AI</p><p class="mt-1 text-slate-700">' + esc(t.admin_antwoord) + '</p></div>'
                  : '') +
                '</div>';
            }).join('');
          })
          .catch(function () {});
      }

      document.getElementById('s-form').addEventListener('submit', function (e) {
        e.preventDefault();
        var onderwerp = document.getElementById('s-onderwerp').value.trim();
        var bericht = document.getElementById('s-bericht').value.trim();
        var msg = document.getElementById('s-msg');
        if (!onderwerp || !bericht) {
          msg.className = 'rounded-lg bg-amber-50 px-3 py-2 text-sm text-amber-800';
          msg.textContent = 'Vul onderwerp en vraag in.';
          return;
        }
        var btn = document.getElementById('s-submit');
        btn.disabled = true;
        fetch('/api/portal/tickets', {
          method: 'POST', credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ onderwerp: onderwerp, bericht: bericht }),
        })
          .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
          .then(function (res) {
            if (res.ok) {
              msg.className = 'rounded-lg bg-emerald-50 px-3 py-2 text-sm text-emerald-800';
              msg.textContent = res.j.message || 'Vraag verstuurd.';
              document.getElementById('s-form').reset();
              loadTickets();
            } else {
              msg.className = 'rounded-lg bg-amber-50 px-3 py-2 text-sm text-amber-800';
              msg.textContent = res.j.error || 'Er ging iets mis.';
            }
          })
          .catch(function () {
            msg.className = 'rounded-lg bg-amber-50 px-3 py-2 text-sm text-amber-800';
            msg.textContent = 'Netwerkfout.';
          })
          .finally(function () { btn.disabled = false; });
      });

      loadTickets();
    })();
  </script>
</PortalLayout>
