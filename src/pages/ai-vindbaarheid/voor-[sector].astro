---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { GEO_SECTORS } from '../../data/geo-sectors';

export function getStaticPaths() {
  return GEO_SECTORS.map((s) => ({ params: { sector: s.slug }, props: { sector: s } }));
}

const { sector } = Astro.props;
const url = `https://aanloopai.nl/ai-vindbaarheid/voor-${sector.slug}/`;

// Ring-rotatie: elke pagina linkt de 4 vólgende sectoren (wrap-around), zodat
// elke voor-*-pagina exact 4 inkomende zusterlinks krijgt — een vaste
// slice(0, 4) zou alle links naar dezelfde vier sturen.
const eigenIdx = GEO_SECTORS.findIndex((s) => s.slug === sector.slug);
const zusterSectoren = Array.from({ length: 4 }, (_, i) => GEO_SECTORS[(eigenIdx + 1 + i) % GEO_SECTORS.length]);

const factoren = [
  { titel: 'Consistentie', body: 'Naam, vakgebied en gegevens overal identiek — website, KvK, socials, directories.' },
  { titel: 'Vertrouwen', body: 'Reviews, vermeldingen op andere sites en een site die AI-crawlers kunnen lezen.' },
  { titel: 'Structuur', body: 'Schema.org-markup en een llms.txt, plus content die antwoord geeft op echte klantvragen.' },
];

const schema = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: `${sector.titel}: gevonden worden in ChatGPT, Gemini & Claude`,
  description: sector.intro.slice(0, 200),
  author: { '@type': 'Organization', '@id': 'https://aanloopai.nl/#organization', name: 'Aanloop AI' },
  publisher: { '@type': 'Organization', name: 'Aanloop AI', url: 'https://aanloopai.nl', logo: { '@type': 'ImageObject', url: 'https://aanloopai.nl/logo-mark-light-1024.png' } },
  datePublished: '2026-06-13', dateModified: '2026-06-13', inLanguage: 'nl-NL',
  mainEntityOfPage: url, articleSection: 'AI-vindbaarheid',
};
const faqSchema = sector.faq.map((f) => ({ question: f.q, answer: f.a }));
// Titel was `${sector.titel} — gevonden worden in ChatGPT | AI-vindbaarheid`.
// Met de langere sectortitels ("GEO voor reisbureaus & touroperators") liep dat
// op tot 89 tekens en kapte Google hem af. De variant hieronder blijft onder de
// 60 en houdt de zoekterm intact.
---
<BaseLayout
  title={`${sector.titel} in ChatGPT & Gemini`}
  description={`AI-vindbaarheid (GEO) voor de ${sector.naam}: word gevonden en aanbevolen in ChatGPT, Gemini en Claude. Doe de gratis GEO Quick Scan.`}
  schema={[schema]}
  faqSchema={faqSchema}
>
  <section class="border-b border-slate-200 hero-gradient">
    <div class="container-page py-16 lg:py-20">
      <div class="max-w-3xl">
        <div class="flex items-center gap-4 mb-6"><div class="accent-band"><span></span><span></span><span></span><span></span></div><span class="eyebrow">AI-vindbaarheid · {sector.naam}</span></div>
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tightest text-navy text-balance leading-[1.08]">{sector.emoji} {sector.titel}</h1>
        <p class="mt-6 text-lg text-slate-600 leading-relaxed">{sector.intro}</p>
        <div class="mt-8 flex flex-col sm:flex-row gap-3">
          <a href="/ai-vindbaarheid/check/" class="btn-primary text-base px-6 py-3.5">Gratis GEO Quick Scan</a>
          <a href="/ai-vindbaarheid/" class="btn-outline text-base px-6 py-3.5">Hoe werkt AI-vindbaarheid?</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page max-w-3xl mx-auto">
      <h2 class="text-2xl font-bold text-navy mb-4">Vragen die jouw klanten nu aan AI stellen</h2>
      <p class="text-slate-600 mb-6">Steeds vaker klinkt de zoekvraag zo — en de AI geeft maar een paar namen als antwoord:</p>
      <div class="space-y-3 mb-12">
        {sector.queries.map((q) => (
          <div class="flex items-start gap-3 rounded-xl border border-slate-200 bg-white p-4">
            <span class="text-brand-indigo text-lg leading-none mt-0.5">"</span>
            <p class="text-navy font-medium">{q}</p>
          </div>
        ))}
      </div>

      <h2 class="text-2xl font-bold text-navy mb-4">Waarom AI-vindbaarheid telt in deze sector</h2>
      <p class="text-slate-700 leading-relaxed mb-12">{sector.waarom}</p>

      <h2 class="text-2xl font-bold text-navy mb-6">Wat bepaalt of een AI jou noemt</h2>
      <div class="grid sm:grid-cols-3 gap-5 mb-12">
        {factoren.map((f) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <h3 class="font-bold text-navy">{f.titel}</h3>
            <p class="mt-2 text-sm text-slate-600 leading-relaxed">{f.body}</p>
          </div>
        ))}
      </div>

      <h2 class="text-2xl font-bold text-navy mb-6">Veelgestelde vragen</h2>
      <div class="space-y-4 mb-12">
        {sector.faq.map((item) => (
          <details class="group bg-white rounded-2xl border border-slate-200 p-6">
            <summary class="flex items-center justify-between cursor-pointer font-semibold text-navy list-none">{item.q}<span class="text-brand-indigo group-open:rotate-45 transition-transform text-2xl leading-none">+</span></summary>
            <p class="mt-4 text-slate-600 leading-relaxed">{item.a}</p>
          </details>
        ))}
      </div>

      <div class="rounded-2xl bg-navy text-white p-8 text-center">
        <h2 class="text-xl font-bold">Word jij al genoemd door AI?</h2>
        <p class="mt-2 text-slate-300 text-sm">Doe de gratis GEO Quick Scan en ontdek in 20 seconden hoe vindbaar jouw {sector.naam}-bedrijf is in ChatGPT, Gemini en Claude.</p>
        <div class="mt-5 flex flex-col sm:flex-row gap-3 justify-center">
          <a href="/ai-vindbaarheid/check/" class="btn-primary text-base px-6 py-3">Gratis GEO Quick Scan</a>
          <a href="/kennisbank/wat-is-geo-ai-vindbaarheid-mkb-nederland/" class="inline-flex items-center justify-center gap-2 rounded-lg border border-white/30 text-white font-semibold hover:bg-white/10 transition-colors text-base px-6 py-3">Wat is GEO?</a>
        </div>
      </div>

      <!-- Zusterpagina's: elke GEO-sectorpagina linkt naar 4 verwante
           sectoren + de hub, zodat geen enkele voor-*-pagina een wees is
           (crawl-links.mjs 2026-08-24: elk 1 inkomende link, alleen de hub). -->
      <div class="mt-10">
        <p class="eyebrow mb-4">AI-vindbaarheid per sector</p>
        <ul class="flex flex-wrap gap-2">
          {zusterSectoren.map((s) => (
            <li><a href={`/ai-vindbaarheid/voor-${s.slug}/`} class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white hover:bg-slate-50 border border-slate-200 hover:border-navy rounded-lg text-xs font-medium text-navy transition-all">Voor {s.naam}</a></li>
          ))}
          <li><a href="/ai-vindbaarheid/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white hover:bg-slate-50 border border-slate-200 hover:border-navy rounded-lg text-xs font-medium text-navy transition-all">Alle sectoren</a></li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
