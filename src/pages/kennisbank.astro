---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { KENNISBANK_ARTICLES } from '../data/kennisbank-articles';

const categories = ['Alle', 'Uitleg', 'Gids', 'Finance', 'Sector', 'Vergelijk', 'Technisch'];

// Merge markdown kennisbank articles (src/content/kennisbank/*.md) into the
// existing hand-written listing — dropping one .md file is meant to be all it
// takes to publish. The existing data array always wins on a slug collision
// (a markdown drop must never shadow a live URL). Existing entries have no
// stable chronological order (manually curated), so that order is preserved
// as-is and markdown articles — freshly authored — are prepended at the top,
// newest-first among themselves.
const existingSlugs = new Set(KENNISBANK_ARTICLES.map((a) => a.slug));
const dateFmt = (d: Date) => d.toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' });
const mdEntries = await getCollection('kennisbank', ({ data }) => !data.draft);
const mdArticles = mdEntries
  .filter((entry) => !existingSlugs.has(entry.slug))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf())
  .map((entry) => ({
    slug: entry.slug,
    category: entry.data.category,
    categoryColor: 'bg-slate-100 text-slate-600',
    title: entry.data.title,
    excerpt: entry.data.excerpt,
    readTime: entry.data.readingMinutes ? `${entry.data.readingMinutes} min` : '—',
    date: dateFmt(entry.data.published),
  }));
const articles = [...mdArticles, ...KENNISBANK_ARTICLES];

// ── CollectionPage + ItemList schema for rich results ──────────────
const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': 'https://aanloopai.nl/kennisbank/#collection',
  name: 'Kennisbank Aanloop AI',
  description: 'Praktische gidsen, uitleg en vergelijkingen over AI voor het Nederlandse MKB.',
  url: 'https://aanloopai.nl/kennisbank/',
  inLanguage: 'nl-NL',
  isPartOf: { '@type': 'WebSite', '@id': 'https://aanloopai.nl/#website' },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: articles.length,
    itemListElement: articles.map((a, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: `https://aanloopai.nl/kennisbank/${a.slug}/`,
      name: a.title,
    })),
  },
};
---

<BaseLayout
  title="Kennisbank AI voor MKB — Gidsen, Uitleg & Tips"
  description="Praktische kennisbank over AI automatisering voor het Nederlandse MKB. Gidsen over AI agents, AI telefoonassistent, workflow automatisering en meer."
  schema={collectionSchema}
>
  <!-- Hero -->
  <section class="border-b border-slate-200 hero-gradient">
    <div class="container-page py-16 lg:py-20">
      <div class="max-w-3xl">
        <div class="flex items-center gap-4 mb-6 reveal">
          <div class="accent-band"><span></span><span></span><span></span><span></span></div>
          <span class="eyebrow">Kennisbank</span>
        </div>
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tightest text-navy text-balance leading-[1.05] reveal reveal-delay-1">
          Alles wat u wilt weten over AI voor uw bedrijf.
        </h1>
        <p class="mt-4 text-lg text-slate-600 leading-relaxed reveal reveal-delay-2">
          Praktische artikelen, gidsen en uitleg — geschreven voor ondernemers, niet voor technici.
        </p>

        <!-- Hier stond een tweede zoekveld met dezelfde id "blog-search".
             getElementById pakte dit hero-veld, waardoor het uitgebreidere
             zoekveld boven de artikellijst (met wisknop, artikelteller en
             aria-label) nergens aan gekoppeld was en dus niets deed. -->
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page">
      <!-- Search input -->
      <div class="mb-6 reveal">
        <div class="relative max-w-2xl">
          <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35m0 0A7.5 7.5 0 103.5 3.5a7.5 7.5 0 0013.15 13.15z" />
          </svg>
          <input
            id="blog-search"
            type="search"
            placeholder={`Zoek in ${articles.length} kennisbank-artikelen — bijv. 'rijschool', 'no-show', 'AVG', 'WhatsApp'`}
            class="w-full pl-12 pr-4 py-3 rounded-2xl border border-slate-200 bg-white text-sm focus:outline-none focus:border-navy focus:ring-2 focus:ring-navy/10 transition-all"
            aria-label="Zoek in kennisbank-artikelen"
          />
          <button
            id="search-clear"
            type="button"
            class="absolute right-3 top-1/2 -translate-y-1/2 hidden text-slate-400 hover:text-navy text-xs px-2 py-1"
            aria-label="Zoekopdracht wissen"
          >
            wissen
          </button>
        </div>
        <p id="result-count" class="mt-3 text-xs text-slate-500" aria-live="polite"></p>
      </div>

      <!-- Category filter -->
      <div class="flex flex-wrap gap-2 mb-10 reveal">
        {categories.map((cat, i) => (
          <button
            class:list={[
              'category-filter px-4 py-1.5 rounded-full text-xs font-medium border transition-all',
              i === 0 ? 'bg-navy text-white border-navy' : 'border-slate-200 text-slate-600 hover:border-navy hover:text-navy'
            ]}
            data-category={cat}
          >
            {cat}
          </button>
        ))}
      </div>

      <!-- No results message -->
      <div id="no-results" class="hidden text-center py-12 text-slate-500">
        <p class="text-lg font-semibold text-navy mb-2">Geen artikelen gevonden</p>
        <p class="text-sm">Probeer een andere zoekterm of categorie.</p>
      </div>

      <!-- Articles grid -->
      <div id="articles-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {articles.map((article, i) => (
          <article
            class={`card card-interactive flex flex-col reveal reveal-delay-${(i % 3) + 1}`}
            data-category={article.category}
          >
            <div class="flex items-center justify-between mb-4">
              <span class:list={['pill text-[11px]', article.categoryColor]}>{article.category}</span>
              <span class="text-xs text-slate-400">{article.readTime} leestijd</span>
            </div>
            <h2 class="text-base font-bold text-navy leading-snug mb-3 flex-1">
              <a href={`/kennisbank/${article.slug}/`} class="hover:text-brand-indigo transition-colors">
                {article.title}
              </a>
            </h2>
            <p class="text-sm text-slate-600 leading-relaxed mb-4">{article.excerpt}</p>
            <div class="flex items-center justify-between pt-4 border-t border-slate-100">
              <span class="text-xs text-slate-400">{article.date}</span>
              <a href={`/kennisbank/${article.slug}/`} class="text-xs font-medium text-brand-indigo hover:underline flex items-center gap-1" aria-label={`Lees: ${article.title}`}>
                Lees gids
                <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
              </a>
            </div>
          </article>
        ))}
      </div>

      <!-- Newsletter CTA -->
      <div class="mt-16 card bg-slate-900 text-pearl reveal">
        <div class="grid lg:grid-cols-2 gap-8 items-center">
          <div>
            <p class="eyebrow text-slate-400 mb-2">Nieuwsbrief</p>
            <h2 class="text-2xl font-bold text-pearl mb-2">Wekelijkse AI-inzichten in uw inbox.</h2>
            <p class="text-sm text-slate-400 leading-relaxed">Elke week één praktisch artikel over AI voor MKB. Geen spam, altijd afmeldbaar.</p>
          </div>
          <form id="newsletter-form" class="flex flex-col sm:flex-row gap-3" novalidate>
            <input
              type="email"
              id="newsletter-email"
              placeholder="uw@email.nl"
              required
              class="flex-1 px-4 py-2.5 rounded-xl bg-slate-800 border border-slate-700 text-pearl placeholder-slate-500 text-sm focus:outline-none focus:ring-2 focus:ring-brand-indigo"
            />
            <button type="submit" class="btn bg-pearl text-navy hover:bg-white text-sm px-6 whitespace-nowrap">
              Inschrijven
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Combined category filter + search
  const filters = document.querySelectorAll('.category-filter');
  const articles = document.querySelectorAll('#articles-grid article');
  const searchInput = document.getElementById('blog-search') as HTMLInputElement | null;
  const searchClear = document.getElementById('search-clear') as HTMLButtonElement | null;
  const resultCount = document.getElementById('result-count') as HTMLParagraphElement | null;
  const noResults = document.getElementById('no-results') as HTMLDivElement | null;
  const totalArticles = articles.length;

  let activeCategory = 'Alle';
  let activeQuery = '';

  function applyFilters() {
    const q = activeQuery.toLowerCase().trim();
    let visible = 0;
    articles.forEach((article) => {
      const el = article as HTMLElement;
      const articleCat = el.dataset.category || '';
      const text = (el.textContent || '').toLowerCase();
      const matchesCategory = activeCategory === 'Alle' || articleCat === activeCategory;
      const matchesQuery = q === '' || text.includes(q);
      const show = matchesCategory && matchesQuery;
      el.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    if (resultCount) {
      if (q === '' && activeCategory === 'Alle') {
        resultCount.textContent = `${totalArticles} artikelen`;
      } else {
        resultCount.textContent = `${visible} van ${totalArticles} artikelen — ${activeCategory}${q ? ` — zoekt: "${activeQuery}"` : ''}`;
      }
    }
    if (noResults) {
      noResults.classList.toggle('hidden', visible !== 0);
    }
    if (searchClear) {
      searchClear.classList.toggle('hidden', q === '');
    }
  }

  filters.forEach((btn) => {
    btn.addEventListener('click', () => {
      activeCategory = (btn as HTMLElement).dataset.category || 'Alle';
      filters.forEach((b) => {
        b.classList.remove('bg-navy', 'text-white', 'border-navy');
        b.classList.add('border-slate-200', 'text-slate-600');
      });
      btn.classList.add('bg-navy', 'text-white', 'border-navy');
      btn.classList.remove('border-slate-200', 'text-slate-600');
      applyFilters();
    });
  });

  searchInput?.addEventListener('input', () => {
    activeQuery = searchInput.value;
    applyFilters();
  });

  searchClear?.addEventListener('click', () => {
    if (searchInput) {
      searchInput.value = '';
      activeQuery = '';
      searchInput.focus();
      applyFilters();
    }
  });

  // Initial render
  applyFilters();

  // Newsletter (Brevo via /api/submit — sends to hello@aanloopai.nl + autoresponse to user)
  document.getElementById('newsletter-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const btn = form.querySelector('button') as HTMLButtonElement;
    const emailEl = document.getElementById('newsletter-email') as HTMLInputElement;
    const email = emailEl?.value;
    if (!email || !email.includes('@')) return;
    btn.textContent = 'Versturen…';
    btn.disabled = true;
    const data = new FormData();
    data.append('form_type', 'newsletter');
    data.append('subject', 'Nieuwe nieuwsbrief-aanmelding (kennisbank) — aanloopai.nl');
    data.append('email', email);
    data.append('source', 'Kennisbank newsletter signup');
    const ctrl = new AbortController();
    const tid = setTimeout(() => ctrl.abort(), 30000);
    try {
      const res = await fetch('/api/submit', { method: 'POST', body: data, signal: ctrl.signal });
      clearTimeout(tid);
      const json = await res.json().catch(() => ({ success: false }));
      if (res.ok && json.success) {
        (window as any)._track?.('generate_lead', { form_name: 'kennisbank_newsletter' });
        btn.textContent = '✓ Ingeschreven!';
      } else {
        throw new Error(json.message || `HTTP ${res.status}`);
      }
    } catch (err: any) {
      clearTimeout(tid);
      console.error('KB newsletter error:', err);
      const isTimeout = err?.name === 'AbortError';
      btn.textContent = isTimeout ? '⏱ Te lang — opnieuw' : 'Probeer opnieuw';
      btn.disabled = false;
    }
  });
</script>
