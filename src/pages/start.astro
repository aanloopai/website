---
import BaseLayout from '../layouts/BaseLayout.astro';

// Pre-sale intake wizard — evolution of gratis-ai-scan.astro (lead-gen quiz).
// This page is the PURCHASE-INTENT intake: bezoeker koos al voor een dienst en
// wil starten. Geen score, geen prijs op deze pagina (prijsmatrix leeft in
// src/data/pricing.ts + /tarieven/ + /aanvragen/ — dit is puur intake-capture).
// Service-ids matchen 1:1 de fleetclaw services-tabel: agenda-assistant,
// voice-agent, whatsapp-bot, ai-scan-consult. Submit -> POST /api/intake
// (src/worker.js: handleIntake) -> D1 (migrations/0014_intake_requests.sql)
// -> best-effort forward naar Hetzner (INTAKE_WEBHOOK_URL, HMAC-signed).
const services = [
  {
    id: 'agenda-assistant',
    icon: '📅',
    title: 'Agenda-assistent',
    desc: 'AI die afspraken inplant, uw agenda beheert en no-shows terugdringt met automatische herinneringen.',
  },
  {
    id: 'voice-agent',
    icon: '📞',
    title: 'Voice-agent (AI-telefonie)',
    desc: 'AI-receptionist die uw telefoon 24/7 opneemt, gesprekken afhandelt en leads vastlegt.',
  },
  {
    id: 'whatsapp-bot',
    icon: '💬',
    title: 'WhatsApp-bot',
    desc: 'Automatische, natuurlijke antwoorden op WhatsApp — 24/7 bereikbaar voor uw klanten.',
  },
  {
    id: 'ai-scan-consult',
    icon: '🧭',
    title: 'AI-scan / adviesgesprek',
    desc: 'Persoonlijk adviesgesprek: welke AI-oplossing past het beste bij uw bedrijf.',
  },
];

const toolSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Start direct — intake-wizard Aanloop AI',
  url: 'https://aanloopai.nl/start/',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'All (browser-based)',
  inLanguage: 'nl-NL',
  isAccessibleForFree: true,
  creator: { '@type': 'Organization', '@id': 'https://aanloopai.nl/#organization', name: 'Aanloop AI', url: 'https://aanloopai.nl' },
};
---

<BaseLayout
  title="Start direct"
  description="Kies uw AI-dienst, beantwoord een paar korte vragen en wij nemen binnen 1 werkdag contact op. Geen verplichtingen."
  schema={[toolSchema]}
  noindex={true}
>
  <!-- Hero -->
  <section class="border-b border-slate-200 hero-gradient">
    <div class="container-page py-16 lg:py-20">
      <div class="max-w-3xl">
        <div class="flex items-center gap-4 mb-6 reveal">
          <div class="accent-band"><span></span><span></span><span></span><span></span></div>
          <span class="eyebrow">Start direct · 2 minuten</span>
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tightest text-navy text-balance leading-[1.05] reveal reveal-delay-1">
          Start uw AI-aanvraag
        </h1>
        <p class="mt-6 text-lg lg:text-xl text-slate-600 leading-relaxed text-pretty max-w-2xl reveal reveal-delay-2">
          Kies de dienst waar u mee wilt starten, beantwoord een paar korte vragen — wij nemen binnen 1 werkdag contact op om de vervolgstappen te bespreken.
        </p>
        <div class="mt-8 flex flex-wrap gap-6 text-sm text-slate-600 reveal reveal-delay-3">
          {[
            'Geen verplichtingen',
            'Binnen 1 werkdag contact',
            'AVG-compliant — data blijft in NL',
          ].map(t => (
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-brand-emerald flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              {t}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Wizard -->
  <section class="section bg-slate-50 border-b border-slate-200" id="start">
    <div class="container-page max-w-3xl mx-auto">
      <form id="start-form" novalidate>
        <div id="start-wizard" class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-8 shadow-sm reveal" aria-live="polite">

          <!-- Progress bar -->
          <div class="mb-6">
            <div class="flex justify-between items-center text-xs font-medium text-slate-500 mb-2">
              <span><span id="start-step-current">1</span> van <span id="start-step-total">3</span></span>
              <span id="start-progress-label">33% afgerond</span>
            </div>
            <div class="w-full h-2 rounded-full bg-slate-100 overflow-hidden">
              <div id="start-progress-bar" class="h-full rounded-full bg-brand-indigo transition-all duration-300" style="width: 33%"></div>
            </div>
          </div>

          <!-- Step 0: dienst-keuze -->
          <fieldset class="start-step" data-step="0">
            <legend class="block text-lg sm:text-xl font-bold text-navy mb-1">Waarmee wilt u starten?</legend>
            <p class="text-sm text-slate-500 mb-5">Kies één dienst — de vragen op de volgende stap zijn hierop afgestemd.</p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" id="start-service-cards">
              {services.map(s => (
                <button
                  type="button"
                  class="start-service-card text-left p-4 rounded-xl border border-slate-200 bg-white hover:border-brand-indigo hover:bg-brand-indigo/5 transition-colors"
                  data-service-id={s.id}
                  aria-pressed="false"
                >
                  <div class="text-2xl mb-2" aria-hidden="true">{s.icon}</div>
                  <p class="font-bold text-navy text-sm">{s.title}</p>
                  <p class="text-xs text-slate-500 mt-1 leading-relaxed">{s.desc}</p>
                </button>
              ))}
            </div>
          </fieldset>

          <!-- Step 1: dienst-specifieke vragen (dynamisch ingevuld door SERVICE_QUESTIONS) -->
          <fieldset class="start-step hidden" data-step="1">
            <legend class="block text-lg sm:text-xl font-bold text-navy mb-1">Nog een paar korte vragen</legend>
            <p id="start-service-intro" class="text-sm text-slate-500 mb-5">—</p>
            <div id="start-service-fields"></div>
          </fieldset>

          <!-- Step 2: contactgegevens + consent -->
          <fieldset class="start-step hidden" data-step="2">
            <legend class="block text-lg sm:text-xl font-bold text-navy mb-1">Uw gegevens</legend>
            <p class="text-sm text-slate-500 mb-5">Zodat we contact met u kunnen opnemen — geen prijsverplichting.</p>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-3">
              <div>
                <label for="start-bedrijfsnaam" class="block text-sm font-semibold text-navy mb-1.5">Bedrijfsnaam *</label>
                <input type="text" id="start-bedrijfsnaam" name="bedrijfsnaam" required
                  class="w-full px-3 py-2.5 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-brand-indigo focus:outline-none" />
              </div>
              <div>
                <label for="start-naam" class="block text-sm font-semibold text-navy mb-1.5">Naam *</label>
                <input type="text" id="start-naam" name="naam" required
                  class="w-full px-3 py-2.5 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-brand-indigo focus:outline-none" />
              </div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-3">
              <div>
                <label for="start-email" class="block text-sm font-semibold text-navy mb-1.5">E-mailadres *</label>
                <input type="email" id="start-email" name="email" required
                  class="w-full px-3 py-2.5 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-brand-indigo focus:outline-none" />
              </div>
              <div>
                <label for="start-telefoon" class="block text-sm font-semibold text-navy mb-1.5">Telefoonnummer <span class="font-normal text-slate-400">(optioneel)</span></label>
                <input type="tel" id="start-telefoon" name="telefoon"
                  class="w-full px-3 py-2.5 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-brand-indigo focus:outline-none" />
              </div>
            </div>
            <div class="mb-4 max-w-[200px]">
              <label for="start-taal" class="block text-sm font-semibold text-navy mb-1.5">Taal</label>
              <select id="start-taal" name="taal"
                class="w-full px-3 py-2.5 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-brand-indigo focus:outline-none bg-white">
                <option value="nl" selected>Nederlands</option>
                <option value="en">Engels</option>
              </select>
            </div>

            <label class="flex items-start gap-2 text-xs text-slate-600 leading-relaxed cursor-pointer mt-4">
              <input type="checkbox" id="start-consent" name="consent" required class="mt-0.5 w-4 h-4 accent-brand-indigo flex-shrink-0" />
              <span>
                Ik ga akkoord met het verwerken van mijn gegevens om mijn aanvraag te behandelen, een voorstel op te stellen (waarbij mijn antwoorden door een AI-model worden verwerkt) en op mijn verzoek een account aan te maken. Zie het <a href="/privacy/" class="text-brand-indigo hover:underline">privacybeleid</a>.
              </span>
            </label>
          </fieldset>

          <!-- Validation message -->
          <p id="start-validation" class="hidden mt-4 text-sm text-red-600" role="alert"></p>

          <!-- Navigation -->
          <div class="mt-8 flex items-center justify-between">
            <button
              type="button"
              id="start-prev-btn"
              class="text-sm font-semibold text-slate-500 hover:text-navy disabled:opacity-30 disabled:cursor-not-allowed transition-colors"
              disabled
            >
              ← Vorige
            </button>
            <button
              type="button"
              id="start-next-btn"
              class="btn-primary text-sm justify-center px-6 py-3 hidden"
            >
              <span id="start-next-label">Volgende</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </button>
            <button
              type="button"
              id="start-submit-btn"
              class="btn-primary text-sm justify-center px-6 py-3 hidden"
            >
              <span id="start-submit-label">Aanvraag versturen →</span>
            </button>
          </div>
        </div>
      </form>

      <!-- Success -->
      <div id="start-success" class="hidden mt-8">
        <div class="bg-navy text-pearl rounded-2xl p-8 sm:p-10 shadow-lg relative overflow-hidden">
          <div class="absolute inset-0 dot-grid opacity-[0.04]"></div>
          <div class="relative">
            <p class="text-xs font-semibold uppercase tracking-widest text-brand-emerald mb-2">Aanvraag ontvangen</p>
            <h2 class="text-2xl sm:text-3xl font-bold text-pearl mb-3">We nemen binnen 1 werkdag contact met u op</h2>
            <p class="text-slate-300 text-sm leading-relaxed">Uw aanvraag staat veilig bij ons geregistreerd. Zo gaat het nu verder:</p>
          </div>
        </div>
        <div class="mt-6 bg-white border border-slate-200 rounded-2xl p-6 sm:p-8">
          <ol class="space-y-4">
            {[
              { t: 'Wij bekijken uw aanvraag', d: 'Ons team beoordeelt uw antwoorden en bereidt een gericht voorstel voor.' },
              { t: 'Persoonlijk contact binnen 1 werkdag', d: 'Telefonisch of per e-mail — wat u het prettigst vindt.' },
              { t: 'Samen de vervolgstappen bepalen', d: 'Geen verplichtingen — u beslist zelf of en hoe u verdergaat.' },
            ].map((s, idx) => (
              <li class="flex items-start gap-3">
                <span class="flex-shrink-0 w-6 h-6 rounded-full bg-brand-indigo text-white text-xs font-bold flex items-center justify-center mt-0.5">{idx + 1}</span>
                <div>
                  <p class="text-sm font-semibold text-navy">{s.t}</p>
                  <p class="text-xs text-slate-500 mt-0.5">{s.d}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
        <div class="mt-6 bg-brand-indigo/5 border border-brand-indigo/20 rounded-2xl p-6 text-center">
          <p class="text-xs text-slate-600 mb-4">Liever nu direct spreken? We zijn bereikbaar via telefoon of WhatsApp.</p>
          <div class="flex flex-wrap gap-3 justify-center">
            <a href="tel:+31624741597" class="btn-primary text-sm justify-center inline-flex">Bel +31 6 24 74 15 97</a>
            <a href="https://wa.me/31624741597" class="btn border border-slate-200 text-navy hover:bg-slate-50 text-sm justify-center inline-flex">WhatsApp ons</a>
          </div>
        </div>
      </div>

      <!-- noscript fallback -->
      <noscript>
        <div class="mt-6 bg-amber-50 border border-amber-200 rounded-2xl p-6 text-sm text-slate-700">
          <p class="font-bold text-navy mb-2">JavaScript is uitgeschakeld</p>
          <p>De intake-wizard vereist JavaScript. Stuur ons in plaats daarvan een mail naar <a href="mailto:hello@aanloopai.nl" class="text-brand-indigo underline">hello@aanloopai.nl</a> of bel <a href="tel:+31624741597" class="text-brand-indigo underline">+31 6 24 74 15 97</a> om direct te starten.</p>
        </div>
      </noscript>
    </div>
  </section>
</BaseLayout>

<script>
  // ============================================================================
  // Start direct — intake-wizard: dienst-keuze -> dienst-specifieke vragen ->
  // contactgegevens -> POST /api/intake. Geen score, geen prijs — puur intake.
  // ============================================================================

  type ServiceId = 'agenda-assistant' | 'voice-agent' | 'whatsapp-bot' | 'ai-scan-consult';

  function trackEvent(eventName: string, params: Record<string, unknown> = {}): void {
    try {
      const w = window as unknown as { dataLayer?: unknown[]; gtag?: (...args: unknown[]) => void };
      if (w.dataLayer && Array.isArray(w.dataLayer)) {
        w.dataLayer.push({ event: eventName, ...params });
      }
      if (typeof w.gtag === 'function') {
        w.gtag('event', eventName, params);
      }
    } catch {
      // No-op — analytics fout mag de wizard niet breken
    }
  }

  interface StartField {
    name: string;
    label: string;
    type: 'text' | 'textarea' | 'tel' | 'select';
    required?: boolean;
    options?: string[];
    placeholder?: string;
    hint?: string;
  }

  // Client-side config object — dienst-specifieke vragen (Stap 2). Eén blok per
  // service-id, ids matchen 1:1 de fleetclaw services-tabel.
  const SERVICE_QUESTIONS: Record<ServiceId, StartField[]> = {
    'agenda-assistant': [
      { name: 'agenda_provider', label: 'Welke agenda gebruikt u?', type: 'select', required: true, options: ['Google Agenda', 'Outlook / Microsoft 365', 'Anders'] },
      { name: 'werkuren', label: 'Werkuren / openingstijden', type: 'textarea', required: true, placeholder: 'bijv. Ma-Vr 09:00-17:00' },
      { name: 'afspraaktypes', label: 'Welke afspraaktypes moet de assistent inplannen?', type: 'textarea', required: true, placeholder: 'bijv. intake, vervolgafspraak, kennismaking' },
      { name: 'talen', label: 'In welke taal/talen moet de assistent werken?', type: 'text', required: true, placeholder: 'bijv. Nederlands, Engels' },
      { name: 'nummer_overdracht', label: 'Wilt u uw bestaande telefoonnummer overdragen?', type: 'select', required: true, options: ['Ja', 'Nee', 'Weet ik nog niet'] },
    ],
    'voice-agent': [
      { name: 'huidige_lijn', label: 'Huidig telefoonnummer / lijn', type: 'tel', required: true, placeholder: '+31 6 12345678' },
      { name: 'call_volume', label: 'Verwacht aantal gesprekken per dag', type: 'select', required: true, options: ['Minder dan 10', '10-30', '30-75', 'Meer dan 75'] },
      { name: 'openingstoon', label: 'Gewenste toon van het openingsbericht', type: 'select', required: true, options: ['Formeel', 'Zakelijk en warm', 'Informeel'] },
      {
        name: 'gemiste_gesprekken_week',
        label: 'Hoeveel telefoontjes mist u ongeveer per week?',
        type: 'select',
        required: true,
        options: ['1', '3', '5', '10', '20'],
        hint: 'Een ruwe schatting is genoeg — hiermee rekenen we uw gemiste omzet uit.',
      },
      {
        name: 'gemiddelde_klantwaarde',
        label: 'Wat levert een nieuwe klant u gemiddeld op (in euro)?',
        type: 'select',
        required: false,
        options: ['150', '400', '750', '1500', '5000'],
        hint: 'Laat leeg als u het niet weet; we tonen dan een bandbreedte.',
      },
    ],
    'whatsapp-bot': [
      { name: 'whatsapp_business', label: 'Heeft u al een WhatsApp Business-account?', type: 'select', required: true, options: ['Ja', 'Nee', 'Weet ik niet'] },
      { name: 'veelgestelde_vragen', label: 'Wat zijn uw meest gestelde vragen?', type: 'textarea', required: true, placeholder: 'Eén vraag per regel' },
    ],
    'ai-scan-consult': [
      { name: 'voorkeursdatum', label: 'Voorkeursdatum / -periode voor het gesprek', type: 'text', required: false, placeholder: 'bijv. volgende week dinsdag, of "zo snel mogelijk"' },
    ],
  };

  const SERVICE_LABELS: Record<ServiceId, string> = {
    'agenda-assistant': 'Agenda-assistent',
    'voice-agent': 'Voice-agent (AI-telefonie)',
    'whatsapp-bot': 'WhatsApp-bot',
    'ai-scan-consult': 'AI-scan / adviesgesprek',
  };

  document.addEventListener('DOMContentLoaded', () => {
    const wizard = document.getElementById('start-wizard');
    const success = document.getElementById('start-success');
    const form = document.getElementById('start-form') as HTMLFormElement | null;
    if (!wizard || !success || !form) return;

    const steps = Array.from(document.querySelectorAll<HTMLFieldSetElement>('.start-step'));
    const totalSteps = steps.length;

    const prevBtn = document.getElementById('start-prev-btn') as HTMLButtonElement;
    const nextBtn = document.getElementById('start-next-btn') as HTMLButtonElement;
    const submitBtn = document.getElementById('start-submit-btn') as HTMLButtonElement;
    const submitLabel = document.getElementById('start-submit-label') as HTMLElement;
    const progressBar = document.getElementById('start-progress-bar') as HTMLElement;
    const progressLabel = document.getElementById('start-progress-label') as HTMLElement;
    const stepCurrent = document.getElementById('start-step-current') as HTMLElement;
    const stepTotal = document.getElementById('start-step-total') as HTMLElement;
    const validation = document.getElementById('start-validation') as HTMLElement;
    const serviceFields = document.getElementById('start-service-fields') as HTMLElement;
    const serviceIntro = document.getElementById('start-service-intro') as HTMLElement;

    let current = 0;
    let selectedService: ServiceId | null = null;
    let startedTracked = false;

    stepTotal.textContent = String(totalSteps);

    function renderProgress(i: number): void {
      const pct = Math.round(((i + 1) / totalSteps) * 100);
      progressBar.style.width = `${pct}%`;
      progressLabel.textContent = `${pct}% afgerond`;
      stepCurrent.textContent = String(i + 1);
      prevBtn.disabled = i === 0;
      nextBtn.classList.toggle('hidden', i === 0 || i === totalSteps - 1);
      submitBtn.classList.toggle('hidden', i !== totalSteps - 1);
    }

    function showStep(i: number): void {
      steps.forEach((step, idx) => {
        step.classList.toggle('hidden', idx !== i);
      });
      validation.classList.add('hidden');
      renderProgress(i);
      if (i > 0) {
        wizard?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }

    // Bouwt Stap 2 dynamisch op uit SERVICE_QUESTIONS voor de gekozen dienst.
    function renderServiceFields(serviceId: ServiceId): void {
      serviceFields.innerHTML = '';
      serviceIntro.textContent = `Een paar korte vragen over ${SERVICE_LABELS[serviceId]} — zodat we direct van start kunnen.`;
      const fields = SERVICE_QUESTIONS[serviceId] || [];

      if (fields.length === 0) {
        const p = document.createElement('p');
        p.className = 'text-sm text-slate-500';
        p.textContent = 'Geen extra vragen nodig voor deze dienst — verder naar uw gegevens.';
        serviceFields.appendChild(p);
        return;
      }

      fields.forEach((f) => {
        const wrap = document.createElement('div');
        wrap.className = 'mb-4';

        const label = document.createElement('label');
        label.className = 'block text-sm font-semibold text-navy mb-1.5';
        label.textContent = f.label + (f.required ? ' *' : '');
        label.htmlFor = `sf-${f.name}`;
        wrap.appendChild(label);

        const baseClass = 'w-full px-3 py-2.5 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-brand-indigo focus:outline-none';
        let input: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;

        if (f.type === 'textarea') {
          const ta = document.createElement('textarea');
          ta.id = `sf-${f.name}`;
          ta.name = f.name;
          ta.rows = 3;
          ta.className = baseClass;
          if (f.placeholder) ta.placeholder = f.placeholder;
          if (f.required) ta.required = true;
          input = ta;
        } else if (f.type === 'select') {
          const sel = document.createElement('select');
          sel.id = `sf-${f.name}`;
          sel.name = f.name;
          sel.className = `${baseClass} bg-white`;
          if (f.required) sel.required = true;
          const empty = document.createElement('option');
          empty.value = '';
          empty.textContent = 'Kies...';
          sel.appendChild(empty);
          (f.options || []).forEach((opt) => {
            const o = document.createElement('option');
            o.value = opt;
            o.textContent = opt;
            sel.appendChild(o);
          });
          input = sel;
        } else {
          const inp = document.createElement('input');
          inp.type = f.type === 'tel' ? 'tel' : 'text';
          inp.id = `sf-${f.name}`;
          inp.name = f.name;
          inp.className = baseClass;
          if (f.placeholder) inp.placeholder = f.placeholder;
          if (f.required) inp.required = true;
          input = inp;
        }

        wrap.appendChild(input);

        if (f.hint) {
          const hint = document.createElement('p');
          hint.className = 'mt-1 text-xs text-slate-500';
          hint.textContent = f.hint;
          wrap.appendChild(hint);
        }

        serviceFields.appendChild(wrap);
      });
    }

    function selectService(id: ServiceId, cardEl: HTMLElement): void {
      selectedService = id;
      document.querySelectorAll<HTMLElement>('.start-service-card').forEach((el) => {
        const isSelected = el === cardEl;
        el.classList.toggle('border-brand-indigo', isSelected);
        el.classList.toggle('bg-brand-indigo/5', isSelected);
        el.classList.toggle('ring-2', isSelected);
        el.classList.toggle('ring-brand-indigo/30', isSelected);
        el.setAttribute('aria-pressed', isSelected ? 'true' : 'false');
      });
      renderServiceFields(id);

      if (!startedTracked) {
        startedTracked = true;
        trackEvent('intake_started', { service_id: id });
      }
    }

    document.querySelectorAll<HTMLButtonElement>('.start-service-card').forEach((card) => {
      card.addEventListener('click', () => {
        const id = card.getAttribute('data-service-id') as ServiceId | null;
        if (!id) return;
        selectService(id, card);
        validation.classList.add('hidden');
        // Auto-advance, zelfde patroon als de radio-auto-advance in gratis-ai-scan.astro
        window.setTimeout(() => {
          if (current === 0) nextStep();
        }, 300);
      });
    });

    function validateStep(stepIdx: number): { ok: boolean; message?: string } {
      if (stepIdx === 0) {
        if (!selectedService) return { ok: false, message: 'Kies eerst een dienst om door te gaan.' };
        return { ok: true };
      }
      const step = steps[stepIdx];
      const requiredInputs = Array.from(
        step.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>('[required]')
      );
      for (const el of requiredInputs) {
        if (el instanceof HTMLInputElement && el.type === 'checkbox') {
          if (!el.checked) return { ok: false, message: 'Ga akkoord met de gegevensverwerking om door te gaan.' };
          continue;
        }
        if (el instanceof HTMLInputElement && el.type === 'email') {
          if (!el.value.trim() || !el.checkValidity()) return { ok: false, message: 'Vul een geldig e-mailadres in.' };
          continue;
        }
        if (!el.value || !String(el.value).trim()) {
          return { ok: false, message: 'Vul alle verplichte velden in om door te gaan.' };
        }
      }
      return { ok: true };
    }

    function collectServiceAnswers(): Record<string, string> {
      const answers: Record<string, string> = {};
      if (!selectedService) return answers;
      const fields = SERVICE_QUESTIONS[selectedService] || [];
      fields.forEach((f) => {
        const el = document.getElementById(`sf-${f.name}`) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null;
        if (el) answers[f.name] = el.value.trim();
      });
      return answers;
    }

    function nextStep(): void {
      const v = validateStep(current);
      if (!v.ok) {
        validation.textContent = v.message || 'Vul deze stap eerst in.';
        validation.classList.remove('hidden');
        return;
      }
      trackEvent('intake_step', { step: current + 1, service_id: selectedService });
      if (current === totalSteps - 1) return;
      current += 1;
      showStep(current);
    }

    function prevStep(): void {
      if (current === 0) return;
      current -= 1;
      showStep(current);
    }

    nextBtn.addEventListener('click', nextStep);
    prevBtn.addEventListener('click', prevStep);

    // ============================================================================
    // Submit
    // ============================================================================
    async function submitIntake(): Promise<void> {
      const v = validateStep(current);
      if (!v.ok) {
        validation.textContent = v.message || 'Vul alle verplichte velden in.';
        validation.classList.remove('hidden');
        return;
      }
      if (!selectedService) return;

      submitBtn.disabled = true;
      submitLabel.textContent = 'Versturen…';
      validation.classList.add('hidden');

      const bedrijfsnaam = (document.getElementById('start-bedrijfsnaam') as HTMLInputElement).value.trim();
      const naam = (document.getElementById('start-naam') as HTMLInputElement).value.trim();
      const email = (document.getElementById('start-email') as HTMLInputElement).value.trim();
      const telefoon = (document.getElementById('start-telefoon') as HTMLInputElement).value.trim();
      const taal = (document.getElementById('start-taal') as HTMLSelectElement).value || 'nl';

      const payload = {
        service_id: selectedService,
        customer: {
          company: bedrijfsnaam,
          name: naam,
          email,
          phone: telefoon,
          lang: taal,
        },
        answers: collectServiceAnswers(),
        consent: true,
      };

      const ctrl = new AbortController();
      const tid = window.setTimeout(() => ctrl.abort(), 30000);

      try {
        const res = await fetch('/api/intake', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload),
          signal: ctrl.signal,
        });
        clearTimeout(tid);
        const data = await res.json().catch(() => ({ success: false, message: 'Ongeldig antwoord' }));

        if (res.ok && data.success) {
          trackEvent('intake_submitted', { service_id: selectedService });
          trackEvent('generate_lead', { form_name: 'start_intake', currency: 'EUR', value: 150 });
          if (data.voorstel_token) {
            window.location.href = `/start/voorstel/?t=${encodeURIComponent(data.voorstel_token)}`;
            return;
          }
          wizard?.classList.add('hidden');
          success?.classList.remove('hidden');
          success?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        } else {
          validation.textContent = data.message || 'Versturen mislukt — probeer opnieuw of mail hello@aanloopai.nl.';
          validation.classList.remove('hidden');
        }
      } catch (err: any) {
        clearTimeout(tid);
        const isTimeout = err?.name === 'AbortError';
        validation.textContent = isTimeout
          ? '⏱ Het versturen duurt te lang. Probeer opnieuw of mail hello@aanloopai.nl.'
          : 'Netwerkfout — probeer opnieuw of mail hello@aanloopai.nl.';
        validation.classList.remove('hidden');
      } finally {
        submitBtn.disabled = false;
        submitLabel.textContent = 'Aanvraag versturen →';
      }
    }

    submitBtn.addEventListener('click', submitIntake);
    form.addEventListener('submit', (e) => e.preventDefault());

    showStep(0);
  });
</script>
