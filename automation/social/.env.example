# Aanloop AI — Social Media Automation
# .env.example — copy to .env and fill values
# DO NOT COMMIT .env TO GIT

# ──────────────────────────────────────────────────────────
# n8n self-hosted (Aanloop's existing infrastructure)
# ──────────────────────────────────────────────────────────
N8N_URL=https://n8n.aanloopai.nl
N8N_API_KEY=

# ──────────────────────────────────────────────────────────
# Claude (Anthropic) — content generation
# ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_DRAFT=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_FINAL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=2000

# ──────────────────────────────────────────────────────────
# Telegram — daily approval gate
# ──────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_DIGEST_TIME_NL=09:00
TELEGRAM_TIMEOUT_NL=11:00

# ──────────────────────────────────────────────────────────
# LinkedIn Company Page (cookie-based — Phase 1)
# Get from logged-in browser: F12 -> Application -> Cookies -> linkedin.com
# Cookies expire 60-90 days; refresh monthly
# ──────────────────────────────────────────────────────────
LINKEDIN_LI_AT=
LINKEDIN_JSESSIONID=
LINKEDIN_COMPANY_URN=
LINKEDIN_COMPANY_PAGE_ID=

# When Marketing API approved (Phase 5+):
# LINKEDIN_OAUTH_CLIENT_ID=
# LINKEDIN_OAUTH_CLIENT_SECRET=
# LINKEDIN_OAUTH_REFRESH_TOKEN=

# ──────────────────────────────────────────────────────────
# Meta — Facebook Page + Instagram Business
# ──────────────────────────────────────────────────────────
FB_PAGE_ACCESS_TOKEN=
FB_PAGE_ID=
IG_BUSINESS_ACCOUNT_ID=

# ──────────────────────────────────────────────────────────
# X (Twitter) — API v2 free tier
# ──────────────────────────────────────────────────────────
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=

# ──────────────────────────────────────────────────────────
# YouTube Data API v3
# ──────────────────────────────────────────────────────────
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
YT_CHANNEL_ID=

# ──────────────────────────────────────────────────────────
# TikTok — Phase 1: Drive-drop only, no API yet
# ──────────────────────────────────────────────────────────
# Phase 5+ when Content Posting API approved:
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=

# ──────────────────────────────────────────────────────────
# Asset generation (optional)
# ──────────────────────────────────────────────────────────
FAL_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_NL=Lotte
ELEVENLABS_VOICE_EN=Adam

# ──────────────────────────────────────────────────────────
# Storage
# ──────────────────────────────────────────────────────────
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_SHEET_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# ──────────────────────────────────────────────────────────
# Brand
# ──────────────────────────────────────────────────────────
BRAND_NAME=Aanloop AI
BRAND_KVK=88606902
BRAND_DOMAIN=aanloopai.nl
BRAND_LOCATION=Rotterdam
BRAND_TAGLINE_NL=AI die je werk doet, zodat jij kunt groeien.
BRAND_PRIMARY_LANG=nl
BRAND_SECONDARY_LANG=en

# ──────────────────────────────────────────────────────────
# Cost / quota controls
# ──────────────────────────────────────────────────────────
DAILY_POST_LIMIT=6
WEEKLY_VIDEO_LIMIT=1
MAX_MONTHLY_USD=50
