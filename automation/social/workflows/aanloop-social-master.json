      "typeVersion": 2,
      "position": [2660, 520]
    },
    {
      "parameters": {
        "chatId": "={{$env.TELEGRAM_CHAT_ID}}",
        "text": "=📲 TikTok ready for manual upload\n\nCaption:\n{{$json.text}}\n\nVideo location: {{$json.video_url || 'Drive folder pending-tiktok/'}}\n\nUpload via TikTok mobile app (60 seconds)."
      },
      "name": "TikTok Drive Drop",
      "type": "n8n-nodes-base.telegram",
