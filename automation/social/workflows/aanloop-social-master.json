        "jsonBody": "={\n  \"image_url\": {{JSON.stringify($json.image_url || '')}},\n  \"caption\": {{JSON.stringify($json.text)}},\n  \"access_token\": \"{{$env.FB_PAGE_ACCESS_TOKEN}}\"\n}",
        "options": {}
      },
      "name": "Post Instagram",
      "type": "n8n-nodes-base.httpRequest",
