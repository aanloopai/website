      },
      "name": "Post YouTube Shorts",
      "type": "n8n-nodes-base.youTube",
      "typeVersion": 1,
      "position": [2660, 800]
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": { "__rl": true, "mode": "id", "value": "={{$env.GOOGLE_SHEET_ID}}" },
        "sheetName": { "__rl": true, "mode": "name", "value": "posts-log" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "date": "={{$now.format('yyyy-MM-dd')}}",
            "weekday": "={{$('Pillar Router').item.json.weekday}}",
            "pillar": "={{$('Pillar Router').item.json.pillar}}",
            "platform": "={{$json.platform}}",
            "lang": "={{$json.lang}}",
            "char_count": "={{$json.char_count || ($json.text || '').length}}",
            "post_url": "={{$json.post_url || ''}}",
            "status": "={{$json.error ? 'failed' : 'posted'}}",
            "error": "={{$json.error || ''}}"
          }
        }
      },
