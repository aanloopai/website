{
  "name": "Aanloop Social Master",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "30 7 * * 1-5" }]
        }
      },
      "name": "Cron Daily 07:30 NL",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "0 9 * * 6" }]
        }
      },
      "name": "Cron Saturday Video 09:00 NL",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 460]
    },
    {
      "parameters": {
        "jsCode": "const tz = 'Europe/Amsterdam';\nconst now = new Date();\nconst weekday = now.toLocaleDateString('en-US', { weekday: 'long', timeZone: tz }).toLowerCase();\nconst dateNL = now.toLocaleDateString('nl-NL', { timeZone: tz });\nconst yyyymmdd = now.toLocaleDateString('sv-SE', { timeZone: tz }).replaceAll('-', '');\n\nconst pillarMap = {\n  monday: { pillar: 'news', platforms: ['linkedin', 'instagram', 'facebook', 'x'] },\n  tuesday: { pillar: 'sector', platforms: ['linkedin', 'instagram', 'facebook', 'x'] },\n  wednesday: { pillar: 'tip', platforms: ['linkedin', 'instagram', 'facebook', 'x'] },\n  thursday: { pillar: 'service', platforms: ['linkedin', 'instagram', 'facebook', 'x'] },\n  friday: { pillar: 'longform', platforms: ['linkedin'] },\n  saturday: { pillar: 'video', platforms: ['youtube', 'instagram', 'tiktok'] }\n};\n\nconst plan = pillarMap[weekday] || { pillar: 'skip', platforms: [] };\nreturn [{ json: { weekday, dateNL, yyyymmdd, ...plan } }];"
      },
      "name": "Pillar Router",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 380]
    },
    {
      "parameters": {
        "fileSelector": "/home/node/.n8n/aanloop-social/data/services.json",
        "options": {}
      },
      "name": "Read services.json",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [680, 200]
    },
    {
      "parameters": {
        "fileSelector": "/home/node/.n8n/aanloop-social/data/sectors.json",
        "options": {}
      },
      "name": "Read sectors.json",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [680, 320]
    },
    {
      "parameters": {
        "fileSelector": "/home/node/.n8n/aanloop-social/data/tips.json",
        "options": {}
      },
      "name": "Read tips.json",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [680, 440]
    },
    {
      "parameters": {
        "fileSelector": "/home/node/.n8n/aanloop-social/prompts/brand-voice.md",
        "options": {}
      },
      "name": "Read brand-voice.md",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [680, 560]
    },
    {
      "parameters": {
        "fileSelector": "/home/node/.n8n/aanloop-social/prompts/pillar-prompts.md",
        "options": {}
      },
      "name": "Read pillar-prompts.md",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [680, 680]
    },
    {
      "parameters": {
        "jsCode": "const input = $('Pillar Router').item.json;\nconst pillar = input.pillar;\nconst week = Math.floor(Date.now() / (7*24*3600*1000));\n\nlet dataRow = null;\nlet sectorTags = [];\n\nif (pillar === 'service' || pillar === 'video') {\n  const services = JSON.parse($('Read services.json').item.binary.data.toString()).services;\n  dataRow = services[week % services.length];\n} else if (pillar === 'sector') {\n  const sectors = JSON.parse($('Read sectors.json').item.binary.data.toString()).sectors;\n  dataRow = sectors[week % sectors.length];\n  sectorTags = dataRow.hashtags_nl;\n} else if (pillar === 'tip') {\n  const tips = JSON.parse($('Read tips.json').item.binary.data.toString()).tips;\n  dataRow = tips[week % tips.length];\n} else if (pillar === 'longform') {\n  const themes = [\n    'AVG, EU AI Act en self-hosted AI',\n    'ROI berekening voor AI projecten',\n    'n8n vs Zapier vs Make voor NL MKB',\n    'Voice AI voor MKB met ElevenLabs',\n    'AI hallucinations: bescherm je klant',\n    'No-code AI agents: werkt het echt?',\n    'AI adoptie in NL MKB: drempels en kansen',\n    'AI met mens: angsten vs realiteit'\n  ];\n  dataRow = { theme: themes[week % themes.length] };\n}\n\nconst brandVoice = $('Read brand-voice.md').item.binary.data.toString();\nconst pillarPrompts = $('Read pillar-prompts.md').item.binary.data.toString();\n\nreturn [{ json: { ...input, dataRow, sectorTags, brandVoice, pillarPrompts } }];"
      },
      "name": "Build Pillar Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 380]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "anthropic-version", "value": "2023-06-01" },
            { "name": "content-type", "value": "application/json" },
            { "name": "x-api-key", "value": "={{$env.ANTHROPIC_API_KEY}}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-6\",\n  \"max_tokens\": 2000,\n  \"system\": {{JSON.stringify($json.brandVoice)}},\n  \"messages\": [{\n    \"role\": \"user\",\n    \"content\": {{JSON.stringify('Pillar: ' + $json.pillar + ' | Weekday: ' + $json.weekday + ' | Date: ' + $json.dateNL + ' | UTM: ' + $json.yyyymmdd + ' | Platforms: ' + $json.platforms.join(',') + ' | DataRow: ' + JSON.stringify($json.dataRow) + ' | SectorTags: ' + $json.sectorTags.join(' ') + '\\n\\nPillar prompts (find matching section):\\n' + $json.pillarPrompts + '\\n\\nGenerate posts. Return JSON array of platform variants in code block.')}}\n  }]\n}",
        "options": {}
      },
      "name": "Claude — Generate Content",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 380]
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst contentText = (response.content && response.content[0] && response.content[0].text) || '';\nconst jsonMatch = contentText.match(/```json\\n([\\s\\S]*?)\\n```/) || contentText.match(/(\\[[\\s\\S]*\\])/);\nconst variants = jsonMatch ? JSON.parse(jsonMatch[1]) : [];\nconst pillar = $('Pillar Router').item.json.pillar;\nconst dateNL = $('Pillar Router').item.json.dateNL;\nconst digestText = variants.map(v => v.platform.toUpperCase() + ' (' + v.lang + ', ' + (v.char_count || v.text.length) + ' chars):\\n' + v.text.slice(0, 200) + '...').join('\\n\\n');\nreturn [{ json: { variants, pillar, dateNL, digestText } }];"
      },
      "name": "Parse Variants",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1340, 380]
    },
    {
      "parameters": {
        "chatId": "={{$env.TELEGRAM_CHAT_ID}}",
        "text": "=📅 *{{$json.dateNL}}* — Pillar: *{{$json.pillar}}*\n\n{{$json.digestText}}\n\n_Reply: /approve | /skip | /regenerate_",
        "additionalFields": { "parse_mode": "Markdown" }
      },
      "name": "Telegram — Send Digest",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1560, 380]
    },
    {
      "parameters": {
        "amount": 2,
        "unit": "hours"
      },
      "name": "Wait for Approval",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1780, 380],
      "webhookId": "approval-webhook"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.message?.text || ''}}",
              "operation": "startsWith",
              "value2": "/approve"
            }
          ]
        }
      },
      "name": "IF Approved",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [2000, 380]
    },
    {
      "parameters": {
        "jsCode": "const variants = $('Parse Variants').item.json.variants;\nreturn variants.map(v => ({ json: v }));"
      },
      "name": "Split per Platform",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2220, 280]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            { "conditions": { "string": [{ "value1": "={{$json.platform}}", "value2": "linkedin" }] }, "outputName": "linkedin" },
            { "conditions": { "string": [{ "value1": "={{$json.platform}}", "value2": "instagram" }] }, "outputName": "instagram" },
            { "conditions": { "string": [{ "value1": "={{$json.platform}}", "value2": "facebook" }] }, "outputName": "facebook" },
            { "conditions": { "string": [{ "value1": "={{$json.platform}}", "value2": "x" }] }, "outputName": "x" },
            { "conditions": { "string": [{ "value1": "={{$json.platform}}", "value2": "tiktok" }] }, "outputName": "tiktok" },
            { "conditions": { "string": [{ "value1": "={{$json.platform}}", "value2": "youtube" }] }, "outputName": "youtube" }
          ]
        }
      },
      "name": "Switch by Platform",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [2440, 280]
    },
    {
