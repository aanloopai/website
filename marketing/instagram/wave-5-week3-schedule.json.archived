      "id": "w5-c16-step-whatsapp-business",
      "slot_iso": "2026-06-10T09:00:00+02:00",
      "pillar": "P4 — Educational micro-tip",
      "format": "carousel",
      "template": "step-framework",
      "hook": "WhatsApp Business\nlive in 6 stappen\n— zonder API-gedoe",
      "steps": [
        {"title": "Apart nummer", "body": "Gebruik 2e SIM of VOIP-nummer. WhatsApp Business kan NIET op je persoonlijke nummer + WhatsApp tegelijk."},
        {"title": "Bedrijfsprofiel inrichten", "body": "Logo, adres, openingstijden, productcategorie, website. Vul ALLE velden — Google indexeert dit voor lokale zoekresultaten."},
        {"title": "Catalogus aanmaken", "body": "Top 5-10 producten/diensten met prijs + foto. Klanten kunnen direct bestellen of vraag stellen vanuit product-card."},
        {"title": "Snelle antwoorden", "body": "Veelgestelde vragen (openingstijden, prijzen, retour) → keyboard-shortcuts. 30-60% van je antwoorden gaat zo 5x sneller."},
        {"title": "Begroetingsbericht + afwezigheid", "body": "Automatisch antwoord bij nieuw gesprek + buiten kantooruren. Geen klant meer in stilte."},
        {"title": "Naar AI-handover (optioneel)", "body": "Als volume > 50/week: stap over naar WhatsApp Business API + Emma. €49/mnd Lite-tier dekt 500 berichten/maand."}
