    {
      "id": "w5-c18-faq-retail-webshop",
      "slot_iso": "2026-06-12T09:00:00+02:00",
      "pillar": "P3 — Sector deep (retail / webshop)",
      "format": "carousel",
      "template": "faq",
      "hook": "Emma voor webshops —\n8 vragen die elke\nretail-eigenaar stelt",
      "qa": [
        {"q": "Werkt het met Shopify, WooCommerce, Magento?", "a": "Ja. Order-status, retour-flow, product-info real-time uit jouw shop-API. Geen losse database bouwen."},
        {"q": "Wat met retouren?", "a": "Emma start retour-flow, mailt retour-label, plant pickup. 90% retouren zelf afgehandeld zonder mens."},
        {"q": "Kan Emma productadvies geven?", "a": "Ja — gebaseerd op jouw catalogus + filters (maat, kleur, prijs). Geen open ChatGPT, alleen jouw producten."},
        {"q": "Hoe zit het met dispute / cashback-claims?", "a": "Hard rule: na 1 weigering door klant → direct naar customer-service mens. Klanttevredenheid > automatisering bij geld-conflicten."},
        {"q": "Werkt het met mijn betaalprovider?", "a": "Stripe, Mollie, Adyen, PayPal — Emma kan refund-status checken en uitleggen. Geen actie zelf op betalingen (hard rule)."},
        {"q": "Wat met B2B-prijzen?", "a": "Login-detectie + accountkoppeling. Logged-in B2B-klant ziet eigen kortingen. Geen prijs-lek naar consument."},
        {"q": "Hoe lang implementatie?", "a": "14 dagen. Week 1: catalogus + retour-flow. Week 2: shop-API koppeling + test."},
        {"q": "Kosten voor middel-grote webshop?", "a": "Emma Starter €597/mnd dekt typisch 1.000 chats/mnd. Bij volume > 3.000: Groei €1.197 met integratie + dashboard."}
      ],
      "cta": "Bewaar voor je\nvolgende e-commerce overleg",
      "slides": [
        "carousel/w5-c18-faq-retail-webshop/slide-01.png",
