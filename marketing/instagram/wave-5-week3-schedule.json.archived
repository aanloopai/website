    {
      "id": "w5-c21-objection-jaarcontract",
      "slot_iso": "2026-06-15T17:00:00+02:00",
      "pillar": "P1 — Diferansiyel/Contrarian",
      "format": "carousel",
      "template": "objection-destroyed",
      "hook": "5 redenen dat AI-bureaus\njaarcontracten verkopen\n(en wat het jou kost)",
      "objections": [
        {"claim": "Jaarcontracten zijn voor stabiliteit", "reality": "Stabiliteit voor LEVERANCIER, niet voor jou. Jij bent vastgeklemd, leverancier heeft recurring revenue gegarandeerd."},
        {"claim": "Maandelijks is duurder per maand", "reality": "Marco Lite €249/mnd maandelijks = €2.988/jr. Veel jaar-contracten bij anderen rekenen €3.500-5.000/jr exact. Maandelijks is gelijk of goedkoper."},
        {"claim": "Jaarcontract = betere setup-aandacht", "reality": "Wij doen 14-dagen managed setup ongeacht contract-type. Niemand 'verkoopt' jou minder zorg omdat je maandelijks zit."},
        {"claim": "Maandelijks geeft instabiele relatie", "reality": "Wij hebben 80+ MKB-klanten waarvan 92% langer dan 6 mnd blijft. Maandelijks = beste service moet leveren, anders ben je weg."},
        {"claim": "Je hebt een lange-termijn budget nodig", "reality": "€249-1.197 OPEX past in MKB-cashflow zonder treasurer. Geen activering, geen afschrijving."}
      ],
      "cta": "Bewaar voor je\nvolgende AI-bureau gesprek",
      "slides": [
        "carousel/w5-c21-objection-jaarcontract/slide-01.png",
        "carousel/w5-c21-objection-jaarcontract/slide-02.png",
