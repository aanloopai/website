    {
      "id": "w5-c25-step-kennisbank-prep",
      "slot_iso": "2026-06-19T09:00:00+02:00",
      "pillar": "P4 — Educational micro-tip",
      "format": "carousel",
      "template": "step-framework",
      "hook": "Kennisbank-prep voor AI\n— 6 stappen om in\n1 dag klaar te zijn",
      "steps": [
        {"title": "Open 1 lege map", "body": "'/ai-kennisbank' op je drive. Hier komt ALLES wat AI mag weten. Eén plek, geen verspreide bestanden."},
        {"title": "Dump je FAQ", "body": "Wat krijg je het vaakst gevraagd? 10-30 vragen + jouw beste antwoord. Geen perfecte zinnen, gewoon je echte tone."},
        {"title": "Voeg openingstijden toe", "body": "Per locatie, per dag, plus feestdagen volgend jaar. Schrijf afwijkingen expliciet op."},
        {"title": "Producten/diensten + prijzen", "body": "Top 10-20 met korte omschrijving + richtprijs. Geen volledige catalogus, alleen waar klanten vragen over stellen."},
        {"title": "Hard rules op 1 A4", "body": "Wat mag AI NIET zeggen? Wat moet AI WEL escaleren? Concreet, geen 'wees voorzichtig'."},
        {"title": "Test met 5 mensen", "body": "Vraag 5 willekeurige mensen om vragen te stellen. Wat AI niet weet uit je kennisbank → bijwerken."}
      ],
