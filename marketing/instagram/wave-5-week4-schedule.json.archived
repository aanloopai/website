    {
      "id": "w5-c24-faq-logistiek",
      "slot_iso": "2026-06-18T17:00:00+02:00",
      "pillar": "P3 — Sector deep (logistiek)",
      "format": "carousel",
      "template": "faq",
      "hook": "AI voor transport +\nlogistiek — 8 vragen\ndie elke planner stelt",
      "qa": [
        {"q": "Kan Emma track-and-trace beantwoorden?", "a": "Ja. Live-status uit TMS/WMS (Transwide, Carriersoft, Microlistics). Klant krijgt direct ETA."},
        {"q": "Werkt het met meerdere vervoerders?", "a": "Ja — DHL, DPD, PostNL, GLS, UPS koppelingen klaar. Eigenwerk: API of nightly CSV."},
        {"q": "Wat met levertijd-claims?", "a": "Hard rule: claim-trigger ('zou gisteren komen', 'niet ontvangen') → direct naar customer-service mens. Geen automatische compensatie."},
        {"q": "Kan Marco transportplanning doen?", "a": "Nee. Marco doet alleen klant-intake en status-vragen. Planning blijft bij planner."},
        {"q": "Hoe zit het met B2B-portal vragen?", "a": "Logged-in klanten zien hun eigen ritten + facturen. Marco/Emma helpen met vragen daarover, geen prijs-onderhandeling."},
        {"q": "Kosten voor 5-truck transportbedrijf?", "a": "Starter €597/mnd dekt typisch 200 klantvragen/mnd + track-and-trace. Bij volume > 1.000: Groei €1.197."},
        {"q": "Spoed-zendingen?", "a": "Spoed-trigger ('te laat', 'urgent', 'morgen leveren') → directe escalatie naar planner mens. Hard rule."},
        {"q": "Werkt het met onze EDI-koppeling?", "a": "Ja — EDI-status real-time leesbaar. Bij wijzigingen automatische klantnotificatie via WhatsApp/SMS."}
      ],
      "cta": "Bewaar voor je\nvolgende planners-meeting",
