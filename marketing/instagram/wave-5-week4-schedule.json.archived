    {
      "id": "w5-c23-step-handover-flow",
      "slot_iso": "2026-06-17T09:00:00+02:00",
      "pillar": "P4 — Educational micro-tip",
      "format": "carousel",
      "template": "step-framework",
      "hook": "AI handover-flow\nin 7 stappen — wat\n90% verkeerd doet",
      "steps": [
        {"title": "Definieer 'twijfel'", "body": "Wanneer mag AI doorvragen, wanneer escaleert? 'Bij elke twijfel' is te vaag — concreet maken per use-case."},
        {"title": "Trigger-woorden lijst", "body": "Spoed-trigger ('klacht', 'manager', 'opzeggen', 'spoed', etc.) → direct mens. Geen AI-poging."},
        {"title": "Context overdracht", "body": "Transcript automatisch meegestuurd in handover-notificatie. Mens hoeft niet 'wat was de vraag?' te vragen."},
        {"title": "Notificatie-kanaal", "body": "Slack + Teams + e-mail tegelijk. Eerste die opent claimt het ticket. Geen race-condition."},
        {"title": "SLA per kanaal", "body": "Werktijd: 15 min. Avond/weekend: 4 uur. Klant weet vooraf wat te verwachten via begroeting."},
        {"title": "Feedback-loop", "body": "Mens labelt na afhandeling: 'AI had dit kunnen doen' / 'goed escalatie'. Weekly review, kennisbank update."},
        {"title": "Geen schaam-spiraal", "body": "AI mag zeggen 'ik weet het niet, ik verbind je door'. Klanten waarderen dat MEER dan een fout antwoord."}
      ],
      "cta_keyword": "HANDOVER",
