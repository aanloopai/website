---
// Hero — homepage opening section
---

<section class="relative overflow-hidden">
  <!-- Subtle background pattern -->
  <div class="absolute inset-0 -z-10 bg-gradient-to-b from-slate-50/50 to-white"></div>
  <div
    class="absolute inset-0 -z-10 opacity-[0.04]"
    style="background-image: radial-gradient(circle at 1px 1px, #0F172A 1px, transparent 0); background-size: 24px 24px;"
  ></div>

  <div class="container-page pt-20 pb-24 lg:pt-28 lg:pb-32">
    <div class="max-w-4xl">
      <!-- Eyebrow + accent band -->
      <div class="flex items-center gap-4 mb-8">
        <div class="accent-band">
          <span></span><span></span><span></span><span></span>
        </div>
        <span class="eyebrow">AI voor het Nederlandse MKB</span>
      </div>

      <!-- H1 -->
      <h1 class="text-4xl sm:text-5xl lg:text-7xl font-bold tracking-tightest text-navy text-balance leading-[1.05]">
        AI die <em class="not-italic relative">
          écht werkt
          <svg class="absolute -bottom-2 left-0 w-full" viewBox="0 0 240 12" preserveAspectRatio="none" aria-hidden="true">
            <path d="M2 8 Q 60 2, 120 6 T 238 5" fill="none" stroke="#E11D48" stroke-width="3" stroke-linecap="round" />
          </svg>
        </em> voor uw bedrijf.
      </h1>

      <!-- Subheadline -->
      <p class="mt-8 text-lg lg:text-xl text-slate-600 leading-relaxed text-pretty max-w-2xl">
        Van AI-receptionist die uw telefoon aanneemt, tot WhatsApp-assistent die
        klantvragen beantwoordt — Aanloop AI levert kant-en-klare AI-oplossingen
        en custom workflows voor MKB-ondernemers in Nederland.
      </p>

      <!-- CTAs -->
      <div class="mt-10 flex flex-col sm:flex-row gap-3">
        <a href="/contact/?type=demo" class="btn-primary text-base px-6 py-3.5">
          Boek een gratis demo
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
        <a href="/diensten/" class="btn-outline text-base px-6 py-3.5">
          Bekijk onze diensten
        </a>
      </div>

      <!-- Inline trust signals -->
      <div class="mt-12 flex flex-wrap items-center gap-x-8 gap-y-3 text-sm text-slate-500">
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-brand-emerald" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span>ISO 9001 & 27001 gecertificeerd</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-brand-emerald" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span>500+ actieve klanten</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-brand-emerald" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span>Live binnen 14 dagen</span>
        </div>
      </div>
    </div>
  </div>
</section>
