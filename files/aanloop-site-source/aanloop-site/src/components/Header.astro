---
const navLinks = [
  { href: '/diensten/', label: 'Diensten' },
  { href: '/sectoren/', label: 'Sectoren' },
  { href: '/cases/', label: 'Cases' },
  { href: '/werkwijze/', label: 'Werkwijze' },
  { href: '/tarieven/', label: 'Tarieven' },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
};
---

<header class="sticky top-0 z-40 bg-white/80 backdrop-blur-lg border-b border-slate-200/80">
  <div class="container-page">
    <div class="flex items-center justify-between h-18 py-4">
      <!-- Logo -->
      <a href="/" class="flex items-center" aria-label="Aanloop AI — naar de homepagina">
        <img
          src="/brand/logo-horizontal-light.svg"
          alt="Aanloop AI"
          width="160"
          height="50"
          class="h-9 w-auto"
        />
      </a>

      <!-- Desktop nav -->
      <nav class="hidden lg:flex items-center gap-1" aria-label="Hoofdnavigatie">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              'px-4 py-2 rounded-lg text-sm font-medium transition-colors',
              isActive(link.href)
                ? 'text-navy bg-slate-100'
                : 'text-slate-600 hover:text-navy hover:bg-slate-50',
            ]}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- CTA -->
      <div class="flex items-center gap-3">
        <a href="/contact/" class="hidden md:inline-flex btn-ghost text-sm">
          Contact
        </a>
        <a href="/contact/?type=demo" class="btn-primary text-sm">
          Boek een demo
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
        <button
          id="mobile-menu-toggle"
          class="lg:hidden p-2 text-slate-700 hover:text-navy"
          aria-label="Menu openen"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden lg:hidden border-t border-slate-200 bg-white"
  >
    <nav class="container-page py-4 flex flex-col gap-1" aria-label="Mobiele navigatie">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            'px-4 py-3 rounded-lg text-sm font-medium transition-colors',
            isActive(link.href)
              ? 'text-navy bg-slate-100'
              : 'text-slate-700 hover:bg-slate-50',
          ]}
        >
          {link.label}
        </a>
      ))}
      <a href="/contact/" class="px-4 py-3 rounded-lg text-sm font-medium text-slate-700 hover:bg-slate-50">
        Contact
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(isOpen));
  });
</script>
