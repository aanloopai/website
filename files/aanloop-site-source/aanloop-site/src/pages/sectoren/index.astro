---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectorCard from '../../components/SectorCard.astro';
import { sectors } from '../../data/sectors';
---

<BaseLayout
  title="Sectoren · Aanloop AI"
  description="AI-oplossingen toegespitst op uw branche: horeca, logistiek, vastgoed, detailhandel, zakelijke dienstverlening, zorg. Gespecialiseerde aanpak per sector."
>
  <section class="border-b border-slate-200">
    <div class="container-page py-16 lg:py-24">
      <div class="max-w-3xl">
        <div class="flex items-center gap-4 mb-6">
          <div class="accent-band"><span></span><span></span><span></span><span></span></div>
          <span class="eyebrow">Sectoren</span>
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tightest text-navy text-balance leading-[1.05]">
          Uw branche kent zijn eigen ritme.
        </h1>
        <p class="mt-6 text-lg lg:text-xl text-slate-600 leading-relaxed text-pretty max-w-2xl">
          Een restaurant heeft andere AI-noden dan een transportbedrijf of huisartspraktijk.
          We hebben gespecialiseerde oplossingen ontwikkeld op basis van honderden gesprekken
          met MKB-ondernemers — toegespitst op uw sector, uw klanten, uw realiteit.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 lg:gap-6">
        {sectors.map((sector) => (
          <SectorCard
            href={`/sectoren/${sector.slug}/`}
            title={sector.title}
            description={sector.shortDescription}
            icon={sector.icon}
          />
        ))}
      </div>

      <div class="mt-16 max-w-2xl">
        <p class="text-sm text-slate-500">
          Staat uw sector er niet bij? Geen probleem — we werken graag in andere branches.
          <a href="/contact/" class="text-navy font-medium hover:underline">Plan een adviesgesprek</a>
          en we kijken samen wat past.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
