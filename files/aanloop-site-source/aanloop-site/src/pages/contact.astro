---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact · Aanloop AI"
  description="Neem contact op met Aanloop AI voor een gratis adviesgesprek over AI-oplossingen voor uw bedrijf. Geen verkooppraatje — alleen advies."
>
  <section class="border-b border-slate-200">
    <div class="container-page py-16 lg:py-24">
      <div class="max-w-3xl">
        <div class="flex items-center gap-4 mb-6">
          <div class="accent-band"><span></span><span></span><span></span><span></span></div>
          <span class="eyebrow">Contact</span>
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tightest text-navy text-balance leading-[1.05]">
          Plan een gratis adviesgesprek.
        </h1>
        <p class="mt-6 text-lg lg:text-xl text-slate-600 leading-relaxed text-pretty max-w-2xl">
          30 minuten, geen verplichting. We luisteren naar uw bedrijf en geven eerlijk advies —
          ook als dat is dat AI nog niet de juiste keuze is.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page">
      <div class="grid lg:grid-cols-12 gap-12 lg:gap-16">
        <!-- Form -->
        <div class="lg:col-span-7">
          <form
            id="contact-form"
            class="space-y-6"
            method="POST"
            action="/api/contact"
          >
            <!-- Type select (auto-filled from URL ?type=) -->
            <div>
              <label class="block text-sm font-medium text-navy mb-2" for="type">
                Waarover wilt u in gesprek?
              </label>
              <select
                id="type"
                name="type"
                required
                class="w-full px-4 py-3 bg-white border border-slate-300 rounded-lg text-sm text-navy focus:border-navy focus:ring-1 focus:ring-navy outline-none"
              >
                <option value="advies">Algemeen adviesgesprek</option>
                <option value="marco">Marco — AI sekreter</option>
                <option value="emma">Emma — WhatsApp agent</option>
                <option value="telefoon-assistent">AI telefoon assistent</option>
                <option value="custom">Custom AI workflow</option>
                <option value="audit">AI strategie & audit</option>
                <option value="horeca">Sector: horeca</option>
                <option value="logistiek">Sector: logistiek</option>
                <option value="vastgoed">Sector: vastgoed</option>
                <option value="detailhandel">Sector: detailhandel</option>
                <option value="zakelijk">Sector: zakelijke dienstverlening</option>
                <option value="zorg">Sector: zorg</option>
              </select>
            </div>

            <div class="grid sm:grid-cols-2 gap-6">
              <div>
                <label class="block text-sm font-medium text-navy mb-2" for="name">
                  Uw naam <span class="text-brand-rose">*</span>
                </label>
                <input
                  id="name"
                  name="name"
                  type="text"
                  required
                  autocomplete="name"
                  class="w-full px-4 py-3 bg-white border border-slate-300 rounded-lg text-sm text-navy focus:border-navy focus:ring-1 focus:ring-navy outline-none"
                />
              </div>
              <div>
                <label class="block text-sm font-medium text-navy mb-2" for="company">
                  Bedrijfsnaam <span class="text-brand-rose">*</span>
                </label>
                <input
                  id="company"
                  name="company"
                  type="text"
                  required
                  autocomplete="organization"
                  class="w-full px-4 py-3 bg-white border border-slate-300 rounded-lg text-sm text-navy focus:border-navy focus:ring-1 focus:ring-navy outline-none"
                />
              </div>
            </div>

            <div class="grid sm:grid-cols-2 gap-6">
              <div>
                <label class="block text-sm font-medium text-navy mb-2" for="email">
                  E-mailadres <span class="text-brand-rose">*</span>
                </label>
                <input
                  id="email"
                  name="email"
                  type="email"
                  required
                  autocomplete="email"
                  class="w-full px-4 py-3 bg-white border border-slate-300 rounded-lg text-sm text-navy focus:border-navy focus:ring-1 focus:ring-navy outline-none"
                />
              </div>
              <div>
                <label class="block text-sm font-medium text-navy mb-2" for="phone">
                  Telefoon
                </label>
                <input
                  id="phone"
                  name="phone"
                  type="tel"
                  autocomplete="tel"
                  placeholder="06 12 34 56 78"
                  class="w-full px-4 py-3 bg-white border border-slate-300 rounded-lg text-sm text-navy focus:border-navy focus:ring-1 focus:ring-navy outline-none"
                />
              </div>
            </div>

            <div>
              <label class="block text-sm font-medium text-navy mb-2" for="message">
                Vertel ons kort wat u zoekt
              </label>
              <textarea
                id="message"
                name="message"
                rows="4"
                placeholder="Bijvoorbeeld: 'We krijgen 50+ telefoontjes per dag waar we 30% niet aanpakken' of 'We willen onze WhatsApp customer service automatiseren'"
                class="w-full px-4 py-3 bg-white border border-slate-300 rounded-lg text-sm text-navy focus:border-navy focus:ring-1 focus:ring-navy outline-none resize-none"
              ></textarea>
            </div>

            <div class="flex items-start gap-3">
              <input
                id="privacy"
                name="privacy"
                type="checkbox"
                required
                class="mt-1 w-4 h-4 rounded border-slate-300 text-navy focus:ring-navy"
              />
              <label for="privacy" class="text-sm text-slate-600">
                Ik ga akkoord met de <a href="/privacy/" class="text-navy underline hover:no-underline">privacyverklaring</a>.
                We gebruiken uw gegevens alleen om uw aanvraag te beantwoorden.
              </label>
            </div>

            <div class="pt-2">
              <button type="submit" class="btn-primary text-base px-6 py-3.5">
                Verstuur aanvraag
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
              </button>
              <p class="mt-3 text-xs text-slate-500">
                We reageren binnen 1 werkdag.
              </p>
            </div>
          </form>
        </div>

        <!-- Sidebar info -->
        <aside class="lg:col-span-5 space-y-8">
          <div class="card bg-slate-50 border-slate-200">
            <h3 class="text-base font-bold text-navy mb-4">Direct contact</h3>
            <div class="space-y-3 text-sm">
              <div class="flex items-start gap-3">
                <svg class="w-4 h-4 mt-0.5 text-slate-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                <a href="mailto:hello@aanloop.ai" class="text-navy font-medium hover:underline">hello@aanloop.ai</a>
              </div>
              <div class="flex items-start gap-3">
                <svg class="w-4 h-4 mt-0.5 text-slate-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                <a href="tel:+31000000000" class="text-navy font-medium hover:underline">010 — 000 0000</a>
              </div>
              <div class="flex items-start gap-3">
                <svg class="w-4 h-4 mt-0.5 text-slate-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                <span class="text-slate-700">Rotterdam, Nederland</span>
              </div>
            </div>
          </div>

          <div class="card bg-navy text-pearl border-navy">
            <h3 class="text-base font-bold text-pearl mb-3">Liever direct bellen?</h3>
            <p class="text-sm text-slate-300 leading-relaxed mb-4">
              Marco neemt op. Hij is onze eigen AI-receptionist — u test \'em meteen door te bellen.
            </p>
            <a href="tel:+31000000000" class="btn bg-pearl text-navy hover:bg-white text-sm">
              Bel direct
            </a>
          </div>

          <div>
            <h3 class="text-base font-bold text-navy mb-3">Wat gebeurt er nu?</h3>
            <ol class="space-y-3 text-sm text-slate-600">
              <li class="flex items-start gap-3">
                <span class="flex-shrink-0 w-5 h-5 rounded-full bg-brand-indigo/10 text-brand-indigo text-[11px] font-bold flex items-center justify-center">1</span>
                We reageren binnen 1 werkdag (meestal binnen 2 uur).
              </li>
              <li class="flex items-start gap-3">
                <span class="flex-shrink-0 w-5 h-5 rounded-full bg-brand-rose/10 text-brand-rose text-[11px] font-bold flex items-center justify-center">2</span>
                We plannen een gesprek van 30 minuten op een tijdstip dat u uitkomt.
              </li>
              <li class="flex items-start gap-3">
                <span class="flex-shrink-0 w-5 h-5 rounded-full bg-brand-amber/10 text-brand-amber text-[11px] font-bold flex items-center justify-center">3</span>
                Tijdens het gesprek krijgt u eerlijke feedback en concrete vervolgstappen.
              </li>
              <li class="flex items-start gap-3">
                <span class="flex-shrink-0 w-5 h-5 rounded-full bg-brand-emerald/10 text-brand-emerald text-[11px] font-bold flex items-center justify-center">4</span>
                <span>Geen druk. Geen verkooppraatje. Alleen advies.</span>
              </li>
            </ol>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <script>
    // Auto-fill 'type' select from ?type= URL parameter
    const params = new URLSearchParams(window.location.search);
    const type = params.get('type');
    if (type) {
      const select = document.getElementById('type') as HTMLSelectElement | null;
      if (select && Array.from(select.options).some((o) => o.value === type)) {
        select.value = type;
      }
    }
  </script>
</BaseLayout>
