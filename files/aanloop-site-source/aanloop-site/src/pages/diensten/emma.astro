---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Emma · AI WhatsApp agent voor het MKB"
  description="Emma beantwoordt klantvragen op WhatsApp 24/7, getraind op uw eigen kennisbank. Naadloze handover naar mens. Vanaf €247/maand."
>
  <section class="border-b border-slate-200">
    <div class="container-page py-16 lg:py-24">
      <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        <div class="lg:col-span-7">
          <div class="flex items-center gap-3 mb-6">
            <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-medium tracking-wide uppercase bg-brand-rose/10 text-brand-rose">WhatsApp Business</span>
            <span class="eyebrow">AI agent</span>
          </div>

          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tightest text-navy text-balance leading-[1.05]">
            Emma beantwoordt klantvragen.<br/>
            <span class="text-slate-500">In seconden, in uw stijl.</span>
          </h1>

          <p class="mt-6 text-lg text-slate-600 leading-relaxed text-pretty max-w-xl">
            Emma is een AI-assistent voor uw WhatsApp Business-nummer, getraind op uw eigen kennisbank.
            Beantwoordt 80% van de klantvragen zelfstandig — voor de rest draagt ze naadloos over aan uw team.
          </p>

          <div class="mt-8 flex flex-col sm:flex-row gap-3">
            <a href="/contact/?type=emma" class="btn-primary text-base px-6 py-3.5">
              Boek een demo
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </a>
            <a href="#functies" class="btn-outline text-base px-6 py-3.5">Bekijk functies</a>
          </div>

          <div class="mt-10 grid grid-cols-3 gap-6 max-w-md">
            <div>
              <div class="text-2xl font-bold text-navy">10 dagen</div>
              <div class="text-xs text-slate-500 mt-1">tot live</div>
            </div>
            <div>
              <div class="text-2xl font-bold text-navy">80%</div>
              <div class="text-xs text-slate-500 mt-1">vragen autonoom</div>
            </div>
            <div>
              <div class="text-2xl font-bold text-navy">€247</div>
              <div class="text-xs text-slate-500 mt-1">vanaf p/m</div>
            </div>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="bg-[#075E54] rounded-2xl p-1 shadow-2xl">
            <div class="bg-[#ECE5DD] rounded-xl p-4">
              <div class="flex items-center gap-3 mb-4 pb-3 border-b border-slate-300/50">
                <div class="w-10 h-10 rounded-full bg-brand-rose/20 flex items-center justify-center text-brand-rose font-bold text-sm">EM</div>
                <div>
                  <div class="text-sm font-bold text-slate-800">Emma · Aanloop AI</div>
                  <div class="text-xs text-brand-emerald">online</div>
                </div>
              </div>

              <div class="space-y-2.5">
                <div class="flex justify-end">
                  <div class="bg-[#DCF8C6] text-sm text-slate-800 rounded-lg rounded-br-none px-3 py-2 max-w-[80%] shadow-sm">
                    Hoi! Hebben jullie de zwarte sneakers in maat 42 op voorraad?
                  </div>
                </div>
                <div class="flex justify-start">
                  <div class="bg-white text-sm text-slate-800 rounded-lg rounded-bl-none px-3 py-2 max-w-[80%] shadow-sm">
                    Goedendag! De zwarte Brandstof Classic in maat 42 hebben we nog 3 op voorraad. Wilt u dat ik er één voor u reserveer?
                  </div>
                </div>
                <div class="flex justify-end">
                  <div class="bg-[#DCF8C6] text-sm text-slate-800 rounded-lg rounded-br-none px-3 py-2 max-w-[80%] shadow-sm">
                    Graag! Wanneer kan ik 'm ophalen?
                  </div>
                </div>
                <div class="flex justify-start">
                  <div class="bg-white text-sm text-slate-800 rounded-lg rounded-bl-none px-3 py-2 max-w-[80%] shadow-sm">
                    Vandaag tot 18:00. Op welke naam zal ik 'm zetten?
                  </div>
                </div>
              </div>

              <div class="mt-4 pt-3 border-t border-slate-300/50 text-[11px] text-slate-500 text-center">
                Demo · Emma beheerst NL, EN, DE, TR
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="functies" class="section">
    <div class="container-page">
      <div class="max-w-3xl mb-14">
        <p class="eyebrow mb-3">Wat Emma kan</p>
        <h2 class="text-3xl lg:text-4xl font-bold tracking-tightest text-navy text-balance">
          Een teamlid dat WhatsApp 24/7 bemenst.
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          { color: 'rose', title: 'Eigen kennisbank', desc: 'Wij trainen Emma op uw documenten, FAQ\'s, productcatalogus. Antwoorden 100% afgestemd op uw bedrijf.' },
          { color: 'indigo', title: 'Naadloze handover', desc: 'Bij complexe vragen draagt Emma over aan een mens. De klant merkt geen breuk in het gesprek.' },
          { color: 'amber', title: 'Werkt op uw nummer', desc: 'Emma werkt op uw bestaande WhatsApp Business-nummer. Klanten zien geen verschil.' },
          { color: 'emerald', title: 'Productadvies', desc: 'Emma geeft eerlijk productadvies, suggereert alternatieven en voorkomt zo retouren.' },
          { color: 'rose', title: 'Multi-language', desc: 'Antwoordt in NL, EN, DE en TR. Detecteert automatisch de taal van de klant.' },
          { color: 'indigo', title: 'CRM-integratie', desc: 'Elk gesprek belandt automatisch in uw CRM (HubSpot, Pipedrive, Teamleader, etc.).' },
        ].map((f) => (
          <div class="card">
            <div class:list={[
              'w-2 h-2 rounded-full mb-4',
              f.color === 'indigo' && 'bg-brand-indigo',
              f.color === 'rose' && 'bg-brand-rose',
              f.color === 'amber' && 'bg-brand-amber',
              f.color === 'emerald' && 'bg-brand-emerald',
            ]}></div>
            <h3 class="text-base font-bold text-navy">{f.title}</h3>
            <p class="mt-2 text-sm text-slate-600 leading-relaxed">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight bg-midnight text-pearl">
    <div class="container-page">
      <div class="max-w-2xl">
        <h2 class="text-3xl lg:text-4xl font-bold tracking-tightest text-pearl text-balance">
          Test Emma op uw eigen WhatsApp.
        </h2>
        <p class="mt-4 text-base text-slate-300">
          We bouwen een testversie op een proefnummer en u stuurt 'm berichten alsof u klant bent.
        </p>
        <div class="mt-6">
          <a href="/contact/?type=emma" class="btn bg-pearl text-navy hover:bg-white text-base px-6 py-3.5">
            Plan een test
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
