---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  image = '/brand/logo-horizontal-light.svg',
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const fullTitle = title.includes('Aanloop') ? title : `${title} · Aanloop AI`;

// Schema.org Organization JSON-LD — boosts Google Knowledge Panel eligibility
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Aanloop AI',
  url: 'https://aanloop.ai',
  logo: 'https://aanloop.ai/brand/logo-horizontal-light.svg',
  description: 'AI-oplossingen voor het Nederlandse MKB — kant-en-klare AI-assistenten en custom workflows.',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Rotterdam',
    addressCountry: 'NL',
  },
  sameAs: [
    'https://www.linkedin.com/company/aanloop-ai',
  ],
};
---

<!DOCTYPE html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Aanloop AI" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site).toString()} />
    <meta property="og:locale" content="nl_NL" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site).toString()} />

    <!-- Theme color for mobile browsers -->
    <meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0B1120" media="(prefers-color-scheme: dark)" />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />

    <!-- Preconnect for fonts (Inter is bundled, but DNS warm-up helps) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-navy focus:text-white focus:rounded-lg"
    >
      Naar hoofdinhoud
    </a>

    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />
  </body>
</html>
